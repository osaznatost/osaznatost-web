стта му, чрез контрол върху задълженията на управителя му. За последните три финансови години повече от 80 % от оборота на дружеството е реализиран от дейности, изпълнени от Община Велики Преслав и други нейни юридически лица - детски градини, училища, болници и др.","offers_count":1,"sme_offers_count":1,"disqualified_offers_count":0,"contract_period_days":364,"ted_link":"https://ted.europa.eu/udl?uri=TED:NOTICE:063030-2024:TEXT:BG:HTML","imported_at":"2026-11-17T22:52:39.92949+00:00","contract_value_eur":168469.6,"estimated_value_eur":168469.6,"level":"общински","ekatte":"58222","settlement":"Велики Преслав","is_village":false,"municipality":"Велики Преслав","municipality_code":"SHU23","oblast":"Шумен"},{"id":"794376|LOT-0001|231902","notice_id":794376,"published_at":"2026-01-08T15:32:24.003333+00:00","unp":"06168-2025-0001","tender_id":529439,"tender_name":"„ДОСТАВКА НА АСФАЛТОВИ СМЕСИ И БИТУМНИ ПРОДУКТИ ЗА НУЖДИТЕ НА „БКС“ ЕООД, ГР. ВЕЛИКИ ПРЕСЛАВ“","procedure_type":"Публично състезание","legal_basis":"Чл. 18, ал. 1, т. 12 от ЗОП","award_method":"Най-ниска цена","cpv":"44113600","cpv_desc":"Битум и асфалт","contract_type":"Доставки","estimated_value":250000,"currency":"BGN","buyer_eik":"837103415","buyer_name":"БКС ЕООД","buyer_type":"Публичноправна организация, контролирана от местен орган","lot":"LOT-0001","contract_number":"231902","contract_date":"2025-12-23","contract_value":127822.97,"contract_currency":"EUR","supplier_eiks":["127001597"],"supplier_names":["АВТОМАГИСТРАЛИ - ЧЕРНО МОРЕ АД"],"supplier_nuts":["BG333"],"awarded_to_group":false,"has_subcontractors":false,"subcontractor_names":null,"subcontractor_eiks":null,"subcontracting_percent":null,"subcontracting_amount":null,"is_eu_funded":false,"eu_program":null,"is_framework":false,"direct_award_justification":null,"offers_count":1,"sme_offers_count":0,"disqualified_offers_count":0,"contract_period_days":364,"ted_link":null,"imported_at":"2026-11-17T13:57:33.369942+00:00","contract_value_eur":127822.97,"