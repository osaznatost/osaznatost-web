settlement":"Нови пазар","is_village":false,"municipality":"Нови пазар","municipality_code":"SHU22","oblast":"Шумен"},{"id":"468653||127081","notice_id":468653,"published_at":"2024-01-10T10:00:00+00:00","unp":"00450-2023-0035","tender_id":344301,"tender_name":"Доставка на природен газ за отопление на сгради в Община Нови пазар","procedure_type":"Договаряне без предварително обявление","legal_basis":"Чл. 79, ал. 1, т.3, б.в от ЗОП","award_method":"Най-ниска цена","cpv":"09123000","cpv_desc":"Природен газ","contract_type":"Доставки","estimated_value":124000,"currency":"BGN","buyer_eik":"000931575","buyer_name":"ОБЩИНА НОВИ ПАЗАР","buyer_type":"Регионален или местен орган","lot":null,"contract_number":"127081","contract_date":"2024-01-01","contract_value":124000,"contract_currency":"BGN","supplier_eiks":["130533432"],"supplier_names":["ОВЕРГАЗ МРЕЖИ АД"],"supplier_nuts":["BG"],"awarded_to_group":false,"has_subcontractors":false,"subcontractor_names":null,"subcontractor_eiks":null,"subcontracting_percent":null,"subcontracting_amount":null,"is_eu_funded":false,"eu_program":null,"is_framework":false,"direct_award_justification":"на основание чл.79, ал.1, т.3 бук. „в” от ЗОП Възложителите могат да възлагат ОП чрез процедура на договаряне без предварително обявление, когато ОП може да бъде изпълнена само от един изпълнител поради наличие на изключителни права. Обществените отношение , свързани с осъществяването на дейността по доставка на природен газ се уреждат в закона за енергетиката /ЗЕ/. На основание 39, ал.1 от ЗЕ , всички юридически лица , осъществяващи дейностите по разпределение и снабдяване с природен газ от крайни снабдители , подлежат на лицензиране от комисията за енергиино и водно реголиране /КЕВР/. Съгласно чл.43, ал2, т.1 и 2 А от ЗЕ за една обособена територия на страната се издава само една лицензия за осъществяване на дейностите разпределение на природен газ и снабдяване с природен гас от крайни снабдители. КЕВР е издала на \"Овергаз Мрежи\" АД за територията на Община Нови пазар лицензии № Л-438-08/30.03.2015Г. за разпределение на природен газ и № Л438-12/30.03.2015Г. за снабдяване с природен газ от краен сднабдител. Овергаз Мрежи АД притежава изключителни права за извършване на дейностите за разпределение и снабдяване с природен газ на Община Нови пазар. Предвид изложеното , на лице са основания ОП да бъде възложена чрез процедура на договаряне без предварително обявление по реда на чл.79, ал.1 т.3, бук.В от ЗОП по смисъла на & 2 т.47 от ДРЗОП предвид това считам че са на лице условията за прилагане на чл.79, ал.1, т.3, бук.В от ЗОП.4.\tНа основание чл.65, ал.1 от ППЗОП покана за участие няма да се изпраща , като договора ще бъде сключен с дружеството , притежаващи изключителни права за разпределение на природен газ и снабдяване с природен газ от краен снабдител на територията на Община Нови пазар - Овергаз  Мрежи АД с ЕИК 130553432.5.\tНа основание чл.65, ал.2 от ППЗОП възложителя ще сключи договор с изпълнител след влизане в сила на настоящото решение за откриване на процедурата . При подписването на договора определения изпълнител представя освен документите  по чл.112, ал.1, т.2 от ЗОП и декларация за липсата на обстоятелствата по чл.57, ал.1, т.7 от ЗОП.6.\tРешение №F451751/21.11.2023г. подлежи на обжалване пред КЗК . На основание чл.197, ал.1 , т.1 от ЗОП жалбата може да се подава в 10 дневен срок от изтичане на срока по чл.100, ал.3 от ЗОП  срещу решението за откриване на процедура.","offers_count":1,"sme_offers_count":0,"disqualified_offers_count":0,"contract_period_days":365,"ted_link":"https://ted.europa.eu/udl?uri=TED:NOTICE:014619-2024:TEXT:BG:HTML","imported_at":"2026-11-17T22:53:23.073929+00:00","contract_value_eur":63400.19,"estimated_value_eur":63400.19,"level":"общински","ekatte":"52009","settlement":"Нови пазар","is_village":false,"municipality":"Нови пазар","municipality_code":"SHU22","oblast":"Шумен"},{"id":"796792|LOT-0001|232723","notice_id":796792,"published_at":"2026-01-15T05:04:18+00:00","