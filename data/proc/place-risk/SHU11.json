антира постигане на целите и принципите, залегнали в чл. 1 и чл. 2 от ЗОП. Настоящата процедура ще се проведе на „Софийска стокова борса\" АД.","offers_count":1,"sme_offers_count":0,"disqualified_offers_count":0,"contract_period_days":1492,"ted_link":"https://ted.europa.eu/udl?uri=TED:NOTICE:044328-2024:TEXT:BG:HTML","imported_at":"2026-11-17T22:52:55.525552+00:00","contract_value_eur":373958.88,"estimated_value_eur":373370.9,"level":"общински","ekatte":"14516","settlement":"Хитрино","is_village":true,"municipality":"Хитрино","municipality_code":"SHU11","oblast":"Шумен"},{"id":"776208|LOT-0001|225053","notice_id":776208,"published_at":"2025-11-24T06:26:06+00:00","unp":"00172-2025-0005","tender_id":522423,"tender_name":"Зимно поддържане и снегопочистване на общинската пътна мрежа на територията на Община Хитрино","procedure_type":"Открита процедура","legal_basis":"Чл. 73, ал. 1 от ЗОП","award_method":"Най-ниска цена","cpv":"90620000","cpv_desc":"Услуги по почистване на улици от сняг","contract_type":"Услуги","estimated_value":700000,"currency":"BGN","buyer_eik":"000931422","buyer_name":"ОБЩИНА ХИТРИНО","buyer_type":"Местен орган","lot":"LOT-0001","contract_number":"225053","contract_date":"2025-10-31","contract_value":700000,"contract_currency":"BGN","supplier_eiks":["835009611"],"supplier_names":["ПЪТИНЖЕНЕРИНГСТРОЙ-Т ЕАД"],"supplier_nuts":["BG334"],"awarded_to_group":false,"has_subcontractors":false,"subcontractor_names":null,"subcontractor_eiks":null,"subcontracting_percent":null,"subcontracting_amount":null,"is_eu_funded":false,"eu_program":null,"is_framework":false,"direct_award_justification":null,"offers_count":1,"sme_offers_count":0,"disqualified_offers_count":0,"contract_period_days":730,"ted_link":"https://ted.europa.eu/udl?uri=TED:NOTICE:776228-2025:TEXT:BG:HTML","imported_at":"2026-11-17T13:55:57.288014+00:00","contract_value_eur":357904.32,"estimated_value_eur":357904.32,"level":"общински","ekatte":"14516","settlement":"Хитрино","is_village":true,"munici