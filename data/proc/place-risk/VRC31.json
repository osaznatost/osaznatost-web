арантира постигане на целите и принципите, залегнали в чл. 1 и чл. 2 от ЗОП, а именно: осигуряване на ефективност при разходване на средства; публичност и прозрачност; свободна и лоялна конкуренция; равни условия за участие в търговията и недопускане на дискриминация.","offers_count":1,"sme_offers_count":0,"disqualified_offers_count":0,"contract_period_days":1462,"ted_link":"https://ted.europa.eu/udl?uri=TED:NOTICE:006765-2024:TEXT:BG:HTML","imported_at":"2026-11-17T22:53:59.047887+00:00","contract_value_eur":244117.84,"estimated_value_eur":250533.02,"level":"общински","ekatte":"54020","settlement":"Оряхово","is_village":false,"municipality":"Оряхово","municipality_code":"VRC31","oblast":"Враца"},{"id":"535355|LOT-0001|144561","notice_id":535355,"published_at":"2024-06-03T17:33:16.643333+00:00","unp":"00491-2024-0008","tender_id":378769,"tender_name":"„Доставка на пътнически автобус за нуждите на Община Оряхово“","procedure_type":"Публично състезание","legal_basis":"Чл. 18, ал. 1, т. 12 от ЗОП","award_method":"Оптимално съотношение качество/цена","cpv":"34120000","cpv_desc":"Моторни превозни средства за превоз на десет или повече пътника","contract_type":"Доставки","estimated_value":270000,"currency":"BGN","buyer_eik":"000193414","buyer_name":"ОБЩИНА ОРЯХОВО","buyer_type":"Местен орган","lot":"LOT-0001","contract_number":"144561","contract_date":"2024-05-22","contract_value":264920,"contract_currency":"BGN","supplier_eiks":["813027681"],"supplier_names":["БУЛАВТО АД"],"supplier_nuts":[],"awarded_to_group":false,"has_subcontractors":false,"subcontractor_names":null,"subcontractor_eiks":null,"subcontracting_percent":null,"subcontracting_amount":null,"is_eu_funded":false,"eu_program":null,"is_framework":false,"direct_award_justification":null,"offers_count":1,"sme_offers_count":null,"disqualified_offers_count":0,"contract_period_days":5,"ted_link":null,"imported_at":"2026-11-17T22:48:45.544521+00:00","contract_value_eur":135451.45,"estimated_value_eur":138048.81,"level