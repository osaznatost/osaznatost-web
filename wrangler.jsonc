{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "osaznatost",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "run_worker_first": ["/_data/*"], "html_handling": "none", "not_found_handling": "none" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "osaznatost" }]
}
