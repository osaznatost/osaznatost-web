ter gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/statistiki\">← <!-- -->Всички показатели</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Доходи и неравенство</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Пъти по-богати: горните 20% спрямо долните 20%</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Колко пъти общият доход на най-богатите 20% е по-голям от този на най-бедните 20%.</div></div></div><div class=\"grid gap-3 sm:grid-cols-3 mb-10\"><div class=\"bg-surface rounded-sm p-4\"><p class=\"text-sm text-muted\">България<!-- -->, <!-- -->2025</p><p class=\"display text-[2.6rem] leading-none mt-1\">6,94</p><p class=\"text-xs text-muted mt-1\">пъти</p></div><div class=\"bg-surface rounded-sm p-4\"><p class=\"text-sm text-muted\">Промяна спрямо <!-- -->2024</p><p class=\"display text-[2.6rem] leading-none mt-1 text-[#1f7a4a]\">-0,02</p><p class=\"text-xs text-muted mt-1\">в добрата посока</p></div><div class=\"bg-surface rounded-sm p-4\"><p class=\"text-sm text-muted\">ЕС, <!-- -->2025</p><p class=\"display text-[2.6rem] leading-none mt-1\">4,62</p><p class=\"text-xs text-muted mt-1\">България е над средното за ЕС</p></div></div><section class=\"mb-10\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Във времето</h2></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><div class=\"w-full\"></div></div><p class=\"text-sm text-muted mt-2\">По-ниската стойност е по-добра за хората.</p></section><section class=\"mb-10\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Какво следва за хората</h2></div><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-1\">Когато расте</p><p class=\"text-[15px]\">Разликата между богати и бедни се разширява.</p></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-1\">Когато пада</p><p class=\"text-[15px]\">Разликата се стопява.</p></div></div></section><section class=\"mb-10\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Свързани показатели</h2></div><ul class=\"grid gap-3 md:grid-cols-2\"><li class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><a class=\"font-semibold\" href=\"/statistiki/gini\">Неравенство (коефициент на Джини)</a><span class=\"text-sm text-muted\"> · <!-- -->37,7<!-- --> (<!-- -->2025<!-- -->)</span><p class=\"text-[15px] mt-1\">Основният показател за неравенство.</p></li></ul></section><section class=\"mb-10\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Какво се движи заедно с него</h2></div><p class=\"text-[15px] text-muted -mt-3 mb-4 max-w-3xl\">Сравняваме годишните промени, а не самите стойности, за да не излизат връзки само защото всичко расте с времето. Корелацията показва, че две неща се движат заедно. Тя не доказва, че едното причинява другото.</p><div class=\"overflow-x-auto\"><table class=\"w-full text-[15px]\"><thead><tr class=\"text-left text-sm text-muted\"><th class=\"py-2 pr-3\">Показател</th><th class=\"py-2 pr-3\">Посока</th><th class=\"py-2 pr-3\">Сила</th><th class=\"py-2 pr-3 num\">r</th><th class=\"py-2 num hidden sm:table-cell\">Години</th></tr></thead><tbody><tr class=\"border-t border-rule\"><td class=\"py-2 pr-3\"><a href=\"/statistiki/gini\">Неравенство (коефициент на Джини)</a></td><td class=\"py-2 pr-3\">в една посока</td><td class=\"py-2 pr-3\">силна</td><td class=\"py-2 pr-3 num\">0,86</td><td class=\"py-2 num hidden sm:table-cell\">2007<!-- -->–<!-- -->2025<!-- --> (<!-- -->19<!-- -->)</td></tr><tr class=\"border-t border-rule\"><td class=\"py-2 pr-3\"><a href=\"/statistiki/overcrowding\">Пренаселени жилища</a></td><td class=\"py-2 pr-3\">в една посока</td><td class=\"py-2 pr-3\">силна</td><td class=\"py-2 pr-3 num\">0,74</td><td class=\"py-2 num hidden sm:table-cell\">2007<!-- -->–<!-- -->2025<!-- --> (<!-- -->19<!-- -->)</td></tr><tr class=\"border-t border-rule\"><td class=\"py-2 pr-3\"><a href=\"/statistiki/doctors\">Лекари</a></td><td class=\"py-2 pr-3\">в една посока</td><td class=\"py-2 pr-3\">умерена</td><td class=\"py-2 pr-3 num\">0,65</td><td class=\"py-2 num hidden sm:table-cell\">2011<!-- -->–<!-- -->2020<!-- --> (<!-- -->10<!-- -->)</td></tr><tr class=\"border-t border-rule\"><td class=\"py-2 pr-3\"><a href=\"/statistiki/housing_overburden\">Прекомерна тежест на жилищните разходи</a></td><td class=\"py-2 pr-3\">в една посока</td><td class=\"py-2 pr-3\">умерена</td><td class=\"py-2 pr-3 num\">0,56</td><td class=\"py-2 num hidden sm:table-cell\">2007<!-- -->–<!-- -->2025<!-- --> (<!-- -->19<!-- -->)</td></tr><tr class=\"border-t border-rule\"><td class=\"py-2 pr-3\"><a href=\"/statistiki/utility_arrears\">Закъснели сметки за ток, вода, парно</a></td><td class=\"py-2 pr-3\">в една посока</td><td class=\"py-2 pr-3\">умерена</td><td class=\"py-2 pr-3 num\">0,51</td><td class=\"py-2 num hidden sm:table-cell\">2007<!-- -->–<!-- -->2025<!-- --> (<!-- -->19<!-- -->)</td></tr><tr class=\"border-t border-rule\"><td class=\"py-2 pr-3\"><a href=\"/statistiki/house_prices\">Поскъпване на жилищата</a></td><td class=\"py-2 pr-3\">в една посока</td><td class=\"py-2 pr-3\">слаба</td><td class=\"py-2 pr-3 num\">0,48</td><td class=\"py-2 num hidden sm:table-cell\">2007<!-- -->–<!-- -->2025<!-- --> (<!-- -->19<!-- -->)</td></tr></tbody></table></div></section><p class=\"text-xs text-muted mb-10\">Източник: Евростат, набор <a href=\"https://ec.europa.eu/eurostat/databrowser/view/ilc_di11/default/table\" target=\"_blank\" rel=\"noreferrer\">ilc_di11</a> (<a href=\"https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data/ilc_di11?format=JSON&amp;lang=EN&amp;age=TOTAL&amp;sex=T&amp;geo=BG&amp;geo=EU27_2020&amp;geo=RO\" target=\"_blank\" rel=\"noreferrer\">заявката, от която са взети числата</a>).</p><section><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Още в „<!-- -->Доходи и неравенство<!-- -->“</h2></div><p class=\"flex flex-wrap gap-x-5 gap-y-2 text-[15px]\"><a href=\"/statistiki/min_wage_all\">Минимална работна заплата в евро</a><a href=\"/statistiki/min_wage_pps\">Минимална заплата при равни цени</a><a href=\"/statistiki/avg_wage\">Средна заплата на пълно работно време</a><a href=\"/statistiki/savings_rate\">Спестявания на домакинствата</a><a href=\"/statistiki/material_deprivation\">Тежки материални лишения</a><a href=\"/statistiki/household_debt\">Дълг на домакинствата</a><a href=\"/statistiki/min_wage\">Минимална работна заплата</a><a href=\"/statistiki/median_income\">Медианен нетен доход</a><a href=\"/statistiki/gini\">Неравенство (коефициент на Джини)</a><a href=\"/statistiki/poverty_risk\">Риск от бедност или социално изключване</a></p></section></div><!--$--><!--/$--></main><!--$--><!--/$--><footer class=\"bg-surface border-t border-rule mt-20\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 text-sm text-muted grid gap-2 sm:grid-cols-2\"><p>Не подкрепяме партия, кандидат или правителство. Всяко число има източник и дата.<!-- --> <a href=\"/metodologiya\">Как работим</a> · <a href=\"/rechnik\">Речник</a> · <a href=\"/sastoyanie\">Състояние на данните</a> · <!--$?--><template id=\"B:1\"></template><a href=\"/metodologiya#greshki\">Съобщи за грешка</a><!--/$--></p><p class=\"sm:text-right\">Вътрешен прототип · данните са към датите, посочени до тях</p></div></footer><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script id=\"_R_\">(globalThis[\"TURBOPACK\"] || (globalThis[\"TURBOPACK\"] = [])).push({\"otherChunks\":[\"static/chunks/310vm2bl3xxpt.js\",\"static/chunks/2vy51v46dlsq-.js\",\"static/chunks/2bx7ggprk0oi5.js\",\"static/chunks/0c1ad7rcpjghx.js\"],\"runtimeModuleIds\":[94553]});</script><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" async=\"\"></script><div hidden id=\"S:0\"><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4