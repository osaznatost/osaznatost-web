]}]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-green font-semibold mb-2\\\",\\\"children\\\":\\\"Автоматична сверка\\\"}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"display text-5xl sm:text-7xl max-w-4xl\\\",\\\"children\\\":\\\"Числата в парламента\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-3 text-lg text-muted max-w-3xl\\\",\\\"children\\\":[\\\"Всяка нощ програмата чете стенограмите на парламента, намира изказвания с конкретно число за инфлацията, безработицата, дълга, дефицита, растежа или минималната заплата и го сравнява с официалните данни на Евростат. Без изкуствен интелект и без човешка оценка: само правило. Обновено: \\\",\\\"23.11.2026\\\",\\\".\\\"]}]]}]}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"grid grid-cols-3 gap-3 mb-8 max-w-3xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"match\\\",{\\\"className\\\":\\\"bg-surface rounded-sm p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs font-semibold rounded-full px-2 py-0.5 w-fit bg-[#d7ecd9] text-[#1f5c2a]\\\",\\\"children\\\":\\\"Съвпада\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"display num text-[2rem] sm:text-[2.6rem] leading-none mt-2\\\",\\\"children\\\":1}]]}],[\\\"$\\\",\\\"div\\\",\\\"close\\\",{\\\"className\\\":\\\"bg-surface rounded-sm p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs font-semibold rounded-full px-2 py-0.5 w-fit bg-[#fdf3e6] text-[#8a4b0f]\\\",\\\"children\\\":\\\"Близо\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"display num text-[2rem] sm:text-[2.6rem] leading-none mt-2\\\",\\\"children\\\":0}]]}],[\\\"$\\\",\\\"div\\\",\\\"off\\\",{\\\"className\\\":\\\"bg-surface rounded-sm p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs font-semibold rounded-full px-2 py-0.5 w-fit bg-[#fdeff1] text-red\\\",\\\"children\\\":\\\"Разминава се\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"display num text-[2rem] sm:text-[2.6rem] leading-none mt-2\\\",\\\"children\\\":1}]]}]]}],[\\\"$\\\",\\\"details\\\",null,{\\\"className\\\":\\\"mb-8 max-w-4xl bg-surface rounded-sm p-4 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer font-semibold\\\",\\\"children\\\":\\\"Как работи и какво не прави\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"list-disc pl-5 mt-2 space-y-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Сравнява се само числото, не цялото твърдение. Думите около него (кой е виновен, какво следва) не се оценяват.\\\"}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Сверява се само когато периодът е ясен: изречението назовава една година (сравнява се с официалната стойност за нея) или говори за сегашното положение — „в момента“, „към днешна дата“ (сравнява се с последните публикувани данни).\\\"}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Нарочно строго: пропускат се бюджети и планове, предложения, хипотези („по стария механизъм щеше…“), преразказ на чужди думи, сравнения „спрямо“, нетни и годишни суми, различни методики (начислена/касова основа, дерогации). По-добре по-малко проверки, отколкото несправедливи.\\\"}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"„Над 20%“ и „под 3%“ се проверяват като неравенство, не като точно число.\\\"}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"„Съвпада“: разлика до 0,5 пункта (дълг — до 1,5 пункта; минимална заплата — до 2 €). „Близо“: до двойно повече. „Разминава се“: повече от това.\\\"}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Изказванията за прогнози, цели, други държави и еврозоната се пропускат. Ако човек е имал предвид друг показател (напр. инфлация на храните) или друг период, сверката може да е несправедлива — затова винаги има линк към стенограмата и към данните.\\\"}]]}]]}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-3 max-w-5xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"11139-31\