"match\",{\"className\":\"bg-surface rounded-sm p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold rounded-full px-2 py-0.5 w-fit bg-[#d7ecd9] text-[#1f5c2a]\",\"children\":\"Съвпада\"}],[\"$\",\"p\",null,{\"className\":\"display num text-[2rem] sm:text-[2.6rem] leading-none mt-2\",\"children\":1}]]}],[\"$\",\"div\",\"close\",{\"className\":\"bg-surface rounded-sm p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold rounded-full px-2 py-0.5 w-fit bg-[#fdf3e6] text-[#8a4b0f]\",\"children\":\"Близо\"}],[\"$\",\"p\",null,{\"className\":\"display num text-[2rem] sm:text-[2.6rem] leading-none mt-2\",\"children\":0}]]}],[\"$\",\"div\",\"off\",{\"className\":\"bg-surface rounded-sm p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold rounded-full px-2 py-0.5 w-fit bg-[#fdeff1] text-red\",\"children\":\"Разминава се\"}],[\"$\",\"p\",null,{\"className\":\"display num text-[2rem] sm:text-[2.6rem] leading-none mt-2\",\"children\":1}]]}]]}],[\"$\",\"details\",null,{\"className\":\"mb-8 max-w-4xl bg-surface rounded-sm p-4 text-[15px]\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold\",\"children\":\"Как работи и какво не прави\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 mt-2 space-y-1\",\"children\":[[\"$\",\"li\",null,{\"children\":\"Сравнява се само числото, не цялото твърдение. Думите около него (кой е виновен, какво следва) не се оценяват.\"}],[\"$\",\"li\",null,{\"children\":\"Сверява се само когато периодът е ясен: изречението назовава една година (сравнява се с официалната стойност за нея) или говори за сегашното положение — „в момента“, „към днешна дата“ (сравнява се с последните публикувани данни).\"}],[\"$\",\"li\",null,{\"children\":\"Нарочно строго: пропускат се бюджети и планове, предложения, хипотези („по стария механизъм щеше…“), преразказ на чужди думи, сравнения „спрямо“, нетни и годишни суми, различни методики (начислена/касова основа, дерогации). По-добре по-малко проверки, отколкото несправедливи.\"}],[\"$\",\"li\",null,{\"children\":\"„Над 20%“ и „под 3%“ се проверяват като неравенство, не като точно число.\"}],[\"$\",\"li\",null,{\"children\":\"„Съвпада“: разлика до 0,5 пункта (дълг — до 1,5 пункта; минимална заплата — до 2 €). „Близо“: до двойно повече. „Разминава се“: повече от това.\"}],[\"$\",\"li\",null,{\"children\":\"Изказванията за прогнози, цели, други държави и еврозоната се пропускат. Ако човек е имал предвид друг показател (напр. инфлация на храните) или друг период, сверката може да е несправедлива — затова винаги има линк към стенограмата и към данните.\"}]]}]]}],[\"$\",\"ul\",null,{\"className\":\"space-y-3 max-w-5xl\",\"children\":[[\"$\",\"li\",\"11139-31\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-x-3 gap-y-1\",\"children\":[\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\"]}],\"$L1d\",\"$L1e\"]}],\"$L1f\"]}],false]}]\n19:[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold rounded-full px-2.5 py-0.5 bg-[#fdeff1] text-red\",\"children\":\"Разминава се\"}]\n1a:[\"$\",\"span\",null,{\"className\":\"font-semibold\",\"children\":[\"$\",\"$L9\",null,{\"href\":\"/parlament/deputat/5234\",\"children\":\"Цончо Ганев\"}]}]\n1b:[\"$\",\"span\",null,{\"className\":\"text-sm text-muted\",\"children\":\"ВЪЗРАЖДАНЕ\"}]\n1c:[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11139\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm ml-auto\",\"children\":[\"стенограма, \",\"17.06.2026\"]}]\n1d:[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":[\"„\",\"Инфлацията и към днешна дата продължава да е над 20%, тоест огромно разминаване между официалната статистика, реалностите, в които живеем всички ние, и това, което се представя от официалните институции.\",\"“\"]}]\n1e:[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[[\"$\",\"b\",n