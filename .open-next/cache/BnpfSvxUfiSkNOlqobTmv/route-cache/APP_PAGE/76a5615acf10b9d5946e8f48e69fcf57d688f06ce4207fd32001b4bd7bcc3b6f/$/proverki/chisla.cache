,\"meta\",\"18\",{\"name\":\"twitter:image:height\",\"content\":\"630\"}],[\"$\",\"link\",\"19\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?favicon.117ezoe8m31dk.ico\",\"sizes\":\"48x48\",\"type\":\"image/x-icon\"}],\"$L1d\"]}]}],null]}],\"$L1e\"]}],\"p\":\"$@1f\",\"v\":null,\"s\":\"$c\"}},\"a\":\"$@20\",\"u\":\"$@21\",\"b\":\"BnpfSvxUfiSkNOlqobTmv\"}\n22:I[97367,[\"$2\"],\"OutletBoundary\"]\n24:I[27201,[\"$2\"],\"IconMark\"]\n13:[\"$\",\"p\",null,{\"className\":\"display num text-[2rem] sm:text-[2.6rem] leading-none mt-2\",\"children\":0}]\n14:[\"$\",\"div\",\"off\",{\"className\":\"bg-surface rounded-sm p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold rounded-full px-2 py-0.5 w-fit bg-[#fdeff1] text-red\",\"children\":\"Разминава се\"}],[\"$\",\"p\",null,{\"className\":\"display num text-[2rem] sm:text-[2.6rem] leading-none mt-2\",\"children\":1}]]}]\n15:[\"$\",\"details\",null,{\"className\":\"mb-8 max-w-4xl bg-surface rounded-sm p-4 text-[15px]\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold\",\"children\":\"Как работи и какво не прави\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 mt-2 space-y-1\",\"children\":[[\"$\",\"li\",null,{\"children\":\"Сравнява се само числото, не цялото твърдение. Думите около него (кой е виновен, какво следва) не се оценяват.\"}],[\"$\",\"li\",null,{\"children\":\"Сверява се само когато периодът е ясен: изречението назовава една година (сравнява се с официалната стойност за нея) или говори за сегашното положение — „в момента“, „към днешна дата“ (сравнява се с последните публикувани данни).\"}],[\"$\",\"li\",null,{\"children\":\"Нарочно строго: пропускат се бюджети и планове, предложения, хипотези („по стария механизъм щеше…“), преразказ на чужди думи, сравнения „спрямо“, нетни и годишни суми, различни методики (начислена/касова основа, дерогации). По-добре по-малко проверки, отколкото несправедливи.\"}],[\"$\",\"li\",null,{\"children\":\"„Над 20%“ и „под 3%“ се проверяват като неравенство, не като точно число.\"}],[\"$\",\"li\",null,{\"children\":\"„Съвпада“: разлика до 0,5 пункта (дълг — до 1,5 пункта; минимална заплата — до 2 €). „Близо“: до двойно повече. „Разминава се“: повече от това.\"}],[\"$\",\"li\",null,{\"children\":\"Изказванията за прогнози, цели, други държави и еврозоната се пропускат. Ако човек е имал предвид друг показател (напр. инфлация на храните) или друг период, сверката може да е несправедлива — затова винаги има линк към стенограмата и към данните.\"}]]}]]}]\n16:[\"$\",\"ul\",null,{\"className\":\"space-y-3 max-w-5xl\",\"children\":[[\"$\",\"li\",\"11139-31\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-x-3 gap-y-1\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold rounded-full px-2.5 py-0.5 bg-[#fdeff1] text-red\",\"children\":\"Разминава се\"}],[\"$\",\"span\",null,{\"className\":\"font-semibold\",\"children\":[\"$\",\"$L9\",null,{\"href\":\"/parlament/deputat/5234\",\"children\":\"Цончо Ганев\"}]}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted\",\"children\":\"ВЪЗРАЖДАНЕ\"}],[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11139\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm ml-auto\",\"children\":[\"стенограма, \",\"17.06.2026\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":[\"„\",\"Инфлацията и към днешна дата продължава да е над 20%, тоест огромно разминаване между официалната статистика, реалностите, в които живеем всички ние, и това, което се представя от официалните институции.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[[\"$\",\"b\",null,{\"children\":[\"годишна инфлация (ХИПЦ)\",\":\"]}],\" казано \",\"20%\",\"; официално \",\"6,3%\",\" за \",\"05.2026\",\" (\",[\"$\",\"a\",null,{\"href\":\"https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data/prc_hicp_minr?format=JSON&lang=EN&coicop18=TOTAL&unit=RCH_A&geo=BG&geo=EU27_2020&sinceTimePeriod=2025-01\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Евростат\"}],\")\",[\", разлика \",\"13,7\",\" пункта\"],\".\"]}]]}],[\"$\",\"li\",\"11102-4\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-x-3 gap-y-1\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold rounded-full px-2.5 py-0.5 bg-[#d7ecd9] text-[#1f5c2a]\",\"children\":\"Съвпада\"}],[\"$\",\"span\",null,{\"className\":\"font-semibold\",\"children\":[\"$\",\"$L9\",null,{\"href\":\"/parlament/deputat/5245\",\"children\":\"Мартин Димитров\"}]}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted\",\"children\":\"ПП-ДБ\"}],[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11102\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm ml-auto\",\"children\":[\"стенограма, \",\"11.02.2026\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":[\"„\",\"А годишната инфлация е по-ниска от 7%, тоест има други компенсиращи фактори за 2025 г.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[[\"$\",\"b\",null,{\"children\":[\"годишна инфлация (ХИПЦ)\",\":\"]}],\" казано \",\"7%\",\"; официално \",\"3,5%\",\" за \",\"2025\",\" (\",[\"$\",\"a\",null,{\"href\":\"https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data/prc_hicp_aind?format=JSON&lang=EN&coicop=CP00&unit=RCH_A_AVG&geo=BG&geo=EU27_2020&geo=RO&geo=GR&geo=HR\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Евростат\"}],\")\",false,\".\"]}]]}]]}]\n17:[\"$\",\"$L22\",null,{\"children\":[\"$\",\"$6\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@23\"}]}]\n1d:[\"$\",\"$L24\",\"20\",{}]\n1e:[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]\nc:300\n23:null\n21:true\nc:C\n20:0\n11:\"$u