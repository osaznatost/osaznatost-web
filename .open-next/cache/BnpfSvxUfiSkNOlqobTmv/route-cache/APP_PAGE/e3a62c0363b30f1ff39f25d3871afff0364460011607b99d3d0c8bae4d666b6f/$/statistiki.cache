-mt-12 mb-10\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\\\",\\\"children\\\":[\\\"$undefined\\\",\\\"$undefined\\\",[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"display text-5xl sm:text-7xl max-w-4xl\\\",\\\"children\\\":\\\"Статистики\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-3 text-lg text-muted max-w-3xl\\\",\\\"children\\\":\\\"Библиотека с 86 официални показателя за България, с история и сравнение с ЕС. Всеки показател има обяснение какво значи, какво следва за хората и с какво се движи заедно. Данни: Евростат, обновени на 20 ноември 2026 г.\\\"}]]}]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"-mt-4 mb-6 text-[15px]\\\",\\\"children\\\":[\\\"Търсиш връзките между цените, доходите и бюджета? Виж \\\",[\\\"$\\\",\\\"$La\\\",null,{\\\"href\\\":\\\"/statistiki/analiz\\\",\\\"children\\\":\\\"анализите по теми\\\"}],\\\".\\\"]}],[\\\"$\\\",\\\"$Lf\\\",null,{\\\"cards\\\":[{\\\"id\\\":\\\"homicide\\\",\\\"title\\\":\\\"Умишлени убийства\\\",\\\"topic\\\":\\\"Население\\\",\\\"unit\\\":\\\"на 100 000 души\\\",\\\"what\\\":\\\"Регистрирани от полицията умишлени убийства (по международната класификация ICCS).\\\",\\\"value\\\":\\\"1,23\\\",\\\"period\\\":\\\"2024\\\",\\\"change\\\":\\\"+0,08 спрямо 2023\\\",\\\"trend\\\":\\\"up\\\",\\\"good\\\":false,\\\"eu\\\":\\\"$undefined\\\"},{\\\"id\\\":\\\"trust_others\\\",\\\"title\\\":\\\"Доверие в другите хора\\\",\\\"topic\\\":\\\"Население\\\",\\\"unit\\\":\\\"оценка 0–10\\\",\\\"what\\\":\\\"Средната оценка от анкетата EU-SILC на въпроса доколко човек вярва, че на повечето хора може да се има доверие (0 = никак, 10 = напълно).\\\",\\\"value\\\":\\\"5,4\\\",\\\"period\\\":\\\"2025\\\",\\\"change\\\":\\\"0 спрямо 2024\\\",\\\"trend\\\":\\\"flat\\\",\\\"good\\\":null,\\\"eu\\\":\\\"5,8 (2025)\\\"},{\\\"id\\\":\\\"crime_area\\\",\\\"title\\\":\\\"Престъпност и вандализъм в квартала (по думите на хората)\\\",\\\"topic\\\":\\\"Население\\\",\\\"unit\\\":\\\"% от населението\\\",\\\"what\\\":\\\"Делът на хората, които казват, че в района, където живеят, има престъпност, насилие или вандализъм. Това е мнение от анкета (EU-SILC), а не полицейска статистика, затова показва и усещането за сигурност.\\\",\\\"value\\\":\\\"15,6\\\",\\\"period\\\":\\\"2023\\\",\\\"change\\\":\\\"-3,5 спрямо 2020\\\",\\\"trend\\\":\\\"down\\\",\\\"good\\\":true,\\\"eu\\\":\\\"10 (2023)\\\"},{\\\"id\\\":\\\"robbery\\\",\\\"title\\\":\\\"Грабежи\\\",\\\"topic\\\":\\\"Население\\\",\\\"unit\\\":\\\"на 100 000 души\\\",\\\"what\\\":\\\"Регистрирани от полицията грабежи: отнемане на вещи със сила или заплаха.\\\",\\\"value\\\":\\\"14,2\\\",\\\"period\\\":\\\"2024\\\",\\\"change\\\":\\\"+0,22 спрямо 2023\\\",\\\"trend\\\":\\\"up\\\",\\\"good\\\":false,\\\"eu\\\":\\\"$undefined\\\"},{\\\"id\\\":\\\"burglary\\\",\\\"title\\\":\\\"Кражби с взлом\\\",\\\"topic\\\":\\\"Население\\\",\\\"unit\\\":\\\"на 100 000 души\\\",\\\"what\\\":\\\"Регистрирани от полицията кражби с проникване в жилище или сграда. Зависи и от това колко хора съобщават в полицията.\\\",\\\"value\\\":\\\"46,1\\\",\\\"period\\\":\\\"2024\\\",\\\"change\\\":\\\"-5,67 спрямо 2023\\\",\\\"trend\\\":\\\"down\\\",\\\"good\\\":true,\\\"eu\\\":\\\"$undefined\\\"},{\\\"id\\\":\\\"tertiary_young\\\",\\\"title\\\":\\\"Млади хора с висше образование\\\",\\\"topic\\\":\\\"Образование и технологии\\\",\\\"unit\\\":\\\"% от 25–34 г.\\\",\\\"what\\\":\\\"Делът на хората на 25–34 години със завършено висше образование.\\\",\\\"value\\\":\\\"41,2\\\",\\\"period\\\":\\\"2025\\\",\\\"change\\\":\\\"+0,7 спрямо 2024\\\",\\\"trend\\\":\\\"up\\\",\\\"good\\\":true,\\\"eu\\\":\\\"44,8 (2025)\\\"},{\\\"id\\\":\\\"min_wage_all\\\",\\\"title\\\":\\\"Минимална работна заплата в евро\\\",\\\"topic\\\":\\\"Доходи и неравенство\\\",\\\"unit\\\":\\\"€ на месец\\\",\\\"what\\\":\\\"Минималната брутна месечна заплата по закон. Показва колко получава най-ниско платеният работник, преди данъци.\\\",\\\"value\\\":\\\"620\\\",\\\"period\\\":\\\"2026-S2\\\",\\\"change\\\":\\\"0 спрямо 2026-S1\\\",\\\"trend\\\":\\\"flat\\\",\\\"good\\\":null,\\\"eu\\\":\\\"$undefined\\\"},{\\\"id\\\":\\\"min_wage_pps\\\",\\\"title\\\":\\\"Минимална заплата при равни цени\\\",\\\"topic\\\":\\\"Доходи и неравенство\\\",\\\"unit\\\":\\\"стандарт на покупателна способност (PPS)\\\",\\\"what\\\":\\\"Минималната заплата, преизчислена така, че да отчита разликата в цените. Отговаря на въпроса колко неща реално купува, а не колко евро е.\\\",\\\"value\\\":\\\"993\\\",\\\"period\\\":\\\"2026-S2\\\",\\\"change\\\":\\\"0 спрямо 2026-S1\\\",\\\"trend\\\":\\\"flat\\\",\\\"good\\\":null,\\\"eu\\\":\\\"$undefined\\\"},{\\\"id\\\":\\\"avg_wage\\\",\\\"title\\\":\\\"Средна заплата на пълно работно време\\\",\\\"topic\\\":\\\"Доходи и неравенство\\\",\\\"unit\\\":\\\"€ на година\\\",\\\"what\\\":\\\"Средното годишно възнаграждение на един зает на пълно работно време (по националните сметки).\\\",\\\"value\\\":\\\"16 201\\\",\\\"period\\\":\\\"2025\\\",\\\"change\\\":\\\"+814 спрямо 2024\\\",\\\"trend\\\":\\\"up\\\",\\\"good\\\":true,\\\"eu\\\":\\\"41 464 (2025)\\\"},{\\\"id\\\":\\\"unmet_medical\\\",\\\"title\\\":\\\"Без лечение заради цена, разстояние или чакане\\\",\\\"topic\\\":\\\"Здраве\\\",\\\"unit\\\":\\\"% от хората над 16 г.\\\",\\\"what\\\":\\\"Делът на хората, които са имали нужда от лекар, но не са го посетили, защото е скъпо, далеч или чакането е дълго.\\\",\\\"value\\\":\\\"1\\\",\\\"period\\\":\\\"2025\\\",\\\"change\\\":\\\"-0,1 спрямо 2024\\\",\\\"trend\\\":\\\"down\\\",\\\"good\\\":true,\\\"eu\\\":\\\"2,4 (2025)\\\"},{\\\"id\\\":\\\"out_of_pocket\\\",\\\"title\\\":\\\"Разходи за здраве от джоба на пациента\\\",\\\"topic\\\":\\\"Здраве\\\",\\\"unit\\\":\\\"% от всички разходи за здраве\\\",\\\"what\\\":\\\"Каква част от разходите за здраве плащат хората директно: лекарства, такси, доплащания. В България е сред най-високите в ЕС.\\\",\\\"value\\\":\\\"34,1\\\",\\\"period\\\":\\\"2024\\\",\\\"change\\\":\\\"-1,39 спрямо 2023\\\",\\\"trend\\\":\\\"down\\\",\\\"good\\\":true,\\\"eu\\\":\\\"15,1 (2024)\\\"},{\\\"id\\\":\\\"hospital_beds\\\",\\\"title\\\":\\\"Болнични легла\\\",\\\"topic\\\":\\\"Здраве\\\",\\\"unit\\\":\\\"на 100 000 души\\\",\\\"what\\\":\\\"Брой болнични легла. Много легла не означава непременно добро лечение: може да показва и прекалено много хоспитализации.\\\",\\\"value\\\":\\\"870,3\\\",\\\"period\\\":\\\"2024\\\",\\\"change\\\":\\\"+5,93 спрямо 2023\\\",\\\"trend\\\":\\\"up\\\",\\\"good\\\":true,\\\"eu\\\":\\\"507,4 (2024)\\\"},{\\\"id\\\":\\\"healthy_years\\\",\\\"title\\\":\\\"Години здравословен живот\\\",\\\"topic\\\":\\\"Здраве\\\",\\\"unit\\\":\\\"години при раждане\\\",\\\"what\\\":\\\"Колко години се очаква да живее човек без сериозни здравни ограничения.\\\",\\\"value\\\":\\\"69,1\\\",\\\"period\\\":\\\"2024\\\",\\\"change\\\":\\\"+0,5 спрямо 2023\\\",\\\"trend\\\":\\\"up\\\",\\\"good\\\":true,\\\"eu\\\":\\\"65,2 (2024)\\\"},{\\\"id\\\":\\\"preventable_deaths\\\",\\\"title\\\":\\\"Предотвратими смъртни случаи\\\",\\\"topic\\\":\\\"Здраве\\\",\\\"unit\\\":\\\"на 100 000 души\\\",\\\"what\\\":\\\"Смъртни случаи, които могат да бъдат избегнати чрез профилактика и обществено здраве (тютюн, алкохол, катастрофи, ваксини).\\\",\\\"value\\\":\\\"220,1\\\",\\\"period\\\":\\\"2023\\\",\\\"change\\\":\\\"-56,5 спрямо 2022\\\",\\\"trend\\\":\\\"down\\\",\\\"good\\\":true,\\\"eu\\\":\\\"150,9 (2023)\\\"},{\\\"id\\\":\\\"savings_rate\\\",\\\"title\\\":\\\"Спестявания на домакинствата\\\",\\\"topic\\\":\\\"Доходи и неравенство\\\",\\\"unit\\\":\\\"% от разполагаемия доход\\\",\\\"what\\\":\\\"Каква част от дохода си домакинствата не харчат. Ниска или отрицателна стойност означава, че живеят на заем или от спестявания.\\\",\\\"value\\\":\\\"-6,63\\\",\\\"period\\\":\\\"2022\\\",\\\"change\\\":\\\"-1,07 спрямо 2021\\\",\\\"trend\\\":\\\"down\\\",\\\"good\\\":false,\\\"eu\\\":\\\"14,3 (2025)\\\"},{\\\"id\\\":\\\"tax_burden\\\",\\\"title\\\":\\\"Данъчна тежест\\\",\\\"topic\\\":\\\"Публични финанси\\\",\\\"unit\\\":\\\"% от БВП\\\",\\\"what\\\":\\\"Всички данъци и осигуровки като дял от икономиката. В България е сред най-ниските в ЕС.\\\",\\\"value\\\":\\\"30,6\\\",\\\"period\\\":\\\"2025\\\",\\\"change\\\":\\\"+0,3 спрямо 2024\\\",\\\"trend\\\":\\\"up\\\",\\\"good\\\":false,\\\"eu\\\":\\\"40,7 (2025)\\\"},{\\\"id\\\":\\\"housing_overburden\\\",\\\"title\\\":\\\"Прекомерна тежест на жилищните разходи\\\",\\\"topic\\\":\\\"Жилища\\\",\\\"unit\\\":\\\"% от населението\\\",\\\"what\\\":\\\"Делът на хората, чиито разходи за жилище (наем, ипотека, сметки) са над 40% от дохода.\\\",\\\"value\\\":\\\"6,9\\\",\\\"period\\\":\\\"2025\\\",\\\"change\\\":\\\"-1,1 спрямо 2024\\\",\\\"trend\\\":\\\"down\\\",\\\"good\\\":true,\\\"eu\\\":\\\"7,6 (2025)\\\"},{\\\"id\\\":\\\"cold_home\\\",\\\"title\\\":\\\"Не могат да отопляват дома си\\\",\\\"topic\\\":\\\"Жилища\\\",\\\"unit\\\":\\\"% от населението\\\",\\\"what\\\":\\\"Делът на хората, които казват, че не могат да поддържат жилището си достатъчно топло. Мярка за енергийна бедност.\\\",\\\"value\\\":\\\"16,1\\\",\\\"period\\\":\\\"2025\\\",\\\"change\\\":\\\"-2,9 спрямо 2024\\\",\\\"trend\\\":\\\"down\\\",\\\"good\\\":true,\\\"eu\\\":\\\"8,8 (2025)\\\"},{\\\"id\\\":\\\"utility_arrears\\\",\\\"title\\\":\\\"Закъснели сметки за ток, вода, парно\\\",\\\"topic\\\":\\\"Жилища\\\",\\\"unit\\\":\\\"% от населението\\\",\\\"what\\\":\\\"Делът на хората, които са закъснели с плащане на комунални сметки поради липса на пари.\\\",\\\"value\\\":\\\"17,2\\\",\\\"period\\\":\\\"2025\\\",\\\"change\\\":\\\"-0,4 спрямо 2024\\\",\\\"trend\\\":\\\"down\\\",\\\"good\\\":true,\\\"eu\\\":\\\"7 (2025)\\\"},{\\\"id\\\":\\\"material_deprivation\\\",\\\"title\\\":\\\"Тежки материални лишения\\\",\\\"topic\\\":\\\"Доходи и неравенство\\\",\\\"unit\\\":\\\"% от населението\\\",\\\"what\\\":\\\"Хора, които не могат да си позволят поне 7 от 13 основни неща (непредвиден разход, почивка, месо през ден, отопление и др.).\\\",\\\"value\\\":\\\"15\\\",\\\"period\\\":\\\"2025\\\",\\\"change\\\":\\\"-1,6 спрямо 2024\\\",\\\"trend\\\":\\\"down\\\",\\\"good\\\":true,\\\"eu\\\":\\\"6,3 (2025)\\\"},{\\\"id\\\":\\\"median_age\\\",\\\"title\\\":\\\"Медианна възраст\\\",\\\"topic\\\":\\\"Население\\\",\\\"unit\\\":\\\"години\\\",\\\"what\\\":\\\"Половината население е по-младо, а половината по-възрастно от тази възраст.\\\",\\\"value\\\":\\\"47,3\\\",\\\"period\\\":\\\"2025\\\",\\\"change\\\":\\\"+0,2 спрямо 2024\\\",\\\"trend\\\":\\\"up\\\",\\\"good\\\":false,\\\"eu\\\":\\\"44,9 (2025)\\\"},{\\\"id\\\":\\\"old_dependency\\\",\\\"title\\\":\\\"Възрастни на 100 души в трудоспособна възраст\\\",\\\"topic\\\":\\\"Население\\\",\\\"unit\\\":\\\"души 65+ на 100 души 15–64 г.\\\",\\\"what\\\":\\\"Колко души над 65 години се падат на 100 души в трудоспособна възраст. Показва натиска върху пенсионната система.\\\",\\\"value\\\":\\\"38,7\\\",\\\"period\\\":\\\"2025\\\",\\\"change\\\":\\\"+0,5 спрямо 2024\\\",\\\"trend\\\":\\\"up\\\",\\\"good\\\":false,\\\"eu\\\":\\\"34,4 (2025)\\\"},{\\\"id\\\":\\\"share_65plus\\\",\\\"title\\\":\\\"Дял на хората над 65\\\",\\\"topic\\\":\\\"Население\\\",\\\"unit\\\":\\\"% от населението\\\",\\\"what\\\":\\\"Каква част от населението е над 65 години.\\\",\\\"value\\\":\\\"24\\\",\\\"period\\\":\\\"2025\\\",\\\"change\\\":\\\"+0,2 спрямо 2024\\\",\\\"trend\\\":\\\"up\\\",\\\"good\\\":false,\\\"eu\\\":\\\"21,9 (2025)\\\"},{\\\"id\\\":\\\"births\\\",\\\"title\\\":\\\"Родени деца\\\",\\\"topic\\\":\\\"Население\\\",\\\"unit\\\":\\\"брой за година\\\",\\\"what\\\":\\\"Колко деца са родени в България за годината.\\\",\\\"value\\\":\\\"50 241\\\",\\\"period\\\":\\\"2025\\\",\\\"change\\\":\\\"-3187 спрямо 2024\\\",\\\"trend\\\":\\\"down\\\",\\\"good\\\":false,\\\"eu\\\":\\\"$undefined\\\"},{\\\"id\\\":\\\"deaths\\\",\\\"title\\\":\\\"Починали\\\",\\\"topic\\\":\\\"Население\\\",\\\"unit\\\":\\\"брой за година\\\",\\\"what\\\":\\\"Ко