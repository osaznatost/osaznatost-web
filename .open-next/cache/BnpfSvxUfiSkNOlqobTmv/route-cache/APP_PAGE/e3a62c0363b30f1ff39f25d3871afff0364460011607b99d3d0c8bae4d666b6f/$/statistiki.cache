fined\",[\"$\",\"h1\",null,{\"className\":\"display text-5xl sm:text-7xl max-w-4xl\",\"children\":\"Статистики\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-lg text-muted max-w-3xl\",\"children\":\"Библиотека с 86 официални показателя за България, с история и сравнение с ЕС. Всеки показател има обяснение какво значи, какво следва за хората и с какво се движи заедно. Данни: Евростат, обновени на 20 ноември 2026 г.\"}]]}]}],[\"$\",\"p\",null,{\"className\":\"-mt-4 mb-6 text-[15px]\",\"children\":[\"Търсиш връзките между цените, доходите и бюджета? Виж \",[\"$\",\"$La\",null,{\"href\":\"/statistiki/analiz\",\"children\":\"анализите по теми\"}],\".\"]}],[\"$\",\"$Lf\",null,{\"cards\":[{\"id\":\"homicide\",\"title\":\"Умишлени убийства\",\"topic\":\"Население\",\"unit\":\"на 100 000 души\",\"what\":\"Регистрирани от полицията умишлени убийства (по международната класификация ICCS).\",\"value\":\"1,23\",\"period\":\"2024\",\"change\":\"+0,08 спрямо 2023\",\"trend\":\"up\",\"good\":false,\"eu\":\"$undefined\"},{\"id\":\"trust_others\",\"title\":\"Доверие в другите хора\",\"topic\":\"Население\",\"unit\":\"оценка 0–10\",\"what\":\"Средната оценка от анкетата EU-SILC на въпроса доколко човек вярва, че на повечето хора може да се има доверие (0 = никак, 10 = напълно).\",\"value\":\"5,4\",\"period\":\"2025\",\"change\":\"0 спрямо 2024\",\"trend\":\"flat\",\"good\":null,\"eu\":\"5,8 (2025)\"},{\"id\":\"crime_area\",\"title\":\"Престъпност и вандализъм в квартала (по думите на хората)\",\"topic\":\"Население\",\"unit\":\"% от населението\",\"what\":\"Делът на хората, които казват, че в района, където живеят, има престъпност, насилие или вандализъм. Това е мнение от анкета (EU-SILC), а не полицейска статистика, затова показва и усещането за сигурност.\",\"value\":\"15,6\",\"period\":\"2023\",\"change\":\"-3,5 спрямо 2020\",\"trend\":\"down\",\"good\":true,\"eu\":\"10 (2023)\"},{\"id\":\"robbery\",\"title\":\"Грабежи\",\"topic\":\"Население\",\"unit\":\"на 100 000 души\",\"what\":\"Регистрирани от полицията грабежи: отнемане на вещи със сила или заплаха.\",\"value\":\"14,2\",\"period\":\"2024\",\"change\":\"+0,22 спрямо 2023\",\"trend\":\"up\",\"good\":false,\"eu\":\"$undefined\"},{\"id\":\"burglary\",\"title\":\"Кражби с взлом\",\"topic\":\"Население\",\"unit\":\"на 100 000 души\",\"what\":\"Регистрирани от полицията кражби с проникване в жилище или сграда. Зависи и от това колко хора съобщават в полицията.\",\"value\":\"46,1\",\"period\":\"2024\",\"change\":\"-5,67 спрямо 2023\",\"trend\":\"down\",\"good\":true,\"eu\":\"$undefined\"},{\"id\":\"tertiary_young\",\"title\":\"Млади хора с висше образование\",\"topic\":\"Образование и технологии\",\"unit\":\"% от 25–34 г.\",\"what\":\"Делът на хората на 25–34 години със завършено висше образование.\",\"value\":\"41,2\",\"period\":\"2025\",\"change\":\"+0,7 спрямо 2024\",\"trend\":\"up\",\"good\":true,\"eu\":\"44,8 (2025)\"},{\"id\":\"min_wage_all\",\"title\":\"Минимална работна заплата в евро\",\"topic\":\"Доходи и неравенство\",\"unit\":\"€ на месец\",\"what\":\"Минималната брутна месечна заплата по закон. Показва колко получава най-ниско платеният работник, преди данъци.\",\"value\":\"620\",\"period\":\"2026-S2\",\"change\":\"0 спрямо 2026-S1\",\"trend\":\"flat\",\"good\":null,\"eu\":\"$undefined\"},{\"id\":\"min_wage_pps\",\"title\":\"Минимална заплата при равни цени\",\"topic\":\"Доходи и неравенство\",\"unit\":\"стандарт на покупателна способност (PPS)\",\"what\":\"Минималната заплата, преизчислена така, че да отчита разликата в цените. Отговаря на въпроса колко неща реално купува, а не колко евро е.\",\"value\":\"993\",\"period\":\"2026-S2\",\"change\":\"0 спрямо 2026-S1\",\"trend\":\"flat\",\"good\":null,\"eu\":\"$undefined\"},{\"id\":\"avg_wage\",\"title\":\"Средна заплата на пълно работно време\",\"topic\":\"Доходи и неравенство\",\"unit\":\"€ на година\",\"what\":\"Средното годишно възнаграждение на един зает на пълно работно време (по националните сметки).\",\"value\":\"16 201\",\"period\":\"2025\",\"change\":\"+814 спрямо 2024\",\"trend\":\"up\",\"good\":true,\"eu\":\"41 464 (2025)\"},{\"id\":\"unmet_medical\",\"title\":\"Без лечение заради цена, разстояние или чакане\",\"topic\":\"Здраве\",\"unit\":\"% от хората над 16 г.\",\"what\":\"Делът на хората, които са имали нужда от лекар, но не са го посетили, защото е скъпо, далеч или чакането е дълго.\",\"value\":\"1\",\"period\":\"2025\",\"change\":\"-0,1 спрямо 2024\",\"trend\":\"down\",\"good\":true,\"eu\":\"2,4 (2025)\"},{\"id\":\"out_of_pocket\",\"title\":\"Разходи за здраве от джоба на пациента\",\"topic\":\"Здраве\",\"unit\":\"% от всички разходи за здраве\",\"what\":\"Каква част от разходите за здраве плащат хората директно: лекарства, такси, доплащания. В България е сред най-високите в ЕС.\",\"value\":\"34,1\",\"period\":\"2024\",\"change\":\"-1,39 спрямо 2023\",\"trend\":\"down\",\"good\":true,\"eu\":\"15,1 (2024)\"},{\"id\":\"hospital_beds\",\"title\":\"Болнични легла\",\"topic\":\"Здраве\",\"unit\":\"на 100 000 души\",\"what\":\"Брой болнични легла. Много легла не означава непременно добро лечение: може да показва и прекалено много хоспитализации.\",\"value\":\"870,3\",\"period\":\"2024\",\"change\":\"+5,93 спрямо 2023\",\"trend\":\"up\",\"good\":true,\"eu\":\"507,4 (2024)\"},{\"id\":\"healthy_years\",\"title\":\"Години здравословен живот\",\"topic\":\"Здраве\",\"unit\":\"години при раждане\",\"what\":\"Колко години се очаква да живее човек без сериозни здравни ограничения.\",\"value\":\"69,1\",\"period\":\"2024\",\"change\":\"+0,5 спрямо 2023\",\"trend\":\"up\",\"good\":true,\"eu\":\"65,2 (2024)\"},{\"id\":\"preventable_deaths\",\"title\":\"Предотвратими смъртни случаи\",\"topic\":\"Здраве\",\"unit\":\"на 100 000 души\",\"what\":\"Смъртни случаи, които могат да бъдат избегнати чрез профилактика и обществено здраве (тютюн, алкохол, катастрофи, ваксини).\",\"value\":\"220,1\",\"period\":\"2023\",\"change\":\"-56,5 спрямо 2022\",\"trend\":\"down\",\"good\":true,\"eu\":\"150,9 (2023)\"},{\"id\":\"savings_rate\",\"title\":\"Спестявания на домакинствата\",\"topic\":\"Доходи и неравенство\",\"unit\":\"% от разполагаемия доход\",\"what\":\"Каква част от дохода си домакинствата не харчат. Ниска или отрицателна стойност означава, че живеят на заем или от спестявания.\",\"value\":\"-6,63\",\"period\":\"2022\",\"change\":\"-1,07 спрямо 2021\",\"trend\":\"down\",\"good\":false,\"eu\":\"14,3 (2025)\"},{\"id\":\"tax_burden\",\"title\":\"Данъчна тежест\",\"topic\":\"Публични финанси\",\"unit\":\"% от БВП\",\"what\":\"Всички данъци и осигуровки като дял от икономиката. В България е сред най-ниските в ЕС.\",\"value\":\"30,6\",\"period\":\"2025\",\"change\":\"+0,3 спрямо 2024\",\"trend\":\"up\",\"good\":false,\"eu\":\"40,7 (2025)\"},{\"id\":\"housing_overburden\",\"title\":\"Прекомерна тежест на жилищните разходи\",\"topic\":\"Жилища\",\"unit\":\"% от населението\",\"what\":\"Делът на хората, чиито разходи за жилище (наем, ипотека, сметки) са над 40% от дохода.\",\"value\":\"6,9\",\"period\":\"2025\",\"change\":\"-1,1 спрямо 2024\",\"trend\":\"down\",\"good\":true,\"eu\":\"7,6 (2025)\"},{\"id\":\"cold_home\",\"title\":\"Не могат да отопляват дома си\",\"topic\":\"Жилища\",\"unit\":\"% от населението\",\"what\":\"Делът на хората, които казват, че не могат да поддържат жилището си достатъчно топло. Мярка за енергийна бедност.\",\"value\":\"16,1\",\"period\":\"2025\",\"change\":\"-2,9 спрямо 2024\",\"trend\":\"down\",\"good\":true,\"eu\":\"8,8 (2025)\"},{\"id\":\"utility_arrears\",\"title\":\"Закъснели сметки за ток, вода, парно\",\"topic\":\"Жилища\",\"unit\":\"% от населението\",\"what\":\"Делът на хората, които са закъснели с плащане на комунални сметки поради липса на пари.\",\"value\":\"17,2\",\"period\":\"2025\",\"change\":\"-0,4 спрямо 2024\",\"trend\":\"down\",\"good\":true,\"eu\":\"7 (2025)\"},{\"id\":\"material_deprivation\",\"title\":\"Тежки материални лишения\",\"topic\":\"Доходи и неравенство\",\"unit\":\"% от населението\",\"what\":\"Хора, които не могат да си позволят поне 7 от 13 основни неща (непредвиден разход, почивка, месо през ден, отопление и др.).\",\"value\":\"15\",\"period\":\"2025\",\"change\":\"-1,6 спрямо 2024\",\"trend\":\"down\",\"good\":true,\"eu\":\"6,3 (2025)\"},{\"id\":\"median_age\",\"title\":\"Медианна възраст\",\"topic\":\"Население\",\"unit\":\"години\",\"what\":\"Половината население е по-младо, а половината по-възрастно от тази възраст.\",\"value\":\"47,3\",\"period\":\"2025\",\"change\":\"+0,2 спрямо 2024\",\"trend\":\"up\",\"good\":false,\"eu\":\"44,9 (2025)\"},{\"id\":\"old_dependency\",\"title\":\"Възрастни на 100 души в трудоспособна възраст\",\"topic\":\"Население\",\"unit\":\"души 65+ на 100 души 15–64 г.\",\"what\":\"Колко души над 65 години се падат на 100 души в трудоспособна възраст. Показва натиска върху пенсионната система.\",\"value\":\"38,7\",\"period\":\"2025\",\"change\":\"+0,5 спрямо 2024\",\"trend\":\"up\",\"good\":false,\"eu\":\"34,4 (2025)\"},{\"id\":\"share_65plus\",\"title\":\"Дял на хората над 65\",\"topic\":\"Население\",\"unit\":\"% от населението\",\"what\":\"Каква част от населението е над 65 години.\",\"value\":\"24\",\"period\":\"2025\",\"change\":\"+0,2 спрямо 2024\",\"trend\":\"up\",\"good\":false,\"eu\":\"21,9 (2025)\"},{\"id\":\"births\",\"title\":\"Родени деца\",\"topic\":\"Население\",\"unit\":\"брой за година\",\"what\":\"Колко деца са родени в България за годината.\",\"value\":\"50 241\",\"period\":\"2025\",\"change\":\"-3187 спрямо 2024\",\"trend\":\"down\",\"good\":false,\"eu\":\"$undefined\"},{\"id\":\"deaths\",\"title\":\"Починали\",\"topic\":\"Население\",\"unit\":\"брой за година\",\"what\":\"Колко души са починали за годината. Разликата с родените е естественият прираст.\",\"value\":\"99 479\",\"period\":\"2025\",\"change\":\"-1257 спрямо 2024\",\"trend\":\"down\",\"good\":true,\"eu\":\"$undefined\"},{\"id\":\"neet\",\"title\":\"Млади без работа и без учене\",\"topic\":\"Образование и технологии\",\"unit\":\"% от 15–29 г.\",\"what\":\"Делът на младите, които нито работят, нито учат, нито се обучават.\",\"value\":\"13,8\",\"period\":\"2025\",\"change\":\"+1,1 спрямо 2024\",\"trend\":\"up\",\"good\":false,\"eu\":\"11 (2025)\"},{\"id\":\"rnd\",\"title\":\"Разходи за научни изследвания\",\"topic\":\"Образование и технологии\",\"unit\":\"% от БВП\",\"what\":\"Колко харчат държавата и фирмите за наука и разработки.\",\"value\":\"0,74\",\"period\":\"2025\",\"change\":\"-0,03 спрямо 2024\",\"trend\":\"down\",\"good\":false,\"eu\":\"2,26 (2024)\"},{\"id\":\"productivity\",\"title\":\"Ръст на производителността на труда\",\"topic\":\"Растеж и инвестиции\",\"unit\":\"% годишно\",\"what\":\"С колко се увеличава реално произведеното от един зает.\",\"value\":\"0,8\",\"period\":\"2025\",\"change\":\"-1,4 спрямо 2024\",\"trend\":\"down\",\"good\":false,\"eu\":\"0,9 (2025)\"},{\"id\":\"pm25_deaths\",\"title\":\"Преждевременни смъртни случаи от фини прахови частици (PM2.5)\",\"topic\":\"Околна среда и пътища\",\"unit\":\"на 100 000 души\",\"what\":\"Оценка на Европейската агенция по околна среда колко хора умират преждевременно заради дългосрочно дишане на замърсен въздух.\",\"value\":\"104\",\"period\":\"2023\",\"change\":\"-24 спрямо 2022\",\"trend\":\"down\",\"good\":true,\"eu\":\"41 (2023)\"},{\"id\":\"pension_spending\",\"title\":\"Разходи за пенсии\",\"topic\":\"Публични финанси\",\"unit\":\"% от БВП\",\"what\":\"Колко харчи държавата за пенсии за старост.\",\"value\":\"9,4\",\"period\":\"2024\",\"change\":\"+0,2 спрямо 2023\",\"trend\":\"up\",\"good\":null,\"eu\":\"10,6 (2024)\"},{\"id\":\"health_gov_spending\",\"title\":\"Държавни разходи за здраве\",\"topic\":\"Публични финанси\",\"unit\":\"% от БВП\",\"what\":\"Колко харчи държавата (вкл. здравната каса) за здравеопазване.\",\"value\":\"5,4\",\"period\":\"2024\",\"change\":\"0 спрямо 2023\",\"trend\":\"flat\",\"good\":null,\"eu\":\"7,3 (2024)\"},{\"id\":\"education_spending\",\"title\":\"Държавни разходи за образование\",\"topic\":\"Публични финанси\",\"unit\":\"% от БВП\",\"what\":\"Колко харчи държавата за образование.\",\"value\":\"4,3\",\"period\":\"2024\",\"change\":\"+0,2 спрямо 2023\",\"trend\":\"up\",\"good\":true,\"eu\":\"4,7 (2024)\"},{\"id\":\"defence_spending\",\"title\":\"Държавни разходи за отбрана\",\"topic\":\"Публични финанси\",\"unit\":\"% от БВП\",\"what\":\"Колко харчи държавата за армия и отбрана (по класификацията COFOG, може да се различава от отчитането към НАТО).\",\"value\":\"1,3\",\"period\":\"2024\",\"change\":\"-0,2 спрямо 2023\",\"trend\":\"down\",\"good\":null,\"eu\":\"1,5 (2024)\"},{\"id\":\"police_spending\",\"title\":\"Разходи за полиция, съд и затвори\",\"topic\":\"Публични финанси\",\"unit\":\"% от БВП\",\"what\":\"Обществен ред и сигурност: МВР, съдилища, прокуратура, затвори.\",\"value\":\"2,8\",\"period\":\"2024\",\"change\":\"+0,2 спрямо 2023\",\"trend\":\"up\",\"good\":null,\"eu\":\"1,7 (2024)\"},{\"id\":\"roads_spending\",\"title\":\"Разходи за икономически дейности\",\"topic\":\"Публични финанси\",\"unit\":\"% от БВП\",\"what\":\"Пътища, транспорт, енергетика, земеделие, субсидии за фирми.\",\"value\":\"5,8\",\"period\":\"2024\",\"change\":\"0 спрямо 2023\",\"trend\":\"flat\",\"good\":null,\"eu\":\"5,3 (2024)\"},{\"id\":\"gov_wages\",\"title\":\"Заплати в държавния сектор\",\"topic\":\"Публични финанси\",\"unit\":\"% от БВП\",\"what\":\"Колко харчи държавата за заплати на служителите си.\",\"value\":\"12,3\",\"period\":\"2025\",\"change\":\"+1 спрямо 2024\",\"trend\":\"up\",\"good\":null,\"eu\":\"10,3 (2025)\"},{\"id\":\"current_account\",\"title\":\"Текуща сметка с чужбина\",\"topic\":\"Растеж и инвестиции\",\"unit\":\"% от БВП\",\"what\":\"Разликата между това, което страната получава от чужбина (износ, доходи, преводи) и което плаща. Отрицателна стойност = харчим повече, отколкото изкарваме навън.\",\"value\":\"-8,2\",\"period\":\"2026-Q2\",\"change\":\"+1,6 спрямо 2026-Q1\",\"trend\":\"up\",\"good\":true,\"eu\":\"$undefined\"},{\"id\":\"household_debt\",\"title\":\"Дълг на домакинствата\",\"topic\":\"Доходи и неравенство\",\"unit\":\"% от БВП\",\"what\":\"Кредитите на домакинствата (ипотеки, потребителски) като дял от икономиката.\",\"value\":\"28,2\",\"period\":\"2025\",\"change\":\"+2,6 спрямо 2024\",\"trend\":\"up\",\"good\":false,\"eu\":\"49,2 (2025)\"},{\"id\":\"inflation\",\"title\":\"Инфлация (годишна)\",\"topic\":\"Цени\",\"unit\":\"% за година\",\"what\":\"С колко средно са поскъпнали стоките и услугите за година по хармонизирания индекс на потребителските цени (ХИПЦ), който е еднакъв за целия ЕС.\",\"value\":\"3,5\",\"period\":\"2025\",\"change\":\"+0,9 спрямо 2024\",\"trend\":\"up\",\"good\":null,\"eu\":\"2,5 (2025)\"},{\"id\":\"inflation_food\",\"title\":\"Поскъпване на храните\",\"topic\":\"Цени\",\"unit\":\"% за година\",\"what\":\"Годишното изменение на цените на храните и безалкохолните напитки.\",\"value\":\"6,2\",\"period\":\"2025\",\"change\":\"+3,4 спрямо 2024\",\"trend\":\"up\",\"good\":false,\"eu\":\"3,3 (2025)\"},{\"id\":\"inflation_energy\",\"title\":\"Поскъпване на енергията\",\"topic\":\"Цени\",\"unit\":\"% за година\",\"what\":\"Годишното изменение на цените на ток, парно, газ и горива за домакинствата.\",\"value\":\"0,6\",\"period\":\"2025\",\"change\":\"+2 спрямо 2024\",\"trend\":\"up\",\"good\":false,\"eu\":\"-0,6 (2025)\"},{\"id\":\"inflation_rent\",\"title\":\"Поскъпване на наемите\",\"topic\":\"Цени\",\"unit\":\"% за година\",\"what\":\"Годишното изменение на наемите, които плащат домакинствата.\",\"value\":\"9,6\",\"period\":\"2025\",\"change\":\"+4 спрямо 2024\",\"trend\":\"up\",\"good\":false,\"eu\":\"3,1 (2025)\"},{\"id\":\"inflation_monthly\",\"title\":\"Инфлация по месеци (2022–2025)\",\"topic\":\"Цени\",\"unit\":\"% спрямо същия месец на миналата година\",\"what\":\"Годишната инфлация, измерена всеки месец. Показва кога точно цените ускоряват или забавят.\",\"value\":\"3,5\",\"period\":\"12.2025\",\"change\":\"-0,2 спрямо 11.2025\",\"trend\":\"down\",\"good\":null,\"eu\":\"2,3 (12.2025)\"},{\"id\":\"inflation_monthly_2026\",\"title\":\"Инфлация по месеци (2025–2026)\",\"topic\":\"Цени\",\"unit\":\"% спрямо същия месец на миналата година\",\"what\":\"Месечната годишна инфлация след въвеждането на еврото, по новата класификация COICOP 2018 на Евростат.\",\"value\":\"5,9\",\"period\":\"10.2026\",\"change\":\"+0,3 спрямо 09.2026\",\"trend\":\"up\",\"good\":null,\"eu\":\"4 (10.2026)\"},{\"id\":\"fuel_monthly\",\"title\":\"Цени на горивата по месеци (2024–2025)\",\"topic\":\"Цени\",\"unit\":\"% спрямо същия месец на миналата година\",\"what\":\"Годишното изменение на цените на горивата и смазочните материали за лични автомобили.\",\"value\":\"-3,8\",\"period\":\"12.2025\",\"change\":\"-1,2 спрямо 11.2025\",\"trend\":\"down\",\"good\":true,\"eu\":\"-1,9 (12.2025)\"},{\"id\":\"fuel_monthly_2026\",\"title\":\"Цени на горивата по месеци (2025–2026)\",\"topic\":\"Цени\",\"unit\":\"% спрямо същия месец на миналата година\",\"what\":\"Същият показател за 2025–2026 г., по новата класификация на Евростат.\",\"value\":\"42,8\",\"period\":\"10.2026\",\"change\":\"+0,6 спрямо 09.2026\",\"trend\":\"up\",\"good\":false,\"eu\":\"29,5 (10.2026)\"},{\"id\":\"min_wage\",\"title\":\"Минимална работна заплата\",\"topic\":\"Доходи и неравенство\",\"unit\":\"€ на месец (бруто)\",\"what\":\"Законовата минимална месечна заплата преди данъци и осигуровки, отчетена два пъти годишно.\",\"value\":\"620\",\"period\":\"2026\",\"change\":\"+69 спрямо 2025\",\"trend\":\"up\",\"good\":true,\"eu\":\"$undefined\"},{\"id\":\"median_income\",\"title\":\"Медианен нетен доход\",\"topic\":\"Доходи и неравенство\",\"unit\":\"€ на човек годишно\",\"what\":\"Доходът на „средния“ човек: половината население има по-малко, половината повече. По-точен от средната стойност, защото не се влияе от много високите доходи.\",\"value\":\"8862\",\"period\":\"2025\",\"change\":\"+1051 спрямо 2024\",\"trend\":\"up\",\"good\":true,\"eu\":\"22 939 (2025)\"},{\"id\":\"gini\",\"title\":\"Неравенство (коефициент на Джини)\",\"topic\":\"Доходи и неравенство\",\"unit\":\"0 = пълно равенство, 100 = всичко у един\",\"what\":\"Колко неравно са разпределени доходите. България от години е сред най-неравните страни в ЕС.\",\"value\":\"37,7\",\"period\":\"2025\",\"change\":\"-0,7 спрямо 2024\",\"trend\":\"down\",\"good\":true,\"eu\":\"29,2 (2025)\"},{\"id\":\"s80s20\",\"title\":\"Пъти по-богати: горните 20% спрямо долните 20%\",\"topic\":\"Доходи и неравенство\",\"unit\":\"пъти\",\"what\":\"Колко пъти общият доход на най-богатите 20% е по-голям от този на най-бедните 20%.\",\"value\":\"6,94\",\"period\":\"2025\",\"change\":\"-0,02 спрямо 2024\",\"trend\":\"down\",\"good\":true,\"eu\":\"4,62 (2025)\"},{\"id\":\"poverty_risk\",\"title\":\"Риск от бедност или социално изключване\",\"topic\":\"Доходи и неравенство\",\"unit\":\"% от населението\",\"what\":\"Дял на хората, които са под прага на бедност, или живеят в сериозни материални лишения, или в домакинства с много ниска заетост.\",\"value\":\"29\",\"period\":\"2025\",\"change\":\"-1,3 спрямо 2024\",\"trend\":\"down\",\"good\":true,\"eu\":\"20,9 (2025)\"},{\"id\":\"household_income_regions\",\"title\":\"Разполагаем доход на домакинствата по райони\",\"topic\":\"Региони\",\"unit\":\"€ на човек годишно\",\"what\":\"Колко пари остават на човек след данъци и социални плащания, по шестте статистически района.\",\"regional\":true,\"value\":\"1,9 пъти\",\"period\":\"разлика между най-високата и най-ниската стойност, 2023\"},{\"id\":\"unemployment\",\"title\":\"Безработица\",\"topic\":\"Труд\",\"unit\":\"% от работната сила\",\"what\":\"Дял на хората от 15 до 74 години, които нямат работа, търсят активно и могат да започнат. Не включва обезкуражените, които са спрели да търсят.\",\"value\":\"3,5\",\"period\":\"2025\",\"change\":\"-0,7 спрямо 2024\",\"trend\":\"down\",\"good\":true,\"eu\":\"6 (2025)\"},{\"id\":\"employment_rate\",\"title\":\"Заетост (20–64 г.)\",\"topic\":\"Труд\",\"unit\":\"% от населението\",\"what\":\"Дял на хората между 20 и 64 години, които работят. Целта на ЕС за 2030 г. е 78%.\",\"value\":\"77\",\"period\":\"2025\",\"change\":\"+0,2 спрямо 2024\",\"trend\":\"up\",\"good\":true,\"eu\":\"76,1 (2025)\"},{\"id\":\"youth_unemployment\",\"title\":\"Младежка безработица (15–24 г.)\",\"topic\":\"Труд\",\"unit\":\"% от работната сила\",\"what\":\"Безработицата сред младите, които търсят работа. Учещите, които не търсят, не се броят.\",\"value\":\"13,1\",\"period\":\"2025\",\"change\":\"+0,8 спрямо 2024\",\"trend\":\"up\",\"good\":false,\"eu\":\"15,2 (2025)\"},{\"id\":\"unemployment_regions\",\"title\":\"Безработица по райони\",\"topic\":\"Региони\",\"unit\":\"% от работната сила\",\"what\":\"Безработицата в шестте статистически района. Разликите между София и Северозапада са сред най-големите в ЕС.\",\"regional\":true,\"value\":\"3,8 пъти\",\"period\":\"разлика между най-високата и най-ниската стойност, 2025\"},{\"id\":\"gdp_growth\",\"title\":\"Икономически растеж (реален БВП)\",\"topic\":\"Растеж и инвестиции\",\"unit\":\"% за година\",\"what\":\"С колко се е увеличило всичко произведено в страната за година, след като се извади инфлацията.\",\"value\":\"3\",\"period\":\"2025\",\"change\":\"-0,3 спрямо 2024\",\"trend\":\"down\",\"good\":false,\"eu\":\"1,4 (2025)\"},{\"id\":\"gdp_pc_pps\",\"title\":\"БВП на човек спрямо ЕС (по покупателна сила)\",\"topic\":\"Растеж и инвестиции\",\"unit\":\"ЕС = 100\",\"what\":\"Колко богата е страната спрямо средното за ЕС, като се отчитат разликите в цените.\",\"value\":\"68\",\"period\":\"2025\",\"change\":\"+2 спрямо 2024\",\"trend\":\"up\",\"good\":true,\"eu\":\"$undefined\"},{\"id\":\"investment\",\"title\":\"Инвестиции\",\"topic\":\"Растеж и инвестиции\",\"unit\":\"% от БВП\",\"what\":\"Колко се влага в сгради, машини, пътища и технологии като дял от икономиката.\",\"value\":\"20,9\",\"period\":\"2025\",\"change\":\"+2,7 спрямо 2024\",\"trend\":\"up\",\"good\":true,\"eu\":\"21,5 (2025)\"},{\"id\":\"consumption_growth\",\"title\":\"Ръст на потреблението на домакинствата\",\"topic\":\"Растеж и инвестиции\",\"unit\":\"% за година (реално)\",\"what\":\"С колко повече са похарчили домакинствата за година, след като се извади инфлацията.\",\"value\":\"7,4\",\"period\":\"2025\",\"change\":\"+2,4 спрямо 2024\",\"trend\":\"up\",\"good\":null,\"eu\":\"1,6 (2025)\"},{\"id\":\"exports\",\"title\":\"Износ\",\"topic\":\"Растеж и инвестиции\",\"unit\":\"% от БВП\",\"what\":\"Стоките и услугите, продадени в чужбина, като дял от икономиката.\",\"value\":\"50,8\",\"period\":\"2025\",\"change\":\"-5,8 спрямо 2024\",\"trend\":\"down\",\"good\":false,\"eu\":\"49,6 (2025)\"},{\"id\":\"deficit\",\"title\":\"Бюджетен дефицит или излишък\",\"topic\":\"Публични финанси\",\"unit\":\"% от БВП (минус = дефицит)\",\"what\":\"Разликата между приходите и разходите на цялото държавно управление по методиката на ЕС. Границата на ЕС за дефицит е 3%.\",\"value\":\"-4\",\"period\":\"2025\",\"change\":\"-1 спрямо 2024\",\"trend\":\"down\",\"good\":false,\"eu\":\"-3,1 (2025)\"},{\"id\":\"debt\",\"title\":\"Държавен дълг\",\"topic\":\"Публични финанси\",\"unit\":\"% от БВП\",\"what\":\"Целият дълг на държавното управление спрямо годишния БВП. Границата на ЕС е 60%. България е сред страните с най-нисък дълг.\",\"value\":\"29,9\",\"period\":\"2025\",\"change\":\"+6,2 спрямо 2024\",\"trend\":\"up\",\"good\":false,\"eu\":\"81,5 (2025)\"},{\"id\":\"gov_revenue\",\"title\":\"Приходи на държавата\",\"topic\":\"Публични финанси\",\"unit\":\"% от БВП\",\"what\":\"Всички данъци, осигуровки и други приходи на държавното управление като дял от икономиката.\",\"value\":\"38,1\",\"period\":\"2025\",\"change\":\"+2,1 спрямо 2024\",\"trend\":\"up\",\"good\":null,\"eu\":\"46,3 (2025)\"},{\"id\":\"gov_expenditure\",\"title\":\"Разходи на държавата\",\"topic\":\"Публични финанси\",\"unit\":\"% от БВП\",\"what\":\"Всички разходи на държавното управление като дял от икономиката: заплати, пенсии, инвестиции, лихви.\",\"value\":\"42,1\",\"period\":\"2025\",\"change\":\"+3,1 спр