"/ikonomika/sabitie/valuten-bord\",\"children\":[\"Валутен борд\",\" →\"]}]}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"След хиперинфлацията от 1996–1997 г. левът е вързан към германската марка, а после към еврото. БНБ спира да печата пари срещу дълг. Данните за растежа на Евростат започват от 1996 г., затова сравнение „преди“ няма.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm\",\"children\":[\"Растеж преди: \",[\"$\",\"b\",null,{\"children\":\"няма данни\"}],[\"$\",\"br\",null,{}],\"Растеж след: \",[\"$\",\"b\",null,{\"children\":\"-6,2%\"}]]}]]}],[\"$\",\"li\",\"2007\",{\"className\":\"ring-1 ring-rule rounded-sm p-4 bg-white hover:ring-2 hover:ring-green grid gap-3 md:grid-cols-[6rem_1fr_14rem]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"display text-[2rem] leading-none\",\"children\":2007}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":[\"$\",\"$Lb\",null,{\"href\":\"/ikonomika/sabitie/es\",\"children\":[\"Членство в ЕС\",\" →\"]}]}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"България влиза в ЕС на 1 януари 2007 г. Отварят се пазарите и започват да идват евросредства.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm\",\"children\":[\"Растеж преди: \",[\"$\",\"b\",null,{\"children\":\"6,8%\"}],[\"$\",\"br\",null,{}],\"Растеж след: \",[\"$\",\"b\",null,{\"children\":\"3,2%\"}]]}]]}],[\"$\",\"li\",\"2008\",{\"className\":\"ring-1 ring-rule rounded-sm p-4 bg-white hover:ring-2 hover:ring-green grid gap-3 md:grid-cols-[6rem_1fr_14rem]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"display text-[2rem] leading-none\",\"children\":2008}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":[\"$\",\"$Lb\",null,{\"href\":\"/ikonomika/sabitie/ploskiat-danak\",\"children\":[\"Плосък данък 10%\",\" →\"]}]}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"Данъкът върху доходите става 10% за всички (от 20