n\":\"–\"}]}],[\"$\",\"td\",\"Подвеждащо\",{\"className\":\"py-2 pr-2 num\",\"children\":1}],[\"$\",\"td\",\"Невярно\",{\"className\":\"py-2 pr-2 num\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-muted\",\"children\":\"–\"}]}],[\"$\",\"td\",\"Непотвърдено\",{\"className\":\"py-2 pr-2 num\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-muted\",\"children\":\"–\"}]}]]]}]\n28:[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#fbecc4] text-[#6b4a00]\",\"children\":\"Подвеждащо\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Публично твърдение\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"19 ноември 2026 г.\"}]]}]\n29:[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Прогресивна България“ отказа да вдигне прага за ДДС.\",\"“\"]}]\n2a:[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"През септември ПБ се въздържа по законопроекта на ПП и той не мина. Два месеца по-късно обаче мнозинството прие на първо четене собствен вариант с поетапно вдигане до 75 000 € през 2029 г. Вярното е, че отказа 85 000 € веднага.\"}]\n2b:[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[],[\"$\",\"$La\",null,{\"href\":\"/parlament/zakon/danak-varhu-dobavenata-stoynost\",\"children\":[\"Анализ: \",\"Закон за данък върху добавената стойност (електронни фактури, праг за регистрация, глоби)\"]}],\"$undefined\"]}]\n2c:[\"$\",\"article\",\"dalg-gadzhev-1\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#eef3d2] text-[#4d5a12]\",\"children\":\"Отчасти вярно\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Христо Гаджев\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"18 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"За по-малко от пет месеца властта е поела 5,3 млрд. € нов дълг.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Правителството е от 8 май 2026 г. Сборът на известните операции след тази дата: 2,5 млрд. € еврооблигации на 7 юли, 2,25 млрд. € на международните пазари в края на септември и около 0,1 млрд. € на вътрешния пазар до края на юли. Това прави около 4,85 млрд. €, без аукционите на вътрешния пазар след юли. Порядъкът на 5,3 млрд. € е реалистичен, но точната сума за мандата ще се потвърди с месечния бюлетин на МФ. За сравнение: целият таван за 2026 г. е 10,1 млрд. €, от които до 3,26 млрд. € са целеви заем по SAFE за отбрана.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[[\"$\",\"a\",\"https://www.bta.bg/bg/news/economy/bg/1163475-balgariya-emitira-dalg-za-2-5-mlrd-evro-na-mezhdunarodnite-pazari-za-parvi-pa\",{\"href\":\"https://www.bta.bg/bg/news/economy/bg/1163475-balgariya-emitira-dalg-za-2-5-mlrd-evro-na-mezhdunarodnite-pazari-za-parvi-pa\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: 2,5 млрд. € на международните пазари, 7 юли 2026 г.\"}],[\"$\",\"a\",\"https://bnrnews.bg/en/post/508409/bulgaria-with-new-domestic-debt-of-100-million-euros\",{\"href\":\"https://bnrnews.bg/en/post/508409/bulgaria-with-new-domestic-debt-of-100-million-euros\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БНР: общо 4,01 млрд. € нов дълг до 28 юли 2026 г.\"}],[\"$\",\"a\",\"https://www.capital.bg/biznes-zakuska/2026/09/30/4960635_biznes_zakuska_bulgariia_nabra_oshte_225_mlrd_evro/\",{\"href\":\"https://www.capital.bg/biznes-zakuska/2026/09/30/4960635_biznes_zakuska_bulgariia_nabra_oshte_225_mlrd_evro/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Капитал: България набра още 2,25 млрд. евро (30.09.2026)\"}],[\"$\",\"a\",\"https://www.bta.bg/bg/news/bulgaria/1144060-vdiganeto-na-tavana-na-dalga-shte-osiguri-resurs-za-prefinansirane-na-ochakvanit\",{\"href\":\"https://www.bta.bg/bg/news/bulgaria/1144060-vdiganeto-na-tavana-na-dalga-shte-osiguri-resurs-za-prefinansirane-na-ochakvanit\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: таванът на дълга до май 2026 г.\"}]],\"$undefined\",[\"$\",\"$La\",null,{\"href\":\"/proverki/dalg-2026\",\"children\":\"Цялата проверка\"}]]}]]}]\n2d:[\"$\",\"article\",\"goriva-1\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#fbecc4] text-[#6b4a00]\",\"children\":\"Подвеждащо\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Публично твърдение\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"18 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Горивата са скъпи заради новото правителство.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Поскъпването започна на 28 февруари 2026 г. с войната в Иран, при служебно правителство, и обхвана целия ЕС. Ръстът у нас е най-голям в ЕС главно защото тръгнахме от най-ниските цени. Дори сега България е сред трите държави с най-евтини горива. Правителството влияе чрез данъците върху горивата и чрез конкуренцията на пазара, но не определя световната цена на петрола.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[[\"$\",\"a\",\"https://www.bta.bg/bg/news/1079358-gorivata-v-stranata-poskapvat-mezhdu-6-i-9-protsenta-za-sedmitsa-sochat-dannite\",{\"href\":\"https://www.bta.bg/bg/news/1079358-gorivata-v-stranata-poskapvat-mezhdu-6-i-9-protsenta-za-sedmitsa-sochat-dannite\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: горивата поскъпват с 6–9% за седмица, Брент над 100 $\"}],[\"$\",\"a\",\"https://www.intellinews.com/bulgaria-records-eu-s-sharpest-fuel-price-rise-in-may-450039/\",{\"href\":\"https://www.intellinews.com/bulgaria-records-eu-s-sharpest-fuel-price-rise-in-may-450039/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"bne IntelliNews: България с най-голямо поскъпване в ЕС през май (Евростат)\"}],[\"$\",\"a\",\"https://www.fuel-prices.eu/news/bulgaria-petrol-below-1-60-eur-2026-11-09/\",{\"href\":\"https://www.fuel-prices.eu/news/bulgaria-petrol-below-1-60-eur-2026-11-09/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Fuel-prices.eu по Weekly Oil Bulletin на ЕК, 9 ноември 2026\"}],[\"$\",\"a\",\"https://cpc.bg/media/0212/Ре-26.pdf\",{\"href\":\"https://cpc.bg/media/0212/Ре-26.pdf\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"КЗК: резюме от проучването на пазара на горива\"}]],\"$undefined\",[\"$\",\"$La\",null,{\"href\":\"/proverki/goriva-2026\",\"children\":\"Цялата проверка\"}]]}]]}]\n2e:[\"$\",\"article\",\"pensii-1\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#eef3d2] text-[#4d5a12]\",\"children\":\"Отчасти вярно\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Министерство на финансите (бюджет на ДОО за 2026 г.)\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"18 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Очакваният реален ръст на пенсиите е 4,5% при средногодишна инфлация 4,3%.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Увеличението от 7,8% от 1 юли наистина е по-голямо от инфлацията. Заложената инфлация от 4,3% обаче е под актуалните прогнози: МВФ очаква 4,9%, ОББ 5%. Годишната инфлация през октомври е 6,0% (НСИ). Пенсионерите печелят реално, но вероятно по-малко от обещаното.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[[\"$\",\"a\",\"https://www.bta.bg/bg/videos/38418\",{\"href\":\"https://www.bta.bg/bg/videos/38418\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: бюджетът на ДОО за 2026 г., второ гласуване в комисията\"}],[\"$\",\"a\",\"https://www.nsi.bg/press-release/inflaciya-i-indeksi-na-potrebitelskite-ceni-9216\",{\"href\":\"https://www.nsi.bg/press-release/inflaciya-i-indeksi-na-potrebitelskite-ceni-9216\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"НСИ: инфлация и индекси на потребителските цени, октомври 2026\"}],[\"$\",\"a\",\"https://www.capital.bg/en/economy/2026/11/03/4975698_bulgarias_inflation_accelerates_to_61_in_october/\",{\"href\":\"https://www.capital.bg/en/economy/2026/11/03/4975698_bulgarias_inflation_accelerates_to_61_in_october/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Капитал: инфлацията се ускорява до 6,1% през октомври (03.11.2026)\"}]],\"$undefined\",[\"$\",\"$La\",null,{\"href\":\"/proverki/pensii-inflacia-2026\",\"children\":\"Цялата проверка\"}]]}]]}]\n2f:[\"$\",\"article\",\"borisov-izlishak-1\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#eef3d2] text-[#4d5a12]\",\"children\":\"Отчасти вярно\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Бойко Борисов\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"18 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Моите бюджети са били на излишък.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Вярно е за част от управлението му. По данни на Евростат (сектор „Държавно управление“) има излишък през 2016 г. (+0,3% от БВП), 2017 г. (+1,6%), 2018 г. (+1,7%) и 2019 г. (+2,2%). През другите пълни години на правителствата му има дефицит: 2010 г. (−3,7%), 2011 г. (−1,7%), 2012 г. (−0,8%), 2015 г. (−1,9%) и 2020 г. (−3,8%, годината на пандемията). Дефицитите през 2009 г. (−4,4%) и 2014 г. (−5,4%) са в години, поделени с други правителства.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[[\"$\",\"a\",\"https://taralej.bg/politika/boyko-borisov-gerb-nqma-da-podkrepi-proektobyudjeta-za-2027-g\",{\"href\":\"https://taralej.bg/politika/boyko-borisov-gerb-nqma-da-podkrepi-proektobyudjeta-za-2027-g\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Таралеж: Борисов за проектобюджета (18.11.2026)\"}],[\"$\",\"a\",\"https://ec.europa.eu/eurostat/databrowser/view/gov_10dd_edpt1/default/table\",{\"href\":\"https://ec.europa.eu/eurostat/databrowser/view/gov_10dd_edpt1/default/table\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Евростат: дефицит/излишък на сектор „Държавно управление“, % от БВП (gov_10dd_edpt1)\"}]],\"$undefined\",\"$undefined\"]}]]}]\n30:[\"$\",\"article\",\"borisov-inflacia-1\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#eef3d2] text-[#4d5a12]\",\"children\":\"Отчасти вярно\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Бойко Борисов\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"18 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Прогнозата е 5% инфлация.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Инфлацията наистина е висока: годишната инфлация по НСИ е 6,0% през октомври 2026 г., а МВФ и ОББ очакват средногодишно около 4,9–5% за 2026 г.; ЕК очаква 4,6%. Макрорамката на Бюджет 2027 обаче залага средногодишна инфлация 4% за 2027 г., а ЕК — 3,9%. Числото 5% е близо до прогнозите за тази година, не до прогнозата в бюджета за следващата.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[[\"$\",\"a\",\"https://taralej.bg/politika/boyko-borisov-gerb-nqma-da-podkrepi-proektobyudjeta-za-2027-g\",{\"href\":\"https://taralej.bg/politika/boyko-borisov-gerb-nqma-da-podkrepi-proektobyudjeta-za-2027-g\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Таралеж: Борисов за проектобюджета (18.11.2026)\"}],[\"$\",\"a\",\"https://www.nsi.bg/press-release/inflaciya-i-indeksi-na-potrebitelskite-ceni-oktomvri-2026-godina-9216\",{\"href\":\"https://www.nsi.bg/press-release/inflaciya-i-indeksi-na-potrebitelskite-ceni-oktomvri-2026-godina-9216\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"НСИ: инфлация и индекси на потребителските цени, октомври 2026\"}],[\"$\",\"a\",\"https://www.parliament.bg/bg/bills/ID/167645\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167645\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Народно събрание: законопроект за държавния бюджет за 2027 г. (52-602-01-71)\"}],[\"$\",\"a\",\"https://www.novinite.com/articles/241647/EU+Commission+Sees+Bulgaria's+Budget+Deficit+Reaching+5+of+GDP+in+2026\",{\"href\":\"https://www.novinite.com/articles/241647/EU+Commission+Sees+Bulgaria's+Budget+Deficit+Reaching+5+of+GDP+in+2026\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Novinite: есенната прогноза на ЕК за България (17.11.2026)\"}]],\"$undefined\",\"$undefined\"]}]]}]\n31:[\"$\",\"article\",\"zakon-byudzheta-na-darzhavnoto-obshtestveno-osiguryavane-za-2026-g-0\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#d7ecd9] text-[#1f5c2a]\",\"children\":\"Вярно\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Публично твърдение\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Всички пенсии се увеличават със 7,8% от 1 юли 2026 г.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Записано е в приетия бюджет и в прессъобщението на мнозинството. Увеличението се изчислява по „швейцарското правило“ (половината от ръста на осигурителния доход и половината от инфлацията).\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[],[\"$\",\"$La\",null,{\"href\":\"/parlament/zakon/byudzheta-na-darzhavnoto-obshtestveno-osiguryavane-za-2026-g\",\"children\":[\"Анализ: \",\"Закон за бюджета на държавното обществено осигуряване за 2026 г.\"]}],\"$undefined\"]}]]}]\n32:[\"$\",\"article\",\"zakon-aktsizite-i-danachnite-skladove-1\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface text-muted\",\"children\":\"Непотвърдено\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Публично твърдение\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Мярката струва на бюджета около 20 млн. € за три месеца.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Това е оценката, цитирана при обсъждането. Ще проверим реалния ефект в отчета за изпълнението на бюджета.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[],[\"$\",\"$La\",null,{\"href\":\"/parlament/zakon/aktsizite-i-danachnite-skladove\",\"children\":[\"Анализ: \",\"Закон за акцизите и данъчните складове\"]}],\"$undefined\"]}]]}]\n33:[\"$\",\"article\",\"zakon-aktsizite-i-danachnite-skladove-0\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#eef3d2] text-[#4d5a12]\",\"children\":\"Отчасти вярно\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Публично твърдение\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Пропан-бутанът ще поевтинее с около 10 евроцента на литър.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Това е максималният ефект от премахнатия акциз. Намалението стига до шофьора само ако търговците не го задържат в надценката. Около 75% от пропан-бутана е внос и цената зависи от вносителя.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[],[\"$\",\"$La\",null,{\"href\":\"/parlament/zakon/aktsizite-i-danachnite-skladove\",\"children\":[\"Анализ: \",\"Закон за акцизите и данъчните складове\"]}],\"$undefined\"]}]]}]\n34:[\"$\",\"article\",\"zakon-darzhavniya-byudzhet-na-republika-balgariya-za-2026-g-2\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#d7ecd9] text-[#1f5c2a]\",\"children\":\"Вярно\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"А. Василев\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted\",\"children\":\"ПП\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Отпада поименният списък с общинските проекти\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Приложение № 3 със списъка на проектите липсва. Правомощието на министъра не е ново, ново е, че списъкът вече не е публичен.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[],[\"$\",\"$La\",null,{\"href\":\"/parlament/zakon/darzhavniya-byudzhet-na-republika-balgariya-za-2026-g\",\"children\":[\"Анализ: \",\"Закон за държавния бюджет на Република България за 2026 г.\"]}],\"$undefined\"]}]]}]\n35:[\"$\",\"article\",\"zakon-darzhavniya-byudzhet-na-republika-balgariya-za-2026-g-1\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#f6d5d8] text-[#8a1c27]\",\"children\":\"Невярно\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"А. Василев\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted\",\"children\":\"ПП\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Текстовете за Националната детска болница са били във всеки бюджет от 2022 г.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Текст има само в бюджетите за 2024 и 2025 г., и в двата без конкретна сума.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[],[\"$\",\"$La\",null,{\"href\":\"/parlament/zakon/darzhavniya-byudzhet-na-republika-balgariya-za-2026-g\",\"children\":[\"Анализ: \",\"Закон за държавния бюджет на Република България за 2026 г.\"]}],\"$undefined\"]}]]}]\n36:[\"$\",\"article\",\"zakon-darzhavniya-byudzhet-na-republika-balgariya-za-2026-g-0\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#fbecc4] text-[#6b4a00]\",\"children\":\"Подвеждащо\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Т. Петкова\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted\",\"children\":\"ГЕРБ–СДС\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Събираемостта е силно занижена\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Бюджет 2025, приет при нейното министерство, планира приходи по централния бюджет 28,2 млрд. €, а събра 26,3 млрд. € (−6,7%). Новият бюджет залага по-умерен ръст на приходите. Рискът е обратен: до май 2026 г. приходите растат само с 2%.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[],[\"$\",\"$La\",null,{\"href\":\"/parlament/zakon/darzhavniya-byudzhet-na-republika-balgariya-za-2026-g\",\"children\":[\"Анализ: \",\"Закон за държавния бюджет на Република България за 2026 г.\"]}],\"$undefined\"]}]]}]\n37:[\"$\",\"article\",\"dalg-valdzhev-6\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-white text-muted border border-dashed border-muted\",\"children\":\"Мнение\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Георги Вълджев\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Пеевски е трябвало да си „купува МВР“ чрез тяхното правителство.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Политическо обвинение без посочен документ. Показваме го като оценка на автора.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[],\"$undefined\",[\"$\",\"$La\",null,{\"href\":\"/proverki/dalg-2026\",\"children\":\"Цялата проверка\"}]]}]]}]\n38:[\"$\",\"article\",\"dalg-valdzhev-5\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface text-muted\",\"children\":\"Непотвърдено\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Георги Вълджев\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Сметната палата е показала скрити разходи в АПИ.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Парламентът е възложил на Сметната палата одит на АПИ за периода от 1 януари 2020 г. до 30 юни 2026 г. Окончателен публикуван доклад още не открихме. ГЕРБ твърди, че при одита разходи от 2026 г. се прехвърлят към 2025 г., за да изглежда по-голям дефицитът от предишната власт. И двете твърдения чакат доклада.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[[\"$\",\"a\",\"https://www.bta.bg/bg/news/1159903?download=1\",{\"href\":\"https://www.bta.bg/bg/news/1159903?download=1\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: парламентът възлага трите одита\"}],[\"$\",\"a\",\"https://www.bta.bg/bg/videos/40267\",{\"href\":\"https://www.bta.bg/bg/videos/40267\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: сигналът на ГЕРБ за одита на АПИ\"}]],\"$undefined\",[\"$\",\"$La\",null,{\"href\":\"/proverki/dalg-2026\",\"children\":\"Цялата проверка\"}]]}]]}]\n39:[\"$\",\"article\",\"dalg-valdzhev-4\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#eef3d2] text-[#4d5a12]\",\"children\":\"Отчасти вярно\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Георги Вълджев\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Дългът, поет през 2025 г., е почти двоен спрямо 2024 г.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"По пазарните емисии: около 9,2 млрд. € през 2025 г. срещу около 5,4 млрд. € през 2024 г., тоест около 1,7 пъти. Ръстът е голям, но „почти двоен“ е закръглено нагоре.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[[\"$\",\"a\",\"https://www.economic.bg/en/a/view/the-state-starts-the-year-with-a-debt-issue-of-150-million\",{\"href\":\"https://www.economic.bg/en/a/view/the-state-starts-the-year-with-a-debt-issue-of-150-million\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Economic.bg: дългът през 2025 г.\"}]],\"$undefined\",[\"$\",\"$La\",null,{\"href\":\"/proverki/dalg-2026\",\"children\":\"Цялата проверка\"}]]}]]}]\n3a:[\"$\",\"article\",\"dalg-valdzhev-3\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#d7ecd9] text-[#1f5c2a]\",\"children\":\"Вярно\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Георги Вълджев\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"За 2027 г. новопоетият дълг започва да намалява.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"По плана: 8,6 млрд. € за 2027 г. срещу таван 10,1 млрд. € за 2026 г. Това е план, не изпълнение.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[],\"$undefined\",[\"$\",\"$La\",null,{\"href\":\"/proverki/dalg-2026\",\"children\":\"Цялата проверка\"}]]}]]}]\n3b:[\"$\",\"article\",\"dalg-valdzhev-2\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#d7ecd9] text-[#1f5c2a]\",\"children\":\"Вярно\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Георги Вълджев\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Таванът за нов дълг през 2026 г. е 10,1 млрд. € срещу 9,64 млрд. € през 2025 г.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Таванът за 2026 г. е 10,1 млрд. €, от които 3,26 млрд. € по механизма за отбрана SAFE. Таванът за 2025 г. е 18,9 млрд. лв., тоест около 9,66 млрд. € по фиксирания курс. Разликата от 9,64 е закръгляне.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[[\"$\",\"a\",\"https://www.minfin.bg/en/news/%26amp%3Bamp%3Bamp%3Bamp%3Bquot%3B/%26quot%3B/13024\",{\"href\":\"https://www.minfin.bg/en/news/%26amp%3Bamp%3Bamp%3Bamp%3Bquot%3B/%26quot%3B/13024\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"МФ: таванът за 2025 г. е 18,9 млрд. лв.\"}]],\"$undefined\",[\"$\",\"$La\",null,{\"href\":\"/proverki/dalg-2026\",\"children\":\"Цялата проверка\"}]]}]]}]\n3c:[\"$\",\"article\",\"dalg-valdzhev-1\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#eef3d2] text-[#4d5a12]\",\"children\":\"Отчасти вярно\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Георги Вълджев\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Най-много дълг за последните шест години е планиран и поет през 2025 г., при финансов министър Теменужка Петкова.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"През 2025 г. е поет нов дълг за близо 18 млрд. лв. (около 9,2 млрд. €), включително международните емисии. Това е повече от общо 15,5 млрд. лв. за трите години 2022–2024 г., по думите на Асен Василев. За 2020 и 2021 г. още нямаме проверени годишни суми, затова потвърждаваме твърдението само за 2022–2025 г.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[[\"$\",\"a\",\"https://www.economic.bg/en/a/view/the-state-starts-the-year-with-a-debt-issue-of-150-million\",{\"href\":\"https://www.economic.bg/en/a/view/the-state-starts-the-year-with-a-debt-issue-of-150-million\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Economic.bg: дългът през 2025 г.\"}],[\"$\",\"a\",\"https://www.bta.bg/en/news/955183-bulgaria-took-on-more-public-debt-in-six-months-than-in-past-three-years-assen\",{\"href\":\"https://www.bta.bg/en/news/955183-bulgaria-took-on-more-public-debt-in-six-months-than-in-past-three-years-assen\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: Асен Василев за дълга 2022–2024 г.\"}]],\"$undefined\",[\"$\",\"$La\",null,{\"href\":\"/proverki/dalg-2026\",\"children\":\"Цялата проверка\"}]]}]]}]\n3d:[\"$\",\"article\",\"dalg-gadzhev-3\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-white text-muted border border-dashed border-muted\",\"children\":\"Мнение\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Христо Гаджев\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"На фона на този бюджет и Жан Виденов изглежда симпатичен.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Сравнение, не проверимо твърдение. За контекст: дългът е 244,5% от БВП през 1996 г. и 29,9% през 2025 г. (Евростат).\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[[\"$\",\"a\",\"https://ec.europa.eu/eurostat/databrowser/view/gov_10dd_edpt1/default/table\",{\"href\":\"https://ec.europa.eu/eurostat/databrowser/view/gov_10dd_edpt1/default/table\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Евростат: дълг и дефицит\"}]],\"$undefined\",[\"$\",\"$La\",null,{\"href\":\"/proverki/dalg-2026\",\"children\":\"Цялата проверка\"}]]}]]}]\n3e:[\"$\",\"article\",\"dalg-gadzhev-2\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#d7ecd9] text-[#1f5c2a]\",\"children\":\"Вярно\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Христо Гаджев\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"За 2027 г. искат да поемат още 8,6 млрд. € нов дълг.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Съвпада с плана в проектобюджета за 2027 г.: 8,6 млрд. €, после 8,5 млрд. € (2028) и 7,9 млрд. € (2029). Това е план, не изпълнение.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[],\"$undefined\",[\"$\",\"$La\",null,{\"href\":\"/proverki/dalg-2026\",\"children\":\"Цялата проверка\"}]]}]]}]\n3f:[\"$\",\"article\",\"vasilev-byudzhet-1\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-white text-muted border border-dashed border-muted\",\"children\":\"Мнение\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Асен Василев\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Този бюджет е катастрофа.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Оценка, не факт. Контекст: проектът предвижда дефицит 3,5% на касова основа и 4,2% по европейската методология, нов дълг до 8,6 млрд. € и държавен дълг 31,4% от БВП в края на 2027 г. — над 3-процентния праг за дефицита, но с дълг сред най-ниските в ЕС. ЕК не прогнозира рецесия: очаква растеж 2,1% през 2027 г. (правителството — 2,5%) и дефицит 4,0%.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[[\"$\",\"a\",\"https://www.bgonair.bg/a/2-bulgaria/436934-byudzhet-2027-skara-deputatite-spor-za-pensiite-i-danaka-varhu-svrahpechalbata\",{\"href\":\"https://www.bgonair.bg/a/2-bulgaria/436934-byudzhet-2027-skara-deputatite-spor-za-pensiite-i-danaka-varhu-svrahpechalbata\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"BG ON AIR: Бюджет 2027 в бюджетната комисия (17.11.2026)\"}],[\"$\",\"a\",\"https://www.parliament.bg/bg/bills/ID/167645\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167645\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Народно събрание: законопроект за държавния бюджет за 2027 г. (52-602-01-71)\"}],[\"$\",\"a\",\"https://www.novinite.com/articles/241647/EU+Commission+Sees+Bulgaria's+Budget+Deficit+Reaching+5+of+GDP+in+2026\",{\"href\":\"https://www.novinite.com/articles/241647/EU+Commission+Sees+Bulgaria's+Budget+Deficit+Reaching+5+of+GDP+in+2026\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Novinite: есенната прогноза на ЕК за България (17.11.2026)\"}]],\"$undefined\",\"$undefined\"]}]]}]\n40:[\"$\",\"article\",\"donev-deficit-1\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#eef3d2] text-[#4d5a12]\",\"children\":\"Отчасти вярно\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Гълъб Донев\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"През 2027 г. дефицитът ще намалее до 3,5% от БВП.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"3,5% е дефицитът по консолидираната фискална програма на касова основа (приходи 51,07 млрд. €, разходи 55,97 млрд. €, разлика 4,9 млрд. €). По европейската методология (начислена основа), по която се следи правилото за 3%, проектът залага 4,2%. Есенната прогноза на ЕК очаква дефицит 5,0% за 2026 г. и 4,0% за 2027 г., т.е. намаление наистина се очаква, но и двете мерки остават над 3%. За 2028 г. ЕК очаква отново по-висок дефицит — 4,8%. Това е план, изпълнението ще се види с отчета.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[[\"$\",\"a\",\"https://news.bg/politics/byudzhet-2027-mina-na-parvo-chetene-v-resornata-komisiya-v-parlamenta-na-8-chasovo-zasedanie.html\",{\"href\":\"https://news.bg/politics/byudzhet-2027-mina-na-parvo-chetene-v-resornata-komisiya-v-parlamenta-na-8-chasovo-zasedanie.html\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"News.bg (БГНЕС): бюджетът мина на първо четене в комисията (17.11.2026)\"}],[\"$\",\"a\",\"https://www.parliament.bg/bg/bills/ID/167645\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167645\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Народно събрание: законопроект за държавния бюджет за 2027 г. (52-602-01-71)\"}],[\"$\",\"a\",\"https://www.novinite.com/articles/241647/EU+Commission+Sees+Bulgaria's+Budget+Deficit+Reaching+5+of+GDP+in+2026\",{\"href\":\"https://www.novinite.com/articles/241647/EU+Commission+Sees+Bulgaria's+Budget+Deficit+Reaching+5+of+GDP+in+2026\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Novinite: есенната прогноза на ЕК за България (17.11.2026)\"}]],\"$undefined\",\"$undefined\"]}]]}]\n41:[\"$\",\"article\",\"radev-pchi-1\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#eef3d2] text-[#4d5a12]\",\"children\":\"Отчасти вярно\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Румен Радев\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"16 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Преките чуждестранни инвестиции са се увеличили със 100% от началото на годината.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Ръстът е голям, но не двоен. По предварителните данни на БНБ, публикувани три дни след изказването, нетният приток на преки инвестиции за януари–септември 2026 г. е 3,95 млрд. € срещу 2,38 млрд. € година по-рано, т.е. с около 66% повече. Над 94% от притока е реинвестирана печалба на вече работещи фирми (3,72 млрд. € срещу 3,32 млрд. €, +12%). Новият дялов капитал е едва 96,5 млн. €. Голямата разлика спрямо 2025 г. идва главно от дълговите инструменти: +131 млн. € сега срещу −935 млн. € тогава. Данните са предварителни и подлежат на ревизия.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[[\"$\",\"a\",\"https://www.investor.bg/a/540-danatsi-i-byudzhet/439563-rumen-radev-byudzhet-2027-e-nay-sotsialniyat-ot-godini\",{\"href\":\"https://www.investor.bg/a/540-danatsi-i-byudzhet/439563-rumen-radev-byudzhet-2027-e-nay-sotsialniyat-ot-godini\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Investor.bg: Радев на заседанието на МС за Бюджет 2027 (16.11.2026)\"}],[\"$\",\"a\",\"https://www.bta.bg/bg/news/economy/1250112-prekite-chuzhdestranni-investitsii-u-nas-dostigat-blizo-4-mlrd-evro-kam-kraya-n\",{\"href\":\"https://www.bta.bg/bg/news/economy/1250112-prekite-chuzhdestranni-investitsii-u-nas-dostigat-blizo-4-mlrd-evro-kam-kraya-n\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: преките инвестиции достигат 3,95 млрд. € към края на септември (данни на БНБ, 19.11.2026)\"}],[\"$\",\"a\",\"https://www.economic.bg/bg/a/view/reinvestiranata-pechalba-ostava-dvigatelja-na-chujdestrannite-investicii-v-bylgarija\",{\"href\":\"https://www.economic.bg/bg/a/view/reinvestiranata-pechalba-ostava-dvigatelja-na-chujdestrannite-investicii-v-bylgarija\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Economic.bg: реинвестираната печалба остава двигателят на инвестициите (19.11.2026)\"}]],\"$undefined\",\"$undefined\"]}]]}]\n1a:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n44:I[27201,[\"$2\"],\"IconMark\"]\n1d:[[\"$\",\"title\",\"0\",{\"children\":\"Проверки · Осъзнатост\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Какво прави държавата. С числа и източници.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"3\",{\"property\":\"og:title\",\"content\":\"Проверки · Осъзнатост\"}],[\"$\",\"meta\",\"4\",{\"property\":\"o