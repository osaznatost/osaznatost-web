g\",\"children\":[\"Анализ: \",\"Закон за държавния бюджет на Република България за 2026 г.\"]}],\"$undefined\"]}]]}]\n3a:[\"$\",\"article\",\"dalg-valdzhev-6\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-white text-muted border border-dashed border-muted\",\"children\":\"Мнение\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Георги Вълджев\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Пеевски е трябвало да си „купува МВР“ чрез тяхното правителство.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Политическо обвинение без посочен документ. Показваме го като оценка на автора.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[],\"$undefined\",[\"$\",\"$La\",null,{\"href\":\"/proverki/dalg-2026\",\"children\":\"Цялата проверка\"}]]}]]}]\n3b:[\"$\",\"article\",\"dalg-valdzhev-5\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface text-muted\",\"children\":\"Непотвърдено\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Георги Вълджев\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Сметната палата е показала скрити разходи в АПИ.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Парламентът е възложил на Сметната палата одит на АПИ за периода от 1 януари 2020 г. до 30 юни 2026 г. Окончателен публикуван доклад още не открихме. ГЕРБ твърди, че при одита разходи от 2026 г. се прехвърлят към 2025 г., за да изглежда по-голям дефицитът от предишната власт. И двете твърдения чакат доклада.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[[\"$\",\"a\",\"https://www.bta.bg/bg/news/1159903?download=1\",{\"href\":\"https://www.bta.bg/bg/news/1159903?download=1\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: парламентът възлага трите одита\"}],[\"$\",\"a\",\"https://www.bta.bg/bg/videos/40267\",{\"href\":\"https://www.bta.bg/bg/videos/40267\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: сигналът на ГЕРБ за одита на АПИ\"}]],\"$undefined\",[\"$\",\"$La\",null,{\"href\":\"/proverki/dalg-2026\",\"children\":\"Цялата проверка\"}]]}]]}]\n3c:[\"$\",\"article\",\"dalg-valdzhev-4\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#eef3d2] text-[#4d5a12]\",\"children\":\"Отчасти вярно\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Георги Вълджев\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"17 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"Дългът, поет през 2025 г., е почти двоен спрямо 2024 г.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"По пазарните емисии: около 9,2 млрд. € през 2025 г. срещу около 5,4 млрд. € през 2024 г., тоест около 1,7 пъти. Ръстът е голям, но „почти двоен“ е закръглено нагоре.\"}],[\"$\",\"p\",null,{\"classNa