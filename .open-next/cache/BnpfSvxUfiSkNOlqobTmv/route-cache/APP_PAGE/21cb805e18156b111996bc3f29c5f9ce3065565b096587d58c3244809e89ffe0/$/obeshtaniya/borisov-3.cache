"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"29 юни 2018\"}],[\"$\",\"p\",null,{\"children\":[\"България изпраща писмо за намерение с мерки преди ERM II (банков надзор, несъстоятелност, държавни фирми).\",\"$undefined\"]}]]}],[\"$\",\"li\",\"10 юли 2020Левът влиза в ERM II, БНБ влиза в банковия съюз.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"10 юли 2020\"}],[\"$\",\"p\",null,{\"children\":[\"Левът влиза в ERM II, БНБ влиза в банковия съюз.\",[\" \",[\"$\",\"a\",null,{\"href\":\"https://www.ecb.europa.eu/press/pr/date/2020/html/ecb.pr200710~4aa5e3565a.en.html\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Източник\"}]]]}]]}]]}]]}],null,\"$undefined\",[\"$\",\"p\",null,{\"className\":\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[\"$\",\"a\",\"https://www.ecb.europa.eu/press/pr/date/2020/html/ecb.pr200710~4aa5e3565a.en.html\",{\"href\":\"https://www.ecb.europa.eu/press/pr/date/2020/html/ecb.pr200710~4aa5e3565a.en.html\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"ЕЦБ: съобщение за България, 10 юли 2020\"}],[\"$\",\"a\",\"https://www.bankingsupervision.europa.eu/press/pr/date/2020/html/ssm.pr200710~ae2abe1f23.en.html\",{\"href\":\"https://www.bankingsupervision.europa.eu/press/pr/date/2020/html/ssm.pr200710~ae2abe1f23.en.html\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"ЕЦБ: тясно сътрудничество с БНБ\"}]]}]]}]]}]]}]\n1f:[\"$\",\"section\",\"Доходи\",{\"id\":\"t-Доходи\",\"className\":\"mb-12 scroll-mt-32 lg:scroll-mt-24\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb-5\",\"children\":[[\"$\",\"h2\",null,{\"c