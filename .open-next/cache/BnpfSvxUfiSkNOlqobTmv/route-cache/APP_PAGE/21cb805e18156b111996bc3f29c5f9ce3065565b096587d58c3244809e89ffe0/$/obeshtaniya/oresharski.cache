{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/obeshtaniya/layout,_N_T_/obeshtaniya/[gov]/layout,_N_T_/obeshtaniya/[gov]/page,_N_T_/obeshtaniya/oresharski"},"segmentPaths":["/_tree","/_full","/obeshtaniya/$d$gov/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/21cb805e18156b111996bc3f29c5f9ce3065565b096587d58c3244809e89ffe0/$/obeshtaniya/oresharski","owner":{"kind":"APP_PAGE","sourceRoute":"/obeshtaniya/[gov]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0vn96-fhbu77m.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><title>Обещания: Правителство „Орешарски“ (БСП и ДПС) · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Обещания: Правителство „Орешарски“ (БСП и ДПС) · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Обещания: Правителство „Орешарски“ (БСП и ДПС) · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/obeshtaniya\">← <!-- -->Обещания</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">29 май 2013 – 6 август 2014</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Правителство „Орешарски“ (БСП и ДПС)</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Правителство с мандат на БСП, подкрепено от ДПС и (с мълчаливо съгласие) от „Атака“. Подаде оставка след масови протести (от юни 2013 г.) и загубата на европейските избори през 2014 г.</div></div></div><nav class=\"flex flex-wrap gap-2 mb-8\" aria-label=\"Други правителства\"><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/radev\">Прогресивна България</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/zhelyazkov\">Правителство „Желязков“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/denkov\">Правителство „Денков“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/petkov\">Правителство „Петков“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/borisov-3\">Правителство „Борисов 3“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/borisov-2\">Правителство „Борисов 2“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-green text-white\" href=\"/obeshtaniya/oresharski\">Правителство „Орешарски“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/borisov-1\">Правителство „Борисов 1“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/sluzhebno-gyurov\">Служебно правителство „Гюров“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/sluzhebno-glavchev\">Служебни правителства „Главчев“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/sluzhebno-donev\">Служебни правителства „Донев“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/sluzhebno-yanev\">Служебни правителства „Янев“</a></nav><section class=\"bg-surface rounded-sm p-5 mb-8\"><div class=\"flex h-4 rounded-full overflow-hidden\"><div style=\"width:50%;background:#2f9e6a\"></div><div style=\"width:20%;background:#e2b33b\"></div><div style=\"width:30%;background:#d2353f\"></div></div><p class=\"flex flex-wrap gap-x-5 gap-y-1 mt-3 text-sm\"><span class=\"inline-flex items-center gap-1.5\"><span class=\"inline-block w-3 h-3 rounded-full\" style=\"background:#2f9e6a\"></span>Изпълнено<!-- -->: <b class=\"num\">5</b></span><span class=\"inline-flex items-center gap-1.5\"><span class=\"inline-block w-3 h-3 rounded-full\" style=\"background:#e2b33b\"></span>Частично изпълнено<!-- -->: <b class=\"num\">2</b></span><span class=\"inline-flex items-center gap-1.5\"><span class=\"inline-block w-3 h-3 rounded-full\" style=\"background:#d2353f\"></span>Не е изпълнено<!-- -->: <b class=\"num\">3</b></span></p><p class=\"text-sm text-muted mt-3\">Проследяваме <!-- -->10<!-- --> обещания, избрани заради това, че могат да се измерят. Това не са всички обещания и съотношението не е оценка за цялото управление.</p></section><nav class=\"flex flex-wrap gap-x-4 gap-y-1 text-[15px] mb-8\" aria-label=\"Теми\"><span class=\"text-muted\">Теми:</span><a href=\"#t-Доходи\">Доходи<!-- --> (<!-- -->2<!-- -->)</a><a href=\"#t-Енергетика\">Енергетика<!-- --> (<!-- -->4<!-- -->)</a><a href=\"#t-Семейства\">Семейства<!-- --> (<!-- -->1<!-- -->)</a><a href=\"#t-Бюджет\">Бюджет<!-- --> (<!-- -->1<!-- -->)</a><a href=\"#t-Сигурност\">Сигурност<!-- --> (<!-- -->1<!-- -->)</a><a href=\"#t-Данъци\">Данъци<!-- --> (<!-- -->1<!-- -->)</a></nav><section id=\"t-Доходи\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Доходи</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p0\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Доходи</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#e2b33b;color:#16201b\">Частично изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">По-висока минимална заплата от 1 октомври 2013 г.</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.infobusiness.bcci.bg/econ-21-6-13.html\" target=\"_blank\" rel=\"noreferrer\">Стабилизационни и неотложни мерки, приети от Народното събрание<!-- -->, <!-- -->19 юни 2013</a></p><p class=\"text-[15px] mt-3\">Минималната заплата не е увеличена от 1 октомври 2013 г. Остава 310 лв. до края на годината и става 340 лв. (174 €) от 1 януари 2014 г., по данните на Евростат.</p><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"/statistiki/min_wage\">Минималната заплата по години</a></p></li><li id=\"p9\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Доходи</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#2f9e6a;color:#fff\">Изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Минимална заплата 340 лв. от 2014 г.</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://wageindicator.org/labour-laws/collective-bargaining/2013/news-items-2013/bulgaria-minimum-wage-to-be-raised-in-2014-october-30-2013\" target=\"_blank\" rel=\"noreferrer\">Министърът на труда и социалната политика<!-- -->, <!-- -->октомври 2013</a></p><p class=\"text-[15px] mt-3\">Минималната заплата беше вдигната от 310 на 340 лв. от 1 януари 2014 г. Работодателските организации бяха против. Премиерът Орешарски призна, че и на това ниво минималната заплата не изважда хората от бедност.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->3<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">септември 2013</span><p>БСП предлага 340 лв.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">октомври 2013</span><p>Министерството обявява целта.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">1 януари 2014</span><p>Минималната заплата става 340 лв.</p></li></ol></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://www.novinite.com/view_news.php?id=155673&amp;\" target=\"_blank\" rel=\"noreferrer\">Novinite: Орешарски за минималната заплата (19.11.2013)</a><a href=\"https://wageindicator.org/labour-laws/collective-bargaining/2013/news-items-2013/bulgaria-minimum-wage-to-be-raised-in-2014-october-30-2013\" target=\"_blank\" rel=\"noreferrer\">WageIndicator: от 310 на 340 лв.</a></p></li></ul></section><section id=\"t-Енергетика\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Енергетика</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p1\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Енергетика</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#2f9e6a;color:#fff\">Изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">По-евтин ток за домакинствата</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.bia-bg.com/uploads/files/Government_programmes/2013-Government_program-Oresharski.pdf\" target=\"_blank\" rel=\"noreferrer\">Програмата на кабинета и мерките от юни 2013 г.<!-- -->, <!-- -->2013</a></p><p class=\"text-[15px] mt-3\">През 2013 г. цените на тока за бита са намалени три пъти поред (поевтиняване с около 5% от лятото на 2013 г.). Цената е свалена административно, а не чрез по-евтини договори с централите, и дефицитът в енергийната система расте: НЕК трупа дългове към централите.</p><p class=\"text-[15px] mt-2 font-semibold\">Обещанието е изпълнено, но с цената на по-голям дефицит в енергетиката, платен по-късно.</p><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2013/07/22/2108373_cenovi_magii/\" target=\"_blank\" rel=\"noreferrer\">Капитал: „Ценови магии“ (юли 2013)</a><a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2013/12/04/2196425_nek_potuna_v_dulgove/\" target=\"_blank\" rel=\"noreferrer\">Капитал: НЕК потъна в дългове (декември 2013)</a><a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2015/01/23/2459238_energetika_problemite_se_kriiat_v_detailite/\" target=\"_blank\" rel=\"noreferrer\">Капитал: три поредни намаления през 2013 г.</a></p></li><li id=\"p2\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Енергетика</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#2f9e6a;color:#fff\">Изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Поевтиняване на тока за домакинствата с около 5% от 1 август 2013 г.</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://m.novinite.com/view_news.php?id=151310\" target=\"_blank\" rel=\"noreferrer\">Пламен Орешарски, министър-председател; потвърдено от министъра на икономиката Драгомир Стойнев<!-- -->, <!-- -->17 юни 2013</a></p><p class=\"text-[15px] mt-3\">ДКЕВР намали цените на електроенергията за битовите потребители с около 5% от 1 август 2013 г. „Капитал“ коментира, че при поетите от ВЕИ, АЕЦ и ТЕЦ разходи спадът можеше да е по-голям.</p><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2013/07/26/2111227_enter_5_namalenie/\" target=\"_blank\" rel=\"noreferrer\">Капитал: Enter: 5% намаление (26.07.2013)</a></p></li><li id=\"p4\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Енергетика</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#d2353f;color:#fff\">Не е изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Изграждане на газопровода „Южен поток“ през България</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://blogs.lse.ac.uk/europpblog/2014/06/13/bulgarias-decision-to-suspend-work-on-the-south-stream-pipeline-is-likely-to-increase-the-eus-leverage-in-negotiations-with-russia-over-ukraine\" target=\"_blank\" rel=\"noreferrer\">Министърът на икономиката и енергетиката Драгомир Стойнев потвърждава ангажимента към проекта<!-- -->, <!-- -->април 2014</a></p><p class=\"text-[15px] mt-3\">На 8 юни 2014 г. премиерът Орешарски спря работата по проекта до приключване на консултациите с Европейската комисия, която беше започнала наказателна процедура заради избора на изпълнител. През декември 2014 г. Русия се отказа от проекта.</p><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2014/06/08/2318167_oresharski_spira_jujen_potok/\" target=\"_blank\" rel=\"noreferrer\">Капитал: Орешарски спира „Южен поток“ (08.06.2014)</a><a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2014/12/05/2433139_kraiat_na_golemiia_korupcionen_shlem/\" target=\"_blank\" rel=\"noreferrer\">Капитал: Краят на големия корупционен шлем (05.12.2014)</a></p></li><li id=\"p8\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Енергетика</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#d2353f;color:#fff\">Не е изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Строителство на газопровода „Южен поток“</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://blogs.lse.ac.uk/europpblog/2014/06/13/bulgarias-decision-to-suspend-work-on-the-south-stream-pipeline-is-likely-to-increase-the-eus-leverage-in-negotiations-with-russia-over-ukraine\" target=\"_blank\" rel=\"noreferrer\">Правителството „Орешарски“ (министър на икономиката и енергетиката)<!-- -->, <!-- -->април 2014</a></p><p class=\"text-[15px] mt-3\">Строителството в България започна през октомври 2013 г. През юни 2014 г. Европейската комисия откри процедура срещу България заради обществените поръчки по проекта. На 8 юни 2014 г. премиерът Орешарски спря работата по газопровода.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->4<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">октомври 2013</span><p>Започва строителството в България.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">април 2014</span><p>Енергийният министър потвърждава ангажимента към проекта.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">началото на юни 2014</span><p>ЕК открива процедура срещу България.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">8 юни 2014</span><p>Премиерът спира работата.</p></li></ol></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://www.enerdata.net/publications/daily-energy-news/bulgaria-suspends-south-stream-gas-pipeline-project.html\" target=\"_blank\" rel=\"noreferrer\">Enerdata: работата е спряна през юни 2014 г.</a><a href=\"https://www.globalsecurity.org/military/library/news/2014/06/mil-140608-rferl02.htm\" target=\"_blank\" rel=\"noreferrer\">RFE/RL: България спира „Южен поток“ (8.6.2014)</a></p></li></ul></section><section id=\"t-Семейства\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Семейства</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p3\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Семейства</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#2f9e6a;color:#fff\">Изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Обезщетението за отглеждане на дете от 1 до 2 години да стане 310 лв. вместо 240 лв.</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.bia-bg.com/uploads/files/positions/Oresharski_programme-2013.pdf\" target=\"_blank\" rel=\"noreferrer\">Приоритети на кабинета „Орешарски“ (управленска програма)<!-- -->, <!-- -->юни 2013</a></p><p class=\"text-[15px] mt-3\">Народното събрание реши обезщетението да е 310 лв. от 1 юли 2013 г.</p><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://old.parliament.bg/en/news/ID/2610\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: обезщетението става 310 лв. от 1 юли 2013 г.</a></p></li></ul></section><section id=\"t-Бюджет\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Бюджет</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p5\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Бюджет</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#d2353f;color:#fff\">Не е изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Дефицит до 1,8% от БВП през 2014 г.</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.bta.bg/en/news//182856-Bulgaria-s-Finances-in-2014-Public-Purse-Is-in-the-Red-But-Banking-System-Is-S\" target=\"_blank\" rel=\"noreferrer\">Правителството „Орешарски“ (министър на финансите Петър Чобанов)<!-- -->, <!-- -->2013</a></p><p class=\"text-[15px] mt-3\">По данни на Евростат дефицитът за 2014 г. е 5,4% от БВП. Правителството подаде оставка през август 2014 г., а служебното правителство след него актуализира бюджета. В годината беше и фалитът на КТБ.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->4<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">2013</span><p>Бюджетът за 2014 г. залага дефицит до 1,8%.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">юни 2014</span><p>КТБ спира работа.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">август 2014</span><p>Правителството подава оставка.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">2014 (отчет)</span><p>Дефицит 5,4% от БВП (Евростат).</p></li></ol></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"/statistiki/deficit\">Евростат: дефицит по години</a><a href=\"https://www.bta.bg/en/news//182856-Bulgaria-s-Finances-in-2014-Public-Purse-Is-in-the-Red-But-Banking-System-Is-S\" target=\"_blank\" rel=\"noreferrer\">БТА: публичните финанси през 2014 г.</a></p></li></ul></section><section id=\"t-Сигурност\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Сигурност</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p6\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Сигурност</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#2f9e6a;color:#fff\">Изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Ограда от 30 км по границата с Турция</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://sofiaglobe.com/?p=30508\" target=\"_blank\" rel=\"noreferrer\">Правителството „Орешарски“<!-- -->, <!-- -->октомври 2013</a></p><p class=\"text-[15px] mt-3\">Министерството на отбраната построи 30-километровата ограда от януари до юни 2014 г. Цената (около 9,6 млн. лв., около 300 000 лв. на км) предизвика спорове. През октомври 2014 г. части от оградата се наклониха и трябваше да бъдат ремонтирани.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->3<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">октомври 2013</span><p>Обявена е ограда от 30 км.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">януари–юни 2014</span><p>Строителство.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">октомври 2014</span><p>Части от оградата се накланят.</p></li></ol></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://sofiaglobe.com/?p=30508\" target=\"_blank\" rel=\"noreferrer\">Sofia Globe: спор за цената на оградата</a><a href=\"https://sofiaglobe.com/?p=43241\" target=\"_blank\" rel=\"noreferrer\">Sofia Globe: оградата се накланя след по-малко от година</a></p></li></ul></section><section id=\"t-Данъци\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Данъци</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p7\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Данъци</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#e2b33b;color:#16201b\">Частично изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Отмяна на данъка върху лихвите по депозитите</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.novinite.com/articles/153925/Bulgaria%27s+Socialist-Backed+Govt%3A+Deposit+Tax+Here+to+Stay\" target=\"_blank\" rel=\"noreferrer\">БСП преди изборите (наричат данъка „несправедлив“)<!-- -->, <!-- -->2013</a></p><p class=\"text-[15px] mt-3\">След изборите финансовият министър Петър Чобанов обяви, че данъкът остава, за да се съберат около 90 млн. лв. за образование. След това парламентът го намали от 10% на 8% от 2014 г. с план за още намаления и пълно отпадане от 2017 г. През декември 2014 г. новото мнозинство обсъди връщане на 10%, но бюджетната комисия запази 8%.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->3<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">2013</span><p>Чобанов: данъкът остава.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">2014</span><p>Ставката е намалена на 8%, с план за отпадане от 2017 г.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">декември 2014</span><p>Новото мнозинство запазва 8%.</p></li></ol></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://www.novinite.com/view_news.php?id=155246&amp;\" target=\"_blank\" rel=\"noreferrer\">Novinite: данъкът се намалява на 8% от 2014 г.</a><a href=\"https://sofiaglobe.com/?p=38956\" target=\"_blank\" rel=\"noreferrer\">Sofia Globe: планът за отпадане и опитът за връщане на 10%</a><a href=\"https://www.bta.bg/en/news/183679-Parliamentary-Budget-Committee-Decides-to-Keep-Deposit-Interest-Tax-at-8-Resto\" target=\"_blank\" rel=\"noreferrer\">БТА: комисията запазва 8% (2.12.2014)</a></p></li></ul></section><p class=\"text-xs text-muted mt-4\">Програми: <span><a href=\"https://www.bia-bg.com/uploads/files/Government_programmes/2013-Government_program-Oresharski.pdf\" target=\"_blank\" rel=\"noreferrer\">Приоритети на кабинета „Орешарски“ (2013)</a></span><span>; <a href=\"https://www.mon.bg/nfs/2018/01/14_01_17_governmentreport_3.pdf\" target=\"_blank\" rel=\"noreferrer\">Отчет на правителството</a></span>. Проверено: <!-- -->2026-11-19</p><p class=\"text-[15px] mt-6\">Сравни с: <span><a href=\"/obeshtaniya/radev\">Прогресивна България</a></span><span>, <a href=\"/obeshtaniya/zhelyazkov\">Правителство „Желязков“</a></span><span>, <a href=\"/obeshtaniya/denkov\">Правителство „Денков“</a></span><span>, <a href=\"/obeshtaniya/petkov\">Правителство „Петков“</a></span><span>, <a href=\"/obeshtaniya/borisov-3\">Правителство „Борисов 3“</a></span><span>, <a href=\"/obeshtaniya/borisov-2\">Правителство „Борисов 2“</a></span><span>, <a href=\"/obeshtaniya/borisov-1\">Правителство „Борисов 1“</a></span><span>, <a href=\"/obeshtaniya/sluzhebno-gyurov\">Служебно правителство „Гюров“</a></span><span>, <a href=\"/obeshtaniya/sluzhebno-glavchev\">Служебни правителства „Главчев“</a></span><span>, <a href=\"/obeshtaniya/sluzhebno-donev\">Служебни правителства „Донев“</a></span><span>, <a href=\"/obeshtaniya/sluzhebno-yanev\">Служебни правителства „Янев“</a></span>.</p></div><!--$--><!--/$--></main><!--$--><!--/$--><footer class=\"bg-surface border-t border-rule mt-20\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 text-sm text-muted grid gap-2 sm:grid-cols-2\"><p>Не подкрепяме партия, кандидат или правителство. Всяко число има източник и дата.<!-- --> <a href=\"/metodologiya\">Как работим</a> · <a href=\"/rechnik\">Речник</a> · <a href=\"/sastoyanie\">Състояние на данните</a> · <!--$?--><template id=\"B:1\"></template><a href=\"/metodologiya#greshki\">Съобщи за грешка</a><!--/$--></p><p class=\"sm:text-right\">Вътрешен прототип · данните са към датите, посочени до тях</p></div></footer><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script id=\"_R_\">(globalThis[\"TURBOPACK\"] || (globalThis[\"TURBOPACK\"] = [])).push({\"otherChunks\":[\"static/chunks/310vm2bl3xxpt.js\",\"static/chunks/2vy51v46dlsq-.js\",\"static/chunks/2bx7ggprk0oi5.js\",\"static/chunks/0c1ad7rcpjghx.js\"],\"runtimeModuleIds\":[94553]});</script><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" async=\"\"></script><div hidden id=\"S:0\"><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" aria-current=\"page\" class=\"no-underline pb-1 border-b-2 text-white border-red\" h