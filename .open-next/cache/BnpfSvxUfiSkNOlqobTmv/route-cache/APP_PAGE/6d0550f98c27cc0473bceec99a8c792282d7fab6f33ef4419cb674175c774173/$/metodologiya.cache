{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/metodologiya/layout,_N_T_/metodologiya/page,_N_T_/metodologiya"},"segmentPaths":["/_tree","/_full","/metodologiya/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/6d0550f98c27cc0473bceec99a8c792282d7fab6f33ef4419cb674175c774173/$/metodologiya","owner":{"kind":"APP_PAGE","sourceRoute":"/metodologiya/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0vn96-fhbu77m.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><title>Как работим · Осъзнатост</title><meta name=\"description\" content=\"Кой стои зад „Осъзнатост“, откъде са данните, кое се обновява само и кое пишат хора, как поправяме грешки.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Как работим · Осъзнатост\"/><meta property=\"og:description\" content=\"Кой стои зад „Осъзнатост“, откъде са данните, кое се обновява само и кое пишат хора, как поправяме грешки.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Как работим · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Кой стои зад „Осъзнатост“, откъде са данните, кое се обновява само и кое пишат хора, как поправяме грешки.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-3xl\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Как работим</h1></div></div><div class=\"space-y-5 text-[17px]\"><p>Не подкрепяме партия, кандидат или правителство. Всяко число на сайта има източник и дата, а всяко твърдение има автор. Прилагаме една и съща методология за всички, независимо кой управлява.</p><nav class=\"bg-surface rounded-sm p-4 text-[15px]\"><a href=\"#koy\">Кой стои зад проекта</a> · <a href=\"#avtomatichno\">Кое е автоматично и кое пишат хора</a> · <a href=\"#fakt\">Факт, твърдение, оценка</a> · <a href=\"#zakon\">Как разказваме закон</a> · <a href=\"#signal\">Сигнал не е обвинение</a> · <a href=\"#ednakvo\">Еднакъв подход към всички</a> · <a href=\"#iztochnici\">Източници</a> · <a href=\"#greshki\">Грешки и поправки</a></nav><h2 id=\"koy\" class=\"text-xl font-bold pt-2 scroll-mt-32 lg:scroll-mt-20\">Кой стои зад проекта</h2><p>„Осъзнатост“ е независим, некомерсиален граждански проект. Не получава пари от партии, институции или фирми и не продава реклама. Работи на безплатни услуги (GitHub, Vercel, Supabase), без платен изкуствен интелект. Програмният код е публичен в<!-- --> <a href=\"https://github.com/osaznatost/osaznatost-web\" target=\"_blank\" rel=\"noreferrer\">GitHub</a>, така че всеки може да провери как се смята всяко число.</p><h2 id=\"avtomatichno\" class=\"text-xl font-bold pt-2 scroll-mt-32 lg:scroll-mt-20\">Кое е автоматично и кое пишат хора</h2><ul class=\"list-disc pl-5 space-y-2\"><li><b>Автоматично, по правила:</b> гласуванията в парламента, законопроектите и докладите, обществените поръчки и анексите, плащанията от СЕБРА, Търговският регистър, местната власт и декларациите, решенията на общинските съвети, цените в магазините, статистиките. Също и сигналите (съкратен срок, нови текстове на второ четене, червени флагове в поръчките), цитатите от документите на парламента и сверката на числата от трибуната. Правилата са едни и същи за всички и са описани до всеки сигнал. <a href=\"/sastoyanie\">Кога е обновен всеки източник</a>.</li><li><b>Пишат хора (редакционно):</b> обобщенията „двете страни“ на законите, обещанията и оценката им, проверките на твърдения, съдебните случаи и санкциите. Всяко изречение там има номер на източник. Ако не можем да го подкрепим с документ, не го пишем.</li></ul><h2 id=\"fakt\" class=\"text-xl font-bold pt-2 scroll-mt-32 lg:scroll-mt-20\">Факт, твърдение, оценка</h2><ul class=\"space-y-3\"><li><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Факт</span> Потвърдено от официален документ: стенограма, гласуване, Държавен вестник, съдебен акт, отчет на институция.</li><li><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-ink border border-rule\">Твърдение</span> Казано публично от конкретен човек. Показваме кой, кога и къде, докато не го проверим.</li><li><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-white text-muted border border-dashed border-muted\">Оценка</span> Мнение или тълкуване. Никога не го представяме като факт.</li></ul><h2 id=\"zakon\" class=\"text-xl font-bold pt-2 scroll-mt-32 lg:scroll-mt-20\">Как разказваме един закон</h2><p>За всеки гласуван закон показваме едно и също, в този ред: какво променя; мотивите на вносителите; какво казват критиците; какво показват данните; какво печели и какво губи всяка засегната група; какво следва, ако бъде приет или отхвърлен. Всеки аргумент има номер на източник, който води до първоизточника. Таблицата „печели и губи“ е наш анализ на текста и на цитираните данни, а не позиция на партия. Под нея са дословните цитати от документите, без редакция.</p><h2 id=\"signal\" class=\"text-xl font-bold pt-2 scroll-mt-32 lg:scroll-mt-20\">Сигнал не е обвинение</h2><p>Сигнал не е обвинение, а обвинение не е присъда. Червеният флаг в поръчка или законопроект е повод за въпрос, не доказателство за нарушение. При всяко съдебно дело показваме точния му статус (обвинен, подсъдим, осъден, оправдан, прекратено) и документа, на който се основава.</p><h2 id=\"ednakvo\" class=\"text-xl font-bold pt-2 scroll-mt-32 lg:scroll-mt-20\">Еднакъв подход към всички</h2><p>За да се види дали не изкривяваме картината, тук броим какво сме записали за всяка страна. Броят се смята автоматично от данните на сайта. Разлика в броя не означава сама по себе си пристрастие: някои правителства са управлявали по-дълго, а случаите зависят от това какво са направили прокуратурата и съдът.</p><div class=\"overflow-x-auto\"><table class=\"w-full text-[15px] border-collapse\"><thead><tr class=\"text-left border-b border-rule\"><th class=\"py-1 pr-3\">Правителство</th><th class=\"py-1 px-2 num\">Обещания</th><th class=\"py-1 px-2 num\">Изпълнени</th><th class=\"py-1 px-2 num\">Частично / в процес</th><th class=\"py-1 px-2 num\">Неизпълнени</th><th class=\"py-1 pl-2 num\">Непроверени</th></tr></thead><tbody><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">Правителство „Радев“ (Прогресивна България)</td><td class=\"py-1 px-2 num\">10</td><td class=\"py-1 px-2 num\">2</td><td class=\"py-1 px-2 num\">4</td><td class=\"py-1 px-2 num\">4</td><td class=\"py-1 pl-2 num\">0</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">Правителство „Желязков“ (ГЕРБ–СДС, БСП, ИТН)</td><td class=\"py-1 px-2 num\">10</td><td class=\"py-1 px-2 num\">4</td><td class=\"py-1 px-2 num\">3</td><td class=\"py-1 px-2 num\">3</td><td class=\"py-1 pl-2 num\">0</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">Правителство „Денков“ (ПП–ДБ и ГЕРБ–СДС)</td><td class=\"py-1 px-2 num\">10</td><td class=\"py-1 px-2 num\">5</td><td class=\"py-1 px-2 num\">3</td><td class=\"py-1 px-2 num\">2</td><td class=\"py-1 pl-2 num\">0</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">Правителство „Петков“ (ПП, БСП, ИТН, ДБ)</td><td class=\"py-1 px-2 num\">10</td><td class=\"py-1 px-2 num\">7</td><td class=\"py-1 px-2 num\">0</td><td class=\"py-1 px-2 num\">3</td><td class=\"py-1 pl-2 num\">0</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">Правителство „Борисов 3“ (ГЕРБ и Обединени патриоти)</td><td class=\"py-1 px-2 num\">10</td><td class=\"py-1 px-2 num\">6</td><td class=\"py-1 px-2 num\">1</td><td class=\"py-1 px-2 num\">3</td><td class=\"py-1 pl-2 num\">0</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">Правителство „Борисов 2“ (ГЕРБ и Реформаторски блок)</td><td class=\"py-1 px-2 num\">10</td><td class=\"py-1 px-2 num\">4</td><td class=\"py-1 px-2 num\">3</td><td class=\"py-1 px-2 num\">3</td><td class=\"py-1 pl-2 num\">0</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">Правителство „Орешарски“ (БСП и ДПС)</td><td class=\"py-1 px-2 num\">10</td><td class=\"py-1 px-2 num\">5</td><td class=\"py-1 px-2 num\">2</td><td class=\"py-1 px-2 num\">3</td><td class=\"py-1 pl-2 num\">0</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">Правителство „Борисов 1“ (ГЕРБ)</td><td class=\"py-1 px-2 num\">10</td><td class=\"py-1 px-2 num\">2</td><td class=\"py-1 px-2 num\">3</td><td class=\"py-1 px-2 num\">5</td><td class=\"py-1 pl-2 num\">0</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">Служебно правителство „Гюров“</td><td class=\"py-1 px-2 num\">1</td><td class=\"py-1 px-2 num\">1</td><td class=\"py-1 px-2 num\">0</td><td class=\"py-1 px-2 num\">0</td><td class=\"py-1 pl-2 num\">0</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">Служебни правителства „Главчев“</td><td class=\"py-1 px-2 num\">2</td><td class=\"py-1 px-2 num\">2</td><td class=\"py-1 px-2 num\">0</td><td class=\"py-1 px-2 num\">0</td><td class=\"py-1 pl-2 num\">0</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">Служебни правителства „Донев“</td><td class=\"py-1 px-2 num\">2</td><td class=\"py-1 px-2 num\">2</td><td class=\"py-1 px-2 num\">0</td><td class=\"py-1 px-2 num\">0</td><td class=\"py-1 pl-2 num\">0</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">Служебни правителства „Янев“</td><td class=\"py-1 px-2 num\">1</td><td class=\"py-1 px-2 num\">1</td><td class=\"py-1 px-2 num\">0</td><td class=\"py-1 px-2 num\">0</td><td class=\"py-1 pl-2 num\">0</td></tr></tbody></table></div><p class=\"text-[15px]\"><b>Съдебни случаи по партия:</b> <!-- -->без партия (16), ГЕРБ-СДС (9), ПП–ДБ (4), ДПС (3), ГЕРБ (3), Българско лято (1), Реформаторски блок (1), Обединени патриоти (1), БСП (1), Воля (1)<!-- -->.<!-- --> <b>Проверени твърдения по автор:</b> <!-- -->Георги Вълджев (6), Христо Гаджев (3), Бойко Борисов (2), Румен Радев (1), Гълъб Донев (1), Асен Василев (1), Министерство на финансите (бюджет на ДОО за 2026 г.) (1), Публично твърдение (1)<!-- -->. Пълните списъци: <a href=\"/obeshtaniya\">обещания</a>, <a href=\"/proverki/sankcii\">санкции и съдебни случаи</a>, <a href=\"/proverki\">проверки</a>.</p><h2 id=\"iztochnici\" class=\"text-xl font-bold pt-2 scroll-mt-32 lg:scroll-mt-20\">Източници</h2><p>Използваме данни на НСИ, Министерството на финансите, БНБ, Народното събрание, Евростат, Сметната палата, Търговския регистър, ЦАИС ЕОП, СЕБРА (data.egov.bg) и общините. Медиите използваме само като източник на изказвания, не на факти.</p><p>Част от данните (поименните гласувания, местната власт) взимаме обработени от отворения проект<!-- --> <a href=\"https://naiasno.bg\" target=\"_blank\" rel=\"noreferrer\">„Наясно“</a> (лиценз MIT), който ги извлича от първоизточниците. Към всяко гласуване даваме линк към оригиналната стенограма.</p><p>Числото само по себе си рядко казва нещо. Показваме го спрямо БВП, на човек, спрямо ЕС, спрямо предходни години и след инфлацията.</p><h2 id=\"greshki\" class=\"text-xl font-bold pt-2 scroll-mt-32 lg:scroll-mt-20\">Грешки и поправки</h2><p>Когато сгрешим, поправяме видимо и пишем кога и какво сме променили. Ако видите грешка, натиснете „Съобщи за грешка“ в долната част на всяка страница. Сигналът е публичен (в GitHub) и в него се вижда как е решен. Моля, добавете източник, ако имате.</p><div><p class=\"font-semibold\">Дневник на поправките</p><ul class=\"mt-2 space-y-2 text-[15px]\"><li class=\"border-l-4 border-rule pl-3\"><span class=\"text-muted num\">20.11.2026</span> · <a href=\"/mesta\">страницата</a>: <!-- -->Проектите от Инвестиционната програма с договор над 100 000 € и изплатени под 5% бяха обозначени като „спрян“. Това е автоматично правило, не официален статус, затова надписът е сменен на „под 5% изплатени“ с обяснение.</li><li class=\"border-l-4 border-rule pl-3\"><span class=\"text-muted num\">20.11.2026</span> · <a href=\"/vlast/sadebna-vlast\">страницата</a>: <!-- -->Изборът на членове на ВСС от парламента иска поне 160 гласа „за“ (две трети от всички депутати). Девет гласувания от 20.11.2026 г. с по-малко гласове бяха показани като приети; вече са показани като неприети. Правилото е добавено в обработката на всички бъдещи гласувания.</li><li class=\"border-l-4 border-rule pl-3\"><span class=\"text-muted num\">19.11.2026</span> · <a href=\"/parlament/zakon/ministerstvoto-na-vatreshnite-raboti\">страницата</a>: <!-- -->Премахнахме наше описание на съдържанието на становище на Българския хелзинкски комитет, което не беше взето от самия документ. Оставихме само факта, че становището е внесено, с линк към него.</li><li class=\"border-l-4 border-rule pl-3\"><span class=\"text-muted num\">19.11.2026</span> · <a href=\"/parlament/zakon/mestnite-danatsi-i-taksi\">страницата</a>: <!-- -->Коригирахме оценката за ръста на данъчните оценки на имотите до 2029 г.: около 2 пъти, а не около 2,4 пъти. Увеличенията се смятат спрямо основата за 2026 г., а не една върху друга.</li></ul></div></div></div><!--$--><!--/$--></main><!--$--><!--/$--><footer class=\"bg-surface border-t border-rule mt-20\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 text-sm text-muted grid gap-2 sm:grid-cols-2\"><p>Не подкрепяме партия, кандидат или правителство. Всяко число има източник и дата.<!-- --> <a href=\"/metodologiya\">Как работим</a> · <a href=\"/rechnik\">Речник</a> · <a href=\"/sastoyanie\">Състояние на данните</a> · <!--$?--><template id=\"B:1\"></template><a href=\"/metodologiya#greshki\">Съобщи за грешка</a><!--/$--></p><p class=\"sm:text-right\">Вътрешен прототип · данните са към датите, посочени до тях</p></div></footer><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script id=\"_R_\">(globalThis[\"TURBOPACK\"] || (globalThis[\"TURBOPACK\"] = [])).push({\"otherChunks\":[\"static/chunks/310vm2bl3xxpt.js\",\"static/chunks/2vy51v46dlsq-.js\",\"static/chunks/2bx7ggprk0oi5.js\",\"static/chunks/0c1ad7rcpjghx.js\"],\"runtimeModuleIds\":[94553]});</script><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" async=\"\"></script><div hidden id=\"S:0\"><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hi