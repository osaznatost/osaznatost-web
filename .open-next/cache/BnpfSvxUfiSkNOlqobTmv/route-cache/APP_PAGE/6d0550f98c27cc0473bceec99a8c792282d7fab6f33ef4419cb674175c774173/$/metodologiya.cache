e\":\"py-1 pr-3\",\"children\":\"Правителство „Борисов 1“ (ГЕРБ)\"}],[\"$\",\"td\",null,{\"className\":\"py-1 px-2 num\",\"children\":10}],[\"$\",\"td\",null,{\"className\":\"py-1 px-2 num\",\"children\":2}],[\"$\",\"td\",null,{\"className\":\"py-1 px-2 num\",\"children\":3}],[\"$\",\"td\",null,{\"className\":\"py-1 px-2 num\",\"children\":5}],[\"$\",\"td\",null,{\"className\":\"py-1 pl-2 num\",\"children\":0}]]}],[\"$\",\"tr\",\"CT-GYUROV\",{\"className\":\"border-b border-rule\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-1 pr-3\",\"children\":\"Служебно правителство „Гюров“\"}],[\"$\",\"td\",null,{\"className\":\"py-1 px-2 num\",\"children\":1}],[\"$\",\"td\",null,{\"className\":\"py-1 px-2 num\",\"children\":1}],[\"$\",\"td\",null,{\"className\":\"py-1 px-2 num\",\"children\":0}],[\"$\",\"td\",null,{\"className\":\"py-1 px-2 num\",\"children\":0}],\"$L32\"]}],\"$L33\",\"$L34\",\"$L35\"]}]]}]}]\n1d:[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Съдебни случаи по партия:\"}],\" \",\"без партия (16), ГЕРБ-СДС (9), ПП–ДБ (4), ДПС (3), ГЕРБ (3), Българско лято (1), Реформаторски блок (1), Обединени патриоти (1), БСП (1), Воля (1)\",\".\",\" \",[\"$\",\"b\",null,{\"children\":\"Проверени твърдения по автор:\"}],\" \",\"Георги Вълджев (6), Христо Гаджев (3), Бойко Борисов (2), Румен Радев (1), Гълъб Донев (1), Асен Василев (1), Министерство на финансите (бюджет на ДОО за 2026 г.) (1), Публично твърдение (1)\",\". Пълните списъци: \",[\"$\",\"$L9\",null,{\"href\":\"/obeshtaniya\",\"children\":\"обещания\"}],\", \",[\"$\",\"$L9\",null,{\"href\":\"/proverki/sankcii\",\"children\":\"санкции и съдебни случаи\"}],\", \",[\"$\",\"$L9\",null,{\"href\":\"/proverki\",\"children\":\"проверки\"}],\".\"]}]\n1e:[\"$\",\"h2\",null,{\"id\":\"iztochnici\",\"className\":\"text-xl font-bold pt-2 scroll-mt-32 lg:scroll-mt-20\",\"children\":\"Източници\"}]\n1f:[\"$\",\"p\",null,{\"children\":\"Използваме данни на НСИ, Министерството на финансите, БНБ, Народното събрание, Евростат, Сметната палата, Търговския регистър, ЦАИС ЕОП, СЕБРА (data.egov.bg) и общините. Медиите използваме само като източник на изказвания, не на факти.\"}]\n20:[\"$\",\"p\",null,{\"children\":[\"Част от данните (поименните гласувания, местната власт) взимаме обработени от отворения проект\",\" \",[\"$\",\"a\",null,{\"href\":\"https://naiasno.bg\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"„Наясно“\"}],\" (лиценз MIT), който ги извлича от първоизточниците. Към всяко гласуване даваме линк към оригиналната стенограма.\"]}]\n21:[\"$\",\"p\",null,{\"children\":\"Числото само по себе си рядко казва нещо. Показваме го спрямо БВП, на човек, спрямо ЕС, спрямо предходни години и след инфлацията.\"}]\n22:[\"$\",\"h2\",null,{\"id\":\"greshki\",\"className\":\"text-xl font-bold pt-2 scroll-mt-32 lg:scroll-mt-20\",\"children\":\"Грешки и поправки\"}]\n23:[\"$\",\"p\",null,{\"children\":\"Когато сгрешим, поправяме видимо и пишем кога и какво сме променили. Ако видите грешка, натиснете „Съобщи за грешка“ в долната част на всяка страница. Сигналът е публичен (в GitHub) и в него се вижда как е решен. Моля, добавете източник, ако имате.\"}]\n24:[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Дневник на поправките\"}],[\"$\",\"ul\",null,{\"className\":\"mt-2 space-y-2 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"border-l-4 border-rule pl-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-muted num\",\"children\":\"20.11.2026\"}],\" · \",[\"$\",\"$L9\",null,{\"href\":\"/mesta\",\"children\":\"страницата\"}],\": \",\"Проектите от Инвестиционната програма с договор над 100 000 € и изплатени под 5% бяха обозначени като „спрян“. Това е автоматично правило, не официален статус, затова надписът е сменен на „под 5% изплатени“ с обяснение.\"]}],[\"$\",\"li\",\"1\",{\"className\":\"border-l-4 border-rule pl-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-muted num\",\"children\":\"20.11.2026\"}],\" · \",[\"$\",\"$L9\",null,{\"href\":\"/vlast/sadebna-vlast\",\"children\":\"страницата\"}],\": \",\"Изборът на членове на ВСС от парламента иска поне 160 гласа „за“ (две трети от всички депутати). Девет гласувания от 20.11.2026 г. с по-малко гласове бяха показани като приети; вече са показани като неприети. Правилото е добавено в обработката на всички бъдещи гласувания.\"]}],[\"$\",\"li\",\"2\",{\"className\":\"border-l-4 border-rule pl-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-muted num\",\"children\":\"19.11.2026\"}],\" · \",[\"$\",\"$L9\",null,{\"href\":\"/parlament/zakon/ministerstvoto-na-vatreshnite-raboti\",\"children\":\"страницата\"}],\": \",\"Премахнахме наше описание на съдържанието на становище на Българския хелзинкски комитет, което не беше взето от самия документ. Оставихме само факта, че становището е внесено, с линк към него.\"]}],[\"$\",\"li\",\"3\",{\"className\":\"border-l-4 border-rule pl-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-muted num\",\"children\":\"19.11.2026\"}],\" · \",[\"$\",\"$L9\",null,{\"href\":\"/parlament/zakon/mestnite-danatsi-i-taksi\",\"children\":\"страницата\"}],\": \",\"Коригирахме оценката за ръста на данъчните оценки на имотите до 2029 г.: около 2 пъти, а не около 2,4 пъти. Увеличенията се смятат спрямо основата за 2026 г., а не една върху друга.\"]}]]}]]}]\n25:[\"$\",\"$L36\",null,{\"children\":[\"$\",\"$6\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@37\"}]}]\n2b:[\"$\",\"meta\",\"18\",{\"name\":\"twitter:image:height\",\"content\":\"630\"}]\n2c:[\"$\",\"link\",\"19\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?favicon.117ezoe8m31dk.ico\",\"sizes\":\"48x48\",\"type\":\"image/x-icon\"}]\n2d:[\"$\",\"$L38\",\"20\",{}]\n2e:[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]\nc:300\n32:[\"$\",\"td\",null,{\"className\":\"py-1 pl-2 num\",\"children\":0}]\n33:[\"$\",\"tr\",\"CT-GLAVCHEV\",{\"className\"