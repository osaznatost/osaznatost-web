ildren\\\":\\\"Не подкрепяме партия, кандидат или правителство. Всяко число на сайта има източник и дата, а всяко твърдение има автор. Прилагаме една и съща методология за всички, независимо кой управлява.\\\"}],[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"bg-surface rounded-sm p-4 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#koy\\\",\\\"children\\\":\\\"Кой стои зад проекта\\\"}],\\\" · \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#avtomatichno\\\",\\\"children\\\":\\\"Кое е автоматично и кое пишат хора\\\"}],\\\" · \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#fakt\\\",\\\"children\\\":\\\"Факт, твърдение, оценка\\\"}],\\\" · \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#zakon\\\",\\\"children\\\":\\\"Как разказваме закон\\\"}],\\\" · \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#signal\\\",\\\"children\\\":\\\"Сигнал не е обвинение\\\"}],\\\" · \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#ednakvo\\\",\\\"children\\\":\\\"Еднакъв подход към всички\\\"}],\\\" · \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#iztochnici\\\",\\\"children\\\":\\\"Източници\\\"}],\\\" · \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#greshki\\\",\\\"children\\\":\\\"Грешки и поправки\\\"}]]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"koy\\\",\\\"className\\\":\\\"text-xl font-bold pt-2 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":\\\"Кой стои зад проекта\\\"}],\\\"$Le\\\",\\\"$Lf\\\",\\\"$L10\\\",\\\"$L11\\\",\\\"$L12\\\",\\\"$L13\\\",\\\"$L14\\\",\\\"$L15\\\",\\\"$L16\\\",\\\"$L17\\\",\\\"$L18\\\",\\\"$L19\\\",\\\"$L1a\\\",\\\"$L1b\\\",\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\",\\\"$L1f\\\",\\\"$L20\\\",\\\"$L21\\\"]}]]}],null,\\\"$L22\\\"]}],\\\"p\\\":false,\\\"v\\\":null}}]]\\nb:[[\\\"children\\\",{\\\"s\\\":\\\"metodologiya\\\",\\\"h\\\":512,\\\"d\\\":{\\\"r\\\":[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L4\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$undefined