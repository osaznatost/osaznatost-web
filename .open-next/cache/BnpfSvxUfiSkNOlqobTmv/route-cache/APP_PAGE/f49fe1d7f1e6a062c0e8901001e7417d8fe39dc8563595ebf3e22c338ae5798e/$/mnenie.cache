{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/mnenie/layout,_N_T_/mnenie/page,_N_T_/mnenie"},"segmentPaths":["/_tree","/_full","/mnenie/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/f49fe1d7f1e6a062c0e8901001e7417d8fe39dc8563595ebf3e22c338ae5798e/$/mnenie","owner":{"kind":"APP_PAGE","sourceRoute":"/mnenie/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0vn96-fhbu77m.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><title>Твоето мнение за законите · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Твоето мнение за законите · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Твоето мнение за законите · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Твоето мнение за законите</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Депутатите гласуват всеки закон. Тук можеш да кажеш и ти какво мислиш: „За“, „Против“ или „Не знам“. До всеки закон има обяснение с прости думи и доводите на двете страни.</div></div></div><section id=\"kak\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Как работи</h2><ul class=\"list-disc pl-5 max-w-3xl text-[15px] space-y-1.5\"><li>Един глас на човек: потвърждаваш имейла си с код веднъж. <b>Имейлът не се пази.</b> Пазим само необратим отпечатък, и той е различен за всеки закон, затова никой (и ние) не може да види кой как е гласувал.</li><li>Резултатът се показва едва след като гласуваш, за да не влияе на избора. Гласа си можеш да промениш по всяко време.</li><li>Това е мнението на хората, които са решили да гласуват тук, не представително проучване. До резултата стои броят гласували, а на страницата на закона точно под него е как са гласували групите в парламента.</li><li>Когато законопроект е на обществено обсъждане, официалното становище се подава на <a href=\"https://www.strategy.bg\" target=\"_blank\" rel=\"noreferrer\">strategy.bg</a>; там мнението се отчита от институцията.</li></ul></section><section id=\"zakoni\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Закони (61)</h2><ul class=\"divide-y divide-rule border-y border-rule max-w-4xl\"><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/zabrana-na-himicheskoto-orazhie-i-za-kontrol-na-toksichnite-himicheski-veshtestva-i-tehnite-prekursori#mnenie\">Закон за забрана на химическото оръжие и за контрол на токсичните химически вещества</a><p class=\"text-sm text-muted\">Приет на първо четене на 24.09.2026 г. (единодушно)</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законопроектът променя регистрацията на фирмите, които произвеждат, преработват или употребяват химически вещества по Конвенцията за химическото оръжие. Сега удостоверението се издава от междуведомствената комисия към министъра на икономиката за 3 години и после се подновява. Проектът е по Закона за ограничаване на административното регулиране и урежда публичен регистър (име, ЕИК, номер и срок на удостоверението, дата на прекратяване).</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/hazarta#mnenie\">Закон за хазарта (по-високи данъци, забрана на рекламата)</a><p class=\"text-sm text-muted\">Приет на първо четене на 18.11.2026 г. (единодушно); предстои второ четене</p><p class=\"text-[15px] mt-1 line-clamp-3\">Правителственият проект повишава алтернативния данък за игралните автомати (от 800 лв. на 600 € на тримесечие), масите (от 22 000 лв. на 13 000 €) и другото оборудване; въвежда дистанционна връзка на игралните системи с НАП, нови лицензионни такси (50 000–100 000 €) и минимална месечна такса за онлайн залаганията (поне 100 000 €). Част от таксата (1–2%) се връща на операторите, ако я дарят на спорта. Рекламата на хазарт се забранява, освен при спонсорство на спортни федерации, клубове и олимпийския комитет (върху екипи и съоръжения). Чуждестранните онлайн оператори трябва да имат място на дейност в България; банките и платежните институции внасят в бюджета частта от таксите си над 1,5% при хазартни плащания. В същия закон е включена и забрана за плащания в брой между строителни фирми, изпълнители и подизпълнители.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/vodite#mnenie\">Закон за водите</a><p class=\"text-sm text-muted\">Приет окончателно на 3 юни 2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Промените са насочени основно към ВиК асоциациите: как общините и държавата заедно управляват водоснабдяването в една област. Те са свързани с изпълнението на Плана за възстановяване и устойчивост, от който зависят европейски средства за водния сектор.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/nezavisimiya-finansov-odit-i-izrazyavaneto-na-sigurnost-po-ustoychivostta#mnenie\">Закон за независимия финансов одит и изразяването на сигурност по устойчивостта</a><p class=\"text-sm text-muted\">Приет на първо четене на 18.11.2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Заедно с промените в Закона за счетоводството въвежда директивата „Омнибус“ (2026/470): проверката на отчетите за устойчивост остава с „ограничена степен на сигурност“ (по-евтина и по-лека), има преходен режим за одитори от трети държави. Целта е по-малко разходи за фирмите.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/schetovodstvoto#mnenie\">Закон за счетоводството (по-малко фирми с отчети за устойчивост)</a><p class=\"text-sm text-muted\">Приет на първо четене на 18.11.2026 г.; предстои второ четене</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законът въвежда европейската директива 2026/470 („Омнибус“), която облекчава отчитането на устойчивостта: задължени остават само много големите предприятия — с над 450 млн. € нетни приходи и над 1000 служители; малките и средните компании на борсата отпадат от задължението.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/lova-i-opazvane-na-divecha#mnenie\">Закон за лова и опазване на дивеча (четири законопроекта, ноември 2026)</a><p class=\"text-sm text-muted\">Приети на първо четене на 18.11.2026 г.; предстои второ четене</p><p class=\"text-[15px] mt-1 line-clamp-3\">Най-спорният проект (на Тодор Джиков и др.) урежда кога и как може да се прекратят предсрочно дългосрочните договори на държавните горски предприятия с частни фирми за съвместна дейност в държавните ловни стопанства, забранява такива договори за стопанствата „Воден – Ири Хисар“ и „Искър“ (ползвани за държавни представителни нужди) и дава едномесечен срок сключените договори да се приведат в съответствие, иначе — правни последици. Другите проекти въвеждат електронен ловен билет и регистър, поправителен изпит за ловци и прехвърлят таксите за ловни билети към регионалните дирекции по горите.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/chuzhdentsite-v-republika-balgariya#mnenie\">Закон за чужденците в Република България (единно разрешение за пребиваване и работа, сезонни работници, служебни паспорти)</a><p class=\"text-sm text-muted\">Приет на второ четене на 18.11.2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Правителственият законопроект въвежда в българското право европейските правила за единно разрешение за пребиваване и работа на граждани на трети държави и за проверка (скрининг) на външните граници. Работодател, по чиято вина чужденец загуби достъп до пазара на труда, ще му дължи обезщетение, а при осигурено от работодателя жилище за сезонен работник се изисква писмен договор за наем. Чрез промени в други закони срокът за обикновена услуга за лични документи пада от 30 на 20 дни, а служебните паспорти могат да се ползват само за служебни пътувания.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/publichnite-finansi#mnenie\">Закон за публичните финанси (новите бюджетни правила на ЕС)</a><p class=\"text-sm text-muted\">Приет на първо четене на 12.11.2026 г.; предстои второ четене</p><p class=\"text-[15px] mt-1 line-clamp-3\">Правителственият законопроект прилага новата икономическа рамка на ЕС от април 2024 г. и еврото: остават таваните за дефицит и дълг от Пакта за стабилност, но средносрочната цел за структурния дефицит се заменя с единен показател — ръстът на „нетните разходи“ спрямо плана, одобрен от Съвета на ЕС. Отхвърлените проекти на ДБ предлагаха: методика за разпределяне на общинските пари по населени места и райони; външна оценка на програмните бюджети от Фискалния съвет два пъти годишно; задължение министърът на финансите да публикува до 5-о число месечните данни за приходите и разходите в отворен, машинночетим формат.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/danak-varhu-dobavenata-stoynost#mnenie\">Закон за данък върху добавената стойност (електронни фактури, праг за регистрация, глоби)</a><p class=\"text-sm text-muted\">Приет на първо четене на 12.11.2026 г.; предстои второ четене</p><p class=\"text-[15px] mt-1 line-clamp-3\">Правителственият законопроект въвежда задължителни структурирани електронни фактури между фирмите и към държавата, подавани в реално време към НАП; дневниците за покупки и продажби отпадат, а НАП ще генерира проект на месечната декларация. Очакваният приход е 350 млн. € за 2028 г. и 450 млн. € за 2029 г. Въвежда се задължителна регистрация по ДДС преди първата продажба на нова сграда или парцел (+120 млн. €). Прагът за регистрация се вдига поетапно до 60 000 € (2027), 70 000 € (2028) и 75 000 € (2029). Глобите, непроменяни от 2007 г., се превръщат от лева в евро едно към едно (100 лв. стават 100 €), т.е. на практика се удвояват. Нулева ставка за отбранителни доставки по европейския инструмент SAFE.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/aktsizite-i-danachnite-skladove#mnenie\">Закон за акцизите и данъчните складове</a><p class=\"text-sm text-muted\">Приет окончателно на 25 септември 2026 г. (обнародван в ДВ, бр. 90/2026)</p><p class=\"text-[15px] mt-1 line-clamp-3\">Временно нулев акциз от 1 октомври до 31 декември 2026 г. за природния газ (метан) и пропан-бутана (LPG), когато се използват като гориво за автомобили. Мотивът са високите цени на горивата заради положението в Близкия изток.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/korporativnoto-podohodno-oblagane#mnenie\">Закон за корпоративното подоходно облагане (глобален минимален данък, загуби, амортизации)</a><p class=\"text-sm text-muted\">Приет на първо четене на 11.11.2026 г.; предстои второ четене</p><p class=\"text-[15px] mt-1 line-clamp-3\">Правителственият законопроект въвежда указанията на ОИСР за глобалния минимален данък на многонационалните групи; вдига прага за данъчен дълготраен актив от 700 лв. на 1 000 €; удължава срока за пренасяне на данъчни загуби от 5 на 10 години, но ограничава приспадането до 70% от печалбата за годината; въвежда ускорена данъчна амортизация за системи с изкуствен интелект и мощна компютърна и сървърна техника. За повечето мерки Министерството на финансите посочва, че бюджетният ефект „не може да бъде изчислен“.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/danatsite-varhu-dohodite-na-fizicheskite-litsa#mnenie\">Закон за данъците върху доходите на физическите лица (по-големи облекчения за деца)</a><p class=\"text-sm text-muted\">Приет на първо четене на 11.11.2026 г. (единодушно); предстои второ четене</p><p class=\"text-[15px] mt-1 line-clamp-3\">Данъчните облекчения за деца се уреждат трайно в закона (вместо всяка година в бюджета) и се увеличават: от данъчната основа се приспадат 5 000 € при едно дете, 10 000 € при две и 15 000 € при три и повече; при дете с увреждане — 12 000 €. Въвежда се ново облекчение за доказани разходи за здраве, образование и спорт на децата: до 2 000 € за едно, 4 000 € за две и 6 000 € за три и повече деца. Ефектът е 137,5 млн. € + 93 млн. € по-малко приходи. Глобите, непроменяни от 2007 г., се актуализират.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/mestnite-danatsi-i-taksi#mnenie\">Закон за местните данъци и такси (по-високи данъчни оценки на имотите от 2027 г.)</a><p class=\"text-sm text-muted\">Приет на първо четене на 11.11.2026 г. (124 „за“, 48 „против“); предстои второ четене</p><p class=\"text-[15px] mt-1 line-clamp-3\">Базисните стойности, от които се смята данъчната оценка на имотите, се вдигат поетапно спрямо стойността до края на 2026 г.: с 30% през 2027 г., с още 35 пункта през 2028 г. и с още 35 пункта през 2029 г. — до 2029 г. оценката става около два пъти по-висока. Новите оценки не се прилагат за таксата за битови отпадъци. Ефектът за общинските бюджети е +73,4 млн. € за 2027, +172,1 млн. € за 2028 и +270,8 млн. € за 2029 г. — т.е. по-висок данък сгради за собствениците. Отпадат невлезлите в сила текстове за патентен данък за заведенията (по становище на ЕК за държавна помощ). Глобите, непроменяни до 2019 г., се превалутират едно към едно в евро (на практика се удвояват).</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/energiyata-ot-vazobnovyaemi-iztochnitsi#mnenie\">Закон за енергията от възобновяеми източници (два закона: юли и ноември 2026)</a><p class=\"text-sm text-muted\">Малкият закон (вятърни централи) е обнародван в ДВ, бр. 70/2026; големият правителствен е гласуван на второ четене на 4–6.11.2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Големият правителствен законопроект завършва въвеждането на европейската директива за възобновяемата енергия (2023/2413), чийто срок изтече на 21.05.2025 г.; срещу България вече има процедура за нарушение. Той обновява целите за дела на зелената енергия по сектори, улеснява дългосрочните договори за купуване на зелен ток, въвежда задължения за доставчиците на горива в транспорта, зони за ускорено изграждане на централи с участие на местните общности, правила за биомасата (забрана за субсидии за изгаряне на трупи и промишлена дървесина), за битовите батерии и за малките децентрализирани производители. Малкият закон от юли удължава до 9 месеца валидността на становището за присъединяване на вятърните централи и облекчава затворените електроразпределителни мрежи.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/administrativnoto-regulirane-na-proizvodstvoto-na-optichni-diskove-i-matritsi#mnenie\">Закон за административното регулиране на производството на оптични дискове и матрици</a><p class=\"text-sm text-muted\">Приет на първо четене на 05.11.2026 г. (единодушно)</p><p class=\"text-[15px] mt-1 line-clamp-3\">Технически закон за по-малко административна тежест: информацията за лицензите за производство на оптични дискове и матрици се събира служебно, а услугите могат да се заявяват електронно. Изпълнява мерки 109–114 от плана за намаляване на административната тежест.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/publichnoto-predlagane-na-tsenni-knizha#mnenie\">Закон за публичното предлагане на ценни книжа (акции с повече гласове)</a><p class=\"text-sm text-muted\">Приет окончателно на 05.11.2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законът въвежда европейската директива 2024/2810: компании, които търгуват акциите си на многостранна система за търговия (вкл. пазара за растеж), могат да издават акции с повече гласове, така че основателите да не губят контрола, когато привличат инвеститори. За защита на миноритарните акционери важните решения изискват двойно квалифицирано мнозинство.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/chistotata-na-atmosferniya-vazduh#mnenie\">Закон за чистотата на атмосферния въздух (флуорирани газове и озонов слой)</a><p class=\"text-sm text-muted\">Приет окончателно на 05.11.2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законът прилага новите европейски регламенти за веществата, които разрушават озоновия слой (2024/590), и за флуорсъдържащите парникови газове (2024/573), използвани в климатици, хладилници и термопомпи. Определя контролните и сертифициращите органи, санкциите и сертифицирането на фирмите и техниците, които монтират и обслужват такова оборудване.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/balgarskiya-ezik#mnenie\">Закон за българския език (нов закон)</a><p class=\"text-sm text-muted\">Приет на първо четене на 04.11.2026 г. (единодушно); срокът за предложения е удължен</p><p class=\"text-[15px] mt-1 line-clamp-3\">Новият закон урежда ползването на книжовния български език в институциите, образованието, медиите и публичното пространство и създава Консултативен съвет за българския език: той събира годишни доклади от институциите, прави годишен доклад до Министерския съвет и парламента, предлага препоръки за правилата на книжовния език и дава становища по учебните планове и учебниците. Съветът няма контролни функции и не налага наказания; законът има и административнонаказателни разпоредби.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/zdraveto#mnenie\">Закон за здравето (фалшиви решения на ТЕЛК, спешна помощ)</a><p class=\"text-sm text-muted\">Приети на първо четене на 14.10.2026 г. два проекта; предстои второ четене</p><p class=\"text-[15px] mt-1 line-clamp-3\">Проектът на ПП–ДБ (приет единодушно) цели да спре „фалшивите ТЕЛК решения“: в електронната система за медицинска експертиза се въвежда автоматизирана оценка на риска по реалната история на диагнозите и изследванията в Националната здравноинформационна система (с правила и елементи на изкуствен интелект); при сигнал случаят се разглежда от НЕЛК. Разширява се и достъпът до системата с други методи за електронна идентификация. Проектът на „Прогресивна България“ (Георги Илиев) мина със 165 „за“; подробното му съдържание ще допълним. Отхвърленият проект на „Възраждане“ връщаше възможността човек в спешно състояние да бъде закаран веднага в най-близката болница, без да чака спешен екип.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/zhelezopatniya-transport#mnenie\">Закон за железопътния транспорт (права на пътниците и регистър на возилата)</a><p class=\"text-sm text-muted\">Приет окончателно на 16.10.2026 г., обнародван в ДВ, бр. 99/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законът определя български орган за европейския регистър на железопътните превозни средства и прилага новия регламент за правата на пътниците във влаковете (2021/782): информация, обезщетения при закъснения, помощ за хора с увреждания.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/upravlenie-na-otpadatsite#mnenie\">Закон за управление на отпадъците</a><p class=\"text-sm text-muted\">Приет окончателно на 16.10.2026 г., обнародван в ДВ бр. 99/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законопроектът засяга организациите по оползотворяване: фирмите, които поемат задължението на производителите и вносителите да събират и рециклират отпадъци от опаковки, батерии, гуми, масла, коли за скрап и др. Според вносителите целта е по-малко бариери и повече конкуренция в сектора.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/tehnicheskite-iziskvaniya-kam-produktite#mnenie\">Закон за техническите изисквания към продуктите (продукти при кризи)</a><p class=\"text-sm text-muted\">Приет на първо четене на 15.10.2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законопроектът въвежда европейските правила за извънредни ситуации на вътрешния пазар (Директива (ЕС) 2024/2749). При криза председателят на ДАМТН със заповед може да разреши пускане на пазара на продукти от особено значение (машини, асансьори, съоръжения под налягане, електрически и газови уреди, лични предпазни средства, строителни продукти и др.) без пълната процедура за оценка на съответствието и без маркировка CE. Производителят декларира на своя отговорност, че продуктът е безопасен, а върху продукта се отбелязва, че е пуснат като стока при криза. Режимът важи само докато трае извънредната ситуация.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/hranite#mnenie\">Закон за храните (минерални води по решение на Съда на ЕС)</a><p class=\"text-sm text-muted\">Приет на първо четене на 15.10.2026 г.; срокът за предложения е удължен на 21 дни</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законопроектът въвежда изцяло директивата за натуралните минерални води (2009/54/ЕО) с определения за находище, подземно водно тяло и извор. Съдът на ЕС осъди България на 03.04.2025 г. (дело C‑462/23) и двумесечният срок за поправка отдавна е изтекъл, затова има риск от финансови санкции.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/kodeks-za-zastrahovaneto#mnenie\">Кодекс за застраховането (Гаранционният фонд)</a><p class=\"text-sm text-muted\">Приет окончателно на 15.10.2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Промените уреждат как се покрива недостиг на средства във фондовете на Гаранционния фонд (който плаща обезщетения при фалит на застраховател или при катастрофа с незастрахован автомобил): разграничават авансовите от допълнителните вноски на застрахователите, уреждат кога Обезпечителният фонд плаща задължения на Националното бюро на автомобилните застрахователи при отнет лиценз и позволяват споразумения с аналогични органи в други държави.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/veterinarnomeditsinskata-deynost#mnenie\">Закон за ветеринарномедицинската дейност (забрана на фермите за кожи)</a><p class=\"text-sm text-muted\">Приет окончателно на 13.11.2026 г. (единодушно)</p><p class=\"text-[15px] mt-1 line-clamp-3\">Забранява се отглеждането, развъждането и умъртвяването на животни за ценни кожи, със санкции; чрез промяна в Закона за защита на животните това става „проява на жестокост“. Отпада изключението, което позволяваше хранене на животни във ферми с кухненски отпадъци. Наредбите трябва да се обновят до 6 месеца.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/darzhavnite-rezervi-i-voennovremennite-zapasi#mnenie\">Закон за държавните резерви и военновременните запаси</a><p class=\"text-sm text-muted\">Приет на първо четене на 08.10.2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законопроектът урежда достъпа на фирми с военновременна задача и разрешение за производство на военни изделия до техническата документация в Централната техническа база в с. Соколово, уточнява функциите на инспектората на агенцията и съгласува понятията за медицинските резерви със законите за лекарствата и медицинските изделия.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/kibersigurnost#mnenie\">Закон за киберсигурност (ограничаване на технологии) — отхвърлен проект на „Възраждане“</a><p class=\"text-sm text-muted\">Отхвърлен на първо четене на 07.10.2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Проектът предлагаше ограниченията за използване на определени технологии (напр. от доставчици, смятани за рискови) да се налагат по подход на управление на риска, а не широко, и Съветът по киберсигурността да преразгледа вече взетите решения. Вносителите смятат, че сегашната уредба създава регулаторна несигурност, по-високи разходи за бизнеса и ограничава конкуренцията.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/lechebnite-zavedeniya#mnenie\">Закон за лечебните заведения (заплати на младите лекари и сестрите) — отхвърлени проекти</a><p class=\"text-sm text-muted\">Отхвърлен на първо четене на 07.10.2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Проектът на „Възраждане“ предлагаше основната заплата на лекарите без специалност да е поне 150% от средната брутна заплата в страната, а на медицинските сестри, акушерките и помощник-фармацевтите — 140%, с контрол от Главната инспекция по труда. Проектът на ПП също се отнасяше до възнагражденията в болниците.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/chastnata-ohranitelna-deynost#mnenie\">Закон за частната охранителна дейност</a><p class=\"text-sm text-muted\">Приет окончателно на 07.10.2026 г., обнародван в ДВ, бр. 96/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законът изравнява таксите за лицензи на български охранителни фирми и фирми от ЕС, обединява „охрана на недвижими имоти“ и „охрана на селскостопанско имущество“ в общата „охрана на имущество“, позволява фирма да възлага лична охрана на свой служител при реална заплаха, актуализира сумите при превоз на ценни пратки и отменя изискването трудовият договор на охранителя да е основен (за охрана на заведения, сезонни обекти и събития). Изискванията за охранителите се разширяват и към управителите на фирмите.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/zashtita-ot-vrednoto-vazdeystvie-na-himichnite-veshtestva-i-smesi#mnenie\">Закон за защита от вредното въздействие на химичните вещества и смеси</a><p class=\"text-sm text-muted\">Приети на първо четене на 01.10.2026 г. два правителствени законопроекта</p><p class=\"text-[15px] mt-1 line-clamp-3\">Два правителствени законопроекта по правилата на ЕС за химикалите (REACH, CLP, биоциди) и за прекурсорите на взривни вещества. Първият определя Националния център по обществено здраве и анализи за орган, който получава от вносителите и дистрибуторите информация за опасните смеси (за спешна медицинска помощ при отравяне), и въвежда санкции. Вторият забранява продажбата на прекурсори на взривни вещества на масовия потребител, задължава търговците (вкл. онлайн платформите) да докладват подозрителни сделки, липси и кражби на национално звено за контакт и въвежда глоби и съвместни проверки с МВР.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/avtomobilnite-prevozi#mnenie\">Закон за автомобилните превози (пакет „Мобилност I“)</a><p class=\"text-sm text-muted\">Приет на първо четене на 01.10.2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законопроектът въвежда европейския пакет „Мобилност I“: правила за времето на управление и почивките на шофьорите, тахографи с местоположение, командироване на шофьорите в чужбина (нов раздел по Кодекса на труда) и използване на наети в друга държава от ЕС камиони без шофьор. Срещу България има две процедури за нарушение, по едната вече има дело.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/elektronnata-identifikatsiya#mnenie\">Закон за електронната идентификация (безплатна е-идентичност)</a><p class=\"text-sm text-muted\">Приет окончателно на 01.10.2026 г., обнародван в ДВ, бр. 95/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Отпадат таксите за издаване на удостоверение за електронна идентичност и за проверката ѝ, когато услугата е от държавни органи или организации с обществени услуги. Удостоверенията за електронно овластяване стават само електронни и безплатни. Частните центрове за идентификация могат да продължат да вземат такса.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/targovskiya-registar-i-registara-na-yuridicheskite-litsa-s-nestopanska-tsel#mnenie\">Закон за търговския регистър (забавените вписвания и годишните отчети)</a><p class=\"text-sm text-muted\">Приет окончателно на 01.10.2026 г., обнародван в ДВ, бр. 92/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законът цели да намали забавянето на вписванията в Търговския регистър: заявленията за годишните финансови отчети и декларациите на фирми без дейност се обработват в отделен поток, за да не спират останалите вписвания, а част от декларациите отпадат, защото информацията може да се провери служебно.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/grazhdanski-protsesualen-kodeks#mnenie\">Граждански процесуален кодекс (защита срещу „SLAPP“ дела)</a><p class=\"text-sm text-muted\">Приет окончателно на 30.09.2026 г., обнародван в ДВ, бр. 92/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законът въвежда европейската директива срещу т.нар. SLAPP дела: явно неоснователни искове срещу журналисти, природозащитници, граждански организации и хора, които се изказват по въпрос от обществен интерес, с цел да бъдат сплашени и изтощени финансово. Съдът може да отхвърли такъв иск рано; обезпечение на иска се допуска само при убедителни писмени доказателства; ответникът може да поиска гаранция за разноските си и има право на безплатна адвокатска помощ; организации могат да представят доказателства в негова подкрепа. Окончателните решения се публикуват, а данните за ищеца се пазят 10 години. Правилата важат и за вътрешни, не само за трансгранични дела.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/kodeks-na-truda#mnenie\">Кодекс на труда (механизъм за минималната заплата)</a><p class=\"text-sm text-muted\">Приет окончателно през септември 2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Промените, внесени от Министерския съвет, сменят начина, по който се определя минималната работна заплата. Вместо фиксиран процент от средната заплата се вземат предвид четири критерия: покупателната способност спрямо издръжката на живота, нивото и разпределението на заплатите, ръстът на заплатите и дългосрочната производителност на труда. Точната формула се определя с наредба на Министерския съвет. Минималната заплата за следващата година трябва да е определена до 15 август, а адекватността ѝ се преглежда на три години.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/nakazatelen-kodeks#mnenie\">Наказателен кодекс (престъпления срещу ограничителните мерки на ЕС)</a><p class=\"text-sm text-muted\">Приет на първо четене на 24.09.2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Създава се нова глава „Престъпления против ограничителните мерки на Европейския съюз“: нарушаването и заобикалянето на санкциите на ЕС (вкл. замразяване на средства и икономически ресурси) става престъпление с лишаване от свобода, големи глоби и лишаване от права. Въвежда директива 2024/1226; срокът ѝ изтече на 20.05.2025 г. и срещу България има процедура за нарушение.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/sobstvenostta-i-polzvaneto-na-zemedelskite-zemi#mnenie\">Закон за собствеността и ползването на земеделските земи (търгове за държавната земя)</a><p class=\"text-sm text-muted\">Приет на първо четене на 24.09.2026 г.; срокът за предложения е удължен на 14 дни</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законопроектът променя правилата за държавния поземлен фонд: отпада ограничението търговете за наем и аренда да са само на две сесии; при изчисляване на максималната обработвана площ се броят всички земи; договорите над една година се вписват; областната дирекция „Земеделие“ може да ги прекратява едностранно при неизпълнение. Земи с напояване и разрешително за водовземане могат да се отдават без търг, по пазарна цена от независим оценител, до 10 години. Ограничените вещни права върху държавни земи се оценяват от независим оценител, като се плаща по-високата от двете цени. Земите на бившите стопански дворове не могат да се придобиват по давност.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/predostavyane-na-tsifrovo-sadarzhanie-i-tsifrovi-uslugi-i-za-prodazhba-na-stoki#mnenie\">Закон за предоставяне на цифрово съдържание и цифрови услуги и за продажба на стоки („право на ремонт“)</a><p class=\"text-sm text-muted\">Приет на първо четене на 24.09.2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законът въвежда европейската директива за правото на ремонт (2024/1799). Ако потребителят избере ремонт вместо замяна на дефектна стока в гаранция, законовата гаранция се удължава с една година (за стоки, купени след 31.07.2026 г.). Производителите на стоки с изисквания за ремонтопригодност трябва да предлагат ремонт и след изтичане на гаранцията, пряко или чрез подизпълнител. ЕК създава европейска онлайн платформа за ремонт.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/potrebitelskiya-kredit#mnenie\">Закон за потребителския кредит</a><p class=\"text-sm text-muted\">Нов закон, приет на първо четене на 23 септември 2026 г. Предстои второ четене.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Нов закон за кредитите за потребители, който заменя закона от 2010 г. и въвежда европейската директива за потребителския кредит (CCD II). Обхваща заеми до 100 000 € (досега до 75 000 €), включително „купи сега, плати после“, безлихвени и краткосрочни кредити. Сменя начина, по който се ограничава цената на малките бързи кредити.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/podpomagane-na-zemedelskite-proizvoditeli#mnenie\">Закон за подпомагане на земеделските производители (Взаимоспомагателен фонд, Copa-Cogeca, оранжерии)</a><p class=\"text-sm text-muted\">Приет окончателно на 17.09.2026 г., обнародван в ДВ, бр. 88/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Държавен фонд „Земеделие“ може да изплаща обезщетения от Взаимоспомагателен фонд при неблагоприятни климатични явления и болести по растенията и животните; средствата идват от публично финансиране и от непотърсени от правоимащите суми по Закона за земеделските земи след 10 години. Фондът ще работи и по Социалния фонд за климата. Министерството на земеделието създава база данни за оранжериите и трайните насаждения. Проектът на „Прогресивна България“ дава възможност министерството да плаща вноската в европейската земеделска организация Copa-Cogeca на обединения на земеделски производители в обществена полза.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/ravnopostavenost-na-zhenite-i-mazhete#mnenie\">Закон за равнопоставеност на жените и мъжете (жени в бордовете на публичните дружества)</a><p class=\"text-sm text-muted\">Приет окончателно на 17.09.2026 г., обнародван в ДВ, бр. 88/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законът въвежда европейската директива 2022/2381 (срокът изтече на 28.12.2024 г.): публичните дружества на борсата трябва да имат поне 33% от по-слабо представения пол сред всички директорски позиции в управителните и надзорните органи. Първото отчитане е до 30.06.2027 г. за 2026 г., чрез декларациите за корпоративно управление; има санкции при неизпълнение. Комисията за защита от дискриминация получава допълнителни правомощия по наблюдението.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/zashtita-na-potrebitelite#mnenie\">Закон за защита на потребителите</a><p class=\"text-sm text-muted\">Промени срещу неоправданото поскъпване: в сила от 9 август 2026 г. до 9 август 2027 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Основните промени, внесени от Явор Гечев („Прогресивна България“), забраняват повишаване на цените, когато то не е икономически обосновано. Законът изрежда кои фактори могат да оправдаят поскъпване: по-високи разходи за доставка и производство, труд, енергия. Големите търговци с оборот над 5,1 млн. € трябва всеки ден да публикуват цените си в машинночетим вид за храни, напитки, тютюн, нехранителни стоки и лекарства. Част от правилата от Закона за въвеждане на еврото се пренасят тук и се удължават с една година. Отделно през юли беше приет на първо четене и друг законопроект на Министерския съвет за безопасността на продуктите.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/danachno-osiguritelen-protsesualen-kodeks#mnenie\">Данъчно-осигурителен процесуален кодекс (обмен на данъчна информация в ЕС)</a><p class=\"text-sm text-muted\">Приет окончателно на 09.09.2026 г., обнародван в ДВ, бр. 85/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законът въвежда европейските правила за административно сътрудничество и обмен на данъчна информация между държавите членки, за да се ограничи избягването на данъци. Не предвижда нови разходи, структури или режими.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/vissheto-obrazovanie#mnenie\">Закон за висшето образование (такси за платено обучение и стипендии)</a><p class=\"text-sm text-muted\">Приет окончателно на 03.09.2026 г., обнародван в ДВ, бр. 85/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Минималната такса за студентите в платено обучение пада от 60 на 50% от издръжката на обучение в направлението (плюс таксата за държавна поръчка), а за целия срок на обучение таксата на един студент не може да се увеличи с повече от 20% спрямо първата година. Академичните съвети сами определят таксите за кандидатстване, без утвърждаване от Министерския съвет. Стипендии от бюджета ще получават студентите в редовна форма на субсидирани от държавата места. Образованието от официални регистри се проверява служебно.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/vavezhdane-na-evroto-v-republika-balgariya#mnenie\">Закон за въвеждане на еврото (срокът за превалутиране на капитала на фирмите)</a><p class=\"text-sm text-muted\">Приет на първо и второ четене в един ден — 02.09.2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Фирмите трябваше до 12 месеца след въвеждането на еврото да превалутират капитала си и да обновят учредителните си документи в Търговския регистър. Срокът се удължава на 36 месеца, а задължението за подаване на обновен устав се облекчава. Проектът на ДБ предлагаше срокът да отпадне изобщо и документите да се обновяват при следваща промяна във фирмата.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/darzhavniya-sluzhitel#mnenie\">Закон за държавния служител (проверки за почтеност)</a><p class=\"text-sm text-muted\">Приет окончателно на 25.08.2026 г., обнародван в ДВ, бр. 78/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законът въвежда проверки на почтеността на служителите на длъжности с висок корупционен риск в централната власт: преди назначаване, при повишение на по-висока ръководна длъжност и след проверка на инспекторат. Правилата за тестовете за почтеност ще се определят с наредба на Министерския съвет. Инспекторатите получават по-голяма независимост от ръководителите на ведомствата, подобрява се стипендиантската програма и се разрешава работа от разстояние. Законът изпълнява етап от антикорупционната реформа в Плана за възстановяване и препоръки на ОИСР.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/deynostta-na-kolektivnite-investitsionni-shemi-i-na-drugi-predpriyatiya-za-kolektivno-investirane#mnenie\">Закон за дейността на колективните инвестиционни схеми (фондове)</a><p class=\"text-sm text-muted\">Приет окончателно на 30.07.2026 г., обнародван в ДВ, бр. 71/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законът въвежда няколко европейски директиви и регламента за инвестиционните фондове и капиталовите пазари: правила за делегиране на управлението, управление на ликвидния риск, надзорна отчетност, депозитарни услуги и заеми от алтернативни инвестиционни фондове. Комисията за финансов надзор може да задължи фонд да спре обратното изкупуване на дялове при извънредни обстоятелства, когато има риск за инвеститорите или финансовата стабилност. Част от мерките са за по-лесен достъп на малки и средни фирми до борсата.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/izboren-kodeks#mnenie\">Изборен кодекс (машинно гласуване и секции в чужбина, юли 2026)</a><p class=\"text-sm text-muted\">Приет окончателно на 30.07.2026 г., обнародван в ДВ, бр. 71/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Промените са приети няколко месеца преди президентските избори. Основната тема е начинът на гласуване: проектите на управляващите и на ПП–ДБ връщат машинното гласуване като основен начин, с контролно преброяване на разписките от машините, а проектът на „Прогресивна България“ оставя хартиени бюлетини само по изключение (напр. в секции под 300 избиратели). Втората тема са секциите в чужбина: няколко проекта предлагаха да отпадне ограничението до 20 секции извън посолствата в държави извън ЕС. Обсъждани бяха и правилата за ЦИК (решения с мнозинство над половината от членовете), ограничения за членове на секционните комисии и скенери за личните карти в секциите.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/darzhavniya-byudzhet-na-republika-balgariya-za-2026-g#mnenie\">Закон за държавния бюджет на Република България за 2026 г.</a><p class=\"text-sm text-muted\">Приет окончателно на 24.07.2026 г., след седем месеца на удължителен закон</p><p class=\"text-[15px] mt-1 line-clamp-3\">Бюджетът определя колко пари събира и харчи държавата през 2026 г. Планирани са приходи по консолидираната програма около 49,6 млрд. € и разходи около 56,8 млрд. €. Така дефицитът е 7,2 млрд. € или 5,7% от БВП, най-високият от 20 години. Позволен е нов дълг до 10,1 млрд. €, от които до 3,26 млрд. € е заем по европейския инструмент SAFE за отбрана. Максималният осигурителен доход става 2 300 € от 1 август.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/byudzheta-na-natsionalnata-zdravnoosiguritelna-kasa-za-2026-g#mnenie\">Закон за бюджета на Националната здравноосигурителна каса за 2026 г.</a><p class=\"text-sm text-muted\">Приет окончателно на 22 юли 2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Бюджетът на Здравната каса: над 5,256 млрд. € за болници, лекари, лекарства, медицински изделия, изследвания и дентална помощ. Бюджетът е балансиран, тоест без дефицит.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/byudzheta-na-darzhavnoto-obshtestveno-osiguryavane-za-2026-g#mnenie\">Закон за бюджета на държавното обществено осигуряване за 2026 г.</a><p class=\"text-sm text-muted\">Приет окончателно на 22 юли 2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Това е бюджетът на НОИ: пенсии, обезщетения за майчинство, болнични и безработица. От 1 юли 2026 г. всички пенсии се увеличават със 7,8% по „швейцарското правило“. От 1 август държавните служители и заетите в съдебната власт започват поетапно да плащат сами своите осигуровки (досега ги плащаше работодателят).</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/kreditnite-institutsii#mnenie\">Закон за кредитните институции</a><p class=\"text-sm text-muted\">Приет окончателно на 09.07.2026 г., обнародван в ДВ, бр. 67/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Правителствен законопроект, който привежда банковото законодателство в съответствие с правилата на ЕС (основно Директива (ЕС) 2024/1619 и 2024/2994). Според мотивите той: допълва основанията за отнемане на банков лиценз (вкл. по искане на самата банка); изброява какво БНБ трябва да вземе предвид при определяне на глобите (тежест, продължителност, финансово състояние на нарушителя); разпределя по-ясно надзора между ЕЦБ и БНБ; урежда реда за решения по вътрешните експозиции (заеми към свързани лица); въвежда надзор върху клонове на банки от трети държави и рисковете от екологичен, социален и управленски характер; превалутира глобите и таксите в евро. В преходните разпоредби променя и Закона за пазарите на финансови инструменти, Кодекса за застраховането и Закона за лицата, обслужващи кредити.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/ministerstvoto-na-vatreshnite-raboti#mnenie\">Закон за МВР (терористично съдържание онлайн и европейски бази данни)</a><p class=\"text-sm text-muted\">Приет окончателно на 08.07.2026 г., обнародван в ДВ, бр. 66/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законът определя орган, който може да нарежда на доставчици на хостинг услуги да премахнат или блокират терористично съдържание онлайн, да следи мерките им и да ги санкционира, по европейския регламент 2021/784. Урежда и оперативната съвместимост на европейските системи за граници, визи, полицейско сътрудничество и миграция, както и националното звено за контакт.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/kodeks-za-sotsialno-osiguryavane#mnenie\">Кодекс за социално осигуряване (държавните служители да плащат осигуровки) — отхвърлени проекти</a><p class=\"text-sm text-muted\">Отхвърлен на първо четене на 01.07.2026 г.</p><p class=\"text-[15px] mt-1 line-clamp-3\">Проектът предлагаше за шест години държавните служители и служителите в съдебната власт постепенно да започнат да плащат лична част от осигурителните си вноски, както служителите по трудов договор. Сега осигуровките им се плащат изцяло от бюджета. Вносителите предлагат обичайното индексиране на заплатите да покрие прехода.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/darzhavniya-dalg#mnenie\">Закон за държавния дълг (облигации за граждани и правила на еврозоната)</a><p class=\"text-sm text-muted\">Приет окончателно на 01.07.2026 г., обнародван в ДВ, бр. 62/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законът привежда правилата за държавния дълг в съответствие с еврозоната: всички нови държавни ценни книжа над една година имат клаузи за колективно действие (общ механизъм при евентуално преструктуриране на дълга); законово се уреждат критериите за първичните дилъри. Създава се основа за отделни спестовни емисии държавни облигации само за граждани, с по-нисък праг за участие и специализирана система на Министерството на финансите за продажбата им.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/sadebnata-vlast#mnenie\">Закон за съдебната власт</a><p class=\"text-sm text-muted\">Приет окончателно на 25 юни 2026 г., обнародван в ДВ бр. 60 от 1 юли 2026 г., в сила от същия ден</p><p class=\"text-[15px] mt-1 line-clamp-3\">Промените засягат Висшия съдебен съвет (ВСС): кой и как може да избира ръководителите в съдебната власт, включително главния прокурор, и как се избира нов състав на ВСС. Внесени бяха три отделни законопроекта: от Олга Борисова („Прогресивна България“), от Надежда Йорданова (ДБ) и от Велислав Величков (ПП). След промените ВСС трябваше да организира избор на членове от квотата на съдии, прокурори и следователи до 17 октомври 2026 г.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/byudzheta-na-darzhavnoto-obshtestveno-osiguryavane-za-2026-g-i-zakona-za-byudzheta-na-natsionalnata-zdravnoosiguritelna-kasa-za-2026-g#mnenie\">Удължителният закон за бюджета 2026 (нов дълг до приемането на бюджета)</a><p class=\"text-sm text-muted\">Две промени, приети през май–юни 2026 г.; втората обнародвана в ДВ, бр. 57/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Докато няма приет бюджет за 2026 г., държавата работи по „удължителен закон“. С промените правителството получава право да поеме нов държавен дълг (с таван 3,8 млрд. €), за да покрие текущия дефицит и да префинансира плащанията по Плана за възстановяване — около 4,4 млрд. € трябваше да се изплатят до 31.08.2026 г. Разрешава се и краткосрочен дълг в рамките на годината, а лимитът на програмата за облигации на международните пазари се вдига от 27 на 30,8 млрд. €.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/nakazatelno-protsesualen-kodeks#mnenie\">Наказателно-процесуален кодекс (контрол над разследването на главния прокурор, права на задържаните)</a><p class=\"text-sm text-muted\">Приет окончателно на 17–18.06.2026 г., обнародван в ДВ, бр. 59/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законът въвежда задължителен съдебен контрол, когато прокуратурата прекратява или спира дела за корупция на хора на висши публични длъжности и дела срещу главния прокурор. Ad hoc прокурорът, който разследва главния прокурор или заместниците му, се контролира от съдия от наказателната колегия на ВКС, избран на случаен принцип. Задържаните и обвиняемите трябва да бъдат уведомявани за правата си (адвокат, правна помощ, превод, право на мълчание), а при задочните дела се спазват решенията на Съда на ЕС. Държавата отговаря за вреди, когато длъжностно лице публично наруши презумпцията за невиновност. Проектът на ДБ въвежда право на незабавна жалба пред съд срещу 72-часовото прокурорско задържане.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/zashtita-na-konkurentsiyata#mnenie\">Закон за защита на конкуренцията (нелоялни търговски практики и „прекомерно високи цени“)</a><p class=\"text-sm text-muted\">Приет окончателно на 11.06.2026 г., обнародван в ДВ, бр. 58/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законът разширява списъка на нелоялните търговски практики по веригата на храните: едностранно налагане на цени и такси, такси за „предлагане“ на продукт, последващи и ретроактивни бонуси, прехвърляне на търговския риск върху доставчика, скрити плащания при формиране на цената, изваждане от асортимента или замяна със собствена марка на търговеца. Такива практики са допустими само ако са договорени писмено предварително и срещу реална услуга. При обосновано съмнение Комисията за защита на конкуренцията може да задължи купувача да докаже, че практиката му не е нелоялна. Въвежда се електронен регистър за проследимост по веригата на доставки и възможност КЗК да санкционира „прекомерно високи цени“ при господстващо положение, както и временни мерки.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/nasarchavane-na-investitsiite#mnenie\">Закон за насърчаване на инвестициите (ново министерство и Координационен съвет по инвестициите)</a><p class=\"text-sm text-muted\">Приет окончателно на 04.06.2026 г., обнародван в ДВ, бр. 55/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Законът следва новата структура на правителството: създава Министерството на икономиката, инвестициите и индустрията (от Министерството на икономиката и част от Министерството на иновациите и растежа) и разпределя правомощията между него и Министерството на иновациите и дигиталната трансформация. Създава се Координационен съвет по инвестициите към Министерския съвет. Подзаконовите актове трябва да се обновят до 6 месеца.</p></li><li class=\"py-3\"><a class=\"font-semibold text-ink\" href=\"/parlament/zakon/darzhavnata-finansova-inspektsiya#mnenie\">Закон за държавната финансова инспекция (глобите в евро)</a><p class=\"text-sm text-muted\">Приет на първо и второ четене в един ден — 21.05.2026 г., обнародван в ДВ, бр. 50/2026</p><p class=\"text-[15px] mt-1 line-clamp-3\">Технически закон след въвеждането на еврото: глобите и имуществените санкции, които налага Агенцията за държавна финансова инспекция (АДФИ) за нарушения на бюджетната и финансовата дисциплина, и сумите при пълна имуществена отговорност се определят в евро.</p></li></ul></section></div><!--$--><!--/$--></main><!--$--><!--/$--><footer class=\"bg-surface border-t border-rule mt-20\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 text-sm text-muted grid gap-2 sm:grid-cols-2\"><p>Не подкрепяме партия, кандидат или правителство. Всяко число има източник и дата.<!-- --> <a href=\"/metodologiya\">Как работим</a> · <a href=\"/rechnik\">Речник</a> · <a href=\"/sastoyanie\">Състояние на данните</a> · <!--$?--><template id=\"B:1\"></template><a href=\"/metodologiya#greshki\">Съобщи за грешка</a><!--/$--></p><p class=\"sm:text-right\">Вътрешен прототип · данните са към датите, посочени до тях</p></div></footer><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script id=\"_R_\">(globalThis[\"TURBOPACK\"] || (globalThis[\"TURBOPACK\"] = [])).push({\"otherChunks\":[\"static/chunks/310vm2bl3xxpt.js\",\"static/chunks/2vy51v46dlsq-.js\",\"static/chunks/2bx7ggprk0oi5.js\",\"static/chunks/0c1ad7rcpjghx.js\"],\"runtimeModuleIds\":[94553]});</script><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" async=\"\"></script><div hidden id=\"S:0\"><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header></div><script>$RB=[];$RV=function(a){$RT=performance.now();for(var b=0;b<a.length;b+=2){var c=a[b],e=a[b+1];null!==e.parentNode&&e.parentNode.removeChild(e);var f=c.parentNode;if(f){var g=c.previousSibling,h=0;do{if(c&&8===c.nodeType){var d=c.data;if(\"/$\"===d||\"/&\"===d)if(0===h)break;else h--;else\"$\"!==d&&\"$?\"!==d&&\"$~\"!==d&&\"$!\"!==d&&\"&\"!==d||h++}d=c.nextSibling;f.removeChild(c);c=d}while(c);for(;e.firstChild;)f.insertBefore(e.firstChild,c);g.data=\"$\";g._reactRetry&&requestAnimationFrame(g._reactRetry)}}a.length=0};\n$RC=function(a,b){if(b=document.getElementB