{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/proverki/layout,_N_T_/proverki/sankcii/layout,_N_T_/proverki/sankcii/page,_N_T_/proverki/sankcii"},"segmentPaths":["/_tree","/_full","/proverki/sankcii/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/37b531609b6adf7f9bbf0d8c0747d9d641f2f9e7045eefbaeb2730d995e05204/$/proverki/sankcii","owner":{"kind":"APP_PAGE","sourceRoute":"/proverki/sankcii/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0vn96-fhbu77m.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><title>Корупция: санкции, обвинения, присъди · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Корупция: санкции, обвинения, присъди · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Корупция: санкции, обвинения, присъди · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/proverki\">← <!-- -->Проверки</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Корупция: само официални източници</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Корупция: санкции, обвинения, присъди</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Българи, санкционирани от САЩ и Великобритания за значима корупция. Само мерки, обявени официално от Министерството на финансите и Държавния департамент на САЩ и от британското правителство.</div></div></div><nav class=\"flex flex-wrap gap-2 mb-8 text-[15px]\"><a href=\"#sankcii\" class=\"px-3 py-1.5 rounded-full bg-surface no-underline text-ink\">Санкции (<!-- -->11<!-- -->)</a><a href=\"#dela\" class=\"px-3 py-1.5 rounded-full bg-surface no-underline text-ink\">Обвинения и присъди (<!-- -->40<!-- -->)</a></nav><section class=\"bg-surface rounded-sm p-5 mb-10 max-w-4xl text-[15px] space-y-2\"><p><b>Какво е и какво не е това.</b> <!-- -->Санкцията е мярка на чужда държава (замразяване на активи и забрана за влизане). Тя не е присъда от български съд. Санкционираните отричат обвиненията.</p><p>Различаваме пет нива и не ги смесваме: <b>сигнал</b> (някой е подал жалба), <b>разследване</b> (прокуратурата проверява), <b>обвинение</b> (повдигнато официално), <b>присъда</b> (влязла в сила) и <b>санкция</b> (мярка на друга държава). Тук са само санкциите. Обвиненията и присъдите добавяме отделно, само по документи на прокуратурата и съдилищата.</p></section><section class=\"grid gap-4 sm:grid-cols-3 mb-10\"><div class=\"bg-surface rounded-sm p-4\"><p class=\"text-sm text-muted\">Санкционирани българи</p><p class=\"display num text-[1.75rem] sm:text-[2.4rem] leading-none mt-1 break-words\">11</p><p class=\"text-xs text-muted\">10 с мерки в сила</p></div><div class=\"bg-surface rounded-sm p-4\"><p class=\"text-sm text-muted\">„Магнитски“ (САЩ)</p><p class=\"display num text-[1.75rem] sm:text-[2.4rem] leading-none mt-1 break-words\">8</p><p class=\"text-xs text-muted\">замразени активи в САЩ</p></div><div class=\"bg-surface rounded-sm p-4\"><p class=\"text-sm text-muted\">Великобритания</p><p class=\"display num text-[1.75rem] sm:text-[2.4rem] leading-none mt-1 break-words\">3</p><p class=\"text-xs text-muted\">активи и забрана за влизане</p></div></section><section class=\"mb-10 max-w-3xl\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">По партийна принадлежност</h2></div><p class=\"text-[15px] text-muted -mt-3 mb-3\">Принадлежността е към момента на санкцията или сегашната, ако е известна. Броят сам по себе си не показва коя партия е „по-корумпирана“: санкциите засягат малко хора и зависят от приоритетите на чуждите правителства.</p><p class=\"font-semibold mt-2\">Санкции</p><ul class=\"text-[15px] space-y-1\"><li class=\"flex justify-between border-b border-rule py-1\"><span>Без партия (служители, бизнес)</span><b class=\"num\">4</b></li><li class=\"flex justify-between border-b border-rule py-1\"><span>БСП</span><b class=\"num\">2</b></li><li class=\"flex justify-between border-b border-rule py-1\"><span>ДПС</span><b class=\"num\">1</b></li><li class=\"flex justify-between border-b border-rule py-1\"><span>Българско лято</span><b class=\"num\">1</b></li><li class=\"flex justify-between border-b border-rule py-1\"><span>ГЕРБ-СДС</span><b class=\"num\">1</b></li><li class=\"flex justify-between border-b border-rule py-1\"><span>Русофили (бивш депутат от БСП)</span><b class=\"num\">1</b></li></ul><div class=\"mt-6 overflow-x-auto\"><p class=\"font-semibold\">Обвинения и присъди</p><table class=\"w-full text-[15px] num mt-1\"><thead><tr class=\"text-left text-sm text-muted border-b border-rule\"><th class=\"py-1 pr-3 font-normal\">Партия</th><th class=\"py-1 pr-3 font-normal\">Влязла в сила присъда</th><th class=\"py-1 pr-3 font-normal\">Осъден, присъдата не е окончателна</th><th class=\"py-1 pr-3 font-normal\">Подсъдим</th><th class=\"py-1 pr-3 font-normal\">Обвинен</th><th class=\"py-1 pr-3 font-normal\">Разследването е прекратено</th><th class=\"py-1 pr-3 font-normal\">Окончателно оправдан</th></tr></thead><tbody><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">без партия / неизвестна</td><td class=\"py-1 pr-3\">5</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">2</td><td class=\"py-1 pr-3\">3</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">6</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">ГЕРБ-СДС</td><td class=\"py-1 pr-3\">2</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">3</td><td class=\"py-1 pr-3\">1</td><td class=\"py-1 pr-3\">2</td><td class=\"py-1 pr-3\">1</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">ПП–ДБ</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">1</td><td class=\"py-1 pr-3\">3</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">ДПС</td><td class=\"py-1 pr-3\">1</td><td class=\"py-1 pr-3\">1</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">1</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">ГЕРБ</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">1</td><td class=\"py-1 pr-3\">2</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">Българско лято</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">1</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">Реформаторски блок</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">1</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">Обединени патриоти</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">1</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">БСП</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">1</td></tr><tr class=\"border-b border-rule\"><td class=\"py-1 pr-3\">Воля</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">—</td><td class=\"py-1 pr-3\">1</td></tr></tbody></table><p class=\"text-sm text-muted mt-2\">Включваме само случаи с обвинение или съдебен акт и официален източник, по едни и същи правила за всички партии. Сравнително малкият брой случаи не позволява изводи коя партия е „по-корумпирана“.</p></div></section><section id=\"sankcii\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Санкционираните</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"font-semibold text-lg\"><a href=\"/parlament/deputat/5100\">Делян Славчев Пеевски</a></p><p class=\"text-sm text-muted\">Лидер на „ДПС–Ново начало“, народен представител</p><ul class=\"flex flex-wrap gap-2 my-3\"><li><a href=\"https://home.treasury.gov/news/press-releases/jy0208\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">„Магнитски“ (САЩ)<!-- --> · <!-- -->2 юни 2021 г.</a></li><li><a href=\"https://home.treasury.gov/news/press-releases/jy0208\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">Забрана за влизане в САЩ<!-- --> · <!-- -->2 юни 2021 г.</a></li><li><a href=\"https://home.treasury.gov/news/press-releases/jy1264\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">Санкции на Великобритания<!-- --> · <!-- -->10 февруари 2023 г.</a></li></ul><p class=\"text-[15px]\">Според Министерството на финансите на САЩ е използвал влияние и подкупи, за да контролира институции и ключови сектори, включително чрез посредника си Илко Желязков.</p><p class=\"text-sm mt-2 bg-surface rounded-sm px-3 py-2\"><b>В България:</b> <!-- -->Пет години след санкциите българската прокуратура не е открила основания за наказателно преследване (Club Z, 2026).<!-- --> <a href=\"https://clubz.bg/177320\" target=\"_blank\" rel=\"noreferrer\">Източник</a></p><p class=\"text-xs text-muted mt-2\">Статус: <!-- -->„Магнитски“ (САЩ): в сила; Забрана за влизане в САЩ: в сила; Санкции на Великобритания: в сила</p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"font-semibold text-lg\">Илко Димитров Желязков</p><p class=\"text-sm text-muted\">Бивш заместник-председател на Държавната агенция „Технически операции“, член на Националното бюро за контрол на СРС</p><ul class=\"flex flex-wrap gap-2 my-3\"><li><a href=\"https://home.treasury.gov/news/press-releases/jy0208\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">„Магнитски“ (САЩ)<!-- --> · <!-- -->2 юни 2021 г.</a></li><li><a href=\"https://home.treasury.gov/news/press-releases/jy0208\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">Забрана за влизане в САЩ<!-- --> · <!-- -->2 юни 2021 г.</a></li><li><a href=\"https://home.treasury.gov/news/press-releases/jy1264\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">Санкции на Великобритания<!-- --> · <!-- -->10 февруари 2023 г.</a></li></ul><p class=\"text-[15px]\">Според САЩ е бил посредник на Пеевски: предлагал е подкупи на висши служители срещу информация и назначения.</p><p class=\"text-xs text-muted mt-2\">Статус: <!-- -->„Магнитски“ (САЩ): в сила; Забрана за влизане в САЩ: в сила; Санкции на Великобритания: в сила</p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"font-semibold text-lg\">Васил Крумов Божков</p><p class=\"text-sm text-muted\">Бизнесмен (хазарт), основател на партия „Българско лято“</p><ul class=\"flex flex-wrap gap-2 my-3\"><li><a href=\"https://home.treasury.gov/news/press-releases/jy0208\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">„Магнитски“ (САЩ)<!-- --> · <!-- -->2 юни 2021 г.</a></li><li><a href=\"https://home.treasury.gov/news/press-releases/jy1264\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">Санкции на Великобритания<!-- --> · <!-- -->10 февруари 2023 г.</a></li></ul><p class=\"text-[15px]\">Според САЩ многократно е подкупвал държавни служители, включително председателя на Държавната комисия по хазарта, за да бъдат отнети лицензите на конкурентите му.</p><p class=\"text-xs text-muted mt-2\">Статус: <!-- -->„Магнитски“ (САЩ): в сила; Санкции на Великобритания: в сила</p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"font-semibold text-lg\"><a href=\"/parlament/deputat/5063\">Владислав Иванов Горанов</a></p><p class=\"text-sm text-muted\">Бивш министър на финансите, народен представител от ГЕРБ</p><ul class=\"flex flex-wrap gap-2 my-3\"><li><a href=\"https://home.treasury.gov/news/press-releases/jy1264\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">„Магнитски“ (САЩ)<!-- --> · <!-- -->10 февруари 2023 г.</a></li><li><a href=\"https://www.state.gov/reports/report-to-congress-on-anti-kleptocracy-and-human-rights-visa-restrictions-public-listing/public-listing-fiscal-year-2023\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">Забрана за влизане в САЩ<!-- --> · <!-- -->10 февруари 2023 г.</a></li></ul><p class=\"text-[15px]\">Според САЩ е използвал поста си, за да улесни подкупи срещу изгодно законодателство, което е лишило държавата от данъчни приходи. ГЕРБ се дистанцира официално, а Бойко Борисов заяви, че е сигурен в невинността му.</p><p class=\"text-xs text-muted mt-2\">Статус: <!-- -->„Магнитски“ (САЩ): в сила; Забрана за влизане в САЩ: в сила</p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"font-semibold text-lg\">Румен Стоянов Овчаров</p><p class=\"text-sm text-muted\">Бивш министър на икономиката и енергетиката, член на Националния съвет на БСП</p><ul class=\"flex flex-wrap gap-2 my-3\"><li><a href=\"https://home.treasury.gov/news/press-releases/jy1264\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">„Магнитски“ (САЩ)<!-- --> · <!-- -->10 февруари 2023 г.</a></li><li><a href=\"https://www.state.gov/reports/report-to-congress-on-anti-kleptocracy-and-human-rights-visa-restrictions-public-listing/public-listing-fiscal-year-2023\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">Забрана за влизане в САЩ<!-- --> · <!-- -->10 февруари 2023 г.</a></li></ul><p class=\"text-[15px]\">Според САЩ заедно с Николов и Генов е отклонявал договори за услуги на АЕЦ „Козлодуй“ към свои бизнес интереси срещу комисиони.</p><p class=\"text-xs text-muted mt-2\">Статус: <!-- -->„Магнитски“ (САЩ): в сила; Забрана за влизане в САЩ: в сила</p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"font-semibold text-lg\">Александър Христов Николов</p><p class=\"text-sm text-muted\">Бивш изпълнителен директор на АЕЦ „Козлодуй“</p><ul class=\"flex flex-wrap gap-2 my-3\"><li><a href=\"https://home.treasury.gov/news/press-releases/jy1264\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">„Магнитски“ (САЩ)<!-- --> · <!-- -->10 февруари 2023 г.</a></li><li><a href=\"https://www.state.gov/reports/report-to-congress-on-anti-kleptocracy-and-human-rights-visa-restrictions-public-listing/public-listing-fiscal-year-2023\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">Забрана за влизане в САЩ<!-- --> · <!-- -->10 февруари 2023 г.</a></li></ul><p class=\"text-[15px]\">Според САЩ е участвал в схемата с договорите на АЕЦ „Козлодуй“.</p><p class=\"text-xs text-muted mt-2\">Статус: <!-- -->„Магнитски“ (САЩ): в сила; Забрана за влизане в САЩ: в сила</p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"font-semibold text-lg\">Иван Киров Генов</p><p class=\"text-sm text-muted\">Бивш изпълнителен директор на АЕЦ „Козлодуй“, бивш народен представител от БСП</p><ul class=\"flex flex-wrap gap-2 my-3\"><li><a href=\"https://ofac.treasury.gov/recent-actions/20230210\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">„Магнитски“ (САЩ)<!-- --> · <!-- -->10 февруари 2023 г.</a></li></ul><p class=\"text-[15px]\">Според САЩ е участвал в схемата с договорите на АЕЦ „Козлодуй“.</p><p class=\"text-xs text-muted mt-2\">Статус: <!-- -->„Магнитски“ (САЩ): в сила</p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"font-semibold text-lg\">Николай Симеонов Малинов</p><p class=\"text-sm text-muted\">Лидер на движение „Русофили“, бивш народен представител от БСП</p><ul class=\"flex flex-wrap gap-2 my-3\"><li><a href=\"https://home.treasury.gov/news/press-releases/jy1264\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">„Магнитски“ (САЩ)<!-- --> · <!-- -->10 февруари 2023 г.</a></li></ul><p class=\"text-[15px]\">Според САЩ е участвал в корупционни действия в полза на руски интереси.</p><p class=\"text-xs text-muted mt-2\">Статус: <!-- -->„Магнитски“ (САЩ): в сила</p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"font-semibold text-lg\">Александър Манолев</p><p class=\"text-sm text-muted\">Бивш заместник-министър на икономиката</p><ul class=\"flex flex-wrap gap-2 my-3\"><li><a href=\"https://eualive.net/u-s-lifts-sanctions-on-former-bulgarian-deputy-minister/\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-surface text-muted line-through\">Забрана за влизане в САЩ<!-- --> · <!-- -->2 юни 2021 г.</a></li></ul><p class=\"text-[15px]\">Обявен за участие в значима корупция през 2021 г. През 2026 г. Държавният департамент го изважда от списъка.</p><p class=\"text-xs text-muted mt-2\">Статус: <!-- -->Забрана за влизане в САЩ: отменена (2026)</p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"font-semibold text-lg\">Петър Харалампиев</p><p class=\"text-sm text-muted\">Бивш държавен служител</p><ul class=\"flex flex-wrap gap-2 my-3\"><li><a href=\"https://www.neglobal.eu/washington-zeroes-in-on-corrupt-bulgarian-officials/\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">Забрана за влизане в САЩ<!-- --> · <!-- -->2 юни 2021 г.</a></li></ul><p class=\"text-[15px]\">Обявен от Държавния департамент за участие в значима корупция.</p><p class=\"text-xs text-muted mt-2\">Статус: <!-- -->Забрана за влизане в САЩ: няма данни за отмяна</p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"font-semibold text-lg\">Красимир Томов</p><p class=\"text-sm text-muted\">Бивш държавен служител</p><ul class=\"flex flex-wrap gap-2 my-3\"><li><a href=\"https://www.neglobal.eu/washington-zeroes-in-on-corrupt-bulgarian-officials/\" target=\"_blank\" rel=\"noreferrer\" class=\"text-xs font-semibold px-2.5 py-1 rounded-full no-underline bg-red text-white\">Забрана за влизане в САЩ<!-- --> · <!-- -->2 юни 2021 г.</a></li></ul><p class=\"text-[15px]\">Обявен от Държавния департамент за участие в значима корупция.</p><p class=\"text-xs text-muted mt-2\">Статус: <!-- -->Забрана за влизане в САЩ: няма данни за отмяна</p></li></ul></section><section id=\"dela\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Обвинения и присъди в България</h2></div><p class=\"text-[15px] text-muted -mt-3 mb-4 max-w-3xl\">Политици и високопоставени лица с обвинения или присъди, само по съобщения на прокуратурата и съдилищата или медии, които ги цитират. Нивото е най-важното: обвинението не е доказателство за вина.</p><ul class=\"flex flex-wrap gap-3 mb-5 text-sm\"><li class=\"bg-surface rounded-sm px-3 py-2 max-w-xs\"><b>Влязла в сила присъда</b>: <!-- -->Окончателно решение на съда. Само то доказва вина.</li><li class=\"bg-surface rounded-sm px-3 py-2 max-w-xs\"><b>Осъден, присъдата не е окончателна</b>: <!-- -->Има присъда, но е обжалвана. Човекът се смята за невинен до окончателното решение.</li><li class=\"bg-surface rounded-sm px-3 py-2 max-w-xs\"><b>Подсъдим</b>: <!-- -->Прокуратурата е внесла обвинителен акт и делото е в съда.</li><li class=\"bg-surface rounded-sm px-3 py-2 max-w-xs\"><b>Обвинен</b>: <!-- -->Прокуратурата е повдигнала обвинение в досъдебно производство.</li><li class=\"bg-surface rounded-sm px-3 py-2 max-w-xs\"><b>Окончателно оправдан</b>: <!-- -->Съдът е решил окончателно, че не е виновен. Показваме и тези случаи, за да е пълна картината.</li><li class=\"bg-surface rounded-sm px-3 py-2 max-w-xs\"><b>Разследването е прекратено</b>: <!-- -->Прокуратурата е прекратила делото, без да внесе обвинение в съда. Човекът не е обвинен пред съд и не е осъден.</li></ul><ul class=\"grid gap-4 lg:grid-cols-2\"><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-red text-white\">Влязла в сила присъда</span><p class=\"font-semibold text-lg mt-2\">Алтимир Адамов</p><p class=\"text-sm text-muted\">Бивш народен представител от ГЕРБ</p><p class=\"text-[15px] mt-2\">Заплахи към горски служители, за да спрат проверка за незаконна дървесина в района на Дулово.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->6 месеца лишаване от свобода, условно, с 3 години изпитателен срок. Потвърдено от Върховния касационен съд.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://clubz.bg/174714\" target=\"_blank\" rel=\"noreferrer\">Club Z: ВКС потвърди присъдата</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-red text-white\">Влязла в сила присъда</span><p class=\"font-semibold text-lg mt-2\"><a href=\"/parlament/deputat/5101\">Георги Георгиев</a></p><p class=\"text-sm text-muted\">Кмет на с. Бата (община Поморие), избран от ГЕРБ</p><p class=\"text-[15px] mt-2\">Купуване на гласове.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->10 месеца лишаване от свобода, условно, с 3 години изпитателен срок; ВКС потвърждава присъдата на 19 декември 2025 г. Месец и половина по-късно все още е на поста си.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://clubz.bg/170463\" target=\"_blank\" rel=\"noreferrer\">Club Z: осъден окончателно</a></span><span>; <a href=\"https://defakto.bg/2026/01/26/vks-potvardi-osaditelna-prisada-za-kupuvane-na-glasove-ot-zasthiteniya-ot-borisov-kmet-na-gerb-ot-s-bata/\" target=\"_blank\" rel=\"noreferrer\">DeFakto: ВКС потвърди присъдата</a></span><span>; <a href=\"https://dnes.dir.bg/temida/kmet-osaden-za-targoviya-s-glasove-prodalzhava-da-upravlyava\" target=\"_blank\" rel=\"noreferrer\">Дир.бг: продължава да управлява</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-red text-white\">Влязла в сила присъда</span><p class=\"font-semibold text-lg mt-2\">Десислава Иванчева</p><p class=\"text-sm text-muted\">Бивш кмет на район „Младост“ (София)</p><p class=\"text-[15px] mt-2\">Искане на подкуп от строителен предприемач (заедно със заместничката си Биляна Петрова и посредника Петко Дюлгеров).</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Първата инстанция я осъди на 20 години затвор (2019). По-горният съд намали наказанието. Окончателно е осъдена на 6 години затвор и го изтърпява; през април 2025 г. съдът в Ловеч отказа да я освободи предсрочно.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.bta.bg/bg/galleries/394573\" target=\"_blank\" rel=\"noreferrer\">БТА: Окръжният съд в Ловеч, 16.04.2025</a></span><span>; <a href=\"https://bta.bg/en/news/36805-Ex-Mayor-of-Sofia-s-Mladost-Borough-Released-on-Bail-Trial-Adjourned\" target=\"_blank\" rel=\"noreferrer\">БТА: освобождаване под гаранция и намалените присъди</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-red text-white\">Влязла в сила присъда</span><p class=\"font-semibold text-lg mt-2\">Фидел Беев</p><p class=\"text-sm text-muted\">Бивш кмет на Велинград и бивш депутат (ДПС)</p><p class=\"text-[15px] mt-2\">Злоупотреба като кмет: общински обекти (детски градини) са снабдявани с гориво от негови собствени фирми в нарушение на Закона за обществените поръчки.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Софийският градски съд го осъди на 3,5 години затвор (юли 2009 г.); Върховният касационен съд потвърди присъдата през януари 2012 г.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.capital.bg/blogove/momchil_milev/2009/07/14/754935_vlastelin_v_minalo_vreme/\" target=\"_blank\" rel=\"noreferrer\">Капитал: присъдата на първа инстанция (07.2009)</a></span><span>; <a href=\"https://www.novinite.com/articles/135848/Ex+Mayor%2C+MP+Goes+to+Jail+in+Bulgaria\" target=\"_blank\" rel=\"noreferrer\">Novinite: ВКС потвърди 3,5 години (18.01.2012)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-red text-white\">Влязла в сила присъда</span><p class=\"font-semibold text-lg mt-2\">Милен Милев</p><p class=\"text-sm text-muted\">Бивш кмет на Тетевен</p><p class=\"text-[15px] mt-2\">Присвояване в големи размери на пари на общинската фондация „Тома Васильов“ (2009 г.), като председател на управителния ѝ съвет.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Осъден на 2 години условно; Върховният касационен съд потвърди присъдата през август 2024 г. Делата срещу останалите обвиняеми са прекратени поради давност.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://utroruse.com/article/1028811/\" target=\"_blank\" rel=\"noreferrer\">Утро Русе / БТА: ВКС потвърди условната присъда (09.08.2024)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-red text-white\">Влязла в сила присъда</span><p class=\"font-semibold text-lg mt-2\">Анелия Цветкова</p><p class=\"text-sm text-muted\">Бивш председател на Административния съд – Варна</p><p class=\"text-[15px] mt-2\">Подкуп (задържана при акция на ДАНС и прокуратурата през 2008 г.).</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Окончателно осъдена: ВКС потвърди 3 години условно, глоба 10 000 лв. и забрана да заема съдийска длъжност за 3 години.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.novinite.com/articles/171202/Ex+Chair+of+Varna+Administrative+Court+Conclusively+Convicted+in+Bribery+Case\" target=\"_blank\" rel=\"noreferrer\">Novinite: окончателна присъда (07.10.2015)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-red text-white\">Влязла в сила присъда</span><p class=\"font-semibold text-lg mt-2\">Атанас Вълков</p><p class=\"text-sm text-muted\">Бивш председател на Административния съд – Бургас</p><p class=\"text-[15px] mt-2\">Документни престъпления при реституционни претенции за два имота (2007–2011 г.).</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Окончателно осъден: ВКС остави в сила 2,5 години условно и забрана да заема магистратска длъжност 5,5 години (първата инстанция беше дала 3,5 години ефективно).</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.capital.bg/kakvo_stava/2018/04/24/3168233_bivshiiat_shef_na_administrativen_sud_-_burgas/\" target=\"_blank\" rel=\"noreferrer\">Капитал: окончателна присъда (24.04.2018)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-red text-white\">Влязла в сила присъда</span><p class=\"font-semibold text-lg mt-2\">Ценко Чоков</p><p class=\"text-sm text-muted\">Бивш кмет на с. Галиче</p><p class=\"text-[15px] mt-2\">Отвличане, средна телесна повреда и палежи (делото е от 2017 г., заедно със сина му).</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Окончателно осъден: ВКС потвърди 5 години затвор, постановени от Апелативния специализиран съд; на сина бяха намалени от 7 на 5 години.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://utroruse.com/article/822130/\" target=\"_blank\" rel=\"noreferrer\">Утро Русе / БТА (13.07.2022)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#e08a2e] text-white\">Осъден, присъдата не е окончателна</span><p class=\"font-semibold text-lg mt-2\"><a href=\"/parlament/deputat/5169\">Димитър Аврамов</a></p><p class=\"text-sm text-muted\">Народен представител от ДПС</p><p class=\"text-[15px] mt-2\">Търговия с влияние, в съучастие.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Апелативният съд в София го признава за виновен (октомври 2025), след като Софийският градски съд го е оправдал по тази част. Присъдата е обжалвана пред ВКС; прокуратурата иска сваляне на имунитета му в 52-рото Народно събрание.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://iustitia.bg/parlamenta-vneseno-iskane-svalyane-imuniteta-deputat-za/\" target=\"_blank\" rel=\"noreferrer\">Iustitia: искане за сваляне на имунитета</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Подсъдим</span><p class=\"font-semibold text-lg mt-2\">Благомир Коцев</p><p class=\"text-sm text-muted\">Кмет на Варна</p><p class=\"text-[15px] mt-2\">Дело на Комисията за противодействие на корупцията (КПК) срещу него, двама общински съветници от ПП във Варна и бизнесмен.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Едно от само трите дела на КПК, стигнали до съда към края на 2025 г. Няма присъда.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://paragraf.bg/delata-na-antikoruptsionnata-komisiya-katastrofirat-v-sada-varnaha-18-hil-lv-na-deputata-ibryamov/\" target=\"_blank\" rel=\"noreferrer\">Paragraf: делата на КПК в съда</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Подсъдим</span><p class=\"font-semibold text-lg mt-2\">Нено Димов</p><p class=\"text-sm text-muted\">Бивш министър на околната среда и водите (номиниран от „Обединени патриоти“)</p><p class=\"text-[15px] mt-2\">Умишлена безстопанственост по време на водната криза в Перник през 2019 г.: според прокуратурата е позволил вода от язовир „Студена“ да се ползва за промишлеността, след като е знаел, че запасът намалява.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Подаде оставка на 10 януари 2020 г. Делото е в съда; през февруари 2026 г. съдът продължава да заседава. Няма присъда.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.rferl.org/a/bulgaria-prosecutors-charge-environmental-minister-dimov/30371411.html\" target=\"_blank\" rel=\"noreferrer\">Свободна Европа: обвинението (2020)</a></span><span>; <a href=\"https://www.fakti.bg/en/bulgaria/1032739-the-court-is-sitting-again-in-the-case-of-former-minister-of-environment-neno-dimov\" target=\"_blank\" rel=\"noreferrer\">Fakti: ново заседание по делото (06.02.2026)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Подсъдим</span><p class=\"font-semibold text-lg mt-2\">Иван Портних</p><p class=\"text-sm text-muted\">Бивш кмет на Варна (ГЕРБ)</p><p class=\"text-[15px] mt-2\">Измама с евросредства: според Европейската прокуратура заедно с бивш областен управител и двама служители на Морска администрация са подали неверни данни, за да получат 3,4 млн. € за реконструкция на рибарско пристанище край Варна, което по документите не е съществувало.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Европейската прокуратура внесе обвинителен акт в съда на 1 декември 2025 г. Щетата се оценява на около 2,8 млн. € за бюджета на ЕС и 675 475 € за националния бюджет. Няма присъда.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.eppo.europa.eu/en/media/news/bulgaria-former-mayor-and-ex-governor-varna-indicted-claiming-funds-non-existent-harbour\" target=\"_blank\" rel=\"noreferrer\">Европейска прокуратура: обвинителен акт (1.12.2025)</a></span><span>; <a href=\"https://bntnews.bg/news/european-prosecutor’s-office-brings-former-varna-mayor-ivan-portnih-to-court-1367629news.html\" target=\"_blank\" rel=\"noreferrer\">БНТ: Портних на съд</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Подсъдим</span><p class=\"font-semibold text-lg mt-2\">Панайот Рейзи</p><p class=\"text-sm text-muted\">Бивш кмет на Созопол (избран от ГЕРБ; напуска партията през 2019 г.)</p><p class=\"text-[15px] mt-2\">Присвояване на 1 989 474 лв. от бюджета на общината в периода 2014–2017 г. чрез договори и фактури за неизвършени ремонти.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Съдът го отстрани от длъжност през април 2019 г. Обвинителният акт е внесен през юли 2020 г. Не открихме публикувана присъда по наказателното дело. По отделно дело административният съд в Бургас го глоби 160 000 лв. за конфликт на интереси.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://bntnews.bg/news/mayor-of-sozopol-accused-of-misappropriation-of-nearly-bgn-2-million-1311928news.html\" target=\"_blank\" rel=\"noreferrer\">БНТ: обвинението</a></span><span>; <a href=\"https://www.capital.bg/politika_i_ikonomika/imena/2020/07/10/4088948_stroitel_na_kapitalizma_panaiot_reizi/\" target=\"_blank\" rel=\"noreferrer\">Капитал: делото отива в съда (2020)</a></span><span>; <a href=\"https://www.bta.bg/en/news/355000-former-sozopol-mayor-fined-bgn-160-000-for-conflict-of-interestza-konflikt-na-in\" target=\"_blank\" rel=\"noreferrer\">БТА: глоба за конфликт на интереси</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Подсъдим</span><p class=\"font-semibold text-lg mt-2\">Стоян Пасев</p><p class=\"text-sm text-muted\">Бивш областен управител на Варна (ГЕРБ)</p><p class=\"text-[15px] mt-2\">Същото дело като срещу Иван Портних: неверни данни и документи за 3,4 млн. € евросредства за реконструкция на рибарско пристанище край Варна, което по документите не е съществувало.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Европейската прокуратура внесе обвинителен акт на 1.12.2025 г. При осъдителна присъда грозят от 2 до 8 години затвор. Няма присъда.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.fakti.bg/en/krimi/1018261-evroprokuraturata-obvini-bivshia-kmet-na-varna-ivan-portnih-i-bivshia-oblasten-upravitel-stoan-pasev\" target=\"_blank\" rel=\"noreferrer\">Fakti: обвинени са Портних и Пасев</a></span><span>; <a href=\"https://www.eppo.europa.eu/en/media/news/bulgaria-former-mayor-and-ex-governor-varna-indicted-claiming-funds-non-existent-harbour\" target=\"_blank\" rel=\"noreferrer\">Европейска прокуратура (1.12.2025)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Подсъдим</span><p class=\"font-semibold text-lg mt-2\">Димитър Бръчков</p><p class=\"text-sm text-muted\">Кмет на община Петрич</p><p class=\"text-[15px] mt-2\">Измама с евросредства по проекта „Културен дипол в трансграничния регион“ (програма Гърция–България): според обвинението е скрито, че се строи изцяло нова сграда, в нарушение на споразумението между партньорите. Кметът сам потвърди пред БТА, че обвинението е срещу него, и заяви, че не е притеснен.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Обвинен през март 2025 г.; обвинителният акт е внесен в съда през октомври 2026 г. Няма присъда.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.bta.bg/bg/videos/26521\" target=\"_blank\" rel=\"noreferrer\">БТА: кметът на Петрич за обвиненията</a></span><span>; <a href=\"https://www.eppo.europa.eu/en/media/news/bulgaria-mayor-petrich-accused-fraud-involving-cultural-heritage-museum\" target=\"_blank\" rel=\"noreferrer\">Европейска прокуратура: обвинението (25.03.2025)</a></span><span>; <a href=\"https://euagenda.eu/news/942478\" target=\"_blank\" rel=\"noreferrer\">EUagenda / Novinite: обвинителният акт (10.2026)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Подсъдим</span><p class=\"font-semibold text-lg mt-2\">Николай Малинов</p><p class=\"text-sm text-muted\">Бивш депутат, лидер на движение „Русофили“</p><p class=\"text-[15px] mt-2\">Обвинение от 2019 г. (повторено през 2021 г.) за шпионаж в полза на руски организации, свързани с Руския институт за стратегически изследвания.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Софийският градски съд го оправда през май 2026 г. Присъдата не е окончателна и може да бъде протестирана от прокуратурата.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.fakti.bg/en/bulgaria/1054779-russophile-movement-leader-nikolay-malinov-acquitted-in-espionage-case\" target=\"_blank\" rel=\"noreferrer\">Fakti: оправдан по делото за шпионаж (16.05.2026)</a></span><span>; <a href=\"https://brusselssignal.eu/2026/05/bulgarian-court-clears-pro-russian-activist-of-spying/\" target=\"_blank\" rel=\"noreferrer\">Brussels Signal / AFP (05.2026)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Обвинен</span><p class=\"font-semibold text-lg mt-2\"><a href=\"/parlament/deputat/3996\">Иван Демерджиев</a></p><p class=\"text-sm text-muted\">Бивш служебен министър на вътрешните работи</p><p class=\"text-[15px] mt-2\">Обвинение за корупция: увеличение на цени по договор на МВР без одобрена методика, с щета около 758 000 € (1 482 218 лв.).</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Мярка за неотклонение „гаранция“ 10 000 лв. Досъдебното производство е образувано на 16.01.2024 г.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://eurocom.bg/2025/04/25/prokuraturata-povdigna-obvinenie-za-koruptsiya-v-razmer-nad-1-mln-leva-sreshtu-demerdzhiev\" target=\"_blank\" rel=\"noreferrer\">Евроком: обвинение срещу Демерджиев</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Обвинен</span><p class=\"font-semibold text-lg mt-2\">Джейхан Ибрямов</p><p class=\"text-sm text-muted\">Народен представител</p><p class=\"text-[15px] mt-2\">Обвинение от Комисията за противодействие на корупцията; единственият депутат с официални обвинения от КПК.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Съдът връща 18 000 лв., иззети при обиски. Няма присъда.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://paragraf.bg/delata-na-antikoruptsionnata-komisiya-katastrofirat-v-sada-varnaha-18-hil-lv-na-deputata-ibryamov/\" target=\"_blank\" rel=\"noreferrer\">Paragraf: върнаха пари на депутата Ибрямов</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Обвинен</span><p class=\"font-semibold text-lg mt-2\">Васил Божков</p><p class=\"text-sm text-muted\">Бизнесмен, основател на партия „Българско лято“</p><p class=\"text-[15px] mt-2\">Множество обвинения, включително за подкупи на държавни служители. Санкциониран и от САЩ и Великобритания.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Към началото на 2026 г. няма присъда. Прокуратурата сочи липса на съдействие от ОАЕ за разпита му.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://boulevardbulgaria.bg/articles/magnitski-na-trupcheta-kakvo-stana-s-delata-sreshtu-ovcharov-goranov-bozhkov-i-peevski\" target=\"_blank\" rel=\"noreferrer\">Булевард България: какво стана с делата (2026)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Обвинен</span><p class=\"font-semibold text-lg mt-2\">Никола Барбутов</p><p class=\"text-sm text-muted\">Бивш заместник-кмет на Столична община (от „Продължаваме промяната“)</p><p class=\"text-[15px] mt-2\">Участие в организирана престъпна група за престъпления по служба и подкупи; обещаване и предлагане на подкуп на районни кметове („Люлин“ и „Младост“). Разследването е на Комисията за противодействие на корупцията.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Обвинителният акт е внесен в съда през ноември 2025 г. През 2026 г. Софийският градски съд го върна на прокуратурата заради съществени процесуални нарушения (определението подлежи на протест). Мярката му е сменена на парична гаранция 5 000 €. Няма присъда.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://clubz.bg/163099\" target=\"_blank\" rel=\"noreferrer\">Клуб Z: обвиненията (25.06.2025)</a></span><span>; <a href=\"https://www.bta.bg/bg/videos/35410\" target=\"_blank\" rel=\"noreferrer\">БТА: съдът върна делото на прокуратурата</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Обвинен</span><p class=\"font-semibold text-lg mt-2\">Кирил Петков</p><p class=\"text-sm text-muted\">Бивш министър-председател, бивш председател на „Продължаваме промяната“</p><p class=\"text-[15px] mt-2\">Обвинение в принуда срещу бившия министър на електронното управление Александър Йоловски.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Делото беше внесено в съда, но Софийският градски съд прекрати производството и върна обвинителния акт на прокуратурата за отстраняване на грешки (определението подлежи на жалба и протест). Няма присъда.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.bta.bg/bg/videos/36274\" target=\"_blank\" rel=\"noreferrer\">БТА: съдът върна обвинителния акт срещу Петков и Божанов</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Обвинен</span><p class=\"font-semibold text-lg mt-2\"><a href=\"/parlament/deputat/5229\">Божидар Божанов</a></p><p class=\"text-sm text-muted\">Бивш министър на електронното управление, съпредседател на „Да, България“</p><p class=\"text-[15px] mt-2\">Обвинение в престъпление по служба, свързано с обществена поръчка.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Софийският градски съд върна обвинителния акт на прокуратурата: според съда от него не става ясно в полза на кое дружество са действията, за които е обвинен. Определението подлежи на жалба и протест. Няма присъда.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.bta.bg/bg/videos/36274\" target=\"_blank\" rel=\"noreferrer\">БТА: съдът върна обвинителния акт срещу Петков и Божанов</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Обвинен</span><p class=\"font-semibold text-lg mt-2\">Цветан Цветанов (кмет на Лом)</p><p class=\"text-sm text-muted\">Кмет на община Лом (избран през 2023 г. като кандидат на ГЕРБ)</p><p class=\"text-[15px] mt-2\">Престъпление против политическите права на гражданите: според прокуратурата на 15 април 2026 г. е предложил по 50 € на служители на общинско предприятие, за да гласуват за определена коалиция и кандидат на изборите на 19 април 2026 г.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Обвинението е повдигнато от Окръжната прокуратура – Монтана (обявено на 12.05.2026). Няма присъда.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.bta.bg/en/news/bulgaria/1124499-lom-mayor-charged-with-vote-buying\" target=\"_blank\" rel=\"noreferrer\">БТА: кметът на Лом е обвинен в купуване на гласове</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Обвинен</span><p class=\"font-semibold text-lg mt-2\">Мюмюн Искендер</p><p class=\"text-sm text-muted\">Кмет на община Минерални бани</p><p class=\"text-[15px] mt-2\">Разследване на Софийската градска прокуратура за четири случая в периода 2019–2025 г., сред които злоупотреба с имот на черковното настоятелство в с. Брястово.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->На 21.10.2025 г. Окръжният съд в Хасково го отстрани от длъжност по искане на прокуратурата. Няма присъда.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.bta.bg/bg/news/bulgaria/992267-sadat-v-haskovo-otstrani-kmeta-na-mineralni-bani-myumyun-iskender-ot-dlazhnost-z\" target=\"_blank\" rel=\"noreferrer\">БТА: съдът отстрани кмета от длъжност</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Разследването е прекратено</span><p class=\"font-semibold text-lg mt-2\"><a href=\"/parlament/deputat/5186\">Бойко Борисов</a></p><p class=\"text-sm text-muted\">Лидер на ГЕРБ, бивш министър-председател</p><p class=\"text-[15px] mt-2\">Разследване за пране на пари („Барселонагейт“): твърдения за имот в Барселона, купен през 2013 г. Разследването започва през 2020 г.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Софийската градска прокуратура прекратява делото поради липса на доказателства за престъпление.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://old-news.bnr.bg/en/post/101892954/money-laundering-case-against-former-pm-boyko-borissov-terminated\" target=\"_blank\" rel=\"noreferrer\">БНР: Прекратено е делото за пране на пари срещу Бойко Борисов</a></span><span>; <a href=\"https://www.eurointegration.com.ua/news/2023/10/17/7171577/\" target=\"_blank\" rel=\"noreferrer\">Европейска правда, 17.10.2023</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Разследването е прекратено</span><p class=\"font-semibold text-lg mt-2\"><a href=\"/parlament/deputat/5186\">Бойко Борисов</a></p><p class=\"text-sm text-muted\">Лидер на ГЕРБ, бивш министър-председател</p><p class=\"text-[15px] mt-2\">Разследване за изнудване по показания на Васил Божков (заедно с Владислав Горанов и Севделина Арнаудова).</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Софийската градска прокуратура прекратява разследването поради липса на доказателства.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://parliament140.bnr.bg/en/post/101921160/prosecutor-s-office-terminates-investigation-against-boyko-borissov-for-extortion\" target=\"_blank\" rel=\"noreferrer\">БНР: Прокуратурата прекрати разследването срещу Бойко Борисов за изнудване</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\">Разследването е прекратено</span><p class=\"font-semibold text-lg mt-2\">Иван Тотев</p><p class=\"text-sm text-muted\">Бивш кмет на Пловдив (ГЕРБ)</p><p class=\"text-[15px] mt-2\">Обвинение от януари 2017 г. за престъпление по служба при възлагането на строежа на зоокъта в Пловдив (според прокуратурата вреда около 1 млн. лв.).</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Съдът два пъти върна делото на прокуратурата заради неясно обвинение (окончателно от апелативния съд, юли 2018 г.). В началото на 2021 г. прокуратурата прекрати производството. Няма присъда.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.capital.bg/kakvo_stava/2018/07/24/3286565_deloto_sreshtu_kmeta_na_plovdiv_ivan_totev_okochatelno/\" target=\"_blank\" rel=\"noreferrer\">Капитал: делото окончателно върнато на прокуратурата (2018)</a></span><span>; <a href=\"https://www.capital.bg/politika_i_ikonomika/pravo/2021/11/01/4272394_prokuraturata_tihomulkom_prekrati_deloto_sreshtu_ivan/\" target=\"_blank\" rel=\"noreferrer\">Капитал: прокуратурата прекрати делото (2021)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\">Окончателно оправдан</span><p class=\"font-semibold text-lg mt-2\">Вельо Илиев</p><p class=\"text-sm text-muted\">Бивш кмет на Петрич</p><p class=\"text-[15px] mt-2\">Обвинение за престъпление по служба: непроведени процедури за обществени поръчки за доставка на лекарства за ветерани (2007–2011 г.).</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Върховният касационен съд го оправдава окончателно.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://utroruse.com/article/1007078/\" target=\"_blank\" rel=\"noreferrer\">Утро Русе: ВКС окончателно оправда бившия кмет на Петрич</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\">Окончателно оправдан</span><p class=\"font-semibold text-lg mt-2\">Цветан Цветанов</p><p class=\"text-sm text-muted\">Бивш вицепремиер и министър на вътрешните работи от ГЕРБ</p><p class=\"text-[15px] mt-2\">Обвинения, че като министър е осуетил разследване, като шест пъти е отказал да разпореди специални разузнавателни средства, и за изплащане на близо 50 000 лв. на бивш шеф на звеното срещу организираната престъпност във Велико Търново.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Двете по-долни инстанции първо го осъдиха на 4 години затвор, но след ново разглеждане беше оправдан. Върховният касационен съд потвърди окончателно оправдателните присъди и по двете дела.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://bta.bg/en/news/158360-Supreme-Court-Acquits-Ex-Interior-Minister-Tsvetanov-in-Surveillance-Refusal-Cas\" target=\"_blank\" rel=\"noreferrer\">БТА: ВКС потвърждава оправдаването (отказ на СРС)</a></span><span>; <a href=\"https://www.bta.bg/en/news/164197-Supreme-Court-of-Cassation-Upholds-Former-Interior-Minister-Tsvetanov-s-Acquitta\" target=\"_blank\" rel=\"noreferrer\">БТА: ВКС потвърждава оправдаването (присвояване)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\">Окончателно оправдан</span><p class=\"font-semibold text-lg mt-2\">Николай Ненчев</p><p class=\"text-sm text-muted\">Бивш министър на отбраната (БЗНС, Реформаторски блок)</p><p class=\"text-[15px] mt-2\">Две обвинения от ноември 2016 г. за престъпления по служба: ремонтът на изтребителите МиГ-29 в Полша и поръчката за униформи на военните.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Окончателно оправдан и по двете дела от Върховния касационен съд: за униформите през април 2018 г., за ремонта на МиГ-овете след пет години и половина разследване и съдебни дела.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.capital.bg/kakvo_stava/2018/04/25/3169155_nikolai_nenchev_okonchatelno_opravdan_po_edno_ot/\" target=\"_blank\" rel=\"noreferrer\">Капитал: окончателно оправдан за униформите (2018)</a></span><span>; <a href=\"https://bnr.bg/en/post/101465481/mig-fighter-aircraft-court-saga-ends-with-not-guilty-verdict\" target=\"_blank\" rel=\"noreferrer\">БНР: окончателно оправдан за МиГ-29</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\">Окончателно оправдан</span><p class=\"font-semibold text-lg mt-2\">Николай Цонев</p><p class=\"text-sm text-muted\">Бивш министър на отбраната (правителство „Станишев“)</p><p class=\"text-[15px] mt-2\">Обвинение, че чрез посредник е предложил подкуп от 20 000 евро на следовател, за да бъде спряно разследване срещу него за поръчка на МО за 120 млн. лв. Отделно обвинение за поръчката на оптичния кабел „Странджа-2“.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Оправдан окончателно от Върховния касационен съд по делото за подкуп (3.2.2015). По делото за кабела е оправдан през октомври 2012 г.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.bta.bg/en/news/180168-Ex-Defence-Minister-Judge-Former-Finance-Ministry-Official-Conclusively-Acquit\" target=\"_blank\" rel=\"noreferrer\">БТА: окончателно оправдан по делото за подкуп</a></span><span>; <a href=\"https://www.occrp.org/en/daily/3637-bulgaria-former-defense-minister-acquitted-in-bribery-case\" target=\"_blank\" rel=\"noreferrer\">OCCRP: оправдан и по делото за кабела</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\">Окончателно оправдан</span><p class=\"font-semibold text-lg mt-2\">Христо Бисеров</p><p class=\"text-sm text-muted\">Бивш заместник-председател на Народното събрание и на ДПС</p><p class=\"text-[15px] mt-2\">Укриване на данъци в особено големи размери, недекларирани валутни преводи и невярна декларация пред Сметната палата (недекларирани влогове в швейцарска банка). Отделно разследване за пране на пари.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Оправдан и от трите инстанции по трите обвинения; Върховният касационен съд потвърждава окончателно. Делото за пране на пари е закрито от съда през февруари 2016 г., след като прокуратурата не го довършва.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.bta.bg/en/news/136252-Hristo-Bisserov-Acquitted-by-Final-Court-of-Appeal\" target=\"_blank\" rel=\"noreferrer\">БТА: окончателно оправдан от ВКС</a></span><span>; <a href=\"https://www.occrp.org/ru/novosti/bolgariia-s-byvsego-vice-spikera-parlamenta-sniaty-obvineniia-v-otmyvanii-deneg\" target=\"_blank\" rel=\"noreferrer\">OCCRP: закрито делото за пране на пари (2016)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\">Окончателно оправдан</span><p class=\"font-semibold text-lg mt-2\">Симеон Дянков</p><p class=\"text-sm text-muted\">Бивш вицепремиер и министър на финансите (ГЕРБ, 2009–2013)</p><p class=\"text-[15px] mt-2\">Обвинение от 2017 г. за престъпление по служба при продажбата през 2011 г. на остатъчния държавен дял от 33% в ЕВН (според обвинението на занижена цена, с вреда около 20 млн. лв.).</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Оправдан от Специализирания наказателен съд (юни 2020 г.); апелативният съд потвърди през април 2021 г., прокуратурата не обжалва и оправдаването влезе в сила през май 2021 г.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://bnt.bg/bg/a/businessman-prokopiev-former-ministers-djankov-traikov-acquitted-in-evn-case\" target=\"_blank\" rel=\"noreferrer\">БНТ: оправдани на първа инстанция (28.06.2020)</a></span><span>; <a href=\"https://seenews.com/news/bulgarias-alfa-finance-says-court-upholds-acquittal-of-owner-ex-ministers-in-evn-unit-sale-case-738498\" target=\"_blank\" rel=\"noreferrer\">SeeNews: апелативният съд потвърди оправдаването (04.2021)</a></span><span>; <a href=\"https://seenews.com/news/acquittal-of-all-defendants-in-sale-of-33-in-evn-bulgaria-takes-effect-alfa-finance-740701\" target=\"_blank\" rel=\"noreferrer\">SeeNews: оправдаването влезе в сила (05.2021)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\">Окончателно оправдан</span><p class=\"font-semibold text-lg mt-2\">Трайчо Трайков</p><p class=\"text-sm text-muted\">Бивш министър на икономиката, енергетиката и туризма (2009–2012)</p><p class=\"text-[15px] mt-2\">Обвинение от 2017 г. за безстопанственост при продажбата през 2011 г. на държавния дял от 33% в ЕВН.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Оправдан на две инстанции; оправдаването влезе в сила през май 2021 г., след като прокуратурата не го обжалва.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://bnt.bg/bg/a/businessman-prokopiev-former-ministers-djankov-traikov-acquitted-in-evn-case\" target=\"_blank\" rel=\"noreferrer\">БНТ: оправдани на първа инстанция (28.06.2020)</a></span><span>; <a href=\"https://seenews.com/news/bulgarias-alfa-finance-says-court-upholds-acquittal-of-owner-ex-ministers-in-evn-unit-sale-case-738498\" target=\"_blank\" rel=\"noreferrer\">SeeNews: апелативният съд потвърди оправдаването (04.2021)</a></span><span>; <a href=\"https://seenews.com/news/acquittal-of-all-defendants-in-sale-of-33-in-evn-bulgaria-takes-effect-alfa-finance-740701\" target=\"_blank\" rel=\"noreferrer\">SeeNews: оправдаването влезе в сила (05.2021)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\">Окончателно оправдан</span><p class=\"font-semibold text-lg mt-2\">Емилия Масларова</p><p class=\"text-sm text-muted\">Бивш министър на труда и социалната политика (БСП)</p><p class=\"text-[15px] mt-2\">Обвинение от 2010 г. за присвояване при т.нар. „златен ремонт“ на Центъра за комплексни социални услуги в Стара Загора (над 11 млн. лв.).</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Софийският градски съд оправда всички подсъдими в края на 2015 г.; делото приключи окончателно след 11 години. През 2024 г. съдът осъди прокуратурата да ѝ плати 70 000 лв. обезщетение.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://fakti.bg/en/bulgaria/921965-bivshiat-socialen-ministar-emilia-maslarova-osadi-prokuraturata-za-70-000-lv\" target=\"_blank\" rel=\"noreferrer\">Fakti: обезщетение от прокуратурата (22.10.2024)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\">Окончателно оправдан</span><p class=\"font-semibold text-lg mt-2\">Христо Ангеличин</p><p class=\"text-sm text-muted\">Бивш заместник-министър на външните работи</p><p class=\"text-[15px] mt-2\">Обвинения в безстопанственост: покупка на телефонни централи за 12 посолства; отделно дело за самолетните билети на министерството (заедно с бившия министър Даниел Митов).</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Окончателно оправдан и по двете дела: за билетите в началото на 2020 г., за централите – от ВКС през септември 2020 г. (съдът приема, че деянието не е престъпление). През 2021 г. заведе иск срещу прокуратурата.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://news.lex.bg/%D0%B1%D0%B8%D0%B2%D1%88%D0%B8%D1%8F%D1%82-%D0%B7%D0%B0%D0%BC-%D0%B2%D1%8A%D0%BD%D1%88%D0%B5%D0%BD-%D0%BC%D0%B8%D0%BD%D0%B8%D1%81%D1%82%D1%8A%D1%80-%D1%85%D1%80%D0%B8%D1%81%D1%82%D0%BE-%D0%B0%D0%BD-4/\" target=\"_blank\" rel=\"noreferrer\">Lex.bg: Ангеличин съди прокуратурата (02.03.2021)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\">Окончателно оправдан</span><p class=\"font-semibold text-lg mt-2\"><a href=\"/parlament/deputat/5284\">Даниел Митов</a></p><p class=\"text-sm text-muted\">Бивш министър на външните работи</p><p class=\"text-[15px] mt-2\">Обвинение за злоупотреба с доверие при поръчката на самолетни билети за министерството (заедно със заместника му Христо Ангеличин).</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Окончателно оправдан: ВКС остави в сила оправдателната присъда на апелативния спецсъд и прие, че министърът изобщо не може да носи отговорност по този текст.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://news.lex.bg/%D0%B1%D0%B8%D0%B2%D1%88%D0%B8%D1%8F%D1%82-%D0%B2%D1%8A%D0%BD%D1%88%D0%B5%D0%BD-%D0%BC%D0%B8%D0%BD%D0%B8%D1%81%D1%82%D1%8A%D1%80-%D0%B4%D0%B0%D0%BD%D0%B8%D0%B5%D0%BB-%D0%BC%D0%B8%D1%82%D0%BE%D0%B2/\" target=\"_blank\" rel=\"noreferrer\">Lex.bg: Митов окончателно оправдан</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\">Окончателно оправдан</span><p class=\"font-semibold text-lg mt-2\">Илко Семерджиев</p><p class=\"text-sm text-muted\">Бивш вицепремиер и министър на здравеопазването (служебен кабинет)</p><p class=\"text-[15px] mt-2\">Обвинение за заплаха и натиск по телефона към директора на Агенцията по лекарствата за назначение на заместник.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Оправдан на две инстанции; ВКС потвърди окончателно на 15.01.2020 г. и прие, че обвинението е несъставомерно.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://news.lex.bg/%D0%B1%D0%B8%D0%B2%D1%88%D0%B8%D1%8F%D1%82-%D0%B2%D0%B8%D1%86%D0%B5%D0%BF%D1%80%D0%B5%D0%BC%D0%B8%D0%B5%D1%80-%D0%B8%D0%BB%D0%BA%D0%BE-%D1%81%D0%B5%D0%BC%D0%B5%D1%80%D0%B4%D0%B6%D0%B8%D0%B5%D0%B2/\" target=\"_blank\" rel=\"noreferrer\">Lex.bg: Семерджиев окончателно оправдан (16.01.2020)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\">Окончателно оправдан</span><p class=\"font-semibold text-lg mt-2\">Веселин Марешки</p><p class=\"text-sm text-muted\">Бивш заместник-председател на Народното събрание</p><p class=\"text-[15px] mt-2\">Обвинение за изнудване на варненски бизнесмен (за плащания от по 10 000 лв. месечно).</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->След 8 години и няколко връщания между инстанциите ВКС на 18.03.2025 г. остави окончателно в сила оправдаването от Бургаския апелативен съд.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.svobodnaevropa.bg/a/veselin-mreshki-iznudvane-prisada/33358828.html\" target=\"_blank\" rel=\"noreferrer\">Свободна Европа (25.03.2025)</a></span><span>; <a href=\"https://www.segabg.com/category-bulgaria/mareshki-e-okonchatelno-opravdan-po-deloto-za-iznudvane\" target=\"_blank\" rel=\"noreferrer\">Сега (03.2025)</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\">Окончателно оправдан</span><p class=\"font-semibold text-lg mt-2\">Светлозар Георгиев</p><p class=\"text-sm text-muted\">Съдия във Варна</p><p class=\"text-[15px] mt-2\">Обвинение, че през 2015 г. е въздействал на прокурор да прекрати разследване срещу негов приятел полицай.</p><p class=\"text-[15px] mt-1\"><b>Докъде е стигнало:</b> <!-- -->Окончателно оправдан: ВКС потвърди оправдателните присъди на СГС и Софийския апелативен съд.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2018/04/28/3170629_sudiiata_podslushvan_po_deloto_mareshki_be/\" target=\"_blank\" rel=\"noreferrer\">Капитал (28.04.2018)</a></span></p></li></ul><p class=\"text-sm text-muted mt-3 max-w-3xl\">Списъкът се допълва. Влизат случаи с повдигнато обвинение или присъда срещу настоящи и бивши депутати, министри, кметове и ръководители на държавни институции, с източник. Сигнали и медийни публикации без обвинение не влизат.</p></section><section class=\"max-w-3xl text-[15px] space-y-2 mb-8\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Режимите</h2></div><p><b>Глобален закон „Магнитски“ (САЩ, Министерство на финансите, OFAC)<!-- -->.</b> <!-- -->Замразяване на активи в САЩ и забрана за сделки с американски лица и банки, работещи в долари.</p><p><b>Раздел 7031(c) (САЩ, Държавен департамент)<!-- -->.</b> <!-- -->Забрана за влизане в САЩ за лицето и семейството му заради значима корупция.</p><p><b>Британски режим за санкции срещу корупция (Global Anti-Corruption)<!-- -->.</b> <!-- -->Замразяване на активи и забрана за влизане във Великобритания.</p><p>Списъците се проверяват при всяко обновяване. Ако някой бъде изваден от списък, мярката остава тук, задраскана, с датата на отмяната.</p><p>Свързано: <a href=\"/ikonomika/evrosredstva/politika\">евросредства и политици</a>, <a href=\"/proverki\">проверки на твърдения</a>.</p></section><p class=\"text-xs text-muted\">Проверено: <!-- -->17 ноември 2026 г.<!-- -->.</p></div><!--$--><!--/$--></main><!--$--><!--/$--><footer class=\"bg-surface border-t border-rule mt-20\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 text-sm text-muted grid gap-2 sm:grid-cols-2\"><p>Не подкрепяме партия, кандидат или правителство. Всяко число има източник и дата.<!-- --> <a href=\"/metodologiya\">Как работим</a> · <a href=\"/rechnik\">Речник</a> · <a href=\"/sastoyanie\">Състояние на данните</a> · <!--$?--><template id=\"B:1\"></template><a href=\"/metodologiya#greshki\">Съобщи за грешка</a><!--/$--></p><p class=\"sm:text-right\">Вътрешен прототип · данните са към датите, посочени до тях</p></div></footer><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script id=\"_R_\">(globalThis[\"TURBOPACK\"] || (globalThis[\"TURBOPACK\"] = [])).push({\"otherChunks\":[\"static/chunks/310vm2bl3xxpt.js\",\"static/chunks/2vy51v46dlsq-.js\",\"static/chunks/2bx7ggprk0oi5.js\",\"static/chunks/0c1ad7rcpjghx.js\"],\"runtimeModuleIds\":[94553]});</script><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" async=\"\"></script><div hidden id=\"S:0\"><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" aria-current=\"page\" class=\"no-underline pb-1 border-b-2 text-white border-red\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 borde