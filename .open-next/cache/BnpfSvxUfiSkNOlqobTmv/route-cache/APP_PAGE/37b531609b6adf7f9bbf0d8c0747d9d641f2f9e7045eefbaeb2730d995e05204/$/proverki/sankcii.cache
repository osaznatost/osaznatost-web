ата\"}]]}]]]}]]}],[\"$\",\"li\",\"Георги ГеоргиевКупуване на гласове.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-red text-white\",\"children\":\"Влязла в сила присъда\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":[\"$\",\"$L9\",null,{\"href\":\"/parlament/deputat/5101\",\"children\":\"Георги Георгиев\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Кмет на с. Бата (община Поморие), избран от ГЕРБ\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Купуване на гласове.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"10 месеца лишаване от свобода, условно, с 3 години изпитателен срок; ВКС потвърждава присъдата на 19 декември 2025 г. Месец и половина по-късно все още е на поста си.\"]}],\"$L37\"]}],\"$L38\",\"$L39\",\"$L3a\",\"$L3b\",\"$L3c\",\"$L3d\",\"$L3e\",\"$L3f\",\"$L40\",\"$L41\",\"$L42\",\"$L43\",\"$L44\",\"$L45\",\"$L46\",\"$L47\",\"$L48\",\"$L49\",\"$L4a\",\"$L4b\",\"$L4c\",\"$L4d\",\"$L4e\",\"$L4f\",\"$L50\",\"$L51\",\"$L52\",\"$L53\",\"$L54\",\"$L55\",\"$L56\",\"$L57\",\"$L58\",\"$L59\",\"$L5a\",\"$L5b\",\"$L5c\",\"$L5d\"]}],\"$L5e\"]}]\n22:[\"$\",\"section\",null,{\"className\":\"max-w-3xl text-[15px] space-y-2 mb-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb-5\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] sm:text-[2.4rem]\",\"children\":\"Режимите\"}],\"$undefined\"]}],[[\"$\",\"p\",\"GLOMAG\",{\"children\":[[\"$\",\"b\",null,{\"children\":[\"Глобален закон „Магнитски“ (САЩ, Министерство на финансите, OFAC)\",\".\"]}],\" \",\"Замразяване на активи в САЩ и забрана за сделки с американски лица и банки, работещи в долари.\"]}],[\"$\",\"p\",\"7031c\",{\"children\":[[\"$\",\"b\",null,{\"children\":