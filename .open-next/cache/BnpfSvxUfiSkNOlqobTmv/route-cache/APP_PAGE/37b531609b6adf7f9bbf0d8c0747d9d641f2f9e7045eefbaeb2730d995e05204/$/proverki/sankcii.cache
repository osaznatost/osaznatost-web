ildren\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-red text-white\",\"children\":\"Влязла в сила присъда\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Десислава Иванчева\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш кмет на район „Младост“ (София)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Искане на подкуп от строителен предприемач (заедно със заместничката си Биляна Петрова и посредника Петко Дюлгеров).\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Първата инстанция я осъди на 20 години затвор (2019). По-горният съд намали наказанието. Окончателно е осъдена на 6 години затвор и го изтърпява; през април 2025 г. съдът в Ловеч отказа да я освободи предсрочно.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.bta.bg/bg/galleries/394573\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.bta.bg/bg/galleries/394573\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: Окръжният съд в Ловеч, 16.04.2025\"}]]}],[\"$\",\"span\",\"https://bta.bg/en/news/36805-Ex-Mayor-of-Sofia-s-Mladost-Borough-Released-on-Bail-Trial-Adjourned\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://bta.bg/en/news/36805-Ex-Mayor-of-Sofia-s-Mladost-Borough-Released-on-Bail-Trial-Adjourned\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: освобождаване под гаранция и намалените присъди\"}]]}]]]}]]}]\n39:[\"$\",\"li\",\"Фидел БеевЗлоупотреба като кмет: общински обекти (детски градини) са снабдявани с гориво от негови собствени фирми в нарушение на Закона за обществените поръчки.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-red text-white\",\"children\":\"Влязла в сила присъда\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Фидел Беев\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш кмет на Велинград и бивш депутат (ДПС)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Злоупотреба като кмет: общински обекти (детски градини) са снабдявани с гориво от негови собствени фирми в нарушение на Закона за обществените поръчки.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Софийският градски съд го осъди на 3,5 години затвор (юли 2009 г.); Върховният касационен съд потвърди присъдата през януари 2012 г.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.capital.bg/blogove/momchil_milev/2009/07/14/754935_vlastelin_v_minalo_vreme/\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.capital.bg/blogove/momchil_milev/2009/07/14/754935_vlastelin_v_minalo_vreme/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Капитал: присъдата на първа инстанция (07.2009)\"}]]}],[\"$\",\"span\",\"https://www.novinite.com/articles/135848/Ex+Mayor%2C+MP+Goes+to+Jail+in+Bulgaria\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://www.novinite.com/articles/135848/Ex+Mayor%2C+MP+Goes+to+Jail+in+Bulgaria\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Novinite: ВКС потвърди 3,5 години (18.01.2012)\"}]]}]]]}]]}]\n3a:[\"$\",\"li\",\"Милен МилевПрисвояване в големи размери на пари на общинската фондация „Тома Васильов“ (2009 г.), като председател на управителния ѝ съвет.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-red text-white\",\"children\":\"Влязла в сила присъда\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Милен Милев\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш кмет на Тетевен\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Присвояване в големи размери на пари на общинската фондация „Тома Васильов“ (2009 г.), като председател на управителния ѝ съвет.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Осъден на 2 години условно; Върховният касационен съд потвърди присъдата през август 2024 г. Делата срещу останалите обвиняеми са прекратени поради давност.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://utroruse.com/article/1028811/\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://utroruse.com/article/1028811/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Утро Русе / БТА: ВКС потвърди условната присъда (09.08.2024)\"}]]}]]]}]]}]\n3b:[\"$\",\"li\",\"Анелия ЦветковаПодкуп (задържана при акция на ДАНС и прокуратурата през 2008 г.).\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-red text-white\",\"children\":\"Влязла в сила присъда\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Анелия Цветкова\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш председател на Административния съд – Варна\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Подкуп (задържана при акция на ДАНС и прокуратурата през 2008 г.).\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Окончателно осъдена: ВКС потвърди 3 години условно, глоба 10 000 лв. и забрана да заема съдийска длъжност за 3 години.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.novinite.com/articles/171202/Ex+Chair+of+Varna+Administrative+Court+Conclusively+Convicted+in+Bribery+Case\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.novinite.com/articles/171202/Ex+Chair+of+Varna+Administrative+Court+Conclusively+Convicted+in+Bribery+Case\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Novinite: окончателна присъда (07.10.2015)\"}]]}]]]}]]}]\n3c:[\"$\",\"li\",\"Атанас ВълковДокументни престъпления при реституционни претенции за два имота (2007–2011 г.).\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-red text-white\",\"children\":\"Влязла в сила присъда\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Атанас Вълков\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш председател на Административния съд – Бургас\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Документни престъпления при реституционни претенции за два имота (2007–2011 г.).\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Окончателно осъден: ВКС остави в сила 2,5 години условно и забрана да заема магистратска длъжност 5,5 години (първата инстанция беше дала 3,5 години ефективно).\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.capital.bg/kakvo_stava/2018/04/24/3168233_bivshiiat_shef_na_administrativen_sud_-_burgas/\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.capital.bg/kakvo_stava/2018/04/24/3168233_bivshiiat_shef_na_administrativen_sud_-_burgas/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Капитал: окончателна присъда (24.04.2018)\"}]]}]]]}]]}]\n3d:[\"$\",\"li\",\"Ценко ЧоковОтвличане, средна телесна повреда и палежи (делото е от 2017 г., заедно със сина му).\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-red text-white\",\"children\":\"Влязла в сила присъда\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Ценко Чоков\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш кмет на с. Галиче\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Отвличане, средна телесна повреда и палежи (делото е от 2017 г., заедно със сина му).\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Окончателно осъден: ВКС потвърди 5 години затвор, постановени от Апелативния специализиран съд; на сина бяха намалени от 7 на 5 години.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://utroruse.com/article/822130/\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://utroruse.com/article/822130/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Утро Русе / БТА (13.07.2022)\"}]]}]]]}]]}]\n3e:[\"$\",\"li\",\"Димитър АврамовТърговия с влияние, в съучастие.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#e08a2e] text-white\",\"children\":\"Осъден, присъдата не е окончателна\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":[\"$\",\"$L9\",null,{\"href\":\"/parlament/deputat/5169\",\"children\":\"Димитър Аврамов\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Народен представител от ДПС\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Търговия с влияние, в съучастие.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Апелативният съд в София го признава за виновен (октомври 2025), след като Софийският градски съд го е оправдал по тази част. Присъдата е обжалвана пред ВКС; прокуратурата иска сваляне на имунитета му в 52-рото Народно събрание.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://iustitia.bg/parlamenta-vneseno-iskane-svalyane-imuniteta-deputat-za/\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://iustitia.bg/parlamenta-vneseno-iskane-svalyane-imuniteta-deputat-za/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Iustitia: искане за сваляне на имунитета\"}]]}]]]}]]}]\n3f:[\"$\",\"li\",\"Благомир КоцевДело на Комисията за противодействие на корупцията (КПК) срещу него, двама общински съветници от ПП във Варна и бизнесмен.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Подсъдим\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Благомир Коцев\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Кмет на Варна\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Дело на Комисията за противодействие на корупцията (КПК) срещу него, двама общински съветници от ПП във Варна и бизнесмен.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Едно от само трите дела на КПК, стигнали до съда към края на 2025 г. Няма присъда.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://paragraf.bg/delata-na-antikoruptsionnata-komisiya-katastrofirat-v-sada-varnaha-18-hil-lv-na-deputata-ibryamov/\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://paragraf.bg/delata-na-antikoruptsionnata-komisiya-katastrofirat-v-sada-varnaha-18-hil-lv-na-deputata-ibryamov/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Paragraf: делата на КПК в съда\"}]]}]]]}]]}]\n40:[\"$\",\"li\",\"Нено ДимовУмишлена безстопанственост по време на водната криза в Перник през 2019 г.: според прокуратурата е позволил вода от язовир „Студена“ да се ползва за промишлеността, след като е знаел, че запасът намалява.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Подсъдим\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Нено Димов\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш министър на околната среда и водите (номиниран от „Обединени патриоти“)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Умишлена безстопанственост по време на водната криза в Перник през 2019 г.: според прокуратурата е позволил вода от язовир „Студена“ да се ползва за промишлеността, след като е знаел, че запасът намалява.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Подаде оставка на 10 януари 2020 г. Делото е в съда; през февруари 2026 г. съдът продължава да заседава. Няма присъда.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.rferl.org/a/bulgaria-prosecutors-charge-environmental-minister-dimov/30371411.html\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.rferl.org/a/bulgaria-prosecutors-charge-environmental-minister-dimov/30371411.html\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Свободна Европа: обвинението (2020)\"}]]}],[\"$\",\"span\",\"https://www.fakti.bg/en/bulgaria/1032739-the-court-is-sitting-again-in-the-case-of-former-minister-of-environment-neno-dimov\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://www.fakti.bg/en/bulgaria/1032739-the-court-is-sitting-again-in-the-case-of-former-minister-of-environment-neno-dimov\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Fakti: ново заседание по делото (06.02.2026)\"}]]}]]]}]]}]\n41:[\"$\",\"li\",\"Иван ПортнихИзмама с евросредства: според Европейската прокуратура заедно с бивш областен управител и двама служители на Морска администрация са подали неверни данни, за да получат 3,4 млн. € за реконструкция на рибарско пристанище край Варна, което по документите не е съществувало.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Подсъдим\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Иван Портних\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш кмет на Варна (ГЕРБ)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Измама с евросредства: според Европейската прокуратура заедно с бивш областен управител и двама служители на Морска администрация са подали неверни данни, за да получат 3,4 млн. € за реконструкция на рибарско пристанище край Варна, което по документите не е съществувало.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Европейската прокуратура внесе обвинителен акт в съда на 1 декември 2025 г. Щетата се оценява на около 2,8 млн. € за бюджета на ЕС и 675 475 € за националния бюджет. Няма присъда.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.eppo.europa.eu/en/media/news/bulgaria-former-mayor-and-ex-governor-varna-indicted-claiming-funds-non-existent-harbour\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.eppo.europa.eu/en/media/news/bulgaria-former-mayor-and-ex-governor-varna-indicted-claiming-funds-non-existent-harbour\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Европейска прокуратура: обвинителен акт (1.12.2025)\"}]]}],[\"$\",\"span\",\"https://bntnews.bg/news/european-prosecutor’s-office-brings-former-varna-mayor-ivan-portnih-to-court-1367629news.html\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://bntnews.bg/news/european-prosecutor’s-office-brings-former-varna-mayor-ivan-portnih-to-court-1367629news.html\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БНТ: Портних на съд\"}]]}]]]}]]}]\n42:[\"$\",\"li\",\"Панайот РейзиПрисвояване на 1 989 474 лв. от бюджета на общината в периода 2014–2017 г. чрез договори и фактури за неизвършени ремонти.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Подсъдим\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Панайот Рейзи\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш кмет на Созопол (избран от ГЕРБ; напуска партията през 2019 г.)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Присвояване на 1 989 474 лв. от бюджета на общината в периода 2014–2017 г. чрез договори и фактури за неизвършени ремонти.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Съдът го отстрани от длъжност през април 2019 г. Обвинителният акт е внесен през юли 2020 г. Не открихме публикувана присъда по наказателното дело. По отделно дело административният съд в Бургас го глоби 160 000 лв. за конфликт на интереси.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://bntnews.bg/news/mayor-of-sozopol-accused-of-misappropriation-of-nearly-bgn-2-million-1311928news.html\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://bntnews.bg/news/mayor-of-sozopol-accused-of-misappropriation-of-nearly-bgn-2-million-1311928news.html\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БНТ: обвинението\"}]]}],[\"$\",\"span\",\"https://www.capital.bg/politika_i_ikonomika/imena/2020/07/10/4088948_stroitel_na_kapitalizma_panaiot_reizi/\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://www.capital.bg/politika_i_ikonomika/imena/2020/07/10/4088948_stroitel_na_kapitalizma_panaiot_reizi/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Капитал: делото отива в съда (2020)\"}]]}],[\"$\",\"span\",\"https://www.bta.bg/en/news/355000-former-sozopol-mayor-fined-bgn-160-000-for-conflict-of-interestza-konflikt-na-in\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://www.bta.bg/en/news/355000-former-sozopol-mayor-fined-bgn-160-000-for-conflict-of-interestza-konflikt-na-in\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: глоба за конфликт на интереси\"}]]}]]]}]]}]\n43:[\"$\",\"li\",\"Стоян ПасевСъщото дело като срещу Иван Портних: неверни данни и документи за 3,4 млн. € евросредства за реконструкция на рибарско пристанище край Варна, което по документите не е съществувало.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Подсъдим\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Стоян Пасев\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш областен управител на Варна (ГЕРБ)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Същото дело като срещу Иван Портних: неверни данни и документи за 3,4 млн. € евросредства за реконструкция на рибарско пристанище край Варна, което по документите не е съществувало.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Европейската прокуратура внесе обвинителен акт на 1.12.2025 г. При осъдителна присъда грозят от 2 до 8 години затвор. Няма присъда.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.fakti.bg/en/krimi/1018261-evroprokuraturata-obvini-bivshia-kmet-na-varna-ivan-portnih-i-bivshia-oblasten-upravitel-stoan-pasev\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.fakti.bg/en/krimi/1018261-evroprokuraturata-obvini-bivshia-kmet-na-varna-ivan-portnih-i-bivshia-oblasten-upravitel-stoan-pasev\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Fakti: обвинени са Портних и Пасев\"}]]}],[\"$\",\"span\",\"https://www.eppo.europa.eu/en/media/news/bulgaria-former-mayor-and-ex-governor-varna-indicted-claiming-funds-non-existent-harbour\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://www.eppo.europa.eu/en/media/news/bulgaria-former-mayor-and-ex-governor-varna-indicted-claiming-funds-non-existent-harbour\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Европейска прокуратура (1.12.2025)\"}]]}]]]}]]}]\n44:[\"$\",\"li\",\"Димитър БръчковИзмама с евросредства по проекта „Културен дипол в трансграничния регион“ (програма Гърция–България): според обвинението е скрито, че се строи изцяло нова сграда, в нарушение на споразумението между партньорите. Кметът сам потвърди пред БТА, че обвинението е срещу него, и заяви, че не е притеснен.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Подсъдим\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Димитър Бръчков\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Кмет на община Петрич\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Измама с евросредства по проекта „Културен дипол в трансграничния регион“ (програма Гърция–България): според обвинението е скрито, че се строи изцяло нова сграда, в нарушение на споразумението между партньорите. Кметът сам потвърди пред БТА, че обвинението е срещу него, и заяви, че не е притеснен.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Обвинен през март 2025 г.; обвинителният акт е внесен в съда през октомври 2026 г. Няма присъда.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.bta.bg/bg/videos/26521\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.bta.bg/bg/videos/26521\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: кметът на Петрич за обвиненията\"}]]}],[\"$\",\"span\",\"https://www.eppo.europa.eu/en/media/news/bulgaria-mayor-petrich-accused-fraud-involving-cultural-heritage-museum\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://www.eppo.europa.eu/en/media/news/bulgaria-mayor-petrich-accused-fraud-involving-cultural-heritage-museum\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Европейска прокуратура: обвинението (25.03.2025)\"}]]}],[\"$\",\"span\",\"https://euagenda.eu/news/942478\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://euagenda.eu/news/942478\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"EUagenda / Novinite: обвинителният акт (10.2026)\"}]]}]]]}]]}]\n45:[\"$\",\"li\",\"Николай МалиновОбвинение от 2019 г. (повторено през 2021 г.) за шпионаж в полза на руски организации, свързани с Руския институт за стратегически изследвания.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Подсъдим\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Николай Малинов\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш депутат, лидер на движение „Русофили“\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Обвинение от 2019 г. (повторено през 2021 г.) за шпионаж в полза на руски организации, свързани с Руския институт за стратегически изследвания.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Софийският градски съд го оправда през май 2026 г. Присъдата не е окончателна и може да бъде протестирана от прокуратурата.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.fakti.bg/en/bulgaria/1054779-russophile-movement-leader-nikolay-malinov-acquitted-in-espionage-case\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.fakti.bg/en/bulgaria/1054779-russophile-movement-leader-nikolay-malinov-acquitted-in-espionage-case\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Fakti: оправдан по делото за шпионаж (16.05.2026)\"}]]}],[\"$\",\"span\",\"https://brusselssignal.eu/2026/05/bulgarian-court-clears-pro-russian-activist-of-spying/\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://brusselssignal.eu/2026/05/bulgarian-court-clears-pro-russian-activist-of-spying/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Brussels Signal / AFP (05.2026)\"}]]}]]]}]]}]\n46:[\"$\",\"li\",\"Иван ДемерджиевОбвинение за корупция: увеличение на цени по договор на МВР без одобрена методика, с щета около 758 000 € (1 482 218 лв.).\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Обвинен\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":[\"$\",\"$L9\",null,{\"href\":\"/parlament/deputat/3996\",\"children\":\"Иван Демерджиев\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш служебен министър на вътрешните работи\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Обвинение за корупция: увеличение на цени по договор на МВР без одобрена методика, с щета около 758 000 € (1 482 218 лв.).\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Мярка за неотклонение „гаранция“ 10 000 лв. Досъдебното производство е образувано на 16.01.2024 г.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://eurocom.bg/2025/04/25/prokuraturata-povdigna-obvinenie-za-koruptsiya-v-razmer-nad-1-mln-leva-sreshtu-demerdzhiev\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://eurocom.bg/2025/04/25/prokuraturata-povdigna-obvinenie-za-koruptsiya-v-razmer-nad-1-mln-leva-sreshtu-demerdzhiev\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Евроком: обвинение срещу Демерджиев\"}]]}]]]}]]}]\n47:[\"$\",\"li\",\"Джейхан ИбрямовОбвинение от Комисията за противодействие на корупцията; единственият депутат с официални обвинения от КПК.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Обвинен\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Джейхан Ибрямов\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Народен представител\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Обвинение от Комисията за противодействие на корупцията; единственият депутат с официални обвинения от КПК.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Съдът връща 18 000 лв., иззети при обиски. Няма присъда.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://paragraf.bg/delata-na-antikoruptsionnata-komisiya-katastrofirat-v-sada-varnaha-18-hil-lv-na-deputata-ibryamov/\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://paragraf.bg/delata-na-antikoruptsionnata-komisiya-katastrofirat-v-sada-varnaha-18-hil-lv-na-deputata-ibryamov/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Paragraf: върнаха пари на депутата Ибрямов\"}]]}]]]}]]}]\n48:[\"$\",\"li\",\"Васил БожковМножество обвинения, включително за подкупи на държавни служители. Санкциониран и от САЩ и Великобритания.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Обвинен\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Васил Божков\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бизнесмен, основател на партия „Българско лято“\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Множество обвинения, включително за подкупи на държавни служители. Санкциониран и от САЩ и Великобритания.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Към началото на 2026 г. няма присъда. Прокуратурата сочи липса на съдействие от ОАЕ за разпита му.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://boulevardbulgaria.bg/articles/magnitski-na-trupcheta-kakvo-stana-s-delata-sreshtu-ovcharov-goranov-bozhkov-i-peevski\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://boulevardbulgaria.bg/articles/magnitski-na-trupcheta-kakvo-stana-s-delata-sreshtu-ovcharov-goranov-bozhkov-i-peevski\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Булевард България: какво стана с делата (2026)\"}]]}]]]}]]}]\n49:[\"$\",\"li\",\"Никола БарбутовУчастие в организирана престъпна група за престъпления по служба и подкупи; обещаване и предлагане на подкуп на районни кметове („Люлин“ и „Младост“). Разследването е на Комисията за противодействие на корупцията.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Обвинен\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Никола Барбутов\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш заместник-кмет на Столична община (от „Продължаваме промяната“)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Участие в организирана престъпна група за престъпления по служба и подкупи; обещаване и предлагане на подкуп на районни кметове („Люлин“ и „Младост“). Разследването е на Комисията за противодействие на корупцията.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Обвинителният акт е внесен в съда през ноември 2025 г. През 2026 г. Софийският градски съд го върна на прокуратурата заради съществени процесуални нарушения (определението подлежи на протест). Мярката му е сменена на парична гаранция 5 000 €. Няма присъда.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://clubz.bg/163099\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://clubz.bg/163099\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Клуб Z: обвиненията (25.06.2025)\"}]]}],[\"$\",\"span\",\"https://www.bta.bg/bg/videos/35410\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://www.bta.bg/bg/videos/35410\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: съдът върна делото на прокуратурата\"}]]}]]]}]]}]\n4a:[\"$\",\"li\",\"Кирил ПетковОбвинение в принуда срещу бившия министър на електронното управление Александър Йоловски.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Обвинен\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Кирил Петков\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш министър-председател, бивш председател на „Продължаваме промяната“\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Обвинение в принуда срещу бившия министър на електронното управление Александър Йоловски.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Делото беше внесено в съда, но Софийският градски съд прекрати производството и върна обвинителния акт на прокуратурата за отстраняване на грешки (определението подлежи на жалба и протест). Няма присъда.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.bta.bg/bg/videos/36274\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.bta.bg/bg/videos/36274\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: съдът върна обвинителния акт срещу Петков и Божанов\"}]]}]]]}]]}]\n4b:[\"$\",\"li\",\"Божидар БожановОбвинение в престъпление по служба, свързано с обществена поръчка.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Обвинен\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":[\"$\",\"$L9\",null,{\"href\":\"/parlament/deputat/5229\",\"children\":\"Божидар Божанов\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш министър на електронното управление, съпредседател на „Да, България“\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Обвинение в престъпление по служба, свързано с обществена поръчка.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Софийският градски съд върна обвинителния акт на прокуратурата: според съда от него не става ясно в полза на кое дружество са действията, за които е обвинен. Определението подлежи на жалба и протест. Няма присъда.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.bta.bg/bg/videos/36274\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.bta.bg/bg/videos/36274\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: съдът върна обвинителния акт срещу Петков и Божанов\"}]]}]]]}]]}]\n4c:[\"$\",\"li\",\"Цветан Цветанов (кмет на Лом)Престъпление против политическите права на гражданите: според прокуратурата на 15 април 2026 г. е предложил по 50 € на служители на общинско предприятие, за да гласуват за определена коалиция и кандидат на изборите на 19 април 2026 г.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Обвинен\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Цветан Цветанов (кмет на Лом)\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Кмет на община Лом (избран през 2023 г. като кандидат на ГЕРБ)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Престъпление против политическите права на гражданите: според прокуратурата на 15 април 2026 г. е предложил по 50 € на служители на общинско предприятие, за да гласуват за определена коалиция и кандидат на изборите на 19 април 2026 г.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Обвинението е повдигнато от Окръжната прокуратура – Монтана (обявено на 12.05.2026). Няма присъда.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.bta.bg/en/news/bulgaria/1124499-lom-mayor-charged-with-vote-buying\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.bta.bg/en/news/bulgaria/1124499-lom-mayor-charged-with-vote-buying\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: кметът на Лом е обвинен в купуване на гласове\"}]]}]]]}]]}]\n4d:[\"$\",\"li\",\"Мюмюн ИскендерРазследване на Софийската градска прокуратура за четири случая в периода 2019–2025 г., сред които злоупотреба с имот на черковното настоятелство в с. Брястово.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Обвинен\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Мюмюн Искендер\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Кмет на община Минерални бани\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Разследване на Софийската градска прокуратура за четири случая в периода 2019–2025 г., сред които злоупотреба с имот на черковното настоятелство в с. Брястово.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"На 21.10.2025 г. Окръжният съд в Хасково го отстрани от длъжност по искане на прокуратурата. Няма присъда.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.bta.bg/bg/news/bulgaria/992267-sadat-v-haskovo-otstrani-kmeta-na-mineralni-bani-myumyun-iskender-ot-dlazhnost-z\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.bta.bg/bg/news/bulgaria/992267-sadat-v-haskovo-otstrani-kmeta-na-mineralni-bani-myumyun-iskender-ot-dlazhnost-z\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: съдът отстрани кмета от длъжност\"}]]}]]]}]]}]\n4e:[\"$\",\"li\",\"Бойко БорисовРазследване за пране на пари („Барселонагейт“): твърдения за имот в Барселона, купен през 2013 г. Разследването започва през 2020 г.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Разследването е прекратено\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":[\"$\",\"$L9\",null,{\"href\":\"/parlament/deputat/5186\",\"children\":\"Бойко Борисов\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Лидер на ГЕРБ, бивш министър-председател\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Разследване за пране на пари („Барселонагейт“): твърдения за имот в Барселона, купен през 2013 г. Разследването започва през 2020 г.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Софийската градска прокуратура прекратява делото поради липса на доказателства за престъпление.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://old-news.bnr.bg/en/post/101892954/money-laundering-case-against-former-pm-boyko-borissov-terminated\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://old-news.bnr.bg/en/post/101892954/money-laundering-case-against-former-pm-boyko-borissov-terminated\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БНР: Прекратено е делото за пране на пари срещу Бойко Борисов\"}]]}],[\"$\",\"span\",\"https://www.eurointegration.com.ua/news/2023/10/17/7171577/\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://www.eurointegration.com.ua/news/2023/10/17/7171577/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Европейска правда, 17.10.2023\"}]]}]]]}]]}]\n4f:[\"$\",\"li\",\"Бойко БорисовРазследване за изнудване по показания на Васил Божков (заедно с Владислав Горанов и Севделина Арнаудова).\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Разследването е прекратено\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":[\"$\",\"$L9\",null,{\"href\":\"/parlament/deputat/5186\",\"children\":\"Бойко Борисов\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Лидер на ГЕРБ, бивш министър-председател\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Разследване за изнудване по показания на Васил Божков (заедно с Владислав Горанов и Севделина Арнаудова).\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Софийската градска прокуратура прекратява разследването поради липса на доказателства.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://parliament140.bnr.bg/en/post/101921160/prosecutor-s-office-terminates-investigation-against-boyko-borissov-for-extortion\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://parliament140.bnr.bg/en/post/101921160/prosecutor-s-office-terminates-investigation-against-boyko-borissov-for-extortion\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БНР: Прокуратурата прекрати разследването срещу Бойко Борисов за изнудване\"}]]}]]]}]]}]\n50:[\"$\",\"li\",\"Иван ТотевОбвинение от януари 2017 г. за престъпление по служба при възлагането на строежа на зоокъта в Пловдив (според прокуратурата вреда около 1 млн. лв.).\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface\",\"children\":\"Разследването е прекратено\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Иван Тотев\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш кмет на Пловдив (ГЕРБ)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Обвинение от януари 2017 г. за престъпление по служба при възлагането на строежа на зоокъта в Пловдив (според прокуратурата вреда около 1 млн. лв.).\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Съдът два пъти върна делото на прокуратурата заради неясно обвинение (окончателно от апелативния съд, юли 2018 г.). В началото на 2021 г. прокуратурата прекрати производството. Няма присъда.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.capital.bg/kakvo_stava/2018/07/24/3286565_deloto_sreshtu_kmeta_na_plovdiv_ivan_totev_okochatelno/\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.capital.bg/kakvo_stava/2018/07/24/3286565_deloto_sreshtu_kmeta_na_plovdiv_ivan_totev_okochatelno/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Капитал: делото окончателно върнато на прокуратурата (2018)\"}]]}],[\"$\",\"span\",\"https://www.capital.bg/politika_i_ikonomika/pravo/2021/11/01/4272394_prokuraturata_tihomulkom_prekrati_deloto_sreshtu_ivan/\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://www.capital.bg/politika_i_ikonomika/pravo/2021/11/01/4272394_prokuraturata_tihomulkom_prekrati_deloto_sreshtu_ivan/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Капитал: прокуратурата прекрати делото (2021)\"}]]}]]]}]]}]\n51:[\"$\",\"li\",\"Вельо ИлиевОбвинение за престъпление по служба: непроведени процедури за обществени поръчки за доставка на лекарства за ветерани (2007–2011 г.).\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\",\"children\":\"Окончателно оправдан\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Вельо Илиев\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш кмет на Петрич\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Обвинение за престъпление по служба: непроведени процедури за обществени поръчки за доставка на лекарства за ветерани (2007–2011 г.).\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Върховният касационен съд го оправдава окончателно.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://utroruse.com/article/1007078/\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://utroruse.com/article/1007078/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Утро Русе: ВКС окончателно оправда бившия кмет на Петрич\"}]]}]]]}]]}]\n52:[\"$\",\"li\",\"Цветан ЦветановОбвинения, че като министър е осуетил разследване, като шест пъти е отказал да разпореди специални разузнавателни средства, и за изплащане на близо 50 000 лв. на бивш шеф на звеното срещу организираната престъпност във Велико Търново.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\",\"children\":\"Окончателно оправдан\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Цветан Цветанов\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш вицепремиер и министър на вътрешните работи от ГЕРБ\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Обвинения, че като министър е осуетил разследване, като шест пъти е отказал да разпореди специални разузнавателни средства, и за изплащане на близо 50 000 лв. на бивш шеф на звеното срещу организираната престъпност във Велико Търново.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Двете по-долни инстанции първо го осъдиха на 4 години затвор, но след ново разглеждане беше оправдан. Върховният касационен съд потвърди окончателно оправдателните присъди и по двете дела.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://bta.bg/en/news/158360-Supreme-Court-Acquits-Ex-Interior-Minister-Tsvetanov-in-Surveillance-Refusal-Cas\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://bta.bg/en/news/158360-Supreme-Court-Acquits-Ex-Interior-Minister-Tsvetanov-in-Surveillance-Refusal-Cas\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: ВКС потвърждава оправдаването (отказ на СРС)\"}]]}],[\"$\",\"span\",\"https://www.bta.bg/en/news/164197-Supreme-Court-of-Cassation-Upholds-Former-Interior-Minister-Tsvetanov-s-Acquitta\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://www.bta.bg/en/news/164197-Supreme-Court-of-Cassation-Upholds-Former-Interior-Minister-Tsvetanov-s-Acquitta\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: ВКС потвърждава оправдаването (присвояване)\"}]]}]]]}]]}]\n53:[\"$\",\"li\",\"Николай НенчевДве обвинения от ноември 2016 г. за престъпления по служба: ремонтът на изтребителите МиГ-29 в Полша и поръчката за униформи на военните.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\",\"children\":\"Окончателно оправдан\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Николай Ненчев\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш министър на отбраната (БЗНС, Реформаторски блок)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Две обвинения от ноември 2016 г. за престъпления по служба: ремонтът на изтребителите МиГ-29 в Полша и поръчката за униформи на военните.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Окончателно оправдан и по двете дела от Върховния касационен съд: за униформите през април 2018 г., за ремонта на МиГ-овете след пет години и половина разследване и съдебни дела.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.capital.bg/kakvo_stava/2018/04/25/3169155_nikolai_nenchev_okonchatelno_opravdan_po_edno_ot/\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.capital.bg/kakvo_stava/2018/04/25/3169155_nikolai_nenchev_okonchatelno_opravdan_po_edno_ot/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Капитал: окончателно оправдан за униформите (2018)\"}]]}],[\"$\",\"span\",\"https://bnr.bg/en/post/101465481/mig-fighter-aircraft-court-saga-ends-with-not-guilty-verdict\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://bnr.bg/en/post/101465481/mig-fighter-aircraft-court-saga-ends-with-not-guilty-verdict\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БНР: окончателно оправдан за МиГ-29\"}]]}]]]}]]}]\n54:[\"$\",\"li\",\"Николай ЦоневОбвинение, че чрез посредник е предложил подкуп от 20 000 евро на следовател, за да бъде спряно разследване срещу него за поръчка на МО за 120 млн. лв. Отделно обвинение за поръчката на оптичния кабел „Странджа-2“.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\",\"children\":\"Окончателно оправдан\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Николай Цонев\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш министър на отбраната (правителство „Станишев“)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Обвинение, че чрез посредник е предложил подкуп от 20 000 евро на следовател, за да бъде спряно разследване срещу него за поръчка на МО за 120 млн. лв. Отделно обвинение за поръчката на оптичния кабел „Странджа-2“.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Оправдан окончателно от Върховния касационен съд по делото за подкуп (3.2.2015). По делото за кабела е оправдан през октомври 2012 г.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.bta.bg/en/news/180168-Ex-Defence-Minister-Judge-Former-Finance-Ministry-Official-Conclusively-Acquit\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.bta.bg/en/news/180168-Ex-Defence-Minister-Judge-Former-Finance-Ministry-Official-Conclusively-Acquit\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: окончателно оправдан по делото за подкуп\"}]]}],[\"$\",\"span\",\"https://www.occrp.org/en/daily/3637-bulgaria-former-defense-minister-acquitted-in-bribery-case\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://www.occrp.org/en/daily/3637-bulgaria-former-defense-minister-acquitted-in-bribery-case\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"OCCRP: оправдан и по делото за кабела\"}]]}]]]}]]}]\n55:[\"$\",\"li\",\"Христо БисеровУкриване на данъци в особено големи размери, недекларирани валутни преводи и невярна декларация пред Сметната палата (недекларирани влогове в швейцарска банка). Отделно разследване за пране на пари.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\",\"children\":\"Окончателно оправдан\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Христо Бисеров\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш заместник-председател на Народното събрание и на ДПС\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Укриване на данъци в особено големи размери, недекларирани валутни преводи и невярна декларация пред Сметната палата (недекларирани влогове в швейцарска банка). Отделно разследване за пране на пари.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Оправдан и от трите инстанции по трите обвинения; Върховният касационен съд потвърждава окончателно. Делото за пране на пари е закрито от съда през февруари 2016 г., след като прокуратурата не го довършва.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.bta.bg/en/news/136252-Hristo-Bisserov-Acquitted-by-Final-Court-of-Appeal\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.bta.bg/en/news/136252-Hristo-Bisserov-Acquitted-by-Final-Court-of-Appeal\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: окончателно оправдан от ВКС\"}]]}],[\"$\",\"span\",\"https://www.occrp.org/ru/novosti/bolgariia-s-byvsego-vice-spikera-parlamenta-sniaty-obvineniia-v-otmyvanii-deneg\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://www.occrp.org/ru/novosti/bolgariia-s-byvsego-vice-spikera-parlamenta-sniaty-obvineniia-v-otmyvanii-deneg\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"OCCRP: закрито делото за пране на пари (2016)\"}]]}]]]}]]}]\n56:[\"$\",\"li\",\"Симеон ДянковОбвинение от 2017 г. за престъпление по служба при продажбата през 2011 г. на остатъчния държавен дял от 33% в ЕВН (според обвинението на занижена цена, с вреда около 20 млн. лв.).\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\",\"children\":\"Окончателно оправдан\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Симеон Дянков\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш вицепремиер и министър на финансите (ГЕРБ, 2009–2013)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Обвинение от 2017 г. за престъпление по служба при продажбата през 2011 г. на остатъчния държавен дял от 33% в ЕВН (според обвинението на занижена цена, с вреда около 20 млн. лв.).\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Оправдан от Специализирания наказателен съд (юни 2020 г.); апелативният съд потвърди през април 2021 г., прокуратурата не обжалва и оправдаването влезе в сила през май 2021 г.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://bnt.bg/bg/a/businessman-prokopiev-former-ministers-djankov-traikov-acquitted-in-evn-case\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://bnt.bg/bg/a/businessman-prokopiev-former-ministers-djankov-traikov-acquitted-in-evn-case\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БНТ: оправдани на първа инстанция (28.06.2020)\"}]]}],[\"$\",\"span\",\"https://seenews.com/news/bulgarias-alfa-finance-says-court-upholds-acquittal-of-owner-ex-ministers-in-evn-unit-sale-case-738498\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://seenews.com/news/bulgarias-alfa-finance-says-court-upholds-acquittal-of-owner-ex-ministers-in-evn-unit-sale-case-738498\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"SeeNews: апелативният съд потвърди оправдаването (04.2021)\"}]]}],[\"$\",\"span\",\"https://seenews.com/news/acquittal-of-all-defendants-in-sale-of-33-in-evn-bulgaria-takes-effect-alfa-finance-740701\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://seenews.com/news/acquittal-of-all-defendants-in-sale-of-33-in-evn-bulgaria-takes-effect-alfa-finance-740701\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"SeeNews: оправдаването влезе в сила (05.2021)\"}]]}]]]}]]}]\n57:[\"$\",\"li\",\"Трайчо ТрайковОбвинение от 2017 г. за безстопанственост при продажбата през 2011 г. на държавния дял от 33% в ЕВН.\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\",\"children\":\"Окончателно оправдан\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Трайчо Трайков\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш министър на икономиката, енергетиката и туризма (2009–2012)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Обвинение от 2017 г. за безстопанственост при продажбата през 2011 г. на държавния дял от 33% в ЕВН.\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Оправдан на две инстанции; оправдаването влезе в сила през май 2021 г., след като прокуратурата не го обжалва.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://bnt.bg/bg/a/businessman-prokopiev-former-ministers-djankov-traikov-acquitted-in-evn-case\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://bnt.bg/bg/a/businessman-prokopiev-former-ministers-djankov-traikov-acquitted-in-evn-case\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БНТ: оправдани на първа инстанция (28.06.2020)\"}]]}],[\"$\",\"span\",\"https://seenews.com/news/bulgarias-alfa-finance-says-court-upholds-acquittal-of-owner-ex-ministers-in-evn-unit-sale-case-738498\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://seenews.com/news/bulgarias-alfa-finance-says-court-upholds-acquittal-of-owner-ex-ministers-in-evn-unit-sale-case-738498\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"SeeNews: апелативният съд потвърди оправдаването (04.2021)\"}]]}],[\"$\",\"span\",\"https://seenews.com/news/acquittal-of-all-defendants-in-sale-of-33-in-evn-bulgaria-takes-effect-alfa-finance-740701\",{\"children\":[\"; \",[\"$\",\"a\",null,{\"href\":\"https://seenews.com/news/acquittal-of-all-defendants-in-sale-of-33-in-evn-bulgaria-takes-effect-alfa-finance-740701\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"SeeNews: оправдаването влезе в сила (05.2021)\"}]]}]]]}]]}]\n58:[\"$\",\"li\",\"Емилия МаслароваОбвинение от 2010 г. за присвояване при т.нар. „златен ремонт“ на Центъра за комплексни социални услуги в Стара Загора (над 11 млн. лв.).\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\",\"children\":\"Окончателно оправдан\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Емилия Масларова\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш министър на труда и социалната политика (БСП)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Обвинение от 2010 г. за присвояване при т.нар. „златен ремонт“ на Центъра за комплексни социални услуги в Стара Загора (над 11 млн. лв.).\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Софийският градски съд оправда всички подсъдими в края на 2015 г.; делото приключи окончателно след 11 години. През 2024 г. съдът осъди прокуратурата да ѝ плати 70 000 лв. обезщетение.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://fakti.bg/en/bulgaria/921965-bivshiat-socialen-ministar-emilia-maslarova-osadi-prokuraturata-za-70-000-lv\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://fakti.bg/en/bulgaria/921965-bivshiat-socialen-ministar-emilia-maslarova-osadi-prokuraturata-za-70-000-lv\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Fakti: обезщетение от прокуратурата (22.10.2024)\"}]]}]]]}]]}]\n59:[\"$\",\"li\",\"Христо АнгеличинОбвинения в безстопанственост: покупка на телефонни централи за 12 посолства; отделно дело за самолетните билети на министерството (заедно с бившия министър Даниел Митов).\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\",\"children\":\"Окончателно оправдан\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":\"Христо Ангеличин\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш заместник-министър на външните работи\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Обвинения в безстопанственост: покупка на телефонни централи за 12 посолства; отделно дело за самолетните билети на министерството (заедно с бившия министър Даниел Митов).\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Окончателно оправдан и по двете дела: за билетите в началото на 2020 г., за централите – от ВКС през септември 2020 г. (съдът приема, че деянието не е престъпление). През 2021 г. заведе иск срещу прокуратурата.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://news.lex.bg/%D0%B1%D0%B8%D0%B2%D1%88%D0%B8%D1%8F%D1%82-%D0%B7%D0%B0%D0%BC-%D0%B2%D1%8A%D0%BD%D1%88%D0%B5%D0%BD-%D0%BC%D0%B8%D0%BD%D0%B8%D1%81%D1%82%D1%8A%D1%80-%D1%85%D1%80%D0%B8%D1%81%D1%82%D0%BE-%D0%B0%D0%BD-4/\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://news.lex.bg/%D0%B1%D0%B8%D0%B2%D1%88%D0%B8%D1%8F%D1%82-%D0%B7%D0%B0%D0%BC-%D0%B2%D1%8A%D0%BD%D1%88%D0%B5%D0%BD-%D0%BC%D0%B8%D0%BD%D0%B8%D1%81%D1%82%D1%8A%D1%80-%D1%85%D1%80%D0%B8%D1%81%D1%82%D0%BE-%D0%B0%D0%BD-4/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Lex.bg: Ангеличин съди прокуратурата (02.03.2021)\"}]]}]]]}]]}]\n5a:[\"$\",\"li\",\"Даниел МитовОбвинение за злоупотреба с доверие при поръчката на самолетни билети за министерството (заедно със заместника му Христо Ангеличин).\",{\"className\":\"ring-1 ring-rule rounded-sm p-5 bg-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#2f9e6a] text-white\",\"children\":\"Окончателно оправдан\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold text-lg mt-2\",\"children\":[\"$\",\"$L9\",null,{\"href\":\"/parlament/deputat/5284\",\"children\":\"Даниел Митов\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Бивш министър на външните работи\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Обвинение за злоупотреба с доверие при поръчката на самолетни билети за министерството (заедно със заместника му Христо Ангеличин).\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-1\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Докъде е стигнало:\"}],\" \",\"Окончателно оправдан: ВКС остави в сила оправдателната присъда на апелативния спецсъд и прие, че министърът изобщо не може да носи отговорност по този текст.\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://news.lex.bg/%D0%B1%D0%B8%D0%B2%D1%88%D0%B8%D1%8F%D1%82-%D0%B2%D1%8A%D0%BD%D1%88%D0%B5%D0%BD-%D0%BC%D0%B8%D0%BD%D0%B8%D1%81%D1%82%D1%8A%D1%80-%D0%B4%D0%B0%D0%BD%D0%B8%D0%B5%D0%BB-%D0%BC%D0%B8%D1%82%D0%BE%D0%B2/\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://news.lex.bg/%D0%B1%D0%B8%D0%B2%D1%88%D0%B8%D1%8F%D1%82-%D0%B2%D1%8A%D0%BD%D1%88%D0%B5%D0%BD-%D0%BC%D0%B8%D0%BD%D0%B8%D1%81%D1%82%D1%8A%D1%80-%D0%B4%D0%B0%D0%BD%D0%B8%D0%B5%D0%BB-%D0%BC%D0%B8%D1%82%D0%BE%D0%B2/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Lex.b