ont-semibold text-[#b08436]\",\"children\":\"Въздържал се\"}]]}]\n41:[\"$\",\"tr\",\"grazhdanski-protsesualen-kodeks\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/grazhdanski-protsesualen-kodeks\",\"children\":\"Граждански процесуален кодекс (защита срещу „SLAPP“ дела)\"}],[\"$\",\"span\",null,{\"className\":\"block text-sm text-muted\",\"children\":[\"Законът въвежда европейската директива срещу т.нар\",\".\"]}]]}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}]]}]\n42:[\"$\",\"tr\",\"chastnata-ohranitelna-deynost\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/chastnata-ohranitelna-deynost\",\"children\":\"Закон за частната охранителна дейност\"}],[\"$\",\"span\",null,{\"className\":\"block text-sm text-muted\",\"children\":[\"Законът изравнява таксите за лицензи на български охранителни фирми и фирми от ЕС, обединява „охрана на недвижими имоти“ и „охрана на селскостопанско имущество“ в общата „охрана на имущество“, позволява фирма да възлага лична охрана на свой служител при реална заплаха, актуализира сумите при превоз на ценни пратки и отменя изискването трудовият договор на охранителя да е основен (за охрана на заведения, сезонни обекти и събития)\",\".\"]}]]}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}]]}]\n43:[\"$\",\"tr\",\"darzhavniya-sluzhitel\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/darzhavniya-sluzhitel\",\"children\":\"Закон за държавния служител (проверки за почтеност)\"}],[\"$\",\"span\",null,{\"className\":\"block text-sm text-muted\",\"children\":[\"Законът въвежда проверки на почтеността на служителите на длъжности с висок корупционен риск в централната власт: преди назначаване, при повишение на по-висока ръководна длъжност и след проверка на инспекторат\",\".\"]}]]}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}]]}]\n44:[\"$\",\"tr\",\"vissheto-obrazovanie\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/vissheto-obrazovanie\",\"children\":\"Закон за висшето образование (такси за платено обучение и стипендии)\"}],[\"$\",\"span\",null,{\"className\":\"block text-sm text-muted\",\"children\":[\"Минималната такса за студентите в платено обучение пада от 60 на 50% от издръжката на обучение в направлението (плюс таксата за държавна поръчка), а за целия срок на обучение таксата на един студент не може да се увеличи с повече от 20% спрямо първата година\",\".\"]}]]}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-[#b08436]\",\"children\":\"Въздържал се\"}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}]]}]\n45:[\"$\",\"tr\",\"darzhavniya-dalg\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/darzhavniya-dalg\",\"children\":\"Закон за държавния дълг (облигации за граждани и правила на еврозоната)\"}],[\"$\",\"span\",null,{\"className\":\"block text-sm text-muted\",\"children\":[\"Законът привежда правилата за държавния дълг в съответствие с еврозоната: всички нови държавни ценни книжа над е