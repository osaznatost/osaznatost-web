\\\",\\\"$Lb\\\",null,{\\\"href\\\":\\\"/parlament/zakon/kibersigurnost\\\",\\\"children\\\":\\\"Закон за киберсигурност (ограничаване на технологии) — отхвърлен проект на „Възраждане“\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"block text-sm text-muted\\\",\\\"children\\\":[\\\"Проектът предлагаше ограниченията за използване на определени технологии (напр\\\",\\\".\\\"]}]]}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-red\\\",\\\"children\\\":\\\"Против\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold \\\",\\\"children\\\":\\\"–\\\"}]]}]\\n65:[\\\"$\\\",\\\"tr\\\",\\\"kodeks-za-sotsialno-osiguryavane\\\",{\\\"className\\\":\\\"border-b border-rule align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2 pr-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lb\\\",null,{\\\"href\\\":\\\"/parlament/zakon/kodeks-za-sotsialno-osiguryavane\\\",\\\"children\\\":\\\"Кодекс за социално осигуряване (държавните служители да плащат осигуровки) — отхвърлени проекти\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"block text-sm text-muted\\\",\\\"children\\\":[\\\"Проектът предлагаше за шест години държавните служители и служителите в съдебната власт постепенно да започнат да плащат лична част от осигурителните си вноски, както служителите по трудов договор\\\",\\\".\\\"]}]]}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold \\\",\\\"children\\\":\\\"–\\\"}]]}]\\n66:[\\\"$\\\",\\\"tr\\\",\\\"balgarskiya-ezik\\\",{\\\"className\\\":\\\"border-b border-rule align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2 pr-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lb\\\",null,{\\\"href\\\":\\\"/parlament/zakon/balgarskiya-ezik\\\",\\\"children\\\":\\\"Закон за българския език (нов закон)\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"block text-sm text-muted\\\",\\\"children\\\":[\\\"Новият закон урежда ползването на книжовния български език в институциите, образованието, медиите и публичното пространство и създава Консултативен съвет за българския език: той събира годишни доклади от институциите, прави годишен доклад до Министерския съвет и парламента, предлага препоръки за правилата на книжовния език и дава становища по учебните планове и учебниците\\\",\\\".\\\"]}]]}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold \\\",\\\"children\\\":\\\"–\\\"}]]}]\\n67:[\\\"$\\\",\\\"tr\\\",\\\"podpomagane-na-zemedelskite-proizvoditeli\\\",{\\\"className\\\":\\\"border-b border-rule align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2 pr-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lb\\\",null,{\\\"href\\\":\\\"/parlament/zakon/podpomagane-na-zemedelskite-proizvoditeli\\\",\\\"children\\\":\\\"Закон за подпомагане на земеделските производители (Взаимоспомагателен фонд, Copa-Cogeca, оранжерии)\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"block text-sm text-muted\\\",\\\"children\\\":[\\\"Държавен фонд „Земеделие“ може да изплаща обезщетения от Взаимоспомагателен фонд при неблагоприятни климатични явления и болести по растенията и животните; средствата идват от публично финансиране и от непотърсени от правоимащите суми по Закона за земеделските земи след 10 години\\\",\\\".\\\"]}]]}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}]]}]\\n68:[\\\"$\\\",\\\"tr\\\",\\\"nezavisimiya-finansov-odit-i-izrazyavaneto-na-sigurnost-po-ustoychivostta\\\",{\\\"className\\\":\\\"border-b border-rule align-top\\\",\\\"ch