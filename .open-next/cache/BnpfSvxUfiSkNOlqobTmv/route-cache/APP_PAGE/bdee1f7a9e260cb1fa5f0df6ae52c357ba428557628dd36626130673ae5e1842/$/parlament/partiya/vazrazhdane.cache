-2 py-2 font-semibold text-red\",\"children\":\"Против\"}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}]]}]\n47:[\"$\",\"tr\",\"elektronnata-identifikatsiya\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/elektronnata-identifikatsiya\",\"children\":\"Закон за електронната идентификация (безплатна е-идентичност)\"}],[\"$\",\"span\",null,{\"className\":\"block text-sm text-muted\",\"children\":[\"Отпадат таксите за издаване на удостоверение за електронна идентичност и за проверката ѝ, когато услугата е от държавни органи или организации с обществени услуги\",\".\"]}]]}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-red\",\"children\":\"Против\"}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}]]}]\n48:[\"$\",\"tr\",\"ministerstvoto-na-vatreshnite-raboti\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/ministerstvoto-na-vatreshnite-raboti\",\"children\":\"Закон за МВР (терористично съдържание онлайн и европейски бази данни)\"}],[\"$\",\"span\",null,{\"className\":\"block text-sm text-muted\",\"children\":[\"Законът определя орган, който може да нарежда на доставчици на хостинг услуги да премахнат или блокират терористично съдържание онлайн, да следи мерките им и да ги санкционира, по европейския регламент 2021/784\",\".\"]}]]}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}]]}]\n49:[\"$\",\"tr\",\"danak-varhu-dobavenata-stoynost\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$L