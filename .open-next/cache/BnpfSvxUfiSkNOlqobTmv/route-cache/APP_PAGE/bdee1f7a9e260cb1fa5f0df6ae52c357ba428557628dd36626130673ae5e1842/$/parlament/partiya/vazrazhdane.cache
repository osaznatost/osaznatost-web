der-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/darzhavnata-finansova-inspektsiya\",\"children\":\"Закон за държавната финансова инспекция (глобите в евро)\"}],[\"$\",\"span\",null,{\"className\":\"block text-sm text-muted\",\"children\":[\"Технически закон след въвеждането на еврото: глобите и имуществените санкции, които налага Агенцията за държавна финансова инспекция (АДФИ) за нарушения на бюджетната и финансовата дисциплина, и сумите при пълна имуществена отговорност се определят в евро.\",\".\"]}]]}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-red\",\"children\":\"Против\"}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-red\",\"children\":\"Против\"}]]}]\n75:[\"$\",\"tr\",\"byudzheta-na-darzhavnoto-obshtestveno-osiguryavane-za-2026-g-i-zakona-za-byudzheta-na-natsionalnata-zdravnoosiguritelna-kasa-za-2026-g\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/byudzheta-na-darzhavnoto-obshtestveno-osiguryavane-za-2026-g-i-zakona-za-byudzheta-na-natsionalnata-zdravnoosiguritelna-kasa-za-2026-g\",\"children\":\"Удължителният закон за бюджета 2026 (нов дълг до приемането на бюджета)\"}],[\"$\",\"span\",null,{\"className\":\"block text-sm text-muted\",\"children\":[\"Докато няма приет бюджет за 2026 г., държавата работи по „удължителен закон“\",\".\"]}]]}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-red\",\"children\":\"Против\"}]]}]\n76:[\"$\",\"tr\",\"korporativnoto-podohodno-oblagane\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/korporativnoto-podohodno-oblagane\"