property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Евросредства и политици · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/ikonomika/evrosredstva\">← <!-- -->Европейски средства</a></p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Евросредства и политици</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Кои депутати (настоящи и бивши) са свързани с фирми и организации, получили европейски пари, каква е връзката, и кои случаи са описани от разследващи журналисти. Връзката е повод за въпрос, а не доказателство за нарушение.</div></div></div><section class=\"grid gap-4 sm:grid-cols-3 mb-12\"><div class=\"bg-surface rounded-sm p-4\"><p class=\"text-sm text-muted\">Депутати с връзка</p><p class=\"display num text-[1.75rem] sm:text-[2.4rem] leading-none mt-1 break-words\">155</p><p class=\"text-xs text-muted\">настоящи и бивши, по Търговския регистър и декларациите</p></div><div class=\"bg-surface rounded-sm p-4\"><p class=\"text-sm text-muted\">Бенефициенти</p><p class=\"display num text-[1.75rem] sm:text-[2.4rem] leading-none mt-1 break-words\">173</p><p class=\"text-xs text-muted\">фирми, общински дружества, организации</p></div><div class=\"bg-surface rounded-sm p-4\"><p class=\"text-sm text-muted\">С лично участие</p><p class=\"display num text-[1.75rem] sm:text-[2.4rem] leading-none mt-1 break-words\">82</p><p class=\"text-xs text-muted\">депутатът има дял или е собственик на частна фирма</p></div></section><section id=\"sluchai\" class=\"mb-14 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Случаи, разкрити от журналисти</h2></div><p class=\"text-[15px] text-muted -mt-3 mb-2 max-w-3xl\">Мярка „<!-- -->Restore — изграждане на нови мощности за съхранение на електрическа енергия<!-- -->“ (<!-- -->Национален план за възстановяване и устойчивост (НПВУ)<!-- -->): два кръга, общо около 1,15 млрд. лв. за батерии за съхранение на ток. Мярката е под внимание, защото много от одобрените фирми водят до политици, бивши министри и известни бизнесмени. Официалният списък на одобрените е на <a href=\"https://www.me.government.bg/news/82-proekta-na-obshta-stoinost-pochti-1-150-mlrd-lv-shte-badat-finansirani-po-restore-3640.html\" target=\"_blank\" rel=\"noreferrer\">сайта на Министерството на енергетиката</a>.</p><p class=\"text-[15px] text-muted mb-4 max-w-3xl\">Всеки случай е проверен срещу регистъра ИСУН: сумата, описана в медията, съвпада със сумата в регистъра. Това потвърждава, че фирмата е получила договор. Дали има нарушение, решават контролните органи и съдът.</p><ul class=\"grid gap-4 lg:grid-cols-2\"><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"text-sm text-muted\">НПВУ — RESTORE<!-- --> · RESTORE 1</p><p class=\"font-semibold text-lg mt-1\"><span><a href=\"/porachki/firma/203635576\">ВМ Петролеум ООД</a></span></p><p class=\"text-[15px] mt-1\"><b>Кой стои зад нея:</b> <!-- -->Веска Марешка — майка на бившия депутат и лидер на „Воля“ Веселин Марешки</p><p class=\"text-[15px] mt-2\">Фамилната компания на Марешки — исторически в горивата и аптеките — влиза в съхранението на електроенергия през списъка с одобрени проекти по RESTORE.</p><p class=\"text-[15px] mt-2 num\">Договорени: <b>35,5 млн. €</b> · изплатени: <!-- -->0 €</p><p class=\"text-sm mt-2 bg-surface rounded-sm px-3 py-2\"><b>Проверка в регистъра:</b> <!-- -->Регистърът ИСУН показва 69 409 118 лв договорени средства — точно сумата на докладваните 25 389 855,36 лв безвъзмездна помощ и 44 019 262,64 лв собствено съфинансиране.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.mediapool.bg/maikata-na-mareshki-i-sinat-na-dzhevdet-chakarov-sred-odobrenite-112-za-baterii-za-tok-s-evrosubsidii-news370517.html\" target=\"_blank\" rel=\"noreferrer\">Mediapool<!-- -->: <!-- -->Майката на Марешки и синът на Джевдет Чакъров сред одобрените 112 за батерии за ток с евросубсидии</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"text-sm text-muted\">НПВУ — RESTORE<!-- --> · RESTORE 1</p><p class=\"font-semibold text-lg mt-1\"><span><a href=\"/porachki/firma/206934480\">Верила солар парк 2 ООД</a></span></p><p class=\"text-[15px] mt-1\"><b>Кой стои зад нея:</b> <!-- -->Сами Джевдет Чакъров — син на дългогодишния депутат от ДПС Джевдет Чакъров</p><p class=\"text-[15px] mt-2\">Дружество, контролирано от сина на Джевдет Чакъров, сред одобрените проекти за батерии. Името се появява в публикациите и като „Верила Солар Парк 3“ — регистърът потвърждава ЕИК 206934480.</p><p class=\"text-[15px] mt-2 num\">Договорени: <b>65,7 млн. €</b> · изплатени: <!-- -->0 €</p><p class=\"text-sm mt-2 bg-surface rounded-sm px-3 py-2\"><b>Проверка в регистъра:</b> <!-- -->Регистърът ИСУН показва 128 500 142 лв договорени средства — точно сумата на докладваните 41 120 045,44 лв БФП и 87 380 096,56 лв съфинансиране.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.actualno.com/company/milionite-ot-es-za-bateriite-na-tok-poznati-interesni-imena-gi-vzemat-news_2436764.html\" target=\"_blank\" rel=\"noreferrer\">Actualno<!-- -->: <!-- -->Милионите от ЕС за батериите на ток: Познати интересни имена ги вземат</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"text-sm text-muted\">НПВУ — RESTORE<!-- --> · RESTORE 1</p><p class=\"font-semibold text-lg mt-1\"><span><a href=\"/porachki/firma/207274721\">Токи сторидж ЕАД</a></span></p><p class=\"text-[15px] mt-1\"><b>Кой стои зад нея:</b> <!-- -->Свързвано с издателя Иво Прокопиев</p><p class=\"text-[15px] mt-2\">Компания, свързвана с Иво Прокопиев, сред одобрените по RESTORE с няколко проекта за батерии.</p><p class=\"text-[15px] mt-2 num\">Договорени: <b>41 млн. €</b> · изплатени: <!-- -->0 €</p><p class=\"text-sm mt-2 bg-surface rounded-sm px-3 py-2\"><b>Проверка в регистъра:</b> <!-- -->Регистърът ИСУН показва 7 договора на обща стойност 80 156 856 лв за ТОКИ СТОРИДЖ ЕАД — съответства на описанието за серия от проекти за батерии под един бенефициент.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.actualno.com/company/milionite-ot-es-za-bateriite-na-tok-poznati-interesni-imena-gi-vzemat-news_2436764.html\" target=\"_blank\" rel=\"noreferrer\">Actualno<!-- -->: <!-- -->Милионите от ЕС за батериите на ток: Познати интересни имена ги вземат</a></span><span>; <a href=\"https://blitz.bg/obshtestvo/skandal-ivo-prokopiev-i-chakrov-mladshi-pribrali-milioni-ot-es_news1080166.html\" target=\"_blank\" rel=\"noreferrer\">Blitz<!-- -->: <!-- -->Скандал! Иво Прокопиев и Чакъров-младши прибрали милиони от ЕС</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"text-sm text-muted\">НПВУ — RESTORE<!-- --> · RESTORE 1</p><p class=\"font-semibold text-lg mt-1\"><span><a href=\"/porachki/firma/208031284\">МЛД Батери парк ООД</a></span></p><p class=\"text-[15px] mt-1\"><b>Кой стои зад нея:</b> <!-- -->Младен Маринов-младши — син на бившия вътрешен министър и депутат от ГЕРБ Младен Маринов</p><p class=\"text-[15px] mt-2\">Дружеството е учредено през октомври 2024 г.; младият му собственик става имотен милионер за месеци, малко след одобрението по RESTORE.</p><p class=\"text-[15px] mt-2 num\">Договорени: <b>20,9 млн. €</b> · изплатени: <!-- -->0 €</p><p class=\"text-sm mt-2 bg-surface rounded-sm px-3 py-2\"><b>Проверка в регистъра:</b> <!-- -->Регистърът ИСУН показва 40 779 740 лв договорени средства — точно сумата на докладваните 15 496 301,20 лв БФП и 25 283 438,80 лв съфинансиране.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://bird.bg/gerb-marinov-millionaires/\" target=\"_blank\" rel=\"noreferrer\">BIRD.bg<!-- -->: <!-- -->Синът на бивш министър от ГЕРБ сред новите милионери от батериите</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"text-sm text-muted\">НПВУ — RESTORE<!-- --> · RESTORE 1</p><p class=\"font-semibold text-lg mt-1\"><span><a href=\"/porachki/firma/207958783\">Адванс грийн енерджи АД</a></span></p><p class=\"text-[15px] mt-1\"><b>Кой стои зад нея:</b> <!-- -->Георги Домусчиев (управление); компанията се свързва с групата на братя Домусчиеви</p><p class=\"text-[15px] mt-2\">Изгражда най-голямото локално съоръжение за съхранение на електроенергия в ЕС (индустриален парк „Балкан“, Ловеч). Единственият случай в списъка с реално изплатени средства.</p><p class=\"text-[15px] mt-2 num\">Договорени: <b>75 млн. €</b> · изплатени: <!-- -->29,5 млн. €</p><p class=\"text-sm mt-2 bg-surface rounded-sm px-3 py-2\"><b>Проверка в регистъра:</b> <!-- -->Регистърът ИСУН показва 146 688 223 лв договорени средства — точно сумата на докладваните 57 795 160,02 лв БФП и 88 893 063,37 лв съфинансиране. Изплатени са вече 57 774 947 лв (≈ безвъзмездната помощ).</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.actualno.com/economy/advans-grijn-enerdji-ad-predstavja-naj-goljamoto-lokalno-syoryjenie-za-syhranenie-na-elektroenergija-v-es-news_2495911.html\" target=\"_blank\" rel=\"noreferrer\">Actualno<!-- -->: <!-- -->„Адванс Грийн Енерджи“ АД представя най-голямото локално съоръжение за съхранение на електроенергия в ЕС</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"text-sm text-muted\">НПВУ — RESTORE<!-- --> · RESTORE 2</p><p class=\"font-semibold text-lg mt-1\"><span><a href=\"/porachki/firma/208411297\">Со Сторидж ЕООД</a></span></p><p class=\"text-[15px] mt-1\"><b>Кой стои зад нея:</b> <!-- -->Чрез „АБФА Инвестмънтс“ — на бившия финансов министър Милен Велчев и брат му Георги Велчев</p><p class=\"text-[15px] mt-2\">Класирано по RESTORE 2 през декември 2025 г.; докладваната безвъзмездна помощ е 17,5 млн лв.</p><p class=\"text-[15px] mt-2 num\">Договорени: <b>54 млн. €</b> · изплатени: <!-- -->0 €</p><p class=\"text-sm mt-2 bg-surface rounded-sm px-3 py-2\"><b>Проверка в регистъра:</b> <!-- -->Регистърът ИСУН показва 105 544 905 лв договорени средства — съответства на докладваната обща стойност на проекта „над 105 млн лв“.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.24chasa.bg/biznes/article/22047579\" target=\"_blank\" rel=\"noreferrer\">24chasa<!-- -->: <!-- -->Новите бенефициенти по RESTORE 2</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"text-sm text-muted\">НПВУ — RESTORE<!-- --> · RESTORE 2</p><p class=\"font-semibold text-lg mt-1\"><span><a href=\"/porachki/firma/208397285\">Болкан Пауър Систем ЕООД</a></span></p><p class=\"text-[15px] mt-1\"><b>Кой стои зад нея:</b> <!-- -->Чрез „Грийн Солар енерджи“ — свързвано с Драгомир Танев</p><p class=\"text-[15px] mt-2\">Класирано по RESTORE 2; докладваната БФП е 17,5 млн лв.</p><p class=\"text-[15px] mt-2 num\">Договорени: <b>43,1 млн. €</b> · изплатени: <!-- -->0 €</p><p class=\"text-sm mt-2 bg-surface rounded-sm px-3 py-2\"><b>Проверка в регистъра:</b> <!-- -->Регистърът ИСУН показва 84 213 189 лв договорени средства — съответства на докладваната обща стойност на проекта около 84 млн лв.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.capital.bg/biznes/energetika/2025/12/22/4866013_novi_4000_mvtch_baterii_za_11_mlrd_lv_po_restore_2_koi/\" target=\"_blank\" rel=\"noreferrer\">Capital<!-- -->: <!-- -->Нови 4000 MWh батерии за 1,1 млрд лв по RESTORE 2 — кои печелят</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"text-sm text-muted\">НПВУ — RESTORE<!-- --> · RESTORE 2</p><p class=\"font-semibold text-lg mt-1\"><span><a href=\"/porachki/firma/208348135\">Адванс Диджитал Пауър АД</a></span></p><p class=\"text-[15px] mt-1\"><b>Кой стои зад нея:</b> <!-- -->Свързвано с групата на братя Домусчиеви</p><p class=\"text-[15px] mt-2\">Втора компания от кръга на Домусчиеви в списъка — с поредица от проекти за батерии по RESTORE 2.</p><p class=\"text-[15px] mt-2 num\">Договорени: <b>27,6 млн. €</b> · изплатени: <!-- -->0 €</p><p class=\"text-sm mt-2 bg-surface rounded-sm px-3 py-2\"><b>Проверка в регистъра:</b> <!-- -->Регистърът ИСУН показва 5 договора на обща стойност 53 898 819 лв — съответства на описанието за серия от проекти за батерии на дружеството.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.capital.bg/biznes/energetika/2025/12/22/4866013_novi_4000_mvtch_baterii_za_11_mlrd_lv_po_restore_2_koi/\" target=\"_blank\" rel=\"noreferrer\">Capital<!-- -->: <!-- -->Нови 4000 MWh батерии за 1,1 млрд лв по RESTORE 2 — кои печелят</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"text-sm text-muted\">НПВУ — RESTORE<!-- --> · RESTORE 1</p><p class=\"font-semibold text-lg mt-1\"><span><a href=\"/porachki/firma/207930595\">Крита енерджи 50 АД</a></span></p><p class=\"text-[15px] mt-1\"><b>Кой стои зад нея:</b> <!-- -->Даниел Гергов и Тенчо Лилянов — хасковски бизнес партньори на депутата от ГЕРБ Делян Добрев</p><p class=\"text-[15px] mt-2\">Хасковска компания; собствениците са описани като бизнес партньори на председателя на енергийната комисия в парламента Делян Добрев.</p><p class=\"text-[15px] mt-2 num\">Договорени: <b>69,5 млн. €</b> · изплатени: <!-- -->0 €</p><p class=\"text-sm mt-2 bg-surface rounded-sm px-3 py-2\"><b>Проверка в регистъра:</b> <!-- -->Регистърът ИСУН показва 135 920 171 лв договорени средства за КРИТА ЕНЕРДЖИ 50 АД — докладваната БФП от ≈58,45 млн лв плюс собствено съфинансиране е в този порядък.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://aferahs.com/българия/хасковските-партньори-на-делян-добре/\" target=\"_blank\" rel=\"noreferrer\">Aferahs<!-- -->: <!-- -->Хасковските партньори на Делян Добрев — Даниел Гергов и Тенчо Лилянов — се сдобиха с 58,45 милиона за батерии за ток</a></span><span>; <a href=\"https://www.mediapool.bg/bivshi-ministri-s-haskovska-zhilka-v-udaren-biznes-s-baterii-za-tok-news377895.html\" target=\"_blank\" rel=\"noreferrer\">Mediapool<!-- -->: <!-- -->Бивши министри с хасковска жилка в ударен бизнес с батерии за ток</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-5 bg-white\"><p class=\"text-sm text-muted\">НПВУ — RESTORE<!-- --> · RESTORE 2</p><p class=\"font-semibold text-lg mt-1\"><span><a href=\"/porachki/firma/208376227\">„Криводол Енерджи Парк“ ЕООД</a></span><span>, <a href=\"/porachki/firma/208376273\">„Криводол Сторидж Парк“ ЕООД</a></span><span>, <a href=\"/porachki/firma/208336574\">„Полски Тръмбеш Сторидж Сълюшън“ ЕООД</a></span><span>, <a href=\"/porachki/firma/208336492\">„Полски Тръмбеш Балансинг Систем“ ЕООД</a></span></p><p class=\"text-[15px] mt-1\"><b>Кой стои зад нея:</b> <!-- -->Велин Кънчев Филипов — одитор и данъчен консултант; в публикациите — „непознатият“ зад клъстер от еднотипни дружества</p><p class=\"text-[15px] mt-2\">Клъстер от еднотипни дружества, всяко кандидатствало за отделна субсидия по RESTORE 2 — описано като раздробяване, за да остане всеки проект под прага. Регистърът потвърждава четири от тях.</p><p class=\"text-[15px] mt-2 num\">Договорени: <b>21,1 млн. €</b> · изплатени: <!-- -->0 €</p><p class=\"text-sm mt-2 bg-surface rounded-sm px-3 py-2\"><b>Проверка в регистъра:</b> <!-- -->Регистърът ИСУН потвърждава четири от дружествата на клъстера — всяко с по един договор за ≈10,3 млн лв (общо 41 193 692 лв) — съответства на описанието за серия от еднотипни проекти за батерии.</p><p class=\"text-sm mt-2\">Източници: <span><a href=\"https://www.24chasa.bg/biznes/article/22047579\" target=\"_blank\" rel=\"noreferrer\">24chasa<!-- -->: <!-- -->Новите бенефициенти по RESTORE 2</a></span></p></li></ul></section><section class=\"mb-14\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Всички депутати с връзка</h2></div><p class=\"text-[15px] text-muted -mt-3 mb-4 max-w-3xl\">Първо са тези с лично участие в частни фирми (дял, собственост, съдружие). След тях са служебните роли: управител на държавна фирма, член на борд на общинско дружество, на читалище или на сдружение. Служебните роли по правило не носят личен интерес.</p><ul class=\"space-y-3\"><li class=\"ring-1 rounded-sm p-4 bg-white ring-red\"><p class=\"font-semibold\"><a href=\"https://www.parliament.bg/bg/MP/3067\">Минко Велчев Ангелов</a> <span class=\"text-xs font-semibold text-white bg-red rounded-full px-2 py-0.5 ml-1\">лично участие</span> <span class=\"text-sm text-muted font-normal\">· <!-- -->55 млн. €<!-- --> договорени</span></p><ul class=\"text-[15px] mt-1 space-y-0.5\"><li><a href=\"/porachki/firma/831160078\">&quot;Напоителни системи&quot; ЕАД</a> <span class=\"text-muted\">— <!-- -->управител<!-- --> · <!-- -->24<!-- --> договора, <!-- -->55 млн. €<!-- -->, изплатени <!-- -->49,5 млн. €</span></li><li><a href=\"/porachki/firma/836163459\">Компютър консулт ЕООД</a> <span class=\"text-muted\">— <!-- -->управител, едноличен собственик, дялово участие (в миналото)<!-- --> · <!-- -->1<!-- --> договора, <!-- -->5113 €<!-- -->, изплатени <!-- -->5113 €</span></li></ul></li><li class=\"ring-1 rounded-sm p-4 bg-white ring-red\"><p class=\"font-semibold\"><a href=\"https://www.parliament.bg/bg/MP/3845\">Владимир Славев Табутов</a> <span class=\"text-xs font-semibold text-white bg-red rounded-full px-2 py-0.5 ml-1\">лично участие</span> <span class=\"text-sm text-muted font-normal\">· <!-- -->10,8 млн. €<!-- --> договорени</span></p><ul class=\"text-[15px] mt-1 space-y-0.5\"><li><a href=\"/porachki/firma/202162424\">ХЕК Солар ЕООД</a> <span class=\"text-muted\">— <!-- -->дялово участие (в миналото)<!-- --> · <!-- -->1<!-- --> договора, <!-- -->10,8 млн. €<!-- -->, изплатени <!-- -->0 €</span></li></ul></li><li class=\"ring-1 rounded-sm p-4 bg-white ring-red\"><p class=\"font-semibold\"><a href=\"https://www.parliament.bg/bg/MP/3427\">Петко Ангелов Кущирев</a> <span class=\"text-xs font-semibold text-white bg-red rounded-full px-2 py-0.5 ml-1\">лично участие</span> <span class=\"text-sm text-muted font-normal\">· <!-- -->7,1 млн. €<!-- --> договорени</span></p><ul class=\"text-[15px] mt-1 space-y-0.5\"><li><a href=\"/porachki/firma/200712697\">ПАК Дизайн ЕООД</a> <span class=\"text-muted\">— <!-- -->управител, съдружник, едноличен собственик<!-- --> · <!-- -->12<!-- --> договора, <!-- -->7 млн. €<!-- -->, изплатени <!-- -->1,9 млн. €</span></li><li><a href=\"/porachki/firma