sName\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167606\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за регионалното развитие\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-602-01-53\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",false,false,false,false,false,null]}]]}]]}],false]]}],\"$undefined\",\"$L1f\",\"$undefined\",\"$L20\",\"$L21\"]}]\n1b:[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}]\n1c:[\"$\",\"dd\",null,{\"children\":[\"20 октомври 2026 г.\",\" от \",\"Министерския съвет\",false]}]\n1d:[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по регионална политика, благоустройство и местно самоуправление (водеща)\"}]]\n1e:[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Становища\"}],[\"$\",\"dd\",null,{\"children\":\"кмета на Столична община; НСОРБ по ЗИД на ЗРР\"}]]\n1f:[\"$\",\"section\",null,{\"id\":\"argumenti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Двете страни: какво казват документите\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Обобщение от редактор още няма. По-долу са дословни цитати от докладите на комисиите, мотивите и стенограмите, подредени автоматично по правила: какво се предлага, кой какво каза и какви възражения има.\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 max-w-4xl\",\"children\":[[\"$\",\"div\",\"167606\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167606\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за регионалното развитие\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-602-01-53\"]}]]}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"С проектозакона се цели осигуряване на съответствие на националното законодателство с новата класификация NUTS, въведена с Делегиран регламент (ЕС) 2026/195 на Комисията от 13 ноември 2025 г. за изменение на Регламент (ЕО) № 1059/2003 на Европейския парламент и на Съвета по отношение на класификацията NUTS и списъците на съществуващите административни единици и местните административни единици, във връзка с настъпилите промени в броя и териториалния обхват на единиците от ниво 1 и 2.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Въз основа на натрупания опит се предвижда усъвършенстване на съдържанието на стратегическите документи на регионално и на общинско ниво.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Във връзка с новото райониране се предвижда намаляване броя на регионалните съвети за развитие от шест на четири и съответните организационни промени.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"За Столичния регион за планиране от ниво 2 се въвежда специален подход, обусловен от съвпадането на функции на столица, община и регион за планиране, при който планът за интегрирано развитие на общината изпълнява и функциите на интегрирана териториална стратегия за развитие за региона.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Двата закона уреждат различни, но взаимосвързани политики, поради което е необходимо актуализиране на нормативните връзки с цел по-ясно разграничаване на предметния обхват и осигуряване на съгласуваност между системата за стратегическо планиране на регионалното и пространственото развитие и устройственото планиране.\",\"“\"]}],[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"Възразява и настоява да отпаднат регулациите предвиждащи мерки, само и единствено спрямо кметовете на общини, за неизпълнение на предвидени в законопроекта техни задължения.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167606\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#8a8f8c] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Позиции, изказани в комисията\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[\"$L22\"]}],\"$L23\"]}],\"$L24\",false,\"$L25\"]}]]}]]}]]}]\n20:[\"$\",\"section\",null,{\"id\":\"grupi\",\"className\":\"mb-12 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb-5\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] sm:text-[2.4rem]\",\"children\":\"Как гласуваха групите по този закон\"}],\"$undefined\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mb-3\",\"children\":[\"Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо \",3,\". Прието: \",3,\", отхвърлено: \",0,\".\"]}],[\"$\",