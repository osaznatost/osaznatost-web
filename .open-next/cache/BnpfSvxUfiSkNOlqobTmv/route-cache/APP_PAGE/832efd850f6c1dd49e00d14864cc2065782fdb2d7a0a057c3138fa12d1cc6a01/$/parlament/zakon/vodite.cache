hildren\\\":[\\\"№ \\\",\\\"52-654-01-170\\\"]}]]}],[\\\"$\\\",\\\"details\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer font-semibold text-green mt-2\\\",\\\"children\\\":\\\"Покажи цитатите\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-5 mt-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-green pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Какво предлага законопроектът\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"Законопроектът има за цел усъвършенстване на нормативната уредба чрез намаляване на административната тежест, оптимизиране на разрешителните и съгласувателни режими, повишаване на правната сигурност и ускоряване на административните производства, без да се допуска намаляване на нивото на защита на водите и околната среда.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"Бяха зададени въпроси и във връзка с предвижданите административни реформи в РИОСВ.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[\\\"„\\\",\\\"Той заяви, че предлаганите изменения и допълнения в Закона за водите са насочени към намаляване на административната тежест, оптимизиране на разрешителните и съгласувателните режими и повишаване на правната сигурност и ефективността на административните производства.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[\\\"„\\\",\\\"С предложенията се предвижда отпадане на изисквания, които водят до излишни финансови разходи за заявителите, без да подобряват качеството на административния контрол, както и цифровизация на процесите по предоставяне и обработване на информация чрез разширяване на електронния обмен на данни.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"children\\\":[\\\"„\\\",\\\"ВНОСИТЕЛИ: Стефан Саврлен Зеро 8 ра ЗАМ ко 4 / с.г + евк ае да ПРЕДВАРИТЕЛНА ОЦЕНКА НА ВЪЗДЕЙСТВИЕТО към проекта на Закон за изменение и допълнение на Закона за водите Основания на законодателната инициатива Законодателната инициатива е обусловена от необходимостта от едновременно повишаване на ефективността на управлението на водите и намаляване на административната тежест при запазване на установените \\u003e скологични, здравни и технически изисквания.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"5\\\",{\\\"children\\\":[\\\"„\\\",\\\"Практиката показва процедури, при които документалната и финансовата тежест е несъразмерна на конкретния риск, както и необходимост от по-бързо административно действие при недостиг на вода.\\\",\\\"“\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted mt-1\\\",\\\"children\\\":[\\\"Източник: \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167621\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":\\\"доклад на комисията и мотиви, parliament.bg\\\"}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-[#8a8f8c] pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Позиции, изказани в комисията\\\"}],\\\"$L32\\\",\\\"$L33\\\"]}],\\\"$L34\\\",false,\\\"$L35\\\"]}]]}]]}],\\\"$L36\\\",\\\"$L37\\\"]}]]}]\\n22:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"mnenie\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Твоето мнение\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":[\\\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \\\",[\\\"$\\\