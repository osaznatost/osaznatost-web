{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/zakon/layout,_N_T_/parlament/zakon/[slug]/layout,_N_T_/parlament/zakon/[slug]/page,_N_T_/parlament/zakon/darzhavnata-finansova-inspektsiya"},"segmentPaths":["/_tree","/_full","/parlament/zakon/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/832efd850f6c1dd49e00d14864cc2065782fdb2d7a0a057c3138fa12d1cc6a01/$/parlament/zakon/darzhavnata-finansova-inspektsiya","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/zakon/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0vn96-fhbu77m.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><script src=\"/_next/static/chunks/43gzry38n6x69.js\" async=\"\"></script><title>Закон за държавната финансова инспекция · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Закон за държавната финансова инспекция · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Закон за държавната финансова инспекция · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Парламент</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Закон</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Закон за държавната финансова инспекция</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Приет на първо и второ четене в един ден — 21.05.2026 г., обнародван в ДВ, бр. 50/2026</div></div></div><nav aria-label=\"Секции на страницата\" class=\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\"><ul class=\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\"><li><a href=\"#nakratko\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Накратко</a></li><li><a href=\"#signali\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Сигнали (2)</a></li><li><a href=\"#zakonoproekti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Кой внесе и кой се изказа</a></li><li><a href=\"#argumenti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Двете страни</a></li><li><a href=\"#mnenie\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Твоето мнение</a></li><li><a href=\"#grupi\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Как гласуваха</a></li><li><a href=\"#glasuvaniya\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Гласувания (5)</a></li></ul></nav><section id=\"nakratko\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Накратко</h2><div class=\"max-w-4xl\"><p class=\"text-[17px]\">Технически закон след въвеждането на еврото: глобите и имуществените санкции, които налага Агенцията за държавна финансова инспекция (АДФИ) за нарушения на бюджетната и финансовата дисциплина, и сумите при пълна имуществена отговорност се определят в евро.</p><p class=\"mt-3 text-[15px]\"><b>Вносители:</b> <!-- -->Министерският съвет<!-- --> · <a href=\"https://www.parliament.bg/bg/bills/ID/166968\" target=\"_blank\" rel=\"noreferrer\">законопроект <!-- -->52-602-01-4</a></p><p class=\"mt-3 text-[15px]\"><b>Какво се случи:</b> <!-- -->Приет на първо и второ четене в едно заседание (153 и 167 „за“, 9–10 „против“).</p></div></section><section id=\"signali\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Сигнали</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.</p><ul class=\"grid gap-3 md:grid-cols-2 max-w-5xl\"><li class=\"border-l-4 rounded-sm p-4 border-red bg-[#fdeff1]\"><p class=\"font-semibold\">Двете четения в един ден</p><p class=\"text-[15px] text-muted mt-1\">Законът е приет на първо и второ четене в едно заседание. Няма срок за предложения и за обсъждане в комисия между четенията. Понякога е оправдано (спешни или технически промени), но намалява контрола.</p></li><li class=\"border-l-4 rounded-sm p-4 border-rule bg-surface\"><p class=\"font-semibold\">Няма публикувани становища</p><p class=\"text-[15px] text-muted mt-1\">На сайта на парламента няма становища на външни организации (браншове, синдикати, институции) по този законопроект.</p></li></ul><p class=\"text-sm mt-3\"><a href=\"/parlament/signali\">Всички сигнали в парламента</a></p><p class=\"text-xs text-muted mt-2\">Сигналът е повод за въпрос, не доказателство за нарушение.<!-- --> <a class=\"underline\" href=\"/metodologiya#signal\">Как работим със сигналите</a></p></section><section id=\"zakonoproekti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Кой внесе и кой се изказа</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.</p><ul class=\"space-y-4 max-w-5xl\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/166968\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение на Закона за държавната финансова инспекция</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-602-01-4</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>4 май 2026 г.<!-- --> от <!-- -->Министерския съвет</dd><dt class=\"text-muted\">Комисии</dt><dd>Временна комисия по бюджет и финанси (водеща)</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11128\" target=\"_blank\" rel=\"noreferrer\">21 май 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span><span>, <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11128\" target=\"_blank\" rel=\"noreferrer\">21 май 2026 г.</a> (<!-- -->зала второ гласуване<!-- -->)</span></dd><dt class=\"text-muted\">Обнародван</dt><dd>ДВ, бр. 50/2026<!-- -->, приет на 21 май 2026 г.</dd></dl></li></ul></section><div id=\"argumenti\" class=\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\"><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Министерството на финансите</p><p class=\"text-[15px]\">Законът трябва да е в евро; не се очаква финансово въздействие.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/166968\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-4, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Отворен въпрос</p><p class=\"text-[15px]\">Двете четения в един ден не оставят срок за предложения; от доклада не става ясно дали сумите са превалутирани по курса или едно към едно.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/166968\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-4, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://www.parliament.bg/bg/bills/ID/166968\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-602-01-4, доклади и становища</a></li><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания, Народно събрание (чрез „Наясно“)</a></li></ol><p class=\"text-xs text-muted mt-2\">Обобщението е по доклада на бюджетната комисия.<!-- --> Проверено: <!-- -->19 ноември 2026 г.</p></div></div><section id=\"dokumenti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Още от документите</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.</p><div class=\"space-y-4 max-w-4xl\"><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/166968\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение на Закона за държавната финансова инспекция</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-602-01-4</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->С оглед адаптирането на действащия Закон за държавната финансова инспекция към новата парична единица, със законопроекта се предвиждат изменения относно възстановяването на вредата, причинена при пълна имуществена отговорност, както и се определят в евро стойностите на глобите и имуществените санкции, налагани от директора на Агенцията за държавна финансова инспекция (АДФИ) при установяване на административни нарушения на бюджетната, финансово-стопанската и отчетническата дейност в подконтролните обекти.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/166968\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->При проведеното гласуване се получиха следните резултати: „За”- 19 гласа (от които 12 от ПГ“Прогресивна България“, 2 от ПГ „ГЕРБ-СДС“, 2 от „Движение за права и свободи - ДПС“; 1 от ПГ „Продължаваме промяната“ и 2 гласа от ПГ „Демократична България“) „Против”- 0 гласа и „Въздържали се“ – 1 глас от ПГ „ВЪЗРАЖДАНЕ“.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/166968\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div></div></details></div></div></section><section id=\"mnenie\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Твоето мнение</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. <a href=\"/mnenie\">Всички закони за гласуване</a>.</p><div class=\"bg-surface rounded-sm p-5 text-[15px] text-muted\">Зарежда се…</div></section><section id=\"grupi\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласуваха групите по този закон</h2></div><p class=\"text-sm text-muted mb-3\">Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо <!-- -->5<!-- -->. Прието: <!-- -->5<!-- -->, отхвърлено: <!-- -->0<!-- -->.</p><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Прогресивна България</p><p class=\"num text-sm mt-1\">За: <b>5</b> · Против: <b>0</b> · общо <!-- -->5</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ГЕРБ – СДС</p><p class=\"num text-sm mt-1\">За: <b>5</b> · Против: <b>0</b> · общо <!-- -->5</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Демократична България</p><p class=\"num text-sm mt-1\">За: <b>5</b> · Против: <b>0</b> · общо <!-- -->5</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ДПС</p><p class=\"num text-sm mt-1\">За: <b>5</b> · Против: <b>0</b> · общо <!-- -->5</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Продължаваме промяната</p><p class=\"num text-sm mt-1\">За: <b>5</b> · Против: <b>0</b> · общо <!-- -->5</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Възраждане</p><p class=\"num text-sm mt-1\">За: <b>0</b> · Против: <b>5</b> · общо <!-- -->5</p></div></div><p class=\"text-sm mt-3\">Първо четене: <a href=\"/parlament/glasuvane/2026-05-21-3\">21 май 2026 г.</a></p></section><section id=\"glasuvaniya\" class=\"scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Всички гласувания по закона</h2></div><ul><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-05-21-2\">ЗИ на Закона за държавната финансова инспекция – първо гласуване - процедура за допускане в зала</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">21 май 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-05-21-3\">ЗИ на Закона за държавната финансова инспекция – първо гласуване</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">21 май 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-05-21-4\">ЗИ на Закона за държавната финансова инспекция – първо гласуване - процедура за второ гласуване</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">21 май 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-05-21-5\">ЗИ на Закона за държавната финансова инспекция – второ гласуване - наименование</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">21 май 2026 г.<!-- --> · <!-- -->Второ четене: наименование<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-05-21-6\">ЗИ на Закона за държавната финансова инспекция – второ гласуване - параграф 1 до параграф 5</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">21 май 2026 г.<!-- --> · <!-- -->Второ четене: текст на закона<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Против</p></li></ul></section></div><!--$--><!--/$--></main><!--$--><!--/$--><footer class=\"bg-surface border-t border-rule mt-20\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 text-sm text-muted grid gap-2 sm:grid-cols-2\"><p>Не подкрепяме партия, кандидат или правителство. Всяко число има източник и дата.<!-- --> <a href=\"/metodologiya\">Как работим</a> · <a href=\"/rechnik\">Речник</a> · <a href=\"/sastoyanie\">Състояние на данните</a> · <!--$?--><t