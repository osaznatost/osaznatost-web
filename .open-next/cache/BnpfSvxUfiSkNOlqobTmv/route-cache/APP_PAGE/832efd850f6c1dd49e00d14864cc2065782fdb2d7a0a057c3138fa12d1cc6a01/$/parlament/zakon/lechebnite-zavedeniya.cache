{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/zakon/layout,_N_T_/parlament/zakon/[slug]/layout,_N_T_/parlament/zakon/[slug]/page,_N_T_/parlament/zakon/lechebnite-zavedeniya"},"segmentPaths":["/_tree","/_full","/parlament/zakon/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/832efd850f6c1dd49e00d14864cc2065782fdb2d7a0a057c3138fa12d1cc6a01/$/parlament/zakon/lechebnite-zavedeniya","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/zakon/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0vn96-fhbu77m.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><script src=\"/_next/static/chunks/43gzry38n6x69.js\" async=\"\"></script><title>Закон за лечебните заведения · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Закон за лечебните заведения · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Закон за лечебните заведения · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Парламент</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Закон</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Закон за лечебните заведения</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Отхвърлен на първо четене на 07.10.2026 г.</div></div></div><nav aria-label=\"Секции на страницата\" class=\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\"><ul class=\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\"><li><a href=\"#nakratko\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Накратко</a></li><li><a href=\"#signali\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Сигнали (1)</a></li><li><a href=\"#zakonoproekti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Кой внесе и кой се изказа</a></li><li><a href=\"#argumenti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Двете страни</a></li><li><a href=\"#mnenie\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Твоето мнение</a></li><li><a href=\"#grupi\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Как гласуваха</a></li><li><a href=\"#glasuvaniya\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Гласувания (1)</a></li></ul></nav><section id=\"nakratko\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Накратко</h2><div class=\"max-w-4xl\"><p class=\"text-[17px]\">Проектът на „Възраждане“ предлагаше основната заплата на лекарите без специалност да е поне 150% от средната брутна заплата в страната, а на медицинските сестри, акушерките и помощник-фармацевтите — 140%, с контрол от Главната инспекция по труда. Проектът на ПП също се отнасяше до възнагражденията в болниците.</p><p class=\"mt-3 text-[15px]\"><b>Вносители:</b> <!-- -->Костадин Костадинов, Георги Георгиев и др. („Възраждане“); отделен проект на Ивайло Шотев, Асен Василев и др. (ПП)<!-- --> · <a href=\"https://www.parliament.bg/bg/bills/ID/166982\" target=\"_blank\" rel=\"noreferrer\">законопроект <!-- -->52-654-01-27</a></p><p class=\"mt-3 text-[15px]\"><b>Какво се случи:</b> <!-- -->Отхвърлен на първо четене (60 „за“, 4 „против“, 116 въздържали се — „Прогресивна България“ се въздържа, всички останали групи подкрепиха). В социалната комисия: 4 „за“ (ГЕРБ–СДС, „Възраждане“, ПП), 14 въздържали се (12 от ПБ и 2 от ДБ).</p></div></section><section id=\"signali\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Сигнали</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.</p><ul class=\"grid gap-3 md:grid-cols-2 max-w-5xl\"><li class=\"border-l-4 rounded-sm p-4 border-rule bg-surface\"><p class=\"font-semibold\">Внесен от депутати</p><p class=\"text-[15px] text-muted mt-1\">Законопроектите на депутати не минават през задължителното 30-дневно обществено обсъждане на strategy.bg, както тези на Министерския съвет, и често нямат подробна оценка на въздействието.</p></li></ul><p class=\"text-sm mt-3\"><a href=\"/parlament/signali\">Всички сигнали в парламента</a></p><p class=\"text-xs text-muted mt-2\">Сигналът е повод за въпрос, не доказателство за нарушение.<!-- --> <a class=\"underline\" href=\"/metodologiya#signal\">Как работим със сигналите</a></p></section><section id=\"zakonoproekti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Кой внесе и кой се изказа</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.</p><ul class=\"space-y-4 max-w-5xl\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/166982\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за лечебните заведения</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-27</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>7 май 2026 г.<!-- --> от <!-- -->Костадин Костадинов, Георги Георгиев, Кръстьо Врачев и още 4 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по здравеопазването (водеща); Комисия по бюджет и финанси (участваща); Комисия по труда, демографската и социалната политика (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>МТСП- Вх.№ КТДСП-52-603-14-2; БЗС; МТСП; БСЛАФ; БФС; НСОМБАЛ; ББА; БАПЗГ; НСОРБ; СОББ; БЛС; БСК</dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/166951\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закон за лечебните заведения</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-13</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>30 април 2026 г.<!-- --> от <!-- -->Ивайло Шотев, Асен Василев, Бойко Рашков и още 13 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по здравеопазването (водеща); Комисия по бюджет и финанси (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>БЗС; БСЛАФ; БФС; НСОМБАЛ; ББА; МТСП; БАПЗГ; НСОРБ; СОББ; БЛС; БСК; ИАМН</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11183\" target=\"_blank\" rel=\"noreferrer\">7 октомври 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li></ul></section><div id=\"argumenti\" class=\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\"><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Георги Георгиев („Възраждане“)</p><p class=\"text-[15px]\">Конкурентни заплати ще задържат младите лекари в България и ще намалят недостига на медицински сестри.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/166982\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-27, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Съсловните организации и синдикатите (в здравната комисия)</p><p class=\"text-[15px]\">Темата се обсъжда повече от година без решение; голяма част от медиците са в пенсионна възраст, а младите заминават; липсват конкретни финансови разчети.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/166982\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-27, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">„Прогресивна България“</p><p class=\"text-[15px]\">Въздържаха се и не подкрепиха проекта.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/166982\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-27, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a><a href=\"https://www.parliament.bg/bg/bills/ID/166951\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-13, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Двете страни на монетата</h3><p class=\"text-sm text-muted mb-3\">Какво следва на практика, ако законът се приеме и ако се отхвърли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/166982\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-27, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\"><p class=\"font-semibold\">Ако се приеме</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">По-високи заплати и по-малко емиграция на медици.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Разходи без финансова обосновка; рискове за бюджета на болниците.</li></ul></div></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\"><p class=\"font-semibold\">Ако се отхвърли</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Без неосигурени разходи.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Недостигът на кадри остава без законово решение.</li></ul></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Какво печели и какво губи всяка страна</h3><p class=\"text-sm text-muted mb-3\">Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.</p><div class=\"space-y-3\"><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Млади лекари и медицински сестри<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/166982\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-27, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Ако беше приет — законов минимум на заплатата.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">—</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Болниците и НЗОК<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/166982\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-27, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Значително по-високи разходи без посочен източник.</p></div></div></div></div></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://www.parliament.bg/bg/bills/ID/166982\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-654-01-27, доклади и становища</a></li><li><a href=\"https://www.parliament.bg/bg/bills/ID/166951\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-654-01-13, доклади и становища</a></li><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания, Народно събрание (чрез „Наясно“)</a></li></ol><p class=\"text-xs text-muted mt-2\">Обобщението е по докладите на здравната и социалната комисия.<!-- --> Проверено: <!-- -->19 ноември 2026 г.</p></div></div><section id=\"dokumenti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Още от документите</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.</p><div class=\"space-y-4 max-w-4xl\"><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/166982\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за лечебните заведения</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-27</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Предвижда се основното възнаграждение на лекарите, лекарите по дентална медицина и фармацевтите без специалност да достигне 150 на сто от средната брутна работна заплата за страната, а на медицинските сестри, акушерките и асоциираните медицински специалисти, лекарските асистенти и на помощник-фармацевтите – 140 на сто от средната брутна работна заплата.<!-- -->“</li><li>„<!-- -->Беше отбелязано, че темата за определянето на достойно трудово възнаграждение на медицинските специалисти се обсъжда повече от една година, но до този момент все още няма решение на този въпрос.<!-- -->“</li><li>„<!-- -->Според вносителя целта на предложения законопроект е насърчаване на младите лекари да практикуват в България чрез конкурентни възнаграждения и намаляване недостига на медицински сестри чрез повишаване привлекателността на професията.<!-- -->“</li><li>„<!-- -->Предложеното увеличение предвижда основното възнаграждение на лекарите без специалност да достигне 150% от средната брутна работна заплата за страната, а за медицинските сестри, акушерките и асоциираните медицински специалисти и на помощник-фармацевтите – 140% от средната брутна работна заплата.<!-- -->“</li><li>„<!-- -->Предлага се създаване на нови разпоредби в Кодекса на труда, като се задължава Главна инспекция по труда да следи за спазването на минималните изисквания при определяне на трудовите възнаграждения в лечебните заведения.<!-- -->“</li><li>„<!-- -->Предложеното увеличение предвижда основното възнаграждение на лекарите без специалност да достигне 15090 от средната брутна работна заплата за страната, а на медицинските сестри, акушерките и асоциираните медицински специалисти и на помощник-фармацевтите - 14090 от средната брутна работна заплата.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/166982\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Той информира народните представители, че с предлаганите нормативни промени се цели увеличаване на основните трудови възнаграждения на лекарите без специалност и на медицинските специалисти, както и допълнителни възнаграждения за нощен труд и за допълнително придобита квалификация.<!-- -->“</li><li>„<!-- -->Представителите на синдикатите и работодателите изтъкнаха, че с предлаганите изменения и допълнения се създават предпоставки за пренебрегване на процеса на колективното трудово договаряне.<!-- -->“</li><li>„<!-- -->Според вносителя за реализирането на законодателната инициатива се предвиждат допълнителни публични разходи в зависимост от размера на възнаграждението на всяко съсловие.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/166982\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->МТСП- Вх.№ КТДСП-52-603-14-2; БЗС; МТСП; БСЛАФ; БФС; НСОМБАЛ; ББА; БАПЗГ; НСОРБ; СОББ; БЛС; БСК<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/166982\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/166951\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закон за лечебните заведения</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-13</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Той информира народните представители, че с предлаганите нормативни промени се цели гарантиране на адекватни минимални нива на заплащане на медицинския персонал в лечебните заведения по чл. 5, ал. 1 и чл. 10 от Закона за лечебните заведения и в държавните и общински лечебни заведения за болнична помощ.<!-- -->“</li><li>„<!-- -->Създават се механизми за по-голяма прозрачност при формирането на трудовите възнаграждения в тези лечебни заведения и за стимулиране на професионалното развитие и квалификацията на медицинските специалисти чрез обвързване на част от възнаграждението с продължаващото обучение и придобитата допълнителна квалификация.<!-- -->“</li><li>„<!-- -->Въвеждат се ефективни санкции при неспазване на законоустановените минимални прагове за заплащане, включително възможност за прекратяване на договорите с НЗОК и налагане на финансови глоби на ръководствата на лечебните заведения.<!-- -->“</li><li>„<!-- -->Беше отбелязано, че темата за определянето на достойно трудово възнаграждение на медицинските специалисти се обсъжда повече от една година, но до този момент все още няма решение на този въпрос.<!-- -->“</li><li>„<!-- -->Имено по този начин ще бъде намерено трайно решение на съществуващите проблеми, свързани с определянето на трудовите възнаграждения на медицинския персонал в лечебните заведения за болнична помощ.<!-- -->“</li><li>„<!-- -->Право на здравословни и безопасни условия на труд: Достойното заплащане е елемент, който индиректно допринася за по-добри условия на труд. е Осигуряване на достъп до качествени здравни услуги: Целта за задържане на медицински кадри и подобряване на качеството на здравните грижи е в унисон с европейските политики в областта на здравеопазването.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/166951\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Представителите на синдикатите и работодателите изтъкнаха, че с предлаганите изменения и допълнения се създават предпоставки за пренебрегване на процеса на колективното трудово договаряне.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/166951\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Част от народните представители посочиха, че отлагането на решаването на този въпрос за пореден път ще доведе до напрежение сред медицинските специалисти, които работят в лечебни заведения за болнична помощ.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/166951\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Николай Денков</b>: „<!-- -->Ами очевидно за колегите това, което казвам, не е особено важно, въпреки че аз ще стигна и до техния<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11183\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->07.10.2026</a></li><li><b>Александър Симидчиев</b><span class=\"text-muted\"> (<!-- -->ДБ<!-- -->)</span>: „<!-- -->Законопроектът, който обсъждаме, засяга въпрос, който не търпи отлагане – как да задържим младите колеги и медицински специалисти в българското<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11183\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->07.10.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->БЗС; БСЛАФ; БФС; НСОМБАЛ; ББА; МТСП; БАПЗГ; НСОРБ; СОББ; БЛС; БСК; ИАМН<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/166951\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div></div></section><section id=\"mnenie\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Твоето мнение</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. <a href=\"/mnenie\">Всички закони за гласуване</a>.</p><div class=\"bg-surface rounded-sm p-5 text-[15px] text-muted\">Зарежда се…</div></section><section id=\"grupi\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласуваха групите по този закон</h2></div><p class=\"text-sm text-muted mb-3\">Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо <!-- -->1<!-- -->. Прието: <!-- -->0<!-- -->, отхвърлено: <!-- -->1<!-- -->.</p><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Прогресивна България</p><p class=\"num text-sm mt-1\">За: <b>0</b> · Против: <b>0</b> · общо <!-- -->1</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ГЕРБ – СДС</p><p class=\"num text-sm mt-1\">За: <b>1</b> · Против: <b>0</b> · общо <!-- -->1</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Демократична България</p><p class=\"num text-sm mt-1\">За: <b>1</b> · Против: <b>0</b> · общо <!-- -->1</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ДПС</p><p class=\"num text-sm mt-1\">За: <b>1</b> · Против: <b>0</b> · общо <!-- -->1</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Продължаваме промяната</p><p class=\"num text-sm mt-1\">За: <b>1</b> · Против: <b>0</b> · общо <!-- -->1</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Възраждане</p><p class=\"num text-sm mt-1\">За: <b>1</b> · Против: <b>0</b> · общо <!-- -->1</p></div></div><p class=\"text-sm mt-3\">Първо четене: <a href=\"/parlament/glasuvane/2026-10-07-12\">7 октомври 2026 г.</a></p></section><section id=\"glasuvaniya\" class=\"scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Всички гласувания по закона</h2></div><ul><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-10-07-12\">Закона за лечебните заведения - първо гласуване</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-muted border border-rule\">Отхвърлено</span></div><p class=\"text-sm text-muted mt-1\">7 октомври 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: Въздържал се · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: За</p></li></ul></section></div><!--$--><!--/$--></main><!--$--><!--/$--><footer class=\"bg-surface border-t border-rule mt-20\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 text-sm text-muted grid gap-2 sm:grid-cols-2\"><p>Не подкрепяме партия, кандидат или правителство. Всяко число има източник и дата.<!-- --> <a href=\"/metodologiya\">Как работим</a> · <a href=\"/rechnik\">Речник</a> · <a href=\"/sastoyanie\">Състояние на данните</a> · <!--$?--><template id=\"B:1\"></template><a href=\"/metodologiya#greshki\">Съобщи за грешка</a><!--/$--></p><p class=\"sm:text-right\">Вътрешен прототип · данните са към датите, посочени до тях</p></div></footer><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script id=\"_R_\">(globalThis[\"TURBOPACK\"] || (globalThis[\"TURBOPACK\"] = [])).push({\"otherChunks\":[\"static/chunks/310vm2bl3xxpt.js\",\"static/chunks/2vy51v46dlsq-.js\",\"static/chunks/2bx7ggprk0oi5.js\",\"static/chunks/0c1ad7rcpjghx.js\"],\"runtimeModuleIds\":[94553]});</script><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" async=\"\"></script><div hidden id=\"S:0\"><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" aria-current=\"page\" class=\"no-underline pb-1 border-b-2 text-white border-red\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></