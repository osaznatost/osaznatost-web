\\\",\\\"children\\\":\\\"Покажи цитатите\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-5 mt-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-green pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Какво предлага законопроектът\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"Предвижда се основното възнаграждение на лекарите, лекарите по дентална медицина и фармацевтите без специалност да достигне 150 на сто от средната брутна работна заплата за страната, а на медицинските сестри, акушерките и асоциираните медицински специалисти, лекарските асистенти и на помощник-фармацевтите – 140 на сто от средната брутна работна заплата.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"Беше отбелязано, че темата за определянето на достойно трудово възнаграждение на медицинските специалисти се обсъжда повече от една година, но до този момент все още няма решение на този въпрос.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[\\\"„\\\",\\\"Според вносителя целта на предложения законопроект е насърчаване на младите лекари да практикуват в България чрез конкурентни възнаграждения и намаляване недостига на медицински сестри чрез повишаване привлекателността на професията.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[\\\"„\\\",\\\"Предложеното увеличение предвижда основното възнаграждение на лекарите без специалност да достигне 150% от средната брутна работна заплата за страната, а за медицинските сестри, акушерките и асоциираните медицински специалисти и на помощник-фармацевтите – 140% от средната брутна работна заплата.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"children\\\":[\\\"„\\\",\\\"Предлага се създаване на нови разпоредби в Кодекса на труда, к