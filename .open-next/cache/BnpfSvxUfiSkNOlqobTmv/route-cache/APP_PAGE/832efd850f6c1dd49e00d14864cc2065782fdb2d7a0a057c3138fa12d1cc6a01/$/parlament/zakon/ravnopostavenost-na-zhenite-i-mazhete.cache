{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/zakon/layout,_N_T_/parlament/zakon/[slug]/layout,_N_T_/parlament/zakon/[slug]/page,_N_T_/parlament/zakon/ravnopostavenost-na-zhenite-i-mazhete"},"segmentPaths":["/_tree","/_full","/parlament/zakon/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/832efd850f6c1dd49e00d14864cc2065782fdb2d7a0a057c3138fa12d1cc6a01/$/parlament/zakon/ravnopostavenost-na-zhenite-i-mazhete","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/zakon/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0vn96-fhbu77m.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><script src=\"/_next/static/chunks/43gzry38n6x69.js\" async=\"\"></script><title>Закон за равнопоставеност на жените и мъжете · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Закон за равнопоставеност на жените и мъжете · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Закон за равнопоставеност на жените и мъжете · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Парламент</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Закон</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Закон за равнопоставеност на жените и мъжете</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Приет окончателно на 17.09.2026 г., обнародван в ДВ, бр. 88/2026</div></div></div><nav aria-label=\"Секции на страницата\" class=\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\"><ul class=\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\"><li><a href=\"#nakratko\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Накратко</a></li><li><a href=\"#zakonoproekti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Кой внесе и кой се изказа</a></li><li><a href=\"#argumenti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Двете страни</a></li><li><a href=\"#mnenie\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Твоето мнение</a></li><li><a href=\"#grupi\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Как гласуваха</a></li><li><a href=\"#glasuvaniya\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Гласувания (4)</a></li></ul></nav><section id=\"nakratko\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Накратко</h2><div class=\"max-w-4xl\"><p class=\"text-[17px]\">Законът въвежда европейската директива 2022/2381 (срокът изтече на 28.12.2024 г.): публичните дружества на борсата трябва да имат поне 33% от по-слабо представения пол сред всички директорски позиции в управителните и надзорните органи. Първото отчитане е до 30.06.2027 г. за 2026 г., чрез декларациите за корпоративно управление; има санкции при неизпълнение. Комисията за защита от дискриминация получава допълнителни правомощия по наблюдението.</p><p class=\"mt-3 text-[15px]\"><b>Вносители:</b> <!-- -->Министерският съвет (представи зам.-министърът на труда Надя Клисурска)<!-- --> · <a href=\"https://www.parliament.bg/bg/bills/ID/167131\" target=\"_blank\" rel=\"noreferrer\">законопроект <!-- -->52-602-01-15</a></p><p class=\"mt-3 text-[15px]\"><b>Какво се случи:</b> <!-- -->Първо четене на 27.08.2026 г. (155 „за“, 9 „против“), окончателно на 17.09.2026 г. (150 „за“, 9 „против“ — „Възраждане“).</p></div></section><section id=\"zakonoproekti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Кой внесе и кой се изказа</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.</p><ul class=\"space-y-4 max-w-5xl\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167131\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за равнопоставеност на жените и мъжете</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-602-01-15</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>22 юни 2026 г.<!-- --> от <!-- -->Министерския съвет</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по труда, демографската и социалната политика (водеща); Комисия по европейските въпроси и контрол на европейските фондове (участваща); Комисия по правата на човека, вероизповеданията и жалбите на гражданите (участваща); Комисия по бюджет и финанси (участваща); Комисия по икономическа политика, инвестиции и индустрия (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>БЪЛГАРСКА СТОПАНСКА КАМАРА- становище; Фондация&quot;БЪЛГАРСКИ ФОНД ЗА ЖЕНИТЕ&quot;-Вх.КТДСП-52-633-00-1; Фонд.Мама има работа - вх.№КТДСП-52-633-00-2; КФН- становище; Комисия за защита от дискриминация-становище; СЪВЕТ НА ЖЕНИТЕ В БИЗНЕСА В БЪЛГАРИЯ-становище</dd><dt class=\"text-muted\">Предложения</dt><dd>1<!-- --> писмени предложения на депутати между <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">първо</button></span> и <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">второ четене</button></span></dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11162\" target=\"_blank\" rel=\"noreferrer\">27 август 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span><span>, <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11171\" target=\"_blank\" rel=\"noreferrer\">17 септември 2026 г.</a> (<!-- -->зала второ гласуване<!-- -->)</span></dd><dt class=\"text-muted\">Обнародван</dt><dd>ДВ, бр. 88/2026<!-- -->, приет на 17 септември 2026 г.</dd></dl></li></ul></section><div id=\"argumenti\" class=\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\"><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Министерството на труда и социалната политика</p><p class=\"text-[15px]\">Балансът между половете в ръководството на дружествата е от полза за икономиката; директивата е задължителна и срокът ѝ е изтекъл.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167131\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-15, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Председателят на Комисията за защита от дискриминация</p><p class=\"text-[15px]\">Изрази резерви към възлагането на нови функции на комисията; министерството отговори, че те съответстват на правото на ЕС.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167131\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-15, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">„Възраждане“</p><p class=\"text-[15px]\">Гласуваха против.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\" title=\"Поименни гласувания, Народно събрание (чрез „Наясно“)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">БСК, КФН, Българския фонд за жените, „Мама има работа“, Съвета на жените в бизнеса</p><p class=\"text-[15px]\">Внесоха становища (публикувани на сайта на парламента).<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167131\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-15, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Двете страни на монетата</h3><p class=\"text-sm text-muted mb-3\">Какво следва на практика, ако законът се приеме и ако се отхвърли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167131\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-15, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\"><p class=\"font-semibold\">Ако се приеме</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Изпълнение на директивата и по-разнообразно управление.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Критиците на квотите смятат, че подборът трябва да е само по качества.</li></ul></div></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\"><p class=\"font-semibold\">Ако се отхвърли</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Процедура за нарушение.</li></ul></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Какво печели и какво губи всяка страна</h3><p class=\"text-sm text-muted mb-3\">Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.</p><div class=\"space-y-3\"><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Публичните дружества<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167131\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-15, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Задължение за прозрачен подбор и отчитане; санкции при неизпълнение.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Жени с опит в управлението<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167131\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-15, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Повече възможности за места в бордовете.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">—</p></div></div></div></div></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://www.parliament.bg/bg/bills/ID/167131\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-602-01-15, доклади и становища</a></li><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания, Народно събрание (чрез „Наясно“)</a></li></ol><p class=\"text-xs text-muted mt-2\">Обобщението е по доклада на социалната комисия. Доводът срещу квотите е обобщение на обичайната критика, не цитат от доклада.<!-- --> Проверено: <!-- -->19 ноември 2026 г.</p></div></div><section id=\"dokumenti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Още от документите</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.</p><div class=\"space-y-4 max-w-4xl\"><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167131\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за равнопоставеност на жените и мъжете</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-602-01-15</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Според вносителя целта на предложения законопроект е въвеждането разпоредбите на Директива (ЕС) 2022/2381 на Европейския парламент и на Съвета от 23 ноември 2022 г. за подобряване баланса между половете сред директорите на дружества, регистрирани на фондовата борса, и на свързаните с това мерки.<!-- -->“</li><li>„<!-- -->Въвеждат се изисквания за публичност на тази информация чрез декларациите за корпоративно управление.<!-- -->“</li><li>„<!-- -->Определят се санкции, приложими за нарушение от страна дружествата, регистрирани на фондовата борса, при неизпълнение на приетите разпоредби.<!-- -->“</li><li>„<!-- -->Въвежда се изискването публичните дружества, които не отговарят на поставената количествена цел, да адаптират процедурите за подбор на управителните, надзорните, съответно съветите на директорите.<!-- -->“</li><li>„<!-- -->Предлага се създаване на съответстващи разпоредби в Закона за защита от дискриминация и в Закона за публичното предлагане на ценни книжа.<!-- -->“</li><li>„<!-- -->Фондация „Мама има работа“ изразява принципна подкрепа на законопроекта като предлага конкретни допълнения: въвеждане на алтернативна цел от 40% за неизпълнителните директори и добавяне на ефективна санкционна мярка за некоригиран баланс.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167131\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Според вносителя за реализирането на законодателната инициатива не се предвиждат допълнителни публични разходи и законопроектът няма да има пряко или косвено въздействие върху държавния бюджет.<!-- -->“</li><li>„<!-- -->Фондация „Български фонд за жените“ подкрепя законопроекта, както и транспонирането на Директива 2022/2381 в българското право.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167131\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Промените няма да доведат до допълнителна финансова и административна тежест за лицата и заинтересованите страни.<!-- -->“</li><li>„<!-- -->Комисията за защита от дискриминация изразява категоричното си несъгласие с част от предложените разпоредби в законопроекта, в частта на § 3 от Преходните и заключителните разпоредби, със следните аргументи: • КЗД е независим специализиран държавен орган за предотвратяване от дискриминация.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167131\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Надя Клисурска-жекова</b>: „<!-- -->С предложения проект на Закона за изменение и допълнение на Закона за равнопоставеността на жените и мъжете се транспонира Директива на Европейския съюз 2022/2381 на Европейския парламент и на Съвета от 23 ноември 2022 г. за подобряване на баланса между половете сред директорите на дружества, регистрирани на Фондовата борса, и за свързаните с това мерки. Срокът за транспониране на Директивата изтече на 28 декември…<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11162\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->27.08.2026</a></li><li><b>Милена Недева</b><span class=\"text-muted\"> (<!-- -->ПБ<!-- -->)</span>: „<!-- -->Уважаема госпожо Председател, уважаеми колеги, с настоящото предложение към Закона за равнопоставеност между жените и мъжете се въвеждат разпоредбите на Европейската директива, с която се цели да се осигури равно представителство на мъже и жени в управителните органи на публичните дружества, предлагащи ценни книжа на фондовата борса. Стана ясно, че тази директива е трябвало да бъде въведена в националното ни…<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11171\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->17.09.2026</a></li><li><b>Георги Георгиев</b><span class=\"text-muted\"> (<!-- -->ВЪЗРАЖДАНЕ<!-- -->)</span>: „<!-- -->Ама дайте да видим кое променя? Променя факта, че нарушавате, както Вие цитирахте преди малко, Конституцията. При равни други условия кандидатите трябва да бъдат гледани по пол – това гласи законът, който Вие предлагате в момента. Не Вие – Европейската комисия, а Вие чинно изпълнявате, козирувате пред нея. Това променяте. Нарушавате Конституцията на Република България с това нещо. Защото при равни други условия…<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11171\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->17.09.2026</a></li><li><b>Димо Дренчев</b><span class=\"text-muted\"> (<!-- -->ВЪЗРАЖДАНЕ<!-- -->)</span>: „<!-- -->Госпожо Недева, репликата ми е към Вас, понеже изчетохте мотивите, но всъщност не е лично към Вас, а по-скоро към тези, създали европейската директива. Всъщност ние нямаме равни други условия. Имаме предприятие, което след шест месеца ще бъде санкционирано, ако не промени състава на борда си. И то не може да избере лице от по-силно представения пол, а то трябва да избере, за да не бъде санкционирано до 20 000 евро,…<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11171\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->17.09.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->БЪЛГАРСКА СТОПАНСКА КАМАРА- становище; Фондация&quot;БЪЛГАРСКИ ФОНД ЗА ЖЕНИТЕ&quot;-Вх.КТДСП-52-633-00-1; Фонд.Мама има работа - вх.№КТДСП-52-633-00-2; КФН- становище; Комисия за защита от дискриминация-становище; СЪВЕТ НА ЖЕНИТЕ В БИЗНЕСА В БЪЛГАРИЯ-становище<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167131\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div></div></section><section id=\"mnenie\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Твоето мнение</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. <a href=\"/mnenie\">Всички закони за гласуване</a>.</p><div class=\"bg-surface rounded-sm p-5 text-[15px] text-muted\">Зарежда се…</div></section><section id=\"grupi\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласуваха групите по този закон</h2></div><p class=\"text-sm text-muted mb-3\">Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо <!-- -->4<!-- -->. Прието: <!-- -->4<!-- -->, отхвърлено: <!-- -->0<!-- -->.</p><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Прогресивна България</p><p class=\"num text-sm mt-1\">За: <b>4</b> · Против: <b>0</b> · общо <!-- -->4</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ГЕРБ – СДС</p><p class=\"num text-sm mt-1\">За: <b>4</b> · Против: <b>0</b> · общо <!-- -->4</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Демократична България</p><p class=\"num text-sm mt-1\">За: <b>4</b> · Против: <b>0</b> · общо <!-- -->4</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ДПС</p><p class=\"num text-sm mt-1\">За: <b>4</b> · Против: <b>0</b> · общо <!-- -->4</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Продължаваме промяната</p><p class=\"num text-sm mt-1\">За: <b>4</b> · Против: <b>0</b> · общо <!-- -->4</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Възраждане</p><p class=\"num text-sm mt-1\">За: <b>0</b> · Против: <b>4</b> · общо <!-- -->4</p></div></div><p class=\"text-sm mt-3\">Първо четене: <a href=\"/parlament/glasuvane/2026-08-27-5\">27 август 2026 г.</a></p></section><section id=\"glasuvaniya\" class=\"scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Всички гласувания по закона</h2></div><ul><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-08