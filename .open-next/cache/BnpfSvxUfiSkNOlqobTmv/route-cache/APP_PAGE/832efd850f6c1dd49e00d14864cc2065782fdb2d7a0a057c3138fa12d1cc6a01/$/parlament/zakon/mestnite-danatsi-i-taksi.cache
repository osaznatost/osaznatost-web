:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"dokumenti\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Още от документите\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":\\\"Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-4 max-w-4xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"167623\\\",{\\\"className\\\":\\\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted\\\",\\\"children\\\":\\\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mt-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167623\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"className\\\":\\\"text-ink\\\",\\\"children\\\":\\\"Законопроект за изменение и допълнение на Закона за местните данъци и такси\\\"}],\\\" \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-muted num font-normal\\\",\\\"children\\\":[\\\"№ \\\",\\\"52-602-01-59\\\"]}]]}],[\\\"$\\\",\\\"details\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer font-semibold text-green mt-2\\\",\\\"children\\\":\\\"Покажи цитатите\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-5 mt-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-green pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Какво предлага законопроектът\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"В изложението си г-жа Петкова акцентира, че със законопроекта се предлага поетапна актуализация на базисните данъчни стойности, използвани при определяне на данъчната оценка на недвижимите имоти.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"Определената данъчната оценка, изготвена по новия ред, няма да се прилага за целите на определяне на таксата за битови отпадъци.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[\\\"„\\\",\\\"Предвижда се и удължаване на срока за връчване на съобщенията за определяне на данъка върху недвижимите имоти, както и срокът за ползване на отстъпката за предплатилите за цялата 2027 година.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[\\\"„\\\",\\\"Във връзка с получено становище от страна на Европейската комисия се предлага премахване на невлезлите в сила текстове, свързани с проекта за въвеждане на режим за облагане на определени юридически лица с патентен данък.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"children\\\":[\\\"„\\\",\\\"В становището на Европейската комисия въвеждането на облагане с такъв вид данък на доходите от дейност като заведения за хранене и развлечения на юридически лица е определено като държавна помощ.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"5\\\",{\\\"children\\\":[\\\"„\\\",\\\"По отношение на правителствените мерки, свързани с таксата за битови отпадъци считат, че подобна мярка не следва да се превръща в трайно решение за запазване на данъчната оценка като основа за определяне на ТБО, а колкото до осъвременяването на административнонаказателните санкции са категорично против.\\\",\\\"“\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted mt-1\\\",\\\"children\\\":[\\\"Източник: \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167623\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":\\\"доклад на комисията и мотиви, parliament.bg\\\"}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-[#8a8f8c] pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Позиции, изказани в комисията\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"Господин Трифонов заяви, че на този етап не би подкрепил законопроекта, внесен от народните представители, предвид на това, че следва предлаганата от тях уредба да се прецизира.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"Българската стопанска камара подкрепя по принцип актуализирането на данъчните оценки, но не е убедена, че предложеният механизъм е достатъчно прецизен.\\\",\\\"“\\\"]}],\\\"$L26\\\"]}],\\\"$L27\\\"]}],\\\"$L28\\\",\\\"$L29\\\",\\\"$L2a\\\"]}]]}]]}],\\\"$L2b\\\"]}]]}]\\n1e:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"mnenie\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Твоето мнение\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":[\\\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \\\",[\\\"$\\\",\\\"$La\\\",null,{\\\"href\\\":\\\"/mnenie\\\",\\\"children\\\":\\\"Всички закони за гласуване\\\"}],\\\".\\\"]}],[\\\"$\\\",\\\"$L2c\\\",null,{\\\"item\\\":\\\"mestnite-danatsi-i-taksi\\\",\\\"question\\\":\\\"Подкрепяш ли последните промени в „Закон за местните данъци и такси (по-високи данъчни оценки на имотите от 2027 г.)“?\\\"}]]}]\\n1f:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"grupi\\\",