{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/zakon/layout,_N_T_/parlament/zakon/[slug]/layout,_N_T_/parlament/zakon/[slug]/page,_N_T_/parlament/zakon/mestnite-danatsi-i-taksi"},"segmentPaths":["/_tree","/_full","/parlament/zakon/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/832efd850f6c1dd49e00d14864cc2065782fdb2d7a0a057c3138fa12d1cc6a01/$/parlament/zakon/mestnite-danatsi-i-taksi","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/zakon/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0vn96-fhbu77m.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><script src=\"/_next/static/chunks/43gzry38n6x69.js\" async=\"\"></script><title>Закон за местните данъци и такси · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Закон за местните данъци и такси · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Закон за местните данъци и такси · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Парламент</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Закон</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Закон за местните данъци и такси</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Приет на първо четене на 11.11.2026 г. (124 „за“, 48 „против“); предстои второ четене</div></div></div><nav aria-label=\"Секции на страницата\" class=\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\"><ul class=\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\"><li><a href=\"#nakratko\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Накратко</a></li><li><a href=\"#zakonoproekti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Кой внесе и кой се изказа</a></li><li><a href=\"#argumenti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Двете страни</a></li><li><a href=\"#mnenie\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Твоето мнение</a></li><li><a href=\"#grupi\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Как гласуваха</a></li><li><a href=\"#glasuvaniya\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Гласувания (3)</a></li></ul></nav><section id=\"nakratko\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Накратко</h2><div class=\"max-w-4xl\"><p class=\"text-[17px]\">Базисните стойности, от които се смята данъчната оценка на имотите, се вдигат поетапно спрямо стойността до края на 2026 г.: с 30% през 2027 г., с още 35 пункта през 2028 г. и с още 35 пункта през 2029 г. — до 2029 г. оценката става около два пъти по-висока. Новите оценки не се прилагат за таксата за битови отпадъци. Ефектът за общинските бюджети е +73,4 млн. € за 2027, +172,1 млн. € за 2028 и +270,8 млн. € за 2029 г. — т.е. по-висок данък сгради за собствениците. Отпадат невлезлите в сила текстове за патентен данък за заведенията (по становище на ЕК за държавна помощ). Глобите, непроменяни до 2019 г., се превалутират едно към едно в евро (на практика се удвояват).</p><p class=\"mt-3 text-[15px]\"><b>Вносители:</b> <!-- -->Министерският съвет (представи зам.-министърът на финансите Людмила Петкова). Проект на Димитър Найденов и др. за отпадане на годишната декларация за туристическия данък беше отхвърлен.<!-- --> · <a href=\"https://www.parliament.bg/bg/bills/ID/167623\" target=\"_blank\" rel=\"noreferrer\">законопроект <!-- -->52-602-01-59</a></p><p class=\"mt-3 text-[15px]\"><b>Какво се случи:</b> <!-- -->На първо четене (11.11.2026) правителственият проект мина със 124 „за“ и 48 „против“ (ГЕРБ–СДС, ДПС, ПП и „Възраждане“ против, ДБ се въздържа). Проектът на Найденов беше отхвърлен (152 въздържали се). В регионалната комисия правителственият проект получи 13 „за“ и 2 въздържали се. Министерствата на финансите и на туризма и сдружението на общините не подкрепиха проекта на Найденов, защото декларацията има контролна функция.</p></div></section><section id=\"zakonoproekti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Кой внесе и кой се изказа</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.</p><ul class=\"space-y-4 max-w-5xl\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167623\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за местните данъци и такси</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-602-01-59</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>5 ноември 2026 г.<!-- --> от <!-- -->Министерския съвет</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща); Комисия по регионална политика, благоустройство и местно самоуправление (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>КНСБ по ЗИД на ЗМДТ-59; НСОРБ по ЗИД на ЗМДТ-59; НСОРБ по ЗМДТ 52-602-01-59; БСК по ЗИД на ЗМДТ-59</dd><dt class=\"text-muted\">Предложения</dt><dd>7<!-- --> писмени предложения на депутати между <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">първо</button></span> и <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">второ четене</button></span></dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11195\" target=\"_blank\" rel=\"noreferrer\">11 ноември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167523\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за местните данъци и такси</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-122</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>28 август 2026 г.<!-- --> от <!-- -->Димитър Найденов, Джипо Джипов, Стела Николова и още 8 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща); Комисия по регионална политика, благоустройство и местно самоуправление (участваща); Комисия по туризъм (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>НСОРБ; МРРБ по ЗИД на ЗМДТ №52-654-01-122; МФ по ЗИД на ЗМДТ № 52-654-01-122; Министерството на туризма; НСОРБ по Законопроект за изменение и допълнение на Закона за местните данъци и такси, № 52-654-01-122</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11195\" target=\"_blank\" rel=\"noreferrer\">11 ноември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li></ul></section><div id=\"argumenti\" class=\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\"><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Министерството на финансите</p><p class=\"text-[15px]\">Данъчните оценки отдавна не отразяват реалните стойности; актуализацията укрепва собствените приходи и финансовата самостоятелност на общините.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167623\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-59, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Милен Трифонов (ПБ)</p><p class=\"text-[15px]\">Мярката е закъсняла, а при сделките страните няма да бъдат засегнати отрицателно.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167623\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-59, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Националното сдружение на общините</p><p class=\"text-[15px]\">Законопроектът съдържа вътрешно противоречие; иска преходният режим за таксата за битови отпадъци да се удължи до края на 2029 г.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167623\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-59, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Българската стопанска камара</p><p class=\"text-[15px]\">Подкрепя по принцип, но предлага прецизиране на текстовете.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167623\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-59, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Отворен въпрос</p><p class=\"text-[15px]\">Удвояването на данъчните оценки до 2029 г. засяга всички собственици на имоти, включително домакинства с ниски доходи; в доклада няма оценка на ефекта върху тях.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167623\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-59, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Двете страни на монетата</h3><p class=\"text-sm text-muted mb-3\">Какво следва на практика, ако законът се приеме и ако се отхвърли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167623\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-59, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\"><p class=\"font-semibold\">Ако се приеме</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">По-самостоятелни общини с повече собствени приходи.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Значително по-висока данъчна тежест за собствениците на жилища.</li></ul></div></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\"><p class=\"font-semibold\">Ако се отхвърли</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Без нова тежест за собствениците.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Общините остават зависими от държавни трансфери.</li></ul></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Какво печели и какво губи всяка страна</h3><p class=\"text-sm text-muted mb-3\">Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.</p><div class=\"space-y-3\"><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Собствениците на имоти<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167623\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-59, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">По-висок данък сгради всяка година до 2029 г.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Общините<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167623\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-59, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Стотици милиони евро повече собствени приходи.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">—</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Нарушителите<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167623\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-59, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">На практика двойно по-високи глоби.</p></div></div></div></div></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://www.parliament.bg/bg/bills/ID/167623\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-602-01-59, доклади и становища</a></li><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания, Народно събрание (чрез „Наясно“)</a></li></ol><p class=\"text-xs text-muted mt-2\">Обобщението е по докладите на бюджетната и регионалната комисия. Изводът „около два пъти“ е наш: увеличенията са спрямо стойността до 2026 г. (30% + 35% + 35%), което съответства и на бюджетния ефект по години.<!-- --> Проверено: <!-- -->19 ноември 2026 г.</p></div></div><section id=\"dokumenti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Още от документите</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.</p><div class=\"space-y-4 max-w-4xl\"><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167623\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за местните данъци и такси</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-602-01-59</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->В изложението си г-жа Петкова акцентира, че със законопроекта се предлага поетапна актуализация на базисните данъчни стойности, използвани при определяне на данъчната оценка на недвижимите имоти.<!-- -->“</li><li>„<!-- -->Определената данъчната оценка, изготвена по новия ред, няма да се прилага за целите на определяне на таксата за битови отпадъци.<!-- -->“</li><li>„<!-- -->Предвижда се и удължаване на срока за връчване на съобщенията за определяне на данъка върху недвижимите имоти, както и срокът за ползване на отстъпката за предплатилите за цялата 2027 година.<!-- -->“</li><li>„<!-- -->Във връзка с получено становище от страна на Европейската комисия се предлага премахване на невлезлите в сила текстове, свързани с проекта за въвеждане на режим за облагане на определени юридически лица с патентен данък.<!-- -->“</li><li>„<!-- -->В становището на Европейската комисия въвеждането на облагане с такъв вид данък на доходите от дейност като заведения за хранене и развлечения на юридически лица е определено като държавна помощ.<!-- -->“</li><li>„<!-- -->По отношение на правителствените мерки, свързани с таксата за битови отпадъци считат, че подобна мярка не следва да се превръща в трайно решение за запазване на данъчната оценка като основа за определяне на ТБО, а колкото до осъвременяването на административнонаказателните санкции са категорично против.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167623\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Господин Трифонов заяви, че на този етап не би подкрепил законопроекта, внесен от народните представители, предвид на това, че следва предлаганата от тях уредба да се прецизира.<!-- -->“</li><li>„<!-- -->Българската стопанска камара подкрепя по принцип актуализирането на данъчните оценки, но не е убедена, че предложеният механизъм е достатъчно прецизен.<!-- -->“</li><li>„<!-- -->Асоциацията на индустриалния капитал в България подкрепят по принцип поетапното осъвременяване на данъчните оценки, като настояват санкциите да бъдат преработени и прилагането на принципа „замърсителят плаща“ да не бъде отлагано.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167623\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Петър Петров</b><span class=\"text-muted\"> (<!-- -->ВЪЗРАЖДАНЕ<!-- -->)</span>: „<!-- -->Уважаема госпожо Председател, ще помоля за прегласуване на така направеното искане, тъй като Столичната топлофикация предизвика през последните няколко месеца вниманието на обществото и все повече насочи вниманието към себе си не само заради огромната си задлъжнялост, която гони вече милиард и половина евро, а и също заради своята дейност, следствие от която почти ежедневно виждаме в репортажи по телевизиите – с…<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11195\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->11.11.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->КНСБ по ЗИД на ЗМДТ-59; НСОРБ по ЗИД на ЗМДТ-59; НСОРБ по ЗМДТ 52-602-01-59; БСК по ЗИД на ЗМДТ-59<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167623\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167523\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за местните данъци и такси</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-122</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Предлага се и Министерството на финансите да осигури на общините служебен достъп до данните от ЕСТИ, което е предвидено да става в тридневен срок от получаването им от Министерството на туризма.<!-- -->“</li><li>„<!-- -->Тя отбеляза, че декларацията има самостоятелна, контролна функция и материализира годишното изявление на данъчно задължените лица, и допълни, че отпадането на декларацията би било оправдано, когато Единната система за туристическа информация започне да предоставя равностойна или по-висока степен на доказуемост.<!-- -->“</li><li>„<!-- -->Тя посочи, че данните в ЕСТИ се въвеждат единствено от хотелиерите и не се валидират от общински данъчни служители, което поставя под въпрос гарантирането истинността на данните в системата.<!-- -->“</li><li>„<!-- -->В изложението си г-жа Петкова акцентира, че със законопроекта се предлага поетапна актуализация на базисните данъчни стойности, използвани при определяне на данъчната оценка на недвижимите имоти.<!-- -->“</li><li>„<!-- -->Определената данъчната оценка, изготвена по новия ред, няма да се прилага за целите на определяне на таксата за битови отпадъци.<!-- -->“</li><li>„<!-- -->Предвижда се и удължаване на срока за връчване на съобщенията за определяне на данъка върху недвижимите имоти, както и срокът за ползване на отстъпката за предплатилите за цялата 2027 година.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167523\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Господин Георги Тодоров представи становището на Министерството на туризма, като посочи, че предложеният законопроект е малка част от големия пакет законодателни мерки, които правителството подготвя с цел намаляване на административната тежест в сектор данъци и такси и в сектор туризъм по отношение на изсветляване на бизнеса.<!-- -->“</li><li>„<!-- -->Заместник-министърът отбеляза, че се предвижда реинженеринг на Единната система за туристическа информация и допълни, че моментът и начинът, по който се предлага изменението в Закона за местните данъци и такси, са неподходящи и неправилни.<!-- -->“</li><li>„<!-- -->Тя представи накратко становището на Министерството на финансите, като отбеляза, че с отмяната на декларацията по чл. 61р, ал. 5 от Закона за местните данъци и такси се премахва и един самостоятелен източник за проверка и съпоставка на данните, като същевременно с това данъчно задълженото лице ще бъде лишено от механизъм за отразяване на корекциите на данни.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167523\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->От името на вносителя законопроектът беше представен от г-н Димитър Найденов, който посочи, че с него се цели да се намали административната тежест за лицата, предлагащи нощувки, като отпадне ежегодното деклариране на данни, с които администрацията разполага, както и по-ясно разграничаване на функциите на Министерството на туризма и Министерството на финансите при служебния обмен на данните от Единната система за туристическа информация (ЕСТИ).<!-- -->“</li><li>„<!-- -->Тя обърна внимание и върху възражението на Министерството на финансите срещу незабавното влизане на закона в сила, тъй като липсата на технически възможности за служебен обмен и корекция на данните би създало практически затруднения.<!-- -->“</li><li>„<!-- -->В хода на дискусията народният представител Ясен Щерев изрази съгласие с идеята за намаляване на административната тежест за туристическия бизнес, но възрази срещу отпадането на декларацията по чл. 61р, ал. 5 от Закона за местните данъци и такси с оглед несъвършенствата на Единната система за туристическа информация, като допълни, че той ще се въздържи от подкрепа на законопроекта.<!-- -->“</li><li>„<!-- -->Той посочи, че целта е да се намали административната тежест за лицата, предлагащи нощувки, като отпадне ежегодното деклариране на данни, с които администрацията вече разполага.<!-- -->“</li><li>„<!-- -->Очаква се да отпадне една ежегодна декларационна тежест за туристическия сектор, да се намали административната работа по приемане и обработване на декларациите и да се ограничат грешките при повторното пренасяне на данни.<!-- -->“</li><li>„<!-- -->Конфедерацията на независимите синдикати в България изразява принципната си подкрепа на направените предложения за изменения в законопроекта, внесен от Министерския съвет, като счита че те са сред най-съществените промени в настоящия данъчен пакет, но изразява и сериозни резерви за конкретния начин на тяхното прилагане, обяснени детайлно.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167523\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Петър Петров</b><span class=\"text-muted\"> (<!-- -->ВЪЗРАЖДАНЕ<!-- -->)</span>: „<!-- -->Уважаема госпожо Председател, ще помоля за прегласуване на така направеното искане, тъй като Столичната топлофикация предизвика през последните няколко месеца вниманието на обществото и все повече насочи вниманието към себе си не само заради огромната си задлъжнялост, която гони вече милиард и половина евро, а и също заради своята дейност, следствие от която почти ежедневно виждаме в репортажи по телевизиите – с…<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11195\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->11.11.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->НСОРБ; МРРБ по ЗИД на ЗМДТ №52-654-01-122; МФ по ЗИД на ЗМДТ № 52-654-01-122; Министерството на туризма; НСОРБ по Законопроект за изменение и допълнение на Закона за местните данъци и такси, № 52-654-01-122<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167523\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div></div></section><section id=\"mnenie\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Твоето мнение</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. <a href=\"/mnenie\">Всички закони за гласуване</a>.</p><div class=\"bg-surface rounded-sm p-5 text-[15px] text-muted\">Зарежда се…</div></section><section id=\"grupi\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласуваха групите по този закон</h2></div><p class=\"text-sm text-muted mb-3\">Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо <!-- -->3<!-- -->. Прието: <!-- -->1<!-- -->, отхвърлено: <!-- -->2<!-- -->.</p><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Прогресивна България</p><p class=\"num text-sm mt-1\">За: <b>1</b> · Против: <b>0</b> · общо <!-- -->3</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ГЕРБ – СДС</p><p class=\"num text-sm mt-1\">За: <b>0</b> · Против: <b>1</b> · общо <!-- -->3</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Демократична България</p><p class=\"num text-sm mt-1\">За: <b>2</b> · Против: <b>0</b> · общо <!-- -->3</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ДПС</p><p class=\"num text-sm mt-1\">За: <b>0</b> · Против: <b>1</b> · общо <!-- -->3</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Продължаваме промяната</p><p class=\"num text-sm mt-1\">За: <b>2</b> · Против: <b>1</b> · общо <!-- -->3</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Възраждане</p><p class=\"num text-sm mt-1\">За: <b>0</b> · Против: <b>3</b> · общо <!-- -->3</p></div></div><p class=\"text-sm mt-3\">Първо четене: <a href=\"/parlament/glasuvane/2026-11-11-13\">11 ноември 2026 г.</a><a href=\"/parlament/glasuvane/2026-11-11-14\">11 ноември 2026 г.</a><a href=\"/parlament/glasuvane/2026-11-11-15\">11 ноември 2026 г.</a></p></section><section id=\"glasuvaniya\" class=\"scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Всички гласувания по закона</h2></div><ul><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-11-11-13\">Закона за местните данъци и такси – първо гласуване - вносител Димитър Найденов и група н.п</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-muted border border-rule\">Отхвърлено</span></div><p class=\"text-sm text-muted mt-1\">11 ноември 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: Въздържал се · ГЕРБ – СДС: Въздържал се · Демократична България: За · ДПС: Въздържал се · Продължаваме промяната: За · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-11-11-14\">Закона за местните данъци и такси – първо гласуване - вносител Димитър Найденов и група н.п.</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-muted border border-rule\">Отхвърлено</span></div><p class=\"text-sm text-muted mt-1\">11 ноември 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: Въздържал се · ГЕРБ – СДС: Въздържал се · Демократична България: За · ДПС: Въздържал се · Продължаваме промяната: За · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-11-11-15\">Закона за местните данъци и такси – първо гласуване - вносител Министерски съвет</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">11 ноември 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: Против · Демократична България: Въздържал се · ДПС: Против · Продължаваме промяната: Против · Възраждане: Против</p></li></ul></section></div><!--$--><!--/$--></main><!--$--><!--/$--><footer class=\"bg-surface border-t border-rule mt-20\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 text-sm text-muted grid gap-2 sm:grid-cols-2\"><p>Не подкрепяме партия, кандидат или правителство. Всяко число има източник и дата.<!-- --> <a href=\"/metodologiya\">Как работим</a> · <a href=\"/rechnik\">Речник</a> · <a href=\"/sast