ote\"]\n39:I[97367,[\"$2\"],\"OutletBoundary\"]\n3b:I[27201,[\"$2\"],\"IconMark\"]\n16:[\"$\",\"li\",\"argumenti\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#argumenti\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Двете страни\"}]}]\n17:[\"$\",\"li\",\"mnenie\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#mnenie\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Твоето мнение\"}]}]\n18:[\"$\",\"li\",\"grupi\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#grupi\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Как гласуваха\"}]}]\n19:[\"$\",\"li\",\"glasuvaniya\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#glasuvaniya\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Гласувания (3)\"}]}]\n1a:[\"$\",\"section\",null,{\"id\":\"nakratko\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Накратко\"}],\"$undefined\",[\"$\",\"div\",null,{\"className\":\"max-w-4xl\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[17px]\",\"children\":\"Базисните стойности, от които се смята данъчната оценка на имотите, се вдигат поетапно спрямо стойността до края на 2026 г.: с 30% през 2027 г., с още 35 пункта през 2028 г. и с още 35 пункта през 2029 г. — до 2029 г. оценката става около два пъти по-висока. Новите оценки не се прилагат за таксата за битови отпадъци. Ефектът за общинските бюджети е +73,4 млн. € за 2027, +172,1 млн. € за 2028 и +270,8 млн. € за 2029 г. — т.е. по-висок данък сгради за собствениците. Отпадат невлезлите в сила текстове за патентен данък за заведенията (по становище на ЕК за държавна помощ). Глобите, непроменяни до 2019 г., се превалутират едно към едно в евро (на практика се удвояват).\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Вносители:\"}],\" \",\"Министерският съвет (представи зам.-министърът на финансите Людмила Петкова). Проект на Димитър Найденов и др. за отпадане на годишната декларация за туристическия данък беше отхвърлен.\",[\" · \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167623\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"законопроект \",\"52-602-01-59\"]}]]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Какво се случи:\"}],\" \",\"На първо четене (11.11.2026) правителственият проект мина със 124 „за“ и 48 „против“ (ГЕРБ–СДС, ДПС, ПП и „Възраждане“ против, ДБ се въздържа). Проектът на Найденов беше отхвърлен (152 въздържали се). В регионалната комисия правителственият проект получи 13 „за“ и 2 въздържали се. Министерствата на финансите и на туризма и сдружението на общините не подкрепиха проекта на Найденов, защото декларацията има контролна функция.\"]}]]}]]}]\n1b:[\"$\",\"section\",null,{\"id\":\"zakonoproekti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Кой внесе и кой се изказа\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.\"}],[[\"$\",\"ul\",null,{\"className\":\"space-y-4 max-w-5xl\",\"children\":[[\"$\",\"li\",\"167623\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167623\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за местните данъци и такси\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-602-01-59\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"5 ноември 2026 г.\",\" от \",\"Министерския съвет\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по бюджет и финанси (водеща); Комисия по регионална политика, благоустройство и местно самоуправление (участваща)\"}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Становища\"}],[\"$\",\"dd\",null,{\"children\":\"КНСБ по ЗИД на ЗМДТ-59; НСОРБ по ЗИД на ЗМДТ-59; НСОРБ по ЗМДТ 52-602-01-59; БСК по ЗИД на ЗМДТ-59\"}]],false,false,false,[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Предложения\"}],[\"$\",\"dd\",null,{\"children\":[7,\" писмени предложения на депутати между \",[\"$\",\"$L2d\",null,{\"k\":\"parvo-chetene\",\"children\":\"първо\"}],\" и \",[\"$\",\"$L2d\",null,{\"k\":\"vtoro-chetene\",\"children\":\"второ четене\"}]]}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"В залата\"}],[\"$\",\"dd\",null,{\"children\":[[\"$\",\"span\",\"0\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11195\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"11 ноември 2026 г.\"}],\" (\",\"зала първо гласуване\",\")\"]}]]}]],null]}]]}],[\"$\",\"li\",\"167523\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167523\",\"target\":\"_blank\",\"r