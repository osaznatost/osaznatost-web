m bg-white\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold px-4 pt-3\",\"children\":[\"Нарушителите\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167623\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-59, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}],[\"$\",\"div\",null,{\"className\":\"grid sm:grid-cols-2 gap-px bg-rule mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-white px-4 py-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-[#2f7d57] mb-0.5\",\"children\":\"Печели\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"—\"}]]}],[\"$\",\"div\",null,{\"className\":\"bg-white px-4 py-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-red mb-0.5\",\"children\":\"Губи\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"На практика двойно по-високи глоби.\"}]]}]]}]]}]]}]]}]\n31:[\"$\",\"div\",null,{\"className\":\"mt-8 text-sm\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Източници\"}],[\"$\",\"ol\",null,{\"className\":\"list-decimal pl-5 space-y-0.5\",\"children\":[[\"$\",\"li\",\"https://www.parliament.bg/bg/bills/ID/167623\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167623\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Народно събрание: законопроект № 52-602-01-59, доклади и становища\"}]}],[\"$\",\"li\",\"https://naiasno.bg/parliament\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://naiasno.bg/parliament\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Поименни гласувания, Народно събрание (чрез „Наясно“)\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-2\",\"children\":[\"Обобщението е по докладите на бюджетната и регионалната комисия. Изводът „около два пъти“ е наш: увеличенията са спрямо стойността до 2026 г. (30% + 35% + 35%), което съответства и на бюджетния ефект по години.\",\" Проверено: \",\"19 ноември 2026 г.\"]}]]}]\n32:[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Асоциацията на индустриалния капитал в България подкрепят по принцип поетапното осъвременяване на данъчните оценки, като настояват санкциите да бъдат преработени и прилагането на принципа „замърсителят плаща“ да не бъде отлагано.\",\"“\"]}]\n33:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167623\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]\n34:null\n35:[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#e08a2e] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"В пленарната зала\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"b\",null,{\"children\":\"Петър Петров\"}],[\"$\",\"span\",null,{\"className\":\"text-muted\",\"children\":[\" (\",\"ВЪЗРАЖДАНЕ\",\")\"]}],\": „\",\"Уважаема госпожо Председател, ще помоля за прегласуване на така направеното искане, тъй като Столичната топлофикация предизвика през последните няколко месеца вниманието на обществото и все повече насочи вниманието към себе си не само заради огромната си задлъжнялост, която гони вече милиард и половина евро, а и също заради своята дейност, следствие от която почти ежедневно виждаме в репортажи по телевизиите – с…\",\"“ \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11195\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm whitespace-nowrap\",\"children\":[\"стенограма, \",\"11.11.2026\"]}]]}]]}]]}]\n36:[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"КНСБ по ЗИД на ЗМДТ-59; НСОРБ по ЗИД на ЗМДТ-59; НСОРБ по ЗМДТ 52-602-01-59; БСК по ЗИД на ЗМДТ-59\",\". \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167623\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Текстовете в parliament.bg\"}]]}]\n37:[\"$\",\"div\",\"167523\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167523\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за местните данъци и такси\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-654-01-122\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Предлага се и Министерството на финансите да осигури на общините служебен достъп до данните от ЕСТИ, което е предвидено да става в тридневен срок от получаването им от Министерството на туризма.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Тя отбеляза, че декларацията има самостоятелна, контролна функция и материализира годишното изявление на данъчно задължените лица, и допълни, че отпадането на декларацията би било оправдано, когато Единната система за туристическа информация започне да предоставя равностойна или по-висока степен на доказуемост.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Тя посочи, че данните в ЕСТИ се въвеждат единствено от хотелиерите и не се валидират от общински данъчни служители, което поставя под въпрос гарантирането истинността на данните в системата.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"В изложението си г-жа Петкова акцентира, че със законопроекта се предлага поетапна актуализация на базисните данъчни стойности, използвани при определяне на данъчната оценка на недвижимите имоти.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Определената данъчната оценка, изготвена по новия ред, няма да се прилага за целите на определяне на таксата за битови отпадъци.\",\"“\"]}],[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"Предвижда се и удължаване на срока за връчване на съобщенията за определяне на данъка върху недвижимите имоти, както и срокът за ползване на отстъпката за предплатилите за цялата 2027 година.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167523\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#8a8f8c] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Позиции, изказани в комисията\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Господин Георги Тодоров представи становището на Министерството на туризма, като посочи, че предложеният законопроект е малка част от големия пакет законодателни мерки, които правителството подготвя с цел намаляване на административната тежест в сектор данъци и такси и в сектор туризъм по отношение на изсветляване на бизнеса.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Заместник-министърът отбеляза, че се предвижда реинженеринг на Единната система за туристическа информация и допълни, че моментът и начинът, по който се предлага изменението в Закона за местните данъци и такси, са неподходящи и неправилни.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Тя представи накратко становището на Министерството на финансите, като отбеляза, че с отмяната на декларацията по чл. 61р, ал. 5 от Закона за местните данъци и такси се премахва и един самостоятелен източник за проверка и съпоставка на данните, като същевременно с това данъчно задълженото лице ще бъде лишено от механизъм за отразяване на корекциите на данни.\",\"“\"]}]]}],\"$L3c\"]}],\"$L3d\",\"$L3e\",\"$L3f\"]}]]}]]}]\n3a:null\n2c:true\nd:C\n3c:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167523\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]\n3d:[\"$\",\"div\",null,{\"className\":\"border-l-4 border-red pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Възражения и критики\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"От името на вносителя законопроектът беше представен от г-н Димитър Найденов, който посочи, че с него се цели да се намали административната тежест за лицата, предлагащи нощувки, като отпадне ежегодното деклариране на данни, с които администрацията разполага, както и по-ясно разграничаване на функциите на Министерството на туризма и Министерството на финансите при служебния обмен на данните от Единната система за туристическа информация (ЕСТИ).\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Тя обърна внимание и върху възражението на Министерството на финансите срещу незабавното влизане на закона в сила, тъй като липсата на технически възможности за служебен обмен и корекция на данните би създало практически затруднения.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"В хода на дискусията народният представител Ясен Щерев изрази съгласие с идеята за намаляване на административната тежест за туристическия бизнес, но възрази срещу отпадането на декларацията по чл. 61р, ал. 5 от Закона за местните данъци и такси с оглед несъвършенствата на Единната система за туристическа информация, като допълни, че той ще се въздържи от подкрепа на законопроекта.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"Той посочи, че целта е да се намали административната тежест за лицата, предлагащи нощувки, като отпадне ежегодното деклариране на данни, с които администрацията вече разполага.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Очаква се да отпадне една ежегодна декларационна тежест за туристическия сектор, да се намали административната работа по приемане и обработване на декларациите и да се ограничат грешките при повторното пренасяне на данни.\",\"“\"]}],[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"Конфедерацията на независимите синдикати в България изразява принципната си подкрепа на направените предложения за изменения в законопроекта, внесен от Министерския съвет, като счита че те са сред най-съществените промени в настоящия данъчен пакет, но изразява и сериозни резерви за конкретния начин на тяхното прилагане, обяснени детайлно.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167523\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}]\n3e:[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#e08a2e] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"В пленарната зала\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"b\",null,{\"children\":\"Петър Петров\"}],[\"$\",\"span\",null,{\"className\":\"text-muted\",\"children\":[\" (\",\"ВЪЗРАЖДАНЕ\",\")\"]}],\": „\",\"Уважаема госпожо Председател, ще помоля за прегласуване на така направеното искане, тъй като Столичната топлофикация предизвика през последните няколко месеца вниманието на обществото и все повече насочи вниманието към себе си не само заради огромната си задлъжнялост, която гони вече милиард и половина евро, а и също заради своята дейност, следствие от която почти ежедневно виждаме в репортажи по телевизиите – с…\",\"“ \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11195\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm whitespace-nowrap\",\"children\":[\"стенограма, \",\"11.11.2026\"]}]]}]]}]]}]\n3f:[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"НСОРБ; МРРБ по ЗИД на ЗМДТ №52-654-01-122; МФ по ЗИД на ЗМДТ № 52-654-01-122; Министерството на туризма; НСОРБ по Законопроект за изменение и допълнение на Закона за местните данъци и такси, № 52-654-01-122\",\". \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167523\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Текстовете в parliament.bg\"}]]}]\n2b:0\n14:\"$undefined\"\n12:\"$undefined\"\nf:\"$undefined\"\nc:\"$undefined\"\n2a:\"$undefined\"\n23:\"$undefined\"\n"}}