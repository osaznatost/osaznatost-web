,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11171\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm whitespace-nowrap\",\"children\":[\"стенограма, \",\"17.09.2026\"]}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"b\",null,{\"children\":\"Христина Велинова\"}],null,\": „\",\"Предложеният Закон за изменение и допълнение на Закона за автомобилните\",\"“ \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11180\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm whitespace-nowrap\",\"children\":[\"стенограма, \",\"01.10.2026\"]}]]}]]}]]}]\n2c:[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"МФ по ЗИД на ЗЕИ, № 52-654-01-121; МВР по ЗИД на ЗЕИ, № 52-654-01-121\",\". \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167522\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Текстовете в parliament.bg\"}]]}]\n2d:[\"$\",\"div\",\"167154\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167154\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за електронната идентификация\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-654-01-76\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Предвижда се конкурентен модел на европейски портфейли за цифрова самоличност, т.е. всеки доставчик, който отговаря на условията на регламента, ще може да създаде такъв портфейл и да предоставя чрез него услуги.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"С оглед на необходимостта от спазване на изискването за безплатно използване на квалифицирани електронни подписи от гражданите за лични нужди, със законопроекта се предлага и приемането на методика за определяне на стойността на квалифицираните електронни подписи с оглед на тяхното заплащане към доставчиците.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Предлага се изграждането на приложение, чрез което да могат да се извършват редица административни услуги по електронен път.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"Божидар Божанов, който заяви че със законопроекта се предвижда привеждане на националната нормативна уредба в съответствие с Регламент (ЕС) 2024/1183, включително уреждане на необходимите въпроси на национално ниво, свързани с европейските портфейли за цифрова самоличност.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Регламентът допуска конкурентен модел на портфейли, предоставяни от различни доставчици.\",\"“\"]}],[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"Със законопроекта се предвижда и механизъм за определяне на стойността на квалифицираните електронни подписи, използвани от физически лица за лични нужди, с оглед осигуряване на безплатното им използване.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167154\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\