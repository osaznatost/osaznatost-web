face no-underline text-ink hover:ring-1 hover:ring-green\\\",\\\"children\\\":\\\"Как гласуваха\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"glasuvaniya\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#glasuvaniya\\\",\\\"className\\\":\\\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\\\",\\\"children\\\":\\\"Гласувания (30)\\\"}]}]]}]}],[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"nakratko\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Накратко\\\"}],\\\"$undefined\\\",[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"max-w-4xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[17px]\\\",\\\"children\\\":\\\"Правителственият законопроект въвежда в българското право европейските правила за единно разрешение за пребиваване и работа на граждани на трети държави и за проверка (скрининг) на външните граници. Работодател, по чиято вина чужденец загуби достъп до пазара на труда, ще му дължи обезщетение, а при осигурено от работодателя жилище за сезонен работник се изисква писмен договор за наем. Чрез промени в други закони срокът за обикновена услуга за лични документи пада от 30 на 20 дни, а служебните паспорти могат да се ползват само за служебни пътувания.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"children\\\":\\\"Вносители:\\\"}],\\\" \\\",\\\"Министерският съвет (представи министърът на вътрешните работи). Отделен проект на Божидар Божанов и др. (ДБ) беше отхвърлен.\\\",[\\\" · \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167465\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":[\\\"законопроект \\\",\\\"52-602-01-29\\\"]}]]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"children\\\":\\\"Какво се случи:\\\"}],\\\" \\\",\\\"На първо четене (16.09.2026) правителственият проект мина със 151 „за“ (ГЕРБ–СДС се въздържаха, „Възраждане“ против). Проектът на ДБ за задължителна електронна платформа за разрешенията за работа беше отхвърлен със 133 „против“. Двете комисии предложиха да не се приема: „Прогресивна България“ гласува против, ДБ и ПП — за. Окончателно приет на 18.11.2026 г. (наименованието — 158 „за“, 6 „против“).\\\"]}]]}]]}],\\\"$L1b\\\",\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\",\\\"$L1f\\\",\\\"$L20\\\",\\\"$L21\\\"]}]\\n2f:I[52368,[\\\"$2\\\",\\\"$9\\\"],\\\"CitizenVote\\\"]\\n1b:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"signali\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Сигнали\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":\\\"Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.\\\"}],[[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"grid gap-3 md:grid-cols-2 max-w-5xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"3 нови текста, приети на второ четене\\\",{\\\"className\\\":\\\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold\\\",\\\"children\\\":\\\"3 нови текста, приети на второ четене\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mt-1\\\",\\\"children\\\":\\\"Текстове, които ги нямаше в първоначалния законопроект. Обикновено са поправки, но могат и да променят смисъла.\\\"}]]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm mt-3\\\",\\\"children\\\":[\\\"$\\\",\\\"$La\\\",null,{\\\"href\\\":\\\"/parlament/signali