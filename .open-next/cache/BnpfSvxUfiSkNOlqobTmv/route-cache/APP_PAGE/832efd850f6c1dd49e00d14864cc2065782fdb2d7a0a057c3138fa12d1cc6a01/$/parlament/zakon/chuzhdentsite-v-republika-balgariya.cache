ll,{\"className\":\"list-none pl-0 space-y-1\",\"children\":[[\"$\",\"li\",\"България изпълнява европейските правила и избягва санкции по процедурата за нарушение.\",{\"className\":\"text-[15px] pl-4 relative before:content-['+'] before:absolute before:left-0 before:font-bold\",\"children\":\"България изпълнява европейските правила и избягва санкции по процедурата за нарушение.\"}],[\"$\",\"li\",\"Служебните паспорти не могат да се ползват за лични пътувания.\",{\"className\":\"text-[15px] pl-4 relative before:content-['+'] before:absolute before:left-0 before:font-bold\",\"children\":\"Служебните паспорти не могат да се ползват за лични пътувания.\"}]]}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-red\",\"children\":\"Рискът и цената\"}],[\"$\",\"ul\",null,{\"className\":\"list-none pl-0 space-y-1\",\"children\":[[\"$\",\"li\",\"Електронизацията на разрешенията за работа (предложението на ДБ) остава извън закона; повечето заявления продължават на хартия.\",{\"className\":\"text-[15px] pl-4 relative before:content-['−'] before:absolute before:left-0 before:font-bold\",\"children\":\"Електронизацията на разрешенията за работа (предложението на ДБ) остава извън закона; повечето заявления продължават на хартия.\"}]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Ако се отхвърли\"}],[\"$\",\"div\",null,{\"className\":\"space-y-2 mt-3\",\"children\":[false,[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-red\",\"children\":\"Рискът и цената\"}],[\"$\",\"ul\",null,{\"className\":\"list-none pl-0 space-y-1\",\"children\":[[\"$\",\"li\",\"Риск от санкции от Европейската комисия.\",{\"className\":\"text-[15px] pl-4 relative before:content-['−'] before:absolute before:left-0 before:font-bold\",\"children\":\"Риск от санкции от Европейската комисия.\"}],[\"$\",\"li\",\"Остава празнотата за служебните паспорти.\",{\"className\":\"text-[15px] pl-4 relative before:content-['−'] before:absolute before:left-0 before:font-bold\",\"children\":\"Остава празнотата за служебните паспорти.\"}]]}]]}]]}]]}]]}]]}]\n27:[\"$\",\"div\",null,{\"className\":\"mt-8\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.8rem] mb-1\",\"children\":\"Какво печели и какво губи всяка страна\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mb-3\",\"children\":\"Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"div\",\"Работници от трети държави\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold px-4 pt-3\",\"children\":[\"Работници от трети държави\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167465\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-29 (Министерски съвет), доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}],[\"$\",\"div\",null,{\"className\":\"grid sm:grid-cols-2 gap-px bg-rule mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-white px-4 py-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-[#2f7d57] mb-0.5\",\"children\":\"Печели\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"Едно разрешение за пребиваване и работа и защита при загуба на работата по вина на работодателя.\"}]]}],[\"$\",\"div\",null,{\"className\":\"bg-white px-4 py-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-red mb-0.5\",\"children\":\"Губи\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"Нищо пряко.\"}]]}]]}]]}],[\"$\",\"div\",\"Работодатели\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold px-4 pt-3\",\"children\":[\"Работодатели\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167465\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-29 (Министерски съвет), доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}],[\"$\",\"div\",null,{\"className\":\"grid sm:grid-cols-2 gap-px bg-rule mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-white px-4 py-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-[#2f7d57] mb-0.5\",\"children\":\"Печели\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"По-ясна процедура за наемане на чужденци.\"}]]}],[\"$\",\"div\",null,{\"className\":\"bg-white px-4 py-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-red mb-0.5\",\"children\":\"Губи\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"Обезщетение при отнет достъп до пазара на труда по тяхна вина и задължителен договор за жилището на сезонните работници.\"}]]}]]}]]}],[\"$\",\"div\",\"Гражданите\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold px-4 pt-3\",\"children\":[\"Гражданите\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167465\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-29 (Министерски съвет), доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}],[\"$\",\"div\",null,{\"className\":\"grid sm:grid-cols-2 gap-px bg-rule mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-white px-4 py-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-[#2f7d57] mb-0.5\",\"children\":\"Печели\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"По-бързо издаване на лични документи (20 вместо 30 дни).\"}]]}],[\"$\",\"div\",null,{\"className\":\"bg-white px-4 py-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-red mb-0.5\",\"children\":\"Губи\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"—\"}]]}]]}]]}]]}]]}]\n28:[\"$\",\"div\",null,{\"className\":\"mt-8 text-sm\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Източници\"}],[\"$\",\"ol\",null,{\"className\":\"list-decimal pl-5 space-y-0.5\",\"children\":[[\"$\",\"li\",\"https://www.parliament.bg/bg/bills/ID/167465\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167465\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Народно събрание: законопроект № 52-602-01-29 (Министерски съвет), доклади и становища\"}]}],[\"$\",\"li\",\"https://www.parliament.bg/bg/bills/ID/167498\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167498\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Народно събрание: законопроект № 52-654-01-111 (Б. Божанов и др.), доклади на две комисии\"}]}],[\"$\",\"li\",\"https://naiasno.bg/parliament\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://naiasno.bg/parliament\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Поименни гласувания, Народно събрание (чрез „Наясно“)\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-2\",\"children\":[\"Обобщението е по докладите на комисиите за първо гласуване. „Какво печели и какво губи всяка страна“ е наш анализ.\",\" Проверено: \",\"19 ноември 2026 г.\"]}]]}]\n29:[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Госпожа Стойкова посочи, че МВР е представило отрицателно становище по разглеждания законопроект.\",\"“\"]}]]}]\n2a:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167498\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]\n2b:[\"$\",\"div\",null,{\"className\":\"border-l-4 border-red pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Възражения и критики\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Основните възражения са, че трябва да се включат всички участващи институции в лицето на Министерството на външните работи и трябва да бъде уредено и електронното уведомяване за нередовности в документите и даването на указания за тяхното отстраняване.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"МТСП не подкрепя законопроекта, въпреки че подкрепя идеята за дигитализация и централизиране на процедурите поради непълнота и частичното дублиране на приета нормативна уредба.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"В последвалата дискусия се изказаха становища и се зададоха въпроси от народни представители, а присъстващият представител на Министерството на труда и социалната политика даде разяснения и изказа своите възражения.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167498\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}]\n2c:[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#e08a2e] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"В пленарната зала\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"b\",null,{\"children\":\"Венцислав Катинов\"}],null,\": „\",\"С предложения на Вашето внимание законопроект се предлагат мерки на национално ниво, необходими за осигуряване на изпълнението на правни актове на Европейския съюз, а\",\"“ \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11170\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm whitespace-nowrap\",\"children\":[\"стенограма, \",\"16.09.2026\"]}]]}]]}]]}]\n2d:[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"МТСП- сановище; МВР-становище; БСК - становище; ДАНС по ЗИД на ЗЧРБ, № 52-654-01-111; АЗ по ЗИД на ЗЧРБ, № 52-654-01-111; МВнР по ЗИД на ЗЧРБ, № 52-654-01-111; МВР по ЗИД на ЗЧРБ, № 52-654-01-111; БСК по ЗИД на ЗЧРБ, № 52-654-01-111\",\". \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167498\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Текстовете в parliament.bg\"}]]}]\n2e:[\"$\",\"div\",\"167465\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167465\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за чужденците в Република България\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-602-01-29\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Част от предложенията са свързани с целта да отразят в Закона за МВР изискванията на Регламент (ЕС) 2024/1356 на Европейския парламент и на Съвета от 14 май 2024 година за въвеждане на скрининг на граждани на трети държави на външните граници.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Законопроектът предвижда и промени в Закона за българските лични документи за отразяване на заложеното в Плана за действие за внедряване на административни услуги на принципа „епизод от живота“, стъпка 4 „Намаляване сроковете за обикновена и бърза услуга за издаване на СУМПС и останалите български документи за самоличност“.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Предлагат се и промени в Закона за здравето, за да се уредят изискванията на Регламент (ЕС) 2024/1356 по отношение на граждани на трети страни, подложени на скрининг процедури, така че да им бъде осигурен достъп до здравни грижи.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"Друга важна за практиката цел е въвеждането на процедура за смяна на длъжността след 6 месеца работа, която може да се инициира от работодателя или от самия чужденец.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Също така е необходима и промяна в Закона за трудовата миграция и трудовата мобилност, свързана с изпълнение на препоръките на Европейската комисия по процедура за нарушение № 2023/2017, с които се цели осигуряване правилното прилагане на Директива 2014/36/ЕС относно условията за влизане и престой на граждани на трети държави с цел заетост като сезонни работници.\",\"“\"]}],[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"В тази връзка се предвижда, когато достъпът до пазара на труда бъде отнет по вина на работодателя, той да дължи на чужденеца обезщетение.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167465\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],null,null,[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#e08a2e] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"В пленарната зала\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"b\",null,{\"children\":\"Венцислав Катинов\"}],null,\": „\",\"С предложения на Вашето внимание законопроект се предлагат мерки на национално ниво, необходими за осигуряване на изпълнението на правни актове на Европейския съюз, а\",\"“ \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11170\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm whitespace-nowrap\",\"children\":[\"стенограма, \",\"16.09.2026\"]}]]}]]}]]}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"КТ\\\" Подкрепа\\\" - Вх.№ КТДСП-52-629-00-2; БТПП- Вх.№ КТДСП-52-624-00-1; КНСБ-становище с вх.№ КТДСП-52-629-00-3; БСК-вх. № КТДСП-52-616-01-2; по ЗИД на ЗЧРБ, № 52-602-01-29; Петър Марков по ЗИД на ЗЧРБ, № 52-602-01-29; БСК по ЗИД на ЗЧРБ, № 52-602-01-29; ФАР по ЗИД на ЗЧРБ, № 52-602-01-29; ВКБООН по ЗИД на ЗЧРБ, № 52-602-01-29; адв. Полина Берг по ЗИД на ЗЧРБ; адв. Петър Марков по ЗИД на ЗЧРБ, № 52-602-01-29; \\\"ЕЛАНА\\\" АД  по ЗЧРБ\",\". \",\"$L3e\"]}]]}]]}]]}]\n30:[\"$\",\"span\",null,{\"className\":\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\",\"children\":\"Прието\"}]\n31:[\"$\",\"p\",null,{\"className\":\"text-sm text-mute