children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted\\\",\\\"children\\\":\\\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mt-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167498\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"className\\\":\\\"text-ink\\\",\\\"children\\\":\\\"Законопроект за изменение и допълнение на Закона за чужденците в Република България\\\"}],\\\" \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-muted num font-normal\\\",\\\"children\\\":[\\\"№ \\\",\\\"52-654-01-111\\\"]}]]}],[\\\"$\\\",\\\"details\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer font-semibold text-green mt-2\\\",\\\"children\\\":\\\"Покажи цитатите\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-5 mt-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-green pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Какво предлага законопроектът\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"Предлага се през тази Платформа да се извършва не само заявяванията на съответните услуги, но и обменът на данни между институциите в процедурата.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"С това вносителите целят нормативно да се уреди не само по-бърза и ефективна обработка на заявленията, но и прилагане на разпределение на преписките на случаен принцип, с което да се постигне намаляване на корупционния елемент при издаване на разрешенията за работа.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[\\\"„\\\",\\\"Предложеният законопроект урежда и субектите с право на достъп до тази Платформа – директорът на ДАНС, на Агенцията по заетостта и на изпълнителния директор на ИА „Главна инспекция по труда“.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[\\\"„\\\",\\\"В становището си Българската стопанска камара подкрепя законопроекта, като посочва, че той представлява достатъчна нормативна основа за разширяване на приложимостта на действащата електронна система за издаване на разрешения за работа и ще улесни положението на работодателите.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"children\\\":[\\\"„\\\",\\\"Господин Божанов посочи, че с предложения законопроект се предлага въвеждане на изрична законова уредба за използване на автоматизирана информационна система „Платформа за производство за издаване на разрешения за пребиваване и работа“ при обработването и обмена на информация във връзка с подадени заявления за издаване на разрешения за пребиваване и работа, както и при декларациите за регистрация на сезонна работа до 90 дни.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"5\\\",{\\\"children\\\":[\\\"„\\\",\\\"Със законопроекта се предлага създаването на нова разпоредба, с което се цели да се осигури по-голяма прозрачност, предвидимост и ефективност при разглеждането на заявленията за пребиваване и работа, като за целта се въведе единна електронна среда за взаимодействие между компетентните институции.\\\",\\\"“\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted mt-1\\\",\\\"children\\\":[\\\"Източник: \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167498\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":\\\"доклад на комисията и мотиви, parliament.bg\\\"}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-[#8a8f8c] pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Позиции, изказани в комисията\\\"}],\\\"$L29\\\",\\\"$L2a\\\"]}],\\\"$L2b\\\",\\\"$L2c\\\",\\\"$L2d\\\"]}]]}]]}],\\\"$L2e\\\"]}]]}]\\n1f:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"mnenie\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Твоето мнение\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":[\\\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \\\",[\\\"$\\\",\\\"$La\\\",null,{\\\"href\\\":\\\"/mnenie\\\",\\\"children\\\":\\\"Всички закони за гласуване\\\"}],\\\".\\\"]}],[\\\"$\\\",\\\"$L2f\\\",null,{\\\"item\\\":\\\"chuzhdentsite-v-republika-balgariya\\\",\\\"question\\\":\\\"Подкрепяш ли последните промени в „Закон за чужденците в Република България (единно разрешение за пребиваване и работа, сезонни работници, служебни паспорти)“?\\\"}]]}]\\n20:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"grupi\\\",\\\"className\\\":\\\"mb-12 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-end justify-between gap-4 mb-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2rem] sm:text-[2.4rem]\\\",\\\"children\\\":\\\"Как гласуваха групите по този закон\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted mb-3\\\",\\\"children\\\":[\\\"Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо \\\",30,\\\". Прието: \\\",22,\\\", отхвърлено: \\\",8,\\\".\\\"]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"ПБ\\\",{\\\"className\\\":\\\"border border-rule rounded-sm p-4\\\",\\\"children\\\":[[\