{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/zakon/layout,_N_T_/parlament/zakon/[slug]/layout,_N_T_/parlament/zakon/[slug]/page,_N_T_/parlament/zakon/chuzhdentsite-v-republika-balgariya"},"segmentPaths":["/_tree","/_full","/parlament/zakon/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/832efd850f6c1dd49e00d14864cc2065782fdb2d7a0a057c3138fa12d1cc6a01/$/parlament/zakon/chuzhdentsite-v-republika-balgariya","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/zakon/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0vn96-fhbu77m.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><script src=\"/_next/static/chunks/43gzry38n6x69.js\" async=\"\"></script><title>Закон за чужденците в Република България · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Закон за чужденците в Република България · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Закон за чужденците в Република България · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Парламент</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Закон</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Закон за чужденците в Република България</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Приет на второ четене на 18.11.2026 г.</div></div></div><nav aria-label=\"Секции на страницата\" class=\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\"><ul class=\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\"><li><a href=\"#nakratko\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Накратко</a></li><li><a href=\"#signali\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Сигнали (1)</a></li><li><a href=\"#zakonoproekti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Кой внесе и кой се изказа</a></li><li><a href=\"#argumenti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Двете страни</a></li><li><a href=\"#mnenie\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Твоето мнение</a></li><li><a href=\"#grupi\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Как гласуваха</a></li><li><a href=\"#glasuvaniya\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Гласувания (30)</a></li></ul></nav><section id=\"nakratko\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Накратко</h2><div class=\"max-w-4xl\"><p class=\"text-[17px]\">Правителственият законопроект въвежда в българското право европейските правила за единно разрешение за пребиваване и работа на граждани на трети държави и за проверка (скрининг) на външните граници. Работодател, по чиято вина чужденец загуби достъп до пазара на труда, ще му дължи обезщетение, а при осигурено от работодателя жилище за сезонен работник се изисква писмен договор за наем. Чрез промени в други закони срокът за обикновена услуга за лични документи пада от 30 на 20 дни, а служебните паспорти могат да се ползват само за служебни пътувания.</p><p class=\"mt-3 text-[15px]\"><b>Вносители:</b> <!-- -->Министерският съвет (представи министърът на вътрешните работи). Отделен проект на Божидар Божанов и др. (ДБ) беше отхвърлен.<!-- --> · <a href=\"https://www.parliament.bg/bg/bills/ID/167465\" target=\"_blank\" rel=\"noreferrer\">законопроект <!-- -->52-602-01-29</a></p><p class=\"mt-3 text-[15px]\"><b>Какво се случи:</b> <!-- -->На първо четене (16.09.2026) правителственият проект мина със 151 „за“ (ГЕРБ–СДС се въздържаха, „Възраждане“ против). Проектът на ДБ за задължителна електронна платформа за разрешенията за работа беше отхвърлен със 133 „против“. Двете комисии предложиха да не се приема: „Прогресивна България“ гласува против, ДБ и ПП — за. Окончателно приет на 18.11.2026 г. (наименованието — 158 „за“, 6 „против“).</p></div></section><section id=\"signali\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Сигнали</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.</p><ul class=\"grid gap-3 md:grid-cols-2 max-w-5xl\"><li class=\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\"><p class=\"font-semibold\">3 нови текста, приети на второ четене</p><p class=\"text-[15px] text-muted mt-1\">Текстове, които ги нямаше в първоначалния законопроект. Обикновено са поправки, но могат и да променят смисъла.</p></li></ul><p class=\"text-sm mt-3\"><a href=\"/parlament/signali\">Всички сигнали в парламента</a></p><p class=\"text-xs text-muted mt-2\">Сигналът е повод за въпрос, не доказателство за нарушение.<!-- --> <a class=\"underline\" href=\"/metodologiya#signal\">Как работим със сигналите</a></p></section><section id=\"zakonoproekti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Кой внесе и кой се изказа</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.</p><ul class=\"space-y-4 max-w-5xl\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167498\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за чужденците в Република България</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-111</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>30 юли 2026 г.<!-- --> от <!-- -->Божидар Божанов, Надежда Йорданова, Йордан Иванов и още 9 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по вътрешна сигурност и обществен ред (водеща); Комисия по труда, демографската и социалната политика (участваща); Комисия по икономическа политика, инвестиции и индустрия (участваща); Комисия за контрол над службите за сигурност, прилагането и използването на специалните разузнавателни средства и достъпа до данните по Закона за електронните съобщения (участваща); Комисия по иновациите и дигиталната трансформация (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>МТСП- сановище; МВР-становище; БСК - становище; ДАНС по ЗИД на ЗЧРБ, № 52-654-01-111; АЗ по ЗИД на ЗЧРБ, № 52-654-01-111; МВнР по ЗИД на ЗЧРБ, № 52-654-01-111; МВР по ЗИД на ЗЧРБ, № 52-654-01-111; БСК по ЗИД на ЗЧРБ, № 52-654-01-111</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11170\" target=\"_blank\" rel=\"noreferrer\">16 септември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167465\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за чужденците в Република България</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-602-01-29</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>28 юли 2026 г.<!-- --> от <!-- -->Министерския съвет</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по вътрешна сигурност и обществен ред (водеща); Комисия по европейските въпроси и контрол на европейските фондове (участваща); Комисия по икономическа политика, инвестиции и индустрия (участваща); Комисия по труда, демографската и социалната политика (участваща); Комисия по здравеопазването (участваща); Комисия по транспорт и съобщения (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>КТ&quot; Подкрепа&quot; - Вх.№ КТДСП-52-629-00-2; БТПП- Вх.№ КТДСП-52-624-00-1; КНСБ-становище с вх.№ КТДСП-52-629-00-3; БСК-вх. № КТДСП-52-616-01-2; по ЗИД на ЗЧРБ, № 52-602-01-29; Петър Марков по ЗИД на ЗЧРБ, № 52-602-01-29; БСК по ЗИД на ЗЧРБ, № 52-602-01-29; ФАР по ЗИД на ЗЧРБ, № 52-602-01-29; ВКБООН по ЗИД на ЗЧРБ, № 52-602-01-29; адв. Полина Берг по ЗИД на ЗЧРБ; адв. Петър Марков по ЗИД на ЗЧРБ, № 52-602-01-29; &quot;ЕЛАНА&quot; АД  по ЗЧРБ</dd><dt class=\"text-muted\">Предложения</dt><dd>5<!-- --> писмени предложения на депутати между <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">първо</button></span> и <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">второ четене</button></span></dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11170\" target=\"_blank\" rel=\"noreferrer\">16 септември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span><span>, <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11198\" target=\"_blank\" rel=\"noreferrer\">18 ноември 2026 г.</a> (<!-- -->зала второ гласуване<!-- -->)</span></dd></dl></li></ul></section><div id=\"argumenti\" class=\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\"><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Министър Иван Демерджиев (за Министерския съвет)</p><p class=\"text-[15px]\">Законът изпълнява Директива (ЕС) 2024/1233 за единното разрешение и Регламент (ЕС) 2024/1356 за скрининга, както и препоръки на Европейската комисия по процедура за нарушение за сезонните работници.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167465\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-29 (Министерски съвет), доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Министър Иван Демерджиев</p><p class=\"text-[15px]\">Сега няма изрично ограничение за ползването на служебни паспорти; новият текст ги ограничава до служебни пътувания, за да не се злоупотребява с безвизовия режим.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167465\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-29 (Министерски съвет), доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Божидар Божанов (ДБ), за отхвърления проект</p><p class=\"text-[15px]\">Всички заявления за разрешения за работа да минават през електронна платформа с разпределение на преписките на случаен принцип, за да намалее корупцията.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167498\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-111 (Б. Божанов и др.), доклади на две комисии\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">МВР (становище по проекта на ДБ)</p><p class=\"text-[15px]\">Платформата не работи ефективно: МВнР и ДАНС не я използват. През 2025 г. на хартия са подадени 31 000 заявления, а през платформата — 1 500.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167498\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-111 (Б. Божанов и др.), доклади на две комисии\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Министерството на труда и социалната политика</p><p class=\"text-[15px]\">Не подкрепя проекта на ДБ, въпреки че подкрепя дигитализацията, заради непълнота и дублиране на вече приети правила.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167498\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-111 (Б. Божанов и др.), доклади на две комисии\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">„Възраждане“</p><p class=\"text-[15px]\">Гласуваха против правителствения проект на първо и второ четене.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\" title=\"Поименни гласувания, Народно събрание (чрез „Наясно“)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Двете страни на монетата</h3><p class=\"text-sm text-muted mb-3\">Какво следва на практика, ако законът се приеме и ако се отхвърли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167465\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-29 (Министерски съвет), доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a><a href=\"https://www.parliament.bg/bg/bills/ID/167498\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-111 (Б. Божанов и др.), доклади на две комисии\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\"><p class=\"font-semibold\">Ако се приеме</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">България изпълнява европейските правила и избягва санкции по процедурата за нарушение.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Служебните паспорти не могат да се ползват за лични пътувания.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Електронизацията на разрешенията за работа (предложението на ДБ) остава извън закона; повечето заявления продължават на хартия.</li></ul></div></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\"><p class=\"font-semibold\">Ако се отхвърли</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Риск от санкции от Европейската комисия.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Остава празнотата за служебните паспорти.</li></ul></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Какво печели и какво губи всяка страна</h3><p class=\"text-sm text-muted mb-3\">Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.</p><div class=\"space-y-3\"><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Работници от трети държави<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167465\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-29 (Министерски съвет), доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Едно разрешение за пребиваване и работа и защита при загуба на работата по вина на работодателя.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Нищо пряко.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Работодатели<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167465\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-29 (Министерски съвет), доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">По-ясна процедура за наемане на чужденци.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Обезщетение при отнет достъп до пазара на труда по тяхна вина и задължителен договор за жилището на сезонните работници.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Гражданите<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167465\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-29 (Министерски съвет), доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">По-бързо издаване на лични документи (20 вместо 30 дни).</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">—</p></div></div></div></div></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://www.parliament.bg/bg/bills/ID/167465\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-602-01-29 (Министерски съвет), доклади и становища</a></li><li><a href=\"https://www.parliament.bg/bg/bills/ID/167498\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-654-01-111 (Б. Божанов и др.), доклади на две комисии</a></li><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания, Народно събрание (чрез „Наясно“)</a></li></ol><p class=\"text-xs text-muted mt-2\">Обобщението е по докладите на комисиите за първо гласуване. „Какво печели и какво губи всяка страна“ е наш анализ.<!-- --> Проверено: <!-- -->19 ноември 2026 г.</p></div></div><section id=\"dokumenti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Още от документите</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.</p><div class=\"space-y-4 max-w-4xl\"><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167498\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за чужденците в Република България</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-111</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Предлага се през тази Платформа да се извършва не само заявяванията на съответните услуги, но и обменът на данни между институциите в процедурата.<!-- -->“</li><li>„<!-- -->С това вносителите целят нормативно да се уреди не само по-бърза и ефективна обработка на заявленията, но и прилагане на разпределение на преписките на случаен принцип, с което да се постигне намаляване на корупционния елемент при издаване на разрешенията за работа.<!-- -->“</li><li>„<!-- -->Предложеният законопроект урежда и субектите с право на достъп до тази Платформа – директорът на ДАНС, на Агенцията по заетостта и на изпълнителния директор на ИА „Главна инспекция по труда“.<!-- -->“</li><li>„<!-- -->В становището си Българската стопанска камара подкрепя законопроекта, като посочва, че той представлява достатъчна нормативна основа за разширяване на приложимостта на действащата електронна система за издаване на разрешения за работа и ще улесни положението на работодателите.<!-- -->“</li><li>„<!-- -->Господин Божанов посочи, че с предложения законопроект се предлага въвеждане на изрична законова уредба за използване на автоматизирана информационна система „Платформа за производство за издаване на разрешения за пребиваване и работа“ при обработването и обмена на информация във връзка с подадени заявления за издаване на разрешения за пребиваване и работа, както и при декларациите за регистрация на сезонна работа до 90 дни.<!-- -->“</li><li>„<!-- -->Със законопроекта се предлага създаването на нова разпоредба, с което се цели да се осигури по-голяма прозрачност, предвидимост и ефективност при разглеждането на заявленията за пребиваване и работа, като за целта се въведе единна електронна среда за взаимодействие между компетентните институции.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167498\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Госпожа Стойкова посочи, че МВР е представило отрицателно становище по разглеждания законопроект.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167498\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Основните възражения са, че трябва да се включат всички участващи институции в лицето на Министерството на външните работи и трябва да бъде уредено и електронното уведомяване за нередовности в документите и даването на указания за тяхното отстраняване.<!-- -->“</li><li>„<!-- -->МТСП не подкрепя законопроекта, въпреки че подкрепя идеята за дигитализация и централизиране на процедурите поради непълнота и частичното дублиране на приета нормативна уредба.<!-- -->“</li><li>„<!-- -->В последвалата дискусия се изказаха становища и се зададоха въпроси от народни представители, а присъстващият представител на Министерството на труда и социалната политика даде разяснения и изказа своите възражения.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167498\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Венцислав Катинов</b>: „<!-- -->С предложения на Вашето внимание законопроект се предлагат мерки на национално ниво, необходими за осигуряване на изпълнението на правни актове на Европейския съюз, а<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11170\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->16.09.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->МТСП- сановище; МВР-становище; БСК - становище; ДАНС по ЗИД на ЗЧРБ, № 52-654-01-111; АЗ по ЗИД на ЗЧРБ, № 52-654-01-111; МВнР по ЗИД на ЗЧРБ, № 52-654-01-111; МВР по ЗИД на ЗЧРБ, № 52-654-01-111; БСК по ЗИД на ЗЧРБ, № 52-654-01-111<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167498\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167465\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за чужденците в Република България</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-602-01-29</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Част от предложенията са свързани с целта да отразят в Закона за МВР изискванията на Регламент (ЕС) 2024/1356 на Европейския парламент и на Съвета от 14 май 2024 година за въвеждане на скрининг на граждани на трети държави на външните граници.<!-- -->“</li><li>„<!-- -->Законопроектът предвижда и промени в Закона за българските лични документи за отразяване на заложеното в Плана за действие за внедряване на административни услуги на принципа „епизод от живота“, стъпка 4 „Намаляване сроковете за обикновена и бърза услуга за издаване на СУМПС и останалите български документи за самоличност“.<!-- -->“</li><li>„<!-- -->Предлагат се и промени в Закона за здравето, за да се уредят изискванията на Регламент (ЕС) 2024/1356 по отношение на граждани на трети страни, подложени на скрининг процедури, така че да им бъде осигурен достъп до здравни грижи.<!-- -->“</li><li>„<!-- -->Друга важна за практиката цел е въвеждането на процедура за смяна на длъжността след 6 месеца работа, която може да се инициира от работодателя или от самия чужденец.<!-- -->“</li><li>„<!-- -->Също така е необходима и промяна в Закона за трудовата миграция и трудовата мобилност, свързана с изпълнение на препоръките на Европейската комисия по процедура за нарушение № 2023/2017, с които се цели осигуряване правилното прилагане на Директива 2014/36/ЕС относно условията за влизане и престой на граждани на трети държави с цел заетост като сезонни работници.<!-- -->“</li><li>„<!-- -->В тази връзка се предвижда, когато достъпът до пазара на труда бъде отнет по вина на работодателя, той да дължи на чужденеца обезщетение.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167465\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Венцислав Катинов</b>: „<!-- -->С предложения на Вашето внимание законопроект се предлагат мерки на национално ниво, необходими за осигуряване на изпълнението на правни актове на Европейския съюз, а<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11170\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->16.09.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->КТ&quot; Подкрепа&quot; - Вх.№ КТДСП-52-629-00-2; БТПП- Вх.№ КТДСП-52-624-00-1; КНСБ-становище с вх.№ КТДСП-52-629-00-3; БСК-вх. № КТДСП-52-616-01-2; по ЗИД на ЗЧРБ, № 52-602-01-29; Петър Марков по ЗИД на ЗЧРБ, № 52-602-01-29; БСК по ЗИД на ЗЧРБ, № 52-602-01-29; ФАР по ЗИД на ЗЧРБ, № 52-602-01-29; ВКБООН по ЗИД на ЗЧРБ, № 52-602-01-29; адв. Полина Берг по ЗИД на ЗЧРБ; адв. Петър Марков по ЗИД на ЗЧРБ, № 52-602-01-29; &quot;ЕЛАНА&quot; АД  по ЗЧРБ<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167465\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div></div></section><section id=\"mnenie\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Твоето мнение</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. <a href=\"/mnenie\">Всички закони за гласуване</a>.</p><div class=\"bg-surface rounded-sm p-5 text-[15px] text-muted\">Зарежда се…</div></section><section id=\"grupi\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласуваха групите по този закон</h2></div><p class=\"text-sm text-muted mb-3\">Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо <!-- -->30<!-- -->. Прието: <!-- -->22<!-- -->, отхвърлено: <!-- -->8<!-- -->.</p><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Прогресивна България</p><p class=\"num text-sm mt-1\">За: <b>22</b> · Против: <b>8</b> · общо <!-- -->30</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ГЕРБ – СДС</p><p class=\"num text-sm mt-1\">За: <b>5</b> · Против: <b>0</b> · общо <!-- -->30</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Демократична България</p><p class=\"num text-sm mt-1\">За: <b>30</b> · Против: <b>0</b> · общо <!-- -->30</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ДПС</p><p class=\"num text-sm mt-1\">За: <b>8</b> · Против: <b>20</b> · общо <!-- -->30</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Продължаваме промяната</p><p class=\"num text-sm mt-1\">За: <b>11</b> · Против: <b>1</b> · общо <!-- -->30</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Възраждане</p><p class=\"num text-sm mt-1\">За: <b>10</b> · Против: <b>17</b> · общо <!-- -->29</p></div></div><p class=\"text-sm mt-3\">Първо четене: <a href=\"/parlament/glasuvane/2026-09-16-21\">16 септември 2026 г.</a><a href=\"/parlament/glasuvane/2026-09-16-22\">16 септември 2026 г.</a></p></section><section id=\"glasuvaniya\" class=\"scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Всички гласувания по закона</h2></div><ul><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-09-16-20\">Закона за чужденците в Република България – първо гласуване - процедура за допускане в зала</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">16 септември 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-09-16-21\">Закона за чужденците в Република България – първо гласуване - вносител Министерски съвет</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">16 септември 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: Въздържал се · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-09-16-22\">Закона за чужденците в Република България – първо гласуване - - вносител Божидар Божанов</a><span class=\"inline-block