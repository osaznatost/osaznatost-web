":\"twitter:image:height\",\"content\":\"630\"}],[\"$\",\"link\",\"19\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?favicon.117ezoe8m31dk.ico\",\"sizes\":\"48x48\",\"type\":\"image/x-icon\"}],\"$L2a\"]}]}],null]}],\"$L2b\"]}],\"p\":\"$@2c\",\"v\":null,\"s\":\"$d\"}},\"a\":\"$@2d\",\"u\":\"$@2e\",\"b\":\"BnpfSvxUfiSkNOlqobTmv\"}\n3c:I[52368,[\"$2\",\"$9\"],\"CitizenVote\"]\n4a:I[97367,[\"$2\"],\"OutletBoundary\"]\n4c:I[27201,[\"$2\"],\"IconMark\"]\n16:[\"$\",\"li\",\"zakonoproekti\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#zakonoproekti\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Кой внесе и кой се изказа\"}]}]\n17:[\"$\",\"li\",\"argumenti\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#argumenti\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Двете страни\"}]}]\n18:[\"$\",\"li\",\"mnenie\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#mnenie\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Твоето мнение\"}]}]\n19:[\"$\",\"li\",\"grupi\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#grupi\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Как гласуваха\"}]}]\n1a:[\"$\",\"li\",\"glasuvaniya\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#glasuvaniya\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Гласувания (30)\"}]}]\n1b:[\"$\",\"section\",null,{\"id\":\"nakratko\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Накратко\"}],\"$undefined\",[\"$\",\"div\",null,{\"className\":\"max-w-4xl\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[17px]\",\"children\":\"Правителственият законопроект въвежда в българското право европейските правила за единно разрешение за пребиваване и работа на граждани на трети държави и за проверка (скрининг) на външните граници. Работодател, по чиято вина чужденец загуби достъп до пазара на труда, ще му дължи обезщетение, а при осигурено от работодателя жилище за сезонен работник се изисква писмен договор за наем. Чрез промени в други закони срокът за обикновена услуга за лични документи пада от 30 на 20 дни, а служебните паспорти могат да се ползват само за служебни пътувания.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Вносители:\"}],\" \",\"Министерският съвет (представи министърът на вътрешните работи). Отделен проект на Божидар Божанов и др. (ДБ) беше отхвърлен.\",[\" · \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167465\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"законопроект \",\"52-602-01-29\"]}]]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Какво се случи:\"}],\" \",\"На първо четене (16.09.2026) правителственият проект мина със 151 „за“ (ГЕРБ–СДС се въздържаха, „Възраждане“ против). Проектът на ДБ за задължителна електронна платформа за разрешенията за работа беше отхвърлен със 133 „против“. Двете комисии предложиха да не се приема: „Прогресивна България“ гласува против, ДБ и ПП — за. Окончателно приет на 18.11.2026 г. (наименованието — 158 „за“, 6 „против“).\"]}]]}]]}]\n1c:[\"$\",\"section\",null,{\"id\":\"signali\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Сигнали\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.\"}],[[\"$\",\"ul\",null,{\"className\":\"grid gap-3 md:grid-cols-2 max-w-5xl\",\"children\":[[\"$\",\"li\",\"3 нови текста, приети на второ четене\",{\"className\":\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"3 нови текста, приети на второ четене\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Текстове, които ги нямаше в първоначалния законопроект. Обикновено са поправки, но могат и да променят смисъла.\"}]]}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3\",\"children\":[\"$\",\"$La\",null,{\"href\":\"/parlament/signali\",\"children\":\"Всички сигнали в парламента\"}]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-2\",\"children\":[\"Сигналът е повод за въпрос, не доказателство за нарушение.\",\" \",[\"$\",\"$La\",null,{\"href\":\"/metodologiya#signal\",\"className\":\"underline\",\"children\":\"Как работим със сигналите\"}]]}]]]}]\n1d:[\"$\",\"section\",null,{\"id\":\"zakonoproekti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Кой внесе и кой се изказа\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.\"}],[[\"$\",\"ul\",null,{\"className\":\"space-y-4 max-w-5xl\",\"children\":[[\"$\",\"li\",\"167498\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167498\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за чужденците в Република България\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-654-01-111\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"30 юли 2026 г.\",\" от \",\"Божидар Божанов, Надежда Йорданова, Йордан Иванов и още 9 депутати\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по вътрешна сигурност и обществен ред (водеща); Комисия по труда, демографската и социалната политика (участваща); Комисия по икономическа политика, инвестиции и индустрия (участваща); Комисия за контрол над службите за сигурност, прилагането и използването на специалните разузнавателни средства и достъпа до данните по Закона за електронните съобщения (участваща); Комисия по иновациите и дигиталната трансформация (участваща)\"}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Становища\"}],[\"$\",\"dd\",null,{\"children\":\"МТСП- сановище; МВР-становище; БСК - становище; ДАНС по ЗИД на ЗЧРБ, № 52-654-01-111; АЗ по ЗИД на ЗЧРБ, № 52-654-01-111; МВнР по ЗИД на ЗЧРБ, № 52-654-01-111; МВР по ЗИД на ЗЧРБ, № 52-654-01-111; БСК по ЗИД на ЗЧРБ, № 52-654-01-111\"}]],false,false,false,false,[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"В залата\"}],[\"$\",\"dd\",null,{\"children\":[[\"$\",\"span\",\"0\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11170\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"16 септември 2026 г.\"}],\" (\",\"зала първо гласуване\",\")\"]}]]}]],null]}]]}],[\"$\",\"li\",\"167465\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167465\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за чужденците в Република България\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-602-01-29\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"28 юли 2026 г.\",\" от \",\"Министерския съвет\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по вътрешна сигурност и обществен ред (водеща); Комисия по европейските въпроси и контрол на европейските фондове (участваща); Комисия по икономическа политика, инвестиции и индустрия (участваща); Комисия по труда, демографската и социалната политика (участваща); Комисия по здравеопазването (участваща); Комисия по транспорт и съобщения (участваща)\"}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Становища\"}],[\"$\",\"dd\",null,{\"children\":\"КТ\\\" Подкрепа\\\" - Вх.№ КТДСП-52-629-00-2; БТПП- Вх.№ КТДСП-52-624-00-1; КНСБ-становище с вх.№ КТДСП-52-629-00-3; БСК-вх. № КТДСП-52-616-01-2; по ЗИД на ЗЧРБ, № 52-602-01-29; Петър Марков по ЗИД на ЗЧРБ, № 52-602-01-29; БСК по ЗИД на ЗЧРБ, № 52-602-01-29; ФАР по ЗИД на ЗЧРБ, № 52-602-01-29; ВКБООН по ЗИД на ЗЧРБ, № 52-602-01-29; адв. Полина Берг по ЗИД на ЗЧРБ; адв. Петър Марков по ЗИД на ЗЧРБ, № 52-602-01-29; \\\"ЕЛАНА\\\" АД  по ЗЧРБ\"}]],false,false,false,\"$L2f\",\"$L30\",null]}]]}]]}],false]]}]\n1e:[\"$\",\"div\",null,{\"id\":\"argumenti\",\"className\":\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-2 mt-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-green bg-surface\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Мотивите на вносителите\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Министър Иван Демерджиев (за Министерския съвет)Законът изпълнява Ди\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Министър Иван Демерджиев (за Министерския съвет)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Законът изпълнява Директива (ЕС) 2024/1233 за единното разрешение и Регламент (ЕС) 2024/1356 за скрининга, както и препоръки на Европейската комисия по процедура за нарушение за сезонните работници.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167465\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-29 (Министерски съвет), доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Министър Иван ДемерджиевСега няма изрично ог\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Министър Иван Демерджиев\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Сега няма изрично ограничение за ползването на служебни паспорти; новият текст ги ограничава до служебни пътувания, за да не се злоупотребява с безвизовия режим.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167465\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-29 (Министерски съвет), доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Божидар Божанов (ДБ), за отхвърления проектВсички заявления за \",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Божидар Божанов (ДБ), за отхвърления проект\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Всички заявления за разрешения за работа да минават през електронна платформа с разпределение на преписките на случаен принцип, за да намалее корупцията.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"2\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167498\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-111 (Б. Божанов и др.), доклади на две комисии\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",2,\"]\"]}]]]}]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Какво казват критиците\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"МВР (становище по проекта на ДБ)Платформата не работ\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"МВР (становище по проекта на ДБ)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Платформата не работи ефективно: МВнР и ДАНС не я използват. През 2025 г. на хартия са подадени 31 000 заявления, а през платформата — 1 500.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"2\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167498\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-111 (Б. Божанов и др.), доклади на две комисии\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",2,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Министерството на труда и социалната политикаНе подкрепя проекта \",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Министерството на труда и социалната политика\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Не подкрепя проекта на ДБ, въпреки че подкрепя дигитализацията, заради непълнота и дублиране на вече приети правила.\",\"$L31\"]}]]}],\"$L32\"]}]]}]]}],null,\"$L33\",\"$L34\",null,\"$L35\"]}]\n1f:[\"$\",\"section\",null,{\"id\":\"dokumenti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Още от документите\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 max-w-4xl\",\"children\":[[\"$\",\"div\",\"167498\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167498\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за чужденците в Република България\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-654-01-111\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Предлага се през тази Платформа да се извършва не само заявяванията на съответните услуги, но и обменът на данни между институциите в процедурата.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"С това вносителите целят нормативно да се уреди не само по-бърза и ефективна обработка на заявленията, но и прилагане на разпределение на преписките на случаен принцип, с което да се постигне намаляване на корупционния елемент при издаване на разрешенията за работа.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Предложеният законопроект урежда и субектите с право на достъп до тази Платформа – директорът на ДАНС, на Агенцията по заетостта и на изпълнителния директор на ИА „Главна инспекция по труда“.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"В становището си Българската стопанска камара подкрепя законопроекта, като посочва, че той представлява достатъчна нормативна основа за разширяване на приложимостта на действащата електронна система за издаване на разрешения за работа и ще улесни положението на работодателите.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Господин Божанов посочи, че с предложения законопроект се предлага въвеждане на изрична законова уредба за използване на автоматизирана информационна система „Платформа за производство за издаване на разрешения за пребиваване и работа“ при обработването и обмена на информация във връзка с подадени заявления за издаване на разрешения за пребиваване и работа, както и при декларациите за регистрация на сезонна работа до 90 дни.\",\"“\"]}],[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"Със законопроекта се предлага създаването на нова разпоредба, с което се цели да се осигури по-голяма прозрачност, предвидимост и ефективност при разглеждането на заявленията за пребиваване и работа, като за целта се въведе единна електронна среда за взаимодействие между компетентните институции.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167498\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#8a8f8c] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Позиции, изказани в комисията\"}],\"$L36\",\"$L37\"]}],\"$L38\",\"$L39\",\"$L3a\"]}]]}]]}],\"$L3b\"]}]]}]\n20:[\"$\",\"section\",null,{\"id\":\"mnenie\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Твоето мнение\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":[\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \",[\"$\",\"$La\",null,{\"href\":\"/mnenie\",\"children\":\"Всички закони за гласуване\"}],\".\"]}],[\"$\",\"$L3c\",null,{\"item\":\"chuzhdentsite-v-republika-balgariya\",\"question\":\"Подкрепяш ли последните промени в „Закон за чужденците в Република България (единно разрешение за пребиваване и работа, сезонни работници, служебни паспорти)“?\"}]]}]\n21:[\"$\",\"section\",null,{\"id\":\"grupi\",\"className\":\"mb-12 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb-5\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] sm:text-[2.4rem]\",\"children\":\"Как гласуваха групите по този закон\"}],\"$undefined\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mb-3\",\"children\":[\"Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо \",30,\". Прието: \",22,\", отхвърлено: \",8,\".\"]}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"div\",\"ПБ\",{\"className\":\"border border-rule rounded-sm p-4\",\"childre