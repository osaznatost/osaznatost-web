{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/zakon/layout,_N_T_/parlament/zakon/[slug]/layout,_N_T_/parlament/zakon/[slug]/page,_N_T_/parlament/zakon/nakazatelno-protsesualen-kodeks"},"segmentPaths":["/_tree","/_full","/parlament/zakon/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/832efd850f6c1dd49e00d14864cc2065782fdb2d7a0a057c3138fa12d1cc6a01/$/parlament/zakon/nakazatelno-protsesualen-kodeks","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/zakon/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0vn96-fhbu77m.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><script src=\"/_next/static/chunks/43gzry38n6x69.js\" async=\"\"></script><title>Наказателно-процесуален кодекс · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Наказателно-процесуален кодекс · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Наказателно-процесуален кодекс · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Парламент</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Закон</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Наказателно-процесуален кодекс</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Приет окончателно на 17–18.06.2026 г., обнародван в ДВ, бр. 59/2026</div></div></div><nav aria-label=\"Секции на страницата\" class=\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\"><ul class=\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\"><li><a href=\"#nakratko\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Накратко</a></li><li><a href=\"#zakonoproekti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Кой внесе и кой се изказа</a></li><li><a href=\"#argumenti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Двете страни</a></li><li><a href=\"#mnenie\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Твоето мнение</a></li><li><a href=\"#grupi\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Как гласуваха</a></li><li><a href=\"#glasuvaniya\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Гласувания (28)</a></li></ul></nav><section id=\"nakratko\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Накратко</h2><div class=\"max-w-4xl\"><p class=\"text-[17px]\">Законът въвежда задължителен съдебен контрол, когато прокуратурата прекратява или спира дела за корупция на хора на висши публични длъжности и дела срещу главния прокурор. Ad hoc прокурорът, който разследва главния прокурор или заместниците му, се контролира от съдия от наказателната колегия на ВКС, избран на случаен принцип. Задържаните и обвиняемите трябва да бъдат уведомявани за правата си (адвокат, правна помощ, превод, право на мълчание), а при задочните дела се спазват решенията на Съда на ЕС. Държавата отговаря за вреди, когато длъжностно лице публично наруши презумпцията за невиновност. Проектът на ДБ въвежда право на незабавна жалба пред съд срещу 72-часовото прокурорско задържане.</p><p class=\"mt-3 text-[15px]\"><b>Вносители:</b> <!-- -->Общ законопроект на правната комисия от проектите на Министерския съвет (№ 52-602-01-1 и 52-602-01-8) и на Йордан Иванов, Надежда Йорданова и др. (ДБ)<!-- --> · <a href=\"https://www.parliament.bg/bg/bills/ID/167016\" target=\"_blank\" rel=\"noreferrer\">законопроект <!-- -->52-653-123-8</a></p><p class=\"mt-3 text-[15px]\"><b>Какво се случи:</b> <!-- -->Второ четене на 17–18.06.2026 г. (28 гласувания). Становища внесоха Висшият адвокатски съвет, ВКС, Прокуратурата, Министерството на правосъдието и Камарата на следователите.</p></div></section><section id=\"zakonoproekti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Кой внесе и кой се изказа</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.</p><ul class=\"space-y-4 max-w-5xl\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167510\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-117</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>31 юли 2026 г.<!-- --> от <!-- -->Силвия Христова, Христо Симеонов, Димитър Петров и още 3 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">Становища</dt><dd>Независимо сдружение на българските прокурори относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-117, внесен от Силвия Тошкова Христова и група народни представители на 31.07.2026 г.; Висшия адвокатски съвет относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-117, внесен от Силвия Тошкова Христова и група народни представители на 31.07.2026 г.; Министерство на правосъдието относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-117, внесен от г-жа Силвия Тошкова Христова и група народни представители на 31 юли 2026 г.; Прокуратурата на Република България относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-117, внесен от Силвия Тошкова Христова и група народни представители на 31.07.2026 г.; Върховен касационен съд относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-117, внесен от Силвия Тошкова Христова и група народни представители на 31.07.2026 г.</dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167509\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-116</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>31 юли 2026 г.<!-- --> от <!-- -->Божидар Божанов, Надежда Йорданова, Ивайло Мирчев и още 1 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по правни въпроси (водеща); Комисия по бюджет и финанси (участваща); Комисия за контрол над службите за сигурност, прилагането и използването на специалните разузнавателни средства и достъпа до данните по Закона за електронните съобщения (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>Независимо сдружение на българските прокурори относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-116, внесен от Божидар Пламенов Божанов и група народни представители на 31.07.2026 г.; Прокуратура на Република България относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-116, внесен от Божидар Пламенов Божанов и група народни представители на 31.07.2026 г.; Министерство на правосъдието относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-116, внесен от г-н Божидар Пламенов Божанов и група народни представители на 31 юли 2026 г.; Върховен касационен съд относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-116, внесен от Божидар Пламенов Божанов и група народни представители на 31.07.2026 г.; Висш съдебен съвет относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-116, внесен от Божидар Пламенов Божанов и група народни представители на 31.07.2026 г.</dd></dl></li></ul><details class=\"mt-3 max-w-5xl\"><summary class=\"cursor-pointer font-semibold text-green py-2\">Още <!-- -->7<!-- --> законопроекта по този закон</summary><ul class=\"space-y-4 mt-2\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167501\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-113</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>30 юли 2026 г.<!-- --> от <!-- -->Божидар Божанов, Надежда Йорданова, Атанас Атанасов и още 10 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по правни въпроси (водеща); Комисия по иновациите и дигиталната трансформация (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>Независимо сдружение на българските прокурори относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-113, внесен от Божидар Пламенов Божанов и група народни представители на 30.07.2026 г.; Прокуратура на Република България относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-113, внесен от Божидар Пламенов Божанов и група народни представители на 30.07.2026 г.; Министерство на правосъдието относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-113, внесен от г-н Божидар Пламенов Божанов и група народни представители на 30 юли 2026 г.; Върховен касационен съд относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-113, внесен от Божидар Пламенов Божанов и група народни представители на 30.07.2026 г.</dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167473\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-602-01-31</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>28 юли 2026 г.<!-- --> от <!-- -->Министерския съвет</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по правни въпроси (водеща); Комисия по вътрешна сигурност и обществен ред (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>Независимо сдружение на българските прокурори относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-602-01-31, внесен от Министерски съвет на 28.07.2026 г.</dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167175\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-81</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>8 юли 2026 г.<!-- --> от <!-- -->Божидар Божанов, Надежда Йорданова, Атанас Атанасов и още 5 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по правни въпроси (водеща); Комисия по бюджет и финанси (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>Министерство на правосъдието относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-81, внесен от г-н Божидар Пламенов Божанов и група народни представители на 8 юли 2026 г.; Прокуратура на Република България относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-81, внесен от Божидар Пламенов Божанов и група народни представители на 8.07.2026 г.; Пленума на Висшия съдебен съвет относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-81, внесен от Божидар Пламенов Божанов и група народни представители на 8.07.2026 г.; Независимо сдружение на българските прокурори относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-81, внесен от Божидар Пламенов Божанов и група народни представители на 8.07.2026 г.</dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167016\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Общ законопроект за изменение и допълнение на Наказателно-процесуалния кодекс</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-653-123-8</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>22 май 2026 г.<!-- --> от <!-- -->депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Временна комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">Становища</dt><dd>Висшия адвокатски съвет относно общ законопроект за изменение и допълнение на Наказателно-процесуалния кодекс № 52-653-123-8 от 22.05.2026 г.; Върховния касационен съд относно общ законопроект за изменение и допълнение на Наказателно-процесуалния кодекс № 52-653-123-8 от 22.05.2026 г.; Прокуратура на Република България относно общ законопроект за изменение и допълнение на Наказателно-процесуалния кодекс № 52-653-123-8 от 22.05.2026 г.; Министерство на правосъдието относно общ законопроект за изменение и допълнение на Наказателно-процесуалния кодекс № 52-653-123-8 от 22.05.2026 г.; Камара на следователите в България относно общ законопроект за изменение и допълнение на Наказателно-процесуалния кодекс № 52-653-123-8 от 22.05.2026 г.</dd><dt class=\"text-muted\">Предложения</dt><dd>2<!-- --> писмени предложения на депутати между <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">първо</button></span> и <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">второ четене</button></span></dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/1\" target=\"_blank\" rel=\"noreferrer\">11 юни 2026 г.</a> (<!-- -->комисии второ гласуване<!-- -->)</span><span>, <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11140\" target=\"_blank\" rel=\"noreferrer\">18 юни 2026 г.</a> (<!-- -->зала второ гласуване<!-- -->)</span></dd><dt class=\"text-muted\">Обнародван</dt><dd>ДВ, бр. 59/2026<!-- -->, приет на 18 юни 2026 г.</dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167006\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-40</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>13 май 2026 г.<!-- --> от <!-- -->Йордан Иванов, Надежда Йорданова, Атанас Атанасов и още 13 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Временна комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11127\" target=\"_blank\" rel=\"noreferrer\">20 май 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/166978\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-602-01-8</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>5 май 2026 г.<!-- --> от <!-- -->Министерския съвет</dd><dt class=\"text-muted\">Комисии</dt><dd>Временна комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11127\" target=\"_blank\" rel=\"noreferrer\">20 май 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/166961\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-602-01-1</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>30 април 2026 г.<!-- --> от <!-- -->Министерския съвет</dd><dt class=\"text-muted\">Комисии</dt><dd>Временна комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11127\" target=\"_blank\" rel=\"noreferrer\">20 май 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li></ul></details></section><div id=\"argumenti\" class=\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\"><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Министерството на правосъдието</p><p class=\"text-[15px]\">Сега на практика няма контрол над ad hoc прокурора, който разследва главния прокурор; промените изпълняват реформата „Противодействие на корупцията“ от Плана за възстановяване.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167016\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-653-123-8, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Министерството на правосъдието</p><p class=\"text-[15px]\">Директивите за правата на заподозрените трябва да се въведат изцяло, за да се избегнат санкции и осъдителни решения на Съда на ЕС и ЕСПЧ.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167016\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-653-123-8, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">ДБ (Йордан Иванов)</p><p class=\"text-[15px]\">По делото „Канджов срещу България“ и други ЕСПЧ намира, че задържаните не се изправят своевременно пред съдия; нужна е незабавна съдебна проверка на прокурорското задържане.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167006\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-40, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Прокуратурата, ВКС, Висшият адвокатски съвет, Камарата на следователите</p><p class=\"text-[15px]\">Внесоха становища по общия законопроект (публикувани на сайта на парламента).<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167016\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-653-123-8, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Отворен въпрос</p><p class=\"text-[15px]\">Новият съдебен контрол натоварва ВКС и съдилищата; ефектът зависи от това дали съдиите ще се произнасят бързо и независимо.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167016\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-653-123-8, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Двете страни на монетата</h3><p class=\"text-sm text-muted mb-3\">Какво следва на практика, ако законът се приеме и ако се отхвърли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167016\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-653-123-8, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\"><p class=\"font-semibold\">Ако се приеме</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Отчетност на прокуратурата, вкл. на главния прокурор.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Изпълнение на Плана за възстановяване и на решенията на ЕСПЧ.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Повече натоварване на съдилищата.</li></ul></div></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\"><p class=\"font-semibold\">Ако се отхвърли</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Главният прокурор остава практически недосегаем; санкции от ЕС.</li></ul></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Какво печели и какво губи всяка страна</h3><p class=\"text-sm text-muted mb-3\">Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.</p><div class=\"space-y-3\"><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Разследваните висши длъжностни лица<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167016\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-653-123-8, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Делата им не могат да бъдат тихо прекратени без съд.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Задържаните и обвиняемите<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167016\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-653-123-8, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a><a href=\"https://www.parliament.bg/bg/bills/ID/167006\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-40, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">По-пълна информация за правата и по-бърз съдебен контрол.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">—</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Прокуратурата<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167016\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-653-123-8, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">По-малко самостоятелност при прекратяване на дела.</p></div></div></div></div></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://www.parliament.bg/bg/bills/ID/167016\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-653-123-8, доклади и становища</a></li><li><a href=\"https://www.parliament.bg/bg/bills/ID/167006\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-654-01-40, доклади и становища</a></li><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания, Народно събрание (чрез „Наясно“)</a></li></ol><p class=\"text-xs text-muted mt-2\">Обобщението е по доклада на правната комисия и мотивите на ДБ.<!-- --> Проверено: <!-- -->19 ноември 2026 г.</p></div></div><section id=\"dokumenti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Още от документите</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.</p><div class=\"space-y-4 max-w-4xl\"><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167510\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-117</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->За да се гарантира срочността на процеса, а същевременно, за да не се ограничи възможността на всеки участник в стадия „Разпоредително заседание“ да вземе участие, се предвижда възможността, същото да протече последователно в две или повече заседания, на които всеки да разполага с правото да депозира своето становище по въпросите на чл. 248 пред Съда, а последният от своя страна, когато събере всички становища - да произнесе обосновано Определение, в което да обсъди всяко от тях.<!-- -->“</li><li>„<!-- -->Целта на разпоредителното заседание е да се анализира проведеното предварително разследване и в частност изготвения обвинителен акт.<!-- -->“</li><li>„<!-- -->Въздействие върху нормативната среда Не се предвиждат промени в други нормативни актове. 6.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167510\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->Независимо сдружение на българските прокурори относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-117, внесен от Силвия Тошкова Христова и група народни представители на 31.07.2026 г.; Висшия адвокатски съвет относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-117, внесен от Силвия Тошкова Христова и група народни представители на 31.07.2026 г.; Министерство на правосъдието относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-117, внесен от г-жа Силвия Тошкова Христова и група народни представители на 31 юли 2026 г.; Прокуратурата на Република България относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-117, внесен от Силвия Тошкова Христова и група народни представители на 31.07.2026 г.; Върховен касационен съд относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-117, внесен от Силвия Тошкова Христова и група народни представители на 31.07.2026 г.<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167510\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167509\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-116</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Предлага се подобряване на уредбата за отстраняване на магистрати при наличие на повдигнато обвинение.<!-- -->“</li><li>„<!-- -->По отношение на предложението в чл. 329 от ЗСВ Предлага се нова алинея, която да ограничи рисковете от злоупотреби при една специфична хипотеза - насрочване на съдебни заседания в съдебната ваканция по наказателни дела по искане на административни ръководители на съда или прокуратурата, или на министъра на правосъдието.<!-- -->“</li><li>„<!-- -->В действащия закон се предвижда специално правомощие на главния прокурор да разкрива банкова тайна без съдебен контрол.<!-- -->“</li><li>„<!-- -->Предвижда се и уведомяване на клиентите на банките след изтичане на 18 месеца (или 24 месеца) от разкриването на банковата тайна достатъчно време, така че уведомлението да не застраши съответното разследване или производство.<!-- -->“</li><li>„<!-- -->Предлага се и връщането на регистъра в БНБ, воден близо 15 години от приемането на закона до 2020 г, поради което връщането на такова задължение не се очаква да представлява особена допълнителна тежест за БНБ. 20.<!-- -->“</li><li>„<!-- -->Макар разширяването на кръга от лица, които имат необходимост да знаят съответната информация да повишава риска от нейното компрометиране, алтернативен подход за отпадане на грифа за сигурност при включване на документа в наказателен процес крие допълнителни рискове, поради което такъв не се предлага.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167509\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->Независимо сдружение на българските прокурори относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-116, внесен от Божидар Пламенов Божанов и група народни представители на 31.07.2026 г.; Прокуратура на Република България относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-116, внесен от Божидар Пламенов Божанов и група народни представители на 31.07.2026 г.; Министерство на правосъдието относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-116, внесен от г-н Божидар Пламенов Божанов и група народни представители на 31 юли 2026 г.; Върховен касационен съд относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-116, внесен от Божидар Пламенов Божанов и група народни представители на 31.07.2026 г.; Висш съдебен съвет относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-116, внесен от Божидар Пламенов Божанов и група народни представители на 31.07.2026 г.<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167509\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167501\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-113</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Това с практика, въведена в множество европейски държави и значително ще улесни разследващите органи, като се предвиждат гаранции срещу промени в заснетото съдържание (един възможен начин би бил квалифициран електронен времеви печат по смисъла на Регламент (ЕС) 910/2014).<!-- -->“</li><li>„<!-- -->По отношение на предложението в чл. 163 До 2025 г, НПК предвиждаше иззети компютърни данни да се възпроизвеждат на хартиен носител и да се подписват на всяка страница.<!-- -->“</li><li>„<!-- -->По тази причина с настоящите промени се премахват текстовете, насочващи към определен вид елсктронен носител. (0) оглед на ограничаване на рисковете от злоупотреби се предвиждат технически гаранции срещу подмяна на данните, съхранявани в електронен формат (чрез квалифициран електронен времеви печат по смисъла на Регламент (ЕС) 910/2014), както и срещу незаконосъобразно разгласяване (чрез съхранение в шифриран вид).<!-- -->“</li><li>„<!-- -->За целта е необходима техническа подготовка, която обаче не следва да е предизвикателство в 21-ви век.<!-- -->“</li><li>„<!-- -->По отношение на предложението в чл. 206а, чл. 247а и предложението за нов чл. 381 в ЗСВ Предлага се въвеждане на електронно досъдебно производство.<!-- -->“</li><li>„<!-- -->По отношение на параграф 9 (уасайо |ер!5) Предлагат се законът да влезе в сила шест месеца след обнародването му, поради големият брой промени, които изискват обновяване на вътрешни правила и процеси и подготовка на заинтересованите страни, като се предвижда допълнително отлагане с три години на изграждането на Единна информационна система за наказателни производства, която изисква значително време за подготовка, изграждане и внедряване.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167501\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->Независимо сдружение на българските прокурори относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-113, внесен от Божидар Пламенов Божанов и група народни представители на 30.07.2026 г.; Прокуратура на Република България относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-113, внесен от Божидар Пламенов Божанов и група народни представители на 30.07.2026 г.; Министерство на правосъдието относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-113, внесен от г-н Божидар Пламенов Божанов и група народни представители на 30 юли 2026 г.; Върховен касационен съд относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-113, внесен от Божидар Пламенов Божанов и група народни представители на 30.07.2026 г.<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167501\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167175\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-81</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->По отношение на предложенията в чл. 234 С оглед на повишаване на прозрачността на стапа на разследването се предвижда публикуване на съобщение за издадените постановления за удължаване на разследването, без да се създава риск за самото разследване.<!-- -->“</li><li>„<!-- -->По отношение на предложението в чл. 244 Законопроектът предвижда допълнителна прозрачност на актовете на прокуратурата. като въвежда изискване за обявяване на някои постановления единния портал за електронно правосъдие.<!-- -->“</li><li>„<!-- -->По отношение на предложенията в чл. 3600 от ЗСВ Настоящата разпоредба на чл. 360о предвижда актове, които съдържат защитена от закона тайна, да не се публикуват.<!-- -->“</li><li>„<!-- -->Предвижда сс и изрична забрана за заличаване на идентификационни данни на юридически лица, каквато практика съществува при обявяването на актове, без да има основание за това. 6.<!-- -->“</li><li>„<!-- -->Предлага се период, в който да бъдат изготвени справките извън минималните определени в закона, както и задължение за публикуване на данни от определените справки за период от 12 месеца назад. 7.<!-- -->“</li><li>„<!-- -->Част първа Елементи на А ументация оценката щ Основания на законодателната Законодателната инициатива се обосновава с необходимостта от инициатива преодоляване на установени празноти и неясноти в уредбата на досъдебната фаза, повишаване на прозрачността и отчетността на прокуратурата и осигуряване на по-надеждни данни за съдебната статистика, при стриктно зачитане на презумпцията за | невиновност и правото на защита.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167175\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->Министерство на правосъдието относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-81, внесен от г-н Божидар Пламенов Божанов и група народни представители на 8 юли 2026 г.; Прокуратура на Република България относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-81, внесен от Божидар Пламенов Божанов и група народни представители на 8.07.2026 г.; Пленума на Висшия съдебен съвет относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-81, внесен от Божидар Пламенов Божанов и група народни представители на 8.07.2026 г.; Независимо сдружение на българските прокурори относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-81, внесен от Божидар Пламенов Божанов и група народни представители на 8.07.2026 г.<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167175\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div></div></section><section id=\"mnenie\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Твоето мнение</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. <a href=\"/mnenie\">Всички закони за гласуване</a>.</p><div class=\"bg-surface rounded-sm p-5 text-[15px] text-muted\">Зарежда се…</div></section><section id=\"grupi\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласуваха групите по този закон</h2></div><p class=\"text-sm text-muted mb-3\">Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо <!-- -->28<!-- -->. Прието: <!-- -->11<!-- -->, отхвърлено: <!-- -->17<!-- -->.</p><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Прогресивна България</p><p class=\"num text-sm mt-1\">За: <b>11</b> · Против: <b>17</b> · общо <!-- -->28</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ГЕРБ – СДС</p><p class=\"num text-sm mt-1\">За: <b>15</b> · Против: <b>6</b> · общо <!-- -->28</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Демократична България</p><p class=\"num text-sm mt-1\">За: <b>21</b> · Против: <b>7</b> · общо <!-- -->28</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ДПС</p><p class=\"num text-sm mt-1\">За: <b>11</b> · Против: <b>17</b> · общо <!-- -->28</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Продължаваме промяната</p><p class=\"num text-sm mt-1\">За: <b>21</b> · Против: <b>7</b> · общо <!-- -->28</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Възраждане</p><p class=\"num text-sm mt-1\">За: <b>19</b> · Против: <b>1</b> · общо <!-- -->28</p></div></div></section><section id=\"glasuvaniya\" class=\"scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Всички гласувания по закона</h2></div><ul><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-06-17-31\">Наказателно-процесуалния кодекс – второ гласуване - наименование, параграф 1</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието единодушно</span></div><p class=\"text-sm text-muted mt-1\">17 юни 2026 г.<!-- --> · <!-- -->Второ четене: наименование<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: За</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-06-17-32\">Наказателно-процесуалния кодекс – второ гласуване - параграф 1а - предложение от Божидар Божанов и Надежда Йорданова</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-muted border border-rule\">Отхвърлено</span></div><p class=\"text-sm text-muted mt-1\">17 юни 2026 г.<!-- --> · <!-- -->Второ четене: предложение на депутат<!-- --> · <!-- -->Прогресивна България: Против · ГЕРБ – СДС: Въздържал се · Демократична България: За · ДПС: Против · Продължаваме промяната: За · Възраждане: За</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-06-17-33\