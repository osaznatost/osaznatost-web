\\",\\\"https://www.parliament.bg/bg/bills/ID/167006\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167006\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":\\\"Народно събрание: законопроект № 52-654-01-40, доклади и становища\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"https://naiasno.bg/parliament\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://naiasno.bg/parliament\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":\\\"Поименни гласувания, Народно събрание (чрез „Наясно“)\\\"}]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted mt-2\\\",\\\"children\\\":[\\\"Обобщението е по доклада на правната комисия и мотивите на ДБ.\\\",\\\" Проверено: \\\",\\\"19 ноември 2026 г.\\\"]}]]}]\\n28:[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167510\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":\\\"Текстовете в parliament.bg\\\"}]\\n42:T752,Независимо сдружение на българските прокурори относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-116, внесен от Божидар Пламенов Божанов и група народни представители на 31.07.2026 г.; Прокуратура на Република България относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-116, внесен от Божидар Пламенов Божанов и група народни представители на 31.07.2026 г.; Министерство на правосъдието относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-116, внесен от г-н Божидар Пламенов Божанов и група народни представители на 31 юли 2026 г.; Върховен касационен съд относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-116, внесен от Божидар Пламенов Божанов и група народни представители на 31.07.2026 г.; Висш съдебен съвет относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-116, внесен от Божидар Пламенов Божанов и група народни представители на 31.07.2026 г.29:[\\\"$\\\",\\\"div\\\",\\\"167509\\\",{\\\"className\\\":\\\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted\\\",\\\"children\\\":\\\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mt-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167509\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"className\\\":\\\"text-ink\\\",\\\"children\\\":\\\"Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс\\\"}],\\\" \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-muted num font-normal\\\",\\\"children\\\":[\\\"№ \\\",\\\"52-654-01-116\\\"]}]]}],[\\\"$\\\",\\\"details\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer font-semibold text-green mt-2\\\",\\\"children\\\":\\\"Покажи цитатите\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-5 mt-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-green pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Какво предлага законопроектът\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"Предлага се подобряване на уредбата за отстраняване на магистрати при наличие на повдигнато обвинение.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"По отношение на предложението в чл. 329 от ЗСВ Предлага се нова алинея, която да ограничи рисковете от злоупотреби при една специфична хипотеза - насрочване на съдебни заседания в съдебната ваканция по наказателни дела по искане на административни ръководители на съда или прокуратурата, или на министъра на правосъдието.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[\\\"„\\\",\\\"В действащия закон се предвижда специално правомощие на главния прокурор да разкрива банкова тайна без съдебен контрол.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[\\\"„\\\",\\\"Предвижда се и уведомяване на клиентите на банките след изтичане на 18 месеца (или 24 месеца) от разкриването на банковата тайна достатъчно време, така че уведомлението да не застраши съответното разследване или производство.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"children\\\":[\\\"„\\\",\\\"Предлага се и връщането на регистъра в БНБ, воден близо 15 години от приемането на закона до 2020 г, поради което връщането на такова задължение не се очаква да представлява особена допълнителна тежест за БНБ. 20.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"5\\\",{\\\"children\\\":[\\\"„\\\",\\\"Макар разширяването на кръга от лица, които имат необходимост да знаят съответната информация да повишава риска от нейното компрометиране, алтернативен подход за отпадане на грифа за сигурност при включване на документа в наказателен процес крие допълнителни рискове, поради което такъв не се предлага.\\\",\\\"“\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted mt-1\\\",\\\"children\\\":[\\\"Източник: \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167509\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":\\\"доклад на комисията и мотиви, parliament.bg\\\"}]]}]]}],null,null,false,[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"children\\\":\\\"Писмени становища внесоха:\\\"}],\\\" \\\",\\\"$42\\\",\\\". \\\",\\\"$L43\\\"]}]]}]]}]]}]\\n2a:[\\\"$\\\",\\\"div\\\",\\\"167501\\\",{\\\"className\\\":\\\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted\\\",\\\"children\\\":\\\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mt-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167501\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"className\\\":\\\"text-ink\\\",\\\"children\\\":\\\"Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс\\\"}],\\\" \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-muted num font-normal\\\",\\\"children\\\":[\\\"№ \\\",\\\"52-654-01-113\\\"]}]]}],[\\\"$\\\",\\\"details\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer font-semibold text-green mt-2\\\",\\\"children\\\":\\\"Покажи цитатите\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-5 mt-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-green pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Какво предлага законопроектът\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"Това с практика, въведена в множество европейски държави и значително ще улесни разследващите органи, като се предвиждат гаранции срещу промени в заснетото съдържание (един възможен начин би бил квалифициран електронен времеви печат по смисъла на Регламент (ЕС) 910/2014).\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"По отношение на предложението в чл. 163 До 2025 г, НПК предвиждаше иззети компютърни данни да се възпроизвеждат на хартиен носител и да се подписват на всяка страница.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[\\\"„\\\",\\\"По тази причина с настоящите промени се премахват текстовете, насочващи към определен вид елсктронен носител. (0) оглед на ограничаване на рисковете от злоупотреби се предвиждат технически гаранции срещу подмяна на данните, съхранявани в електронен формат (чрез квалифициран електронен времеви печат по смисъла на Регламент (ЕС) 910/2014), както и срещу незаконосъобразно разгласяване (чрез съхранение в шифриран вид).\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[\\\"„\\\",\\\"За целта е необходима техническа подготовка, която обаче не следва да е предизвикателство в 21-ви век.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"children\\\":[\\\"„\\\",\\\"По отношение на предложението в чл. 206а, чл. 247а и предложението за нов чл. 381 в ЗСВ Предлага се въвеждане на електронно досъдебно производство.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"5\\\",{\\\"children\\\":[\\\"„\\\",\\\"По отношение на параграф 9 (уасайо |ер!5) Предлагат се законът да влезе в сила шест месеца след обнародването му, поради големият брой промени, които изискват обновяване на вътрешни правила и процеси и подготовка на заинтересованите страни, като се предвижда допълнително отлагане с три години на изграждането на Единна информационна система за наказателни производства, която изисква значително време за подготовка, изграждане и внедряване.\\\",\\\"“\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted mt-1\\\",\\\"children\\\":[\\\"Източник: \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167501\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":\\\"доклад на комисията и мотиви, parliament.bg\\\"}]]}]]}],null,null,false,[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null