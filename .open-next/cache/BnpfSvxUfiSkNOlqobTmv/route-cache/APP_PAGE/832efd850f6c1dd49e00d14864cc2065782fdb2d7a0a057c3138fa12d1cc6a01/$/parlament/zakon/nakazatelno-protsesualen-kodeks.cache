block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\\\",\\\"children\\\":\\\"Двете страни\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"mnenie\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#mnenie\\\",\\\"className\\\":\\\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\\\",\\\"children\\\":\\\"Твоето мнение\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"grupi\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#grupi\\\",\\\"className\\\":\\\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\\\",\\\"children\\\":\\\"Как гласуваха\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"glasuvaniya\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#glasuvaniya\\\",\\\"className\\\":\\\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\\\",\\\"children\\\":\\\"Гласувания (28)\\\"}]}]]}]}],[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"nakratko\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Накратко\\\"}],\\\"$undefined\\\",[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"max-w-4xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[17px]\\\",\\\"children\\\":\\\"Законът въвежда задължителен съдебен контрол, когато прокуратурата прекратява или спира дела за корупция на хора на висши публични длъжности и дела срещу главния прокурор. Ad hoc прокурорът, който разследва главния прокурор или заместниците му, се контролира от съдия от наказателната колегия на ВКС, избран на случаен принцип. Задържаните и обвиняемите трябва да бъдат уведомявани за правата си (адвокат, правна помощ, превод, право на мълчание), а при задочните дела се спазват решенията на Съда на ЕС. Държавата отговаря за вреди, когато длъжностно лице публично наруши презумпцията за невиновност. Проектът на ДБ въвежда право на незабавна жалба пред съд срещу 72-часовото прокурорско задържане.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"children\\\":\\\"Вносители:\\\"}],\\\" \\\",\\\"Общ законопроект на правната комисия от проектите на Министерския съвет (№ 52-602-01-1 и 52-602-01-8) и на Йордан Иванов, Надежда Йорданова и др. (ДБ)\\\",[\\\" · \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167016\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":[\\\"законопроект \\\",\\\"52-653-123-8\\\"]}]]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"children\\\":\\\"Какво се случи:\\\"}],\\\" \\\",\\\"Второ четене на 17–18.06.2026 г. (28 гласувания). Становища внесоха Висшият адвокатски съвет, ВКС, Прокуратурата, Министерството на правосъдието и Камарата на следователите.\\\"]}]]}]]}],false,\\\"$L1b\\\",\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\",\\\"$L1f\\\",\\\"$L20\\\"]}]\\n2c:I[52368,[\\\"$2\\\",\\\"$9\\\"],\\\"CitizenVote\\\"]\\n21:T758,Независимо сдружение на българските прокурори относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-117, внесен от Силвия Тошкова Христова и група народни представители на 31.07.2026 г.; Висшия адвокатски съвет относно Законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-117, внесен от Силвия Тошкова Христова и група народни представители на 31.07.2026 г.; Министерство на правосъдието относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-117, внесен от г-жа Силвия Тошкова Христова и група народни представители на 31 юли 2026 г.; Прокуратурата на Република България относно законопроект за изменение и допълнение на Наказателно-процесуалния кодекс, № 52-654-01-117, в