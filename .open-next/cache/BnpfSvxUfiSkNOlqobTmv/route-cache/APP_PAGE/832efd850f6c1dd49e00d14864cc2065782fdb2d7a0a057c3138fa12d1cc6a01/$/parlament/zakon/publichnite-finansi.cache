ttps://www.parliament.bg/bg/bills/ID/167610\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"title\\\":\\\"Народно събрание: законопроект № 52-602-01-55, доклади и становища\\\",\\\"className\\\":\\\"ml-0.5 no-underline\\\",\\\"children\\\":[\\\"[\\\",1,\\\"]\\\"]}]]]}]]}]]}]]}]]}]]}],null,[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"display text-[1.8rem] mb-1\\\",\\\"children\\\":\\\"Двете страни на монетата\\\"}],\\\"$L23\\\",\\\"$L24\\\"]}],\\\"$L25\\\",null,\\\"$L26\\\"]}]\\n1d:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"dokumenti\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Още от документите\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":\\\"Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-4 max-w-4xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"167067\\\",{\\\"className\\\":\\\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted\\\",\\\"children\\\":\\\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mt-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167067\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"className\\\":\\\"text-ink\\\",\\\"children\\\":\\\"Законопроект за допълнение на Закона за публичните финанси\\\"}],\\\" \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-muted num font-normal\\\",\\\"children\\\":[\\\"№ \\\",\\\"52-654-01-59\\\"]}]]}],[\\\"$\\\",\\\"details\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer font-semibold text-green mt-2\\\",\\\"children\\\":\\\"Покажи цитатите\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-5 mt-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-green pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Какво предлага законопроектът\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"Мартин Димитров, като в изложението си той очерта целите на промените в него, а именно: - въвеждане на външна оценка на качеството на бюджетите в програмен формат и - създаване на задължение за своевременно публикуване на месечни данни за приходите и разходите по консолидираната фискална програма в отворен и машинночетим формат.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"Законопроектът, внесен от Министерския съвет, беше представен от г-н Методиев, който посочи, че промените в Закона за публичните финанси са продиктувани от новата рамка за икономическо управление на Европейския съюз от м. април 2024 г. и от въвеждане на еврото в страната от 1 януари 2026 г.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[\\\"„\\\",\\\"Основните промени в законопроекта се отнасят до: ● Промени относно фискалните правила.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[\\\"„\\\",\\\"Запазват се основните ограничения от Пакта за стабилност и растеж за дефицита и дълга и се въвежда проследяване на ръста на нетните разходи спрямо одобрения от Съвета на Европейския съюз план за нетните разходи за България.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"children\\\":[\\\"„\\\",\\\"При определянето на плана на нетните разходи се отчита цикличната позиция на държавата през отделните години от периода, както и фискалния ефект върху икономическия растеж.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"5\\\",{\\\"children\\\":[\\\"„\\\",\\\"Целите за растежа на разходите се определят така, че да осигурят устойчиво във времето изменение на структурния баланс, без същевременно да водят до натрупване на прекомерен дълг.\\\",\\\"“\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted mt-1\\\",\\\"children\\\":[\\\"Източник: \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167067\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":\\\"доклад на комисията и мотиви, parliament.bg\\\"}]]}]]}],null,[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-red pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Възражения и критики\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"В писменото си становище Министерството на финансите не подкрепя двата законопроекта с вносител Божидар Божанов и група народни представители.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"Божидар Божанов и група народни представители със сигнатура № 52-654-01-59, Стефан Белчев се изказа за неподкрепа с аргументи за излишно дублиране на информация, нереалистични срокове, изключително скъпи софтуерни промени без да е налице гаранция, че това ще подобри качеството на макрофискалните данни, а Владислав Горанов го подкрепи с оглед разширяване на публичността на отчетността на публичните финанси.\\\",\\\"“\\\"]}],\\\"$L27\\\"]}],\\\"$L28\\\"]}],false,false]}]]}]]}],\\\"$L29\\\"]}]]}]\\n1e:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"mnenie\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"childr