ren\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"children\\\":\\\"Какво се случи:\\\"}],\\\" \\\",\\\"Първо четене единодушно (163 „за“, 14.10.2026 г.); срокът за предложения беше съкратен на три дни. Окончателно — единодушно (173 „за“, 13.11.2026 г.). На второ четене е добавен нов параграф и промяна в преходните и заключителните разпоредби.\\\"]}]]}]]}],[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"signali\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Сигнали\\\"}],\\\"$L1b\\\",[\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\"]]}],\\\"$L1f\\\",\\\"$L20\\\",\\\"$L21\\\",\\\"$L22\\\",\\\"$L23\\\",\\\"$L24\\\"]}]\\n29:I[52368,[\\\"$2\\\",\\\"$9\\\"],\\\"CitizenVote\\\"]\\n1b:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":\\\"Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.\\\"}]\\n1c:[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"grid gap-3 md:grid-cols-2 max-w-5xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"Съкратен срок за предложения (три дни)\\\",{\\\"className\\\":\\\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold\\\",\\\"children\\\":\\\"Съкратен срок за предложения (три дни)\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mt-1\\\",\\\"children\\\":\\\"Мнозинството гласува по-кратък срок от обичайните 7 дни, в който депутатите могат да внасят промени между първо и второ четене.\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"Внесен от депутати\\\",{\\\"className\\\":\\\"border-l-4 rounded-sm p-4 border-rule bg-surface\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold\\\",\\\"children\\\":\\\"Внесен от депутати\\\"}],[\\\"$\\\",