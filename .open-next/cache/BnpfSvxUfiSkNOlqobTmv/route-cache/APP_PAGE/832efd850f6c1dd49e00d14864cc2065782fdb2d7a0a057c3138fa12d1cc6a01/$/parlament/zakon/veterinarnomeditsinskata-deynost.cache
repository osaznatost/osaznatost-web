"$\",\"a\",null,{\"href\":\"#glasuvaniya\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Гласувания (2)\"}]}]\n1b:[\"$\",\"section\",null,{\"id\":\"nakratko\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Накратко\"}],\"$undefined\",[\"$\",\"div\",null,{\"className\":\"max-w-4xl\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[17px]\",\"children\":\"Забранява се отглеждането, развъждането и умъртвяването на животни за ценни кожи, със санкции; чрез промяна в Закона за защита на животните това става „проява на жестокост“. Отпада изключението, което позволяваше хранене на животни във ферми с кухненски отпадъци. Наредбите трябва да се обновят до 6 месеца.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Вносители:\"}],\" \",\"Антон Кутев, Явор Гечев, Кръстьо Врачев и др. („Прогресивна България“)\",[\" · \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167580\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"законопроект \",\"52-654-01-155\"]}]]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Какво се случи:\"}],\" \",\"Първо четене единодушно (163 „за“, 14.10.2026 г.); срокът за предложения беше съкратен на три дни. Окончателно — единодушно (173 „за“, 13.11.2026 г.). На второ четене е добавен нов параграф и промяна в преходните и заключителните разпоредби.\"]}]]}]]}]\n1c:[\"$\",\"section\",null,{\"id\":\"signali\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Сигнали\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.\"}],[[\"$\",\"ul\",null,{\"className\":\"grid gap-3 md:grid-cols-2 max-w-5xl\",\"children\":[[\"$\",\"li\",\"Съкратен срок за предложения (три дни)\",{\"className\":\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Съкратен срок за предложения (три дни)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Мнозинството гласува по-кратък срок от обичайните 7 дни, в който депутатите могат да внасят промени между първо и второ четене.\"}]]}],[\"$\",\"li\",\"Внесен от депутати\",{\"className\":\"border-l-4 rounded-sm p-4 border-rule bg-surface\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Внесен от депутати\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Законопроектите на депутати не минават през задължителното 30-дневно обществено обсъждане на strategy.bg, както тези на Министерския съвет, и често нямат подробна оценка на въздействието.\"}]]}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3\",\"children\":[\"$\",\"$La\",null,{\"href\":\"/parlament/signali\",\"children\":\"Всички сигнали в парламента\"}]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-2\",\"children\":[\"Сигналът е повод за въпрос, не доказателство за нарушение.\",\" \",[\"$\",\"$La\",null,{\"href\":\"/metodologiya#signal\",\"className\":\"underline\",\"children\":\"Как работим със сигналите\"}]]}]]]}]\n1d:[\"$\",\"section\",null,{\"id\":\"zakonoproekti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Кой внесе и кой се изказа\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Законопроектите, с които е променян законът в този парламент: вносители, комисии, ст