нията за изпълнение на националните дейности/инвестиции в заключителния етап от изпълнението на проектите по Националния план за възстановяване и устойчивост (НПВУ).\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167035\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"border-l-4 border-red pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Възражения и критики\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"По този начин се минимизира влиянието на потенциални рискове за бюджета в случай на временен ликвиден недостиг, породен от различната падежна структура на приходите и разходите и краткосрочните задължения се обезпечават навреме и в пълен обем, времево синхронизирани с дългови инструменти за тяхното покриване.\",\"“\"]}],\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\"]}],\"$L2d\"]}],\"$L2e\",false]}]]}]]}],\"$L2f\"]}]]}]\n1f:[\"$\",\"section\",null,{\"id\":\"mnenie\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Твоето мнение\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":[\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \",[\"$\",\"$La\",null,{\"href\":\"/mnenie\",\"children\":\"Всички закони за гласуване\"}],\".\"]}],[\"$\",\"$L30\",null,{\"item\":\"byudzheta-na-darzhavnoto-obshtestveno-osiguryavane-za-2026-g-i-zakona-za-byudzheta-na-natsionalnata-zdravnoosiguritelna-kasa-za-2026-g\",\"question\":\"Подкрепяш ли последните промени в „Удължителният закон за бюджета 2026 (нов дълг до приема