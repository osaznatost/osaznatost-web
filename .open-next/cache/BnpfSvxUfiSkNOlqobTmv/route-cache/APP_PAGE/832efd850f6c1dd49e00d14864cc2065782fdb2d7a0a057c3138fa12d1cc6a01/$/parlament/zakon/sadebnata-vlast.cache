{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/zakon/layout,_N_T_/parlament/zakon/[slug]/layout,_N_T_/parlament/zakon/[slug]/page,_N_T_/parlament/zakon/sadebnata-vlast"},"segmentPaths":["/_tree","/_full","/parlament/zakon/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/832efd850f6c1dd49e00d14864cc2065782fdb2d7a0a057c3138fa12d1cc6a01/$/parlament/zakon/sadebnata-vlast","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/zakon/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0vn96-fhbu77m.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><script src=\"/_next/static/chunks/43gzry38n6x69.js\" async=\"\"></script><title>Закон за съдебната власт · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Закон за съдебната власт · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Закон за съдебната власт · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Парламент</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Закон</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Закон за съдебната власт</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Приет окончателно на 25 юни 2026 г., обнародван в ДВ бр. 60 от 1 юли 2026 г., в сила от същия ден</div></div></div><nav aria-label=\"Секции на страницата\" class=\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\"><ul class=\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\"><li><a href=\"#nakratko\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Накратко</a></li><li><a href=\"#signali\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Сигнали (2)</a></li><li><a href=\"#zakonoproekti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Кой внесе и кой се изказа</a></li><li><a href=\"#argumenti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Двете страни</a></li><li><a href=\"#mnenie\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Твоето мнение</a></li><li><a href=\"#grupi\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Как гласуваха</a></li><li><a href=\"#glasuvaniya\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Гласувания (40)</a></li></ul></nav><section id=\"nakratko\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Накратко</h2><div class=\"max-w-4xl\"><p class=\"text-[17px]\">Промените засягат Висшия съдебен съвет (ВСС): кой и как може да избира ръководителите в съдебната власт, включително главния прокурор, и как се избира нов състав на ВСС. Внесени бяха три отделни законопроекта: от Олга Борисова („Прогресивна България“), от Надежда Йорданова (ДБ) и от Велислав Величков (ПП). След промените ВСС трябваше да организира избор на членове от квотата на съдии, прокурори и следователи до 17 октомври 2026 г.</p><p class=\"mt-3 text-[15px]\"><b>Какво се случи:</b> <!-- -->На първо четене (14 май) проектът на „Прогресивна България“ мина единодушно със 189 гласа. Проектите на ДБ и ПП също бяха приети, но ДПС гласува „против“ тях (18 гласа). На второ четене (25 юни) законът мина със 183 гласа „за“ и без нито един „против“.</p></div></section><section id=\"signali\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Сигнали</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.</p><ul class=\"grid gap-3 md:grid-cols-2 max-w-5xl\"><li class=\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\"><p class=\"font-semibold\">6 нови текста, приети на второ четене</p><p class=\"text-[15px] text-muted mt-1\">Текстове, които ги нямаше в първоначалния законопроект. Обикновено са поправки, но могат и да променят смисъла.</p></li><li class=\"border-l-4 rounded-sm p-4 border-rule bg-surface\"><p class=\"font-semibold\">Внесен от депутати</p><p class=\"text-[15px] text-muted mt-1\">Законопроектите на депутати не минават през задължителното 30-дневно обществено обсъждане на strategy.bg, както тези на Министерския съвет, и често нямат подробна оценка на въздействието.</p></li></ul><p class=\"text-sm mt-3\"><a href=\"/parlament/signali\">Всички сигнали в парламента</a></p><p class=\"text-xs text-muted mt-2\">Сигналът е повод за въпрос, не доказателство за нарушение.<!-- --> <a class=\"underline\" href=\"/metodologiya#signal\">Как работим със сигналите</a></p></section><section id=\"zakonoproekti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Кой внесе и кой се изказа</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.</p><ul class=\"space-y-4 max-w-5xl\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167631\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за съдебната власт</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-173</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>10 ноември 2026 г.<!-- --> от <!-- -->Александра Вълчева, Тодор Барболов, Милен Трифонов и още 1 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">Становища</dt><dd>Независимото сдружение на българските прокурори относно законопроект за изменение и допълнение на Закона за съдебната власт, № 52-654-01-173, внесен от Александра Йовчева Вълчева и група народни представители на 10.11.2026 г.</dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167011\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Общ законопроект за изменение и допълнение на Закона за съдебната власт</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-653-123-6</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>14 май 2026 г.<!-- --> от <!-- -->депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Временна комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">Становища</dt><dd>съдии от всички съдебни райони във връзка с предстоящите избори за нов състав на Висш съдебен съвет от професионалната квота.; група съдии – участници в конкурси за повишаване в длъжност в окръжните и административните съдилища относно общ законопроект № 52-653-123-6 от 14.05.2026 г.; Национален институт на правосъдието относно общ законопроект № 52-653-123-6 от 14.05.2026 г.; Висш съдебен съвет относно общ законопроект за изменение и допълнение на Закона за съдебната власт № 52-653-123-6 от 15.05.2026 г.; Българска съдийска асоциация относно общ законопроект за изменение и допълнение на Закона за съдебната власт № 52-653-123-6 от 15.05.2026 г.; Инспектората към Висш съдебен съвет относно общ законопроект за изменение и допълнение на Закона за съдебната власт № 52-653-123-6 от 15.05.2026 г.; Пленума на Върховния административен съд относно общ  законопроект № 52-653-123-6 от 15.05.2026 г. за изменение и допълнение на Закона за съдебната власт; Висшия адвокатски съвет относно общ  законопроект № 52-653-123-6 от 15.05.2026 г. за изменение и допълнение на Закона за съдебната власт; Прокуратура на Република България относно общ законопроект за изменение и допълнение на Закона за съдебната власт № 52-653-123-6 от 14.05.2026 г.; Борислав Колев относно общ  законопроект № 52-653-123-6 от 15.05.2026 г. за изменение и допълнение на Закона за съдебната власт; Съюза на съдиите в България относно общ законопроект за изменение и допълнение на Закона за съдебната власт № 52-653-123-6 от 14.05.2026 г.; Върховен касационен съд относно общ  законопроект № 52-653-123-6 от 15.05.2026 г. за изменение и допълнение на Закона за съдебната власт</dd><dt class=\"text-muted\">Предложения</dt><dd>6<!-- --> писмени предложения на депутати между <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">първо</button></span> и <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">второ четене</button></span></dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11143\" target=\"_blank\" rel=\"noreferrer\">25 юни 2026 г.</a> (<!-- -->зала второ гласуване<!-- -->)</span><span>, <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11144\" target=\"_blank\" rel=\"noreferrer\">26 юни 2026 г.</a> (<!-- -->зала второ гласуване<!-- -->)</span></dd><dt class=\"text-muted\">Обнародван</dt><dd>ДВ, бр. 60/2026<!-- -->, приет на 26 юни 2026 г.</dd></dl></li></ul><details class=\"mt-3 max-w-5xl\"><summary class=\"cursor-pointer font-semibold text-green py-2\">Още <!-- -->3<!-- --> законопроекта по този закон</summary><ul class=\"space-y-4 mt-2\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167002\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за съдебната власт</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-37</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>11 май 2026 г.<!-- --> от <!-- -->Олга Борисова, Михаела Доцова, Петър Витанов и още 19 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Временна комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">Становища</dt><dd>Обединение на свободните адвокати относно законопроект за изменение и допълнение на Закона за съдебната власт, № 52-654-01-37, внесен от Олга Бориславова Борисова и група народни представители на 11.05.2026 г.; председателя на Върховен касационен съд относно законопроект за изменение и допълнение на Закона за съдебната власт, № 52-654-01-37, внесен от Олга Бориславова Борисова и група народни представители на 11.05.2026 г.; Инспектората към Висшия съдебен съвет относно законопроект за изменение и допълнение на Закона за съдебната власт, № 52-654-01-37, внесен от Олга Бориславова Борисова и група народни представители на 11.05.2026 г.</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11125\" target=\"_blank\" rel=\"noreferrer\">14 май 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/166955\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за съдебната власт</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-17</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>30 април 2026 г.<!-- --> от <!-- -->Надежда Йорданова, Атанас Славов, Божидар Божанов и още 12 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Временна комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">Становища</dt><dd>председателя на Върховен касационен съд относно законопроект за изменение и допълнение на Закона за съдебната власт, № 52-654-01-17, внесен от Надежда Георгиева Йорданова и група народни представители на 30.04.2026 г.; Инспекторат към Висшия съдебен съвет относно законопроект за изменение и допълнение на Закона за съдебната власт, № 52-654-01-17, внесен от Надежда Георгиева Йорданова и група народни представители на 30.04.2026 г.</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11125\" target=\"_blank\" rel=\"noreferrer\">14 май 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/166947\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за съдебната власт</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-9</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>30 април 2026 г.<!-- --> от <!-- -->Велислав Величков, Асен Василев, Бойко Рашков и още 13 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Временна комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">Становища</dt><dd>Обединение на свободните адвокати относно законопроект за изменение и допълнение на Закона за съдебната власт, № 52-654-01-9, внесен от Велислав Величков Величков и група народни представители на 30.04.2026 г.; председателя на Върховен касационен съд относно законопроект за изменение и допълнение на Закона за съдебната власт, № 52-654-01-9, внесен от Велислав Величков Величков и група народни представители на 30.04.2026 г.</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11125\" target=\"_blank\" rel=\"noreferrer\">14 май 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li></ul></details></section><div id=\"argumenti\" class=\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\"><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Олга Борисова („Прогресивна България“)</p><p class=\"text-[15px]\">Да се избегнат предварителни уговорки и прегрупирания във ВСС и да бъде избран нов, легитимен главен прокурор.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/museums/sliven/im-kotel/1155959-pg-progresivna-balgariya-narodnoto-sabranie-okonchatelno-prie-promeni-v-zakon\" target=\"_blank\" rel=\"noreferrer\" title=\"Прессъобщение на ПГ „Прогресивна България“ (БТА)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Надежда Йорданова (ДБ) и Велислав Величков (ПП)</p><p class=\"text-[15px]\">ВСС с изтекъл мандат не трябва да избира „тримата големи“ в съдебната власт.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/videos/21974\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Надежда Йорданова за промените\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">ДПС</p><p class=\"text-[15px]\">Подкрепи проекта на управляващите, но гласува против проектите на ДБ и ПП. Публично обяснение на позицията не открихме.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\" title=\"Поименни гласувания, Народно събрание (чрез „Наясно“)\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-3\">Какво казват данните</h3><ul class=\"space-y-2 list-none pl-0\"><li class=\"border-l-4 border-deep pl-4 text-[15px]\">Първо четене (14 май): проектът на „Прогресивна България“ мина със 189 гласа, без „против“. ДПС гласува против проектите на ДБ и ПП с 18 гласа.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\" title=\"Поименни гласувания, Народно събрание (чрез „Наясно“)\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">Второ четене (25 юни): 183 „за“, нито един „против“.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\" title=\"Поименни гласувания, Народно събрание (чрез „Наясно“)\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">Изборът на членове на ВСС от съдиите, прокурорите и следователите трябваше да е до 17 октомври 2026 г.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://vss.justice.bg/root/f/upload/49/2026_Pravila_izbor_chlenove.pdf\" target=\"_blank\" rel=\"noreferrer\" title=\"ВСС: правила за избор на членове, по ДВ бр. 60/2026\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></li></ul></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Двете страни на монетата</h3><p class=\"text-sm text-muted mb-3\">Какво следва на практика, ако законът се приеме и ако се отхвърли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://vss.justice.bg/root/f/upload/49/2026_Pravila_izbor_chlenove.pdf\" target=\"_blank\" rel=\"noreferrer\" title=\"ВСС: правила за избор на членове, по ДВ бр. 60/2026\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a><a href=\"https://www.bta.bg/bg/museums/sliven/im-kotel/1155959-pg-progresivna-balgariya-narodnoto-sabranie-okonchatelno-prie-promeni-v-zakon\" target=\"_blank\" rel=\"noreferrer\" title=\"Прессъобщение на ПГ „Прогресивна България“ (БТА)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.bta.bg/bg/videos/21974\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Надежда Йорданова за промените\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\"><p class=\"font-semibold\">Ако се приеме</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Ръководителите в съдебната власт, включително главният прокурор, се избират от ВСС с нов мандат.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Докато се избере нов ВСС, ключови постове остават временно заети.</li></ul></div></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\"><p class=\"font-semibold\">Ако се отхвърли</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">ВСС с изтекъл мандат запазва правото си да избира ръководители.</li></ul></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Какво печели и какво губи всяка страна</h3><p class=\"text-sm text-muted mb-3\">Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.</p><div class=\"space-y-3\"><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Гражданите<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://vss.justice.bg/root/f/upload/49/2026_Pravila_izbor_chlenove.pdf\" target=\"_blank\" rel=\"noreferrer\" title=\"ВСС: правила за избор на членове, по ДВ бр. 60/2026\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a><a href=\"https://www.bta.bg/bg/museums/sliven/im-kotel/1155959-pg-progresivna-balgariya-narodnoto-sabranie-okonchatelno-prie-promeni-v-zakon\" target=\"_blank\" rel=\"noreferrer\" title=\"Прессъобщение на ПГ „Прогресивна България“ (БТА)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Ръководителите в съдебната власт, включително главният прокурор, се избират от ВСС с нов мандат.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Докато се избере нов ВСС, ключови постове остават временно заети.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Сегашният ВСС с изтекъл мандат<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/museums/sliven/im-kotel/1155959-pg-progresivna-balgariya-narodnoto-sabranie-okonchatelno-prie-promeni-v-zakon\" target=\"_blank\" rel=\"noreferrer\" title=\"Прессъобщение на ПГ „Прогресивна България“ (БТА)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.bta.bg/bg/videos/21974\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Надежда Йорданова за промените\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Губи правото да избира ръководители в съдебната власт.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Съдиите, прокурорите и следователите<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://vss.justice.bg/root/f/upload/49/2026_Pravila_izbor_chlenove.pdf\" target=\"_blank\" rel=\"noreferrer\" title=\"ВСС: правила за избор на членове, по ДВ бр. 60/2026\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Избират нови свои членове във ВСС.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">—</p></div></div></div></div></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://vss.justice.bg/root/f/upload/49/2026_Pravila_izbor_chlenove.pdf\" target=\"_blank\" rel=\"noreferrer\">ВСС: правила за избор на членове, по ДВ бр. 60/2026</a></li><li><a href=\"https://www.bta.bg/bg/museums/sliven/im-kotel/1155959-pg-progresivna-balgariya-narodnoto-sabranie-okonchatelno-prie-promeni-v-zakon\" target=\"_blank\" rel=\"noreferrer\">Прессъобщение на ПГ „Прогресивна България“ (БТА)</a></li><li><a href=\"https://www.bta.bg/bg/videos/21974\" target=\"_blank\" rel=\"noreferrer\">БТА: Надежда Йорданова за промените</a></li><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания, Народно събрание (чрез „Наясно“)</a></li></ol><p class=\"text-xs text-muted mt-2\">Броят гласове е по поименните данни на Народното събрание. Таблицата „Какво печели и какво губи всяка страна“ и последиците „ако се приеме / ако се отхвърли“ са наш анализ на текста и аргументите от източниците, не позиция на партия.<!-- --> Проверено: <!-- -->17 ноември 2026 г.</p></div></div><section id=\"dokumenti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Още от документите</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.</p><div class=\"space-y-4 max-w-4xl\"><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167631\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за съдебната власт</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-173</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Целта на това предложение е еднозначно обвързване на ранга и следващите се от него придобивки, свързани с по-високо заплащане, единствено с професионалните качества на съдията, прокурора или следователя.<!-- -->“</li><li>„<!-- -->С предложените промени се предвижда да отпадне обвързването на средствата за облекло със средната работна заплата, в съответствие с цялостната политика по отпадане на „автоматизма“ при увеличаване на подобни плащания в други публични сектори, по-ефективно използване на финансовите ресурси и оптимизиране на разходите за издръжка.<!-- -->“</li><li>„<!-- -->Административна тежест и структурни промени Не се предвиждат повишаване на админист<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167631\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->Независимото сдружение на българските прокурори относно законопроект за изменение и допълнение на Закона за съдебната власт, № 52-654-01-173, внесен от Александра Йовчева Вълчева и група народни представители на 10.11.2026 г.<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167631\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167011\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Общ законопроект за изменение и допълнение на Закона за съдебната власт</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-653-123-6</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Николета Тодорова</b><span class=\"text-muted\"> (<!-- -->ПБ<!-- -->)</span>: „<!-- -->Във връзка с чл. 80, ал. 2, изречение второ от Правилника за организацията и дейността на Народното събрание правя предложение за следните редакционни, съответно правно-технически<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11144\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->26.06.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->съдии от всички съдебни райони във връзка с предстоящите избори за нов състав на Висш съдебен съвет от професионалната квота.; група съдии – участници в конкурси за повишаване в длъжност в окръжните и административните съдилища относно общ законопроект № 52-653-123-6 от 14.05.2026 г.; Национален институт на правосъдието относно общ законопроект № 52-653-123-6 от 14.05.2026 г.; Висш съдебен съвет относно общ законопроект за изменение и допълнение на Закона за съдебната власт № 52-653-123-6 от 15.05.2026 г.; Българска съдийска асоциация относно общ законопроект за изменение и допълнение на Закона за съдебната власт № 52-653-123-6 от 15.05.2026 г.; Инспектората към Висш съдебен съвет относно общ законопроект за изменение и допълнение на Закона за съдебната власт № 52-653-123-6 от 15.05.2026 г.; Пленума на Върховния административен съд относно общ  законопроект № 52-653-123-6 от 15.05.2026 г. за изменение и допълнение на Закона за съдебната власт; Висшия адвокатски съвет относно общ  законопроект № 52-653-123-6 от 15.05.2026 г. за изменение и допълнение на Закона за съдебната власт; Прокуратура на Република България относно общ законопроект за изменение и допълнение на Закона за съдебната власт № 52-653-123-6 от 14.05.2026 г.; Борислав Колев относно общ  законопроект № 52-653-123-6 от 15.05.2026 г. за изменение и допълнение на Закона за съдебната власт; Съюза на съдиите в България относно общ законопроект за изменение и допълнение на Закона за съдебната власт № 52-653-123-6 от 14.05.2026 г.; Върховен касационен съд относно общ  законопроект № 52-653-123-6 от 15.05.2026 г. за изменение и допълнение на Закона за съдебната власт<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167011\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167002\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за съдебната власт</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-37</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Със законопроекта се въвеждат специални правила и ясни критерии за подбор на членове на органите на съдебната власт, с цел повишаване на прозрачността, обективността и предвидимостта на процедурите, както и гарантиране на високи стандарти за професионализъм и интегритет.<!-- -->“</li><li>„<!-- -->Друг съществен акцент е ограничаването на правомощията на ВСС след изтичане на мандата на неговите членове, като се предвижда тяхното упражняване само по изключение и при необходимост, свързана с осигуряване на нормалното функциониране на съдебната система.<!-- -->“</li><li>„<!-- -->С оглед утвърждаване на независимостта на съдебната власт се предвиждат и мерки за ограничаване на концентрацията на влияние, като се предлага лица, заемали висши ръководни длъжности, да не могат непосредствено да бъдат избирани за членове на ВСС.<!-- -->“</li><li>„<!-- -->Уреждат се и въпроси, свързани с временното изпълнение на ключови длъжности, включително председателя на Върховния административен съд и главния прокурор, както и практиките по командироване.<!-- -->“</li><li>„<!-- -->Със законопроекта се предвижда и отмяна на възможността за увеличаване на броя на съдиите във Върховния административен съд без достатъчна обосновка, като се отчита, че според данни на европейски органи България е сред държавите с висок брой върховни съдии, поради което подобни изменения следва да се предприемат след задълбочен анализ на тяхната необходимост.<!-- -->“</li><li>„<!-- -->Целта е да се прекъсне възможността за пренасяне на институционално влияние от върховете на системата към органа, който следва да осъществява независимо управление и кадрова политика.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167002\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Законопроектът беше представен от народния представител Олга Борисова, която посочи, че с него се отговаря на натрупаните затруднения в дейността на органите на съдебното управление и контрол и по-специално на Висшия съдебен съвет и Инспектората към него.<!-- -->“</li><li>„<!-- -->Допълнително се урежда засилване на контрола върху актовете на ВСС чрез разширяване на правомощията на министъра на правосъдието за тяхното оспорване.<!-- -->“</li><li>„<!-- -->Народните представители Янка Тянкова и Елена Нонева посочиха, че при изготвянето на промените в Закона за съдебната власт ще бъдат обсъдени становищата на институциите и гражданското общество, за да се гарантира устойчиво законодателство.<!-- -->“</li><li>„<!-- -->Народният представител Велислав Величков допълни, че подкрепя предложението за мораториум върху кадрови промени, като изрази нуждата от прецизиране на текстовете, за да се гарантира тяхното точно прилагане.<!-- -->“</li><li>„<!-- -->От Върховния касационен съд заявиха, че подкрепят законопроекта, като приветстваха предложенията, целящи да гарантират независимостта на съдебната система.<!-- -->“</li><li>„<!-- -->От ПГ на ГЕРБ-СДС посочиха, че ще подкрепят по принцип законопроекта и обсъдиха разпоредбите относно командироването на магистратите.<!-- -->“</li><li>„<!-- -->Г-жа Йорданова посочи, че от ПГ „Демократична България“ ще подкрепят законопроекта, като изрази необходимост от прецизиране на част от текстовете.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167002\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Тя допълни, че продължаващото функциониране на тези органи при изтекли мандати поражда въпроси относно легитимността на част от техните решения, създава предпоставки за правна несигурност и оказва влияние върху общественото доверие, като същевременно се открояват и съмнения, свързани с прозрачността при избора и възможни зависимости в рамките на съдебната система.<!-- -->“</li><li>„<!-- -->Народният представител Петър Петров заяви, че от ПГ ВЪЗРАЖДАНЕ ще подкрепят по принцип законопроекта, като дискутира предложената забрана за избор на членове на ВСС.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167002\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Янка Тянкова</b><span class=\"text-muted\"> (<!-- -->ПБ<!-- -->)</span>: „<!-- -->Позволете ми, преди да прочета докладите, които, както знаете, имат определена форма, и до голяма степен информацията в тях е повтаряща се, с изключение на направените изказвания и заетите становища, да кажа няколко думи като председател на Временната<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11125\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->14.05.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->Обединение на свободните адвокати относно законопроект за изменение и допълнение на Закона за съдебната власт, № 52-654-01-37, внесен от Олга Бориславова Борисова и група народни представители на 11.05.2026 г.; председателя на Върховен касационен съд относно законопроект за изменение и допълнение на Закона за съдебната власт, № 52-654-01-37, внесен от Олга Бориславова Борисова и група народни представители на 11.05.2026 г.; Инспектората към Висшия съдебен съвет относно законопроект за изменение и допълнение на Закона за съдебната власт, № 52-654-01-37, внесен от Олга Бориславова Борисова и група народни представители на 11.05.2026 г.<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167002\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/166955\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за съдебната власт</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-17</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Законопроектът беше представен от г-жа Йорданова, която посочи, че с него се въвежда реформа на управлението на съдебната система чрез засилване ролята на съдиите, ограничаване на политическото влияние, повишаване на прозрачността и отчетността, стесняване на правомощията на прокуратурата извън наказателния процес и въвеждане на гаранции срещу злоупотреби от органи с изтекъл мандат.<!-- -->“</li><li>„<!-- -->Тя отбеляза, че в съответствие с европейските стандарти се въвежда „двойно мнозинство“ при ключови решения както в пленума на ВСС, така и в съдийската колегия по кадрови и дисциплинарни въпроси.<!-- -->“</li><li>„<!-- -->Решенията ще изискват не само общо мнозинство, но и мнозинство от членовете, избрани пряко от съдиите, с цел укрепване на професионалната квота и ограничаване на политическото влияние.<!-- -->“</li><li>„<!-- -->Предвиждат се и мерки за деполитизация на парламентарната квота чрез разширяване на кръга от субекти, които могат да предлагат кандидати, както и въвеждане на изискване за политическа неутралност на кандидатите, проверявана за период от пет години назад.<!-- -->“</li><li>„<!-- -->Въвеждат се и ограничения върху правомощията на ВСС и Инспектората при изтекъл мандат на членовете им, като след изтичане на една година те няма да могат да вземат решения, засягащи пряко статута на магистратите.<!-- -->“</li><li>„<!-- -->Предлага се също ограничаване на увеличаването на щатните бройки в съдебната система.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/166955\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Народният представител Велислав Величков допълни, че подкрепя предложението за мораториум върху кадрови промени, като изрази нуждата от прецизиране на текстовете.<!-- -->“</li><li>„<!-- -->От Върховния касационен съд заявиха, че подкрепят законопроекта, като приветстваха предложенията, целящи да гарантират независимостта на съдебната система.<!-- -->“</li><li>„<!-- -->Г-жа Янка Тянкова и г-жа Елена Нонева посочиха, че от парламентарната група на Прогресивна България ще подкрепят законопроекта и отбелязаха, че при изготвянето на промените в Закона за съдебната власт ще бъдат обсъдени становищата на институциите и гражданското общество, за да се гарантира устойчиво законодателство.<!-- -->“</li><li>„<!-- -->От ПГ на ГЕРБ-СДС посочиха, че ще подкрепят по принцип законопроекта.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/166955\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Народният представител Петър Петров заяви, че от ПГ ВЪЗРАЖДАНЕ ще подкрепят по принцип законопроекта.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/166955\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Янка Тянкова</b><span class=\"text-muted\"> (<!-- -->ПБ<!-- -->)</span>: „<!-- -->Позволете ми, преди да прочета докладите, които, както знаете, имат определена форма, и до голяма степен информацията в тях е повтаряща се, с изключение на направените изказвания и заетите становища, да кажа няколко думи като председател на Временната<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11125\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->14.05.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->председателя на Върховен касационен съд относно законопроект за изменение и допълнение на Закона за съдебната власт, № 52-654-01-17, внесен от Надежда Георгиева Йорданова и група народни представители на 30.04.2026 г.; Инспекторат към Висшия съдебен съвет относно законопроект за изменение и допълнение на Закона за съдебната власт, № 52-654-01-17, внесен от Надежда Георгиева Йорданова и група народни представители на 30.04.2026 г.<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/166955\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div></div></section><section id=\"mnenie\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Твоето мнение</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. <a href=\"/mnenie\">Всички закони за гласуване</a>.</p><div class=\"bg-surface rounded-sm p-5 text-[15px] text-muted\">Зарежда се…</div></section><section id=\"grupi\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласуваха групите по този закон</h2></div><p class=\"text-sm text-muted mb-3\">Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо <!-- -->40<!-- -->. Прието: <!-- -->23<!-- -->, отхвърлено: <!-- -->17<!-- -->.</p><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Прогресивна България</p><p class=\"num text-sm mt-1\">За: <b>23</b> · Против: <b>17</b> · общо <!-- -->40</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ГЕРБ – СДС</p><p class=\"num text-sm mt-1\">За: <b>27</b> · Против: <b>0</b> · общо <!-- -->40</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Демократична България</p><p class=\"num text-sm mt-1\">За: <b>36</b> · Против: <b>0</b> · общо <!-- -->40</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ДПС</p><p class=\"num text-sm mt-1\">За: <b>20</b> · Против: <b>18</b> · общо <!-- -->39</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Продължаваме промяната</p><p class=\"num text-sm mt-1\">За: <b>36</b> · Против: <b>0</b> · общо <!-- -->38</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Възраждане</p><p class=\"num text-sm mt-1\">За: <b>29</b> · Против: <b>3</b> · общо <!-- -->34</p></div></div><p class=\"text-sm mt-3\">Първо четене: <a href=\"/parlament/glasuvane/2026-05-14-8\">14 май 2026 г.</a><a href=\"/parlament/glasuvane/2026-05-14-9\">14 май 2026 г.</a><a href=\"/parlament/glasuvane/2026-05-14-10\">14 май 2026 г.</a></p></section><section id=\"glasuvaniya\" class=\"scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Всички гласувания по закона</h2></div><ul><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-05-14-7\">Закона за съдебната власт – първо гласуване - процедура 