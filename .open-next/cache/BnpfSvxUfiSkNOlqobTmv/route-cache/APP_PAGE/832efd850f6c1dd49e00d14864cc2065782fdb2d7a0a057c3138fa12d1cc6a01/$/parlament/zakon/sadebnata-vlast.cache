dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"30 април 2026 г.\",\" от \",\"Велислав Величков, Асен Василев, Бойко Рашков и още 13 депутати\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Временна комисия по правни въпроси (водеща)\"}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Становища\"}],[\"$\",\"dd\",null,{\"children\":\"Обединение на свободните адвокати относно законопроект за изменение и допълнение на Закона за съдебната власт, № 52-654-01-9, внесен от Велислав Величков Величков и група народни представители на 30.04.2026 г.; председателя на Върховен касационен съд относно законопроект за изменение и допълнение на Закона за съдебната власт, № 52-654-01-9, внесен от Велислав Величков Величков и група народни представители на 30.04.2026 г.\"}]],false,false,false,false,[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"В залата\"}],[\"$\",\"dd\",null,{\"children\":[[\"$\",\"span\",\"0\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11125\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"14 май 2026 г.\"}],\" (\",\"зала първо гласуване\",\")\"]}]]}]],null]}]]}]\n41:[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-red mb-0.5\",\"children\":\"Губи\"}]\n42:[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"—\"}]\n44:[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Народните представители Янка Тянкова и Елена Нонева посочиха, че при изготвянето на промените в Закона за съдебната власт ще бъдат обсъдени становищата на институциите и гражданското общество, за да се гарантира устойчиво законодателство.\",\"“\"]}]\n45:[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"Народният представител Велислав Величков допълни, че подкрепя предложението за мораториум върху кадрови промени, като изрази нуждата от прецизиране на текстовете, за да се гарантира тяхното точно прилагане.\",\"“\"]}]\n46:[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"От Върховния касационен съд заявиха, че подкрепят законопроекта, като приветстваха предложенията, целящи да гарантират независимостта на съдебната система.\",\"“\"]}]\n47:[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"От ПГ на ГЕРБ-СДС посочиха, че ще подкрепят по принцип законопроекта и обсъдиха разпоредбите относно командироването на магистратите.\",\"“\"]}]\n48:[\"$\",\"li\",\"6\",{\"children\":[\"„\",\"Г-жа Йорданова посочи, че от ПГ „Демократична България“ ще подкрепят законопроекта, като изрази необходимост от прецизиране на част от текстовете.\",\"“\"]}]\n49:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167002\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]\n4a:[\"$\",\"div\",null,{\"className\":\"border-l-4 border-red pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Възражения и критики\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Тя допълни, че продължаващото функциониране на тези органи при изтекли мандати поражда въпроси относно легитимността на част от техните решения, създава предпоставки за правна несигурност и оказва влияние върху общественото доверие, като същевременно се открояват и съмнения, свързани с прозрачността при избора и възможни зависимости в рамките на съдебната система.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Народният представител Петър Петров заяви, че от ПГ ВЪЗРАЖДАНЕ ще подкрепят по принцип законопроекта, като дискутира предложената забрана за избор на членове на ВСС.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs 