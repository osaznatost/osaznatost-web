-y-2 mt-3\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-[#2f7d57]\",\"children\":\"Добрата страна\"}],[\"$\",\"ul\",null,{\"className\":\"list-none pl-0 space-y-1\",\"children\":[[\"$\",\"li\",\"Ръководителите в съдебната власт, включително главният прокурор, се избират от ВСС с нов мандат.\",{\"className\":\"text-[15px] pl-4 relative before:content-['+'] before:absolute before:left-0 before:font-bold\",\"children\":\"Ръководителите в съдебната власт, включително главният прокурор, се избират от ВСС с нов мандат.\"}]]}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-red\",\"children\":\"Рискът и цената\"}],[\"$\",\"ul\",null,{\"className\":\"list-none pl-0 space-y-1\",\"children\":[[\"$\",\"li\",\"Докато се избере нов ВСС, ключови постове остават временно заети.\",{\"className\":\"text-[15px] pl-4 relative before:content-['−'] before:absolute before:left-0 before:font-bold\",\"children\":\"Докато се избере нов ВСС, ключови постове остават временно заети.\"}]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Ако се отхвърли\"}],[\"$\",\"div\",null,{\"className\":\"space-y-2 mt-3\",\"children\":[false,[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-red\",\"children\":\"Рискът и цената\"}],[\"$\",\"ul\",null,{\"className\":\"list-none pl-0 space-y-1\",\"children\":[[\"$\",\"li\",\"ВСС с изтекъл мандат запазва правото си да избира ръководители.\",{\"className\":\"text-[15px] pl-4 relative before:content-['−'] before:absolute before:left-0 before:font-bold\",\"children\":\"ВСС с изтекъл мандат запазва правото си да избира ръководители.\"}]]}]]}]]}]]}]]}]]}]\n2b:[\"$\",\"div\",null,{\"className\":\"mt-8\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"di