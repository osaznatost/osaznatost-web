",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-red mb-0.5\",\"children\":\"Губи\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"От 1 август започват поетапно да плащат сами личните си осигуровки. Ако заплатата не се компенсира, нетното им възнаграждение намалява.\"}]]}]]}]]}],[\"$\",\"div\",\"Получателите на държавни плащания (заплати, пенсии, инвестиции)\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold px-4 pt-3\",\"children\":[\"Получателите на държавни плащания (заплати, пенсии, инвестиции)\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"2\",{\"href\":\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",2,\"]\"]}],[\"$\",\"a\",\"3\",{\"href\":\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Капитал: Бюджет 2026, какво трябва да знаем (15.07.2026)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",3,\"]\"]}]]]}]]}],[\"$\",\"div\",null,{\"className\":\"grid sm:grid-cols-2 gap-px bg-rule mt-3\",\"children\":[\"$L43\",\"$L44\"]}]]}],\"$L45\",\"$L46\"]}]]}]\n2e:[\"$\",\"div\",null,{\"className\":\"mt-8\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.8rem] mb-3\",\"children\":\"Проверени твърдения\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"„Събираемостта е силно занижена“ (Т. Петкова)\",{\"className\":\"rounded-xl ring-1 ring-rule p-4 bg-white\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-baseline justify-between gap-2\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"„Събираемостта е силно занижена“ (Т. Петкова)\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold px-2.5 py-0.5 rounded-full bg-[#e2b33b] text-ink\",\"children\":\"Подвеждащо\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Бюджет 2025, приет при нейното министерство, планира приходи по централния бюджет 28,2 млрд. €, а събра 26,3 млрд. € (−6,7%). Новият бюджет залага по-умерен ръст на приходите. Рискът е обратен: до май 2026 г. приходите растат само с 2%.\"}]]}],[\"$\",\"li\",\"Текстовете за Националната детска болница са били във всеки бюджет от 2022 г. (А. Василев)\",{\"className\":\"rounded-xl ring-1 ring-rule p-4 bg-white\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-baseline justify-between gap-2\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Текстовете за Националната детска болница са били във всеки бюджет от 2022 г. (А. Василев)\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold px-2.5 py-0.5 rounded-full bg-[#d2353f] text-white\",\"children\":\"Невярно\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Текст има само в бюджетите за 2024 и 2025 г., и в двата без конкретна сума.\"}]]}],[\"$\",\"li\",\"Отпада поименният списък с общинските проекти (А. Василев)\",{\"className\":\"rounded-xl ring-1 ring-rule p-4 bg-white\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-baseline justify-between gap-2\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Отпада поименният списък с общинските проекти (А. Василев)\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold px-2.5 py-0.5 rounded-full bg-[#2f9e6a] text-white\",\"children\":\"Вярно\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Приложение № 3 със списъка на проектите липсва. Правомощието на министъра не е ново, ново е, че списъкът вече не е публичен.\"}]]}]]}]]}]\n2f:[\"$\",\"div\",null,{\"className\":\"mt-8 text-sm\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Източници\"}],[\"$\",\"ol\",null,{\"className\":\"list-decimal pl-5 space-y-0.5\",\"children\":[[\"$\",\"li\",\"https://naiasno.bg/parliament\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://naiasno.bg/parliament\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Поименни гласувания 15.07.2026 и 24.07.2026, Народно събрание (чрез „Наясно“)\"}]}],[\"$\",\"li\",\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\"}]}],[\"$\",\"li\",\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Капитал: Бюджет 2026, какво трябва да знаем (15.07.2026)\"}]}],[\"$\",\"li\",\"https://www.bta.bg/bg/news/bulgaria/1167584\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.bta.bg/bg/news/bulgaria/1167584\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: Парламентът прие на първо четене бюджета за 2026 г.\"}]}],[\"$\",\"li\",\"https://www.nsi.bg/file/35225/notifikacionni_tablici_za_dalga_i_deficita_na_sektor_darjavno_upravlenie.pdf\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.nsi.bg/file/35225/notifikacionni_tablici_za_dalga_i_deficita_na_sektor_darjavno_upravlenie.pdf\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"НСИ: дефицит и дълг на сектор „Държавно управление“ за 2025 г. (предварителни данни)\"}]}],[\"$\",\"li\",\"https://bnrnews.bg/en/post/508409/bulgaria-with-new-domestic-debt-of-100-million-euros\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://bnrnews.bg/en/post/508409/bulgaria-with-new-domestic-debt-of-100-million-euros\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БНР: нов вътрешен дълг от 100 млн. € (28.07.2026)\"}]}],[\"$\",\"li\",\"https://ec.europa.eu/eurostat/databrowser/view/gov_10dd_edpt1/default/table\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://ec.europa.eu/eurostat/databrowser/view/gov_10dd_edpt1/default/table\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Евростат: дефицит и дълг (gov_10dd_edpt1)\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-2\",\"children\":[\"Проверките на твърденията и анализът на изпълнението са по данните и анализа на „Наясно“ (MIT), сверени с поименните гласувания. Таблицата „Какво печели и какво губи всяка страна“ и последиците „ако се приеме / ако се отхвърли“ са наш анализ на текста и аргументите от източниците, не позиция на партия.\",\" Проверено: \",\"17 ноември 2026 г.\"]}]]}]\n30:[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"В своето становище БСК подкрепя под условие законопроекта като настоява в хода на бюджетната процедура да се отложи увеличението на максималния осигурителен доход за 2027г., ръстът на минималните осигурителни доходи да се ограничи до ръста на минималната работна заплата за 2026г., годишната квота за ваучерите за храна да се увеличи с поне 6%.\",\"“\"]}]\n31:[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"Подкрепят промяната в модела за осигуряване на държавните служители.\",\"“\"]}]\n32:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167157\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]\n33:[\"$\",\"div\",null,{\"className\":\"border-l-4 border-red pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Възражения и критики\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"БТПП възразява срещу повишаването на минималните осигурителни прагове, не подкрепя повишаването на максималния осигурителен доход, подкрепя запазването на размера на обезщетенията за безработица и очаква мерки за балансирана бюджетна политика.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"В становището на КРИБ се изразява принципна подкрепа на законопроекта, но с определени резерви и предложения за премахване на автоматичната индексация на заплати; ограничаване ръста на плащанията за персонал в публичния сектор и разходите за социални плащания особено при необходимостта от драстична реформа на ТЕЛК; предлага се диференцирана, а не за всички, индексация на заплатите в бюджетния сектор според техния размер; настояват за обективен механизъм за определяне на минималната работна заплата и др.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"От ПГ „Продължаваме Промяната“, ПГ „Демократична България“, ПГ ГЕРБ-СДС и ПГ „ВЪЗРАЖДАНЕ“ посочиха, че не подкрепят законопроекта поради рекордния дефицит, липсата на реформи, липсата на целенасочени мерки за подкрепа на семействата, децата, младите хора и хората с увреждания, на мерки за насърчаване завръщането на майките в отпуск по майчинство отново на работа, на мерки за повишаване качеството на работната сила и за осигуряване на адекватна минимална работна заплата.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"В него се поставя акцент върху необходимостта мерките за фискална консолидация и повишаване ефективността на контрола върху социалните плащания да се прилагат така, че да не водят до необосновано ограничаване на достъпа до социална подкрепа на лицата, които отговарят на законовите условия за нейното получаване.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167157\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}]\n47:Tac3,Сдружение на държавните висши училища в Република България, ВОН-КНСБ и СВО-Подкрепа относно Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19 от 01.07.2026 г. внесен от МС; Регионална библиотека ''Хр. Смирненски'' - Хасково по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Регионална библиотека ''Любен Каравелов'' - Русе по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Регионална библиотека ''Проф. Беню Цонев'' - Ловеч по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Регионална библиотека ''Стилиян Чилингиров'' - Шумен по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Българска библиотечно - информационна асоциация по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Регионална библиотека \"Партений Павлович\" - Силистра по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Регионална библиотека \"Априлов - Палаузов'' - Габрово по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; КНСБ - становище по ЗДБРБ за 2026г.; БСК по ЗДБРБ за 2026г.; Министерство на енергетиката по Законопроект за държавния бюджет за 2026 г., № 52-602-01-19.; НСОПЛБ34:[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"$47\",\". \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167157\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Текстовете в parliament.bg\"}]]}]\n36:[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mt-1\",\"children\":[\"15 юли 2026 г.\",\" · \",\"Първо четене\",\" · \",\"Прогресивна България: За · ГЕРБ – СДС: Против · Демократична България: Против · ДПС: За · Продължаваме промяната: Против · Възраждане: Против\"]}]\n37:[\"$\",\"li\",\"2026-07-23-5\",{\"className\":\"border-b border-rule py-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-baseline justify-between gap-2\",\"children\":[[\"$\",\"$La\",null,{\"href\":\"/parlament/glasuvane/2026-07-23-5\",\"className\":\"text-ink no-underline hover:underline\",\"children\":\"второ гласуване - процедура за допускане в залата\"}],[\"$\",\"span\",null,{\"className\":\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\",\"children\":\"Прието\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mt-1\",\"children\":[\"23 юли 2026 г.\",\" · \",\"Второ четене: текст на закона\",\" · \",\"Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Против\"]}]]}]\n38:[\"$\",\"li\",\"2026-07-23-6\",{\"className\":\"border-b border-rule py-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-baseline justify-between gap-2\",\"children\":[[\"$\",\"$La\",null,{\"href\":\"/parlament/glasuvane/2026-07-23-6\",\"className\":\"text-ink no-underline hover:underline\",\"children\":\"второ гласуване - процедура от Даниел Парушев за удължаване на заседанието до приключване на точката (разисквания)\"}],[\"$\",\"span\",null,{\"className\":\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-gree