{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/zakon/layout,_N_T_/parlament/zakon/[slug]/layout,_N_T_/parlament/zakon/[slug]/page,_N_T_/parlament/zakon/darzhavniya-byudzhet-na-republika-balgariya-za-2026-g"},"segmentPaths":["/_tree","/_full","/parlament/zakon/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/832efd850f6c1dd49e00d14864cc2065782fdb2d7a0a057c3138fa12d1cc6a01/$/parlament/zakon/darzhavniya-byudzhet-na-republika-balgariya-za-2026-g","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/zakon/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0vn96-fhbu77m.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><script src=\"/_next/static/chunks/43gzry38n6x69.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Закон за държавния бюджет на Република България за 2026 г. · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Закон за държавния бюджет на Република България за 2026 г. · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Закон за държавния бюджет на Република България за 2026 г. · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Парламент</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Закон</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Закон за държавния бюджет на Република България за 2026 г.</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Приет окончателно на 24.07.2026 г., след седем месеца на удължителен закон</div></div></div><nav aria-label=\"Секции на страницата\" class=\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\"><ul class=\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\"><li><a href=\"#nakratko\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Накратко</a></li><li><a href=\"#signali\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Сигнали (1)</a></li><li><a href=\"#zakonoproekti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Кой внесе и кой се изказа</a></li><li><a href=\"#argumenti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Двете страни</a></li><li><a href=\"#mnenie\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Твоето мнение</a></li><li><a href=\"#grupi\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Как гласуваха</a></li><li><a href=\"#glasuvaniya\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Гласувания (220)</a></li></ul></nav><section id=\"nakratko\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Накратко</h2><div class=\"max-w-4xl\"><p class=\"text-[17px]\">Бюджетът определя колко пари събира и харчи държавата през 2026 г. Планирани са приходи по консолидираната програма около 49,6 млрд. € и разходи около 56,8 млрд. €. Така дефицитът е 7,2 млрд. € или 5,7% от БВП, най-високият от 20 години. Позволен е нов дълг до 10,1 млрд. €, от които до 3,26 млрд. € е заем по европейския инструмент SAFE за отбрана. Максималният осигурителен доход става 2 300 € от 1 август.</p><p class=\"mt-3 text-[15px]\"><b>Какво се случи:</b> <!-- -->На първо четене (15 юли) бюджетът мина със 143 гласа: 126 от „Прогресивна България“ и 17 от ДПС. На второ четене (24 юли, член 1) „за“ гласуваха само 125 депутати от „Прогресивна България“. ДПС гласува „против“ заедно с ГЕРБ–СДС, ДБ, ПП и „Възраждане“ (84 гласа „против“).</p></div></section><section id=\"signali\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Сигнали</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.</p><ul class=\"grid gap-3 md:grid-cols-2 max-w-5xl\"><li class=\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\"><p class=\"font-semibold\">Съкратен срок за предложения (5 дни)</p><p class=\"text-[15px] text-muted mt-1\">Мнозинството гласува по-кратък срок от обичайните 7 дни, в който депутатите могат да внасят промени между първо и второ четене.</p></li></ul><p class=\"text-sm mt-3\"><a href=\"/parlament/signali\">Всички сигнали в парламента</a></p><p class=\"text-xs text-muted mt-2\">Сигналът е повод за въпрос, не доказателство за нарушение.<!-- --> <a class=\"underline\" href=\"/metodologiya#signal\">Как работим със сигналите</a></p></section><section id=\"zakonoproekti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Кой внесе и кой се изказа</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.</p><ul class=\"space-y-4 max-w-5xl\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167157\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за държавния бюджет на Република България за 2026 г.</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-602-01-19</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>1 юли 2026 г.<!-- --> от <!-- -->Министерския съвет</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща); Комисия по правни въпроси (участваща); Комисия по икономическа политика, инвестиции и индустрия (участваща); Комисия по енергетика (участваща); Комисия по регионална политика, благоустройство и местно самоуправление (участваща); Комисия по външна политика (участваща); Комисия по европейските въпроси и контрол на европейските фондове (участваща); Комисия по отбрана (участваща); Комисия по вътрешна сигурност и обществен ред (участваща); Комисия за контрол над службите за сигурност, прилагането и използването на специалните разузнавателни средства и достъпа до данните по Закона за електронните съобщения (участваща); Комисия по земеделието, храните и горите (участваща); Комисия по труда, демографската и социалната политика (участваща); Комисия по образованието и науката (участваща); Комисия по въпросите на младежта и спорта (участваща); Комисия по здравеопазването (участваща); Комисия по околната среда и водите (участваща); Комисия по транспорт и съобщения (участваща); Комисия по иновациите и дигиталната трансформация (участваща); Комисия по културата и медиите (участваща); Комисия за прякото участие на гражданите и взаимодействието с гражданското общество (участваща); Комисия по правата на човека, вероизповеданията и жалбите на гражданите (участваща); Комисия по политиките за българите извън страната (участваща); Комисия по превенция и противодействие на корупцията (участваща); Комисия по туризъм (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>Сдружение на държавните висши училища в Република България, ВОН-КНСБ и СВО-Подкрепа относно Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19 от 01.07.2026 г. внесен от МС; Регионална библиотека &#x27;&#x27;Хр. Смирненски&#x27;&#x27; - Хасково по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Регионална библиотека &#x27;&#x27;Любен Каравелов&#x27;&#x27; - Русе по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Регионална библиотека &#x27;&#x27;Проф. Беню Цонев&#x27;&#x27; - Ловеч по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Регионална библиотека &#x27;&#x27;Стилиян Чилингиров&#x27;&#x27; - Шумен по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Българска библиотечно - информационна асоциация по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Регионална библиотека &quot;Партений Павлович&quot; - Силистра по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Регионална библиотека &quot;Априлов - Палаузов&#x27;&#x27; - Габрово по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; КНСБ - становище по ЗДБРБ за 2026г.; БСК по ЗДБРБ за 2026г.; Министерство на енергетиката по Законопроект за държавния бюджет за 2026 г., № 52-602-01-19.; НСОПЛБ</dd><dt class=\"text-muted\">В комисията</dt><dd><span>отбрана<!-- -->, <!-- -->първо гласуване<!-- -->: <!-- -->10<!-- --> за, <!-- -->0<!-- --> против<!-- -->, 3 въздържал се</span><span>; <!-- -->правата на човека, вероизповеданията и жалбите на гражданите<!-- -->, <!-- -->първо гласуване<!-- -->: <!-- -->6<!-- --> за, <!-- -->4<!-- --> против</span></dd><dt class=\"text-muted\">Предложения</dt><dd>69<!-- --> писмени предложения на депутати между <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">първо</button></span> и <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">второ четене</button></span></dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11151\" target=\"_blank\" rel=\"noreferrer\">15 юли 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span><span>, <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11155\" target=\"_blank\" rel=\"noreferrer\">23 юли 2026 г.</a> (<!-- -->зала второ гласуване<!-- -->)</span></dd><dt class=\"text-muted\">Обнародван</dt><dd>ДВ, бр. 69/2026<!-- -->, приет на 24 юли 2026 г.</dd></dl></li></ul></section><div id=\"argumenti\" class=\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\"><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">„Прогресивна България“ и министърът на финансите Гълъб Донев</p><p class=\"text-[15px]\">Дефицитът е голям, защото бюджетът вади наяве скрити и наследени разходи. Приходите са планирани по-предпазливо, отколкото през 2025 г. Донев го нарече „смел, но не и безразсъден“.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Бюджет 2026, какво трябва да знаем (15.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a><a href=\"https://www.bta.bg/bg/news/bulgaria/1167584\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът прие на първо четене бюджета за 2026 г.\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Теменужка Петкова (ГЕРБ–СДС)</p><p class=\"text-[15px]\">Рекорден дефицит, занижена събираемост на приходите и отпаднали важни текстове.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Бюджет 2026, какво трябва да знаем (15.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Фискалният съвет</p><p class=\"text-[15px]\">Бюджетът трябва да се преработи. Без мерки дългът расте до около 51 млрд. € в края на 2028 г.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Асен Василев (ПП)</p><p class=\"text-[15px]\">Отпада публичният поименен списък с общинските проекти.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-3\">Какво казват данните</h3><ul class=\"space-y-2 list-none pl-0\"><li class=\"border-l-4 border-deep pl-4 text-[15px]\">Планиран дефицит: около 7,2 млрд. €, или 5,7% от БВП, най-високият от 20 години.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Бюджет 2026, какво трябва да знаем (15.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">За сравнение, през 2025 г. дефицитът е 4,0% от БВП по последните данни на Евростат (предварителните на НСИ бяха 3,5%).<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.nsi.bg/file/35225/notifikacionni_tablici_za_dalga_i_deficita_na_sektor_darjavno_upravlenie.pdf\" target=\"_blank\" rel=\"noreferrer\" title=\"НСИ: дефицит и дълг на сектор „Държавно управление“ за 2025 г. (предварителни данни)\" class=\"ml-0.5 no-underline\">[<!-- -->5<!-- -->]</a><a href=\"https://ec.europa.eu/eurostat/databrowser/view/gov_10dd_edpt1/default/table\" target=\"_blank\" rel=\"noreferrer\" title=\"Евростат: дефицит и дълг (gov_10dd_edpt1)\" class=\"ml-0.5 no-underline\">[<!-- -->7<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">Таван на новия дълг: 10,1 млрд. €, от които до 3,261 млрд. € са заем по европейския инструмент SAFE за отбрана.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/news/bulgaria/1167584\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът прие на първо четене бюджета за 2026 г.\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">До 28 юли 2026 г. реално поетият нов дълг е 4,01 млрд. €.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://bnrnews.bg/en/post/508409/bulgaria-with-new-domestic-debt-of-100-million-euros\" target=\"_blank\" rel=\"noreferrer\" title=\"БНР: нов вътрешен дълг от 100 млн. € (28.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->6<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">Бюджет 2025 планира 28,2 млрд. € приходи по централния бюджет, а събра 26,3 млрд. € (6,7% по-малко).<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></li></ul></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Двете страни на монетата</h3><p class=\"text-sm text-muted mb-3\">Какво следва на практика, ако законът се приеме и ако се отхвърли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Бюджет 2026, какво трябва да знаем (15.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a><a href=\"https://www.bta.bg/bg/news/bulgaria/1167584\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът прие на първо четене бюджета за 2026 г.\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></p><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\"><p class=\"font-semibold\">Ако се приеме</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Край на удължителния закон: заплатите, пенсиите и инвестициите се плащат по нов годишен план.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Дефицит от 5,7% от БВП и нов дълг до 10,1 млрд. €.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">По-големи разходи за лихви в следващите години.</li></ul></div></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\"><p class=\"font-semibold\">Ако се отхвърли</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Шанс за преработен бюджет с по-малък дефицит, както препоръчва Фискалният съвет.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Държавата продължава да работи по удължителния закон, без нови политики и с ограничени инвестиции.</li></ul></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Какво печели и какво губи всяка страна</h3><p class=\"text-sm text-muted mb-3\">Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.</p><div class=\"space-y-3\"><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Работещите с високи заплати<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Бюджет 2026, какво трябва да знаем (15.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a><a href=\"https://www.bta.bg/bg/news/bulgaria/1167584\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът прие на първо четене бюджета за 2026 г.\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">По-високи вноски означават по-голяма бъдеща пенсия.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Максималният осигурителен доход става 2 300 € от 1 август, затова плащат повече осигуровки.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Държавните служители и заетите в съдебната власт<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/news/bulgaria/1167584\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът прие на първо четене бюджета за 2026 г.\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">От 1 август започват поетапно да плащат сами личните си осигуровки. Ако заплатата не се компенсира, нетното им възнаграждение намалява.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Получателите на държавни плащания (заплати, пенсии, инвестиции)<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Бюджет 2026, какво трябва да знаем (15.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Плащанията са осигурени, въпреки че приходите не стигат.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">—</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Данъкоплатците и бъдещите поколения<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.bta.bg/bg/news/bulgaria/1167584\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът прие на първо четене бюджета за 2026 г.\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">По-голям дълг означава повече разходи за лихви в следващите години.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Общините и гражданите, които следят как се харчат парите<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Списъкът с общинските проекти вече не е публичен.</p></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-3\">Проверени твърдения</h3><ul class=\"space-y-3\"><li class=\"rounded-xl ring-1 ring-rule p-4 bg-white\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><p class=\"font-semibold\">„Събираемостта е силно занижена“ (Т. Петкова)</p><span class=\"text-sm font-semibold px-2.5 py-0.5 rounded-full bg-[#e2b33b] text-ink\">Подвеждащо</span></div><p class=\"text-[15px] text-muted mt-1\">Бюджет 2025, приет при нейното министерство, планира приходи по централния бюджет 28,2 млрд. €, а събра 26,3 млрд. € (−6,7%). Новият бюджет залага по-умерен ръст на приходите. Рискът е обратен: до май 2026 г. приходите растат само с 2%.</p></li><li class=\"rounded-xl ring-1 ring-rule p-4 bg-white\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><p class=\"font-semibold\">Текстовете за Националната детска болница са били във всеки бюджет от 2022 г. (А. Василев)</p><span class=\"text-sm font-semibold px-2.5 py-0.5 rounded-full bg-[#d2353f] text-white\">Невярно</span></div><p class=\"text-[15px] text-muted mt-1\">Текст има само в бюджетите за 2024 и 2025 г., и в двата без конкретна сума.</p></li><li class=\"rounded-xl ring-1 ring-rule p-4 bg-white\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><p class=\"font-semibold\">Отпада поименният списък с общинските проекти (А. Василев)</p><span class=\"text-sm font-semibold px-2.5 py-0.5 rounded-full bg-[#2f9e6a] text-white\">Вярно</span></div><p class=\"text-[15px] text-muted mt-1\">Приложение № 3 със списъка на проектите липсва. Правомощието на министъра не е ново, ново е, че списъкът вече не е публичен.</p></li></ul></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания 15.07.2026 и 24.07.2026, Народно събрание (чрез „Наясно“)</a></li><li><a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\">„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)</a></li><li><a href=\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\" target=\"_blank\" rel=\"noreferrer\">Капитал: Бюджет 2026, какво трябва да знаем (15.07.2026)</a></li><li><a href=\"https://www.bta.bg/bg/news/bulgaria/1167584\" target=\"_blank\" rel=\"noreferrer\">БТА: Парламентът прие на първо четене бюджета за 2026 г.</a></li><li><a href=\"https://www.nsi.bg/file/35225/notifikacionni_tablici_za_dalga_i_deficita_na_sektor_darjavno_upravlenie.pdf\" target=\"_blank\" rel=\"noreferrer\">НСИ: дефицит и дълг на сектор „Държавно управление“ за 2025 г. (предварителни данни)</a></li><li><a href=\"https://bnrnews.bg/en/post/508409/bulgaria-with-new-domestic-debt-of-100-million-euros\" target=\"_blank\" rel=\"noreferrer\">БНР: нов вътрешен дълг от 100 млн. € (28.07.2026)</a></li><li><a href=\"https://ec.europa.eu/eurostat/databrowser/view/gov_10dd_edpt1/default/table\" target=\"_blank\" rel=\"noreferrer\">Евростат: дефицит и дълг (gov_10dd_edpt1)</a></li></ol><p class=\"text-xs text-muted mt-2\">Проверките на твърденията и анализът на изпълнението са по данните и анализа на „Наясно“ (MIT), сверени с поименните гласувания. Таблицата „Какво печели и какво губи всяка страна“ и последиците „ако се приеме / ако се отхвърли“ са наш анализ на текста и аргументите от източниците, не позиция на партия.<!-- --> Проверено: <!-- -->17 ноември 2026 г.</p></div></div><section id=\"dokumenti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Още от документите</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.</p><div class=\"space-y-4 max-w-4xl\"><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167157\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за държавния бюджет на Република България за 2026 г.</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-602-01-19</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->С осигуряването на планираните разходи за отбрана за 2026 г. ще е възможно реализацията на поетият ангажимент от правителството за недопускане на срив в системата на отбраната, задълбочаване на съществуващите проблеми и загуба на отбранителни способности, както по отношение на окомплектоваността на структурите с личен състав, така и по отношение на преодоляване на дефицита от ключови способности на въоръжените сили и изпълнението на проекти за модернизация на Българската армия.<!-- -->“</li><li>„<!-- -->Пролетната макроикономическа прогноза за периода, изготвена от Министерството на финансите (МФ), предвижда растежът на икономиката да достигне 2,6% през 2026 г.<!-- -->“</li><li>„<!-- -->Беше отбелязано още, че чрез капиталовите разходи се осигуряват средства за изграждане, реконструкция, модернизация и основен ремонт на спортни обекти и съоръжения, с цел подобряване на условията за подготовка на спортистите и за разширяване на възможностите за развитие на масовия спорт.<!-- -->“</li><li>„<!-- -->В нея се предвижда растежът на икономиката да бъде 2.6% през 2026 г.<!-- -->“</li><li>„<!-- -->През следващите години увеличаването на заетостта ще се случи с привличане на част от неактивните лица обратно в работната сила или чрез привличането на работна сила от други държави.<!-- -->“</li><li>„<!-- -->Бяха очертани мерки за увеличаване на приходите чрез намаляване на сивата икономика в т.ч. в сектора на хазарта.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167157\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Представителите на Министерството на младежта и спорта дадоха подробни разяснения по поставените въпроси и заявиха, че предложеният бюджет е съобразен с възможностите на държавния бюджет за 2026 г.<!-- -->“</li><li>„<!-- -->Народните представители, взели отношение, подчертаха, че без да е проведено широко обществено обсъждане, тези промени ограничават правата на работниците и служителите, наети на непълно работно време при определяне на трудовия стаж, размера на отпуска и др. права.<!-- -->“</li><li>„<!-- -->В своето становище БСК подкрепя под условие законопроекта като настоява в хода на бюджетната процедура да се отложи увеличението на максималния осигурителен доход за 2027г., ръстът на минималните осигурителни доходи да се ограничи до ръста на минималната работна заплата за 2026г., годишната квота за ваучерите за храна да се увеличи с поне 6%.<!-- -->“</li><li>„<!-- -->Подкрепят промяната в модела за осигуряване на държавните служители.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167157\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->БТПП възразява срещу повишаването на минималните осигурителни прагове, не подкрепя повишаването на максималния осигурителен доход, подкрепя запазването на размера на обезщетенията за безработица и очаква мерки за балансирана бюджетна политика.<!-- -->“</li><li>„<!-- -->В становището на КРИБ се изразява принципна подкрепа на законопроекта, но с определени резерви и предложения за премахване на автоматичната индексация на заплати; ограничаване ръста на плащанията за персонал в публичния сектор и разходите за социални плащания особено при необходимостта от драстична реформа на ТЕЛК; предлага се диференцирана, а не за всички, индексация на заплатите в бюджетния сектор според техния размер; настояват за обективен механизъм за определяне на минималната работна заплата и др.<!-- -->“</li><li>„<!-- -->От ПГ „Продължаваме Промяната“, ПГ „Демократична България“, ПГ ГЕРБ-СДС и ПГ „ВЪЗРАЖДАНЕ“ посочиха, че не подкрепят законопроекта поради рекордния дефицит, липсата на реформи, липсата на целенасочени мерки за подкрепа на семействата, децата, младите хора и хората с увреждания, на мерки за насърчаване завръщането на майките в отпуск по майчинство отново на работа, на мерки за повишаване качеството на работната сила и за осигуряване на адекватна минимална работна заплата.<!-- -->“</li><li>„<!-- -->В него се поставя акцент върху необходимостта мерките за фискална консолидация и повишаване ефективността на контрола върху социалните плащания да се прилагат така, че да не водят до необосновано ограничаване на достъпа до социална подкрепа на лицата, които отговарят на законовите условия за нейното получаване.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167157\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->Сдружение на държавните висши училища в Република България, ВОН-КНСБ и СВО-Подкрепа относно Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19 от 01.07.2026 г. внесен от МС; Регионална библиотека &#x27;&#x27;Хр. Смирненски&#x27;&#x27; - Хасково по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Регионална библиотека &#x27;&#x27;Любен Каравелов&#x27;&#x27; - Русе по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Регионална библиотека &#x27;&#x27;Проф. Беню Цонев&#x27;&#x27; - Ловеч по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Регионална библиотека &#x27;&#x27;Стилиян Чилингиров&#x27;&#x27; - Шумен по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Българска библиотечно - информационна асоциация по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Регионална библиотека &quot;Партений Павлович&quot; - Силистра по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; Регионална библиотека &quot;Априлов - Палаузов&#x27;&#x27; - Габрово по Законопроект за държавния бюджет на Република България за 2026 г., № 52-602-01-19, внесен от Министерски съвет на 01.07.2026 г.; КНСБ - становище по ЗДБРБ за 2026г.; БСК по ЗДБРБ за 2026г.; Министерство на енергетиката по Законопроект за държавния бюджет за 2026 г., № 52-602-01-19.; НСОПЛБ<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167157\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div></div></section><section id=\"mnenie\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Твоето мнение</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. <a href=\"/mnenie\">Всички закони за гласуване</a>.</p><div class=\"bg-surface rounded-sm p-5 text-[15px] text-muted\">Зарежда се…</div></section><section id=\"grupi\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласуваха групите по този закон</h2></div><p class=\"text-sm text-muted mb-3\">Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо <!-- -->220<!-- -->. Прието: <!-- -->81<!-- -->, отхвърлено: <!-- -->139<!-- -->.</p><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Прогресивна България</p><p class=\"num text-sm mt-1\">За: <b>81</b> · Против: <b>15</b> · общо <!-- -->220</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ГЕРБ – СДС</p><p class=\"num text-sm mt-1\">За: <b>78</b> · Против: <b>106</b> · общо <!-- -->220</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Демократична България</p><p class=\"num text-sm mt-1\">За: <b>58</b> · Против: <b>65</b> · общо <!-- -->217</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ДПС</p><p class=\"num text-sm mt-1\">За: <b>80</b> · Против: <b>92</b> · общо <!-- -->216</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Продължаваме промяната</p><p class=\"num text-sm mt-1\">За: <b>104</b> · Против: <b>98</b> · общо <!-- -->220</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Възраждане</p><p class=\"num text-sm mt-1\">За: <b>109</b> · Против: <b>86</b> · общо <!-- -->220</p></div></div><p class=\"text-sm mt-3\">Първо четене: <a href=\"/parlament/glasuvane/2026-07-15-11\">15 юли 2026 г.</a><a href=\"/parlament/glasuvane/2026-07-15-13\">15 юли 2026 г.</a></p></section><section id=\"glasuvaniya\" class=\"scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Всички гласувания по закона</h2></div><ul><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-07-15-9\">първо гласуване - процедура за допускане в зала</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">15 юли 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-07-15-10\">първо гласуване - процедура от Петър Витанов за удължаване на заседанието до приемане на точка 2 от програмата</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">15 юли 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: Против · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-07-15-11\">първо гласуване - с включен проект на ВСС</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-muted border border-rule\">Отхвърлено</span></div><p class=\"text-sm text-muted mt-1\">15 юли 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: Против · ГЕРБ – СДС: Против · Демократична България: Против · ДПС: Въздържал се · Продължаваме промяната: Против · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-07-15-13\">първо гласуване - със становище на Министерски съвет</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">15 юли 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: Против · Демократична България: Против · ДПС: За · Продължаваме промяната: Против · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-07-15-14\">първо гласуване - процедура от Константин Проданов за намаляване на срока за предложения на 5 дни</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">15 юли 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: Против · Демократична България: Против · ДПС: За · Продължаваме промяната: Против · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-07-23-5\">второ гласуване - процедура за допускане в залата</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">23 юли 2026 г.<!-- --> · <!-- -->Второ четене: текст на закона<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-07-23-6\">второ гласуване - процедура от Даниел Парушев за удължаване на заседанието до приключване на точката (разисквания)</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">23 юли 2026 г.<!-- --> · <!-- -->Второ четене: текст на закона<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-07-24-4\">второ гласуване - наименование</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">24 юли 2026 г.<!-- --> · <!-- -->Второ четене: наименование<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: Против · Демократична България: Против · ДПС: За · Продължаваме промяната: Против · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-07-24-5\">второ гласуване - член 1 - предложение от Венко Сабрутев и група н.п</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-muted border border-rule\">Отхвърлено</span></div><p class=\"text-sm text-muted mt-1\">24 юли 2026 г.<!-- --> · <