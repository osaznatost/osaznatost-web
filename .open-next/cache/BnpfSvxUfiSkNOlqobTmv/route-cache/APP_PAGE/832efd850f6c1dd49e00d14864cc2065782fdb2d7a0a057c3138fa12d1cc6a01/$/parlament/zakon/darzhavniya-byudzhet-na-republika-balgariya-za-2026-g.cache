ren\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-green pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Какво предлага законопроектът\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"С осигуряването на планираните разходи за отбрана за 2026 г. ще е възможно реализацията на поетият ангажимент от правителството за недопускане на срив в системата на отбраната, задълбочаване на съществуващите проблеми и загуба на отбранителни способности, както по отношение на окомплектоваността на структурите с личен състав, така и по отношение на преодоляване на дефицита от ключови способности на въоръжените сили и изпълнението на проекти за модернизация на Българската армия.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"Пролетната макроикономическа прогноза за периода, изготвена от Министерството на финансите (МФ), предвижда растежът на икономиката да достигне 2,6% през 2026 г.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[\\\"„\\\",\\\"Беше отбелязано още, че чрез капиталовите разходи се осигуряват средства за изграждане, реконструкция, модернизация и основен ремонт на спортни обекти и съоръжения, с цел подобряване на условията за подготовка на спортистите и за разширяване на възможностите за развитие на масовия спорт.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[\\\"„\\\",\\\"В нея се предвижда растежът на икономиката да бъде 2.6% през 2026 г.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"children\\\":[\\\"„\\\",\\\"През следващите години увеличаването на заетостта ще се случи с привличане на част от неактивните лица обратно в работната сила или чрез привличането на работна сила от други държави.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"5\\\",{\\\"children\\\":[\\\"„\\\",\\\"Бяха очертани мерки за увеличаване на приходите чрез намаляване на сивата икономика в т.ч. в сектора на хазарта.\\\",\\\"“\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted mt-1\\\",\\\"children\\\":[\\\"Източник: \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167157\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":\\\"доклад на комисията и мотиви, parliament.bg\\\"}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-[#8a8f8c] pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Позиции, изказани в комисията\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"Представителите на Министерството на младежта и спорта дадоха подробни разяснения по поставените въпроси и заявиха, че предложеният бюджет е съобразен с възможностите на държавния бюджет за 2026 г.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"Народните представители, взели отношение, подчертаха, че без да е проведено широко обществено обсъждане, тези промени ограничават правата на работниците и служителите, наети на непълно работно време при определяне на трудовия стаж, размера на отпуска и др. права.\\\",\\\"“\\\"]}],\\\"$L30\\\",\\\"$L31\\\"]}],\\\"$L32\\\"]}],\\\"$L33\\\",false,\\\"$L34\\\"]}]]}]]}]]}]]}]\\n21:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"mnenie\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Твоето мнение\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":[\\\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Ано