l-0 space-y-1\",\"children\":[[\"$\",\"li\",\"Шанс за преработен бюджет с по-малък дефицит, както препоръчва Фискалният съвет.\",{\"className\":\"text-[15px] pl-4 relative before:content-['+'] before:absolute before:left-0 before:font-bold\",\"children\":\"Шанс за преработен бюджет с по-малък дефицит, както препоръчва Фискалният съвет.\"}]]}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-red\",\"children\":\"Рискът и цената\"}],[\"$\",\"ul\",null,{\"className\":\"list-none pl-0 space-y-1\",\"children\":[[\"$\",\"li\",\"Държавата продължава да работи по удължителния закон, без нови политики и с ограничени инвестиции.\",{\"className\":\"text-[15px] pl-4 relative before:content-['−'] before:absolute before:left-0 before:font-bold\",\"children\":\"Държавата продължава да работи по удължителния закон, без нови политики и с ограничени инвестиции.\"}]]}]]}]]}]]}]]}]]}]\n2d:[\"$\",\"div\",null,{\"className\":\"mt-8\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.8rem] mb-1\",\"children\":\"Какво печели и какво губи всяка страна\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mb-3\",\"children\":\"Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"div\",\"Работещите с високи заплати\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold px-4 pt-3\",\"children\":[\"Работещите с високи заплати\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"3\",{\"href\":\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Капитал: Бюджет 2026, какво трябва да знаем (15.07.2026)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",3,\"]\"]}],[\"$\",\"a\",\"4\",{\"href\