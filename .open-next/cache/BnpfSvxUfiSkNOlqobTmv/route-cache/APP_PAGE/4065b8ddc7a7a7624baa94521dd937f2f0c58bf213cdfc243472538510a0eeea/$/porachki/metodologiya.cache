-sm text-muted\",\"children\":[[\"$\",\"th\",null,{\"className\":\"py-2 pr-3\",\"children\":\"Сигнал\"}],[\"$\",\"th\",null,{\"className\":\"px-2\",\"children\":\"Точки\"}],[\"$\",\"th\",null,{\"className\":\"px-2\",\"children\":\"Кога се включва\"}],[\"$\",\"th\",null,{\"className\":\"px-2\",\"children\":\"Защо е важен\"}],[\"$\",\"th\",null,{\"className\":\"px-2\",\"children\":\"Кога греши\"}],[\"$\",\"th\",null,{\"className\":\"px-2 text-right\",\"children\":\"Договори\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"single\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3 font-semibold\",\"children\":\"Само една оферта\"}],[\"$\",\"td\",null,{\"className\":\"px-2 num\",\"children\":\"25\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"В договора е отбелязана точно една получена оферта.\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Без конкуренция няма с какво да се сравни цената. Европейската комисия го смята за основния показател за риск в поръчките.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-muted\",\"children\":\"Понякога пазарът наистина е малък (специална техника, далечно село). Важно е колко често се случва при един възложител.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-right num\",\"children\":\"81 127\"}]]}],[\"$\",\"tr\",\"direct\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3 font-semibold\",\"children\":\"Без открит конкурс\"}],[\"$\",\"td\",null,{\"className\":\"px-2 num\",\"children\":\"20\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Процедурата е договаряне без обявление или пряко договаряне.\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Възложителят сам избира кого да покани. Законът го позволява само в изрични случаи.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-muted\",\"children\":\"Често е законно: авария, единствен доставчик, неуспешна предишна процедура.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-right num\",\"children\":\"26 698\"}]]}],[\"$\",\"tr\",\"over\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3 font-semibold\",\"children\":\"Над прогнозната стойност\"}],[\"$\",\"td\",null,{\"className\":\"px-2 num\",\"children\":\"10\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Договорът е с повече от 5% над прогнозната стойност в обявлението.\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Цената е по-висока от това, което самият възложител е очаквал.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-muted\",\"children\":\"Прогнозата може да е стара или занижена.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-right num\",\"children\":\"9968\"}]]}],[\"$\",\"tr\",\"exact\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3 font-semibold\",\"children\":\"Цена почти равна на прогнозата\"}],[\"$\",\"td\",null,{\"className\":\"px-2 num\",\"children\":\"10\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Една оферта и цена между 97% и 100% от прогнозата, при процедура с обявление (при договаряне без обявление прогнозата често се определя след преговорите и флагът не се смята).\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Единственият участник предлага почти точно бюджета. Може да означава изтекла информация за прогнозата.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-muted\",\"children\":\"Прогнозата е публична в обявлението, така че съвпадението може да е случайно.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-right num\",\"children\":\"35 860\"}]]}],[\"$\",\"tr\",\"annex\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3 font-semibold\",\"children\":\"Оскъпяване с анекси\"}],[\"$\",\"td\",null,{\"className\":\"px-2 num\",\"children\":\"12 или 20\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Анексите добавят над 10% към цената (20 точки при над 30%).\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Ниска цена за спечелване, после увеличение без конкуренция.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-muted\",\"children\":\"Има обективни причини: допълнителни количества, поскъпване на материали (2022 г.).\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-right num\",\"children\":\"3034\"}]]}],\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\",\"$L31\",\"$L32\",\"$L33\"]}]]}]}]\n16:[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb-5\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] sm:text-[2.4rem]\",\"children\":\"Сигнали за възложителя (без точки)\"}],\"$undefined\"]}]\n17:[\"$\",\"p\",null,{\"className\":\"max-w-3xl text-[15px] mb-3\",\"children\":\"На страницата на всеки възложител показваме и сигнали за цялата му практика. Те не влизат в индекса на отделния договор.\"}]\n18:[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 max-w-3xl text-[15px] space-y-1 mb-10\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"Повтарящи се поръчки:\"}],\" поръчки със сходен предмет (сходство на думите поне 0,55) в рамките на 24 месеца, от поне две различни процедури и поне 90 дни една от друга (обособените позиции на една процедура и годишните услуги „за 2022 г.“, „за 2023 г.“ не се броят).\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"Възможно разделяне:\"}],\" няколко договора с една фирма за 90 дни, всеки под прага на закона, но заедно над него.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"Редуващи се изпълнители:\"}],\" в една категория двама изпълнители имат поне по 3 договора, заедно поне 60% от договорите, а победителят се сменя при поне 60% от поредните им договори.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"Общ собственик или управител\"}],\" и \",[\"$\",\"b\",null,{\"children\":\"общ адрес на управление\"}],\" (без етаж и офис) между различни изпълнители, по Търговския регистър. Обхватът расте заедно с прочетените фирми.\"]}],[\"$\",\"li\",null,{\"children\":\"Участниците, които са загубили, не са в отворените данни, затова сравняваме само победителите.\"}]]}]\n19:[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb-5\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] sm:text-[2.4rem]\",\"children\":\"Законови обяснения\"}],\"$undefined\"]}]\n1a:[\"$\",\"p\",null,{\"className\":\"max-w-3xl text-[15px] mb-3\",\"children\":\"Понякога една оферта или договаряне без конкурс идват от закона или от монопол, а не от избор на възложителя. Тогава „Само една оферта“ и „Без открит конкурс“ остават видими, но носят по 5 точки вместо 25 и 20. Другите сигнали (политик, анекси, нова фирма и т.н.) се смятат както винаги. Разпознаваме случаите по предмета на договора:\"}]\n1b:[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 max-w-3xl text-[15px] space-y-1 mb-3\",\"children\":[[\"$\",\"li\",\"exchange\",{\"children\":\"Покупка чрез стокова борса: цената се определя на борсата, затова офертата е една.\"}],[\"$\",\"li\",\"post\",{\"children\":\"Универсалната пощенска услуга по закон се предоставя само от „Български пощи“.\"}],[\"$\",\"li\",\"heat\",{\"children\":\"Топлофикацията е единственият доставчик на топлинна енергия в населеното място (естествен монопол).\"}],[\"$\",\"li\",\"network\",{\"children\":\"Мрежовата услуга (пренос, разпределение, ВиК) се предоставя от лицензиран монополист за района.\"}],[\"$\",\"li\",\"elections\",{\"children\":\"Изборният кодекс определя кой обработва изборните резултати („Информационно обслужване“).\"}],[\"$\",\"li\",\"integrator\",{\"children\":\"Законът за електронното управление (чл. 7с) определя системния интегратор на държавата.\"}],[\"$\",\"li\",\"transport\",{\"children\":\"Превозните документи за градския транспорт се издават само от общинския оператор.\"}],[\"$\",\"li\",\"stamps\",{\"children\":\"Акцизните бандероли по закон се отпечатват от Печатницата на БНБ.\"}]]}]\n1c:[\"$\",\"p\",null,{\"className\":\"max-w-3xl text-[15px] text-muted mb-10\",\"children\":[\"Вътрешните възлагания (in-house) не са в списъка: те са законни, но често спорни, затова се оценяват като всички останали. Засегнати договори: \",\"2056\",\".\"]}]\n1d:[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb-5\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] sm:text-[2.4rem]\",\"children\":\"Какво не виждаме\"}],\"$undefined\"]}]\n1e:[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 max-w-3xl text-[15px] space-y-1 mb-10\",\"children\":[[\"$\",\"li\",null,{\"children\":\"Договорите от 2020–2021 г. почти липсват в отворените данни на ЦАИС ЕОП. По-старите добавяме от европейската база TED, само над европейските прагове.\"}],[\"$\",\"li\",null,{\"children\":\"Колко е платено и кой е приел работата: това не се публикува. В страницата на всеки договор има готово заявление по ЗДОИ.\"}],[\"$\",\"li\",null,{\"children\":\"Кои фирми са участвали и с какви цени: протоколите на комисиите са в PDF, не в отворени данни.\"}],[\"$\",\"li\",null,{\"children\":\"Роднини и собственост чрез посредници. Свързваме само това, което е в Търговския регистър и декларациите.\"}],[\"$\",\"li\",null,{\"children\":\"Грешки в самите обявления (грешна сума, валута, брой оферти) се пренасят и при нас. Ако видите такава, пишете ни.\"}]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb-5\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] sm:text-[2.4rem]\",\"children\":\"Как да проверите сами\"}],\"$undefined\"]}]\n20:[\"$\",\"p\",null,{\"className\":\"max-w-3xl text-[15px] mb-10\",\"children\":[\"Всеки договор води до обявлението в ЦАИС ЕОП. Правилата са точно тези в таблицата горе, а данните се обновяват всеки ден. \",[\"$\",\"$L9\",null,{\"href\":\"/tarsene\",\"children\":\"Търсене\"}],\" · \",[\"$\",\"$L9\",null,{\"href\":\"/porachki/risk\",\"children\":\"Национална класация\"}],\".\"]}]\n21:[\"$\",\"$L34\",null,{\"children\":[\"$\",\"$6\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@35\"}]}]\n27:[\"$\",\"$L36\",\"20\",{}]\n28:[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]\nc:300\n2c:[\"$\",\"tr\",\"disq\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3 font-semibold\",\"children\":\"Отстранени конкуренти\"}],[\"$\",\"td\",null,{\"className\":\"px-2 num\",\"children\":\"15\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Отстранени са оферти и остава един участник.\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Конкурсът може да е бил формален, с изисквания, които само един изпълнява.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-muted\",\"children\":\"Отстраняването може да е напълно основателно (непълни документи).\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-right num\",\"children\":\"3691\"}]]}]\n2d:[\"$\",\"tr\",\"threshold\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3 font-semibold\",\"children\":\"Точно под прага\"}],[\"$\",\"td\",null,{\"className\":\"px-2 num\",\"children\":\"10\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Стойност между 90% и 100% от прага за по-строга процедура (138 049 € за строителство, 35 790 € за доставки и услуги).\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Възможно е поръчката да е нагласена, за да се избегне по-строгата процедура.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-muted\",\"children\":\"Много поръчки естествено са в този размер.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-right num\",\"children\":\"5956\"}]]}]\n2e:[\"$\",\"tr\",\"political\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3 font-semibold\",\"children\":\"Връзка с политик\"}],[\"$\",\"td\",null,{\"className\":\"px-2 num\",\"children\":\"20\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Депутат е собственик или управител на частната фирма изпълнител, или длъжностно лице е посочило фирмата в собствената си декларация (по Търговския регистър и декларациите, обработени от „Наясно“, и по нашето свързване на декларациите за интереси от регистъра на КПК).\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Възможен конфликт на интереси.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-muted\",\"children\":\"Държавните и общинските дружества не се броят: там управителят и „действителният собственик“ по закон са назначени лица. Не виждаме роднини извън декларираните и собственост чрез посредници.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-right num\",\"children\":\"3379\"}]]}]\n2f:[\"$\",\"tr\",\"political_name\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3 font-semibold\",\"children\":\"Възможна връзка с длъжностно лице\"}],[\"$\",\"td\",null,{\"className\":\"px-2 num\",\"children\":\"8\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Собственик на фирмата по Търговския регистър е човек със същите три имена като длъжностно лице (кмет, съветник, директор и др.).\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Може да е конфликт на интереси.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-muted\",\"children\":\"Съвпадението е само по имена, без ЕГН. Може да е съименник, затова теглото е ниско.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-right num\",\"children\":\"1199\"}]]}]\n30:[\"$\",\"tr\",\"short\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3 font-semibold\",\"children\":\"Кратък срок за оферти\"}],[\"$\",\"td\",null,{\"className\":\"px-2 num\",\"children\":\"8–10\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"От обявяването до крайния срок за оферти са минали под 20 дни при процедура по европейските правила или под 10 дни при публично състезание (по обявленията в ЦАИС ЕОП).\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Краткият срок оставя време да се подготви само фирма, която е знаела предварително.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-muted\",\"children\":\"Законът позволява по-кратък срок при спешност или предварително обявление. Срокът се смята от датата на публикуване до най-ранния краен срок сред обособените позиции.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-right num\",\"children\":\"430\"}]]}]\n31:[\"$\",\"tr\",\"changes\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3 font-semibold\",\"children\":\"Чести промени в условията\"}],[\"$\",\"td\",null,{\"className\":\"px-2 num\",\"children\":\"5\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Условията на процедурата са променяни поне два пъти (обявления за промяна в ЦАИС ЕОП).\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Многократните промени могат да пренапишат изискванията в полза на определен участник.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-muted\",\"children\":\"Често промените са законни отговори на въпроси или поправки на грешки.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-right num\",\"children\":\"94\"}]]}]\n32:[\"$\",\"tr\",\"new\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3 font-semibold\",\"children\":\"Нова фирма\"}],[\"$\",\"td\",null,{\"className\":\"px-2 num\",\"children\":\"15\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Изпълнителят е създаден по-малко от година преди договора (по Търговския регистър).\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Фирма без история и опит, понякога създадена специално за поръчката.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-muted\",\"children\":\"Нови фирми има и законно, например след преобразуване. Датата за фирми отпреди 2008 г. е по номера на фирменото дело.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-right num\",\"children\":\"955\"}]]}]\n33:[\"$\",\"tr\",\"sub\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3 font-semibold\",\"children\":\"Голям дял на подизпълнители\"}],[\"$\",\"td\",null,{\"className\":\"px-2 num\",\"children\":\"8\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Подизпълнителите поемат 50% или повече.\"}],[\"$\",\"td\",null,{\"className\":\"px-2\",\"children\":\"Печелившата фирма може да е само посредник.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-muted\",\"children\":\"При сложни обекти е нормално част от работата да се възлага.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-right num\",\"children\":\"173\"}]]}]\n35:null\n2b:true\nc:C\n2a:0\n11:\"$undefined\"\ne:\"$undefined\"\nb:\"$undefined\"\n29:\"$undefined\"\n22:\"$undefined\"\n"}}