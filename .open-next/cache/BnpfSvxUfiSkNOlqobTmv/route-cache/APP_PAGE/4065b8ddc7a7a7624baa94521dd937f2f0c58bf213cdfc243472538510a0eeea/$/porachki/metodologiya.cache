{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/porachki/layout,_N_T_/porachki/metodologiya/layout,_N_T_/porachki/metodologiya/page,_N_T_/porachki/metodologiya"},"segmentPaths":["/_tree","/_full","/porachki/metodologiya/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/4065b8ddc7a7a7624baa94521dd937f2f0c58bf213cdfc243472538510a0eeea/$/porachki/metodologiya","owner":{"kind":"APP_PAGE","sourceRoute":"/porachki/metodologiya/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0vn96-fhbu77m.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><title>Как оценяваме риска в поръчките · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Как оценяваме риска в поръчките · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Как оценяваме риска в поръчките · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/porachki/risk\">← <!-- -->Риск в поръчките</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Методология</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Как оценяваме риска</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Как смятаме риска в обществените поръчки, какво значи всеки сигнал и кога той греши. Сигналът е повод за въпрос, не доказателство за нарушение.</div></div></div><section class=\"max-w-3xl text-[16px] space-y-3 mb-10\"><p>Всеки договор от ЦАИС ЕОП получава точки за всеки сигнал, който се среща в него. Индексът е сумата от точките, най-много 100: <b>висок</b> от 45 нагоре, <b>среден</b> от 20 до 44, <b>нисък</b> под 20.</p><p>Сигналите следват показателите на Европейската служба за борба с измамите (OLAF), инструмента на Европейската комисия за единния пазар и изследванията на Government Transparency Institute. Теглата са наши: колкото по-пряко сочи сигналът към липса на конкуренция, толкова по-голямо е теглото.</p><p>Изчисляваме всичко само от публични данни, всеки ден, с едни и същи правила за всички възложители и фирми. Към <!-- -->23.11.2026<!-- --> в базата са <!-- -->244 271<!-- --> договора, от които <!-- -->19 671<!-- --> с висок риск.</p></section><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Сигналите</h2></div><div class=\"overflow-x-auto mb-10\"><table class=\"w-full text-[15px] align-top\"><thead><tr class=\"text-left border-b border-rule text-sm text-muted\"><th class=\"py-2 pr-3\">Сигнал</th><th class=\"px-2\">Точки</th><th class=\"px-2\">Кога се включва</th><th class=\"px-2\">Защо е важен</th><th class=\"px-2\">Кога греши</th><th class=\"px-2 text-right\">Договори</th></tr></thead><tbody><tr class=\"border-b border-rule align-top\"><td class=\"py-2 pr-3 font-semibold\">Само една оферта</td><td class=\"px-2 num\">25</td><td class=\"px-2\">В договора е отбелязана точно една получена оферта.</td><td class=\"px-2\">Без конкуренция няма с какво да се сравни цената. Европейската комисия го смята за основния показател за риск в поръчките.</td><td class=\"px-2 text-muted\">Понякога пазарът наистина е малък (специална техника, далечно село). Важно е колко често се случва при един възложител.</td><td class=\"px-2 text-right num\">81 127</td></tr><tr class=\"border-b border-rule align-top\"><td class=\"py-2 pr-3 font-semibold\">Без открит конкурс</td><td class=\"px-2 num\">20</td><td class=\"px-2\">Процедурата е договаряне без обявление или пряко договаряне.</td><td class=\"px-2\">Възложителят сам избира кого да покани. Законът го позволява само в изрични случаи.</td><td class=\"px-2 text-muted\">Често е законно: авария, единствен доставчик, неуспешна предишна процедура.</td><td class=\"px-2 text-right num\">26 698</td></tr><tr class=\"border-b border-rule align-top\"><td class=\"py-2 pr-3 font-semibold\">Над прогнозната стойност</td><td class=\"px-2 num\">10</td><td class=\"px-2\">Договорът е с повече от 5% над прогнозната стойност в обявлението.</td><td class=\"px-2\">Цената е по-висока от това, което самият възложител е очаквал.</td><td class=\"px-2 text-muted\">Прогнозата може да е стара или занижена.</td><td class=\"px-2 text-right num\">9968</td></tr><tr class=\"border-b border-rule align-top\"><td class=\"py-2 pr-3 font-semibold\">Цена почти равна на прогнозата</td><td class=\"px-2 num\">10</td><td class=\"px-2\">Една оферта и цена между 97% и 100% от прогнозата, при процедура с обявление (при договаряне без обявление прогнозата често се определя след преговорите и флагът не се смята).</td><td class=\"px-2\">Единственият участник предлага почти точно бюджета. Може да означава изтекла информация за прогнозата.</td><td class=\"px-2 text-muted\">Прогнозата е публична в обявлението, така че съвпадението може да е случайно.</td><td class=\"px-2 text-right num\">35 860</td></tr><tr class=\"border-b border-rule align-top\"><td class=\"py-2 pr-3 font-semibold\">Оскъпяване с анекси</td><td class=\"px-2 num\">12 или 20</td><td class=\"px-2\">Анексите добавят над 10% към цената (20 точки при над 30%).</td><td class=\"px-2\">Ниска цена за спечелване, после увеличение без конкуренция.</td><td class=\"px-2 text-muted\">Има обективни причини: допълнителни количества, поскъпване на материали (2022 г.).</td><td class=\"px-2 text-right num\">3034</td></tr><tr class=\"border-b border-rule align-top\"><td class=\"py-2 pr-3 font-semibold\">Отстранени конкуренти</td><td class=\"px-2 num\">15</td><td class=\"px-2\">Отстранени са оферти и остава един участник.</td><td class=\"px-2\">Конкурсът може да е бил формален, с изисквания, които само един изпълнява.</td><td class=\"px-2 text-muted\">Отстраняването може да е напълно основателно (непълни документи).</td><td class=\"px-2 text-right num\">3691</td></tr><tr class=\"border-b border-rule align-top\"><td class=\"py-2 pr-3 font-semibold\">Точно под прага</td><td class=\"px-2 num\">10</td><td class=\"px-2\">Стойност между 90% и 100% от прага за по-строга процедура (138 049 € за строителство, 35 790 € за доставки и услуги).</td><td class=\"px-2\">Възможно е поръчката да е нагласена, за да се избегне по-строгата процедура.</td><td class=\"px-2 text-muted\">Много поръчки естествено са в този размер.</td><td class=\"px-2 text-right num\">5956</td></tr><tr class=\"border-b border-rule align-top\"><td class=\"py-2 pr-3 font-semibold\">Връзка с политик</td><td class=\"px-2 num\">20</td><td class=\"px-2\">Депутат е собственик или управител на частната фирма изпълнител, или длъжностно лице е посочило фирмата в собствената си декларация (по Търговския регистър и декларациите, обработени от „Наясно“, и по нашето свързване на декларациите за интереси от регистъра на КПК).</td><td class=\"px-2\">Възможен конфликт на интереси.</td><td class=\"px-2 text-muted\">Държавните и общинските дружества не се броят: там управителят и „действителният собственик“ по закон са назначени лица. Не виждаме роднини извън декларираните и собственост чрез посредници.</td><td class=\"px-2 text-right num\">3379</td></tr><tr class=\"border-b border-rule align-top\"><td class=\"py-2 pr-3 font-semibold\">Възможна връзка с длъжностно лице</td><td class=\"px-2 num\">8</td><td class=\"px-2\">Собственик на фирмата по Търговския регистър е човек със същите три имена като длъжностно лице (кмет, съветник, директор и др.).</td><td class=\"px-2\">Може да е конфликт на интереси.</td><td class=\"px-2 text-muted\">Съвпадението е само по имена, без ЕГН. Може да е съименник, затова теглото е ниско.</td><td class=\"px-2 text-right num\">1199</td></tr><tr class=\"border-b border-rule align-top\"><td class=\"py-2 pr-3 font-semibold\">Кратък срок за оферти</td><td class=\"px-2 num\">8–10</td><td class=\"px-2\">От обявяването до крайния срок за оферти са минали под 20 дни при процедура по европейските правила или под 10 дни при публично състезание (по обявленията в ЦАИС ЕОП).</td><td class=\"px-2\">Краткият срок оставя време да се подготви само фирма, която е знаела предварително.</td><td class=\"px-2 text-muted\">Законът позволява по-кратък срок при спешност или предварително обявление. Срокът се смята от датата на публикуване до най-ранния краен срок сред обособените позиции.</td><td class=\"px-2 text-right num\">430</td></tr><tr class=\"border-b border-rule align-top\"><td class=\"py-2 pr-3 font-semibold\">Чести промени в условията</td><td class=\"px-2 num\">5</td><td class=\"px-2\">Условията на процедурата са променяни поне два пъти (обявления за промяна в ЦАИС ЕОП).</td><td class=\"px-2\">Многократните промени могат да пренапишат изискванията в полза на определен участник.</td><td class=\"px-2 text-muted\">Често промените са законни отговори на въпроси или поправки на грешки.</td><td class=\"px-2 text-right num\">94</td></tr><tr class=\"border-b border-rule align-top\"><td class=\"py-2 pr-3 font-semibold\">Нова фирма</td><td class=\"px-2 num\">15</td><td class=\"px-2\">Изпълнителят е създаден по-малко от година преди договора (по Търговския регистър).</td><td class=\"px-2\">Фирма без история и опит, понякога създадена специално за поръчката.</td><td class=\"px-2 text-muted\">Нови фирми има и законно, например след преобразуване. Датата за фирми отпреди 2008 г. е по номера на фирменото дело.</td><td class=\"px-2 text-right num\">955</td></tr><tr class=\"border-b border-rule align-top\"><td class=\"py-2 pr-3 font-semibold\">Голям дял на подизпълнители</td><td class=\"px-2 num\">8</td><td class=\"px-2\">Подизпълнителите поемат 50% или повече.</td><td class=\"px-2\">Печелившата фирма може да е само посредник.</td><td class=\"px-2 text-muted\">При сложни обекти е нормално част от работата да се възлага.</td><td class=\"px-2 text-right num\">173</td></tr></tbody></table></div><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Сигнали за възложителя (без точки)</h2></div><p class=\"max-w-3xl text-[15px] mb-3\">На страницата на всеки възложител показваме и сигнали за цялата му практика. Те не влизат в индекса на отделния договор.</p><ul class=\"list-disc pl-5 max-w-3xl text-[15px] space-y-1 mb-10\"><li><b>Повтарящи се поръчки:</b> поръчки със сходен предмет (сходство на думите поне 0,55) в рамките на 24 месеца, от поне две различни процедури и поне 90 дни една от друга (обособените позиции на една процедура и годишните услуги „за 2022 г.“, „за 2023 г.“ не се броят).</li><li><b>Възможно разделяне:</b> няколко договора с една фирма за 90 дни, всеки под прага на закона, но заедно над него.</li><li><b>Редуващи се изпълнители:</b> в една категория двама изпълнители имат поне по 3 договора, заедно поне 60% от договорите, а победителят се сменя при поне 60% от поредните им договори.</li><li><b>Общ собственик или управител</b> и <b>общ адрес на управление</b> (без етаж и офис) между различни изпълнители, по Търговския регистър. Обхватът расте заедно с прочетените фирми.</li><li>Участниците, които са загубили, не са в отворените данни, затова сравняваме само победителите.</li></ul><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Законови обяснения</h2></div><p class=\"max-w-3xl text-[15px] mb-3\">Понякога една оферта или договаряне без конкурс идват от закона или от монопол, а не от избор на възложителя. Тогава „Само една оферта“ и „Без открит конкурс“ остават видими, но носят по 5 точки вместо 25 и 20. Другите сигнали (политик, анекси, нова фирма и т.н.) се смятат както винаги. Разпознаваме случаите по предмета на договора:</p><ul class=\"list-disc pl-5 max-w-3xl text-[15px] space-y-1 mb-3\"><li>Покупка чрез стокова борса: цената се определя на борсата, затова офертата е една.</li><li>Универсалната пощенска услуга по закон се предоставя само от „Български пощи“.</li><li>Топлофикацията е единственият доставчик на топлинна енергия в населеното място (естествен монопол).</li><li>Мрежовата услуга (пренос, разпределение, ВиК) се предоставя от лицензиран монополист за района.</li><li>Изборният кодекс определя кой обработва изборните резултати („Информационно обслужване“).</li><li>Законът за електронното управление (чл. 7с) определя системния интегратор на държавата.</li><li>Превозните документи за градския транспорт се издават само от общинския оператор.</li><li>Акцизните бандероли по закон се отпечатват от Печатницата на БНБ.</li></ul><p class=\"max-w-3xl text-[15px] text-muted mb-10\">Вътрешните възлагания (in-house) не са в списъка: те са законни, но често спорни, затова се оценяват като всички останали. Засегнати договори: <!-- -->2056<!-- -->.</p><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Какво не виждаме</h2></div><ul class=\"list-disc pl-5 max-w-3xl text-[15px] space-y-1 mb-10\"><li>Договорите от 2020–2021 г. почти липсват в отворените данни на ЦАИС ЕОП. По-старите добавяме от европейската база TED, само над европейските прагове.</li><li>Колко е платено и кой е приел работата: това не се публикува. В страницата на всеки договор има готово заявление по ЗДОИ.</li><li>Кои фирми са участвали и с какви цени: протоколите на комисиите са в PDF, не в отворени данни.</li><li>Роднини и собственост чрез посредници. Свързваме само това, което е в Търговския регистър и декларациите.</li><li>Грешки в самите обявления (грешна сума, валута, брой оферти) се пренасят и при нас. Ако видите такава, пишете ни.</li></ul><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как да проверите сами</h2></div><p class=\"max-w-3xl text-[15px] mb-10\">Всеки договор води до обявлението в ЦАИС ЕОП. Правилата са точно тези в таблицата горе, а данните се обновяват всеки ден. <a href=\"/tarsene\">Търсене</a> · <a href=\"/porachki/risk\">Национална класация</a>.</p></div><!--$--><!--/$--></main><!--$--><!--/$--><footer class=\"bg-surface border-t border-rule mt-20\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 text-sm text-muted grid gap-2 sm:grid-cols-2\"><p>Не подкрепяме партия, кандидат или правителство. Всяко число има източник и дата.<!-- --> <a href=\"/metodologiya\">Как работим</a> · <a href=\"/rechnik\">Речник</a> · <a href=\"/sastoyanie\">Състояние на данните</a> · <!--$?--><template id=\"B:1\"></template><a href=\"/metodologiya#greshki\">Съобщи за грешка</a><!--/$--></p><p class=\"sm:text-right\">Вътрешен прототип · данните са към датите, посочени до тях</p></div></footer><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script id=\"_R_\">(globalThis[\"TURBOPACK\"] || (globalThis[\"TURBOPACK\"] = [])).push({\"otherChunks\":[\"static/chunks/310vm2bl3xxpt.js\",\"static/chunks/2vy51v46dlsq-.js\",\"static/chunks/2bx7ggprk0oi5.js\",\"static/chunks/0c1ad7rcpjghx.js\"],\"runtimeModuleIds\":[94553]});</script><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" async=\"\"></script><div hidden id=\"S:0\"><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" aria-current=\"page\" class=\"no-underline pb-1 border-b-2 text-white border-red\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header></div><script>$RB=[];$RV=function(a){$RT=performance.now();for(var b=0;b<a.length;b+=2){var c=a[b],e=a[b+1];null!==e.