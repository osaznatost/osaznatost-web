\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] sm:text-[2.4rem]\",\"children\":\"Накратко\"}],\"$undefined\"]}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 space-y-2 text-[16px]\",\"children\":[[\"$\",\"li\",\"От 1 юли 2026 г. всички пенсии, отпуснати до края на 2025 г., са увеличени със 7,8% по „швейцарското правило“.\",{\"children\":\"От 1 юли 2026 г. всички пенсии, отпуснати до края на 2025 г., са увеличени със 7,8% по „швейцарското правило“.\"}],[\"$\",\"li\",\"Бюджетът на ДОО предвижда реален ръст на средната пенсия 4,5% при средногодишна инфлация 4,3%.\",{\"children\":\"Бюджетът на ДОО предвижда реален ръст на средната пенсия 4,5% при средногодишна инфлация 4,3%.\"}],[\"$\",\"li\",\"Инфлацията обаче се ускори заради горивата: годишната инфлация е 6,8% през април, 4,5% през юли и 6,0% през октомври 2026 г. (окончателни данни на НСИ; експресната оценка беше 6,1%). МВФ и ОББ вдигнаха прогнозата си за средногодишната инфлация за 2026 г. до 4,9% и 5%.\",{\"children\":\"Инфлацията обаче се ускори заради горивата: годишната инфлация е 6,8% през април, 4,5% през юли и 6,0% през октомври 2026 г. (окончателни данни на НСИ; експресната оценка беше 6,1%). МВФ и ОББ вдигнаха прогнозата си за средногодишната инфлация за 2026 г. до 4,9% и 5%.\"}],[\"$\",\"li\",\"Изводът: пенсиите растат по-бързо от цените, но реалният ръст вероятно е по-малък от заложения в бюджета.\",{\"children\":\"Изводът: пенсиите растат по-бързо от цените, но реалният ръст вероятно е по-малък от заложения в бюджета.\"}]]}],[\"$\",\"div\",null,{\"className\":\"overflow-x-auto mt-5\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full text-[15px] num\",\"children\":[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"Увеличение на пенсиите от 1 юли 2026 г.\",{\"className\":\"border-b border-rule\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-1.5 pr-3\",\"children\":\"Увеличение на пенсиите от 1 юли 2026 г.\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-right font-semi