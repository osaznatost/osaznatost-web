x-4 sm:px-6 py-8 sm:py-12 max-w-3xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm mb-4\",\"children\":[\"$\",\"$L9\",null,{\"href\":\"/proverki\",\"children\":[\"← \",\"Всички проверки\"]}]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-green font-semibold mb-2\",\"children\":\"Проверка · 18 ноември 2026 г.\"}],[\"$\",\"h1\",null,{\"className\":\"display text-5xl sm:text-7xl max-w-4xl\",\"children\":\"Горивата: виновно ли е правителството?\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-lg text-muted max-w-3xl\",\"children\":\"Често се твърди, че горивата поскъпнаха заради новото правителство. Сравнихме кога и колко поскъпнаха и как стоим спрямо останалата част от ЕС.\"}]]}]}],[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb-5\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] sm:text-[2.4rem]\",\"children\":\"Накратко\"}],\"$undefined\"]}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 space-y-2 text-[16px]\",\"children\":[[\"$\",\"li\",\"Поскъпването започва на 28 февруари 2026 г. с войната в Иран: петролът „Брент“ надхвърли 100 $ за барел за първи път от над три години. Тогава управлява служебно правителство, редовното е от 8 май.\",{\"children\":\"Поскъпването започва на 28 февруари 2026 г. с войната в Иран: петролът „Брент“ надхвърли 100 $ за барел за първи път от над три години. Тогава управлява служебно правителство, редовното е от 8 май.\"}],[\"$\",\"li\",\"Горивата поскъпнаха във всички държави от ЕС. Средно за ЕС поскъпването през май е 20,7% на година (Евростат).\",{\"children\":\"Горивата поскъпнаха във всички държави от ЕС. Средно за ЕС поскъпването през май е 20,7% на година (Евростат).\"}],[\"$\",\"li\",\"В България то е най-голямото в ЕС: 33,9% през май и 26% през юни. Причината е най-вече ниската начална цена: в края на 2025 г. горивата у нас бяха най-евтините в ЕС, около 20% под средното.\",{\"children\":\"В България то е най-голямото в ЕС: 33,9% през май и 26% през юни. Причината е най-вече ниската начална цена: в края на 2025 г. горивата у нас бяха най-евтините в ЕС, около 20% под средното.\"}],[\"$\",\"li\",\"Дори след поскъпването България е сред трите държави с най-евтини горива в ЕС: на 9 ноември бензинът е 1,58 €/л при средно 1,88 €/л за ЕС, а дизелът 1,90 €/л при средно 2,10 €/л.\",{\"children\":\"Дори след поскъпването България е сред трите държави с най-евтини горива в ЕС: на 9 ноември бензинът е 1,58 €/л при средно 1,88 €/л за ЕС, а дизелът 1,90 €/л при средно 2,10 €/л.\"}],[\"$\",\"li\",\"Какво зависи от правителството: акцизите и ДДС върху горивата и конкуренцията на пазара. Рафинерията в Бургас е под особен търговски управител. Комисията за защита на конкуренцията препоръча други вносители да получат достъп до складовете и тръбопроводите на групата „Лукойл“.\",{\"children\":\"Какво зависи от правителството: акцизите и ДДС върху горивата и конкуренцията на пазара. Рафинерията в Бургас е под особен търговски управител. Комисията за защита на конкуренцията препоръча други вносители да получат достъп до складовете и тръбопроводите на групата „Лукойл“.\"}]]}],[\"$\",\"div\",null,{\"className\":\"overflow-x-auto mt-5\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full text-[15px] num\",\"children\":[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"Бензин А95, България, 9 ноември 2026\",{\"className\":\"border-b border-rule\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-1.5 pr-3\",\"children\":\"Бензин А95, България, 9 ноември 2026\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-right font-semibold\",\"children\":\"1,58 €/л\"}],\"$L19\"]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"]}]}]}],\"$undefined