rty\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:title\",\"content\":\"Проверка: Горивата: виновно ли е правителството? · Осъзнатост\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:description\",\"content\":\"Какво прави държавата. С числа и източници.\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:image\",\"content\":\"https://osaznatost-web.vercel.app/og.png\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:image:alt\",\"content\":\"Осъзнатост — какво прави държавата, с числа и източници\"}],[\"$\",\"meta\",\"17\",{\"name\":\"twitter:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"18\",{\"name\":\"twitter:image:height\",\"content\":\"630\"}],[\"$\",\"link\",\"19\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?favicon.117ezoe8m31dk.ico\",\"sizes\":\"48x48\",\"type\":\"image/x-icon\"}],\"$L1f\"]}]}],null]}],\"$L20\"]}],\"p\":\"$@21\",\"v\":null,\"s\":\"$c\"}},\"a\":\"$@22\",\"u\":\"$@23\",\"b\":\"BnpfSvxUfiSkNOlqobTmv\"}\n24:I[97367,[\"$2\"],\"OutletBoundary\"]\n26:I[27201,[\"$2\"],\"IconMark\"]\n13:[\"$\",\"li\",\"Горивата поскъпнаха във всички държави от ЕС. Средно за ЕС поскъпването през май е 20,7% на година (Евростат).\",{\"children\":\"Горивата поскъпнаха във всички държави от ЕС. Средно за ЕС поскъпването през май е 20,7% на година (Евростат).\"}]\n14:[\"$\",\"li\",\"В България то е най-голямото в ЕС: 33,9% през май и 26% през юни. Причината е най-вече ниската начална цена: в края на 2025 г. горивата у нас бяха най-евтините в ЕС, около 20% под средното.\",{\"children\":\"В България то е най-голямото в ЕС: 33,9% през май и 26% през юни. Причината е най-вече ниската начална цена: в края на 2025 г. горивата у нас бяха най-евтините в ЕС, около 20% под средното.\"}]\n15:[\"$\",\"li\",\"Дори след поскъпването България е сред трите държави с най-евтини горива в ЕС: на 9 ноември бензинът е 1,58 €/л при средно 1,88 €/л за ЕС, а дизелът 1,90 €/л при средно 2,10 €/л.\",{\"children\":\"Дори след поскъпването България е сред трите държави с най-евтини горива в ЕС: на 9 ноември бензинът е 1,58 €/л при средно 1,88 €/л за ЕС, а дизелът 1,90 €/л при средно 2,10 €/л.\"}]\n16:[\"$\",\"li\",\"Какво зависи от правителството: акцизите и ДДС върху горивата и конкуренцията на пазара. Рафинерията в Бургас е под особен търговски управител. Комисията за защита на конкуренцията препоръча други вносители да получат достъп до складовете и тръбопроводите на групата „Лукойл“.\",{\"children\":\"Какво зависи от правителството: акцизите и ДДС върху горивата и конкуренцията на пазара. Рафинерията в Бургас е под особен търговски управител. Комисията за защита на конкуренцията препоръча други вносители да получат достъп до складовете и тръбопроводите на групата „Лукойл“.\"}]\n17:[\"$\",\"div\",null,{\"className\":\"overflow-x-auto mt-5\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full text-[15px] num\",\"children\":[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"Бензин А95, България, 9 ноември 2026\",{\"className\":\"border-b border-rule\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-1.5 pr-3\",\"children\":\"Бензин А95, България, 9 ноември 2026\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-right font-semibold\",\"children\":\"1,58 €/л\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-sm\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.fuel-prices.eu/news/bulgaria-petrol-below-1-60-eur-2026-11-09/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"източник\"}]}]]}],[\"$\",\"tr\",\"Дизел, България, 9 ноември 2026\",{\"className\":\"border-b border-rule\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-1.5 pr-3\",\"children\":\"Дизел, България, 9 ноември 2026\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-right font-semibold\",\"children\":\"1,90 €/л\"}],[\"$\",\"td\",null,{\"className\":\"px-2 text-sm\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.fuel-prices.eu/news/bulg