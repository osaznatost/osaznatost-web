{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/ikonomika/layout,_N_T_/ikonomika/page,_N_T_/ikonomika"},"segmentPaths":["/_tree","/_full","/ikonomika/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/8382f83a9ea8e2af88aa80b2e76e7262883a266b79be99658ae0d26ecd0ec9e3/$/ikonomika","owner":{"kind":"APP_PAGE","sourceRoute":"/ikonomika/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2bx3suebn7wim.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><script src=\"/_next/static/chunks/3fum20g_rxrn1.js\" async=\"\"></script><script src=\"/_next/static/chunks/331ycelxo_l9t.js\" async=\"\"></script><title>Здравето на икономиката · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Здравето на икономиката · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Здравето на икономиката · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Здравето на икономиката</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Осем числа, които показват дали икономиката е здрава, с история и сравнение с ЕС. Данните идват от Евростат и се обновяват автоматично (последно на 20 ноември 2026 г.).</div></div></div><section class=\"grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4 mb-6\"><a href=\"#rastezh\" class=\"no-underline text-ink block bg-white ring-1 ring-rule rounded-sm p-4 border-t-4 border-[#2f9e6a] hover:bg-surface\"><div class=\"flex flex-wrap justify-between items-baseline gap-x-2\"><p class=\"text-sm text-muted\">Растеж на икономиката, 2025</p><span class=\"text-xs font-semibold text-[#2f7d57]\">Добре</span></div><p class=\"display num text-[2rem] sm:text-[2.6rem] leading-none mt-2\">3<span class=\"text-lg font-normal text-muted\">%</span></p><p class=\"text-sm mt-1\">ЕС: <b class=\"num\">1,4%</b></p><p class=\"hidden sm:block text-sm text-muted mt-2\">Реален ръст на БВП. Над 2,5% означава, че догонваме ЕС.</p></a><a href=\"#ceni\" class=\"no-underline text-ink block bg-white ring-1 ring-rule rounded-sm p-4 border-t-4 border-[#e2b33b] hover:bg-surface\"><div class=\"flex flex-wrap justify-between items-baseline gap-x-2\"><p class=\"text-sm text-muted\">Инфлация, 2025</p><span class=\"text-xs font-semibold text-[#9a7414]\">Внимание</span></div><p class=\"display num text-[2rem] sm:text-[2.6rem] leading-none mt-2\">3,5<span class=\"text-lg font-normal text-muted\">%</span></p><p class=\"text-sm mt-1\">ЕС: <b class=\"num\">2,5%</b></p><p class=\"hidden sm:block text-sm text-muted mt-2\">Средногодишно поскъпване. Целта на ЕЦБ е 2%.</p></a><a href=\"#trud\" class=\"no-underline text-ink block bg-white ring-1 ring-rule rounded-sm p-4 border-t-4 border-[#2f9e6a] hover:bg-surface\"><div class=\"flex flex-wrap justify-between items-baseline gap-x-2\"><p class=\"text-sm text-muted\">Безработица, 2025</p><span class=\"text-xs font-semibold text-[#2f7d57]\">Добре</span></div><p class=\"display num text-[2rem] sm:text-[2.6rem] leading-none mt-2\">3,5<span class=\"text-lg font-normal text-muted\">%</span></p><p class=\"text-sm mt-1\">ЕС: <b class=\"num\">6%</b></p><p class=\"hidden sm:block text-sm text-muted mt-2\">Дял на търсещите работа от работната сила.</p></a><a href=\"#trud\" class=\"no-underline text-ink block bg-white ring-1 ring-rule rounded-sm p-4 border-t-4 border-[#2f9e6a] hover:bg-surface\"><div class=\"flex flex-wrap justify-between items-baseline gap-x-2\"><p class=\"text-sm text-muted\">Заетост 20–64 г., 2025</p><span class=\"text-xs font-semibold text-[#2f7d57]\">Добре</span></div><p class=\"display num text-[2rem] sm:text-[2.6rem] leading-none mt-2\">77<span class=\"text-lg font-normal text-muted\">%</span></p><p class=\"text-sm mt-1\">ЕС: <b class=\"num\">76,1%</b></p><p class=\"hidden sm:block text-sm text-muted mt-2\">Колко от хората в трудоспособна възраст работят.</p></a><a href=\"#finansi\" class=\"no-underline text-ink block bg-white ring-1 ring-rule rounded-sm p-4 border-t-4 border-[#2f9e6a] hover:bg-surface\"><div class=\"flex flex-wrap justify-between items-baseline gap-x-2\"><p class=\"text-sm text-muted\">Дълг, 2025</p><span class=\"text-xs font-semibold text-[#2f7d57]\">Добре</span></div><p class=\"display num text-[2rem] sm:text-[2.6rem] leading-none mt-2\">29,9<span class=\"text-lg font-normal text-muted\">% от БВП</span></p><p class=\"text-sm mt-1\">ЕС: <b class=\"num\">81,5%</b></p><p class=\"hidden sm:block text-sm text-muted mt-2\">Границата в правилата на ЕС е 60%.</p></a><a href=\"#finansi\" class=\"no-underline text-ink block bg-white ring-1 ring-rule rounded-sm p-4 border-t-4 border-red hover:bg-surface\"><div class=\"flex flex-wrap justify-between items-baseline gap-x-2\"><p class=\"text-sm text-muted\">Бюджетно салдо, 2025</p><span class=\"text-xs font-semibold text-red\">Проблем</span></div><p class=\"display num text-[2rem] sm:text-[2.6rem] leading-none mt-2\">-4<span class=\"text-lg font-normal text-muted\">% от БВП</span></p><p class=\"text-sm mt-1\">ЕС: <b class=\"num\">-3,1%</b></p><p class=\"hidden sm:block text-sm text-muted mt-2\">Границата за дефицит в правилата на ЕС е 3%.</p></a><a href=\"#rastezh\" class=\"no-underline text-ink block bg-white ring-1 ring-rule rounded-sm p-4 border-t-4 border-red hover:bg-surface\"><div class=\"flex flex-wrap justify-between items-baseline gap-x-2\"><p class=\"text-sm text-muted\">БВП на човек, 2025</p><span class=\"text-xs font-semibold text-red\">Проблем</span></div><p class=\"display num text-[2rem] sm:text-[2.6rem] leading-none mt-2\">68<span class=\"text-lg font-normal text-muted\"> (ЕС = 100)</span></p><p class=\"hidden sm:block text-sm text-muted mt-2\">По покупателна способност. Преди 10 години: 49.</p></a><a href=\"#trud\" class=\"no-underline text-ink block bg-white ring-1 ring-rule rounded-sm p-4 border-t-4 border-red hover:bg-surface\"><div class=\"flex flex-wrap justify-between items-baseline gap-x-2\"><p class=\"text-sm text-muted\">Неравенство (Джини), 2025</p><span class=\"text-xs font-semibold text-red\">Проблем</span></div><p class=\"display num text-[2rem] sm:text-[2.6rem] leading-none mt-2\">37,7<span class=\"text-lg font-normal text-muted\"></span></p><p class=\"text-sm mt-1\">ЕС: <b class=\"num\">29,2</b></p><p class=\"hidden sm:block text-sm text-muted mt-2\">0 = всички имат еднакъв доход, 100 = един има всичко.</p></a></section><nav aria-label=\"Подробно по теми\" class=\"grid grid-cols-2 lg:grid-cols-5 gap-3 mb-12\"><a class=\"block ring-1 ring-rule rounded-sm p-3 sm:p-4 bg-white no-underline text-ink hover:ring-2 hover:ring-green\" href=\"/ikonomika/struktura\"><span class=\"font-semibold sm:text-lg leading-snug block\">Анатомия на икономиката →</span><span class=\"hidden sm:block text-sm text-muted mt-1\">Кои сектори създават стойност, за какво се харчи БВП, колко остава за заплати и колко за печалби, решенията през годините и разликите между областите.</span></a><a class=\"block ring-1 ring-rule rounded-sm p-3 sm:p-4 bg-white no-underline text-ink hover:ring-2 hover:ring-green\" href=\"/ikonomika/investicii\"><span class=\"font-semibold sm:text-lg leading-snug block\">Чуждестранни инвестиции →</span><span class=\"hidden sm:block text-sm text-muted mt-1\">Колко са вложили чуждите компании, от кои държави, в кои отрасли и колко печелят от това.</span></a><a class=\"block ring-1 ring-rule rounded-sm p-3 sm:p-4 bg-white no-underline text-ink hover:ring-2 hover:ring-green\" href=\"/ikonomika/evrosredstva\"><span class=\"font-semibold sm:text-lg leading-snug block\">Европейски средства →</span><span class=\"hidden sm:block text-sm text-muted mt-1\">83 хиляди договора: фондове, програми, усвояване, общини, бенефициенти и връзки с политици.</span></a><a class=\"block ring-1 ring-rule rounded-sm p-3 sm:p-4 bg-white no-underline text-ink hover:ring-2 hover:ring-green\" href=\"/ikonomika/potoci\"><span class=\"font-semibold sm:text-lg leading-snug block\">Кръвоносната система →</span><span class=\"hidden sm:block text-sm text-muted mt-1\">Как се разпределя създаденото, какво влиза и излиза от страната, кое носи печалба и кои държавни фирми губят.</span></a><a class=\"block ring-1 ring-rule rounded-sm p-3 sm:p-4 bg-white no-underline text-ink hover:ring-2 hover:ring-green\" href=\"/ikonomika/pokupatelna-sila\"><span class=\"font-semibold sm:text-lg leading-snug block\">Какво купува минималната заплата →</span><span class=\"hidden sm:block text-sm text-muted mt-1\">Храна, хляб, ток, горива, дрехи: колко реално купуват 620 € в България срещу Румъния, Хърватия, Полша и други.</span></a></nav><p class=\"text-xs text-muted mb-14 max-w-3xl\">Оценките „добре / внимание / проблем“ са по прости, обявени прагове: целта за инфлация на ЕЦБ, границите за дълг и дефицит в правилата на ЕС и средното за ЕС за пазара на труда. Те не са мнение за правителство.</p><section id=\"rastezh\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Растеж и богатство</h2></div><div class=\"text-[16px] max-w-3xl -mt-2 mb-5\">Икономиката расте с <b>3<!-- -->%</b> при <b>1,4<!-- -->%</b> за ЕС, тоест догонваме. По покупателна способност сме на <b>68<!-- -->%</b> от средното за ЕС (<!-- -->2025<!-- --> г.), след <!-- -->Полша (81), Румъния (78), Хърватия (78), Унгария (76)<!-- -->. Инвестициите са <b>20,9<!-- -->%</b> от БВП при <!-- -->21,5<!-- -->% в ЕС: от тях зависи бъдещият растеж.</div><div class=\"grid gap-4 lg:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Реален растеж на БВП, %</p><div class=\"w-full\"></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">БВП на човек по покупателна способност (ЕС = 100)</p><div class=\"w-full\"></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Инвестиции, % от БВП</p><div class=\"w-full\"></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Износ, % от БВП</p><div class=\"w-full\"></div><p class=\"text-sm text-muted mt-2\">Високият дял на износа значи, че икономиката зависи от търсенето в чужбина.</p></div></div><p class=\"text-xs text-muted mt-3\">Източник: Евростат (<span><a href=\"https://ec.europa.eu/eurostat/databrowser/view/nama_10_gdp/default/table\" target=\"_blank\" rel=\"noreferrer\">nama_10_gdp</a></span><span>, <a href=\"https://ec.europa.eu/eurostat/databrowser/view/tec00114/default/table\" target=\"_blank\" rel=\"noreferrer\">tec00114</a></span>).</p></section><section id=\"ceni\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Цени</h2></div><div class=\"text-[16px] max-w-3xl -mt-2 mb-5\">Цените растат с <b>3,5<!-- -->%</b> годишно при <!-- -->2,5<!-- -->% в ЕС. При по-бърз растеж на заплатите от цените покупателната способност се подобрява, но храната и наемите поскъпват над средното (вижте <a href=\"/statistiki/analiz#dohodi\">доходи срещу цени</a>).</div><div class=\"grid gap-4 lg:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Инфлация по години, %</p><div class=\"w-full\"></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Инфлация по месеци, годишна промяна, %</p><div class=\"w-full\"></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Храни, годишна инфлация, %</p><div class=\"w-full\"></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Енергия, годишна инфлация, %</p><div class=\"w-full\"></div></div></div><p class=\"text-xs text-muted mt-3\">Източник: Евростат (<span><a href=\"https://ec.europa.eu/eurostat/databrowser/view/prc_hicp_aind/default/table\" target=\"_blank\" rel=\"noreferrer\">prc_hicp_aind</a></span><span>, <a href=\"https://ec.europa.eu/eurostat/databrowser/view/prc_hicp_manr/default/table\" target=\"_blank\" rel=\"noreferrer\">prc_hicp_manr</a></span>).</p></section><section id=\"finansi\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Публични финанси</h2></div><div class=\"text-[16px] max-w-3xl -mt-2 mb-5\">Държавата събира <b>38,1<!-- -->%</b> от БВП и харчи <b>42,1<!-- -->%</b> (<!-- -->2025<!-- --> г.). Разликата е дефицитът, който се покрива с нов дълг. Лихвите струват <b>0,8<!-- -->%</b> от БВП при <!-- -->1,9<!-- -->% в ЕС, защото дългът е нисък, но всеки дефицит над 3% го увеличава. Подробно: <a href=\"/pari/dalg\">дългът</a> и <a href=\"/byudzhet\">бюджетът</a>.</div><div class=\"grid gap-4 lg:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Приходи и разходи на държавата, % от БВП (България)</p><div class=\"w-full\"></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Бюджетно салдо, % от БВП</p><div class=\"w-full\"></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Дълг, % от БВП</p><div class=\"w-full\"></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Разходи за лихви, % от БВП</p><div class=\"w-full\"></div></div></div><p class=\"text-xs text-muted mt-3\">Източник: Евростат (<span><a href=\"https://ec.europa.eu/eurostat/databrowser/view/gov_10a_main/default/table\" target=\"_blank\" rel=\"noreferrer\">gov_10a_main</a></span><span>, <a href=\"https://ec.europa.eu/eurostat/databrowser/view/gov_10dd_edpt1/default/table\" target=\"_blank\" rel=\"noreferrer\">gov_10dd_edpt1</a></span>).</p></section><section id=\"trud\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Труд и доходи</h2></div><div class=\"text-[16px] max-w-3xl -mt-2 mb-5\">Работят <b>77<!-- -->%</b> от хората на 20–64 г., безработицата е <b>3,5<!-- -->%</b>. Минималната заплата е <b>620<!-- --> €</b> (<!-- -->2021<!-- --> г.: <!-- -->332<!-- --> €)<!-- -->. Неравенството в доходите (Джини <b>37,7</b>) е сред най-високите в ЕС (<!-- -->29,2<!-- -->).</div><div class=\"grid gap-4 lg:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Безработица, %</p><div class=\"w-full\"></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Безработица сред младите (15–24 г.), %</p><div class=\"w-full\"></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Заетост 20–64 г., %</p><div class=\"w-full\"></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Минимална заплата, € на месец</p><div class=\"w-full\"></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Неравенство в доходите (коефициент на Джини)</p><div class=\"w-full\"></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Колко пъти доходът на най-богатите 20% е по-голям от този на най-бедните 20%</p><div class=\"w-full\"></div></div></div><p class=\"text-xs text-muted mt-3\">Източник: Евростат (<span><a href=\"https://ec.europa.eu/eurostat/databrowser/view/une_rt_a/default/table\" target=\"_blank\" rel=\"noreferrer\">une_rt_a</a></span><span>, <a href=\"https://ec.europa.eu/eurostat/databrowser/view/lfsi_emp_a/default/table\" target=\"_blank\" rel=\"noreferrer\">lfsi_emp_a</a></span><span>, <a href=\"https://ec.europa.eu/eurostat/databrowser/view/earn_mw_cur/default/table\" target=\"_blank\" rel=\"noreferrer\">earn_mw_cur</a></span><span>, <a href=\"https://ec.europa.eu/eurostat/databrowser/view/ilc_di12/default/table\" target=\"_blank\" rel=\"noreferrer\">ilc_di12</a></span>).</p></section><section class=\"max-w-3xl\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как се връзват числата</h2></div><ul class=\"list-disc pl-5 space-y-2 text-[16px]\"><li><b>Растеж и дълг.</b> Дългът като дял от БВП пада, ако икономиката расте по-бързо от дълга. При растеж <!-- -->3<!-- -->% и дефицит <!-- -->4<!-- -->% дългът расте, защото новият дълг е по-голям от ефекта на растежа.</li><li><b>Инфлация и заплати.</b> Когато минималната заплата и доходите растат по-бързо от цените, хората купуват повече. Но по-високите заплати увеличават и разходите на бизнеса, което може да вдигне цените.</li><li><b>Заетост и пенсии.</b> По-малкото работещи на един пенсионер означава повече натиск върху бюджета на НОИ, който днес се доплаща от държавния бюджет.</li><li><b>Инвестиции и бъдещ растеж.</b> Ниските инвестиции днес означават по-бавен растеж утре. Част от инвестициите зависят от европейските средства.</li></ul></section></div><!--$--><!--/$--></main><!--$--><!--/$--><footer class=\"bg-surface border-t border-rule mt-20\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 text-sm text-muted grid gap-2 sm:grid-cols-2\"><p>Не подкрепяме партия, кандидат или правителство. Всяко число има източник и дата.<!-- --> <a href=\"/metodologiya\">Как работим</a> · <a href=\"/rechnik\">Речник</a> · <a href=\"/sastoyanie\">Състояние на данните</a> · <!--$?--><template id=\"B:1\"></template><a href=\"/metodologiya#greshki\">Съобщи за грешка</a><!--/$--></p><p class=\"sm:text-right\">Вътрешен прототип · данните са към датите, посочени до тях</p></div></footer><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script id=\"_R_\">(globalThis[\"TURBOPACK\"] || (globalThis[\"TURBOPACK\"] = [])).push({\"otherChunks\":[\"static/chunks/310vm2bl3xxpt.js\",\"static/chunks/2vy51v46dlsq-.js\",\"static/chunks/2bx7ggprk0oi5.js\",\"static/chunks/0c1ad7rcpjghx.js\"],\"runtimeModuleIds\":[94553]});</script><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" async=\"\"></script><div hidden id=\"S:0\"><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" aria-current=\"page\" class=\"no-underline pb-1 border-b-2 text-white border-red\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header></div><script>$RB=[];$RV=function(a){$RT=performance.now();for(var b=0;b<a.length;b+=2){var c=a[b],e=a[b+1];null!==e.parentNode&&e.parentNode.removeChild(e);var f=c.parentNode;if(f){var g=c.previousSibling,h=0;do{if(c&&8===c.nodeType){var d=c.data;if(\"/$\"===d||\"/&\"===d)if(0===h)break;else h--;else\"$\"!==d&&\"$?\"!==d&&\"$~\"!==d&&\"$!\"!==d&&\"&\"!==d||h++}d=c.nextSibling;f.removeChild(c);c=d}while(c);for(;e.firstChild;)f.insertBefore(e.firstChild,c);g.data=\"$\";g._reactRetry&&requestAnimationFrame(g._reactRetry)}}a.length=0};\n$RC=function(a,b){if(b=document.getElementById(b))(a=document.getElementById(a))?(a.previousSibling.data=\"$~\",$RB.push(a,b),2===$RB.length&&(\"number\"!==typeof $RT?requestAnimationFrame($RV.bind(null,$RB)):(a=performance.now(),setTimeout($RV.bind(null,$RB),2300>a&&2E3<a?2300-a:$RT+300-a