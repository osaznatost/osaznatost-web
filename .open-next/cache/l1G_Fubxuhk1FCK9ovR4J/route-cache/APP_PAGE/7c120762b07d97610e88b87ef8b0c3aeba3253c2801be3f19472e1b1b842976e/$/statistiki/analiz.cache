мите?\"}],[\"$\",\"p\",null,{\"className\":\"text-[16px] text-muted max-w-3xl mb-4\",\"children\":\"2015 г. = 100. Когато цените на жилищата растат по-бързо от наемите, купуването става по-неизгодно спрямо наема, а доходността от отдаване под наем пада.\"}],[\"$\",\"div\",null,{\"className\":\"bg-surface rounded-sm p-4 mb-5 max-w-3xl text-[16px]\",\"children\":[\"От \",2015,\" до \",2025,\" г. жилищата в България са поскъпнали с \",[\"$\",\"b\",null,{\"children\":[\"149\",\"%\"]}],\", наемите с \",[\"$\",\"b\",null,{\"children\":[\"49\",\"%\"]}],\", а всички цени общо с \",[\"$\",\"b\",null,{\"children\":[\"42\",\"%\"]}],\". Цената на жилище, изразена в години наем, се е увеличила с \",[\"$\",\"b\",null,{\"children\":[\"68\",\"%\"]}],\". За сравнение в ЕС: жилищата +\",\"62\",\"%, наемите +\",\"20\",\"%.\"]}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 lg:grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"ring-1 ring-rule rounded-sm p-4 bg-white\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-2\",\"children\":\"България (2015 = 100)\"}],[\"$\",\"$L29\",null,{\"data\":[{\"series\":\"Жилища\",\"x\":2015,\"value\":100},{\"series\":\"Жилища\",\"x\":2016,\"value\":107.02},{\"series\":\"Жилища\",\"x\":2017,\"value\":116.3},{\"series\":\"Жилища\",\"x\":2018,\"value\":123.96},{\"series\":\"Жилища\",\"x\":2019,\"value\":131.42},{\"series\":\"Жилища\",\"x\":2020,\"value\":137.41},{\"series\":\"Жилища\",\"x\":2021,\"value\":149.33},{\"series\":\"Жилища\",\"x\":2022,\"value\":169.92},{\"series\":\"Жилища\",\"x\":2023,\"value\":186.67},{\"series\":\"Жилища\",\"x\":2024,\"value\":217.47},{\"series\":\"Жилища\",\"x\":2025,\"value\":249.23},{\"series\":\"Наеми\",\"x\":2015,\"value\":100},{\"series\":\"Наеми\",\"x\":2016,\"value\":100.6},{\"series\":\"Наеми\",\"x\":2017,\"value\":101.6},{\"series\":\"Наеми\",\"x\":2018,\"value\":103.5},{\"series\":\"Наеми\",\"x\":2019,\"value\":107},{\"series\":\"Наеми\",\"x\":2020,\"value\":109.6},{\"series\":\