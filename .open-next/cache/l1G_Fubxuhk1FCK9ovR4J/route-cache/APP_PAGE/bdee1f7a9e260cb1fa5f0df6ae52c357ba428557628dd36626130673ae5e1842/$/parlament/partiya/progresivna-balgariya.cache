ll,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}]]}]\n4d:[\"$\",\"tr\",\"nasarchavane-na-investitsiite\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/nasarchavane-na-investitsiite\",\"children\":\"Закон за насърчаване на инвестициите (ново министерство и Координационен съвет по инвестициите)\"}],[\"$\",\"span\",null,{\"className\":\"block text-sm text-muted\",\"children\":[\"Законът следва новата структура на правителството: създава Министерството на икономиката, инвестициите и индустрията (от Министерството на икономиката и част от Министерството на иновациите и растежа) и разпределя правомощията между него и Министерството на иновациите и дигиталната трансформация\",\".\"]}]]}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}]]}]\n4e:[\"$\",\"tr\",\"targovskiya-registar-i-registara-na-yuridicheskite-litsa-s-nestopanska-tsel\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/targovskiya-registar-i-registara-na-yuridicheskite-litsa-s-nestopanska-tsel\",\"children\":\"Закон за търговския регистър (забавените вписвания и годишните отчети)\"}],[\"$\",\"span\",null,{\"className\":\"block text-sm text-muted\",\"children\":[\"Законът цели да намали забавянето на вписванията в Търговския регистър: заявленията за годишните финансови отчети и декларациите на фирми без дейност се обработват в отделен поток, за да не спират останалите вписвания, а част от декларациите отпадат, защото информацията може да се провери служебно.\",\".\"]}]]}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}],[\"$\",\"td\",null,{\"classN