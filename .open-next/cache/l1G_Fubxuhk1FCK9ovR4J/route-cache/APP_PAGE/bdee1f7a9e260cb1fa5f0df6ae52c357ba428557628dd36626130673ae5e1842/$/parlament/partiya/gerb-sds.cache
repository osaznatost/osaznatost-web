арския език: той събира годишни доклади от институциите, прави годишен доклад до Министерския съвет и парламента, предлага препоръки за правилата на книжовния език и дава становища по учебните планове и учебниците\\\",\\\".\\\"]}]]}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold \\\",\\\"children\\\":\\\"–\\\"}]]}]\\n65:[\\\"$\\\",\\\"tr\\\",\\\"podpomagane-na-zemedelskite-proizvoditeli\\\",{\\\"className\\\":\\\"border-b border-rule align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2 pr-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lb\\\",null,{\\\"href\\\":\\\"/parlament/zakon/podpomagane-na-zemedelskite-proizvoditeli\\\",\\\"children\\\":\\\"Закон за подпомагане на земеделските производители (Взаимоспомагателен фонд, Copa-Cogeca, оранжерии)\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"block text-sm text-muted\\\",\\\"children\\\":[\\\"Държавен фонд „Земеделие“ може да изплаща обезщетения от Взаимоспомагателен фонд при неблагоприятни климатични явления и болести по растенията и животните; средствата идват от публично финансиране и от непотърсени от правоимащите суми по Закона за земеделските земи след 10 години\\\",\\\".\\\"]}]]}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}]]}]\\n66:[\\\"$\\\",\\\"tr\\\",\\\"nezavisimiya-finansov-odit-i-izrazyavaneto-na-sigurnost-po-ustoychivostta\\\",{\\\"className\\\":\\\"border-b border-rule align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2 pr-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lb\\\",null,{\\\"href\\\":\\\"/parlament/zakon/nezavisimiya-finansov-odit-i-izrazyavaneto-na-sigurnost-po-ustoychivostta\\\",\\\"children\\\":\\\"Закон за независимия финансов одит и изразяването на сигурност по устойчивостта\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"block text-sm text-muted\\\",\\\"children\\\":[\\\"Заедно с промените в Закона за счетоводството въвежда директивата „Омнибус“ (2026/470): проверката на отчетите за устойчивост остава с „ограничена степен на сигурност“ (по-евтина и по-лека), има преходен режим за одитори от трети държави\\\",\\\".\\\"]}]]}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-[#b08436]\\\",\\\"children\\\":\\\"Въздържал се\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold \\\",\\\"children\\\":\\\"–\\\"}]]}]\\n67:[\\\"$\\\",\\\"tr\\\",\\\"administrativnoto-regulirane-na-proizvodstvoto-na-optichni-diskove-i-matritsi\\\",{\\\"className\\\":\\\"border-b border-rule align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2 pr-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lb\\\",null,{\\\"href\\\":\\\"/parlament/zakon/administrativnoto-regulirane-na-proizvodstvoto-na-optichni-diskove-i-matritsi\\\",\\\"children\\\":\\\"Закон за административното регулиране на производството на оптични дискове и матрици\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"block text-sm text-muted\\\",\\\"children\\\":[\\\"Технически закон за по-малко административна тежест: информацията за лицензите за производство на оптични дискове и матрици се събира служебно, а услугите могат да се заявяват електронно\\\",\\\".\\\"]}]]}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold \\\",\\\"children\\\":\\\"–\\\"}]]}]\\n68:[\\\"$\\\",\\\"tr\\\",\\\"zabrana-na-himicheskoto-orazhie-i-za-kontrol-na-toksichnite-himicheski-veshtestva-i-tehnite-prekursori\\\",{\\\"className\\\":\\\"border-b border-rule align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td