ame\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/danak-varhu-dobavenata-stoynost\",\"children\":\"Закон за данък върху добавената стойност (електронни фактури, праг за регистрация, глоби)\"}],[\"$\",\"span\",null,{\"className\":\"block text-sm text-muted\",\"children\":[\"Правителственият законопроект въвежда задължителни структурирани електронни фактури между фирмите и към държавата, подавани в реално време към НАП; дневниците за покупки и продажби отпадат, а НАП ще генерира проект на месечната декларация\",\".\"]}]]}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-[#b08436]\",\"children\":\"Въздържал се\"}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold \",\"children\":\"–\"}]]}]\n4b:[\"$\",\"tr\",\"danachno-osiguritelen-protsesualen-kodeks\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/danachno-osiguritelen-protsesualen-kodeks\",\"children\":\"Данъчно-осигурителен процесуален кодекс (обмен на данъчна информация в ЕС)\"}],[\"$\",\"span\",null,{\"className\":\"block text-sm text-muted\",\"children\":[\"Законът въвежда европейските правила за административно сътрудничество и обмен на данъчна информация между държавите членки, за да се ограничи избягването на данъци\",\".\"]}]]}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}]]}]\n4c:[\"$\",\"tr\",\"lova-i-opazvane-na-divecha\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/lova-i-opazvane-na-divecha\",\"children\":\"Закон за лова и опазване на дивеча (четири законопроекта, ноемв