e\":\"border-l-4 border-[#e08a2e] pl-3\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Цветан Цветанов\"}],\" — \",\"Бивш вицепремиер и министър на вътрешните работи от ГЕРБ\",\". \",[\"$\",\"span\",null,{\"className\":\"font-semibold\",\"children\":\"Окончателно оправдан\"}],\" (2016-01)\",\": \",\"Обвинения, че като министър е осуетил разследване, като шест пъти е отказал да разпореди специални разузнавателни средства, и за изплащане на близо 50 000 лв. на бивш шеф на звеното срещу организираната престъпност във Велико Търново.\",\" \",[\"$\",\"a\",null,{\"href\":\"https://bta.bg/en/news/158360-Supreme-Court-Acquits-Ex-Interior-Minister-Tsvetanov-in-Surveillance-Refusal-Cas\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Източник\"}]]}],\"$L78\",\"$L79\",\"$L7a\",\"$L7b\"],[\"$L7c\"]]}],\"$L7d\"]}]\n21:[\"$\",\"section\",null,{\"id\":\"subsidiya\",\"className\":\"mb-14 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb-5\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] sm:text-[2.4rem]\",\"children\":\"Държавна субсидия\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-3 mb-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"ring-1 ring-rule rounded-sm p-4 bg-white\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":[\"По старата ставка (\",\"4,09\",\" € на глас)\"]}],[\"$\",\"p\",null,{\"className\":\"display text-[2rem]\",\"children\":\"1,77 млн. €\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"годишно, до 30 април 2026 г.\"}]]}],[\"$\",\"div\",null,{\"className\":\"ring-1 ring-rule rounded-sm p-4 bg-white\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":[\"По новата ставка (\",\"3\",\" € на глас)\"]}],[\"$\",\"p\",null,{\"className\":\"display text-[2rem]\",\"children\":\"1,3 млн. €\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"годишно, от 30 април 2026 г.\"}]]}],[\"$\",\"div\",null,{\"className\":\"ring-1 ring-rule rounded-sm p-4 bg-white\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Разлика за хазната\"}],[\"$\",\"p\",null,{\"className\":\"display text-[2rem]\",\"children\":[\"−\",\"0,47 млн. €\"]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"по-малко годишно за тази листа\"}]]}]]}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 space-y-1.5 text-[15px] max-w-3xl\",\"children\":[[\"$\",\"li\",null,{\"children\":\"Субсидията се плаща на всяка партия или коалиция в парламента, както и на партиите извън него с поне 1% от гласовете. Изчислява се по броя гласове на последните избори и се изплаща на четири вноски годишно.\"}],[\"$\",\"li\",null,{\"children\":[\"Намалението до 3 € на глас е прието с \",136,\" гласа „за“, \",11,\" „против“ и \",55,\" „въздържали се“. \",\"„За“: ПБ и ДПС. „Против“: Възраждане. „Въздържали се“: ГЕРБ, ДБ, ПП.\"]}],[\"$\",\"li\",null,{\"children\":\"Субсидията на коалиция се превежда на партиите в нея по споразумение помежду им. Как точно е разделена, се вижда от годишните им отчети.\"}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"За какво се харчи:\"}],\" всяка партия подава годишен финансов отчет в Сметната палата до 31 март на следващата година: приходи (субсидия, членски внос, дарения) и разходи (заплати, наеми, реклама, кампании). Отчетите за 2026 г. ще излязат до 31 март 2027 г. Предишните са в \",[\"$\",\"a\",null,{\"href\":\"https://gfopp.bulnao.government.bg/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"регистъра на Сметната палата\"}],\".\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-3\",\"children\":[\"Източници: \",[[\"$\",\"span\",\"https://www.standartnews.com/balgariya-politika/kray-horata-na-radev-otryazaha-parite-na-partiite-635904.html\",{\"children\":[false,[\"$\",\"a\",null,{\"href\"