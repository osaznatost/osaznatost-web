от 20% спрямо първата година\\\",\\\".\\\"]}]]}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-[#b08436]\\\",\\\"children\\\":\\\"Въздържал се\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}]]}]\\n43:[\\\"$\\\",\\\"tr\\\",\\\"darzhavniya-dalg\\\",{\\\"className\\\":\\\"border-b border-rule align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2 pr-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lb\\\",null,{\\\"href\\\":\\\"/parlament/zakon/darzhavniya-dalg\\\",\\\"children\\\":\\\"Закон за държавния дълг (облигации за граждани и правила на еврозоната)\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"block text-sm text-muted\\\",\\\"children\\\":[\\\"Законът привежда правилата за държавния дълг в съответствие с еврозоната: всички нови държавни ценни книжа над една година имат клаузи за колективно действие (общ механизъм при евентуално преструктуриране на дълга); законово се уреждат критериите за първичните дилъри\\\",\\\".\\\"]}]]}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}]]}]\\n44:[\\\"$\\\",\\\"tr\\\",\\\"deynostta-na-kolektivnite-investitsionni-shemi-i-na-drugi-predpriyatiya-za-kolektivno-investirane\\\",{\\\"className\\\":\\\"border-b border-rule align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2 pr-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lb\\\",null,{\\\"href\\\":\\\"/parlament/zakon/deynostta-na-kolektivnite-investitsionni-shemi-i-na-drugi-predpriyatiya-za-kolektivno-investirane\\\",\\\"children\\\":\\\"Закон за дейността на колективните инвестиционни схеми (фондове)\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"block text-sm text-muted\\\",\\\"children\\\":[\\\"Законът въвежда няко