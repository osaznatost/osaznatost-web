\\"]}]]}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}]]}]\\n40:[\\\"$\\\",\\\"tr\\\",\\\"chastnata-ohranitelna-deynost\\\",{\\\"className\\\":\\\"border-b border-rule align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2 pr-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lb\\\",null,{\\\"href\\\":\\\"/parlament/zakon/chastnata-ohranitelna-deynost\\\",\\\"children\\\":\\\"Закон за частната охранителна дейност\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"block text-sm text-muted\\\",\\\"children\\\":[\\\"Законът изравнява таксите за лицензи на български охранителни фирми и фирми от ЕС, обединява „охрана на недвижими имоти“ и „охрана на селскостопанско имущество“ в общата „охрана на имущество“, позволява фирма да възлага лична охрана на свой служител при реална заплаха, актуализира сумите при превоз на ценни пратки и отменя изискването трудовият договор на охранителя да е основен (за охрана на заведения, сезонни обекти и събития)\\\",\\\".\\\"]}]]}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}]]}]\\n41:[\\\"$\\\",\\\"tr\\\",\\\"darzhavniya-sluzhitel\\\",{\\\"className\\\":\\\"border-b border-rule align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2 pr-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lb\\\",null,{\\\"href\\\":\\\"/parlament/zakon/darzhavniya-sluzhitel\\\",\\\"children\\\":\\\"Закон за държавния служител (проверки за почтеност)\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"block text-sm text-muted\\\",\\\"children\\\":[\\\"Законът въвежда проверки на почтеността на служителите на длъжности с висок коруп