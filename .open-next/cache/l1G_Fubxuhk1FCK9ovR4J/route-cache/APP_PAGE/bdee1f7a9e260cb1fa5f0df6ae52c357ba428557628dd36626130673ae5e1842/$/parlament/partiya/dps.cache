top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2 pr-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lb\\\",null,{\\\"href\\\":\\\"/parlament/zakon/kodeks-za-zastrahovaneto\\\",\\\"children\\\":\\\"Кодекс за застраховането (Гаранционният фонд)\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"block text-sm text-muted\\\",\\\"children\\\":[\\\"Промените уреждат как се покрива недостиг на средства във фондовете на Гаранционния фонд (който плаща обезщетения при фалит на застраховател или при катастрофа с незастрахован автомобил): разграничават авансовите от допълнителните вноски на застрахователите, уреждат кога Обезпечителният фонд плаща задължения на Националното бюро на автомобилните застрахователи при отнет лиценз и позволяват споразумения с аналогични органи в други държави.\\\",\\\".\\\"]}]]}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}]]}]\\n48:[\\\"$\\\",\\\"tr\\\",\\\"elektronnata-identifikatsiya\\\",{\\\"className\\\":\\\"border-b border-rule align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2 pr-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lb\\\",null,{\\\"href\\\":\\\"/parlament/zakon/elektronnata-identifikatsiya\\\",\\\"children\\\":\\\"Закон за електронната идентификация (безплатна е-идентичност)\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"block text-sm text-muted\\\",\\\"children\\\":[\\\"Отпадат таксите за издаване на удостоверение за електронна идентичност и за проверката ѝ, когато услугата е от държавни органи или организации с обществени услуги\\\",\\\".\\\"]}]]}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-red\\\",\\\"children\\\":\\\"Против\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":