\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}]]}]\\n3c:[\\\"$\\\",\\\"tr\\\",\\\"chuzhdentsite-v-republika-balgariya\\\",{\\\"className\\\":\\\"border-b border-rule align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2 pr-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lb\\\",null,{\\\"href\\\":\\\"/parlament/zakon/chuzhdentsite-v-republika-balgariya\\\",\\\"children\\\":\\\"Закон за чужденците в Република България (единно разрешение за пребиваване и работа, сезонни работници, служебни паспорти)\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"block text-sm text-muted\\\",\\\"children\\\":[\\\"Правителственият законопроект въвежда в българското право европейските правила за единно разрешение за пребиваване и работа на граждани на трети държави и за проверка (скрининг) на външните граници\\\",\\\".\\\"]}]]}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-2 py-2 font-semibold text-green\\\",\\\"children\\\":\\\"За\\\"}]]}]\\n3d:[\\\"$\\\",\\\"tr\\\",\\\"energiyata-ot-vazobnovyaemi-iztochnitsi\\\",{\\\"className\\\":\\\"border-b border-rule align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2 pr-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lb\\\",null,{\\\"href\\\":\\\"/parlament/zakon/energiyata-ot-vazobnovyaemi-iztochnitsi\\\",\\\"children\\\":\\\"Закон за енергията от възобновяеми източници (два закона: юли и ноември 2026)\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"block text-sm text-muted\\\",\\\"children\\\":[\\\"Големият правителствен законопроект завършва въвеждането на европейската директива за възобновяемата енергия (2023/2413), чийто срок изтече на 21.05.2025 г.; срещу България вече има пр