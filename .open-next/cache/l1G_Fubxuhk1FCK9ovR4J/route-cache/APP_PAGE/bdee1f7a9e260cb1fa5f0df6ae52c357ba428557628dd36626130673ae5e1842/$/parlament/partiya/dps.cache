:[\"$\",\"tr\",\"kodeks-na-truda\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/kodeks-na-truda\",\"children\":\"Кодекс на труда (механизъм за минималната заплата)\"}],[\"$\",\"span\",null,{\"className\":\"block text-sm text-muted\",\"children\":[\"Промените, внесени от Министерския съвет, сменят начина, по който се определя минималната работна заплата\",\".\"]}]]}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-red\",\"children\":\"Против\"}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-red\",\"children\":\"Против\"}]]}]\n3b:[\"$\",\"tr\",\"izboren-kodeks\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/izboren-kodeks\",\"children\":\"Изборен кодекс (машинно гласуване и секции в чужбина, юли 2026)\"}],[\"$\",\"span\",null,{\"className\":\"block text-sm text-muted\",\"children\":[\"Промените са приети няколко месеца преди президентските избори\",\".\"]}]]}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}],[\"$\",\"td\",null,{\"className\":\"px-2 py-2 font-semibold text-green\",\"children\":\"За\"}]]}]\n3c:[\"$\",\"tr\",\"chuzhdentsite-v-republika-balgariya\",{\"className\":\"border-b border-rule align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 pr-3\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/parlament/zakon/chuzhdentsite-v-republika-balgariya\",\"children\":\"Закон за чужденците в Република България (единно разрешение за пребиваване и работа, сезонни работници, служебни паспорти)\"}],[\"$\",\"span\",null,{\"className\":\"block text-sm text-muted\",\"children\":[\"Правителственият законопроект въвежда в българското право европейските правила за единно разрешение за пребиваване и работа на граждани на трети дъ