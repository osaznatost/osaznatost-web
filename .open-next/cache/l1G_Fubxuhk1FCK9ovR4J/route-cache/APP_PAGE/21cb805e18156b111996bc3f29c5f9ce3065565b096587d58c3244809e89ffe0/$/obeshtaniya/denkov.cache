а реакторите.\"}],\"$undefined\",[\"$\",\"details\",null,{\"className\":\"mt-3 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer text-sm font-semibold text-green\",\"children\":[\"Как се стигна дотук (\",3,\" стъпки)\"]}],[\"$\",\"ol\",null,{\"className\":\"mt-3 border-l-2 border-rule pl-4 space-y-3\",\"children\":[[\"$\",\"li\",\"юли 2023Парламентът възлага преговори за продажба на Украйна.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"юли 2023\"}],[\"$\",\"p\",null,{\"children\":[\"Парламентът възлага преговори за продажба на Украйна.\",\"$undefined\"]}]]}],[\"$\",\"li\",\"март 2024Правителството „Денков“ подава оставка без сключена сделка.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"март 2024\"}],[\"$\",\"p\",null,{\"children\":[\"Правителството „Денков“ подава оставка без сключена сделка.\",\"$undefined\"]}]]}],[\"$\",\"li\",\"април 2025Новата коалиция решава да не продава реакторите.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"април 2025\"}],[\"$\",\"p\",null,{\"children\":[\"Новата коалиция решава да не продава реакторите.\",\"$undefined\"]}]]}]]}]]}],null,\"$undefined\",[\"$\",\"p\",null,{\"className\":\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[\"$\",\"a\",\"https://www.capital.bg/biznes/energetika/2023/07/06/4504402_parlamentut_odobri_prodajbata_na_reaktorite_za_belene/\",{\"href\":\"https://www.capital.bg/biznes/energetika/2