 mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[\"$\",\"a\",\"https://en.bia-bg.com/news/view/32956/\",{\"href\":\"https://en.bia-bg.com/news/view/32956/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БИА: НОИ решава +11% от 1 юли\"}],[\"$\",\"a\",\"https://bta.bg/en/news/697669-pm-income-of-about-2-mln-pensioners-will-increase-by-11-from-july-1\",{\"href\":\"https://bta.bg/en/news/697669-pm-income-of-about-2-mln-pensioners-will-increase-by-11-from-july-1\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: пенсиите на около 2 млн. души растат с 11%\"}]]}]\n34:[\"$\",\"a\",\"https://www.novinite.com/articles/231858/Bulgaria+Halts+Sale+of+Nuclear+Reactors+to+Ukraine+Over+Energy+Security+Concerns\",{\"href\":\"https://www.novinite.com/articles/231858/Bulgaria+Halts+Sale+of+Nuclear+Reactors+to+Ukraine+Over+Energy+Security+Concerns\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Novinite: България спира продажбата (април 2025)\"}]\n35:[\"$\",\"li\",\"8\",{\"id\":\"p8\",\"className\":\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start justify-between gap-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Енергетика\"}],[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\",\"style\":{\"background\":\"#2f9e6a\",\"color\":\"#fff\"},\"children\":\"Изпълнено\"}]]}],[\"$\",\"p\",null,{\"className\":\"display text-[1.7rem] mt-2\",\"children\":\"Нефтохим да спре да преработва руски петрол\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mt-1\",\"children\":[\"Обещал: \",[\"$\",\"a\",null,{\"href\":\"https://new.bnr.bg/en/post/101908905/national-assembly-rejects-abolition-of-derogation-for-import-of-russian-oil\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"Николай Денков\",\", \",\"октомври 2023\"]}]]}],[\"$\