www.aljazeera.com/news/2025/12/11/bulgarian-government-resigns-after-mass-protests\",{\"href\":\"https://www.aljazeera.com/news/2025/12/11/bulgarian-government-resigns-after-mass-protests\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Al Jazeera: правителството подава оставка (11.12.2025)\"}],[\"$\",\"$L9\",\"/parlament/zakon/darzhavniya-byudzhet-na-republika-balgariya-za-2026-g\",{\"href\":\"/parlament/zakon/darzhavniya-byudzhet-na-republika-balgariya-za-2026-g\",\"children\":\"Бюджетът за 2026 г.: гласувания и двете страни\"}]]}]]}]\n37:[\"$\",\"a\",\"https://arynews.tv/bulgaria-faces-political-turmoil-and-resignation\",{\"href\":\"https://arynews.tv/bulgaria-faces-political-turmoil-and-resignation\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Reuters (чрез ARY): оттегленият бюджет за 2026 г.\"}]\n38:[\"$\",\"a\",\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2025/12/02/4859422_purva_reakciia_ot_pravitelstvoto_sled_protesta/\",{\"href\":\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2025/12/02/4859422_purva_reakciia_ot_pravitelstvoto_sled_protesta/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Капитал: „Оттегляме бюджета“\"}]\n39:[\"$\",\"li\",\"3\",{\"id\":\"p3\",\"className\":\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start justify-between gap-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Данъци\"}],[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\",\"style\":{\"background\":\"#e2b33b\",\"color\":\"#16201b\"},\"children\":\"Частично изпълнено\"}]]}],[\"$\",\"p\",null,{\"className\":\"display text-[1.7rem] mt-2\",\"children\":\"Без увеличаване на данъчната и осигурителната тежест\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mt-1\",\"children\":[\"Обещал: \",[\"$\",\"a\",null,{\"href\":\"https://www.bta.bg/bg/videos/25710\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"Росен Желязков\",\", \",\"февруари 2025 (управленската програма)\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-3\",\"children\":\"През мандата не е вдигнат данък или осигуровка. Но първият проект на Бюджет 2026 (ноември 2025) предвиждаше пенсионната вноска да се вдигне с 2 пункта и данъкът върху дивидента от 5 на 10%. След масовите протести правителството оттегли проекта на 2 декември 2025 г. В новия проект вдигането на осигуровките е отложено с година, а максималният осигурителен доход е вдигнат с 9% до 2300 €. На 11 декември 2025 г. правителството подаде оставка, преди бюджетът да бъде приет.\"}],\"$undefined\",[\"$\",\"details\",null,{\"className\":\"mt-3 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer text-sm font-semibold text-green\",\"children\":[\"Как се стигна дотук (\",4,\" стъпки)\"]}],[\"$\",\"ol\",null,{\"className\":\"mt-3 border-l-2 border-rule pl-4 space-y-3\",\"children\":[[\"$\",\"li\",\"февруари 2025Програмата обещава доходи, „съобразени с политиката по неувеличаване на данъчната и осигурителната тежест“.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"февруари 2025\"}],[\"$\",\"p\",null,{\"children\":[\"Програмата обещава доходи, „съобразени с политиката по неувеличаване на данъчната и осигурителната тежест“.\",[\" \",[\"$\",\"a\",null,{\"href\":\"https://www.bta.bg/bg/videos/25710\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Източник\"}]]]}]]}],[\"$\",\"li\",\"ноември 2025Проектът на Бюджет 2026: +2 пункта пенсионна вноска, дивидентен данък 10%.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"ноември 2025\"}],[\"$\",\"p\",null,{\"children\":[\"Проектът на Бюджет 2026: +2 пункта пенсионна вноска, дивидентен данък 10%.\",[\" \",[\"$\",\"a\",null,{\"href\":\"https://bntnews.bg/news/budget-2026-parameters-draw-sharp-criticism-from-opposition-unions-and-employers-1363586news.html\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Източник\"}]]]}]]}],[\"$\",\"li\",\"2 декември 2025След протестите проектът е оттеглен.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"2 декември 2025\"}],[\"$\",\"p\",null,{\"children\":[\"След протестите проектът е оттеглен.\",[\" \",[\"$\",\"a\",null,{\"href\":\"https://www.bta.bg/bg/videos/32871\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Източник\"}]]]}]]}],[\"$\",\"li\",\"11 декември 2025Правителството подава оставка.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"11 декември 2025\"}],[\"$\",\"p\",null,{\"children\":[\"Правителството подава оставка.\",[\" \",[\"$\",\"a\",null,{\"href\":\"https://www.capital.bg/biznes-zakuska/2025/12/12/4863718__biznes_zakuska_pravitelstvoto_padna_kakvo_sledva/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Източник\"}]]]}]]}]]}]]}],null,\"$undefined\",\"$L40\"]}]\n3a:[\"$\",\"a\",\"https://www.bta.bg/en/news/918175-after-nato-summit-pm-zhelyazkov-reaffirms-bulgaria-s-commitment-to-increasing-d\",{\"href\":\"https://www.bta.bg/en/news/918175-after-nato-summit-pm-zhelyazkov-reaffirms-bulgaria-s-commitment-to-increasing-d\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: Желязков потвърждава целта от 5% до 2035 г.\"}]\n3b:[\"$\",\"p\",null,{\"children\":[\"САЩ и Великобритания издават временни лицензи; рафинерията продължава да работи след 21 ноември.\",\"$undefined\"]}]\n3c:[\"$\",\"p\",null,{\"className\":\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[\"$\",\"a\",\"https://bnrnews.bg/en/post/387426/parliament-adopts-the-amendments-regarding-lukoil-s-special-manager\",{\"href\":\"https://bnrnews.bg/en/post/387426/parliament-adopts-the-amendments-regarding-lukoil-s-special-manager\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БНР: приети промени за особения управител (7.11.2025)\"}],[\"$\",\"a\",\"https://www.intellinews.com/bulgaria-s-parliament-overturns-president-s-veto-on-lukoil-refinery-law-411366\",{\"href\":\"https://www.intellinews.com/bulgaria-s-parliament-overturns-president-s-veto-on-lukoil-refinery-law-411366\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"bne IntelliNews: ветото е отхвърлено (13.11.2025)\"}],[\"$\",\"a\",\"https://bntnews.bg/news/rumen-spetsov-appointed-special-commercial-administrator-of-the-lukoil-group-companies-in-bulgaria-1365153news.html\",{\"href\":\"https://bntnews.bg/news/rumen-spetsov-appointed-special-commercial-administrator-of-the-lukoil-group-companies-in-bulgaria-1365153news.html\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БНТ: назначен е особен управител\"}],[\"$\",\"a\",\"https://www.bta.bg/en/news/economy/1008977-us-treasury-issues-licence-allowing-transactions-with-certain-lukoil-entities-in\",{\"href\":\"https://www.bta.bg/en/news/economy/1008977-us-treasury-issues-licence-allowing-transactions-with-certain-lukoil-entities-in\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: лиценз от OFAC за българските дружества на Лукойл (до 29.04.2026)\"}]]}]\n3e:null\n34:true\nc:C\n40:[\"$\",\"p\",null,{\"className\":\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[\"$\",\"a\",\"https://bntne