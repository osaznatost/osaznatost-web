ldren\":[\"Обещал: \",[\"$\",\"a\",null,{\"href\":\"https://www.bta.bg/en/news//174130-Prime-Minister-Borissov-Increasing-Retirement-Age-Is-Non-negotiable\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"Бойко Борисов\",\", \",\"13 май 2015\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-3\",\"children\":\"На 28 юли 2015 г. парламентът прие реформата. Възрастта за пенсия расте постепенно от 2016 г. до 65 години за мъжете и жените. Осигурителните вноски се увеличават, а ранното пенсиониране на военни и полицаи се ограничава.\"}],\"$undefined\",[\"$\",\"details\",null,{\"className\":\"mt-3 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer text-sm font-semibold text-green\",\"children\":[\"Как се стигна дотук (\",3,\" стъпки)\"]}],[\"$\",\"ol\",null,{\"className\":\"mt-3 border-l-2 border-rule pl-4 space-y-3\",\"children\":[[\"$\",\"li\",\"декември 2014Правителството и синдикатите се договарят възрастта да не се променя през 2015 г.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"декември 2014\"}],[\"$\",\"p\",null,{\"children\":[\"Правителството и синдикатите се договарят възрастта да не се променя през 2015 г.\",\"$undefined\"]}]]}],[\"$\",\"li\",\"13 май 2015Борисов: вдигането на възрастта не подлежи на преговори.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"13 май 2015\"}],[\"$\",\"p\",null,{\"children\":[\"Борисов: вдигането на възрастта не подлежи на преговори.\",\"$undefined\"]}]]}],[\"$\",\"li\",\"28 юли 2015Парламентът приема реформата.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":