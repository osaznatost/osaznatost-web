ttps://www.capital.bg/politika_i_ikonomika/bulgaria/2015/12/08/2665755_kompromisut_na_statukvoto/\",{\"href\":\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2015/12/08/2665755_kompromisut_na_statukvoto/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Капитал: „Компромисът на статуквото“ (08.12.2015)\"}]\n28:[\"$\",\"a\",\"https://sofiaglobe.com/?p=48409\",{\"href\":\"https://sofiaglobe.com/?p=48409\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Sofia Globe: министърът на правосъдието подава оставка (09.12.2015)\"}]\n29:[\"$\",\"a\",\"https://archive.rai-see.org/?p=7681\",{\"href\":\"https://archive.rai-see.org/?p=7681\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"RAI: България приема промените в Конституцията (16.12.2015)\"}]\n2a:[\"$\",\"li\",\"9\",{\"id\":\"p9\",\"className\":\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start justify-between gap-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm text-muted\",\"children\":\"Правосъдие\"}],[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\",\"style\":{\"background\":\"#e2b33b\",\"color\":\"#16201b\"},\"children\":\"Частично изпълнено\"}]]}],[\"$\",\"p\",null,{\"className\":\"display text-[1.7rem] mt-2\",\"children\":\"Съдебна реформа: разделяне на ВСС на съдийска и прокурорска колегия\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mt-1\",\"children\":[\"Обещал: \",[\"$\",\"a\",null,{\"href\":\"https://constitutionnet.org/node/14059\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"Правителството „Борисов 2“ (министър на правосъдието Христо Иванов)\",\", \",\"2015\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-3\",\"children\":\"Конституцията беше променена окончателно на 16 декември 2015 г. ВСС беше разделен на две колегии. На второ четене (9 декември) обаче парламентът промени съществено първоначалния текст за състава на колегиите. Министър Христо Иванов подаде оставка, а съпредседателят на Реформаторския блок Радан Кънев оттегли подкрепата си за правителството.\"}],\"$undefined\",[\"$\",\"details\",null,{\"className\":\"mt-3 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer text-sm font-semibold text-green\",\"children\":[\"Как се стигна дотук (\",4,\" стъпки)\"]}],[\"$\",\"ol\",null,{\"className\":\"mt-3 border-l-2 border-rule pl-4 space-y-3\",\"children\":[[\"$\",\"li\",\"юли 2015Събрани са 180 подписа за промени в Конституцията.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"юли 2015\"}],[\"$\",\"p\",null,{\"children\":[\"Събрани са 180 подписа за промени в Конституцията.\",\"$undefined\"]}]]}],[\"$\",\"li\",\"23 септември 2015Първо четене (184 гласа „за“).\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"23 септември 2015\"}],[\"$\",\"p\",null,{\"children\":[\"Първо четене (184 гласа „за“).\",\"$undefined\"]}]]}],[\"$\",\"li\",\"9 декември 2015Второ четене с променени текстове; Христо Иванов подава оставка.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"9 декември 2015\"}],[\"$\",\"p\",null,{\"children\":[\"Второ четене с променени текстове; Христо Иванов подава оставка.\",\"$undefined\"]}]]}],[\"$\",\"li\",\"16 декември 2015Окончателно приемане.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{