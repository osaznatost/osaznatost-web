{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/obeshtaniya/layout,_N_T_/obeshtaniya/[gov]/layout,_N_T_/obeshtaniya/[gov]/page,_N_T_/obeshtaniya/borisov-2"},"segmentPaths":["/_tree","/_full","/obeshtaniya/$d$gov/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/21cb805e18156b111996bc3f29c5f9ce3065565b096587d58c3244809e89ffe0/$/obeshtaniya/borisov-2","owner":{"kind":"APP_PAGE","sourceRoute":"/obeshtaniya/[gov]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2bx3suebn7wim.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><title>Обещания: Правителство „Борисов 2“ (ГЕРБ и Реформаторски блок) · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Обещания: Правителство „Борисов 2“ (ГЕРБ и Реформаторски блок) · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Обещания: Правителство „Борисов 2“ (ГЕРБ и Реформаторски блок) · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/obeshtaniya\">← <!-- -->Обещания</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">7 ноември 2014 – 27 януари 2017</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Правителство „Борисов 2“ (ГЕРБ и Реформаторски блок)</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Коалиция на ГЕРБ и Реформаторския блок, с подкрепата на Патриотичния фронт и АБВ. Подаде оставка след президентските избори през ноември 2016 г.</div></div></div><nav class=\"flex flex-wrap gap-2 mb-8\" aria-label=\"Други правителства\"><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/radev\">Прогресивна България</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/zhelyazkov\">Правителство „Желязков“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/denkov\">Правителство „Денков“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/petkov\">Правителство „Петков“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/borisov-3\">Правителство „Борисов 3“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-green text-white\" href=\"/obeshtaniya/borisov-2\">Правителство „Борисов 2“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/oresharski\">Правителство „Орешарски“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/borisov-1\">Правителство „Борисов 1“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/sluzhebno-gyurov\">Служебно правителство „Гюров“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/sluzhebno-glavchev\">Служебни правителства „Главчев“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/sluzhebno-donev\">Служебни правителства „Донев“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/sluzhebno-yanev\">Служебни правителства „Янев“</a></nav><section class=\"bg-surface rounded-sm p-5 mb-8\"><div class=\"flex h-4 rounded-full overflow-hidden\"><div style=\"width:40%;background:#2f9e6a\"></div><div style=\"width:30%;background:#e2b33b\"></div><div style=\"width:30%;background:#d2353f\"></div></div><p class=\"flex flex-wrap gap-x-5 gap-y-1 mt-3 text-sm\"><span class=\"inline-flex items-center gap-1.5\"><span class=\"inline-block w-3 h-3 rounded-full\" style=\"background:#2f9e6a\"></span>Изпълнено<!-- -->: <b class=\"num\">4</b></span><span class=\"inline-flex items-center gap-1.5\"><span class=\"inline-block w-3 h-3 rounded-full\" style=\"background:#e2b33b\"></span>Частично изпълнено<!-- -->: <b class=\"num\">3</b></span><span class=\"inline-flex items-center gap-1.5\"><span class=\"inline-block w-3 h-3 rounded-full\" style=\"background:#d2353f\"></span>Не е изпълнено<!-- -->: <b class=\"num\">3</b></span></p><p class=\"text-sm text-muted mt-3\">Проследяваме <!-- -->10<!-- --> обещания, избрани заради това, че могат да се измерят. Това не са всички обещания и съотношението не е оценка за цялото управление.</p></section><nav class=\"flex flex-wrap gap-x-4 gap-y-1 text-[15px] mb-8\" aria-label=\"Теми\"><span class=\"text-muted\">Теми:</span><a href=\"#t-Бюджет\">Бюджет<!-- --> (<!-- -->1<!-- -->)</a><a href=\"#t-Здраве\">Здраве<!-- --> (<!-- -->1<!-- -->)</a><a href=\"#t-Инфраструктура\">Инфраструктура<!-- --> (<!-- -->2<!-- -->)</a><a href=\"#t-Правосъдие\">Правосъдие<!-- --> (<!-- -->2<!-- -->)</a><a href=\"#t-Сигурност\">Сигурност<!-- --> (<!-- -->1<!-- -->)</a><a href=\"#t-Доходи\">Доходи<!-- --> (<!-- -->2<!-- -->)</a><a href=\"#t-Електронно управление\">Електронно управление<!-- --> (<!-- -->1<!-- -->)</a></nav><section id=\"t-Бюджет\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Бюджет</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p0\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Бюджет</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#2f9e6a;color:#fff\">Изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Бюджетен дефицит до 3% от БВП през 2015 г., 2,5% през 2016 г. и 2% през 2017 г.</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://beta.strategy.bg/index.php/download/1157907\" target=\"_blank\" rel=\"noreferrer\">Министерският съвет, актуализирана средносрочна прогноза<!-- -->, <!-- -->1 декември 2014</a></p><p class=\"text-[15px] mt-3\">Целите са изпълнени с резерв. По данните на Евростат (методологията на ЕС) дефицитът е 1,9% от БВП през 2015 г., а през 2016 г. бюджетът е на излишък от 0,3%. През 2014 г. дефицитът е бил 5,4% (включително изплащането на гарантираните влогове в КТБ).</p><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"/statistiki/deficit\">Дефицит и дълг по години</a></p></li></ul></section><section id=\"t-Здраве\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Здраве</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p1\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Здраве</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#d2353f;color:#fff\">Не е изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Допълнителен пакет здравни услуги, покриван от здравния фонд, от 2016 г.</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2016/12/09/2879142_obeshtaniiata_na_petur_moskov/\" target=\"_blank\" rel=\"noreferrer\">Министърът на здравеопазването Петър Москов<!-- -->, <!-- -->2015</a></p><p class=\"text-[15px] mt-3\">Към края на мандата няма внесен проект за такъв пакет (Капитал, декември 2016 г.).</p><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2016/12/09/2879142_obeshtaniiata_na_petur_moskov/\" target=\"_blank\" rel=\"noreferrer\">Капитал: обещанията на Петър Москов</a></p></li></ul></section><section id=\"t-Инфраструктура\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Инфраструктура</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p2\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Инфраструктура</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#d2353f;color:#fff\">Не е изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Без поскъпване на винетката през този мандат</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2015/11/11/2647123_vinetkite_poskupvat_sredno_s_30-50_obnovena/\" target=\"_blank\" rel=\"noreferrer\">Лиляна Павлова, министър на регионалното развитие<!-- -->, <!-- -->април 2015</a></p><p class=\"text-[15px] mt-3\">На 11 ноември 2015 г. правителството вдигна годишната винетка за лек автомобил от 67 на 97 лв. от 10 декември 2015 г., месечната и седмичната също поскъпнаха.</p><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://www.capital.bg/kakvo_stava/2015/11/11/2647047_godishnata_vinetka_stava_97_leva/\" target=\"_blank\" rel=\"noreferrer\">Капитал: Годишната винетка става 97 лева (11.11.2015)</a></p></li><li id=\"p3\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Инфраструктура</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#d2353f;color:#fff\">Не е изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Тол система за камионите (таксуване по изминат път) от 2017 г.</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.capital.bg/kakvo_stava/2015/11/11/2647047_godishnata_vinetka_stava_97_leva/\" target=\"_blank\" rel=\"noreferrer\">Министерство на регионалното развитие и благоустройството<!-- -->, <!-- -->ноември 2015</a></p><p class=\"text-[15px] mt-3\">Поръчката е обявена през април 2016 г. и многократно спирана. Тол системата заработва чак на 1 март 2020 г., при следващото правителство на Борисов, след две отлагания.</p><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2017/05/26/2977861_den_za_200_mln_lv/\" target=\"_blank\" rel=\"noreferrer\">Капитал: Ден за 200 млн. лв. (26.05.2017, хронология на поръчката)</a><a href=\"https://bntnews.bg/news/pm-borissov-ministers-met-carriers-over-demands-for-the-toll-system-1310746news.html\" target=\"_blank\" rel=\"noreferrer\">БНТ: среща с превозвачите преди старта на тол системата (февруари 2020)</a></p></li></ul></section><section id=\"t-Правосъдие\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Правосъдие</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p4\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Правосъдие</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#e2b33b;color:#16201b\">Частично изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Конституционна реформа на съдебната власт: ВСС на две колегии, по-малко влияние на прокуратурата</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2015/05/26/2541234_upravliavashtite_vnesoha_proekta_za_promeni_v/\" target=\"_blank\" rel=\"noreferrer\">Управляващата коалиция (проект, внесен от 132 депутати; министър Христо Иванов)<!-- -->, <!-- -->май 2015</a></p><p class=\"text-[15px] mt-3\">Промените в Конституцията бяха приети на 16 декември 2015 г.: ВСС е разделен на съдийска и прокурорска колегия. Но на второ четене текстовете бяха значително променени спрямо първото четене и правосъдният министър Христо Иванов подаде оставка на 9 декември 2015 г. в знак на протест. Анализатори определиха резултата като „компромис на статуквото“.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->3<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">26 май 2015</span><p>132 депутати внасят проекта за промени в Конституцията.<!-- --> <a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2015/05/26/2541234_upravliavashtite_vnesoha_proekta_za_promeni_v/\" target=\"_blank\" rel=\"noreferrer\">Източник</a></p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">9 декември 2015</span><p>Второ четене с променени текстове; Христо Иванов подава оставка.<!-- --> <a href=\"https://sofiaglobe.com/?p=48409\" target=\"_blank\" rel=\"noreferrer\">Източник</a></p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">16 декември 2015</span><p>Окончателно приемане: ВСС с две колегии.<!-- --> <a href=\"https://archive.rai-see.org/?p=7681\" target=\"_blank\" rel=\"noreferrer\">Източник</a></p></li></ol></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2015/05/26/2541234_upravliavashtite_vnesoha_proekta_za_promeni_v/\" target=\"_blank\" rel=\"noreferrer\">Капитал: управляващите внесоха проекта (26.05.2015)</a><a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2015/12/08/2665755_kompromisut_na_statukvoto/\" target=\"_blank\" rel=\"noreferrer\">Капитал: „Компромисът на статуквото“ (08.12.2015)</a><a href=\"https://sofiaglobe.com/?p=48409\" target=\"_blank\" rel=\"noreferrer\">Sofia Globe: министърът на правосъдието подава оставка (09.12.2015)</a><a href=\"https://archive.rai-see.org/?p=7681\" target=\"_blank\" rel=\"noreferrer\">RAI: България приема промените в Конституцията (16.12.2015)</a></p></li><li id=\"p9\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Правосъдие</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#e2b33b;color:#16201b\">Частично изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Съдебна реформа: разделяне на ВСС на съдийска и прокурорска колегия</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://constitutionnet.org/node/14059\" target=\"_blank\" rel=\"noreferrer\">Правителството „Борисов 2“ (министър на правосъдието Христо Иванов)<!-- -->, <!-- -->2015</a></p><p class=\"text-[15px] mt-3\">Конституцията беше променена окончателно на 16 декември 2015 г. ВСС беше разделен на две колегии. На второ четене (9 декември) обаче парламентът промени съществено първоначалния текст за състава на колегиите. Министър Христо Иванов подаде оставка, а съпредседателят на Реформаторския блок Радан Кънев оттегли подкрепата си за правителството.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->4<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">юли 2015</span><p>Събрани са 180 подписа за промени в Конституцията.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">23 септември 2015</span><p>Първо четене (184 гласа „за“).</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">9 декември 2015</span><p>Второ четене с променени текстове; Христо Иванов подава оставка.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">16 декември 2015</span><p>Окончателно приемане.</p></li></ol></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://bntnews.bg/news/bulgaria’s-parliament-passed-the-constitutional-amendments-at-third-reading-1315469news.html\" target=\"_blank\" rel=\"noreferrer\">БНТ: промените са приети на трето четене (16.12.2015)</a><a href=\"https://www.intellinews.com/bulgarian-justice-minister-resigns-after-parliament-adopts-revised-constitutional-amendments-86226/\" target=\"_blank\" rel=\"noreferrer\">bne IntelliNews: оставката на Христо Иванов</a><a href=\"https://old.parliament.bg/pub/ECD/210332COM_2016_40_EN_ACTE_f.docx\" target=\"_blank\" rel=\"noreferrer\">Доклад на ЕК по МСП (2016)</a></p></li></ul></section><section id=\"t-Сигурност\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Сигурност</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p5\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Сигурност</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#2f9e6a;color:#fff\">Изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Удължаване на оградата по границата с Турция с 82 км (около 90 млн. лв.)</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.hurriyetdailynews.com/amp/bulgaria-to-extend-border-fence-against-migrant-influx--76960\" target=\"_blank\" rel=\"noreferrer\">Бойко Борисов пред парламента<!-- -->, <!-- -->14 януари 2015</a></p><p class=\"text-[15px] mt-3\">Оградата беше удължена на няколко етапа и завършена през 2017 г. с обща дължина около 200 км. Част от финансирането беше без обществена поръчка заради спешността. Правителствен инспекторат установи, че на места е построена ограда с един слой вместо с два.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->3<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">14 януари 2015</span><p>Борисов обявява удължаване с 82 км.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">юни 2016</span><p>Още 44 млн. лв. за 61 км.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">2017</span><p>Оградата е завършена (около 200 км).</p></li></ol></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://sofiaglobe.com/?p=52983\" target=\"_blank\" rel=\"noreferrer\">Sofia Globe: още 44 млн. лв. за 61 км (2016)</a><a href=\"https://sofiaglobe.com/?p=35439\" target=\"_blank\" rel=\"noreferrer\">Sofia Globe: оградата е завършена</a><a href=\"https://www.bta.bg/en/news/124863-Socialists-Ask-Law-Enforcers-to-Probe-Construction-of-Border-Fence\" target=\"_blank\" rel=\"noreferrer\">БТА: БСП иска проверка на строителството</a></p></li></ul></section><section id=\"t-Доходи\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Доходи</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p6\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Доходи</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#2f9e6a;color:#fff\">Изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Пенсионна реформа с постепенно увеличаване на възрастта за пенсия</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.bta.bg/en/news//174130-Prime-Minister-Borissov-Increasing-Retirement-Age-Is-Non-negotiable\" target=\"_blank\" rel=\"noreferrer\">Бойко Борисов<!-- -->, <!-- -->13 май 2015</a></p><p class=\"text-[15px] mt-3\">На 28 юли 2015 г. парламентът прие реформата. Възрастта за пенсия расте постепенно от 2016 г. до 65 години за мъжете и жените. Осигурителните вноски се увеличават, а ранното пенсиониране на военни и полицаи се ограничава.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->3<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">декември 2014</span><p>Правителството и синдикатите се договарят възрастта да не се променя през 2015 г.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">13 май 2015</span><p>Борисов: вдигането на възрастта не подлежи на преговори.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">28 юли 2015</span><p>Парламентът приема реформата.</p></li></ol></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://m.novinite.com/view_news.php?id=170106\" target=\"_blank\" rel=\"noreferrer\">Novinite: реформата е приета на второ четене</a><a href=\"https://www.ssa.gov/policy/docs/progdesc/intl_update/2015-08/index.html\" target=\"_blank\" rel=\"noreferrer\">SSA (САЩ): обобщение на реформата</a></p></li><li id=\"p7\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Доходи</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#2f9e6a;color:#fff\">Изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Минимална заплата 380 лв. от 1 юли 2015 г.</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://new.bnr.bg/en/post/100565198/bulgarian-government-raises-minimum-wage-despite-obstacles\" target=\"_blank\" rel=\"noreferrer\">Министерският съвет<!-- -->, <!-- -->декември 2014</a></p><p class=\"text-[15px] mt-3\">Правителството потвърди решението и минималната заплата стана 380 лв. (около 190 €) от 1 юли 2015 г. След това беше вдигната на 420 лв. от 1 януари 2016 г. и на 460 лв. от 1 януари 2017 г.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->3<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">декември 2014</span><p>Решение за увеличение от 1 юли 2015 г.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">1 юли 2015</span><p>380 лв.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">1 януари 2016</span><p>420 лв.</p></li></ol></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://bta.bg/en/news/160048-Minimum-Monthly-Wage-Rises-to-Lv-420-as-of-January-1\" target=\"_blank\" rel=\"noreferrer\">БТА: 420 лв. от 1 януари 2016 г.</a><a href=\"https://www.bta.bg/en/news/136224-Minimum-Monthly-Wage-Set-at-Lv-460-for-2017\" target=\"_blank\" rel=\"noreferrer\">БТА: 460 лв. от 2017 г.</a></p></li></ul></section><section id=\"t-Електронно управление\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Електронно управление</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p8\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Електронно управление</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#e2b33b;color:#16201b\">Частично изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Закон за електронната идентификация</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.mtc.government.bg/archive/en/text/page.php@category=92&amp;id=8958.html\" target=\"_blank\" rel=\"noreferrer\">Министерството на транспорта и съобщенията (зам.-министър Валери Борисов)<!-- -->, <!-- -->2015</a></p><p class=\"text-[15px] mt-3\">Парламентът прие закона на второ четене на 11 май 2016 г. Спорът дали в личните карти да има чип за електронна идентичност се реши с отделни промени в Закона за българските лични документи.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->3<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">март 2015</span><p>Проектът е обявен за обществено обсъждане.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">март 2016</span><p>Спор между ГЕРБ и Реформаторския блок за чиповете.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">11 май 2016</span><p>Законът е приет окончателно.</p></li></ol></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://bntnews.bg/news/bulgaria’s-parliament-adopts-law-on-electronic-identification-1315251news.html\" target=\"_blank\" rel=\"noreferrer\">БНТ: парламентът приема закона (11.5.2016)</a><a href=\"https://www.bta.bg/en/news/155511-Reformist-Bloc-GERB-Disagree-on-Draft-Provisions-for-Introduction-of-Electronic\" target=\"_blank\" rel=\"noreferrer\">БТА: спорът за чиповете в личните карти</a></p></li></ul></section><p class=\"text-xs text-muted mt-4\">Програми: <span><a href=\"https://beta.strategy.bg/index.php/download/1157907\" target=\"_blank\" rel=\"noreferrer\">Протокол от заседание на Министерския съвет, 1 декември 2014 (фискални цели)</a></span>. Проверено: <!-- -->2026-11-19</p><p class=\"text-[15px] mt-6\">Сравни с: <span><a href=\"/obeshtaniya/radev\">Прогресивна България</a></span><span>, <a href=\"/obeshtaniya/zhelyazkov\">Правителство „Желязков“</a></span><span>, <a href=\"/obeshtaniya/denkov\">Правителство „Денков“</a></span><span>, <a href=\"/obeshtaniya/petkov\">Правителство „Петков“</a></span><span>, <a href=\"/obeshtaniya/borisov-3\">Правителство „Борисов 3“</a></span><span>, <a href=\"/obeshtaniya/oresharski\">Правителство „Орешарски“</a></span><span>, <a href=\"/obeshtaniya/borisov-1\">Правителство „Борисов 1“</a></span><span>, <a href=\"/obeshtaniya/sluzhebno-gyurov\">Служебно правителство „Гюров“</a></span><span>, <a href=\"/obeshtaniya/sluzhebno-glavchev\">Служебни правителства „Главчев“</a></span><span>, <a href=\"/obeshtaniya/sluzhebno-donev\">Служебни правителства „Донев“</a></span><span>, <a href=\"/obeshtaniya/sluzhebno-yanev\">Служебни правителства „Янев“</a></span>.</p></div><!--$--><!--/$--></main><!--$--><!--/$--><footer class=\"bg-surface border-t border-rule mt-20\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 text-sm text-muted grid gap-2 sm:grid-cols-2\"><p>Не подкрепяме партия, кандидат или правителство. Всяко число има източник и дата.<!-- --> <a href=\"/metodologiya\">Как работим</a> · <a href=\"/rechnik\">Речник</a> · <a href=\"/sastoyanie\">Състояние на данните</a> · <!--$?--><template id=\"B:1\"></template><a href=\"/metodologiya#greshki\">Съобщи за грешка</a><!--/$--></p><p class=\"sm:text-right\">Вътрешен прототип · данните са към датите, посочени до тях</p></div></footer><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script id=\"_R_\">(globalThis[\"TURBOPACK\"] || (globalThis[\"TURBOPACK\"] = [])).push({\"otherChunks\":[\"static/chunks/310vm2bl3xxpt.js\",\"static/chunks/2vy51v46dlsq-.js\",\"static/chunks/2bx7ggprk0oi5.js\",\"static/chunks/0c1ad7rcpjghx.js\"],\"runtimeModuleIds\":[94553]});</script><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" async=\"\"></script><div hidden id=\"S:0\"><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" aria-current=\"page\" class=\"no-underline pb-1 border-b-2 text-white border-red\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 