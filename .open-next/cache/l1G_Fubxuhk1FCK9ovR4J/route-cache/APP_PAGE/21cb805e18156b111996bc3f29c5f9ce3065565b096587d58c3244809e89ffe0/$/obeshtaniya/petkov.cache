1\",\"children\":[\"Обещал: \",[\"$\",\"a\",null,{\"href\":\"https://www.rferl.org/a/bulgaria-petkov-new-government/31604680.html\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"Кирил Петков\",\", \",\"11 декември 2021\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-3\",\"children\":\"По време на мандата (декември 2021 – юни 2022) комисията не беше реформирана. Законът, който я разделя на две — Комисия за противодействие на корупцията и Комисия за отнемане на незаконно придобитото имущество, — беше приет окончателно през септември 2023 г., при правителството „Денков“.\"}],\"$undefined\",[\"$\",\"details\",null,{\"className\":\"mt-3 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer text-sm font-semibold text-green\",\"children\":[\"Как се стигна дотук (\",3,\" стъпки)\"]}],[\"$\",\"ol\",null,{\"className\":\"mt-3 border-l-2 border-rule pl-4 space-y-3\",\"children\":[[\"$\",\"li\",\"11 декември 2021Петков: реформата на антикорупционната комисия е сред първите приоритети.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"11 декември 2021\"}],[\"$\",\"p\",null,{\"children\":[\"Петков: реформата на антикорупционната комисия е сред първите приоритети.\",\"$undefined\"]}]]}],[\"$\",\"li\",\"юни 2022Правителството пада, реформата не е приета.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"юни 2022\"}],[\"$\",\"p\",null,{\"children\":[\"Правителството пада, реформата не е приета.\",\"$undefined\"]}]]}],[\"$\",\"li\",\"септември 2023Реформата е приета при следващото правителство.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"sp