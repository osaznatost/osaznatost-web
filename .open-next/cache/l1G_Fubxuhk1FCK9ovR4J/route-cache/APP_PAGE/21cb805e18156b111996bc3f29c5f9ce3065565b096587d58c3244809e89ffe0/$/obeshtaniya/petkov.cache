{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/obeshtaniya/layout,_N_T_/obeshtaniya/[gov]/layout,_N_T_/obeshtaniya/[gov]/page,_N_T_/obeshtaniya/petkov"},"segmentPaths":["/_tree","/_full","/obeshtaniya/$d$gov/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/21cb805e18156b111996bc3f29c5f9ce3065565b096587d58c3244809e89ffe0/$/obeshtaniya/petkov","owner":{"kind":"APP_PAGE","sourceRoute":"/obeshtaniya/[gov]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2bx3suebn7wim.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><title>Обещания: Правителство „Петков“ (ПП, БСП, ИТН, ДБ) · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Обещания: Правителство „Петков“ (ПП, БСП, ИТН, ДБ) · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Обещания: Правителство „Петков“ (ПП, БСП, ИТН, ДБ) · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/obeshtaniya\">← <!-- -->Обещания</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">13 декември 2021 – 2 август 2022 г.</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Правителство „Петков“ (ПП, БСП, ИТН, ДБ)</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Коалиция на ПП, БСП, ИТН и ДБ. ИТН напусна коалицията заради спора за ветото за Северна Македония. Правителството падна с вот на недоверие на 22 юни 2022 г. (123 на 116 гласа).</div></div></div><nav class=\"flex flex-wrap gap-2 mb-8\" aria-label=\"Други правителства\"><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/radev\">Прогресивна България</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/zhelyazkov\">Правителство „Желязков“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/denkov\">Правителство „Денков“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-green text-white\" href=\"/obeshtaniya/petkov\">Правителство „Петков“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/borisov-3\">Правителство „Борисов 3“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/borisov-2\">Правителство „Борисов 2“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/oresharski\">Правителство „Орешарски“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/borisov-1\">Правителство „Борисов 1“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/sluzhebno-gyurov\">Служебно правителство „Гюров“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/sluzhebno-glavchev\">Служебни правителства „Главчев“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/sluzhebno-donev\">Служебни правителства „Донев“</a><a class=\"text-sm px-3 py-1.5 rounded-full no-underline bg-surface text-ink hover:ring-1 hover:ring-green\" href=\"/obeshtaniya/sluzhebno-yanev\">Служебни правителства „Янев“</a></nav><section class=\"bg-surface rounded-sm p-5 mb-8\"><div class=\"flex h-4 rounded-full overflow-hidden\"><div style=\"width:70%;background:#2f9e6a\"></div><div style=\"width:30%;background:#d2353f\"></div></div><p class=\"flex flex-wrap gap-x-5 gap-y-1 mt-3 text-sm\"><span class=\"inline-flex items-center gap-1.5\"><span class=\"inline-block w-3 h-3 rounded-full\" style=\"background:#2f9e6a\"></span>Изпълнено<!-- -->: <b class=\"num\">7</b></span><span class=\"inline-flex items-center gap-1.5\"><span class=\"inline-block w-3 h-3 rounded-full\" style=\"background:#d2353f\"></span>Не е изпълнено<!-- -->: <b class=\"num\">3</b></span></p><p class=\"text-sm text-muted mt-3\">Проследяваме <!-- -->10<!-- --> обещания, избрани заради това, че могат да се измерят. Това не са всички обещания и съотношението не е оценка за цялото управление.</p></section><nav class=\"flex flex-wrap gap-x-4 gap-y-1 text-[15px] mb-8\" aria-label=\"Теми\"><span class=\"text-muted\">Теми:</span><a href=\"#t-Икономика\">Икономика<!-- --> (<!-- -->1<!-- -->)</a><a href=\"#t-Данъци и цени\">Данъци и цени<!-- --> (<!-- -->1<!-- -->)</a><a href=\"#t-Пенсии\">Пенсии<!-- --> (<!-- -->2<!-- -->)</a><a href=\"#t-Правосъдие\">Правосъдие<!-- --> (<!-- -->1<!-- -->)</a><a href=\"#t-Данъци\">Данъци<!-- --> (<!-- -->1<!-- -->)</a><a href=\"#t-Цени\">Цени<!-- --> (<!-- -->1<!-- -->)</a><a href=\"#t-Външна политика\">Външна политика<!-- --> (<!-- -->1<!-- -->)</a><a href=\"#t-Корупция\">Корупция<!-- --> (<!-- -->1<!-- -->)</a><a href=\"#t-Доходи\">Доходи<!-- --> (<!-- -->1<!-- -->)</a></nav><section id=\"t-Икономика\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Икономика</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p0\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Икономика</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#d2353f;color:#fff\">Не е изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Еврото от 1 януари 2024 г.</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.bta.bg/en/news/12347-PM-Petkov-on-Bloomberg-Bulgaria-Fully-Committed-to-Adopt-Euro-in-January-202\" target=\"_blank\" rel=\"noreferrer\">Кирил Петков<!-- -->, <!-- -->януари 2022</a></p><p class=\"text-[15px] mt-3\">Правителството прие национален план за въвеждане на еврото от 1 януари 2024 г. През февруари 2023 г. следващото, служебно правителство обяви, че целта отпада заради закъснялото законодателство и високата инфлация. България влезе в еврозоната на 1 януари 2026 г.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->3<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">май 2022</span><p>Правителството „Петков“ приема национален план за въвеждане на еврото от 1 януари 2024 г., въпреки разногласия в коалицията.<!-- --> <a href=\"https://www.intellinews.com/bulgaria-abandons-january-2024-euro-adoption-target-270401\" target=\"_blank\" rel=\"noreferrer\">Източник</a></p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">юни 2022</span><p>Правителството пада след вот на недоверие. Следват служебни кабинети и нови избори, а нужните закони не се приемат.<!-- --> <a href=\"https://www.intellinews.com/bulgaria-abandons-january-2024-euro-adoption-target-270401\" target=\"_blank\" rel=\"noreferrer\">Източник</a></p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">17 февруари 2023</span><p>Служебният финансов министър Росица Велкова обявява, че датата 1 януари 2024 г. отпада. Нова цел: не по-късно от 1 януари 2025 г.<!-- --> <a href=\"https://seenews.com/news/bulgaria-unable-to-meet-eurozone-accession-target-date-fin-min-814904\" target=\"_blank\" rel=\"noreferrer\">Източник</a></p></li></ol></details><details class=\"mt-2\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Защо не е изпълнено или е под въпрос</summary><ul class=\"mt-2 list-disc pl-5 space-y-1 text-[15px]\"><li>Инфлацията е над критерия за ценова стабилност.</li><li>Законите за въвеждането на еврото и промените в Закона за БНБ не са приети навреме заради политическата нестабилност и предсрочните избори.</li><li>Отговорността е споделена: правителството поставя датата, но пада преди да я осигури, а следващите парламенти не приемат законите.</li></ul><p class=\"text-xs text-muted mt-1\">Източници: <span><a href=\"https://seenews.com/news/bulgaria-unable-to-meet-eurozone-accession-target-date-fin-min-814904\" target=\"_blank\" rel=\"noreferrer\">[<!-- -->1<!-- -->]</a></span><span>, <a href=\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2023/02/23/4452868_bulgariia_i_evroto_otlojenata_cl/\" target=\"_blank\" rel=\"noreferrer\">[<!-- -->2<!-- -->]</a></span></p></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://intellinews.com/bulgaria-abandons-january-2024-euro-adoption-target-270401\" target=\"_blank\" rel=\"noreferrer\">intellinews: България се отказва от целта за януари 2024 г.</a><a href=\"https://seenews.com/news/bulgaria-unable-to-meet-eurozone-accession-target-date-fin-min-814904\" target=\"_blank\" rel=\"noreferrer\">SeeNews: причините, по думите на министър Велкова</a></p></li></ul></section><section id=\"t-Данъци и цени\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Данъци и цени</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p1\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Данъци и цени</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#2f9e6a;color:#fff\">Изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Нулева ставка на ДДС за хляба (и брашното) от 1 юли 2022 г.</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://new.bnr.bg/en/post/101663566/parliament-approves-budget-update-at-first-reading\" target=\"_blank\" rel=\"noreferrer\">Правителството, в актуализацията на бюджета за 2022 г., приета на първо четене<!-- -->, <!-- -->юни 2022</a></p><p class=\"text-[15px] mt-3\">Нулевата ставка е приета с изменението на Закона за държавния бюджет за 2022 г. (ДВ бр. 52 от 5 юли 2022 г.), в сила от 1 юли 2022 г. до 1 юли 2023 г.</p><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://assets.kpmg.com/content/dam/kpmg/bg/pdf/bg-tax-news-2022-07-14.pdf\" target=\"_blank\" rel=\"noreferrer\">KPMG: Данъчни новини, 14.07.2022</a></p></li></ul></section><section id=\"t-Пенсии\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Пенсии</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p2\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Пенсии</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#2f9e6a;color:#fff\">Изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Нито един пенсионер под линията на бедност (бюджет 2022 г.)</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.bta.bg/en/news/7454-Government-Adopts-2022-Draft-Budget-PM-Says-It-Will-be-Budget-of-Growth\" target=\"_blank\" rel=\"noreferrer\">Кирил Петков, министър-председател, при приемането на проектобюджета за 2022 г.<!-- -->, <!-- -->януари 2022</a></p><p class=\"text-[15px] mt-3\">От януари 2022 г. минималната пенсия с месечната добавка от 60 лв. е 430 лв. при линия на бедност 413 лв. От 1 юли 2022 г. минималната пенсия става 467 лв., с включена добавка.</p><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://static.eurofound.europa.eu/covid19db/cases/BG-2022-1_2110.html\" target=\"_blank\" rel=\"noreferrer\">Eurofound: месечна добавка към пенсиите, януари–юни 2022</a><a href=\"https://www.zdrave.net/filesS/antikrizisni_20220530.docx\" target=\"_blank\" rel=\"noreferrer\">Законопроект за антикризисните мерки, 30.05.2022 (минимална пенсия 467 лв.)</a></p></li><li id=\"p3\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Пенсии</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#2f9e6a;color:#fff\">Изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Добавка от 60 лв. към всяка пенсия от януари до юни 2022 г.</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://bta.bg/en/news/14198-Additional-Revenues-in-Budget-Amount-to-BGN-1-2-Bln-PM-Kiril-Petkov-Says\" target=\"_blank\" rel=\"noreferrer\">Асен Василев, вицепремиер и министър на финансите<!-- -->, <!-- -->декември 2021</a></p><p class=\"text-[15px] mt-3\">Добавката е изплащана на около 2 млн. пенсионери от 1 януари до 30 юни 2022 г. От 1 юли 2022 г. е включена в размера на пенсиите.</p><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://static.eurofound.europa.eu/covid19db/cases/BG-2022-1_2110.html\" target=\"_blank\" rel=\"noreferrer\">Eurofound: месечна добавка към пенсиите</a></p></li></ul></section><section id=\"t-Правосъдие\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Правосъдие</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p4\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Правосъдие</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#d2353f;color:#fff\">Не е изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Оставка или отстраняване на главния прокурор Иван Гешев</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2022/01/15/4303019_zashto_upravliavashtata_koaliciia_poiska_ostavkata_na/\" target=\"_blank\" rel=\"noreferrer\">Управляващата коалиция (ПП, БСП, ИТН, ДБ), декларация в парламента<!-- -->, <!-- -->януари 2022</a></p><p class=\"text-[15px] mt-3\">Гешев отказа да подаде оставка. Правосъдният министър Надежда Йорданова внесе във ВСС предложение за предсрочното му освобождаване, но той остана на поста. ВСС го освободи едва през юни 2023 г., след края на мандата на правителството.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->4<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">декември 2021</span><p>Гешев заявява, че няма да подаде оставка.<!-- --> <a href=\"https://bnt.bg/news/geshev-after-demands-for-his-resignation-the-prosecutor-39s-office-is-doing-its-job-well-301121news.html\" target=\"_blank\" rel=\"noreferrer\">Източник</a></p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">януари 2022</span><p>Коалицията иска оставката му с декларация от трибуната.<!-- --> <a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2022/01/15/4303019_zashto_upravliavashtata_koaliciia_poiska_ostavkata_na/\" target=\"_blank\" rel=\"noreferrer\">Източник</a></p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">април 2022</span><p>ВСС разглежда предложението на правосъдния министър; Гешев остава на поста.<!-- --> <a href=\"https://www.bta.bg/bg/galleries/27730\" target=\"_blank\" rel=\"noreferrer\">Източник</a></p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">юни 2023</span><p>ВСС освобождава Гешев (вече при друго правителство).<!-- --> <a href=\"https://sofiaglobe.com/2023/06/12/bulgarias-sjc-votes-to-sack-prosecutor-general-geshev/\" target=\"_blank\" rel=\"noreferrer\">Източник</a></p></li></ol></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2022/01/15/4303019_zashto_upravliavashtata_koaliciia_poiska_ostavkata_na/\" target=\"_blank\" rel=\"noreferrer\">Капитал: защо коалицията поиска оставката на Гешев</a><a href=\"https://bnt.bg/news/geshev-after-demands-for-his-resignation-the-prosecutor-39s-office-is-doing-its-job-well-301121news.html\" target=\"_blank\" rel=\"noreferrer\">БНТ: Гешев отказва да подаде оставка</a><a href=\"https://www.bta.bg/bg/galleries/27730\" target=\"_blank\" rel=\"noreferrer\">БТА: ВСС обсъжда предложението на Йорданова (4 април 2022)</a><a href=\"https://sofiaglobe.com/2023/06/12/bulgarias-sjc-votes-to-sack-prosecutor-general-geshev/\" target=\"_blank\" rel=\"noreferrer\">Sofia Globe: ВСС освобождава Гешев (юни 2023)</a></p></li></ul></section><section id=\"t-Данъци\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Данъци</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p5\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Данъци</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#2f9e6a;color:#fff\">Изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Без вдигане на данъците</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.bta.bg/en/news//27288-Kiril-Petkov-Comments-on-Coalition-Policy-of-Continue-the-Change\" target=\"_blank\" rel=\"noreferrer\">Кирил Петков<!-- -->, <!-- -->октомври 2021 (преди изборите)</a></p><p class=\"text-[15px] mt-3\">Бюджетът за 2022 г. не промени данъчните ставки: плоският данък от 10% остана, ставката от 9% ДДС за туризма също. Промени в ДДС бяха в посока надолу: нулева ставка за хляба и брашното от 1 юли 2022 г.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->3<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">октомври 2021</span><p>Петков: принципите на бъдещото управление включват „без вдигане на данъците“.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">ноември 2021</span><p>Коалиционните партньори се договарят да запазят 9% ДДС за туризма.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">юли 2022</span><p>Нулева ставка на ДДС за хляба и брашното.</p></li></ol></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://new.bnr.bg/en/post/101564075/vat-on-some-goods-to-remain-lower-next-year\" target=\"_blank\" rel=\"noreferrer\">БНР: без промени в данъчната система през следващата година</a><a href=\"https://bta.bg/en/news//18828-Continue-the-Change-Continues-Consultations-on-Government-Coalition-Agreement\" target=\"_blank\" rel=\"noreferrer\">БТА: коалицията запазва 9% ДДС за туризма</a></p></li></ul></section><section id=\"t-Цени\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Цени</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p6\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Цени</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#2f9e6a;color:#fff\">Изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Отстъпка от 25 стотинки на литър гориво до края на 2022 г.</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://new.bnr.bg/en/post/101648608/bulgarian-cabinet-announces-a-series-of-anti-crisis-measures\" target=\"_blank\" rel=\"noreferrer\">Кирил Петков (антикризисен пакет)<!-- -->, <!-- -->юни 2022</a></p><p class=\"text-[15px] mt-3\">Отстъпката е приета с актуализацията на бюджета и действа от началото на юли 2022 г. до 31 декември 2022 г. Правителството на Петков отпусна 150 млн. лв. Служебното правителство след него добави 38 млн. лв., за да стигнат парите до края на годината.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->4<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">юни 2022</span><p>Коалицията обявява антикризисен пакет с отстъпка за горивата до края на годината.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">1 юли 2022</span><p>Отстъпката влиза в сила с актуализацията на бюджета.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">ноември 2022</span><p>Служебното правителство отпуска още 38 млн. лв.<!-- --> <a href=\"https://sofiaglobe.com/?p=109973\" target=\"_blank\" rel=\"noreferrer\">Източник</a></p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">31 декември 2022</span><p>Мярката приключва.</p></li></ol></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://www.bta.bg/en/news/economy/290109-za-mat-fuel-discount-of-bgn-0-25-l-takes-effect-from-july-1\" target=\"_blank\" rel=\"noreferrer\">БТА: отстъпката от 0,25 лв./л влиза в сила от 1 юли</a><a href=\"https://sofiaglobe.com/?p=109973\" target=\"_blank\" rel=\"noreferrer\">Sofia Globe: служебното правителство добавя 38 млн. лв. до края на годината</a><a href=\"https://static.eurofound.europa.eu/covid19db/cases/BG-2022-28_2761.html\" target=\"_blank\" rel=\"noreferrer\">Eurofound: мярката действа до 31.12.2022</a></p></li></ul></section><section id=\"t-Външна политика\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Външна политика</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p7\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Външна политика</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#2f9e6a;color:#fff\">Изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Решението за ветото за Северна Македония да вземе парламентът</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://bnt.bg/news/pm-kiril-petkov-in-brussels-i-will-keep-my-word-on-north-macedonia-i-am-tired-of-cowards-307628news.html\" target=\"_blank\" rel=\"noreferrer\">Кирил Петков<!-- -->, <!-- -->23 юни 2022</a></p><p class=\"text-[15px] mt-3\">На 24 юни 2022 г. Народното събрание с 170 гласа „за“ даде мандат на правителството да приеме френското предложение. Решението беше по проект на „Демократична България“. Правителството на Петков вече беше паднало с вот на недоверие на 22 юни.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->3<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">22 юни 2022</span><p>Правителството пада с вот на недоверие.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">23 юни 2022</span><p>Петков: решението ще вземе парламентът.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">24 юни 2022</span><p>Парламентът гласува: 170 „за“, 37 „против“, 21 „въздържал се“.</p></li></ol></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://bnt.bg/news/bulgaria-lifts-the-veto-on-north-macedonia-39s-eu-talks-as-per-french-eu-council-presidency-proposal-307660news.html\" target=\"_blank\" rel=\"noreferrer\">БНТ: парламентът дава мандат за вдигане на ветото (170 „за“)</a><a href=\"https://www.rferl.org/a/bulgaria-withdraws-macedonian-eu-veto/31913536.html\" target=\"_blank\" rel=\"noreferrer\">RFE/RL: депутатите гласуват за вдигане на ветото</a></p></li></ul></section><section id=\"t-Корупция\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Корупция</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p8\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Корупция</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#d2353f;color:#fff\">Не е изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Реформа на антикорупционната комисия като първа задача</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.rferl.org/a/bulgaria-petkov-new-government/31604680.html\" target=\"_blank\" rel=\"noreferrer\">Кирил Петков<!-- -->, <!-- -->11 декември 2021</a></p><p class=\"text-[15px] mt-3\">По време на мандата (декември 2021 – юни 2022) комисията не беше реформирана. Законът, който я разделя на две — Комисия за противодействие на корупцията и Комисия за отнемане на незаконно придобитото имущество, — беше приет окончателно през септември 2023 г., при правителството „Денков“.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->3<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">11 декември 2021</span><p>Петков: реформата на антикорупционната комисия е сред първите приоритети.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">юни 2022</span><p>Правителството пада, реформата не е приета.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">септември 2023</span><p>Реформата е приета при следващото правителство.</p></li></ol></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://sofiaglobe.com/2023/09/21/bulgarias-parliament-approves-anti-corruption-legislation/\" target=\"_blank\" rel=\"noreferrer\">Sofia Globe: парламентът приема антикорупционния закон (21.09.2023)</a><a href=\"https://read.oecd-ilibrary.org/en/publications/reforming-bulgaria-s-anti-corruption-authorities_11ef33c9-en.html\" target=\"_blank\" rel=\"noreferrer\">ОИСР: реформата на антикорупционните органи</a></p></li></ul></section><section id=\"t-Доходи\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-24\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Доходи</h2></div><ul class=\"grid gap-4 lg:grid-cols-2\"><li id=\"p9\" class=\"scroll-mt-32 lg:scroll-mt-24 rounded-xl ring-1 ring-rule bg-white p-5 flex flex-col\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm text-muted\">Доходи</p><span class=\"text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap\" style=\"background:#2f9e6a;color:#fff\">Изпълнено</span></div><p class=\"display text-[1.7rem] mt-2\">Пенсиите +10% от 1 юли 2022 г. и минимална пенсия 467 лв.</p><p class=\"text-sm text-muted mt-1\">Обещал: <a href=\"https://www.minfin.bg/en/news/11857\" target=\"_blank\" rel=\"noreferrer\">Министерството на финансите (проект на актуализация на бюджета)<!-- -->, <!-- -->6 юни 2022</a></p><p class=\"text-[15px] mt-3\">На 28 юни 2022 г. парламентът прие окончателно увеличение на пенсиите с 10% от 1 юли. Ковид добавката от 60 лв. влезе в пенсията, минималната пенсия стана 467 лв., а таванът — 2000 лв. Предложенията на ГЕРБ–СДС (+15%) и ДПС (+14%) не бяха приети.</p><details class=\"mt-3 group\"><summary class=\"cursor-pointer text-sm font-semibold text-green\">Как се стигна дотук (<!-- -->3<!-- --> стъпки)</summary><ol class=\"mt-3 border-l-2 border-rule pl-4 space-y-3\"><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">6 юни 2022</span><p>Публикуван е проектът на актуализация на бюджета.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">28 юни 2022</span><p>Парламентът го приема окончателно.</p></li><li class=\"relative text-[15px]\"><span class=\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"></span><span class=\"text-sm font-semibold\">1 юли 2022</span><p>Увеличението влиза в сила.</p></li></ol></details><p class=\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\"><a href=\"https://bnt.bg/news/retirement-age-pensions-go-up-by-10-from-july-1-307781news.html\" target=\"_blank\" rel=\"noreferrer\">БНТ: пенсиите се увеличават с 10% от 1 юли</a><a href=\"https://www.minfin.bg/en/news/11857\" target=\"_blank\" rel=\"noreferrer\">Министерство на финансите: проектът на актуализация</a></p></li></ul></section><p class=\"text-xs text-muted mt-4\">Програми: <span><a href=\"https://www.gov.bg/en/Press-center/News/Statement-by-the-Prime-Minister-Kiril-Petkov\" target=\"_blank\" rel=\"noreferrer\">Изявление на премиера Кирил Петков при предаването на властта (02.08.2022)</a></span><span>; <a href=\"https://www.aljazeera.com/news/2022/6/22/bulgarias-ruling-four-party-coalition-faces-no-confidence-vote\" target=\"_blank\" rel=\"noreferrer\">Ал Джазира: правителството пада след вот на недоверие</a></span>. Проверено: <!-- -->2026-11-19</p><p class=\"text-[15px] mt-6\">Сравни с: <span><a href=\"/obeshtaniya/radev\">Прогресивна България</a></span><span>, <a href=\"/obeshtaniya/zhelyazkov\">Правителство „Желязков“</a></span><span>, <a href=\"/obeshtaniya/denkov\">Правителство „Денков“</a></span><span>, <a href=\"/obeshtaniya/borisov-3\">Правителство „Борисов 3“</a></span><span>, <a href=\"/obeshtaniya/borisov-2\">Правителство „Борисов 2“</a></span><span>, <a href=\"/obeshtaniya/oresharski\">Правителство „Орешарски“</a></span><span>, <a href=\"/obeshtaniya/borisov-1\">Правителство „Борисов 1“</a></span><span>, <a href=\"/obeshtaniya/sluzhebno-gyurov\">Служебно правителство „Гюров“</a></span><span>, <a href=\"/obeshtaniya/sluzhebno-glavchev\">Служебни правителства „Главчев“</a></span><span>, <a href=\"/obeshtaniya/sluzhebno-donev\">Служебни правителства „Донев“</a></span><span>, <a href=\"/obeshtaniya/sluzhebno-yanev\">Служебни правителства „Янев“</a></span>.</p></div><!--$--><!--/$--></main><!--$--><!--/$--><footer class=\"bg-surface border-t border-rule mt-20\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 text-sm text-muted grid gap-2 sm:grid-cols-2\"><p>Не подкрепяме партия, кандидат или правителство. Всяко число има източник и дата.<!-- --> <a href=\"/metodologiya\">Как работим</a> · <a href=\"/rechnik\">Речник</a> · <a href=\"/sastoyanie\">Състояние на данните</a> · <!--$?--><template id=\"B:1\"></template><a href=\"/metodologiya#greshki\">Съобщи за грешка</a><!--/$--></p><p class=\"sm:text-right\">Вътрешен прототип · данните са към датите, посочени до тях</p></div></footer><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script id=\"_R_\">(globalThis[\"TURBOPACK\"] || (globalThis[\"TURBOPACK\"] = [])).push({\"otherChunks\":[\"static/chunks/310vm2bl3xxpt.js\",\"static/chunks/2vy51v46dlsq-.js\",\"static/chunks/2bx7ggprk0oi5.js\",\"static/chunks/0c1ad7rcpjghx.js\"],\"runtimeModuleIds\":[94553]});</script><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" async=\"\"></script><div hidden id=\"S:0\"><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" aria-current=\"page\" class=\"no-underline pb-1 border-b-2 text-white border-red\" href=\"/obeshtaniya\">Обещания</a></span><span c