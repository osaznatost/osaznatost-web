-4 space-y-3\",\"children\":[[\"$\",\"li\",\"2009Цел: Шенген през 2011 г.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"2009\"}],[\"$\",\"p\",null,{\"children\":[\"Цел: Шенген през 2011 г.\",\"$undefined\"]}]]}],[\"$\",\"li\",\"декември 2010Франция и Германия: „преждевременно“.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"декември 2010\"}],[\"$\",\"p\",null,{\"children\":[\"Франция и Германия: „преждевременно“.\",\"$undefined\"]}]]}],[\"$\",\"li\",\"22 септември 2011Вето от Нидерландия и Финландия.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"22 септември 2011\"}],[\"$\",\"p\",null,{\"children\":[\"Вето от Нидерландия и Финландия.\",\"$undefined\"]}]]}],[\"$\",\"li\",\"2024–2025Влизане в Шенген (по въздух и море, после изцяло).\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"2024–2025\"}],[\"$\",\"p\",null,{\"children\":[\"Влизане в Шенген (по въздух и море, после изцяло).\",\"$undefined\"]}]]}]]}]]}],null,\"$undefined\",[\"$\",\"p\",null,{\"className\":\"text-sm mt-auto pt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[\"$\",\"a\",\"https://www.novinite.com/view_news.php?id=123461\",{\"href\":\"https://www.novinite.com/view_news.php?id=123461\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"childr