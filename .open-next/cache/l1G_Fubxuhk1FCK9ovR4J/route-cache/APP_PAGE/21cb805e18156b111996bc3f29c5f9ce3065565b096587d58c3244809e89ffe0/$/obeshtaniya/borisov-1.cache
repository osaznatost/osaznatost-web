]}],[\"$\",\"p\",null,{\"className\":\"display text-[1.7rem] mt-2\",\"children\":\"Без вдигане на данъците до края на мандата\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mt-1\",\"children\":[\"Обещал: \",[\"$\",\"a\",null,{\"href\":\"https://www.novinite.com/articles/131484/Bulgarian+Cabinet+Promises+Not+to+Raise+Taxes+While+in+Power\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"Симеон Дянков, вицепремиер и министър на финансите\",\", \",\"2011\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-3\",\"children\":\"През 2010 г. правителството обмисляше да вдигне ДДС от 20% на 22%, но се отказа след протест на синдикатите и работодателите и вместо това намали разходите. Плоският данък от 10% и ДДС от 20% останаха до края на мандата. Осигурителната вноска за пенсия беше увеличена с 2 пункта от 2011 г.\"}],\"$undefined\",[\"$\",\"details\",null,{\"className\":\"mt-3 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer text-sm font-semibold text-green\",\"children\":[\"Как се стигна дотук (\",4,\" стъпки)\"]}],[\"$\",\"ol\",null,{\"className\":\"mt-3 border-l-2 border-rule pl-4 space-y-3\",\"children\":[[\"$\",\"li\",\"март 2010Обсъжда се ДДС 22%.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"март 2010\"}],[\"$\",\"p\",null,{\"children\":[\"Обсъжда се ДДС 22%.\",\"$undefined\"]}]]}],[\"$\",\"li\",\"2010Правителството се отказва и съкращава разходите.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"2010\"}],[\"$\",\"p\",null,{\"children\":[\"Правителството се отказва и съкращава разходите.\",\"$undefined\"]}]]}],[\"$\",\"li\",\"20