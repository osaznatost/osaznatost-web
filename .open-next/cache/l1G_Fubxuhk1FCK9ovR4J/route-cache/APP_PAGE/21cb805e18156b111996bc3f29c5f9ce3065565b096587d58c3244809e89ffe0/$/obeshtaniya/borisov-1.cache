text-sm text-muted mt-1\",\"children\":[\"Обещал: \",[\"$\",\"a\",null,{\"href\":\"https://www.novinite.com/view_news.php?id=123461\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"Правителството „Борисов 1“ (вътрешният министър Цветан Цветанов)\",\", \",\"декември 2010\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-3\",\"children\":\"Целта е поставена още през 2007 г. Правителството я направи свой основен приоритет. През декември 2010 г. Франция и Германия поискаха отлагане, а след това се присъединиха и Нидерландия и Финландия. До края на мандата (март 2013 г.) България не беше приета.\"}],\"$undefined\",[\"$\",\"details\",null,{\"className\":\"mt-3 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer text-sm font-semibold text-green\",\"children\":[\"Как се стигна дотук (\",3,\" стъпки)\"]}],[\"$\",\"ol\",null,{\"className\":\"mt-3 border-l-2 border-rule pl-4 space-y-3\",\"children\":[[\"$\",\"li\",\"2010Шенген е основен приоритет на правителството.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"2010\"}],[\"$\",\"p\",null,{\"children\":[\"Шенген е основен приоритет на правителството.\",\"$undefined\"]}]]}],[\"$\",\"li\",\"21 декември 2010Франция и Германия искат отлагане.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-full bg-green\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"21 декември 2010\"}],[\"$\",\"p\",null,{\"children\":[\"Франция и Германия искат отлагане.\",\"$undefined\"]}]]}],[\"$\",\"li\",\"март 2011Целевата дата минава без приемане.\",{\"className\":\"relative text-[15px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute -left-[1.4rem] top-1.5 w-2.5 h-2.5 rounded-f