[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold px-2.5 py-1 rounded-full bg-[#eef3d2] text-[#4d5a12]\",\"children\":\"Отчасти вярно\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Христо Гаджев\"}],\"$undefined\",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted ml-auto\",\"children\":\"18 ноември 2026 г.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17px] font-semibold leading-snug\",\"children\":[\"„\",\"За по-малко от пет месеца властта е поела 5,3 млрд. € нов дълг.\",\"“\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] mt-2\",\"children\":\"Правителството е от 8 май 2026 г. Сборът на известните операции след тази дата: 2,5 млрд. € еврооблигации на 7 юли, 2,25 млрд. € на международните пазари в края на септември и около 0,1 млрд. € на вътрешния пазар до края на юли. Това прави около 4,85 млрд. €, без аукционите на вътрешния пазар след юли. Порядъкът на 5,3 млрд. € е реалистичен, но точната сума за мандата ще се потвърди с месечния бюлетин на МФ. За сравнение: целият таван за 2026 г. е 10,1 млрд. €, от които до 3,26 млрд. € са целеви заем по SAFE за отбрана.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1\",\"children\":[[[\"$\",\"a\",\"https://www.bta.bg/bg/news/economy/bg/1163475-balgariya-emitira-dalg-za-2-5-mlrd-evro-na-mezhdunarodnite-pazari-za-parvi-pa\",{\"href\":\"https://www.bta.bg/bg/news/economy/bg/1163475-balgariya-emitira-dalg-za-2-5-mlrd-evro-na-mezhdunarodnite-pazari-za-parvi-pa\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: 2,5 млрд. € на международните пазари, 7 юли 2026 г.\"}],[\"$\",\"a\",\"https://bnrnews.bg/en/post/508409/bulgaria-with-new-domestic-debt-of-100-million-euros\",{\"href\":\"https://bnrnews.bg/en/post/508409/bulgaria-with-new-domestic-debt-of-100-million-euros\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БНР: общо 4,01 млрд. € нов дълг до 28 юли 2026 г.\"}],[\"$\",\"a\",\"https://www.capital.bg/biznes-z