"></circle><circle cx=\"0.6883166794825337\" cy=\"-0.4901480885876624\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.3747620602622138\" cy=\"-0.2624112196306035\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.509275137535309\" cy=\"-0.3402867677245065\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.6436796608981129\" cy=\"-0.4180104593740334\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.778028608762387\" cy=\"-0.4956588886999451\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.8433914458128856\" cy=\"-0.537299608346824\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.46332359102467463\" cy=\"-0.2675000000000001\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.3290896534380867\" cy=\"-0.18999999999999995\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.5975575286112627\" cy=\"-0.34499999999999986\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.7317914661978507\" cy=\"-0.4224999999999998\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.8182674936069095\" cy=\"-0.4259630957093187\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.8870108331782217\" cy=\"-0.4617486132350338\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.6838475073145724\" cy=\"-0.34843770855010214\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.5493345541887715\" cy=\"-0.2709018227591385\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.41463581256926735\" cy=\"-0.19334785474636998\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.768639036074568\" cy=\"-0.35102568598659417\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.6335691137473891\" cy=\"-0.2732950385670181\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.852278868741662\" cy=\"-0.3530254663567953\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.9238795325112867\" cy=\"-0.3826834323650898\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.4980174555246494\" cy=\"-0.1954574480360212\" r=\"0.04666666666666666\" fill=\"#8a6d9e\"></circle><circle cx=\"0.7165229773366025\" cy=\"-0.27504740127601784\" r=\"0.04666666666666666\" fill=\"#8a8f8c\"></circle><circle cx=\"0.7985256918138948\" cy=\"-0.27637242900322134\" r=\"0.04666666666666666\" fill=\"#8a8f8c\"></circle><circle cx=\"0.5799947043157523\" cy=\"-0.19688167249818653\" r=\"0.04666666666666666\" fill=\"#8a8f8c\"></circle><circle cx=\"0.36140147619215834\" cy=\"-0.11742645786248002\" r=\"0.04666666666666666\" fill=\"#8a8f8c\"></circle><circle cx=\"0.8798038870652394\" cy=\"-0.27740110004269203\" r=\"0.04666666666666666\" fill=\"#8a8f8c\"></circle><circle cx=\"0.9537169507482269\" cy=\"-0.30070579950427323\" r=\"0.04666666666666666\" fill=\"#8a8f8c\"></circle><circle cx=\"0.6610127634976872\" cy=\"-0.19789423057065242\" r=\"0.04666666666666666\" fill=\"#8a8f8c\"></circle><circle cx=\"0.4419110655272488\" cy=\"-0.11840971313440311\" r=\"0.04666666666666666\" fill=\"#8a8f8c\"></circle><circle cx=\"0.74134807167686\" cy=\"-0.19864361711618447\" r=\"0.04666666666666666\" fill=\"#8a8f8c\"></circle><circle cx=\"0.8211807752333927\" cy=\"-0.199216300505466\" r=\"0.04666666666666666\" fill=\"#8a8f8c\"></circle><circle cx=\"0.5215864330172757\" cy=\"-0.1190486996666282\" r=\"0.04666666666666666\" fill=\"#8a8f8c\"></circle><circle cx=\"0.9006330665681385\" cy=\"-0.19966554385790009\" r=\"0.04666666666666666\" fill=\"#8a8f8c\"></circle><circle cx=\"0.9762960071199334\" cy=\"-0.21643961393810307\" r=\"0.04666666666666666\" fill=\"#8a8f8c\"></circle><circle cx=\"0.6007309842469788\" cy=\"-0.11949282223487843\" r=\"0.04666666666666666\" fill=\"#8a8f8c\"></circle><circle cx=\"0.6795173495784235\" cy=\"-0.11981724259018209\" r=\"0.04666666666666666\" fill=\"#8a8f8c\"></circle><circle cx=\"0.7580508014067683\" cy=\"-0.12006345191837721\" r=\"0.04666666666666666\" fill=\"#8a8f8c\"></circle><circle cx=\"0.8363991183893882\" cy=\"-0.12025603834092587\" r=\"0.04666666666666666\" fill=\"#5f7f4e\"></circle><circle cx=\"0.9146078846173401\" cy=\"-0.12041041232299744\" r=\"0.04666666666666666\" fill=\"#5f7f4e\"></circle><circle cx=\"0.9914448613738104\" cy=\"-0.13052619222005143\" r=\"0.04666666666666666\" fill=\"#5f7f4e\"></circle><circle cx=\"0.3779183202399439\" cy=\"-0.039720816041708205\" r=\"0.04666666666666666\" fill=\"#5f7f4e\"></circle><circle cx=\"0.4557590743769736\" cy=\"-0.03987375230705357\" r=\"0.04666666666666666\" fill=\"#5f7f4e\"></circle><circle cx=\"0.5335040314919314\" cy=\"-0.03998060006873713\" r=\"0.04666666666666666\" fill=\"#5f7f4e\"></circle><circle cx=\"0.6111885904836447\" cy=\"-0.04005941665346258\" r=\"0.04666666666666666\" fill=\"#5f7f4e\"></circle><circle cx=\"0.688832629207175\" cy=\"-0.040119931948228174\" r=\"0.04666666666666666\" fill=\"#5f7f4e\"></circle><circle cx=\"0.7664481679241355\" cy=\"-0.04016784641645928\" r=\"0.04666666666666666\" fill=\"#5f7f4e\"></circle><circle cx=\"0.8440429016096417\" cy=\"-0.04020671887106247\" r=\"0.04666666666666666\" fill=\"#5f7f4e\"></circle><circle cx=\"0.9216219844092638\" cy=\"-0.04023888484452241\" r=\"0.04666666666666666\" fill=\"#5f7f4e\"></circle><circle cx=\"0.9990482215818578\" cy=\"-0.04361938736533595\" r=\"0.04666666666666666\" fill=\"#5f7f4e\"></circle><text x=\"0\" y=\"-0.08\" text-anchor=\"middle\" font-size=\"0.16\" font-weight=\"700\" fill=\"#141a17\">240</text><text x=\"0\" y=\"0.02\" text-anchor=\"middle\" font-size=\"0.06\" fill=\"#56605b\">депутати</text></svg><figcaption class=\"flex flex-wrap gap-x-5 gap-y-1 mt-3 text-sm\"><span class=\"inline-flex items-center gap-1.5\"><span class=\"inline-block w-3 h-3 rounded-full\" style=\"background:#3d5a80\"></span>Прогресивна България<!-- --> <b class=\"num\">131</b></span><span class=\"inline-flex items-center gap-1.5\"><span class=\"inline-block w-3 h-3 rounded-full\" style=\"background:#b08436\"></span>ГЕРБ – СДС<!-- --> <b class=\"num\">39</b></span><span class=\"inline-flex items-center gap-1.5\"><span class=\"inline-block w-3 h-3 rounded-full\" style=\"background:#2a7f7a\"></span>Демократична България<!-- --> <b class=\"num\">21</b></span><span class=\"inline-flex items-center gap-1.5\"><span class=\"inline-block w-3 h-3 rounded-full\" style=\"background:#8a6d9e\"></span>ДПС<!-- --> <b class=\"num\">21</b></span><span class=\"inline-flex items-center gap-1.5\"><span class=\"inline-block w-3 h-3 rounded-full\" style=\"background:#8a8f8c\"></span>Продължаваме промяната<!-- --> <b class=\"num\">16</b></span><span class=\"inline-flex items-center gap-1.5\"><span class=\"inline-block w-3 h-3 rounded-full\" style=\"background:#5f7f4e\"></span>Възраждане<!-- --> <b class=\"num\">12</b></span></figcaption></figure><div class=\"text-[15px] space-y-3\"><p>В парламента има <!-- -->240<!-- --> действащи депутати. Най-голямата група е <b>Прогресивна България</b> с <!-- -->131<!-- --> места<!-- --> — самостоятелно мнозинство: може да приема закони без чужди гласове<!-- -->.</p><ul class=\"space-y-1\"><li><a href=\"/parlament\">Как гласува всяка група и всеки депутат</a></li><li><a href=\"/parlament/partii\">Сравнение на партиите: присъствие, единство, съюзници</a></li><li><a href=\"/obeshtaniya/radev\">Обещанията на управляващите и докъде са</a></li><li><a href=\"/vlast/sadebna-vlast\">Съдебната власт: кой е избран във ВСС и коя група как е гласувала</a></li><li><a href=\"/vlast/ministerstva\">Министерствата: кой ги ръководи, колко хора работят, какви поръчки възлагат</a></li><li><a href=\"/vlast/deklaracii\">Декларирани фирми на лицата на власт и обществените поръчки</a></li><li><a href=\"/byudzhet\">Бюджетът: какво харчи държавата</a></li><li><a href=\"/porachki\">Обществените поръчки: кой взема парите</a></li></ul></div></div></section><section id=\"signali\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Сигнали</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Особености в начина на приемане на законите, открити автоматично. Те не доказват нарушение, а показват къде да се прочете внимателно.</p><div class=\"grid gap-4 md:grid-cols-3\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold\">Съкратен срок за предложения<!-- --> <span class=\"num text-red\">(<!-- -->18<!-- -->)</span></p><p class=\"text-sm text-muted mb-2\">Мнозинството гласува по-кратък срок за промени между четенията.</p><ul class=\"text-[15px] space-y-1\"><li><a href=\"/parlament/zakon/vodite\">Закон за водите</a></li><li><a href=\"/parlament/zakon/aktsizite-i-danachnite-skladove\">Закон за акцизите и данъчните складове</a></li><li><a href=\"/parlament/zakon/danak-varhu-dobavenata-stoynost\">Закон за данък върху добавената стойност</a></li><li><a href=\"/parlament/zakon/energiyata-ot-vazobnovyaemi-iztochnitsi\">Закон за енергията от възобновяеми източници</a></li><li><a href=\"/parlament/zakon/veterinarnomeditsinskata-deynost\">Закон за ветеринарномедицинската дейност</a></li><li><a href=\"/parlament/zakon/elektronnata-identifikatsiya\">Закон за електронната идентификация</a></li><li><a href=\"/parlament/zakon/targovskiya-registar-i-registara-na-yuridicheskite-litsa-s-nestopanska-tsel\">Закон за търговския регистър и регистъра на юридическите лица с нестопанска цел</a></li><li><a href=\"/parlament/zakon/kodeks-na-truda\">Кодекс на труда</a></li></ul><p class=\"text-sm text-muted mt-1\">и още <!-- -->10</p></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold\">Обявен конфликт на интереси<!-- --> <span class=\"num text-red\">(<!-- -->2<!-- -->)</span></p><p class=\"text-sm text-muted mb-2\">Депутати са заявили в комисията, че имат потенциален конфликт на интереси.</p><ul class=\"text-[15px] space-y-1\"><li><a href=\"/parlament/zakon/sobstvenostta-i-polzvaneto-na-zemedelskite-zemi\">Закон за собствеността и ползването на земеделските земи</a></li><li><a href=\"/parlament/zakon/podpomagane-na-zemedelskite-proizvoditeli\">Закон за подпомагане на земеделските производители</a></li></ul></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold\">Двете четения в един ден<!-- --> <span class=\"num text-red\">(<!-- -->3<!-- -->)</span></p><p class=\"text-sm text-muted mb-2\">Няма време за предложения и обсъждане между четенията.</p><ul class=\"text-[15px] space-y-1\"><li><a href=\"/parlament/zakon/aktsizite-i-danachnite-skladove\">Закон за акцизите и данъчните складове</a></li><li><a href=\"/parlament/zakon/vavezhdane-na-evroto-v-republika-balgariya\">Закон за въвеждане на еврото в Република България</a></li><li><a href=\"/parlament/zakon/darzhavnata-finansova-inspektsiya\">Закон за държавната финансова инспекция</a></li></ul></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold\">Под 7 дни между четенията<!-- --> <span class=\"num text-red\">(<!-- -->1<!-- -->)</span></p><p class=\"text-sm text-muted mb-2\">По-малко време да се видят и оспорят промените.</p><ul class=\"text-[15px] space-y-1\"><li><a href=\"/parlament/zakon/energiyata-ot-vazobnovyaemi-iztochnitsi\">Закон за енергията от възобновяеми източници</a></li></ul></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold\">Нови текстове в заключителните разпоредби<!-- --> <span class=\"num text-red\">(<!-- -->6<!-- -->)</span></p><p class=\"text-sm text-muted mb-2\">Там често се променят други закони, без обществено обсъждане.</p><ul class=\"text-[15px] space-y-1\"><li><a href=\"/parlament/zakon/energiyata-ot-vazobnovyaemi-iztochnitsi\">Закон за енергията от възобновяеми източници</a></li><li><a href=\"/parlament/zakon/upravlenie-na-otpadatsite\">Закон за управление на отпадъците</a></li><li><a href=\"/parlament/zakon/kodeks-za-zastrahovaneto\">Кодекс за застраховането</a></li><li><a href=\"/parlament/zakon/chastnata-ohranitelna-deynost\">Закон за частната охранителна дейност</a></li><li><a href=\"/parlament/zakon/danachno-osiguritelen-protsesualen-kodeks\">Данъчно-осигурителен процесуален кодекс</a></li><li><a href=\"/parlament/zakon/deynostta-na-kolektivnite-investitsionni-shemi-i-na-drugi-predpriyatiya-za-kolektivno-investirane\">Закон за дейността на колективните инвестиционни схеми и на други предприятия за колективно инвестиране</a></li></ul></div></div><p class=\"text-xs text-muted mt-3\">Сигналът е повод за въпрос, не доказателство за нарушение.<!-- --> <a class=\"underline\" href=\"/metodologiya#signal\">Как работим със сигналите</a></p></section><section id=\"kak\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Как се приема закон и къде е рискът</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Седем стъпки. Червеното показва местата, където най-често се промъкват текстове в полза на тесен кръг.</p><ol class=\"max-w-4xl space-y-3\"><li class=\"grid grid-cols-[2rem_1fr] gap-3 p-3 rounded-sm bg-[#fdeff1]\"><span class=\"display num text-[1.6rem] leading-none text-muted\">1</span><div><p class=\"font-semibold\">Законопроект<span class=\"text-xs text-red font-semibold ml-2\">риск</span></p><p class=\"text-[15px] text-muted\">Внася го Министерският съвет или поне един депутат. Проектите на правителството минават 30-дневно обществено обсъждане; тези на депутатите — не.</p></div></li><li class=\"grid grid-cols-[2rem_1fr] gap-3 p-3 rounded-sm bg-surface\"><span class=\"display num text-[1.6rem] leading-none text-muted\">2</span><div><p class=\"font-semibold\">Комисии</p><p class=\"text-[15px] text-muted\">Водещата комисия обсъжда проекта, кани становища от браншове, синдикати и институции и прави доклад.</p></div></li><li class=\"grid grid-cols-[2rem_1fr] gap-3 p-3 rounded-sm bg-surface\"><span class=\"display num text-[1.6rem] leading-none text-muted\">3</span><div><p class=\"font-semibold\">Първо четене</p><p class=\"text-[15px] text-muted\">Залата гласува идеята „по принцип“. <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">Какво е</button></span>.</p></div></li><li class=\"grid grid-cols-[2rem_1fr] gap-3 p-3 rounded-sm bg-[#fdeff1]\"><span class=\"display num text-[1.6rem] leading-none text-muted\">4</span><div><p class=\"font-semibold\">Предложения между четенията<span class=\"text-xs text-red font-semibold ml-2\">риск</span></p><p class=\"text-[15px] text-muted\">Депутатите внасят писмени предложения, обикновено за 7 дни. Срокът може да се съкрати.</p></div></li><li class=\"grid grid-cols-[2rem_1fr] gap-3 p-3 rounded-sm bg-[#fdeff1]\"><span class=\"display num text-[1.6rem] leading-none text-muted\">5</span><div><p class=\"font-semibold\">Второ четене<span class=\"text-xs text-red font-semibold ml-2\">риск</span></p><p class=\"text-[15px] text-muted\">Гласуване член по член. Тук се приемат и нови текстове, които ги нямаше в проекта. <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">Какво е</button></span>.</p></div></li><li class=\"grid grid-cols-[2rem_1fr] gap-3 p-3 rounded-sm bg-[#fdeff1]\"><span class=\"display num text-[1.6rem] leading-none text-muted\">6</span><div><p class=\"font-semibold\">Преходни и заключителни разпоредби<span class=\"text-xs text-red font-semibold ml-2\">риск</span></p><p class=\"text-[15px] text-muted\">Последната част на закона. В нея с един параграф може да се промени съвсем друг закон.</p></div></li><li class=\"grid grid-cols-[2rem_1fr] gap-3 p-3 rounded-sm bg-surface\"><span class=\"display num text-[1.6rem] leading-none text-muted\">7</span><div><p class=\"font-semibold\">Обнародване или вето</p><p class=\"text-[15px] text-muted\">Президентът подписва указ за обнародване в „Държавен вестник“ или връща закона с вето за ново обсъждане.</p></div></li></ol></section><section id=\"zakoni\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Законите в този парламент</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">62<!-- --> закона с поименни гласувания. Подробно за всеки — етап, вносители, становища, сигнали и двете страни.</p><ul class=\"divide-y divide-rule border-y border-rule max-w-5xl\"><li class=\"py-2 flex flex-wrap justify-between gap-x-4\"><a href=\"/parlament/zakon/regionalnoto-razvitie\">Закон за регионалното развитие</a><span class=\"text-sm text-muted\">19 ноември 2026 г.</span></li><li class=\"py-2 flex flex-wrap justify-between gap-x-4\"><a href=\"/parlament/zakon/zabrana-na-himicheskoto-orazhie-i-za-kontrol-na-toksichnite-himicheski-veshtestva-i-tehnite-prekursori\">Закон за забрана на химическото оръжие и за контрол на токсичните химически вещества и техните прекурсори</a><span class=\"text-sm text-muted\">19 ноември 2026 г.</span></li><li class=\"py-2 flex flex-wrap justify-between gap-x-4\"><a href=\"/parlament/zakon/hazarta\">Закон за хазарта</a><span class=\"text-sm text-muted\">19 ноември 2026 г.</span></li><li class=\"py-2 flex flex-wrap justify-between gap-x-4\"><a href=\"/parlament/zakon/vodite\">Закон за водите</a><span class=\"text-sm text-muted\">19 ноември 2026 г.</span></li><li class=\"py-2 flex flex-wrap justify-between gap-x-4\"><a href=\"/parlament/zakon/chuzhdentsite-v-republika-balgariya\">Закон за чужденците в Република България</a><span class=\"text-sm text-muted\">18 ноември 2026 г.</span></li><li class=\"py-2 flex flex-wrap justify-between gap-x-4\"><a href=\"/parlament/zakon/lova-i-opazvane-na-divecha\">Закон за лова и опазване на дивеча</a><span class=\"text-sm text-muted\">18 ноември 2026 г.</span></li><li class=\"py-2 flex flex-wrap justify-between gap-x-4\"><a href=\"/parlament/zakon/schetovodstvoto\">Закон за счетоводството</a><span class=\"text-sm text-muted\">18 ноември 2026 г.</span></li><li class=\"py-2 flex flex-wrap justify-between gap-x-4\"><a href=\"/parlament/zakon/nezavisimiya-finansov-odit-i-izrazyavaneto-na-sigurnost-po-ustoychivostta\">Закон за независимия финансов одит и изразяването на сигурност по устойчивостта</a><span class=\"text-sm text-muted\">18 ноември 2026 г.</span></li><li class=\"py-2 flex flex-wrap justify-between gap-x-4\"><a href=\"/parlament/zakon/aktsizite-i-danachnite-skladove\">Закон за акцизите и данъчните складове</a><span class=\"text-sm text-muted\">12 ноември 2026 г.<b class=\"text-red\"> · сигнал</b></span></li><li class=\"py-2 flex flex-wrap justify-between gap-x-4\"><a href=\"/parlament/zakon/danak-varhu-dobavenata-stoynost\">Закон за данък върху добавената стойност</a><span class=\"text-sm text-muted\">12 ноември 2026 г.</span></li><li class=\"py-2 flex flex-wrap justify-between gap-x-4\"><a href=\"/parlament/zakon/publichnite-finansi\">Закон за публичните финанси</a><span class=\"text-sm text-muted\">12 ноември 2026 г.</span></li><li class=\"py-2 flex flex-wrap justify-between gap-x-4\"><a href=\"/parlament/zakon/danatsite-varhu-dohodite-na-fizicheskite-litsa\">Закон за данъците върху доходите на физическите лица</a><span class=\"text-sm text-muted\">11 ноември 2026 г.</span></li></ul><p class=\"mt-3 font-semibold\"><a href=\"/parlament/zakoni\">Всички <!-- -->62<!-- --> закона</a></p></section><section id=\"firmi\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Депутати и фирми</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Депутати, които по Търговския регистър или декларациите си са собственици или управители на фирми. Участието във фирма не е нарушение; важно е, когато фирмата работи с държавата.</p><ul class=\"grid gap-2 sm:grid-cols-2 lg:grid-cols-3\"><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5268\">Румен Ангелов Миланов</a><p class=\"text-sm text-muted\">2<!-- --> <!-- -->фирми<!-- --> · <span><a href=\"/porachki/firma/121015330\">ЕИК <!-- -->121015330</a></span><span>, <a href=\"/porachki/firma/175884756\">ЕИК <!-- -->175884756</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5076\">Валентин Ботев Гечевски</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/204593913\">ЕИК <!-- -->204593913</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5086\">Иво Севдалинов Цанев</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/131476144\">ЕИК <!-- -->131476144</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5094\">Николай Иванов Косев</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/107564054\">ЕИК <!-- -->107564054</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5098\">Стоян Тонев Петров</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/204219357\">ЕИК <!-- -->204219357</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5111\">Калоян Тошков Иванов</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/204619226\">ЕИК <!-- -->204619226</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5165\">Валери Пламенов Лачовски</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/106510662\">ЕИК <!-- -->106510662</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5177\">Владимир Христов Гончев</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/102274111\">ЕИК <!-- -->102274111</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5197\">Йордан Йовчев Йовчев</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/831635354\">ЕИК <!-- -->831635354</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5198\">Галин Неделчев Дурев</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/831160078\">ЕИК <!-- -->831160078</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5201\">Стефан Иванов Цанков</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/115813904\">ЕИК <!-- -->115813904</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5204\">Маломир Василев Власов</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/116550331\">ЕИК <!-- -->116550331</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5205\">Рашид Мехмедов Узунов</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/116003561\">ЕИК <!-- -->116003561</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5206\">Надежда Георгиева Йорданова</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/175271486\">ЕИК <!-- -->175271486</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5213\">Слави Василев Василев</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/000620161\">ЕИК <!-- -->000620161</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5244\">Ивайло Николаев Мирчев</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/203010795\">ЕИК <!-- -->203010795</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5270\">Здравко Марков Марков</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/126519537\">ЕИК <!-- -->126519537</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5291\">Николай Денков Денков</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/175935973\">ЕИК <!-- -->175935973</a></span></p></li><li class=\"ring-1 ring-rule rounded-sm p-3 bg-white\"><a class=\"font-semibold\" href=\"/parlament/deputat/5296\">Рашко Георгиев Динков</a><p class=\"text-sm text-muted\">1<!-- --> <!-- -->фирма<!-- --> · <span><a href=\"/porachki/firma/203904037\">ЕИК <!-- -->203904037</a></span></p></li></ul></section><section id=\"proverka\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Как да проверите сами</h2><ul class=\"max-w-3xl list-disc pl-5 space-y-2 text-[15px]\"><li>Всяко гласуване води до стенограмата в parliament.bg. Всеки законопроект — до мотивите, докладите и становищата.</li><li>Всяка фирма води до Търговския регистър, договорите ѝ с държавата и реалните плащания (СЕБРА).</li><li>Липсващ документ (протокол, договор, сметка) може да се поиска по <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">ЗДОИ</button></span>. На страницата на всеки договор има готово заявление.</li><li>Видите ли грешка или пропуск, пишете ни: поправяме и отбелязваме поправката.</li></ul></section></div><!--$--><!--/$--></main><!--$--><!--/$--><footer class=\"bg-surface border-t border-rule mt-20\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 text-sm text-muted grid gap-2 sm:grid-cols-2\"><p>Не подкрепяме партия, кандидат или правителство. Всяко число има източник и дата.<!-- --> <a href=\"/metodologiya\">Как работим</a> · <a href=\"/rechnik\">Речник</a> · <a href=\"/sastoyanie\">Състояние на данните</a> · <!--$?--><template id=\"B:1\"></template><a href=\"/metodologiya#greshki\">Съобщи за грешка</a><!--/$--></p><p class=\"sm:text-right\">Вътрешен прототип · данните са към датите, посочени до тях</p></div></footer><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script id=\"_R_\">(globalThis[\"TURBOPACK\"] || (globalThis[\"TURBOPACK\"] = [])).push({\"otherChunks\":[\"static/chunks/310vm2bl3xxpt.js\",\"static/chunks/2vy51v46dlsq-.js\",\"static/chunks/2bx7ggprk0oi5.js\",\"static/chunks/0c1ad7rcpjghx.js\"],\"runtimeModuleIds\":[94553]});</script><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" async=\"\"></script><div hidden id=\"S:0\"><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items