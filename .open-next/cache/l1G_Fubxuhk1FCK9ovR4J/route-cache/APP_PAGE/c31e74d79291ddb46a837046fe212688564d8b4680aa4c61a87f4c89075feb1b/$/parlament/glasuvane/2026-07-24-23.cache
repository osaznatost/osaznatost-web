{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/glasuvane/layout,_N_T_/parlament/glasuvane/[id]/layout,_N_T_/parlament/glasuvane/[id]/page,_N_T_/parlament/glasuvane/2026-07-24-23"},"segmentPaths":["/_tree","/_full","/parlament/glasuvane/$d$id/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/c31e74d79291ddb46a837046fe212688564d8b4680aa4c61a87f4c89075feb1b/$/parlament/glasuvane/2026-07-24-23","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/glasuvane/[id]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2bx3suebn7wim.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Закон за държавния бюджет на Република България за 2026 г. - второ гласуване - ч · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Закон за държавния бюджет на Република България за 2026 г. - второ гласуване - ч · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Закон за държавния бюджет на Република България за 2026 г. - второ гласуване - ч · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Всички гласувания</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">24 юли 2026 г. · Второ четене: предложение на депутат</p><h1 class=\"text-2xl sm:text-[2rem] leading-snug font-bold tracking-tight max-w-4xl\">Закон за държавния бюджет на Република България за 2026 г. - второ гласуване - член 12 - предложение от Петър Петров №....102</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\"><span class=\"flex flex-wrap items-center gap-3 text-ink text-base\"><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-muted border border-rule\">Отхвърлено</span><span class=\"num\">За <b>12</b> · Против <b>42</b> · Въздържал се <b>160</b> · Отсъстващи <!-- -->26</span></span></div></div></div><section class=\"grid gap-5 lg:grid-cols-3 mb-12\"><div class=\"lg:col-span-3 bg-surface rounded-xl p-6\"><h2 class=\"display text-[2rem] mb-3\">За какво е това гласуване</h2><p class=\"text-[18px] max-w-3xl\">Петър Петров (Възраждане) предлага своя редакция. Това е предложение, което водещата комисия не е подкрепила, затова се гласува отделно в залата.</p><p class=\"text-sm mt-2\">Вносител на предложението: <a href=\"/parlament/deputat/5247\">Петър Петров</a>, Възраждане</p></div><div class=\"rounded-xl p-5 bg-white ring-1 ring-rule\"><p class=\"font-semibold mb-1\">Ако се приеме</p><p class=\"text-[15px]\">Текстът на закона се променя според предложението.</p></div><div class=\"rounded-xl p-5 bg-[#d2353f] text-white\"><p class=\"font-semibold mb-1\">Ако се отхвърли<!-- -->: това се случи</p><p class=\"text-[15px]\">Предложението отпада. Гласува се текстът във вида, предложен от комисията.</p></div><div class=\"rounded-xl p-5 bg-white ring-1 ring-rule\"><p class=\"font-semibold mb-1\">Законът</p><p class=\"text-[15px]\"><a href=\"/parlament/zakon/darzhavniya-byudzhet-na-republika-balgariya-za-2026-g\">Закон за държавния бюджет на Република България за 2026 г.</a>: всички гласувания по него<!-- --> и обяснение какво променя<!-- -->.</p><p class=\"text-sm mt-2\">За този конкретен текст още нямаме отделен разбор. Какво носи законът като цяло е описано по-долу.</p></div></section><section class=\"mb-12 max-w-4xl\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Какво променя законът</h2></div><p class=\"text-[17px]\">Бюджетът определя колко пари събира и харчи държавата през 2026 г. Планирани са приходи по консолидираната програма около 49,6 млрд. € и разходи около 56,8 млрд. €. Така дефицитът е 7,2 млрд. € или 5,7% от БВП, най-високият от 20 години. Позволен е нов дълг до 10,1 млрд. €, от които до 3,26 млрд. € е заем по европейския инструмент SAFE за отбрана. Максималният осигурителен доход става 2 300 € от 1 август.</p><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">„Прогресивна България“ и министърът на финансите Гълъб Донев</p><p class=\"text-[15px]\">Дефицитът е голям, защото бюджетът вади наяве скрити и наследени разходи. Приходите са планирани по-предпазливо, отколкото през 2025 г. Донев го нарече „смел, но не и безразсъден“.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Бюджет 2026, какво трябва да знаем (15.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a><a href=\"https://www.bta.bg/bg/news/bulgaria/1167584\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът прие на първо четене бюджета за 2026 г.\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Теменужка Петкова (ГЕРБ–СДС)</p><p class=\"text-[15px]\">Рекорден дефицит, занижена събираемост на приходите и отпаднали важни текстове.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Бюджет 2026, какво трябва да знаем (15.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Фискалният съвет</p><p class=\"text-[15px]\">Бюджетът трябва да се преработи. Без мерки дългът расте до около 51 млрд. € в края на 2028 г.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Асен Василев (ПП)</p><p class=\"text-[15px]\">Отпада публичният поименен списък с общинските проекти.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-3\">Какво казват данните</h3><ul class=\"space-y-2 list-none pl-0\"><li class=\"border-l-4 border-deep pl-4 text-[15px]\">Планиран дефицит: около 7,2 млрд. €, или 5,7% от БВП, най-високият от 20 години.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Бюджет 2026, какво трябва да знаем (15.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">За сравнение, през 2025 г. дефицитът е 4,0% от БВП по последните данни на Евростат (предварителните на НСИ бяха 3,5%).<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.nsi.bg/file/35225/notifikacionni_tablici_za_dalga_i_deficita_na_sektor_darjavno_upravlenie.pdf\" target=\"_blank\" rel=\"noreferrer\" title=\"НСИ: дефицит и дълг на сектор „Държавно управление“ за 2025 г. (предварителни данни)\" class=\"ml-0.5 no-underline\">[<!-- -->5<!-- -->]</a><a href=\"https://ec.europa.eu/eurostat/databrowser/view/gov_10dd_edpt1/default/table\" target=\"_blank\" rel=\"noreferrer\" title=\"Евростат: дефицит и дълг (gov_10dd_edpt1)\" class=\"ml-0.5 no-underline\">[<!-- -->7<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">Таван на новия дълг: 10,1 млрд. €, от които до 3,261 млрд. € са заем по европейския инструмент SAFE за отбрана.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/news/bulgaria/1167584\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът прие на първо четене бюджета за 2026 г.\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">До 28 юли 2026 г. реално поетият нов дълг е 4,01 млрд. €.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://bnrnews.bg/en/post/508409/bulgaria-with-new-domestic-debt-of-100-million-euros\" target=\"_blank\" rel=\"noreferrer\" title=\"БНР: нов вътрешен дълг от 100 млн. € (28.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->6<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">Бюджет 2025 планира 28,2 млрд. € приходи по централния бюджет, а събра 26,3 млрд. € (6,7% по-малко).<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></li></ul></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Двете страни на монетата</h3><p class=\"text-sm text-muted mb-3\">Какво следва на практика, ако законът се приеме и ако се отхвърли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Бюджет 2026, какво трябва да знаем (15.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a><a href=\"https://www.bta.bg/bg/news/bulgaria/1167584\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът прие на първо четене бюджета за 2026 г.\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></p><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\"><p class=\"font-semibold\">Ако се приеме</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Край на удължителния закон: заплатите, пенсиите и инвестициите се плащат по нов годишен план.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Дефицит от 5,7% от БВП и нов дълг до 10,1 млрд. €.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">По-големи разходи за лихви в следващите години.</li></ul></div></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\"><p class=\"font-semibold\">Ако се отхвърли</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Шанс за преработен бюджет с по-малък дефицит, както препоръчва Фискалният съвет.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Държавата продължава да работи по удължителния закон, без нови политики и с ограничени инвестиции.</li></ul></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Какво печели и какво губи всяка страна</h3><p class=\"text-sm text-muted mb-3\">Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.</p><div class=\"space-y-3\"><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Работещите с високи заплати<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Бюджет 2026, какво трябва да знаем (15.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a><a href=\"https://www.bta.bg/bg/news/bulgaria/1167584\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът прие на първо четене бюджета за 2026 г.\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">По-високи вноски означават по-голяма бъдеща пенсия.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Максималният осигурителен доход става 2 300 € от 1 август, затова плащат повече осигуровки.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Държавните служители и заетите в съдебната власт<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/news/bulgaria/1167584\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът прие на първо четене бюджета за 2026 г.\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">От 1 август започват поетапно да плащат сами личните си осигуровки. Ако заплатата не се компенсира, нетното им възнаграждение намалява.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Получателите на държавни плащания (заплати, пенсии, инвестиции)<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Бюджет 2026, какво трябва да знаем (15.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Плащанията са осигурени, въпреки че приходите не стигат.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">—</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Данъкоплатците и бъдещите поколения<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.bta.bg/bg/news/bulgaria/1167584\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът прие на първо четене бюджета за 2026 г.\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">По-голям дълг означава повече разходи за лихви в следващите години.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Общините и гражданите, които следят как се харчат парите<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\" title=\"„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Списъкът с общинските проекти вече не е публичен.</p></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-3\">Проверени твърдения</h3><ul class=\"space-y-3\"><li class=\"rounded-xl ring-1 ring-rule p-4 bg-white\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><p class=\"font-semibold\">„Събираемостта е силно занижена“ (Т. Петкова)</p><span class=\"text-sm font-semibold px-2.5 py-0.5 rounded-full bg-[#e2b33b] text-ink\">Подвеждащо</span></div><p class=\"text-[15px] text-muted mt-1\">Бюджет 2025, приет при нейното министерство, планира приходи по централния бюджет 28,2 млрд. €, а събра 26,3 млрд. € (−6,7%). Новият бюджет залага по-умерен ръст на приходите. Рискът е обратен: до май 2026 г. приходите растат само с 2%.</p></li><li class=\"rounded-xl ring-1 ring-rule p-4 bg-white\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><p class=\"font-semibold\">Текстовете за Националната детска болница са били във всеки бюджет от 2022 г. (А. Василев)</p><span class=\"text-sm font-semibold px-2.5 py-0.5 rounded-full bg-[#d2353f] text-white\">Невярно</span></div><p class=\"text-[15px] text-muted mt-1\">Текст има само в бюджетите за 2024 и 2025 г., и в двата без конкретна сума.</p></li><li class=\"rounded-xl ring-1 ring-rule p-4 bg-white\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><p class=\"font-semibold\">Отпада поименният списък с общинските проекти (А. Василев)</p><span class=\"text-sm font-semibold px-2.5 py-0.5 rounded-full bg-[#2f9e6a] text-white\">Вярно</span></div><p class=\"text-[15px] text-muted mt-1\">Приложение № 3 със списъка на проектите липсва. Правомощието на министъра не е ново, ново е, че списъкът вече не е публичен.</p></li></ul></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания 15.07.2026 и 24.07.2026, Народно събрание (чрез „Наясно“)</a></li><li><a href=\"https://github.com/atanasster/electionsbg/blob/main/public/articles/2026-07-25-budget-2026-adopted-bg.md\" target=\"_blank\" rel=\"noreferrer\">„Наясно“: Бюджет 2026 — приет на седмия месец, какво показват числата (25.07.2026)</a></li><li><a href=\"https://www.capital.bg/politika_i_ikonomika/ikonomika/2026/07/15/4935480_bjudjet_2026_kakvo_triabva_da_znaem/\" target=\"_blank\" rel=\"noreferrer\">Капитал: Бюджет 2026, какво трябва да знаем (15.07.2026)</a></li><li><a href=\"https://www.bta.bg/bg/news/bulgaria/1167584\" target=\"_blank\" rel=\"noreferrer\">БТА: Парламентът прие на първо четене бюджета за 2026 г.</a></li><li><a href=\"https://www.nsi.bg/file/35225/notifikacionni_tablici_za_dalga_i_deficita_na_sektor_darjavno_upravlenie.pdf\" target=\"_blank\" rel=\"noreferrer\">НСИ: дефицит и дълг на сектор „Държавно управление“ за 2025 г. (предварителни данни)</a></li><li><a href=\"https://bnrnews.bg/en/post/508409/bulgaria-with-new-domestic-debt-of-100-million-euros\" target=\"_blank\" rel=\"noreferrer\">БНР: нов вътрешен дълг от 100 млн. € (28.07.2026)</a></li><li><a href=\"https://ec.europa.eu/eurostat/databrowser/view/gov_10dd_edpt1/default/table\" target=\"_blank\" rel=\"noreferrer\">Евростат: дефицит и дълг (gov_10dd_edpt1)</a></li></ol><p class=\"text-xs text-muted mt-2\">Проверките на твърденията и анализът на изпълнението са по данните и анализа на „Наясно“ (MIT), сверени с поименните гласувания. Таблицата „Какво печели и какво губи всяка страна“ и последиците „ако се приеме / ако се отхвърли“ са наш анализ на текста и аргументите от източниците, не позиция на партия.<!-- --> Проверено: <!-- -->17 ноември 2026 г.</p></div></section><section class=\"mt-10 max-w-4xl\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласува всяка група</h2></div><div class=\"bg-surface rounded-xl p-5 mb-6\"><div class=\"space-y-2.5\" role=\"img\" aria-label=\"За 12, против 42, въздържали се 160, отсъстващи 26\"><div class=\"grid grid-cols-[7.5rem_1fr] sm:grid-cols-[10rem_1fr] gap-3 items-start\"><span class=\"text-[13px] leading-tight pt-px text-muted\">Прогресивна България</span><span class=\"flex flex-wrap gap-[3px]\"><span title=\"Пламен Красимиров Белов: против\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#d2353f;animation-delay:0ms\"></span><span title=\"Димитър Трифонов Здравков: против\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#d2353f;animation-delay:3ms\"></span><span title=\"Антонио Владимиров Василев: против\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#d2353f;animation-delay:6ms\"></span><span title=\"Красимир Андреев Папазов: против\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#d2353f;animation-delay:9ms\"></span><span title=\"Мирена Николаева Гуглева - Иванова: въздържал се\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#e2b33b;animation-delay:12ms\"></span><span title=\"Мария Тодорова Тодорова: въздържал се\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#e2b33b;animation-delay:15ms\"></span><span title=\"Олга Бориславова Борисова: въздържал се\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#e2b33b;animation-delay:18ms\"></span><span title=\"Георги Петков Илиев: въздържал се\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#e2b33b;animation-delay:21ms\"></span><span title=\"Николета Костова Тодорова: въздържал се\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#e2b33b;animation-delay:24ms\"></span><span title=\"Миролюб Адамов Адамов: въздържал се\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#e2b33b;animation-delay:27ms\"></span><span title=\"Ясен Щерев Щерев: въздържал се\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#e2b33b;animation-delay:30ms\"></span><span title=\"Александър Романов Узунов: въздържал се\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#e2b33b;animation-delay:33ms\"></span><span title=\"Диана Станчева Димитрова: въздържал се\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#e2b33b;animation-delay: