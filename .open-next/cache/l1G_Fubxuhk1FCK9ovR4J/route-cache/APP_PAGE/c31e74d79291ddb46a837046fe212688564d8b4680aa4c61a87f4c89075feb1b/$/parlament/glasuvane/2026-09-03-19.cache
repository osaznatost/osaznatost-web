",null,{\"className\":\"lg:col-span-3 bg-surface rounded-xl p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] mb-3\",\"children\":\"За какво е това гласуване\"}],[\"$\",\"p\",null,{\"className\":\"text-[18px] max-w-3xl\",\"children\":\"Ангел Янчев (Възраждане) предлага своя редакция на § 8. Това е предложение, което водещата комисия не е подкрепила, затова се гласува отделно в залата.\"}],\"$undefined\",[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":[\"Вносител на предложението: \",[\"$\",\"$L9\",null,{\"href\":\"/parlament/deputat/5074\",\"children\":\"Ангел Янчев\"}],\", Възраждане\"]}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-xl p-5 bg-white ring-1 ring-rule\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":[\"Ако се приеме\",false]}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"Текстът на закона се променя според предложението.\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"rounded-xl p-5 bg-[#d2353f] text-white\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":[\"Ако се отхвърли\",\": това се случи\"]}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"Предложението отпада. Гласува се текстът във вида, предложен от комисията.\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"rounded-xl p-5 bg-white ring-1 ring-rule\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Законът\"}],[[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"$L9\",null,{\"href\":\"/parlament/zakon/vissheto-obrazovanie\",\"children\":\"Закон за висшето образование\"}],\": всички гласувания по него\",\" и обяснение какво променя\",\".\"]}],false,[\"$\",\"p\",null,{\"className\":\"text-sm mt-2\",\"children\":\"За този конкретен текст още нямаме отделен разбор. Какво носи законът като цяло е описано по-долу.\"}],\"$undefined\"]]}]]}],[\"$\",\"section\",null,{\"className\":\"mb-12 max-w-4xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb-5\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] sm:text-[2.4rem]\",\"children\":\"Какво променя законът\"}],\"$undefined\"]}],[\"$\",\"p\",null,{\"className\":\"text-[17px]\",\"children\":\"Минималната такса за студентите в платено обучение пада от 60 на 50% от издръжката на обучение в направлението (плюс таксата за държавна поръчка), а за целия срок на обучение таксата на един студент не може да се увеличи с повече от 20% спрямо първата година. Академичните съвети сами определят таксите за кандидатстване, без утвърждаване от Министерския съвет. Стипендии от бюджета ще получават студентите в редовна форма на субсидирани от държавата места. Образованието от официални регистри се проверява служебно.\"}],[[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-2 mt-8\",\"children\":[\"$L1a\",\"$L1b\"]}],null,\"$L1c\",\"$L1d\",null,\"$L1e\"]]}],\"$L1f\",\"$L20\",\"$L21\",\"$L22\"]}]\n1a:[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-green bg-surface\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Мотивите на вносителите\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Министър проф. Георги ВълчевТаванът от 20% за це\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Министър проф. Георги Вълчев\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Таванът от 20% за целия срок дава предвидимост и не позволява таксата да стане непосилна по средата на обучението; по-ниските такси правят българските университети по-привлекателни и за чуждестранни студенти.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167512\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\