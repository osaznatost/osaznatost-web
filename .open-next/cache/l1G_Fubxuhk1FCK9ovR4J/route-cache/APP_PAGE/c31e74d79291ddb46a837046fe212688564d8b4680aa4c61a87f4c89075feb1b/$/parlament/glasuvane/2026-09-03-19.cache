{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/glasuvane/layout,_N_T_/parlament/glasuvane/[id]/layout,_N_T_/parlament/glasuvane/[id]/page,_N_T_/parlament/glasuvane/2026-09-03-19"},"segmentPaths":["/_tree","/_full","/parlament/glasuvane/$d$id/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/c31e74d79291ddb46a837046fe212688564d8b4680aa4c61a87f4c89075feb1b/$/parlament/glasuvane/2026-09-03-19","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/glasuvane/[id]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2bx3suebn7wim.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>ЗИД на Закона за висшето образование - второ гласуване - параграф 8 - предложени · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"ЗИД на Закона за висшето образование - второ гласуване - параграф 8 - предложени · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"ЗИД на Закона за висшето образование - второ гласуване - параграф 8 - предложени · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Всички гласувания</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">3 септември 2026 г. · Второ четене: предложение на депутат</p><h1 class=\"text-2xl sm:text-[2rem] leading-snug font-bold tracking-tight max-w-4xl\">ЗИД на Закона за висшето образование - второ гласуване - параграф 8 - предложение от Ангел Янчев</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\"><span class=\"flex flex-wrap items-center gap-3 text-ink text-base\"><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-muted border border-rule\">Отхвърлено</span><span class=\"num\">За <b>16</b> · Против <b>117</b> · Въздържал се <b>25</b> · Отсъстващи <!-- -->82</span></span></div></div></div><section class=\"grid gap-5 lg:grid-cols-3 mb-12\"><div class=\"lg:col-span-3 bg-surface rounded-xl p-6\"><h2 class=\"display text-[2rem] mb-3\">За какво е това гласуване</h2><p class=\"text-[18px] max-w-3xl\">Ангел Янчев (Възраждане) предлага своя редакция на § 8. Това е предложение, което водещата комисия не е подкрепила, затова се гласува отделно в залата.</p><p class=\"text-sm mt-2\">Вносител на предложението: <a href=\"/parlament/deputat/5074\">Ангел Янчев</a>, Възраждане</p></div><div class=\"rounded-xl p-5 bg-white ring-1 ring-rule\"><p class=\"font-semibold mb-1\">Ако се приеме</p><p class=\"text-[15px]\">Текстът на закона се променя според предложението.</p></div><div class=\"rounded-xl p-5 bg-[#d2353f] text-white\"><p class=\"font-semibold mb-1\">Ако се отхвърли<!-- -->: това се случи</p><p class=\"text-[15px]\">Предложението отпада. Гласува се текстът във вида, предложен от комисията.</p></div><div class=\"rounded-xl p-5 bg-white ring-1 ring-rule\"><p class=\"font-semibold mb-1\">Законът</p><p class=\"text-[15px]\"><a href=\"/parlament/zakon/vissheto-obrazovanie\">Закон за висшето образование</a>: всички гласувания по него<!-- --> и обяснение какво променя<!-- -->.</p><p class=\"text-sm mt-2\">За този конкретен текст още нямаме отделен разбор. Какво носи законът като цяло е описано по-долу.</p></div></section><section class=\"mb-12 max-w-4xl\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Какво променя законът</h2></div><p class=\"text-[17px]\">Минималната такса за студентите в платено обучение пада от 60 на 50% от издръжката на обучение в направлението (плюс таксата за държавна поръчка), а за целия срок на обучение таксата на един студент не може да се увеличи с повече от 20% спрямо първата година. Академичните съвети сами определят таксите за кандидатстване, без утвърждаване от Министерския съвет. Стипендии от бюджета ще получават студентите в редовна форма на субсидирани от държавата места. Образованието от официални регистри се проверява служебно.</p><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Министър проф. Георги Вълчев</p><p class=\"text-[15px]\">Таванът от 20% за целия срок дава предвидимост и не позволява таксата да стане непосилна по средата на обучението; по-ниските такси правят българските университети по-привлекателни и за чуждестранни студенти.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167512\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-36 и доклад на образователната комисия\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Ректорите на СУ и НАТФИЗ и синдикат „Висше образование и наука“</p><p class=\"text-[15px]\">Подкрепиха законопроекта при публичното обсъждане.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167512\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-36 и доклад на образователната комисия\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Николай Денков и Павел Попов (ПП–ДБ)</p><p class=\"text-[15px]\">Държавата трябва да подкрепя и отличните студенти в платено обучение; всяка стипендия трябва да се преценява според целта си. Ограничаването на държавните стипендии само до местата с държавна поръчка изключва платените студенти.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167512\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-36 и доклад на образователната комисия\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Двете страни на монетата</h3><p class=\"text-sm text-muted mb-3\">Какво следва на практика, ако законът се приеме и ако се отхвърли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167512\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-36 и доклад на образователната комисия\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\"><p class=\"font-semibold\">Ако се приеме</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Предвидими такси и по-достъпно платено обучение.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Част от студентите губят достъп до държавни стипендии.</li></ul></div></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\"><p class=\"font-semibold\">Ако се отхвърли</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Неясни правила за таксите преди учебната година.</li></ul></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Какво печели и какво губи всяка страна</h3><p class=\"text-sm text-muted mb-3\">Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.</p><div class=\"space-y-3\"><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Студенти в платено обучение<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167512\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-36 и доклад на образователната комисия\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">По-ниска минимална такса и таван на увеличението до 20% за целия срок.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Нямат право на стипендия от държавния бюджет.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Висши училища<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167512\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-36 и доклад на образователната комисия\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Сами определят таксите за кандидатстване.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">По-малко приходи от платени студенти, ако намалят таксите.</p></div></div></div></div></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://www.parliament.bg/bg/bills/ID/167512\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-602-01-36 и доклад на образователната комисия</a></li><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания, Народно събрание (чрез „Наясно“)</a></li></ol><p class=\"text-xs text-muted mt-2\">Обобщението е по доклада на комисията по образованието.<!-- --> Проверено: <!-- -->19 ноември 2026 г.</p></div></section><section class=\"mt-10 max-w-4xl\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласува всяка група</h2></div><div class=\"bg-surface rounded-xl p-5 mb-6\"><div class=\"space-y-2.5\" role=\"img\" aria-label=\"За 16, против 117, въздържали се 25, отсъстващи 82\"><div class=\"grid grid-cols-[7.5rem_1fr] sm:grid-cols-[10rem_1fr] gap-3 items-start\"><span class=\"text-[13px] leading-tight pt-px text-muted\">Прогресивна България</span><span class=\"flex flex-wrap gap-[3px]\"><span title=\"Мартин Мариов Жлябинков: за\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#2f9e6a;animation-delay:0ms\"></span><span title=\"Светлана Русева Митошева: за\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#2f9e6a;animation-delay:3ms\"></span><span title=\"Даниел Славеев Парушев: за\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#2f9e6a;animation-delay:6ms\"></span><span title=\"Мария Тодорова Тодорова: против\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#d2353f;animation-delay:9ms\"></span><span title=\"Георги Петков Илиев: против\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#d2353f;animation-delay:12ms\"></span><span title=\"Пламен Красимиров Белов: против\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#d2353f;animation-delay:15ms\"></span><span title=\"Миролюб Адамов Адамов: против\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#d2353f;animation-delay:18ms\"></span><span title=\"Ясен Щерев Щерев: против\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#d2353f;animation-delay:21ms\"></span><span title=\"Александър Романов Узунов: против\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#d2353f;animation-delay:24ms\"></span><span title=\"Диана Станчева Димитрова: против\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#d2353f;animation-delay:27ms\"></span><span title=\"Георги Александров Чакъров: против\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#d2353f;animation-delay:30ms\"></span><span title=\"Янка Тенева Тянкова: против\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#d2353f;animation-delay:33ms\"></span><span title=\"Лилия Маринова Димитрова: против\" class=\"board-dot inline-block rounded-full\" style=\"width:12px;height:12px;background:#d2353f;animation-delay:36ms\"></span><span titl