l,{\\\"id\\\":\\\"dokumenti\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Още от документите\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":\\\"Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-4 max-w-4xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"167217\\\",{\\\"className\\\":\\\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted\\\",\\\"children\\\":\\\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mt-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167217\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"className\\\":\\\"text-ink\\\",\\\"children\\\":\\\"Законопроект за изменение и допълнение на Закона за държавния служител\\\"}],\\\" \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-muted num font-normal\\\",\\\"children\\\":[\\\"№ \\\",\\\"52-602-01-26\\\"]}]]}],[\\\"$\\\",\\\"details\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer font-semibold text-green mt-2\\\",\\\"children\\\":\\\"Покажи цитатите\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-5 mt-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-green pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Какво предлага законопроектът\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"Г-н Апдула уточни, че се предвижда въвеждането на механизъм за проверка на почтеността на служителите, заемащи длъжности с висок корупционен риск в централната изпълнителна власт преди назначаване, при повишаване на по-висока ръководна длъжност и въз основата на резултати от проверка, извършена от инспекторатите.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"Със законопроекта се осигурява достатъчна функционална независимост на инспекторатите по чл. 46 и 46а от Закона за администрацията чрез въвеждане на ограничения по отношение на делегирането на правомощия на орган по назначаването спрямо инспекторатите и Главния инспекторат и избягване на неправомерна намеса в дейността им.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[\\\"„\\\",\\\"Предвижда се повишаване ефективността и привлекателността на стипендиантската програма в държавната администрация, както и подобряване на нормативната уредба на обученията за професионално и служебно развитие в държавната администрация.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[\\\"„\\\",\\\"В областта на развитие на човешките ресурси в администрацията предложеният ЗИД на ЗДСл е в изпълнение на: ь Приоритетна препоръка 1 на Комитета за публично управление (КПУ) на ОИСР за изграждане на адаптивна и гъвкава система за заетост и управление в публичния сектор, която предвижда надграждане на съществуващите инструменти за трансформация на държавната администрация.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"children\\\":[\\\"„\\\",\\\"Във връзка с това се предвижда тестове за почтеност да се провеждат при назначаване, при повишаване в по-висока длъжност и при одобрена от органа по назначаването мотивирана препоръка на инспекторат по чл. 46 и 46а от Закона за администрацията по отношение на лице, заемащо длъжност с висок корупционен риск. 2.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"5\\\",{\\\"children\\\":[\\\"„\\\",\\\"Програмата предвижда администрациите да подават мотивирани предложения, въз основа на които Министерският съвет да определя с решение списък на специалностите, за които в отделните администрации съществува недостиг на експерти и за които могат да се предоставят стипендии на студенти през следващата календарна година.\\\",\\\"“\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted mt-1\\\",\\\"children\\\":[\\\"Източник: \\\",\\\"$L27\\\"]}]]}],\\\"$L28\\\",\\\"$L29\\\",false,\\\"$L2a\\\"]}]]}]]}],\\\"$L2b\\\"]}]]}]\\n1f:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"mnenie\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Твоето мнение\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":[\\\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \\\",[\\\"$\\\",\\\"$La\\\",null,{\\\"href\\\":\\\"/mnenie\\\",\\\"children\\\":\\\"Всички закони за гласуване\\\"}],\\\".\\\"]}],[\\\"$\\\",\\\"$L2c\\\",null,{\\\"item\\\":\\\"darzhavniya-sluzhitel\\\",\\\"question\\\":\\\"Подкрепяш ли последните промени в „Закон за държавния служител (проверки за почтеност)“?\\\"}]]}]\\n20:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"grupi\\\",\\\"className\\\":\\\"mb-12 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-end justify-between gap-4 mb-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2rem] sm:text-[2.4rem]\\\",\\\"children\\\":\\\"Как гласуваха групите по този закон\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted mb-3\\\",\\\"children\\\":[\\\"Брой гласувания, в к