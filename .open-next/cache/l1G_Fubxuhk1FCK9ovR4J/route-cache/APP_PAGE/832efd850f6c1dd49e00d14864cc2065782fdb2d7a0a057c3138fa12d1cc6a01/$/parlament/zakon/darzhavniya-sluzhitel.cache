 проектКонкурсът за държавн\\\",{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm font-semibold\\\",\\\"children\\\":\\\"Божидар Божанов (ДБ), за отхвърления проект\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px]\\\",\\\"children\\\":[\\\"Конкурсът за държавна служба да има централизиран етап с тестове в Института по публична администрация, всички настоящи служители да минат теста, а щатовете да се намалят след функционални анализи.\\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs whitespace-nowrap\\\",\\\"children\\\":[\\\" \\\",[[\\\"$\\\",\\\"a\\\",\\\"1\\\",{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167217\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"title\\\":\\\"Народно събрание: законопроект № 52-602-01-26 и доклад на правната комисия (28.07.2026)\\\",\\\"className\\\":\\\"ml-0.5 no-underline\\\",\\\"children\\\":[\\\"[\\\",1,\\\"]\\\"]}]]]}]]}]]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"display text-[1.6rem] mb-3\\\",\\\"children\\\":\\\"Какво казват критиците\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"Народните представители в правната комисияПравителственият зак\\\",{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm font-semibold\\\",\\\"children\\\":\\\"Народните представители в правната комисия\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px]\\\",\\\"children\\\":[\\\"Правителственият законопроект има нужда от прецизиране.\\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs whitespace-nowrap\\\",\\\"children\\\":[\\\" \\\",[[\\\"$\\\",\\\"a\\\",\\\"1\\\",{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167217\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"title\\\":\\\"Н