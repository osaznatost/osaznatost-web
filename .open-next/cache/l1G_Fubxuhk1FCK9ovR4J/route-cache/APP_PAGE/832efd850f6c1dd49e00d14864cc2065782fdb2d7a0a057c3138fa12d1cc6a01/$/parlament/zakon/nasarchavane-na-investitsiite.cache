 space-y-0.5\",\"children\":[[\"$\",\"li\",\"https://www.parliament.bg/bg/bills/ID/167004\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167004\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Народно събрание: законопроект № 52-654-01-39, доклади и становища\"}]}],[\"$\",\"li\",\"https://naiasno.bg/parliament\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://naiasno.bg/parliament\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Поименни гласувания, Народно събрание (чрез „Наясно“)\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-2\",\"children\":[\"Обобщението е по доклада на правната комисия.\",\" Проверено: \",\"19 ноември 2026 г.\"]}]]}]\n2b:[\"$\",\"div\",null,{\"className\":\"border-l-4 border-red pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Възражения и критики\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Г-н Петров посочи, че няма да подкрепи законопроекта, тъй като ПГ ВЪЗРАЖДАНЕ изразява резерви относно създаването на Координационен съвет по инвестициите към Министерски съвет.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167004\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}]\n2c:[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#e08a2e] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"В пленарната зала\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"b\",null,{\"children\":\"Даниел Парушев\"}],[\"$\",\"span\",null,{\"className\":\"text-muted\",\"children\":[\" (\",\"ПБ\",\")\"]}],\": „\",\"Позволете ми, преди да стартирам със Законопроекта и със становището, което съм изготвил, да се обърна към Вас, уважаеми\",\"“ \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11126\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm whitespace-nowrap\",\"children\":[\"стенограма, \",\"15.05.2026\"]}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"b\",null,{\"children\":\"Александър Иванов\"}],[\"$\",\"span\",null,{\"className\":\"text-muted\",\"children\":[\" (\",\"ГЕРБ-СДС\",\")\"]}],\": „\",\"Първо да подчертая следното, че… За пореден път ще изтъкна това, което заявихте от „Прогресивна България“ – че практиката за внасяне на законопроекти от народни представители ще я избягвате. Това е направено обаче към сегашния законопроект, в което няма нищо лошо, при положение че се бърза, защото хората очакват бързи и адекватни мерки. Единствено упрекът ми е по това, че настоящият законопроект би следвало да се…\",\"“ \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11126\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm whitespace-nowrap\",\"children\":[\"стенограма, \",\"15.05.2026\"]}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"b\",null,{\"children\":\"Костадин Костадинов\"}],[\"$\",\"span\",null,{\"className\":\"text-muted\",\"children\":[\" (\",\"ВЪЗРАЖДАНЕ\",\")\"]}],\": „\",\"Законопроектът до голям степен, както беше заявен и от вносителя, е технически, да не кажем, откровено формален, което до някаква степен обезсмисля обаче изключително въодушевения тон, с който завърши становището, защото там се говореше,\",\"“ \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11126\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm whitespace-nowrap\",\"children\":[\"стенограма, \",\"15.05.2026\"]}]]}]]}]]}]\n2d:[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"Стелиан Томов относно закон