",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mt-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167512\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"className\\\":\\\"text-ink\\\",\\\"children\\\":\\\"Законопроект за изменение и допълнение на Закона за висшето образование\\\"}],\\\" \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-muted num font-normal\\\",\\\"children\\\":[\\\"№ \\\",\\\"52-602-01-36\\\"]}]]}],[\\\"$\\\",\\\"details\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer font-semibold text-green mt-2\\\",\\\"children\\\":\\\"Покажи цитатите\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-5 mt-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-green pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Какво предлага законопроектът\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"Това се съчетава с ограничението за целия срок на обучението на всеки студент за съответната образователно-квалификационна степен, този размер да не може да се увеличава общо с повече от 20 на сто спрямо определения през първата година от обучението, дори ако максимално допустимият увеличен размер е под законово определения минимум.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"Друга предвидена в законопроекта промяна допълва функциите на академичните съвети да определят таксите за кандидатстване във висшите училища, без да е необходимо тези такси да се утвърждават от Министерския съвет.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[\\\"„\\\",\\\"Прецизира се законовата уредба относно правото на студентите и докторантите да получават стипендии от държавния бюджет и се отговаря на необходимостта от нормативно уреждане на кръга на правоимащите лица.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[\\\"„\\\",\\\"В тази връзка законопроектът предвижда стипендии от държавния бюджет да се предоставят на студентите, обучаващи се в редовна форма на места, субсидирани от държавата.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"children\\\":[\\\"„\\\",\\\"С нея се въвежда принципът на служебното събиране на информация, когато тя е налична в официални регистри, като същевременно се запазва възможност за доказване чрез документ в изрично определени хипотези.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"5\\\",{\\\"children\\\":[\\\"„\\\",\\\"Всички народни представители, които взеха участие в дискусията изразиха принципна подкрепа за необходимостта да се регламентират с трайно решение студентските такси и стипендии преди започването на новата учебната година, както и намаляването на административната тежест при проверката на дипломи издадени в чужди държави.\\\",\\\"“\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted mt-1\\\",\\\"children\\\":[\\\"Източник: \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167512\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":\\\"доклад на комисията и мотиви, parliament.bg\\\"}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-[#8a8f8c] pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Позиции, изказани в комисията\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"Народните представители Николай Денков и Павел Попов подкрепиха част от предложените със законопроекта промени, но посочиха, че държавата трябва да намери начин да подпомага и студентите, които се обучават в платена форма на обучение и показват високи резултати в учебната и научно-изследователската дейност, както и че всяка стипендия трябва да се разглежда в съответствие с нейната целесъобразност.\\\",\\\"“\\\"]}],\\\"$L28\\\"]}],\\\"$L29\\\"]}],\\\"$L2a\\\",\\\"$L2b\\\",\\\"$L2c\\\"]}]]}]]}]]}]]}]\\n1f:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"mnenie\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Твоето мнение\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":[\\\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \\\",[\\\"$\\\",\\\"$La\\\",null,{\\\"href\\\":\\\"/mnenie\\\",\\\"children\\\":\\\"Всички закони за гласуване\\\"}],\\\".\\\"]}],[\\\"$\\\",\\\"$L2d\\\",null,{\\\"item\\\":\\\"vissheto-obrazovanie\\\",\\\"question\\\":\\\"Подкрепяш ли последните промени в „Закон за висшето образование (такси за платено обучение и стипендии)“?\\\"}]]}]\\n20:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"grupi\\\",\\\"className\\\":\\\"mb-12 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-end justify-between gap-4 mb-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2rem] sm:text-[2.4rem]\\\",\\\"children\\\":\\\"Как гласуваха групите по този закон\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted mb-3\\\",\\\"children\\\":[\\\"Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо \\\",16,\\\". Прието: \\\",12,\\\", отхвърлено: \\\",4,\\\".\\\"]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"