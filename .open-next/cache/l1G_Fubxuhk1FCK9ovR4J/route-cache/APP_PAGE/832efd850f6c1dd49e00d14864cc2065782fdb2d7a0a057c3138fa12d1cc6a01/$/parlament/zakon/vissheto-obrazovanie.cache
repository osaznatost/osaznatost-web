",null,{\"href\":\"#zakonoproekti\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Кой внесе и кой се изказа\"}]}]\n17:[\"$\",\"li\",\"argumenti\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#argumenti\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Двете страни\"}]}]\n18:[\"$\",\"li\",\"mnenie\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#mnenie\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Твоето мнение\"}]}]\n19:[\"$\",\"li\",\"grupi\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#grupi\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Как гласуваха\"}]}]\n1a:[\"$\",\"li\",\"glasuvaniya\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#glasuvaniya\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Гласувания (16)\"}]}]\n1b:[\"$\",\"section\",null,{\"id\":\"nakratko\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Накратко\"}],\"$undefined\",[\"$\",\"div\",null,{\"className\":\"max-w-4xl\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[17px]\",\"children\":\"Минималната такса за студентите в платено обучение пада от 60 на 50% от издръжката на обучение в направлението (плюс таксата за държавна поръчка), а за целия срок на обучение таксата на един студент не може да се увеличи с повече от 20% спрямо първата година. Академичните съвети сами определят таксите за кандидатстване, без утвърждаване от Министерския съвет. Стипендии от бюджета ще получават студентите в редовна форма на субсидирани от държавата места. Образованието от официални регистри се проверява служебно.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Вносители:\"}],\" \",\"Министерският съвет (представи министърът на образованието проф. Георги Вълчев)\",[\" · \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167512\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"законопроект \",\"52-602-01-36\"]}]]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Какво се случи:\"}],\" \",\"Първо четене на 27.08.2026 г. (134 „за“, 0 „против“; ГЕРБ–СДС, ДБ и ПП се въздържаха); срокът за предложения беше намален на три дни, за да е готов законът преди учебната година. Окончателно приет на 03.09.2026 г.\"]}]]}]]}]\n1c:[\"$\",\"section\",null,{\"id\":\"signali\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Сигнали\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.\"}],[[\"$\",\"ul\",null,{\"className\":\"grid gap-3 md:grid-cols-2 max-w-5xl\",\"children\":[[\"$\",\"li\",\"Съкратен срок за предложения (3 дни)\",{\"className\":\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Съкратен срок за предложения (3 дни)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Мнозинството гласува по-кратък срок от обичайните 7 дни, в който депутатите могат да внасят промени между първо и второ четене.\"}]]}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3\",\"children\":[\"$\",\"$La\",null,{\"href\":\"/parlament/signali\",\"children\":\"Всички сигнали в парламента\"}]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-2\",\"children\":[\"Сигналът е повод за въпрос, не доказателство за нарушение.\",\" \",[\"$\",\"$La\",null,{\"href\":\"/metodologiya#signal\",\"className\":\"underline\",\"children\":\"Как работим със сигналите\"}]]}]]]}]\n1d:[\"$\",\"section\",null,{\"id\":\"zakonoproekti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Кой внесе и кой се изказа\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.\"}],[[\"$\",\"ul\",null,{\"className\":\"space-y-4 max-w-5xl\",\"children\":[[\"$\",\"li\",\"167512\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167512\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за висшето образование\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-602-01-36\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"10 август 2026 г.\",\" от \",\"Министерския съвет\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по образованието и науката (водеща); Комисия по бюджет и финанси (участваща)\"}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Становища\"}],[\"$\",\"dd\",null,{\"children\":\"Варненски свободен университет \\\"Черноризец храбър\\\" относно Законопроект за изменение и допълнение на Закона за висшето образование, № 52-602-01-36 от 10.08.2026 г. внесен от МС; Съвета на ректорите на висшите училища относно Законопроект за изменение и допълнение на Закона за висшето образование, № 52-602-01-36 от 10.08.2026 г. внесен от МС; Омбудсмана на Република България относно Законопроект за изменение и допълнение на Закона за висшето образование, № 52-602-01-36 от 10.08.2026 г. внесен от МС (първо гласуване); НПСС относно Законопроект за изменение и допълнение на Закона за висшето образование, № 52-602-01-36 от 10.08.2026 г. внесен от МС (първо гласуване); граждани относно Законопроект за изменение и допълнение на Закона за висшето образование, № 52-602-01-36 от 10.08.2026 г. внесен от МС (първо гласуване); Комисията за защита от дискриминация относно Законопроект за изменение и допълнение на Закона за висшето образование, № 52-602-01-36 от 10.08.2026 г. внесен от МС\"}]],false,false,false,[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Предложения\"}],[\"$\",\"dd\",null,{\"children\":[2,\" писмени предложения на депутати между \",[\"$\",\"$L2f\",null,{\"k\":\"parvo-chetene\",\"children\":\"първо\"}],\" и \",[\"$\",\"$L2f\",null,{\"k\":\"vtoro-chetene\",\"children\":\"второ четене\"}]]}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"В залата\"}],[\"$\",\"dd\",null,{\"children\":[[\"$\",\"span\",\"0\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11162\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"27 август 2026 г.\"}],\" (\",\"зала първо гласуване\",\")\"]}],[\"$\",\"span\",\"1\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11165\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"3 септември 2026 г.\"}],\" (\",\"зала второ гласуване\",\")\"]}]]}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Обнародван\"}],[\"$\",\"dd\",null,{\"children\":[\"ДВ, бр. 85/2026\",\", приет на 3 септември 2026 г.\"]}]]]}]]}]]}],false]]}]\n1e:[\"$\",\"div\",null,{\"id\":\"argumenti\",\"className\":\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-2 mt-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-green bg-surface\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Мотивите на вносителите\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Министър проф. Георги ВълчевТаванът от 20% за це\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Министър проф. Георги Вълчев\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Таванът от 20% за целия срок дава предвидимост и не позволява таксата да стане непосилна по средата на обучението; по-ниските такси правят българските университети по-привлекателни и за чуждестранни студенти.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167512\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-36 и доклад на образователната комисия\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Ректорите на СУ и НАТФИЗ и синдикат „Висше образование и наука“Подкрепиха законопро\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Ректорите на СУ и НАТФИЗ и синдикат „Висше образование и наука“\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Подкрепиха законопроекта при публичното обсъждане.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167512\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-36 и доклад на образователната комисия\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Какво казват критиците\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Николай Денков и Павел Попов (ПП–ДБ)Държавата трябва да \",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Николай Денков и Павел Попов (ПП–ДБ)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Държавата трябва да подкрепя и отличните студенти в платено обучение; всяка стипендия трябва да се преценява според целта си. Ограничаването на държавните стипендии само до местата с държавна поръчка изключва платените студенти.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167512\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-36 и доклад на образователната комисия\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}]]}]]}]]}],null,[\"$\",\"div\",null,{\"className\":\"mt-8\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.8rem] mb-1\",\"children\":\"Двете страни на монетата\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mb-3\",\"children\":[\"Какво следва на практика, ако законът се приеме и ако се отхвърли.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167512\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-36 и доклад на образователната комисия\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Ако се приеме\"}],[\"$\",\"div\",null,{\"className\":\"space-y-2 mt-3\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-[#2f7d57]\",\"children\":\"Добрата страна\"}],[\"$\",\"ul\",null,{\"className\":\"list-none pl-0 space-y-1\",\"children\":[\"$L30\"]}]]}],\"$L31\"]}]]}],\"$L32\"]}]]}],\"$L33\",null,\"$L34\"]}]\n1f:[\"$\",\"section\",null,{\"id\":\"dokumenti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Още от документите\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 max-w-4xl\",\"children\":[[\"$\",\"div\",\"167512\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167512\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за висшето образование\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-602-01-36\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Това се съчетава с ограничението за целия срок на обучението на всеки студент за съответната образователно-квалификационна степен, този размер да не може да се увеличава общо с повече от 20 на сто спрямо определения през първата година от обучението, дори ако максимално допустимият увеличен размер е под законово определения минимум.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Друга предвидена в законопроекта промяна допълва функциите на академичните съвети да определят таксите за кандидатстване във висшите училища, без да е необходимо тези такси да се утвърждават от Министерския съвет.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Прецизира се законовата уредба относно правото на студентите и докторантите да получават стипендии от държавния бюджет и се отговаря на необходимостта от нормативно уреждане на кръга на правоимащите лица.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"В тази връзка законопроектът предвижда стипендии от държавния бюджет да се предоставят на студентите, обучаващи се в редовна форма на места, субсидирани от държавата.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"С нея се въвежда принципът на служебното събиране на информация, когато тя е налична в официални регистри, като същевременно се запазва възможност за доказване чрез документ в изрично определени хипотези.\",\"“\"]}],[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"Всички народни представители, които взеха участие в дискусията изразиха принципна подкрепа за необходимостта да се регламентират с трайно решение студентските такси и стипендии преди започването на новата учебната година, както и намаляването на административната тежест при проверката на дипломи издадени в чужди държави.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167512\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#8a8f8c] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Позиции, изказани в комисията\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Народните представители Николай Денков и Павел Попов подкрепиха част от предложените със законопроекта промени, но посочиха, че държавата трябва да намери начин да подпомага и студентите, които се обучават в платена форма на обучение и показват високи резултати в учебната и научно-изследователската дейност, както и че всяка стипендия трябва да се разглежда в съответствие с нейната целесъобразност.\",\"“\"]}],\"$L35\"]}],\"$L36\"]}],\"$L37\",\"$L38\",\"$L39\"]}]]}]]}]]}]]}]\n20:[\"$\",\"section\",null,{\"id\":\"mnenie\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Твоето мнение\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":[\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \",[\"$\",\"$La\",null,{\"href\":\"/mnenie\",\"children\":\"Всички закони за гласуване\"}],\".\"]}],[\"$\",\"$L3a\",null,{\"item\":\"vissheto-obrazovanie\",\"question\":\"Подкрепяш ли последните промени в „Закон за висшето образование (такси за платено обучение и стипендии)“?\"}]]}]\n21:[\"$\",\"section\",null,{\"i