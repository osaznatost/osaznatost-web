tion\\\",null,{\\\"id\\\":\\\"nakratko\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Накратко\\\"}],\\\"$undefined\\\",[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"max-w-4xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[17px]\\\",\\\"children\\\":\\\"Основните промени, внесени от Явор Гечев („Прогресивна България“), забраняват повишаване на цените, когато то не е икономически обосновано. Законът изрежда кои фактори могат да оправдаят поскъпване: по-високи разходи за доставка и производство, труд, енергия. Големите търговци с оборот над 5,1 млн. € трябва всеки ден да публикуват цените си в машинночетим вид за храни, напитки, тютюн, нехранителни стоки и лекарства. Част от правилата от Закона за въвеждане на еврото се пренасят тук и се удължават с една година. Отделно през юли беше приет на първо четене и друг законопроект на Министерския съвет за безопасността на продуктите.\\\"}],\\\"$undefined\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"children\\\":\\\"Какво се случи:\\\"}],\\\" \\\",\\\"На първо четене (14 май) „за“ гласуваха 121 депутати от „Прогресивна България“ и 15 от ДПС. „Против“ бяха ПП и „Възраждане“, част от ДБ и ГЕРБ–СДС. Останалите от ДБ и ГЕРБ–СДС се въздържаха.\\\"]}]]}]]}],false,[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"zakonoproekti\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Кой внесе и кой се изказа\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":\\\"$L1b\\\"}],[\\\"$L1c\\\",false]]}],\\\"$L1d\\\",\\\"$L1e\\\",\\\"$L1f\\\",\\\"$L20\\\",\\\"$L21\\\"]}]\\n2f:I[5236