space-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167546\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-43, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}],[\"$\",\"div\",null,{\"className\":\"grid sm:grid-cols-2 gap-px bg-rule mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-white px-4 py-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-[#2f7d57] mb-0.5\",\"children\":\"Печели\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"—\"}]]}],[\"$\",\"div\",null,{\"className\":\"bg-white px-4 py-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-red mb-0.5\",\"children\":\"Губи\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"Наказателна отговорност при нарушаване или заобикаляне.\"}]]}]]}]]}]]}]]}]\n32:[\"$\",\"div\",null,{\"className\":\"mt-8 text-sm\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Източници\"}],[\"$\",\"ol\",null,{\"className\":\"list-decimal pl-5 space-y-0.5\",\"children\":[[\"$\",\"li\",\"https://www.parliament.bg/bg/bills/ID/167546\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167546\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Народно събрание: законопроект № 52-602-01-43, доклади и становища\"}]}],[\"$\",\"li\",\"https://naiasno.bg/parliament\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://naiasno.bg/parliament\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Поименни гласувания, Народно събрание (чрез „Наясно“)\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-2\",\"children\":[\"Обобщението е по доклада на правната комисия.\",\" Проверено: \",\"19 ноември 2026 г.\"]}]]}]\n33:[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-602-01-47\"]}]\n34:[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Не бива да се пропуска и фактът, че почти всички оперативни програми предвиждат национално съфинансиране.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Предлага се деянието да бъде по-тежко квалифицирано, когато е извършено: от длъжностно лице, което е в непосредствена връзка с митническата служба; от две или повече лица, сговорили се предварително; от лице, което действа по поръчение или в изпълнение на решение на организирана престъпна група, както и когато митническото задължение е в особено големи размери.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Предвижда се наказателна отговорност и за длъжностно лице, разрешило или отпуснало средствата по ал. 1, ако е знаело, че представените сведения са неверни или са затаени сведения.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"Предвижда се възможност разследването за квалифицирана митническа измама по чл. 242б от НК да може да се извършва и от разследващи митнически инспектори с предлаганото изменение на чл. 194, ал. 3 и 5 от Наказателно-процесуалния кодекс.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Финансови и други средства, необходими за прилагането на новата уредба Предвижда се осъществяването на дейността по законопроекта да се извършва в рамките на предвидените финансови средства на компетентните институции и ведомства.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167572\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],null,null,false,[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"Даниел Топалов относно Законопроект за изменение и допълнение на Наказателния кодекс, № 52-602-01-47, внесен от Министерски съвет на 28.09.2026 г.\",\". \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167572\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Текстовете в parliament.bg\"}]]}]]}]]}]\n35:[\"$\",\"div\",\"167560\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167560\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за изменение и допълнение на Наказателния кодекс\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-654-01-145\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Предвижда се и съответното изменение в ЗСРС, с което да се уточни, че компютърни програми (шпионски софтуер) не представляват законни технически средства.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Предвижда се въвеждане на нов състав, насочени срещу използването и разпространението на тнар “шпионски софтуер” (или “компютърна > програма за шпиониране”).\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167560\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],null,null,false,[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"Държавна агенция \\\"Технически операции\\\"; ДАНС; МВР по ЗИД на НК, № 52-654-01-145; Министерството на правосъдието относно Законопроект за изменение и допълнение на Наказателния кодекс, № 52-654-01-145, внесен от Божидар Пламенов Божанов и група народни представители на 17.09.2026 г.\",\". \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167560\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Текстовете в parliament.bg\"}]]}]]}]]}]]}]\n36:[\"$\",\"div\",\"167546\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167546\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за изменение и допълнение на Наказателния кодекс\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-602-01-43\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Предлага се да бъдат криминализирани като престъпления определени форми на нарушение на ограничителните мерки на Европейския съюз, както и действията, насочени към тяхното заобикаляне.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"За тези деяния се предвижда налагането на наказания лишаване от свобода, значителни по размер глоби, както и в определени случаи лишаване от определени права.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Предвижда се наказателна отговорност да се носи и за заобикаляне на ограничителните мерки на Европейския съюз.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"В съответствие с предвидената в директивата възможност законопроектът въвежда праг от 10 000 евро за определени нарушения.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Законопроектът предвижда извън приложното поле на наказателните разпоредби да остане предоставянето на хуманитарна помощ на нуждаещи се, когато тя се предоставя в съответствие с принципите на безпристрастност, хуманност, неутралност и независимост.\",\"“\"]}],[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"Въвежда се изключение и по отношение на адвокатите, когато те защитават или представляват клиенти в наказателни, граждански и административни производства.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167546\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#8a8f8c] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Позиции, изказани в комисията\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"От името на вносителите законопроектът беше представен от г-жа Борисова, която посочи, че с него се цели въвеждане в законодателството на изискванията на Директива (ЕС) 2024/1226 на Европейския парламент и на Съвета от 24 април 2024 г. относно определянето на престъпленията и санкциите при нарушаване на ограничителните мерки на Съюза и за изменение на Директива (ЕС) 2018/1673.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Народните представители Стою Стоев и Велислав Величков посочиха, че ПГ „Продължаваме промяната“ ще подкрепи законопроекта и представиха конкретни бележки по него.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Народният представител Петър Петров заяви, че няма да подкрепи внесения законопроект, като изложи подробни политически и юридически причини за това.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"Народните представители Иван Вачев и Янка Тянкова посочиха, че ПГ „Прогресивна България“ ще подкрепи законопроекта.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Г-жа Борисова добави, че членовете на Координационната група са подкрепили инициатива за приемане на Закон за международните ограничителни мерки.\",\"“\"]}]]}],\"$L3b\"]}],\"$L3c\",\"$L3d\",\"$L3e\"]}]]}]]}]\n39:null\n2b:true\nd:C\n3b:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167546\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]\n3c:null\n3d:[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#e08a2e] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"В пленарната зала\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"b\",null,{\"children\":\"Ангел Георгиев\"}],[\"$\",\"span\",null,{\"className\":\"text-muted\",\"children\":[\" (\",\"ВЪЗРАЖДАНЕ\",\")\"]}],\": „\",\"На 29 май от тази трибуна парламентарната група на ВЪЗРАЖДАНЕ предупреди, че в българската общност в Република Молдова тече тревожен процес, че вместо да обединява, посолството ни разделя и че вместо да бъде дом за всички българи, то чертае линии между тях. Тогава поискахме проверка на дейността на посланик Мая Добрева и нейната оставка, а някои приеха думите ни като политическо\",\"“ \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11174\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm whitespace-nowrap\",\"children\":[\"стенограма, \",\"24.09.2026\"]}]]}]]}]]}]\n3e:[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"Национален статистически институт относно законопроект за изменение и допълнение на Наказателния кодекс, № 52-602-01-43, внесен от Министерски съвет на 11.09.2026 г.\",\". \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167546\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Текстовете в parliament.bg\"}]]}]\n2a:0\n14:\"$undefined\"\n12:\"$undefined\"\nf:\"$undefined\"\nc:\"$undefined\"\n29:\"$undefined\"\n23:\"$undefined\"\n"}}