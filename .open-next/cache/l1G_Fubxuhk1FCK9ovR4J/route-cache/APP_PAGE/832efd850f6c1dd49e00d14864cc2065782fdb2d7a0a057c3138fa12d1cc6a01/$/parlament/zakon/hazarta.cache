ldren\":[\"$\",\"a\",null,{\"href\":\"#glasuvaniya\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Гласувания (5)\"}]}]]}]}],[\"$\",\"section\",null,{\"id\":\"nakratko\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Накратко\"}],\"$undefined\",[\"$\",\"div\",null,{\"className\":\"max-w-4xl\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[17px]\",\"children\":\"Правителственият проект повишава алтернативния данък за игралните автомати (от 800 лв. на 600 € на тримесечие), масите (от 22 000 лв. на 13 000 €) и другото оборудване; въвежда дистанционна връзка на игралните системи с НАП, нови лицензионни такси (50 000–100 000 €) и минимална месечна такса за онлайн залаганията (поне 100 000 €). Част от таксата (1–2%) се връща на операторите, ако я дарят на спорта. Рекламата на хазарт се забранява, освен при спонсорство на спортни федерации, клубове и олимпийския комитет (върху екипи и съоръжения). Чуждестранните онлайн оператори трябва да имат място на дейност в България; банките и платежните институции внасят в бюджета частта от таксите си над 1,5% при хазартни плащания. В същия закон е включена и забрана за плащания в брой между строителни фирми, изпълнители и подизпълнители.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Вносители:\"}],\" \",\"Министерският съвет (представи зам.-министърът на финансите Людмила Петкова); Венко Сабрутев, Асен Василев и др. (ПП); Божидар Божанов и др. (ДБ)\",[\" · \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167636\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"законопроект \",\"52-602-01-66\"]}]]]}],\"$L1b\"]}]]}],false,\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\"]}]\n22:I[32466,[\"$2\",\"$9\"],\"Term\"]\n32:I[52368,[\"$2\",\"$9\"],\"CitizenVote\"]\n1b:[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Какво се случи:\"}],\" \",\"На първо четене (18.11.2026) и трите проекта минаха единодушно: на Министерския съвет (193 „за“), на ДБ (187) и на ПП (183). Проектите на ПП и ДБ предлагат по-пълна забрана на рекламата — в населените места, по телевизия, радио, интернет и социални мрежи, с единен формуляр в НАП за сигнали.\"]}]\n1c:[\"$\",\"section\",null,{\"id\":\"zakonoproekti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Кой внесе и кой се изказа\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.\"}],[[\"$\",\"ul\",null,{\"className\":\"space-y-4 max-w-5xl\",\"children\":[[\"$\",\"li\",\"167648\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167648\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Общ законопроект за изменение и допълнение на Закона за хазарта\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-653-01-51\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"19 ноември 2026 г.\",\" от \",\"депутати\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по бюджет и финанси (водеща)\"}]],false,false,fa