{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/zakon/layout,_N_T_/parlament/zakon/[slug]/layout,_N_T_/parlament/zakon/[slug]/page,_N_T_/parlament/zakon/hazarta"},"segmentPaths":["/_tree","/_full","/parlament/zakon/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/832efd850f6c1dd49e00d14864cc2065782fdb2d7a0a057c3138fa12d1cc6a01/$/parlament/zakon/hazarta","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/zakon/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2bx3suebn7wim.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><script src=\"/_next/static/chunks/43gzry38n6x69.js\" async=\"\"></script><title>Закон за хазарта · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Закон за хазарта · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Закон за хазарта · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Парламент</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Закон</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Закон за хазарта</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Приет на първо четене на 18.11.2026 г. (единодушно); предстои второ четене</div></div></div><nav aria-label=\"Секции на страницата\" class=\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\"><ul class=\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\"><li><a href=\"#nakratko\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Накратко</a></li><li><a href=\"#zakonoproekti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Кой внесе и кой се изказа</a></li><li><a href=\"#argumenti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Двете страни</a></li><li><a href=\"#mnenie\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Твоето мнение</a></li><li><a href=\"#grupi\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Как гласуваха</a></li><li><a href=\"#glasuvaniya\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Гласувания (5)</a></li></ul></nav><section id=\"nakratko\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Накратко</h2><div class=\"max-w-4xl\"><p class=\"text-[17px]\">Правителственият проект повишава алтернативния данък за игралните автомати (от 800 лв. на 600 € на тримесечие), масите (от 22 000 лв. на 13 000 €) и другото оборудване; въвежда дистанционна връзка на игралните системи с НАП, нови лицензионни такси (50 000–100 000 €) и минимална месечна такса за онлайн залаганията (поне 100 000 €). Част от таксата (1–2%) се връща на операторите, ако я дарят на спорта. Рекламата на хазарт се забранява, освен при спонсорство на спортни федерации, клубове и олимпийския комитет (върху екипи и съоръжения). Чуждестранните онлайн оператори трябва да имат място на дейност в България; банките и платежните институции внасят в бюджета частта от таксите си над 1,5% при хазартни плащания. В същия закон е включена и забрана за плащания в брой между строителни фирми, изпълнители и подизпълнители.</p><p class=\"mt-3 text-[15px]\"><b>Вносители:</b> <!-- -->Министерският съвет (представи зам.-министърът на финансите Людмила Петкова); Венко Сабрутев, Асен Василев и др. (ПП); Божидар Божанов и др. (ДБ)<!-- --> · <a href=\"https://www.parliament.bg/bg/bills/ID/167636\" target=\"_blank\" rel=\"noreferrer\">законопроект <!-- -->52-602-01-66</a></p><p class=\"mt-3 text-[15px]\"><b>Какво се случи:</b> <!-- -->На първо четене (18.11.2026) и трите проекта минаха единодушно: на Министерския съвет (193 „за“), на ДБ (187) и на ПП (183). Проектите на ПП и ДБ предлагат по-пълна забрана на рекламата — в населените места, по телевизия, радио, интернет и социални мрежи, с единен формуляр в НАП за сигнали.</p></div></section><section id=\"zakonoproekti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Кой внесе и кой се изказа</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.</p><ul class=\"space-y-4 max-w-5xl\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167648\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Общ законопроект за изменение и допълнение на Закона за хазарта</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-653-01-51</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>19 ноември 2026 г.<!-- --> от <!-- -->депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща)</dd><dt class=\"text-muted\">Предложения</dt><dd>1<!-- --> писмени предложения на депутати между <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">първо</button></span> и <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">второ четене</button></span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167636\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за хазарта</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-602-01-66</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>11 ноември 2026 г.<!-- --> от <!-- -->Министерския съвет</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща); Комисия по въпросите на младежта и спорта (участваща); Комисия по културата и медиите (участваща); Комисия по образованието и науката (участваща); Комисия по здравеопазването (участваща); Комисия по иновациите и дигиталната трансформация (участваща); Комисия по икономическа политика, инвестиции и индустрия (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>КНСБ по ЗИД на ЗХ-66</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11198\" target=\"_blank\" rel=\"noreferrer\">18 ноември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li></ul><details class=\"mt-3 max-w-5xl\"><summary class=\"cursor-pointer font-semibold text-green py-2\">Още <!-- -->2<!-- --> законопроекта по този закон</summary><ul class=\"space-y-4 mt-2\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167536\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за хазарта</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-130</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>9 септември 2026 г.<!-- --> от <!-- -->Божидар Божанов, Ивайло Мирчев, Йордан Иванов и още 11 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща); Комисия по въпросите на младежта и спорта (участваща); Комисия по културата и медиите (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>АБРО по ЗИД на Закона за хазарта, №№ 52-654-01-128 и 130; Нетинфо по ЗИД на Закона за хазарта, №№ 52-654-01-128 и 130; Държавно предприятие &#x27;&#x27;Български спортен тотализатор&#x27;&#x27; по Законопроект за изменение и допълнение на Закона за хазарта, № 52-654-01-130, внесен от Божидар Пламенов Божанов и група народни представители на 09.09.2026 г.; Министерство на младежта и спорта по Законопроект за изменение и допълнение на Закона за хазарта, № 52-654-01-130, внесен от Божидар Пламенов Божанов и група народни представители на 09.09.2026 г.; Съвета на електронни медии по Законопроект за изменение и допълнение на Закона за хазарта № 52-654-01-130/09.09.2026 г., внесен от Божидар Пламенов Божанов и група народни представители на 09.09.2026 г.; Съвета на електронни медии по Законопроект за изменение и допълнение на Закона за хазарта № 52-654-01-130/09.09.2026 г., внесен от Божидар Пламенов Божанов и група народни представители на 09.09.2026 г.; Министерство на финансите по Законопроект за изменение и допълнение на Закона за хазарта, № 52-654-01-130, внесен от Божидар Пламенов Божанов и група народни представители на 09.09.2026 г.; относно Законопроект за изменение и допълнение на Закона за хазарта 52-654-01-130; КРС по ЗИД на ЗХ, № 52-654-01-130; КФН по ЗИД на ЗХ-130; АББ по ЗИД на ЗХ-130; БНБ по ЗИД на ЗХ-130</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11198\" target=\"_blank\" rel=\"noreferrer\">18 ноември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167534\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за хазарта</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-128</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>4 септември 2026 г.<!-- --> от <!-- -->Венко Сабрутев, Асен Василев, Богомил Петков и още 3 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща); Комисия по въпросите на младежта и спорта (участваща); Комисия по културата и медиите (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>АБРО по ЗИД на Закона за хазарта, №№ 52-654-01-128 и 130; Нетинфо по ЗИД на Закона за хазарта, №№ 52-654-01-128 и 130; Държавно предприятие &#x27;&#x27;Български спортен тотализатор&#x27;&#x27; по Законопроект за изменение и допълнение на Закона за хазарта, № 52-654-01-128, внесен от Венко Николов Сабрутев и група народни представители на 04.09.2026 г.; ММС по ЗИД на ЗХ-128; Министерство на младежта и спорта по Законопроект за изменение и допълнение на Закона за хазарта, № 52-654-01-128, внесен от Венко Николов Сабрутев и група народни представители на 04.09.2026 г.; Министерство на културата по Законопроект за изменение и допълнение на Закона за хазарта, 52-654-01-128/9.10.2026 г.; Съвета за електронните по Законопроект за изменение и допълнение на Закона за хазарта № 52-654-01-128/04.09.2026 г., внесен от Венко Николов Сабрутев и група народни представители на 04.09.2026 г.; Министерство на финансите по Законопроект за изменение и допълнение на Закона за Хазарта, № 52-654-01-128, внесен от Венко Сабрутев и група народни представители на 04.09.2026 г.</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11198\" target=\"_blank\" rel=\"noreferrer\">18 ноември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li></ul></details></section><div id=\"argumenti\" class=\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\"><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Министерството на финансите</p><p class=\"text-[15px]\">Устойчиво увеличение на приходите от хазарт, повече контрол чрез НАП и средства за спорта, здравеопазването и образованието (15,7 млн. € от вноски за социално отговорно поведение).<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167636\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-66, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Венко Сабрутев (ПП)</p><p class=\"text-[15px]\">Населените места са превзети от реклама на хазарт и пунктове за залози; рекламата трябва да се забрани навсякъде, със санкции за заобикаляне.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167636\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-66, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Сдружението на организаторите на хазартни игри, КРИБ, АИКБ и Финтех асоциацията</p><p class=\"text-[15px]\">Присъстваха на обсъждането в бюджетната комисия; асоциацията на радиооператорите (АБРО), „Нетинфо“ и СЕМ внесоха становища по забраната на рекламата.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167636\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-66, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a><a href=\"https://www.parliament.bg/bg/bills/ID/167534\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-128, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Отворен въпрос</p><p class=\"text-[15px]\">Изключението за спонсорство на спорта и връщането на част от таксата при дарения за спорта оставят на хазартните оператори легален канал за видимост.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167636\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-66, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Отворен въпрос</p><p class=\"text-[15px]\">Забраната за плащания в брой в строителството няма връзка с хазарта; включена е в този закон и така не минава отделно обсъждане.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167636\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-66, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Двете страни на монетата</h3><p class=\"text-sm text-muted mb-3\">Какво следва на практика, ако законът се приеме и ако се отхвърли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167636\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-66, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\"><p class=\"font-semibold\">Ако се приеме</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">По-малко хазартна реклама и повече приходи.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">По-малко сива икономика в строителството.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Рискът част от играчите да минат към нелегални онлайн сайтове.</li></ul></div></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\"><p class=\"font-semibold\">Ако се отхвърли</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Остават рекламите и по-ниските данъци за хазарта.</li></ul></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Какво печели и какво губи всяка страна</h3><p class=\"text-sm text-muted mb-3\">Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.</p><div class=\"space-y-3\"><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Хазартни оператори<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167636\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-66, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Могат да спонсорират спорта срещу връщане на част от таксата.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">По-високи данъци и такси, забрана на рекламата, онлайн контрол от НАП.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Медии и рекламни агенции<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167636\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-66, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Загуба на приходи от хазартна реклама.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Спортът<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167636\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-66, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Повече спонсорства и пари от вноските.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">—</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Строителни фирми<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167636\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-66, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Само безкасови плащания помежду им.</p></div></div></div></div></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://www.parliament.bg/bg/bills/ID/167636\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-602-01-66, доклади и становища</a></li><li><a href=\"https://www.parliament.bg/bg/bills/ID/167534\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-654-01-128, доклади и становища</a></li><li><a href=\"https://www.parliament.bg/bg/bills/ID/167536\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-654-01-130, доклади и становища</a></li><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания, Народно събрание (чрез „Наясно“)</a></li></ol><p class=\"text-xs text-muted mt-2\">Обобщението е по доклада на бюджетната комисия за първо гласуване. „Отворените въпроси“ са наш анализ. Ще обновим след второто четене.<!-- --> Проверено: <!-- -->19 ноември 2026 г.</p></div></div><section id=\"dokumenti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Още от документите</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.</p><div class=\"space-y-4 max-w-4xl\"><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167636\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за хазарта</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-602-01-66</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Мярката предвижда увеличаване на размера на алтернативния данък по Закона за корпоративното подоходно облагане (ЗКПО), дължим за организиране на хазартни игри с игрални автомати и игри в игрално казино.<!-- -->“</li><li>„<!-- -->Алтернативният данък за игрални автомати се увеличава от 800 лв. на 600 евро за игрален автомат на тримесечие, за игралните маси от 22 000 лв. на 13 000 евро за игрална маса на тримесечие и за друго игрално оборудване от 5 000 лв. на 3 000 евро за оборудване на тримесечие. - Въвеждане на дистанционна връзка с НАП на игралните системи на хазартните оператори в наземните игрални зали и казина. - Увеличаване на размера на вноските за социално отговорно поведение.<!-- -->“</li><li>„<!-- -->Мярката осигурява устойчиво увеличаване на бюджетните приходи от хазартната дейност чрез двойно увеличение на еднократната част и повишаване на променливата част на двукомпонентната държавна такса и въвеждане на минимален месечен праг за променливата част от таксата - не по-малко от 100 000 евро месечно, като едновременно с това се създава механизъм за осигуряване на допълнителен финансов ресурс за развитието на българския спорт (само за онлайн залагания).<!-- -->“</li><li>„<!-- -->В интернет страницата и мобилното приложение на организатора на хазартни игри и в обектите и върху фасадите на обектите, за които има издаден лиценз за организиране на хазартни игри, се допуска обявяване само на регистрираната търговска марка на организатора, а при спонсорство и/или фирмата (наименованието) на организатора. - Изискване за място на стопанска дейност за чуждестранни лица, организатори на онлайн залагания.<!-- -->“</li><li>„<!-- -->Детският хазарт и хазарта сред младежите е болна тема и следва да се намери работещ модел, включително и мерки за ограничаване на точно такова игрално поведение, както за тях, така и за всички участници, което намалява зависимостта, така както например са намерили подходящото законово решение в Нидерландия.<!-- -->“</li><li>„<!-- -->Народните представители единодушно приеха Комисията по бюджет и финанси да организира работна група в широк формат с експерти от Министерството на финансите и други институции и бизнеса, с обединяваща идея – намирането на балансирани и работещи решения, произтичащи от трите законопроекта, с акцентите, които се коментираха на заседанието, с цел ограничаване на рекламата и хазарта до възможното минимално ниво, без да се отваря вратата за нелегалния хазарт.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167636\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Предложението въвежда необосновано секторно ограничение, което създава значителна административна и финансова тежест за строителния бизнес, без да е доказана неговата необходимост, съразмерност и ефективност, включително поражда основателни съмнения относно неговата пропорционалност и ефективност.<!-- -->“</li><li>„<!-- -->От ПГ на ГЕРБ-СДС и ПГ ВЪЗРАЖДАНЕ считат, че § 78 в законопроекта, внесен от Министерския съвет е излишен и необоснован.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167636\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->КНСБ по ЗИД на ЗХ-66<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167636\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167536\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за хазарта</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-130</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Той посочи, целта, която си поставя настоящия законопроект е ограничаването на промотирането на хазарт и на достъпа до него чрез заобикаляне на правилата.<!-- -->“</li><li>„<!-- -->Във връзка с това се предлага - пълна забрана на рекламата на хазарт и коригиране на отчетени дефицити за периода от 2024 г. досега; използването на кеш-терминали за зареждане на сметки за онлайн преди установяване на самоличността на потребителите; залагането чрез криптоактиви (криптовалути) чрез въвеждане на забрана на операторите на услуги за криптоактиви и многото големи онлайн търсачки да показват резултати на хазартни оператори, които нямат действащ лиценз.<!-- -->“</li><li>„<!-- -->В тази връзка предлага и мерки за - санкциониране на опитите за заобикаляне на законовите изисквания и ограничения; прецизиране на текстовете за забраната на онлайн рекламата, прецизиране редица формулировки в забраните за реклама, Предвижда се НАП да извършва постоянен мониторинг за незаконна реклама.<!-- -->“</li><li>„<!-- -->Възможно е прилагането на мерките да изисква определени разходи за техническо и организационно обезпечаване на контрола от НАП и за привеждане на дейността на засегнатите доставчици в съответствие с новите изисквания, както и да доведе до намаляване па приходите от хазартна реклама.<!-- -->“</li><li>„<!-- -->В писмените си становища засегнатите и заинтересованите лица, комисии и министерства са за намаляване на хазартната зависимост, адекватна защита на уязвимите лица и децата, каквито цели са заложени и се подкрепят в законопроектите, внесени от народните представители.<!-- -->“</li><li>„<!-- -->Също така Министерството на младежта и спорта подкрепя заложените цели, като се опасява от намаляване на съответните приходи, а Държавното предприятие „Български спортен тотализатор“ насочва към подходяща редакция на текстовете.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167536\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Съветът за електронни медии счита, че би следвало да има оценка на ефекта от действащата от 2024 г. нормативна уредба , а Асоциацията на българските радио- и телевизионни оператори, както и НЕТ ИНФО ЕАД не подкрепят законопроектите в този им вид, без широко обществено и експертно обсъждане, приемайки, че са по-скоро ПР реклама и биха повлияли на нелегалния пазар.<!-- -->“</li><li>„<!-- -->Така също не подкрепят предложенията за завишаване на размерите на глобите и имуществените санкции в чл. 105, ал. 1 и ал. 2 от Закона за хазарта за нарушение на забраната за реклама на хазартни игри по чл. 10 от същия закон, тъй като считат, че те са необосновано завишени в сравнение с настоящия им размер, както и не подкрепят разширяването на ограниченията по чл. 45, ал. 2 от с.з. и по отношение на пунктовете за приемане на залози и изплащане на печалби.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167536\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->АБРО по ЗИД на Закона за хазарта, №№ 52-654-01-128 и 130; Нетинфо по ЗИД на Закона за хазарта, №№ 52-654-01-128 и 130; Държавно предприятие &#x27;&#x27;Български спортен тотализатор&#x27;&#x27; по Законопроект за изменение и допълнение на Закона за хазарта, № 52-654-01-130, внесен от Божидар Пламенов Божанов и група народни представители на 09.09.2026 г.; Министерство на младежта и спорта по Законопроект за изменение и допълнение на Закона за хазарта, № 52-654-01-130, внесен от Божидар Пламенов Божанов и група народни представители на 09.09.2026 г.; Съвета на електронни медии по Законопроект за изменение и допълнение на Закона за хазарта № 52-654-01-130/09.09.2026 г., внесен от Божидар Пламенов Божанов и група народни представители на 09.09.2026 г.; Съвета на електронни медии по Законопроект за изменение и допълнение на Закона за хазарта № 52-654-01-130/09.09.2026 г., внесен от Божидар Пламенов Божанов и група народни представители на 09.09.2026 г.; Министерство на финансите по Законопроект за изменение и допълнение на Закона за хазарта, № 52-654-01-130, внесен от Божидар Пламенов Божанов и група народни представители на 09.09.2026 г.; относно Законопроект за изменение и допълнение на Закона за хазарта 52-654-01-130; КРС по ЗИД на ЗХ, № 52-654-01-130; КФН по ЗИД на ЗХ-130; АББ по ЗИД на ЗХ-130; БНБ по ЗИД на ЗХ-130<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167536\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167534\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за хазарта</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-128</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Предлагат се и мерки за - санкциониране на опитите за заобикаляне на законовите изисквания и ограничения; прецизиране на текстовете за забраната на онлайн рекламата, създаването и поддържането от НАП на единен онлайн формуляр за подаване на сигнали за нарушение на ограниченията за реклама, както и на други нарушения по този закон; и изменение в чл. 45, ал. 2 от Закона за хазарта, като в обхвата на обектите в които не се допускат лицата по ал. 2 се включат и пунктовете за приемане на залози и изплащане на печалби.<!-- -->“</li><li>„<!-- -->Предлага се и прецизиране на текстовете за забраната на онлайн рекламата, като се създава правомощие на изпълнителния директор на НАП да преустановява временно достъпа до онлайн рекламни мрежи, които системно не прекратяват разпространението на онлайн реклами на хазарт.<!-- -->“</li><li>„<!-- -->Предлага се създаване и поддържане от НАП на единен онлайн формуляр за подаване на сигнали за нарушение на ограниченията за реклама, както и на други нарушения по този закон.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167534\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->АБРО по ЗИД на Закона за хазарта, №№ 52-654-01-128 и 130; Нетинфо по ЗИД на Закона за хазарта, №№ 52-654-01-128 и 130; Държавно предприятие &#x27;&#x27;Български спортен тотализатор&#x27;&#x27; по Законопроект за изменение и допълнение на Закона за хазарта, № 52-654-01-128, внесен от Венко Николов Сабрутев и група народни представители на 04.09.2026 г.; ММС по ЗИД на ЗХ-128; Министерство на младежта и спорта по Законопроект за изменение и допълнение на Закона за хазарта, № 52-654-01-128, внесен от Венко Николов Сабрутев и група народни представители на 04.09.2026 г.; Министерство на културата по Законопроект за изменение и допълнение на Закона за хазарта, 52-654-01-128/9.10.2026 г.; Съвета за електронните по Законопроект за изменение и допълнение на Закона за хазарта № 52-654-01-128/04.09.2026 г., внесен от Венко Николов Сабрутев и група народни представители на 04.09.2026 г.; Министерство на финансите по Законопроект за изменение и допълнение на Закона за Хазарта, № 52-654-01-128, внесен от Венко Сабрутев и група народни представители на 04.09.2026 г.<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167534\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div></div></section><section id=\"mnenie\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Твоето мнение</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. <a href=\"/mnenie\">Всички закони за гласуване</a>.</p><div class=\"bg-surface rounded-sm p-5 text-[15px] text-muted\">Зарежда се…</div></section><section id=\"grupi\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласуваха групите по този закон</h2></div><p class=\"text-sm text-muted mb-3\">Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо <!-- -->5<!-- -->. Прието: <!-- -->5<!-- -->, отхвърлено: <!-- -->0<!-- -->.</p><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Прогресивна България</p><p class=\"num text-sm mt-1\">За: <b>5</b> · Против: <b>0</b> · общо <!-- -->5</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ГЕРБ – СДС</p><p class=\"num text-sm mt-1\">За: <b>5</b> · Против: <b>0</b> · общо <!-- -->5</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Демократична България</p><p class=\"num text-sm mt-1\">За: <b>4</b> · Против: <b>1</b> · общо <!-- -->5</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ДПС</p><p class=\"num text-sm mt-1\">За: <b>5</b> · Против: <b>0</b> · общо <!-- -->5</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Продължаваме промяната</p><p class=\"num text-sm mt-1\">За: <b>5</b> · Против: <b>0</b> · общо <!-- -->5</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Възраждане</p><p class=\"num text-sm mt-1\">За: <b>3</b> · Против: <b>2</b> · общо <!-- -->5</p></div></div><p class=\"text-sm mt-3\">Първо четене: <a href=\"/parlament/glasuvane/2026-11-18-38\">18 ноември 2026 г.</a><a href=\"/parlament/glasuvane/2026-11-18-39\">18 ноември 2026 г.</a><a href=\"/parlament/glasuvane/2026-11-18-40\">18 ноември 2026 г.</a></p></section><section id=\"glasuvaniya\" class=\"scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Всички гласувания по закона</h2></div><ul><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-11-18-37\">Закона за хазарта – първо гласуване - процедура за допускане в залата по трите точки в програмата</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">18 ноември 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: Против · ДПС: За · Продължаваме промяната: За · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-11-18-38\">Закона за хазарта – първо гласуване - вносител Венко Сабрутев и група н.п</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието единодушно</span></div><p class=\"text-sm text-muted mt-1\">18 ноември 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: За</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline j