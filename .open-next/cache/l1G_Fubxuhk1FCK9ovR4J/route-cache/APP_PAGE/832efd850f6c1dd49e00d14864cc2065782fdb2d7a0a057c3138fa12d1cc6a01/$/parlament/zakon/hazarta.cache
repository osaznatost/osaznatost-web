}],\"p\":\"$@29\",\"v\":null,\"s\":\"$d\"}},\"a\":\"$@2a\",\"u\":\"$@2b\",\"b\":\"l1G_Fubxuhk1FCK9ovR4J\"}\n2c:I[32466,[\"$2\",\"$9\"],\"Term\"]\n3c:I[52368,[\"$2\",\"$9\"],\"CitizenVote\"]\n3e:I[97367,[\"$2\"],\"OutletBoundary\"]\n16:[\"$\",\"li\",\"argumenti\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#argumenti\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Двете страни\"}]}]\n17:[\"$\",\"li\",\"mnenie\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#mnenie\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Твоето мнение\"}]}]\n18:[\"$\",\"li\",\"grupi\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#grupi\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Как гласуваха\"}]}]\n19:[\"$\",\"li\",\"glasuvaniya\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#glasuvaniya\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Гласувания (5)\"}]}]\n1a:[\"$\",\"section\",null,{\"id\":\"nakratko\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Накратко\"}],\"$undefined\",[\"$\",\"div\",null,{\"className\":\"max-w-4xl\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[17px]\",\"children\":\"Правителственият проект повишава алтернативния данък за игралните автомати (от 800 лв. на 600 € на тримесечие), масите (от 22 000 лв. на 13 000 €) и другото оборудване; въвежда дистанционна връзка на игралните системи с НАП, нови лицензионни такси (50 000–100 000 €) и минимална месечна такса за онлайн залаганията (поне 100 000 €). Част от таксата (1–2%) се връща на операторите, ако я дарят на спорта. Рекламата на хазарт се забранява, освен при спонсорство на спортни федерации, клубове и олимпийския комитет (върху екипи и съоръжения). Чуждестранните онлайн оператори трябва да имат място на дейност в България; банките и платежните институции внасят в бюджета частта от таксите си над 1,5% при хазартни плащания. В същия закон е включена и забрана за плащания в брой между строителни фирми, изпълнители и подизпълнители.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Вносители:\"}],\" \",\"Министерският съвет (представи зам.-министърът на финансите Людмила Петкова); Венко Сабрутев, Асен Василев и др. (ПП); Божидар Божанов и др. (ДБ)\",[\" · \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167636\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"законопроект \",\"52-602-01-66\"]}]]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Какво се случи:\"}],\" \",\"На първо четене (18.11.2026) и трите проекта минаха единодушно: на Министерския съвет (193 „за“), на ДБ (187) и на ПП (183). Проектите на ПП и ДБ предлагат по-пълна забрана на рекламата — в населените места, по телевизия, радио, интернет и социални мрежи, с единен формуляр в НАП за сигнали.\"]}]]}]]}]\n1b:[\"$\",\"section\",null,{\"id\":\"zakonoproekti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Кой внесе и кой се изказа\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.\"}],[[\"$\",\"ul\",null,{\"className\":\"space-y-4 max-w-5xl\",\"children\":[[\"$\",\"li\",\"167648\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167648\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Общ законопроект за изменение и допълнение на Закона за хазарта\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-653-01-51\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"19 ноември 2026 г.\",\" от \",\"депутати\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по бюджет и финанси (водеща)\"}]],false,false,false,false,[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Предложения\"}],[\"$\",\"dd\",null,{\"children\":[1,\" писмени предложения на депутати между \",[\"$\",\"$L2c\",null,{\"k\":\"parvo-chetene\",\"children\":\"първо\"}],\" и \",[\"$\",\"$L2c\",null,{\"k\":\"vtoro-chetene\",\"children\":\"второ четене\"}]]}]],false,null]}]]}],[\"$\",\"li\",\"167636\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167636\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за хазарта\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-602-01-66\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"11 ноември 2026 г.\",\" от \",\"Министерския съвет\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по бюджет и финанси (водеща); Комисия по въпросите на младежта и спорта (участваща); Комисия по културата и медиите (участваща); Комисия по образованието и науката (участваща); Комисия по здравеопазването (участваща); Комисия по иновациите и дигиталната трансформация (участваща); Комисия по икономическа политика, инвестиции и индустрия (участваща)\"}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Становища\"}],[\"$\",\"dd\",null,{\"children\":\"КНСБ по ЗИД на ЗХ-66\"}]],false,false,false,false,[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"В залата\"}],[\"$\",\"dd\",null,{\"children\":[[\"$\",\"span\",\"0\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11198\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"18 ноември 2026 г.\"}],\" (\",\"зала първо гласуване\",\")\"]}]]}]],null]}]]}]]}],[\"$\",\"details\",null,{\"className\":\"mt-3 max-w-5xl\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green py-2\",\"children\":[\"Още \",2,\" законопроекта по този закон\"]}],[\"$\",\"ul\",null,{\"className\":\"space-y-4 mt-2\",\"children\":[[\"$\",\"li\",\"167536\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167536\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за хазарта\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-654-01-130\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],\"$L2d\",\"$L2e\",\"$L2f\",false,false,false,false,\"$L30\",null]}]]}],\"$L31\"]}]]}]]]}]\n1c:[\"$\",\"div\",null,{\"id\":\"argumenti\",\"className\":\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-2 mt-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-green bg-surface\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Мотивите на вносителите\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Министерството на финанситеУстойчиво увеличение\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Министерството на финансите\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Устойчиво увеличение на приходите от хазарт, повече контрол чрез НАП и средства за спорта, здравеопазването и образованието (15,7 млн. € от вноски за социално отговорно поведение).\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167636\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-66, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Венко Сабрутев (ПП)Населените места са \",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Венко Сабрутев (ПП)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Населените места са превзети от реклама на хазарт и пунктове за залози; рекламата трябва да се забрани навсякъде, със санкции за заобикаляне.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167636\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-66, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Какво казват критиците\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Сдружението на организаторите на хазартни игри, КРИБ, АИКБ и Финтех асоциациятаПрисъстваха на обсъж\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Сдружението на организаторите на хазартни игри, КРИБ, АИКБ и Финтех асоциацията\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Присъстваха на обсъждането в бюджетната комисия; асоциацията на радиооператорите (АБРО), „Нетинфо“ и СЕМ внесоха становища по забраната на рекламата.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167636\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-66, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}],[\"$\",\"a\",\"2\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167534\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-128, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",2,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Отворен въпросИзключението за спон\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Отворен въпрос\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Изключението за спонсорство на спорта и връщането на част от таксата при дарения за спорта оставят на хазартните оператори легален канал за видимост.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167636\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-66, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Отворен въпросЗабраната за плащани\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Отворен въпрос\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Забраната за плащания в брой в строителството няма връзка с хазарта; включена е в този закон и така не минава отделно обсъждане.\",\"$L32\"]}]]}]]}]]}]]}],null,\"$L33\",\"$L34\",null,\"$L35\"]}]\n1d:[\"$\",\"section\",null,{\"id\":\"dokumenti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Още от документите\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 max-w-4xl\",\"children\":[[\"$\",\"div\",\"167636\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167636\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за хазарта\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-602-01-66\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Мярката предвижда увеличаване на размера на алтернативния данък по Закона за корпоративното подоходно облагане (ЗКПО), дължим за организиране на хазартни игри с игрални автомати и игри в игрално казино.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Алтернативният данък за игрални автомати се увеличава от 800 лв. на 600 евро за игрален автомат на тримесечие, за игралните маси от 22 000 лв. на 13 000 евро за игрална маса на тримесечие и за друго игрално оборудване от 5 000 лв. на 3 000 евро за оборудване на тримесечие. - Въвеждане на дистанционна връзка с НАП на игралните системи на хазартните оператори в наземните игрални зали и казина. - Увеличаване на размера на вноските за социално отговорно поведение.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Мярката осигурява устойчиво увеличаване на бюджетните приходи от хазартната дейност чрез двойно увеличение на еднократната част и повишаване на променливата част на двукомпонентната държавна такса и въвеждане на минимален месечен праг за променливата част от таксата - не по-малко от 100 000 евро месечно, като едновременно с това се създава механизъм за осигуряване на допълнителен финансов ресурс за развитието на българския спорт (само за онлайн залагания).\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"В интернет страницата и мобилното приложение на организатора на хазартни игри и в обектите и върху фасадите на обектите, за които има издаден лиценз за организиране на хазартни игри, се допуска обявяване само на регистрираната търговска марка на организатора, а при спонсорство и/или фирмата (наименованието) на организатора. - Изискване за място на стопанска дейност за чуждестранни лица, организатори на онлайн залагания.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Детският хазарт и хазарта сред младежите е болна тема и следва да се намери работещ модел, включително и мерки за ограничаване на точно такова игрално поведение, както за тях, така и за всички участници, което намалява зависимостта, така както например са намерили подходящото законово решение в Нидерландия.\",\"“\"]}],[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"Народните представители единодушно приеха Комисията по бюджет и финанси да организира работна група в широк формат с експерти от Министерството на финансите и други институции и бизнеса, с обединяваща идея – намирането на балансирани и работещи решения, произтичащи от трите законопроекта, с акцентите, които се коментираха на заседанието, с цел ограничаване на рекламата и хазарта до възможното минимално ниво, без да се отваря вратата за нелегалния хазарт.\",\"“\"]}]]}],\"$L36\"]}],\"$L37\",\"$L38\",false,\"$L39\"]}]]}]]}],\"$L3a\",\"$L3b\"]}]]}]\n1e:[\"$\",\"section\",null,{\"id\":\"mnenie\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Твоето мнение\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":[\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \",[\"$\",\"$La\",null,{\"href\":\"/mnenie\",\"children\":\"Всички закони за гласуване\"}],\".\"]}],[\"$\",\"$L3c\",null,{\"item\":\"hazarta\",\"question\":\"Подкрепяш ли последните промени в „Закон за хазарта (по-високи данъци, забрана на рекламата)“?\"}]]}]\n1f:[\"$\",\"section\",null,{\"id\":\"grupi\",\"className\":\"mb-12 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"d