undefined\\\",[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"max-w-4xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[17px]\\\",\\\"children\\\":\\\"Правителствен законопроект, който привежда банковото законодателство в съответствие с правилата на ЕС (основно Директива (ЕС) 2024/1619 и 2024/2994). Според мотивите той: допълва основанията за отнемане на банков лиценз (вкл. по искане на самата банка); изброява какво БНБ трябва да вземе предвид при определяне на глобите (тежест, продължителност, финансово състояние на нарушителя); разпределя по-ясно надзора между ЕЦБ и БНБ; урежда реда за решения по вътрешните експозиции (заеми към свързани лица); въвежда надзор върху клонове на банки от трети държави и рисковете от екологичен, социален и управленски характер; превалутира глобите и таксите в евро. В преходните разпоредби променя и Закона за пазарите на финансови инструменти, Кодекса за застраховането и Закона за лицата, обслужващи кредити.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"children\\\":\\\"Вносители:\\\"}],\\\" \\\",\\\"Министерският съвет\\\",[\\\" · \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167078\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":[\\\"законопроект \\\",\\\"52-602-01-13\\\"]}]]]}],\\\"$L1b\\\"]}]]}],\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\",\\\"$L1f\\\",\\\"$L20\\\",\\\"$L21\\\",\\\"$L22\\\"]}]\\n29:I[52368,[\\\"$2\\\",\\\"$9\\\"],\\\"CitizenVote\\\"]\\n1b:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"children\\\":\\\"Какво се случи:\\\"}],\\\" \\\",\\\"Първо четене на 19.06.2026 г. (167 „за“, 8 „против“ — „Възраждане“); срокът за предложения беше намален на 5 дни. Окончателно на 09.07.2026 г. (160–165 „за“). Не са публикувани становища на външни организации.\\\"]}]\\n1c:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"signali\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Сигнали\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":\\\"Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.\\\"}],[[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"grid gap-3 md:grid-cols-2 max-w-5xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"Съкратен срок за предложения (5 дни)\\\",{\\\"className\\\":\\\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold\\\",\\\"children\\\":\\\"Съкратен срок за предложения (5 дни)\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mt-1\\\",\\\"children\\\":\\\"Мнозинството гласува по-кратък срок от обичайните 7 дни, в който депутатите могат да внасят промени между първо и второ четене.\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"Няма публикувани становища\\\",{\\\"className\\\":\\\"border-l-4 rounded-sm p-4 border-rule bg-surface\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold\\\",\\\"children\\\":\\\"Няма публикувани становища\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mt-1\\\",\\\"children\\\":\\\"На сайта на парламента няма становища на външни организации (браншове, синдикати, институции) по този законопроект.\\\"}]]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm mt-3\\\",\\\"children\\\":[\\\"$\\\",\\\"$La\\\",null,{\\\"href\\\":\\\"/parlament/signali\\\",\\\"children\\\":\\\"Всички сигнали в парламента\\\"}]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted mt-2\\\",\\\"children\\\":[\\\"Сигналът е повод за въпрос,