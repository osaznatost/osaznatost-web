ата е било „за“ или „против“, от общо \",7,\". Прието: \",7,\", отхвърлено: \",0,\".\"]}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"div\",\"ПБ\",{\"className\":\"border border-rule rounded-sm p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Прогресивна България\"}],[\"$\",\"p\",null,{\"className\":\"num text-sm mt-1\",\"children\":[\"За: \",[\"$\",\"b\",null,{\"children\":7}],\" · Против: \",[\"$\",\"b\",null,{\"children\":0}],\" · общо \",7]}]]}],[\"$\",\"div\",\"ГЕРБ - СДС\",{\"className\":\"border border-rule rounded-sm p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"ГЕРБ – СДС\"}],[\"$\",\"p\",null,{\"className\":\"num text-sm mt-1\",\"children\":[\"За: \",[\"$\",\"b\",null,{\"children\":7}],\" · Против: \",[\"$\",\"b\",null,{\"children\":0}],\" · общо \",7]}]]}],[\"$\",\"div\",\"ДБ\",{\"className\":\"border border-rule rounded-sm p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Демократична България\"}],[\"$\",\"p\",null,{\"className\":\"num text-sm mt-1\",\"children\":[\"За: \",[\"$\",\"b\",null,{\"children\":7}],\" · Против: \",[\"$\",\"b\",null,{\"children\":0}],\" · общо \",7]}]]}],[\"$\",\"div\",\"ДПС\",{\"className\":\"border border-rule rounded-sm p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"ДПС\"}],[\"$\",\"p\",null,{\"className\":\"num text-sm mt-1\",\"children\":[\"За: \",[\"$\",\"b\",null,{\"children\":7}],\" · Против: \",[\"$\",\"b\",null,{\"children\":0}],\" · общо \",7]}]]}],[\"$\",\"div\",\"ПП\",{\"className\":\"border border-rule rounded-sm p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Продължаваме промяната\"}],[\"$\",\"p\",null,{\"className\":\"num text-sm mt-1\",\"children\":[\"За: \",[\"$\",\"b\",null,{\"children\":7}],\" · Против: \",[\"$\",\"b\",null,{\"children\":0}],\" · общо \",7]}]]}],[