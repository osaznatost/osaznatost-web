re:font-bold\",\"children\":\"Неизпълнена директива.\"}]]}]]}]]}]]}]]}]]}],\"$L30\",null,\"$L31\"]}]\n1d:[\"$\",\"section\",null,{\"id\":\"dokumenti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Още от документите\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 max-w-4xl\",\"children\":[[\"$\",\"div\",\"167469\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167469\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за предоставяне на цифрово съдържание и цифрови услуги и за продажба на стоки\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-602-01-30\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Със законопроекта, представен от заместник-министъра на икономиката, инвестициите и индустрията Левент Мемиш, се въвеждат изискванията на Директива (ЕС) 2024/1799 на Европейския парламент и на Съвета от 13 юни 2024 г. относно общите правила за насърчаване на ремонта на стоки и за изменение на Регламент (ЕС) 2017/2394 и директиви (ЕС) 2019/771 и (ЕС) 2020/1828.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Законопроектът предвижда мерки за насърчаване на ремонта на потребителски стоки в рамките на законовата гаранция, предвидена в Закона за предоставяне на цифрово съдържание, цифрови услуги и за продажба на стоки и улесняване на ремонта на потребителски стоки, след изтичане на срока на законовата гаранция.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Предвижда се задължение за производителите на стоки, за които са установени изисквания за ремонтопригодност, да предлагат услуги за ремонт след изтичане на срока на законовата гаранция, пряко или чрез подизпълнител.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"С проекта на Закон за изменение и допълнение на Закона за предоставяне на цифрово съдържание и цифрови услуги и за продажба на стоки се цели транспониране в българското законодателство на Директива (ЕС) 2024/1799 от 13 юни 2024 г. относно общите правила за насърчаване на ремонта на стоки.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Директивата е част от политиката на Европейския съюз за развитие на кръгова и устойчива икономика и цели удължаване на жизнения цикъл на стоките, намаляване на отпадъците и насърчаване на ремонта като алтернатива на закупуването на нови стоки.\",\"“\"]}],[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"Предвижда се потребителите да бъдат информирани за правото си да избират между ремонт и замяна на стоката, като при избор на ремонт срокът на законовата гаранция се удължава с една година.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167469\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],null,[\"$\",\"div\",null,{\"className\":\"border-l-4 border-red pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Възражения и критики\"}],\"$L32\",\"$L33\"]}],\"$L34\",\"$L35\"]}]]}]]}]]}]]}]\n1e:[\"$\",\"section\",null,{\"id\":\"mnenie\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Твоето мнение\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":[\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \",[\"$\",\"$La\",null,{\"href\":\"/mnenie\",\"children\":\"Всички закони за гласуване\"}],\".\"]}],[\"$\",\"$L36\",null,{\"item\":\"predostavyane-na-tsifrovo-sadarzhanie-i-tsifrovi-uslugi-i-za-prodazhba-na-stoki\",\"question\":\"Подкрепяш ли последните промени в „Закон за предоставяне на цифрово съдържание и цифрови услуги и за продажба на стоки („право на ремонт“)“?\"}]]}]\n1f:[\"$\",\"section\",null,{\"id\":\"grupi\",\"className\":\"mb-12 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb-5\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] sm:text-[2.4rem]\",\"children\":\"Как гласуваха групите по този закон\"}],\"$undefined\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mb-3\",\"children\":[\"Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо \",2,\". Прието: \",2,\", отхвърлено: \",0,\".\"]}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"div\",\"ПБ\",{\"className\":\"border border-rule rounded-sm p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Прогресивна България\"}],[\"$\",\"p\",null,{\"className\":\"