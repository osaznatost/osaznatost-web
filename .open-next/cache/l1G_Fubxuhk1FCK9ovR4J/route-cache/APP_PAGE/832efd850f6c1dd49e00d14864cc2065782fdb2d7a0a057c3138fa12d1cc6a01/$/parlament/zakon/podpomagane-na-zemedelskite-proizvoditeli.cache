3f:null\n40:null\n41:[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"Министерството на земеделието и храните\",\". \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167213\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Текстовете в parliament.bg\"}]]}]\n42:[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Министерство на земеделието и храните подкрепя законопроекта и изразява позиция, че не подлежи на нотификация.\",\"“\"]}]\n43:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167192\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]\n44:[\"$\",\"div\",null,{\"className\":\"border-l-4 border-red pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Възражения и критики\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Бяха изложени както аргументи в подкрепа, така и категорични възражения.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Във връзка с отправените бележки от парламентарната група „ВЪЗРАЖДАНЕ“ заявиха, че няма да подкрепят законопроекта.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167192\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}]\n45:[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#e08a2e] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"В пленарната зала\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"b\",null,{\"children\":\"Десислава Танева\"}],[\"$\",\"span\",null,{\"className\":\"text-muted\",\"children\":[\" (\",\"ГЕРБ-СДС\",\")\"]}],\": „\",\"Ще бъда съвсем кратка. С настоящия законопроект, който представям – съвсем малка ретроспекция: в частите, в които сме го предложили в Петдесет и второто народно събрание, го предложихме и в предходно… Имаше такъв законопроект и в предходния мандат с вносител Министерският съвет и автор – екип на Министерството на земеделието. Поради различни причини – и края на мандата, и определено решение тогава на политическия…\",\"“ \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11160\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm whitespace-nowrap\",\"children\":[\"стенограма, \",\"25.08.2026\"]}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"b\",null,{\"children\":\"Георги Георгиев\"}],[\"$\",\"span\",null,{\"className\":\"text-muted\",\"children\":[\" (\",\"ПБ\",\")\"]}],\": „\",\"Както госпожа Танева каза, в голяма степен двата законопроекта… В голяма не бих казал, но все пак в немалка степен, двата законопроекта се\",\"“ \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11160\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm whitespace-nowrap\",\"children\":[\"стенограма, \",\"25.08.2026\"]}]]}]]}]]}]\n46:[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"Сдружение „Обединени земеделски производители“; Национален браншови пчеларски съюз; Национален съюз на земеделските кооперации в България; Български фермерски съюз; Национална браншова камара \\\"Плодове и зеленчуци\\\"; Министерството на земеделието и храните; Асоциация на овощарите в България; Българска асоциация на консултантите по европейски програми; Българска асоциация на производителите на оранжерийна продукция; Асоциация на земеделските производители в България; Съюз на птицевъдите в България\",\". \",[\"$\",