{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/zakon/layout,_N_T_/parlament/zakon/[slug]/layout,_N_T_/parlament/zakon/[slug]/page,_N_T_/parlament/zakon/podpomagane-na-zemedelskite-proizvoditeli"},"segmentPaths":["/_tree","/_full","/parlament/zakon/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/832efd850f6c1dd49e00d14864cc2065782fdb2d7a0a057c3138fa12d1cc6a01/$/parlament/zakon/podpomagane-na-zemedelskite-proizvoditeli","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/zakon/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2bx3suebn7wim.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><script src=\"/_next/static/chunks/43gzry38n6x69.js\" async=\"\"></script><title>Закон за подпомагане на земеделските производители · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Закон за подпомагане на земеделските производители · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Закон за подпомагане на земеделските производители · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Парламент</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Закон</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Закон за подпомагане на земеделските производители</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Приет окончателно на 17.09.2026 г., обнародван в ДВ, бр. 88/2026</div></div></div><nav aria-label=\"Секции на страницата\" class=\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\"><ul class=\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\"><li><a href=\"#nakratko\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Накратко</a></li><li><a href=\"#signali\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Сигнали (2)</a></li><li><a href=\"#zakonoproekti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Кой внесе и кой се изказа</a></li><li><a href=\"#argumenti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Двете страни</a></li><li><a href=\"#mnenie\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Твоето мнение</a></li><li><a href=\"#grupi\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Как гласуваха</a></li><li><a href=\"#glasuvaniya\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Гласувания (34)</a></li></ul></nav><section id=\"nakratko\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Накратко</h2><div class=\"max-w-4xl\"><p class=\"text-[17px]\">Държавен фонд „Земеделие“ може да изплаща обезщетения от Взаимоспомагателен фонд при неблагоприятни климатични явления и болести по растенията и животните; средствата идват от публично финансиране и от непотърсени от правоимащите суми по Закона за земеделските земи след 10 години. Фондът ще работи и по Социалния фонд за климата. Министерството на земеделието създава база данни за оранжериите и трайните насаждения. Проектът на „Прогресивна България“ дава възможност министерството да плаща вноската в европейската земеделска организация Copa-Cogeca на обединения на земеделски производители в обществена полза.</p><p class=\"mt-3 text-[15px]\"><b>Вносители:</b> <!-- -->Общ законопроект от проектите на Десислава Танева и др. (ГЕРБ–СДС) и на Георги Георгиев, Маломир Власов, Рашид Узунов и др. („Прогресивна България“)<!-- --> · <a href=\"https://www.parliament.bg/bg/bills/ID/167520\" target=\"_blank\" rel=\"noreferrer\">законопроект <!-- -->52-653-11-6</a></p><p class=\"mt-3 text-[15px]\"><b>Какво се случи:</b> <!-- -->На първо четене (25.08.2026) и двата проекта минаха със 163–164 „за“ („Възраждане“ против или въздържали се). Окончателно — единодушно (170 „за“, 17.09.2026). В земеделската комисия трима депутати — Рашид Узунов, Георги Георгиев и Таня Гюрюшева-Николова — обявиха, че няма да гласуват заради потенциален конфликт на интереси; Георгиев и Узунов са вносители на проекта с Copa-Cogeca.</p></div></section><section id=\"signali\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Сигнали</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.</p><ul class=\"grid gap-3 md:grid-cols-2 max-w-5xl\"><li class=\"border-l-4 rounded-sm p-4 border-red bg-[#fdeff1]\"><p class=\"font-semibold\">Депутати обявиха конфликт на интереси</p><p class=\"text-[15px] text-muted mt-1\">От доклада на комисията: „В началото на заседанието народните представители Рашид Узунов, Георги Георгиев и Таня Гюрюшева-Николова заявиха, че няма да участват в гласуването предвид наличието на потенциален конфликт на интереси.“</p></li><li class=\"border-l-4 rounded-sm p-4 border-rule bg-surface\"><p class=\"font-semibold\">Внесен от депутати</p><p class=\"text-[15px] text-muted mt-1\">Законопроектите на депутати не минават през задължителното 30-дневно обществено обсъждане на strategy.bg, както тези на Министерския съвет, и често нямат подробна оценка на въздействието.</p></li></ul><p class=\"text-sm mt-3\"><a href=\"/parlament/signali\">Всички сигнали в парламента</a></p><p class=\"text-xs text-muted mt-2\">Сигналът е повод за въпрос, не доказателство за нарушение.<!-- --> <a class=\"underline\" href=\"/metodologiya#signal\">Как работим със сигналите</a></p></section><section id=\"zakonoproekti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Кой внесе и кой се изказа</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.</p><ul class=\"space-y-4 max-w-5xl\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167520\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Общ законопроект за изменение и допълнение на Закона за подпомагане на земеделските производители</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-653-11-6</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>27 август 2026 г.<!-- --> от <!-- -->депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по земеделието, храните и горите (водеща)</dd><dt class=\"text-muted\">Становища</dt><dd>Българска асоциация на собствениците на земеделски земи; Министерството на земеделието и храните по предложенията за изменения и допълнения</dd><dt class=\"text-muted\">Предложения</dt><dd>4<!-- --> писмени предложения на депутати между <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">първо</button></span> и <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">второ четене</button></span></dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11171\" target=\"_blank\" rel=\"noreferrer\">17 септември 2026 г.</a> (<!-- -->зала второ гласуване<!-- -->)</span></dd><dt class=\"text-muted\">Обнародван</dt><dd>ДВ, бр. 88/2026<!-- -->, приет на 17 септември 2026 г.</dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167215\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за подпомагане на земеделските производители</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-102</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>21 юли 2026 г.<!-- --> от <!-- -->Любен Иванов, Свилен Трифонов</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по земеделието, храните и горите (водеща); Комисия по правни въпроси (участваща); Комисия по околната среда и водите (участваща); Комисия за прякото участие на гражданите и взаимодействието с гражданското общество (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>Обединени земеделски производители; Министерството на земеделието и храните</dd></dl></li></ul><details class=\"mt-3 max-w-5xl\"><summary class=\"cursor-pointer font-semibold text-green py-2\">Още <!-- -->3<!-- --> законопроекта по този закон</summary><ul class=\"space-y-4 mt-2\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167213\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за допълнение на Закона за подпомагане на земеделските производители</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-100</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>21 юли 2026 г.<!-- --> от <!-- -->Божидар Божанов, Любен Иванов, Свилен Трифонов</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по земеделието, храните и горите (водеща)</dd><dt class=\"text-muted\">Становища</dt><dd>Министерството на земеделието и храните</dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167192\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за подпомагане на земеделските производители</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-91</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>15 юли 2026 г.<!-- --> от <!-- -->Георги Георгиев, Маломир Власов, Димитър Кънев и още 5 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по земеделието, храните и горите (водеща); Комисия по европейските въпроси и контрол на европейските фондове (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>Сдружение „Обединени земеделски производители“; Национален браншови пчеларски съюз; Национален съюз на земеделските кооперации в България; Български фермерски съюз; Национална браншова камара &quot;Плодове и зеленчуци&quot;; Министерството на земеделието и храните; Асоциация на овощарите в България; Българска асоциация на консултантите по европейски програми; Българска асоциация на производителите на оранжерийна продукция; Асоциация на земеделските производители в България; Съюз на птицевъдите в България</dd><dt class=\"text-muted\">В комисията</dt><dd><span>земеделието, храните и горите<!-- -->, <!-- -->първо гласуване<!-- -->: <!-- -->14<!-- --> за, <!-- -->1<!-- --> против<!-- -->, 1 въздържал се</span></dd><dt class=\"text-red font-semibold\">Конфликт на интереси</dt><dd>В началото на заседанието народните представители Рашид Узунов, Георги Георгиев и Таня Гюрюшева-Николова заявиха, че няма да участват в гласуването предвид наличието на потенциален конфликт на интереси.</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11160\" target=\"_blank\" rel=\"noreferrer\">25 август 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167126\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за подпомагане на земеделските производители</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-71</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>19 юни 2026 г.<!-- --> от <!-- -->Десислава Танева, Георги Станков, Румен Христов и още 1 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по земеделието, храните и горите (водеща)</dd><dt class=\"text-muted\">Становища</dt><dd>Министерството на земеделието и храните</dd><dt class=\"text-muted\">В комисията</dt><dd><span>земеделието, храните и горите<!-- -->, <!-- -->първо гласуване<!-- -->: <!-- -->14<!-- --> за, <!-- -->0<!-- --> против<!-- -->, 2 въздържал се</span></dd><dt class=\"text-red font-semibold\">Конфликт на интереси</dt><dd>В началото на заседанието народните представители Рашид Узунов, Георги Георгиев и Таня Гюрюшева-Николова заявиха, че няма да участват в гласуването предвид наличието на потенциален конфликт на интереси.</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11160\" target=\"_blank\" rel=\"noreferrer\">25 август 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li></ul></details></section><div id=\"argumenti\" class=\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\"><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Десислава Танева (ГЕРБ–СДС)</p><p class=\"text-[15px]\">Без закона новите европейски инструменти — Социалният фонд за климата и управлението на риска чрез взаимоспомагателен фонд — не могат да се прилагат.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167126\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-71 (Д. Танева и др.)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Георги Георгиев („Прогресивна България“)</p><p class=\"text-[15px]\">Плащането на вноската в Copa-Cogeca дава на българските земеделци представителство в Брюксел; парите са целеви и само за това.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167192\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-91 (Г. Георгиев и др.), доклад на земеделската комисия\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Браншови организации в комисията</p><p class=\"text-[15px]\">„Категорични възражения“ срещу финансирането на вноската в Copa-Cogeca; предложение това да е държавна помощ и първо да се приеме закон за критериите за представителност на браншовите организации.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167192\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-91 (Г. Георгиев и др.), доклад на земеделската комисия\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Министерството на земеделието</p><p class=\"text-[15px]\">Не подкрепя проекта на ГЕРБ–СДС, но подкрепя проекта на „Прогресивна България“.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167192\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-91 (Г. Георгиев и др.), доклад на земеделската комисия\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">„Възраждане“</p><p class=\"text-[15px]\">Няма да подкрепят заради бележките по Copa-Cogeca.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167192\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-91 (Г. Георгиев и др.), доклад на земеделската комисия\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Двете страни на монетата</h3><p class=\"text-sm text-muted mb-3\">Какво следва на практика, ако законът се приеме и ако се отхвърли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167192\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-91 (Г. Георгиев и др.), доклад на земеделската комисия\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\"><p class=\"font-semibold\">Ако се приеме</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Работещ механизъм за обезщетения при бедствия.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Бюджетни пари за вноската на определени организации, без закон за представителността им.</li></ul></div></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\"><p class=\"font-semibold\">Ако се отхвърли</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Без обезщетения от Взаимоспомагателния фонд.</li></ul></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Какво печели и какво губи всяка страна</h3><p class=\"text-sm text-muted mb-3\">Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.</p><div class=\"space-y-3\"><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Земеделските стопани<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167192\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-91 (Г. Георгиев и др.), доклад на земеделската комисия\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Обезщетения при градушки, суши, болести; помощ по Социалния фонд за климата.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">—</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Браншовите организации<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167192\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-91 (Г. Георгиев и др.), доклад на земеделската комисия\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Държавата плаща вноската в Copa-Cogeca на одобрените обединения.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Организациите, които не са одобрени, остават без тази подкрепа.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Наследници на непотърсени суми<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167192\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-91 (Г. Георгиев и др.), доклад на земеделската комисия\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Непотърсените след 10 години суми отиват във фонда.</p></div></div></div></div></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://www.parliament.bg/bg/bills/ID/167192\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-654-01-91 (Г. Георгиев и др.), доклад на земеделската комисия</a></li><li><a href=\"https://www.parliament.bg/bg/bills/ID/167126\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-654-01-71 (Д. Танева и др.)</a></li><li><a href=\"https://www.parliament.bg/bg/bills/ID/167520\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: общ законопроект № 52-653-11-6</a></li><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания, Народно събрание (чрез „Наясно“)</a></li></ol><p class=\"text-xs text-muted mt-2\">Обобщението е по доклада на земеделската комисия. Конфликтът на интереси е записан в доклада.<!-- --> Проверено: <!-- -->19 ноември 2026 г.</p></div></div><section id=\"dokumenti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Още от документите</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.</p><div class=\"space-y-4 max-w-4xl\"><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167215\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за подпомагане на земеделските производители</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-102</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Чл. 84а. (1) Създава се модул „Хидромелиоративна инфраструктура“ като част от Системата за управление на националните инвестиции (СУНИ), поддържана от Министерския съвет. (2) Данните от модула са публични и се публикуват в електронен формат в Портала за отворени данни. (3) Модулът има за цел да повиши прозрачността, отчетността и контрола върху използването на публични и частни средства в хидромелиоративния сектор.<!-- -->“</li><li>„<!-- -->З1дпей Буги, 7еБ56833 -дес4-4есе-а/83-Ю07ваеетб5е А Кесоуега е Фапатиге Х Свилен Петров Трифонов Свилен Трифонов У1апед ру: еа70Тае!-с940-4601-Бееа-7саг5е3158се. мотиви към Законопроекта за изменение и допълнение на Закона за подпомагане на земеделските производители Инвестиционният план за инвестициите в хидромелиоративната инфраструктура 2025-2028 г. предвижда рекорден обем средства за напоителна инфраструктура.<!-- -->“</li><li>„<!-- -->Целта е да се осигури пълна прозрачност на процесите, отчетност и контрол при разходването на национални и европейски средства, да се предотвратят рискове от злоупотреби, дублиране на проекти и неефективно планиране и да се даде възможност за информирано участие на земеделски производители, стопани и граждани в процеса на развитие на напояването.<!-- -->“</li><li>„<!-- -->Основания за законодателната инициатива Законопроектът предвижда създаване на Система за управление на националните инвестиции (СУНИ), част от единна електронна платформа за публични инвестиции, с включен специализиран модул за хидромелиоративна инфраструктура.<!-- -->“</li><li>„<!-- -->Целта е изграждане на прозрачен, единен и публично достъпен механизъм за проследимост на проектите, финансирани със средства от държавния бюджет, европейски фондове и други публични източници.<!-- -->“</li><li>„<!-- -->Административна тежест и структурни промени Законопроектът не предвижда създаване на нова администрация, а въвеждане на задължения за. подаване на данни в рамките на съществуващи процедури.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167215\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->Обединени земеделски производители; Министерството на земеделието и храните<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167215\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167213\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за допълнение на Закона за подпомагане на земеделските производители</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-100</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->МОТИВИ Към Законопроект за допълнение на Закона за подпомагане на земеделските производители Предлаганото допълнение на Закона за подпомагане на земеделските производители има за цел да повиши прозрачността и възможностите за обществен контрол върху разходването на публичните средства за подпомагане на земеделските производители.<!-- -->“</li><li>„<!-- -->Тези актове предвиждат ежегодно последващо оповестяване на информация за бенефициерите на Европейския фонд за гарантиране на земеделието и Европейския земеделски фонд за развитие на селските райони, публикуването й на единен уебсайт и предоставянето й в отворен, машинночетим формат, позволяващ извличането й като единен набор от данни.<!-- -->“</li><li>„<!-- -->При публикуването следва да бъдат спазвани изискванията за защита на личните данни, както и принципите на необходимост, пропорционалност и свеждане на данните до необходимия минимум, особено когато чрез данните за земеделските парцели може да се стигне до косвено идентифициране на физически лица.<!-- -->“</li><li>„<!-- -->Част първа Елементи на Аргументация оценката Основания на законодателната | Основание за законодателната инициатива е необходимостта от инициатива повишаване на прозрачността и обществения контрол при предоставянето на земеделско подпомагане чрез разширяване на обхвата на публикуваните данни и осигуряване на достъпа до тях в отворен, машинночетим формат, в съответствие с действащата европейска правна рамка и изискванията на Закона за достъп до обществена информация.<!-- -->“</li><li>„<!-- -->Анализ на Предложението не води до изменение на приходите и не изисква допълнителни разходи за държавния бюджет, доколкото предвижда публикуване на данни, които се събират и обработват в рамките на съществуващите информационни системи. разходи и ползи Административна | Законопроектът не създава съществени нови административни тежест и тежести.<!-- -->“</li><li>„<!-- -->Не се предвиждат структурни промени. структурни промени Въздействие Приемането на законопроекта ще наложи съответно изменение и върху допълнение на Наредба Хо 105 от 22 август 2006 г. с оглед уреждане Елементи на Аргументация оценката нормативната на вида и обхвата на допълнително публикуваните данни, както и база на реда, формата и начина за тяхното предоставяне.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167213\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->Министерството на земеделието и храните<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167213\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167192\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за подпомагане на земеделските производители</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-91</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Отпада основанието за издаване на наредба за условията и реда за установяване на изкуствено създадени условия по заявления за подпомагане със средства на Европейския фонд за гарантиране в земеделието и Европейския земеделски фонд за развитие на селските райони.<!-- -->“</li><li>„<!-- -->Създава се възможност изпълнителният директор на Държавен фонд „Земеделие“ да делегира правомощия по изпълнението на Стратегическия план.<!-- -->“</li><li>„<!-- -->Предлага се Министерството на земеделието и храните да създаде и поддържа база данни за площи с оранжерии, оранжерии-парници и трайни насаждения, като съдържанието, условията и редът за създаването, поддържането, достъпът и ползването на информация от нея ще бъдат уредени с наредба.<!-- -->“</li><li>„<!-- -->С преходните и заключителните разпоредби се регламентира редът за осъществяване на проверките на съществуващите площи с трайни насаждения, оранжерии и оранжерии-парници.<!-- -->“</li><li>„<!-- -->Отменя се правното основание за издаване на наредба за условията и правилата за изпълнение и предоставяне на подкрепа чрез финансови инструменти.<!-- -->“</li><li>„<!-- -->Създава се правно основание за издаване на наредба от министъра на земеделието и храните, с която да се определят условията и редът за прилагане на интервенцията по чл. 78а от Регламент (ЕС) 2021/2115, включена в Стратегическия план, за предоставяне и изплащане на подпомагане, за отказ за изплащане и намаления на плащанията.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167192\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->В началото на заседанието народните представители Рашид Узунов, Георги Георгиев и Таня Гюрюшева-Николова заявиха, че няма да участват в гласуването предвид наличието на потенциален конфликт на интереси.<!-- -->“</li><li>„<!-- -->Народните представители от парламентарните групи на ГЕРБ–СДС, „Демократична България“ и „Движението за права и свободи – ДПС“ заявиха принципна подкрепа за законопроекта на първо гласуване, но настояха за формирането на работна група между първо и второ гласуване, която да прецизира предложените текстове.<!-- -->“</li><li>„<!-- -->Министерство на земеделието и храните подкрепя законопроекта и изразява позиция, че не подлежи на нотификация.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167192\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Бяха изложени както аргументи в подкрепа, така и категорични възражения.<!-- -->“</li><li>„<!-- -->Във връзка с отправените бележки от парламентарната група „ВЪЗРАЖДАНЕ“ заявиха, че няма да подкрепят законопроекта.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167192\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Десислава Танева</b><span class=\"text-muted\"> (<!-- -->ГЕРБ-СДС<!-- -->)</span>: „<!-- -->Ще бъда съвсем кратка. С настоящия законопроект, който представям – съвсем малка ретроспекция: в частите, в които сме го предложили в Петдесет и второто народно събрание, го предложихме и в предходно… Имаше такъв законопроект и в предходния мандат с вносител Министерският съвет и автор – екип на Министерството на земеделието. Поради различни причини – и края на мандата, и определено решение тогава на политическия…<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11160\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->25.08.2026</a></li><li><b>Георги Георгиев</b><span class=\"text-muted\"> (<!-- -->ПБ<!-- -->)</span>: „<!-- -->Както госпожа Танева каза, в голяма степен двата законопроекта… В голяма не бих казал, но все пак в немалка степен, двата законопроекта се<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11160\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->25.08.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->Сдружение „Обединени земеделски производители“; Национален браншови пчеларски съюз; Национален съюз на земеделските кооперации в България; Български фермерски съюз; Национална браншова камара &quot;Плодове и зеленчуци&quot;; Министерството на земеделието и храните; Асоциация на овощарите в България; Българска асоциация на консултантите по европейски програми; Българска асоциация на производителите на оранжерийна продукция; Асоциация на земеделските производители в България; Съюз на птицевъдите в България<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167192\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167126\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за подпомагане на земеделските производители</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-71</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Десислава Танева, която припомни, че подобен законопроект е бил разглеждан от комисията в предходното Народно събрание и че той има за цел да осигури възможност за прилагане на новите видове подпомагане на земеделските стопани – подпомагане на мерки и инвестиции, финансирани от Социалния фонд за климата и прилагане на инструмента за управление на риска чрез Взаимоспомагателния фонд при възникване на неблагоприятни климатични явления.<!-- -->“</li><li>„<!-- -->Управителният съвет на Държавен фонд „Земеделие“ ще утвърждава указания за всеки прием, с които ще определя размера на средствата и на обезщетенията във връзка с прилагането на инструмента за управление на риска.<!-- -->“</li><li>„<!-- -->В тази връзка с преходните и заключителните разпоредби се регламентира редът за осъществяване на инвентаризацията на съществуващите площи с трайни насаждения и оранжерии.<!-- -->“</li><li>„<!-- -->Предвижда се да се предоставя подкрепа при настъпването на неблагоприятни климатични събития.<!-- -->“</li><li>„<!-- -->Подробни правила за реда за предоставяне на подпомагане, за оценка на щетите и за администриране на плащанията се предвижда да се уредят в наредба, издадена от министъра на земеделието и храните.<!-- -->“</li><li>„<!-- -->С проекта на закон се предвижда Министерството на земеделието и храните да поддържа географски цифрови данни за площи с оранжерии и трайни насаждения.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167126\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Министерство на земеделието и храните не подкрепя законопроекта и изразява позиция, че не подлежи на нотификация, ако бъде подкрепен.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167126\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Десислава Танева</b><span class=\"text-muted\"> (<!-- -->ГЕРБ-СДС<!-- -->)</span>: „<!-- -->Ще бъда съвсем кратка. С настоящия законопроект, който представям – съвсем малка ретроспекция: в частите, в които сме го предложили в Петдесет и второто народно събрание, го предложихме и в предходно… Имаше такъв законопроект и в предходния мандат с вносител Министерският съвет и автор – екип на Министерството на земеделието. Поради различни причини – и края на мандата, и определено решение тогава на политическия…<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11160\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->25.08.2026</a></li><li><b>Георги Георгиев</b><span class=\"text-muted\"> (<!-- -->ПБ<!-- -->)</span>: „<!-- -->Както госпожа Танева каза, в голяма степен двата законопроекта… В голяма не бих казал, но все пак в немалка степен, двата законопроекта се<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11160\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->25.08.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->Министерството на земеделието и храните<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167126\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div></div></section><section id=\"mnenie\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Твоето мнение</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. <a href=\"/mnenie\">Всички закони за гласуване</a>.</p><div class=\"bg-surface rounded-sm p-5 text-[15px] text-muted\">Зарежда се…</div></section><section id=\"grupi\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласуваха групите по този закон</h2></div><p class=\"text-sm text-muted mb-3\">Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо <!-- -->34<!-- -->. Прието: <!-- -->18<!-- -->, отхвърлено: <!-- -->16<!-- -->.</p><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Прогресивна България</p><p class=\"num text-sm mt-1\">За: <b>18</b> · Против: <b>16</b> · общо <!-- -->34</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ГЕРБ – СДС</p><p class=\"num text-sm mt-1\">За: <b>21</b> · Против: <b>5</b> · общо <!-- -->34</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Демократична България</p><p class=\"num text-sm mt-1\">За: <b>27</b> · Против: <b>1</b> · общо <!-- -->34</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ДПС</p><p class=\"num text-sm mt-1\">За: <b>25</b> · Против: <b>5</b> · общо <!-- -->34</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Продължаваме промяната</p><p class=\"num text-sm mt-1\">За: <b>23</b> · Против: <b>3</b> · общо <!-- -->33</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Възраждане</p><p class=\"num text-sm mt-1\">За: <b>21</b> · Против: <b>3</b> · общо <!-- -->34</p></div></div><p class=\"text-sm mt-3\">Първо четене: <a href=\"/parlament/glasuvane/2026-08-25-18\">25 август 2026 г.</a><a href=\"/parlament/glasuvane/2026-08-25-19\">25 август 2026 г.</a></p></section><section id=\"glasuvaniya\" class=\"scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Всички гласувания по закона</h2></div><ul><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-08-25-18\">Закона за подпомагане на земеделските производители - първо гласуване - вносител Десислава Танева и група н.п</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">25 август 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Въздържал се</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-08-25-19\">Закона за подпомагане на земеделските производители - първо гласуване - вносител Георги Петров Георгиев и група н.п</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">25 август 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-09-17-21\">Закона за подпомагане на земеделските производители – второ гласуване - наименование</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието единодушно</span></div><p class=\"text-sm text-muted mt-1\">17 септември 2026 г.<!-- --> · <!-- -->Второ четене: наименование<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: За</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-09-17-22\">Закона за подпомагане на земеделските производители – второ гласуване - параграф 1 - предложение от Любен Иванов и група н.п</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-muted border border-rule\">Отхвърлено</span></div><p class=\"text-sm text-muted mt-1\">17 септември 2026 г.<!-- --> · <!-- -->Второ четене: предложение на депутат<!-- --> · <!-- -->Прогресивна България: Против · ГЕРБ – СДС: Въздържал се · Демократична България: За · ДПС: Против · Продължаваме промяната: Отсъства · Възраждане: Въздържал се</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-09-17-23\">Закона за подпомагане на земеделските производители – второ гласуване - параграф 1</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">17 септември 2026 г.<!-- --> · <!-- -->Второ четене: текст на закона<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Въздържал се</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-09-17-24\">Закона за подпомагане на земеделските производители – второ гласуване - параграф 2 - предложение от Десислава Танева и група н.п</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-muted border border-rule\">Отхвърлено</span></div><p class=\"text-sm text-muted mt-1\">17 септември 2026 г.<!-- --> · <!-- -->Второ четене: предложение на депутат<!-- --> · <!-- -->Прогресивна България: Против · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Въздържал се</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-09-17-25\">Закона за подпомагане на земеделските производители – второ гласуване - параграф 2</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm 