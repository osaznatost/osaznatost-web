 mb-1\\\",\\\"children\\\":\\\"В пленарната зала\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-2 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"children\\\":\\\"Десислава Танева\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-muted\\\",\\\"children\\\":[\\\" (\\\",\\\"ГЕРБ-СДС\\\",\\\")\\\"]}],\\\": „\\\",\\\"Ще бъда съвсем кратка. С настоящия законопроект, който представям – съвсем малка ретроспекция: в частите, в които сме го предложили в Петдесет и второто народно събрание, го предложихме и в предходно… Имаше такъв законопроект и в предходния мандат с вносител Министерският съвет и автор – екип на Министерството на земеделието. Поради различни причини – и края на мандата, и определено решение тогава на политическия…\\\",\\\"“ \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11160\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"className\\\":\\\"text-sm whitespace-nowrap\\\",\\\"children\\\":[\\\"стенограма, \\\",\\\"25.08.2026\\\"]}]]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"children\\\":\\\"Георги Георгиев\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-muted\\\",\\\"children\\\":[\\\" (\\\",\\\"ПБ\\\",\\\")\\\"]}],\\\": „\\\",\\\"Както госпожа Танева каза, в голяма степен двата законопроекта… В голяма не бих казал, но все пак в немалка степен, двата законопроекта се\\\",\\\"“ \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11160\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"className\\\":\\\"text-sm whitespace-nowrap\\\",\\\"children\\\":[\\\"стенограма, \\\",\\\"25.08.2026\\\"]}]]}]]}]]}]\\n46:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"children\\\":\\\"Писмени становища внесоха:\\\"}],\\\" \\\",