assName\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-654-01-58\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Предлага се намаляване на броя заплати, изплатени при прекратяване на правоотношенията в МВР. за всички бъдещи правоотношения, от 20 на 10 заплати.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Предлага се натрупаният отпуск да се изплаща спрямо нивото на заплащане към края на годината, в която е натрупан съответният отпуск, а не към момента на изплащане.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Министърът на вътрешните работи приема вътрешни правила, по които следва да осигури упражняването на правомощията за прекратяване на служебните правоотношения със служители, упражнили правото си на пенсия, като това следва да се извършва на ежегодна база, като при изплащане на обезщетения на стойност над 10 заплати, се предвижда това да бъде направено в двс последователни години.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"Предлага се и администрацията на Министерския съвет да публикува данни за служителите във всички министерства и техните подчинени структури, както и за броя на служитслитс, които са упражнили право на пенсия.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Част първа Елементи на Аргументация оценката Основания на Настоящата > законодателна инициатива се основава на законодателната необходимостта от оптимизиране на разходите в Министерството инициатива. на вътрешните работи, повишаване на предвидимостта при управлението на кадровия ресурс и въвеждане на по-голяма прозрачност относно числеността и структурата на застостта в държавната администрация.\",\"“\"]}],[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"С предложените изменения се предвижда за бъдещите служебни правоотношения в МВР да бъде намален размерът на обезщетението при прекратяване на правоотношението, като същевременно се запазват придобитите права и очаквания на настоящите служители при условията, действали към момента на тяхното назначаване.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167066\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#8a8f8c] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Позиции, изказани в комисията\"}],\"$L34\",\"$L35\"]}],\"$L36\",false,\"$L37\"]}]]}]]}],\"$L38\"]}]]}]\n20:[\"$\",\"section\",null,{\"id\":\"mnenie\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Твоето мнение\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":[\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \",[\"$\",\"$La\",null,{\"href\":\"/mnenie\",\"children\":\"Всички закони за гласуване\"}],\".\"]}],[\"$\",\"$L39\",null,{\"item\":\"ministerstvoto-na-vatreshnite-raboti\",\"question\":\"Подкрепяш ли последните промени в „Закон за МВР (терористично съдържание онлайн и европейски бази данни)“?\"}]]}]\n21:[\"$\",\"section\",null,{\"id\":\"grupi\",\"className\":\"mb-12 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb