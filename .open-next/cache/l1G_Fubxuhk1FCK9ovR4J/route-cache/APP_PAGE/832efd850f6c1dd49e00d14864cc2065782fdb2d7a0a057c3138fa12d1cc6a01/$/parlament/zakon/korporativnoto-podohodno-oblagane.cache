className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Още от документите\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":\\\"Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-4 max-w-4xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"167629\\\",{\\\"className\\\":\\\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted\\\",\\\"children\\\":\\\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mt-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167629\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"className\\\":\\\"text-ink\\\",\\\"children\\\":\\\"Законопроект за изменение и допълнение на Закона за корпоративното подоходно облагане\\\"}],\\\" \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-muted num font-normal\\\",\\\"children\\\":[\\\"№ \\\",\\\"52-602-01-65\\\"]}]]}],[\\\"$\\\",\\\"details\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer font-semibold text-green mt-2\\\",\\\"children\\\":\\\"Покажи цитатите\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-5 mt-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-green pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Какво предлага законопроектът\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"Предлага се за данъчни цели да се признават счетоводните разходи за дарения, направени в полза на: лица, вписани в регистъра по чл. 9, ал. 1, т. 1 и 2 от Закона за физическото възпитание и спорта; юридически лица с нестопанска цел за осъществяване на общественополезна дейност, които развиват спорт за всички и детски градини, училища, висши училища и академии, както и диференциран подход чрез три нива на данъчно признати разходи, обвързани с предназначението на дарението.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"Целта е предотвратяване на възможностите за данъчни злоупотреби и за ограничаване на схемите за изкуствено прехвърляне на печалби, като едновременно с това ще се гарантира, че финансовите средства ще се използват в реална обществена полза.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[\\\"„\\\",\\\"В средносрочен и дългосрочен план се очакват компенсиращи ефекти, свързани с намаляване на публичните разходи в секторите здравеопазване и социална политика и мултиплициращ ефект върху свързани икономически сектори – строителство, услуги, организация на спортни събития.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[\\\"„\\\",\\\"Основните предложения за промени се отнасят до: - въвеждане на пакет от документи, съдържащ правила за паралелно прилагане на глобалното минимално данъчно облагане на многонационалните групи предприятия и правила за облекчени режими, както и промени, свързани с прецизиращи уточнения и технически корекции, свързани с минимално данъчно облагане.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"children\\\":[\\\"„\\\",\\\"Бюджетният ефект от промяната не може да бъде изчислен, предвид отсъствието на достатъчно аналитична информация; - промяна в режима за пренасяне на данъчните загуби, при който ограничението за пренасяне на данъчните загуби се увеличава от 5 на 10 години, но се въвежда ограничение върху размера на приспадането през всяка данъчна година до 70 на сто от положителния данъчен финансов резултат преди приспадането им.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"5\\\",{\\\"children\\\":[\\\"„\\\",\\\"Бюджетният ефект от промяната не може да бъде изчислен, предвид отсъствието на достатъчно аналитична информация; - въвеждане на ускорена данъчна амортизация за системи за изкуствен интелект или за високопроизводителна компютърна техника и сървърна инфраструктура, с което се цели да се подобри конкурентоспособността на предприятията, които извършват инвестиции в дигитализация.\\\",\\\"“\\\"]}]]}],\\\"$L29\\\"]}],\\\"$L2a\\\",\\\"$L2b\\\",\\\"$L2c\\\",\\\"$L2d\\\"]}]]}]]}],\\\"$L2e\\\",\\\"$L2f\\\"]}]]}]\\n1f:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"mnenie\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Твоето мнение\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":[\\\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \\\",[\\\"$\\\",\\\"$La\\\",null,{\\\"href\\\":\\\"/mnenie\\\",\\\"children\\\":\\\"Всички закони за гласуване\\\"}],\\\".\\\"]}],[\\\"$\\\",\\\"$L30\\\",null,{\\\"item\\\":\\\"korporativnoto-podohodno-oblagane\\\",\\\"question\\\":\\\"Подкрепяш ли последните промени в „Закон за корпоративното подоходно облагане (глобален минимален данък, загуби, амортизации)“?\\\"}]]}]\\n20:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"grupi\\\",\\\"className\\\":\\\"mb-12 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-end justify-between gap-4 mb-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2rem] sm:text-[2.4rem]\\\",\\\"children\\\":\\\"Как г