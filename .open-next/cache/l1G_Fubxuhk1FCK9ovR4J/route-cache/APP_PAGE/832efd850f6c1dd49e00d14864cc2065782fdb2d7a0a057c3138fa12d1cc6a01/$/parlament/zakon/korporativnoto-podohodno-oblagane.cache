{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/zakon/layout,_N_T_/parlament/zakon/[slug]/layout,_N_T_/parlament/zakon/[slug]/page,_N_T_/parlament/zakon/korporativnoto-podohodno-oblagane"},"segmentPaths":["/_tree","/_full","/parlament/zakon/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/832efd850f6c1dd49e00d14864cc2065782fdb2d7a0a057c3138fa12d1cc6a01/$/parlament/zakon/korporativnoto-podohodno-oblagane","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/zakon/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2bx3suebn7wim.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><script src=\"/_next/static/chunks/43gzry38n6x69.js\" async=\"\"></script><title>Закон за корпоративното подоходно облагане · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Закон за корпоративното подоходно облагане · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Закон за корпоративното подоходно облагане · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Парламент</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Закон</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Закон за корпоративното подоходно облагане</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Приет на първо четене на 11.11.2026 г.; предстои второ четене</div></div></div><nav aria-label=\"Секции на страницата\" class=\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\"><ul class=\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\"><li><a href=\"#nakratko\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Накратко</a></li><li><a href=\"#signali\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Сигнали (1)</a></li><li><a href=\"#zakonoproekti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Кой внесе и кой се изказа</a></li><li><a href=\"#argumenti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Двете страни</a></li><li><a href=\"#mnenie\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Твоето мнение</a></li><li><a href=\"#grupi\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Как гласуваха</a></li><li><a href=\"#glasuvaniya\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Гласувания (3)</a></li></ul></nav><section id=\"nakratko\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Накратко</h2><div class=\"max-w-4xl\"><p class=\"text-[17px]\">Правителственият законопроект въвежда указанията на ОИСР за глобалния минимален данък на многонационалните групи; вдига прага за данъчен дълготраен актив от 700 лв. на 1 000 €; удължава срока за пренасяне на данъчни загуби от 5 на 10 години, но ограничава приспадането до 70% от печалбата за годината; въвежда ускорена данъчна амортизация за системи с изкуствен интелект и мощна компютърна и сървърна техника. За повечето мерки Министерството на финансите посочва, че бюджетният ефект „не може да бъде изчислен“.</p><p class=\"mt-3 text-[15px]\"><b>Вносители:</b> <!-- -->Министерският съвет (представи зам.-министърът на финансите Людмила Петкова). Отхвърлени: проект на служебното правителство за данъчни облекчения при дарения и проект на Мартин Димитров и др. (ПП–ДБ).<!-- --> · <a href=\"https://www.parliament.bg/bg/bills/ID/167629\" target=\"_blank\" rel=\"noreferrer\">законопроект <!-- -->52-602-01-65</a></p><p class=\"mt-3 text-[15px]\"><b>Какво се случи:</b> <!-- -->Първо четене на 11.11.2026 г.: 127 „за“ („Прогресивна България“), 75 „против“ (всички останали групи). Проектът на служебното правителство за дарения беше отхвърлен (135 въздържали се, 39 против), а проектът на ПП–ДБ — също (126 въздържали се).</p></div></section><section id=\"signali\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Сигнали</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.</p><ul class=\"grid gap-3 md:grid-cols-2 max-w-5xl\"><li class=\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\"><p class=\"font-semibold\">Институция не подкрепя поне един от законопроектите</p><p class=\"text-[15px] text-muted mt-1\">От доклада на комисията: „В писменото си становище Министерството на финансите не подкрепя Законопроекта за изменение и допълнение на Закона за корпоративното подоходно облагане, № 52-654-01-132, внесен от Мартин Димитров и група народни представители на 10.09.2026 г.“</p></li></ul><p class=\"text-sm mt-3\"><a href=\"/parlament/signali\">Всички сигнали в парламента</a></p><p class=\"text-xs text-muted mt-2\">Сигналът е повод за въпрос, не доказателство за нарушение.<!-- --> <a class=\"underline\" href=\"/metodologiya#signal\">Как работим със сигналите</a></p></section><section id=\"zakonoproekti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Кой внесе и кой се изказа</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.</p><ul class=\"space-y-4 max-w-5xl\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167629\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за корпоративното подоходно облагане</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-602-01-65</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>5 ноември 2026 г.<!-- --> от <!-- -->Министерския съвет</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща); Комисия по икономическа политика, инвестиции и индустрия (участваща); Комисия по европейските въпроси и контрол на европейските фондове (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>КНСБ по ЗИД на ЗКПО-65; БСК по ЗИД на ЗКПО-65; АИКБ по ЗИД на ЗКПО; BESCO по ЗИД на ЗКПО-65; Асоциации по ЗИД на ЗКПО-65; АББ по ЗИД на ЗКПО-65; НАМ по ЗИД на ЗКПО-65</dd><dt class=\"text-muted\">Предложения</dt><dd>8<!-- --> писмени предложения на депутати между <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">първо</button></span> и <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">второ четене</button></span></dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11195\" target=\"_blank\" rel=\"noreferrer\">11 ноември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167541\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за корпоративното подоходно облагане</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-132</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>10 септември 2026 г.<!-- --> от <!-- -->Мартин Димитров, Божидар Божанов, Ивайло Мирчев и още 9 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща); Комисия по икономическа политика, инвестиции и индустрия (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>МФ по ЗИД на ЗКПО -132</dd><dt class=\"text-muted\">Несъгласие</dt><dd>В писменото си становище Министерството на финансите не подкрепя Законопроекта за изменение и допълнение на Закона за корпоративното подоходно облагане, № 52-654-01-132, внесен от Мартин Димитров и група народни представители на 10.09.2026 г.</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11195\" target=\"_blank\" rel=\"noreferrer\">11 ноември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li></ul><details class=\"mt-3 max-w-5xl\"><summary class=\"cursor-pointer font-semibold text-green py-2\">Още <!-- -->1<!-- --> законопроекта по този закон</summary><ul class=\"space-y-4 mt-2\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/166995\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за корпоративното подоходно облагане</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-602-01-9</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>7 май 2026 г.<!-- --> от <!-- -->Министерския съвет</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща); Комисия по въпросите на младежта и спорта (участваща); Комисия по образованието и науката (участваща)</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11195\" target=\"_blank\" rel=\"noreferrer\">11 ноември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li></ul></details></section><div id=\"argumenti\" class=\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\"><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Министерството на финансите</p><p class=\"text-[15px]\">Съответствие с правилата на ОИСР, стимул за инвестиции (по-висок праг за активи, ускорена амортизация за ИИ) и по-малко административна тежест.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167629\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-65, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Опозицията</p><p class=\"text-[15px]\">Всички опозиционни групи гласуваха против на първо четене.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\" title=\"Поименни гласувания, Народно събрание (чрез „Наясно“)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">КНСБ, БСК, АИКБ, BESCO и браншови асоциации</p><p class=\"text-[15px]\">Внесоха становища (публикувани на сайта на парламента).<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167629\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-65, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Отворен въпрос</p><p class=\"text-[15px]\">Таванът от 70% за приспадане на загубите увеличава данъка за фирмите, които излизат от загуби; бюджетният ефект на мерките не е изчислен.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167629\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-65, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Двете страни на монетата</h3><p class=\"text-sm text-muted mb-3\">Какво следва на практика, ако законът се приеме и ако се отхвърли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167629\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-65, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\"><p class=\"font-semibold\">Ако се приеме</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Стимули за технологични инвестиции и съответствие с ОИСР.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Неизчислен ефект върху приходите; по-висок данък за фирмите след загуби.</li></ul></div></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\"><p class=\"font-semibold\">Ако се отхвърли</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Несъответствие с правилата за минималния данък.</li></ul></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Какво печели и какво губи всяка страна</h3><p class=\"text-sm text-muted mb-3\">Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.</p><div class=\"space-y-3\"><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Фирми, които инвестират в техника и ИИ<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167629\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-65, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Ускорена амортизация, по-висок праг за активите.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">—</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Фирми с натрупани загуби<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167629\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-65, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">По-дълъг срок за пренасянето им.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Не могат да приспаднат повече от 70% от печалбата за годината.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Многонационални групи<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167629\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-65, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Облекчени режими по правилата на ОИСР.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Минимален ефективен данък.</p></div></div></div></div></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://www.parliament.bg/bg/bills/ID/167629\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-602-01-65, доклади и становища</a></li><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания, Народно събрание (чрез „Наясно“)</a></li></ol><p class=\"text-xs text-muted mt-2\">Обобщението е по доклада на бюджетната комисия за първо гласуване (част от текста му не е достъпна). Ще обновим след второто четене.<!-- --> Проверено: <!-- -->19 ноември 2026 г.</p></div></div><section id=\"dokumenti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Още от документите</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.</p><div class=\"space-y-4 max-w-4xl\"><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167629\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за корпоративното подоходно облагане</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-602-01-65</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Предлага се за данъчни цели да се признават счетоводните разходи за дарения, направени в полза на: лица, вписани в регистъра по чл. 9, ал. 1, т. 1 и 2 от Закона за физическото възпитание и спорта; юридически лица с нестопанска цел за осъществяване на общественополезна дейност, които развиват спорт за всички и детски градини, училища, висши училища и академии, както и диференциран подход чрез три нива на данъчно признати разходи, обвързани с предназначението на дарението.<!-- -->“</li><li>„<!-- -->Целта е предотвратяване на възможностите за данъчни злоупотреби и за ограничаване на схемите за изкуствено прехвърляне на печалби, като едновременно с това ще се гарантира, че финансовите средства ще се използват в реална обществена полза.<!-- -->“</li><li>„<!-- -->В средносрочен и дългосрочен план се очакват компенсиращи ефекти, свързани с намаляване на публичните разходи в секторите здравеопазване и социална политика и мултиплициращ ефект върху свързани икономически сектори – строителство, услуги, организация на спортни събития.<!-- -->“</li><li>„<!-- -->Основните предложения за промени се отнасят до: - въвеждане на пакет от документи, съдържащ правила за паралелно прилагане на глобалното минимално данъчно облагане на многонационалните групи предприятия и правила за облекчени режими, както и промени, свързани с прецизиращи уточнения и технически корекции, свързани с минимално данъчно облагане.<!-- -->“</li><li>„<!-- -->Бюджетният ефект от промяната не може да бъде изчислен, предвид отсъствието на достатъчно аналитична информация; - промяна в режима за пренасяне на данъчните загуби, при който ограничението за пренасяне на данъчните загуби се увеличава от 5 на 10 години, но се въвежда ограничение върху размера на приспадането през всяка данъчна година до 70 на сто от положителния данъчен финансов резултат преди приспадането им.<!-- -->“</li><li>„<!-- -->Бюджетният ефект от промяната не може да бъде изчислен, предвид отсъствието на достатъчно аналитична информация; - въвеждане на ускорена данъчна амортизация за системи за изкуствен интелект или за високопроизводителна компютърна техника и сървърна инфраструктура, с което се цели да се подобри конкурентоспособността на предприятията, които извършват инвестиции в дигитализация.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167629\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Народният представител Здравко Марков обоснова мярката за промяната в режима за пренасяне на данъчните загуби, при който ограничението за пренасяне на данъчните загуби се увеличава от 5 на 10 години с това, че същата е насочена към стартиращите компании и насърчава младите предприемачи, като Министерството на финансите допълни, че са подходили балансирано, отчитайки и практиката в другите държави-членки относно допусканията.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167629\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Към настоящия момент Министерството на финансите не подкрепя законопроекта във вида, в който е внесен от служебното правителство.<!-- -->“</li><li>„<!-- -->В преходните и заключителни разпоредби на закона се предвижда: - въвеждане на данък върху свръхпечалбата за конкретно пределен кръг лица, който да се прилага за 2027 г. и с който част от този извънреден икономически излишък бъде използван за постигане на обществено значими цели, без да се засяга нормалната предприемаческа дейност и без да се подкопават стимулите за инвестиции и растеж.<!-- -->“</li><li>„<!-- -->ПГ ВЪЗРАЖДАНЕ изрази позиция за неподкрепа на предлаганата уредба за ваучерите, както и ще предложат прага от 5 млн. евро да бъде увеличен двойно, с оглед стимулиране на българския бизнес в областта на малките предприятия.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167629\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Петър Петров</b><span class=\"text-muted\"> (<!-- -->ВЪЗРАЖДАНЕ<!-- -->)</span>: „<!-- -->Уважаема госпожо Председател, ще помоля за прегласуване на така направеното искане, тъй като Столичната топлофикация предизвика през последните няколко месеца вниманието на обществото и все повече насочи вниманието към себе си не само заради огромната си задлъжнялост, която гони вече милиард и половина евро, а и също заради своята дейност, следствие от която почти ежедневно виждаме в репортажи по телевизиите – с…<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11195\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->11.11.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->КНСБ по ЗИД на ЗКПО-65; БСК по ЗИД на ЗКПО-65; АИКБ по ЗИД на ЗКПО; BESCO по ЗИД на ЗКПО-65; Асоциации по ЗИД на ЗКПО-65; АББ по ЗИД на ЗКПО-65; НАМ по ЗИД на ЗКПО-65<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167629\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167541\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за корпоративното подоходно облагане</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-132</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Предлага се за данъчни цели да се признават счетоводните разходи за дарения, направени в полза на: лица, вписани в регистъра по чл. 9, ал. 1, т. 1 и 2 от Закона за физическото възпитание и спорта; юридически лица с нестопанска цел за осъществяване на общественополезна дейност, които развиват спорт за всички и детски градини, училища, висши училища и академии, както и диференциран подход чрез три нива на данъчно признати разходи, обвързани с предназначението на дарението.<!-- -->“</li><li>„<!-- -->Целта е предотвратяване на възможностите за данъчни злоупотреби и за ограничаване на схемите за изкуствено прехвърляне на печалби, като едновременно с това ще се гарантира, че финансовите средства ще се използват в реална обществена полза.<!-- -->“</li><li>„<!-- -->В средносрочен и дългосрочен план се очакват компенсиращи ефекти, свързани с намаляване на публичните разходи в секторите здравеопазване и социална политика и мултиплициращ ефект върху свързани икономически сектори – строителство, услуги, организация на спортни събития.<!-- -->“</li><li>„<!-- -->Той посочи, че с него се предлага въвеждане на стъпки на нулева ставка на реинвестираната печалба в машини, производствено оборудване и апаратура.<!-- -->“</li><li>„<!-- -->Целта е фирмите да бъдат стимулирани да влагат печалбата в разширяване на производството или в ново производство, което да създаде условия и среда за повишаване на реалния икономически растеж в България.<!-- -->“</li><li>„<!-- -->Въвеждането на „нулев данък върху реинвестираната печалба&quot; има и положителен фискален ефект, като ще спомогне за преодоляване на продължаващия спад на индустриалното производство в България и ще създаде условия за ускорен икономически растеж.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167541\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Асоциацията на операторите на ваучерите за храна в България напълно подкрепят предлаганите мерки по законопроекта, внесен от Министерския съвет и касаещ уредбата на ваучерите за храна.<!-- -->“</li><li>„<!-- -->Асоциацията на индустриалния капитал в България подкрепя предложените инвестиционни и административни облекчения, включително коригираната редакция на ваучерите за храна, но категорично се противопоставя срещу данъка за свръхпечалбата, новото ограничение за приспадане на данъчните загуби.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167541\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Към настоящия момент Министерството на финансите не подкрепя законопроекта във вида, в който е внесен от служебното правителство.<!-- -->“</li><li>„<!-- -->Конфедерацията на работодателите и индустриалците в България изразяват принципни резерви към въвеждането на извънреден данък върху свръхпечалбата за 2027 г., който може да има негативно отражение върху условията за инвестиции в България, като детайлно разписват работещи хипотези, така както и предлагат прецизиране на текстове относно другите законодателни предложения.<!-- -->“</li><li>„<!-- -->Не подкрепят увеличенията на санкционните тежести чрез превалутиране, зад което разбиране са от КРИБ и БСК.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167541\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Петър Петров</b><span class=\"text-muted\"> (<!-- -->ВЪЗРАЖДАНЕ<!-- -->)</span>: „<!-- -->Уважаема госпожо Председател, ще помоля за прегласуване на така направеното искане, тъй като Столичната топлофикация предизвика през последните няколко месеца вниманието на обществото и все повече насочи вниманието към себе си не само заради огромната си задлъжнялост, която гони вече милиард и половина евро, а и също заради своята дейност, следствие от която почти ежедневно виждаме в репортажи по телевизиите – с…<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11195\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->11.11.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->МФ по ЗИД на ЗКПО -132<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167541\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/166995\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за корпоративното подоходно облагане</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-602-01-9</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Предлага се за данъчни цели да се признават счетоводните разходи за дарения, направени в полза на: лица, вписани в регистъра по чл. 9, ал. 1, т. 1 и 2 от Закона за физическото възпитание и спорта; юридически лица с нестопанска цел за осъществяване на общественополезна дейност, които развиват спорт за всички и детски градини, училища, висши училища и академии, както и диференциран подход чрез три нива на данъчно признати разходи, обвързани с предназначението на дарението.<!-- -->“</li><li>„<!-- -->Целта е предотвратяване на възможностите за данъчни злоупотреби и за ограничаване на схемите за изкуствено прехвърляне на печалби, като едновременно с това ще се гарантира, че финансовите средства ще се използват в реална обществена полза.<!-- -->“</li><li>„<!-- -->В средносрочен и дългосрочен план се очакват компенсиращи ефекти, свързани с намаляване на публичните разходи в секторите здравеопазване и социална политика и мултиплициращ ефект върху свързани икономически сектори – строителство, услуги, организация на спортни събития.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/166995\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Към настоящия момент Министерството на финансите не подкрепя законопроекта във вида, в който е внесен от служебното правителство.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/166995\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Петър Петров</b><span class=\"text-muted\"> (<!-- -->ВЪЗРАЖДАНЕ<!-- -->)</span>: „<!-- -->Уважаема госпожо Председател, ще помоля за прегласуване на така направеното искане, тъй като Столичната топлофикация предизвика през последните няколко месеца вниманието на обществото и все повече насочи вниманието към себе си не само заради огромната си задлъжнялост, която гони вече милиард и половина евро, а и също заради своята дейност, следствие от която почти ежедневно виждаме в репортажи по телевизиите – с…<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11195\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->11.11.2026</a></li></ul></div></div></details></div></div></section><section id=\"mnenie\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Твоето мнение</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. <a href=\"/mnenie\">Всички закони за гласуване</a>.</p><div class=\"bg-surface rounded-sm p-5 text-[15px] text-muted\">Зарежда се…</div></section><section id=\"grupi\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласуваха групите по този закон</h2></div><p class=\"text-sm text-muted mb-3\">Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо <!-- -->3<!-- -->. Прието: <!-- -->1<!-- -->, отхвърлено: <!-- -->2<!-- -->.</p><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Прогресивна България</p><p class=\"num text-sm mt-1\">За: <b>1</b> · Против: <b>0</b> · общо <!-- -->3</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ГЕРБ – СДС</p><p class=\"num text-sm mt-1\">За: <b>1</b> · Против: <b>2</b> · общо <!-- -->3</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Демократична България</p><p class=\"num text-sm mt-1\">За: <b>1</b> · Против: <b>1</b> · общо <!-- -->3</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ДПС</p><p class=\"num text-sm mt-1\">За: <b>1</b> · Против: <b>1</b> · общо <!-- -->3</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Продължаваме промяната</p><p class=\"num text-sm mt-1\">За: <b>1</b> · Против: <b>2</b> · общо <!-- -->3</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Възраждане</p><p class=\"num text-sm mt-1\">За: <b>1</b> · Против: <b>2</b> · общо <!-- -->3</p></div></div><p class=\"text-sm mt-3\">Първо четене: <a href=\"/parlament/glasuvane/2026-11-11-10\">11 ноември 2026 г.</a><a href=\"/parlament/glasuvane/2026-11-11-11\">11 ноември 2026 г.</a><a href=\"/parlament/glasuvane/2026-11-11-12\">11 ноември 2026 г.</a></p></section><section id=\"glasuvaniya\" class=\"scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Всички гласувания по закона</h2></div><ul><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-11-11-10\">Закона за корпоративното подоходно облагане – първо гласуване - вносител Министерски съвет на 07.05.2026 г</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-muted border border-rule\">Отхвърлено</span></div><p class=\"text-sm text-muted mt-1\">11 ноември 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: Въздържал се · ГЕРБ – СДС: Против · Демократична България: Разделени · ДПС: Въздържал се · Продължаваме промяната: Против · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-11-11-11\">Закона за корпоративното подоходно облагане – първо гласуване - вносител Мартин Димитров и група н.п</a><span class=\"inline-block text-xs f