\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted\\\",\\\"children\\\":\\\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mt-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/166975\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"className\\\":\\\"text-ink\\\",\\\"children\\\":\\\"Законопроект за изменение и допълнение на Закона за дейността на колективните инвестиционни схеми и на други предприятия за колективно инвестиране\\\"}],\\\" \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-muted num font-normal\\\",\\\"children\\\":[\\\"№ \\\",\\\"52-602-01-5\\\"]}]]}],[\\\"$\\\",\\\"details\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer font-semibold text-green mt-2\\\",\\\"children\\\":\\\"Покажи цитатите\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-5 mt-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-green pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Какво предлага законопроектът\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"Целта е условията за управляващите дружества на предприятия за колективно инвестиране да са сравними с тези на лицата, управляващи алтернативни инвестиционни фондове.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"С Регламент (ЕС) 2024/2809 и Директива (ЕС) 2024/2811 се предлага да се изменят праговете за публикуване на проспект, облекчава се режимът за изготвяне на проспекти чрез въвеждане на нови форми на документация и се въвеждат изменения, целящи стимулиране на капиталовия пазар, намаляване на административната тежест и разходите за пазарните участници.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[\\\"„\\\",\\\"С оглед осигуряване на мерки по прилагането на Регламент (ЕС) 2025/914 се предвиждат изменения и допълнения в Закона за пазарите на финансови инструменти, Закона за платежните услуги и платежните системи, Закона за Българската народна банка и в Закона за Комисията за финансов надзор относно разпределението на правомощия между националните органи във връзка с режимите за одобрение и надзор на бенчмаркове.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[\\\"„\\\",\\\"С предложението се цели по-добро планиране при организирането на процеса по възлагане на обществени поръчки.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"children\\\":[\\\"„\\\",\\\"Съобразно идентифицираната необходимост от хармонизация спрямо изискванията на чл. 53, параграф 2 от Директива 2009/65/ЕО се прецизира разпоредбата на чл. 46, ал. 2 от ЗДКИСДПКИ относно инвестиционните лимити.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"5\\\",{\\\"children\\\":[\\\"„\\\",\\\"Законопроектът предвижда промени в националното законодателство с цел адаптиране към измененията в Регламент (ЕС) 2017/1129, които уреждат изискванията за изготвяне, одобряване, публикуване и разпространение на проспекти при публично предлагане на ценни книжа и/или допускането им до търговия на регулиран пазар в държавите членки.\\\",\\\"“\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted mt-1\\\",\\\"children\\\":[\\\"Източник: \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/166975\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":\\\"доклад на комисията и мотиви, parliament.bg\\\"}]]}]]}],null,[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-red pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibo