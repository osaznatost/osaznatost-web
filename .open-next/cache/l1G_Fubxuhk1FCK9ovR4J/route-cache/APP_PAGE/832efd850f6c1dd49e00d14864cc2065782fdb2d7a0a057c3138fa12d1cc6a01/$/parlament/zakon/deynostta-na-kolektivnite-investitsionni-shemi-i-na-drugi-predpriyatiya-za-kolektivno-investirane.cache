s/ID/166975\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"законопроект \",\"52-602-01-5\"]}]]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Какво се случи:\"}],\" \",\"Първо четене на 24.06.2026 г. (141 „за“, „Възраждане“ против); срокът за предложения беше намален на 5 дни. На второ четене (30.07.2026) са приети нови параграфи, вкл. в преходните и заключителните разпоредби. В икономическата комисия: 20 „за“, 1 „против“.\"]}]]}]]}]\n1d:[\"$\",\"section\",null,{\"id\":\"signali\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Сигнали\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.\"}],[[\"$\",\"ul\",null,{\"className\":\"grid gap-3 md:grid-cols-2 max-w-5xl\",\"children\":[[\"$\",\"li\",\"1 нови текста в преходните и заключителните разпоредби\",{\"className\":\"border-l-4 rounded-sm p-4 border-red bg-[#fdeff1]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"1 нови текста в преходните и заключителните разпоредби\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Добавени са чак на второ четене, без обществено обсъждане. В тази част често се променят други закони. Прочетете ги в доклада на комисията и стенограмата.\"}]]}],[\"$\",\"li\",\"Съкратен срок за предложения (5 дни)\",{\"className\":\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Съкратен срок за предложения (5 дни)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Мнозинството гласува по-кратък срок от обичайните 7 дни, в който депутатите могат да внасят промени между първо и второ четене.\"}]]}],[\"$\",\"li\",\"Няма публикувани становища\",{\"className\":\"border-l-4 rounded-sm p-4 border-rule bg-surface\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Няма публикувани становища\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"На сайта на парламента няма становища на външни организации (браншове, синдикати, институции) по този законопроект.\"}]]}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3\",\"children\":[\"$\",\"$La\",null,{\"href\":\"/parlament/signali\",\"children\":\"Всички сигнали в парламента\"}]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-2\",\"children\":[\"Сигналът е повод за въпрос, не доказателство за нарушение.\",\" \",[\"$\",\"$La\",null,{\"href\":\"/metodologiya#signal\",\"className\":\"underline\",\"children\":\"Как работим със сигналите\"}]]}]]]}]\n1e:[\"$\",\"section\",null,{\"id\":\"zakonoproekti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Кой внесе и кой се изказа\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.\"}],[[\"$\",\"ul\",null,{\"className\":\"space-y-4 max-w-5xl\",\"children\":[[\"$\",\"li\",\"166975\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/166975\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за дейността на колективните инвестиционни схеми и на други предприятия за колективно инвестиране\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-602-01-5\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"5 май 2026 г.\",\" от \",\"Министерския съвет\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по икономическа политика, инвестиции и индустрия (водеща); Комисия по бюджет и финанси (участваща); Комисия по европейските въпроси и контрол на европейските фондове (участваща); Комисия по правни въпроси (участваща)\"}]],false,false,false,false,false,[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"В залата\"}],[\"$\",\"dd\",null,{\"children\":[[\"$\",\"span\",\"0\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11142\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"24 юни 2026 г.\"}],\" (\",\"зала първо гласуване\",\")\"]}],[\"$\",\"span\",\"1\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11158\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"30 юли 2026 г.\"}],\" (\",\"зала второ гласуване\",\")\"]}]]}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Обнародван\"}],[\"$\",\"dd\",null,{\"children\":[\"ДВ, бр. 71/2026\",\", приет на 30 юли 2026 г.\"]}]]]}]]}]]}],false]]}]\n1f:[\"$\",\"div\",null,{\"id\":\"argumenti\",\"className\":\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-2 mt-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-green bg-surface\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Мотивите на вносителите\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Министерството на финанситеЗаконът е нужен, за \",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Министерството на финансите\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Законът е нужен, за да се въведат директиви 2024/927 и 2024/2811 и регламенти на ЕС; целта е по-добра защита на инвеститорите и по-привлекателни публични капиталови пазари.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/166975\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-5, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Какво казват критиците\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"„Възраждане“Гласуваха против на \",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"„Възраждане“\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Гласуваха против на първо и второ четене; в доклада на комисията не са записани конкретни възражения.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/166975\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-5, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}],[\"$\",\"a\",\"2\",{\"href\":\"https://naiasno.bg/parliament\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Поименни гласувания, Народно събрание (чрез „Наясно“)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",2,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Отворен въпросНовите текстове на в\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Отворен въпрос\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Новите текстове на второ четене в преходните и заключителните разпоредби не са минали обществено обсъждане.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"2\",{\"href\":\"https://naiasno.bg/parliament\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Поименни гласувания, Народно събрание (чрез „Наясно“)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",2,\"]\"]}]]]}]]}]]}]]}]]}]]}],null,[\"$\",\"div\",null,{\"className\":\"mt-8\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.8rem] mb-1\",\"children\":\"Двете страни на монетата\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mb-3\",\"children\":[\"Какво следва на практика, ако законът се приеме и ако се отхвърли.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/166975\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-5, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Ако се приеме\"}],[\"$\",\"div\",null,{\"className\":\"space-y-2 mt-3\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-[#2f7d57]\",\"children\":\"Добрата страна\"}],[\"$\",\"ul\",null,{\"className\":\"list-none pl-0 space-y-1\",\"children\":[[\"$\",\"li\",\"Съответствие с правилата на ЕС и по-добра защита на инвеститорите.\",{\"className\":\"text-[15px] pl-4 relative before:content-['+'] before:absolute before:left-0 before:font-bold\",\"children\":\"Съответствие с правилата на ЕС и по-добра защита на инвеститорите.\"}]]}]]}],\"$L33\"]}]]}],\"$L34\"]}]]}],\"$L35\",null,\"$L36\"]}]\n20:[\"$\",\"section\",null,{\"id\":\"dokumenti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Още от документите\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 max-w-4xl\",\"children\":[[\"$\",\"div\",\"166975\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/166975\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за дейността на колективните инвестиционни схеми и на други предприятия за колективно инвестиране\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-602-01-5\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Целта е условията за управляващите дружества на предприятия за колективно инвестиране да са сравними с тези на лицата, управляващи алтернативни инвестиционни фондове.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"С Регламент (ЕС) 2024/2809 и Директива (ЕС) 2024/2811 се предлага да се изменят праговете за публикуване на проспект, облекчава се режимът за изготвяне на проспекти чрез въвеждане на нови форми на документация и се въвеждат изменения, целящи стимулиране на капиталовия пазар, намаляване на административната тежест и разходите за пазарните участници.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"С оглед осигуряване на мерки по прилагането на Регламент (ЕС) 2025/914 се предвиждат изменения и допълнения в Закона за пазарите на финансови инструменти, Закона за платежните услуги и платежните системи, Закона за Българската народна банка и в Закона за Комисията за финансов надзор относно разпределението на правомощия между националните органи във връзка с режимите за одобрение и надзор на бенчмаркове.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"С предложението се цели по-добро планиране при организирането на процеса по възлагане на обществени поръчки.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Съобразно идентифицираната необходимост от хармонизация спрямо изискванията на чл. 53, параграф 2 от Директива 2009/65/ЕО се прецизира разпоредбата на чл. 46, ал. 2 от ЗДКИСДПКИ относно инвестиционните лимити.\",\"“\"]}],[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"Законопроектът предвижда промени в националното законодателство с цел адаптиране към измененията в Регламент (ЕС) 2017/1129, които уреждат изискванията за изготвяне, одобряване, публикуване и разпространение на проспекти при публично предлагане на ценни книжа и/или допускането им до търговия на регулиран пазар в държавите членки.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/166975\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],null,[\"$\",\"div\",null,{\"className\":\"border-l-4 border-red pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Възражения и критики\"}],\"$L37\",\"$L38\"]}],\"$L39\",false]}]]}]]}]]}]]}]\n21:[\"$\",\"section\",null,{\"id\":\"mnenie\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Твоето мнение\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":[\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \",[\"$\",\"$La\",null,{\"href\":\"/mnenie\",\"children\":\"Всички закони за гласуване\"}],\".\"]}],[\"$\",\"$L3a\",null,{\"item\":\"deynostta-na-kolektivnite-investitsionni-shemi-i-na-drugi-predpriyatiya-za-kolektivno-investirane\",\"question\":\"Подкрепяш ли последните промени в „Закон за дейността на колективните инвестиционни схеми (фондове)“?\"}]]}]\n22:[\"$\",\"section\",null,{\"id\":\"grupi\",\"className\":\"mb-12 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb-5\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] sm:text-[2.4rem]\",\"children\":\"Как гласуваха групите по този закон\"}],\"$undefined\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mb-3\",\"children\":[\"Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо \",16,\". Прието: \",15,\", отхвърлено: \",1,\".\"]}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$