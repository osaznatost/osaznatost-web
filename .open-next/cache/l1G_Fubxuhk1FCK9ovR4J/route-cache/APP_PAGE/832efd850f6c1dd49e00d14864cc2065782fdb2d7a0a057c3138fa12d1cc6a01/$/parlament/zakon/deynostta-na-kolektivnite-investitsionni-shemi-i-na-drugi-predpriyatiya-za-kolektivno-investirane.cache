unded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Твоето мнение\"}]}],[\"$\",\"li\",\"grupi\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#grupi\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Как гласуваха\"}]}],[\"$\",\"li\",\"glasuvaniya\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#glasuvaniya\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Гласувания (16)\"}]}]]}]}],[\"$\",\"section\",null,{\"id\":\"nakratko\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Накратко\"}],\"$undefined\",[\"$\",\"div\",null,{\"className\":\"max-w-4xl\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[17px]\",\"children\":\"Законът въвежда няколко европейски директиви и регламента за инвестиционните фондове и капиталовите пазари: правила за делегиране на управлението, управление на ликвидния риск, надзорна отчетност, депозитарни услуги и заеми от алтернативни инвестиционни фондове. Комисията за финансов надзор може да задължи фонд да спре обратното изкупуване на дялове при извънредни обстоятелства, когато има риск за инвеститорите или финансовата стабилност. Част от мерките са за по-лесен достъп на малки и средни фирми до борсата.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Вносители:\"}],\" \",\"Министерският съвет (представи зам.-министърът на финансите Методи Методиев)\",[\" · \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/166975\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"законопроект \",\"52-602-01-5\"]}]]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Какво се случи:\"}],\" \",\"Първо четене на 24.06.2026 г. (141 „за“, „Възраждане“ против); срокът за предложения беше намален на 5 дни. На второ четене (30.07.2026) са приети нови параграфи, вкл. в преходните и заключителните разпоредби. В икономическата комисия: 20 „за“, 1 „против“.\"]}]]}]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\"]}]\n29:I[52368,[\"$2\",\"$9\"],\"CitizenVote\"]\n1b:[\"$\",\"section\",null,{\"id\":\"signali\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Сигнали\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.\"}],[[\"$\",\"ul\",null,{\"className\":\"grid gap-3 md:grid-cols-2 max-w-5xl\",\"children\":[[\"$\",\"li\",\"1 нови текста в преходните и заключителните разпоредби\",{\"className\":\"border-l-4 rounded-sm p-4 border-red bg-[#fdeff1]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"1 нови текста в преходните и заключителните разпоредби\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Добавени са чак на второ четене, без обществено обсъждане. В тази част често се променят други закони. Прочетете ги в доклада на комисията и стенограмата.\"}]]}],[\"$\",\"li\",\"Съкратен срок за предложения (5 дни)\",{\"className\":\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Съкратен срок за предложения (5 дни)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Мнозинството гласува по-кратък срок от обичайните 7 дни, в който депутатите могат да внасят промени между първо и второ четене.\"}]]}],[\"$\",\"li\",\"Няма публикувани становища\",{\"className\":\"border-l-4 rounded-sm p-4 border-rule bg-surface\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Няма публикувани становища\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"На сайта на парламента няма становища на външни организации (браншове, синдикати, институции) по този законопроект.\"}]]}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3\",\"children\":[\"$\",\"$La\",null,{\"href\":\"/parlament/signali\",\"children\":\"Всички сигнали в парламента\"}]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-2\",\"children\":[\"Сигналът е повод за въпрос, не доказателство за нарушение.\",\" \",[\"$\",\"$La\",null,{\"href\":\"/metodologiya#signal\",\"className\":\"underline\",\"children\":\"Как работим със сигналите\"}]]}]]]}]\n1c:[\"$\",\"section\",null,{\"id\":\"zakonoproekti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Кой внесе и кой се изказа\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.\"}],[[\"$\",\"ul\",null,{\"className\":\"space-y-4 max-w-5xl\",\"children\":[[\"$\",\"li\",\"166975\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/166975\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за дейността на колективните инвестиционни схеми и на други предприятия за колективно инвестиране\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-602-01-5\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"5 май 2026 г.\",\" от \",\"Министерския съвет\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по икономическа политика, инвестиции и индустрия (водеща); Комисия по бюджет и финанси (участваща); Комисия по европейските въпроси и контрол на европейските фондове (участваща); Комисия по правни въпроси (участваща)\"}]],false,false,false,false,false,[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"В залата\"}],[\"$\",\"dd\",null,{\"children\":[[\"$\",\"span\",\"0\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11142\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"24 юни 2026 г.\"}],\" (\",\"зала първо гласуване\",\")\"]}],[\"$\",\"span\",\"1\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11158\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"30 юли 2026 г.\"}],\" (\",\"зала второ гласуване\",\")\"]}]]}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Обнародван\"}],[\"$\",\"dd\",null,{\"children\":[\"ДВ, бр. 71/2026\",\", приет на 30 юли 2026 г.\"]}]]]}]]}]]}],false]]}]\n1d:[\"$\",\"div\",null,{\"id\":\"argumenti\",\"className\":\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-2 mt-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-green bg-surface\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Мотивите на вносителите\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Министерството на финанситеЗаконът е нужен, за \",{\"children\":[[\"$\",\"p\",null,{\"className\":