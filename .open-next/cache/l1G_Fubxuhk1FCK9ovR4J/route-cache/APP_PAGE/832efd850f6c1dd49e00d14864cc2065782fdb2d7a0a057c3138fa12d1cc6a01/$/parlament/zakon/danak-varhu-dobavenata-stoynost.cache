{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/zakon/layout,_N_T_/parlament/zakon/[slug]/layout,_N_T_/parlament/zakon/[slug]/page,_N_T_/parlament/zakon/danak-varhu-dobavenata-stoynost"},"segmentPaths":["/_tree","/_full","/parlament/zakon/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/832efd850f6c1dd49e00d14864cc2065782fdb2d7a0a057c3138fa12d1cc6a01/$/parlament/zakon/danak-varhu-dobavenata-stoynost","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/zakon/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2bx3suebn7wim.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><script src=\"/_next/static/chunks/43gzry38n6x69.js\" async=\"\"></script><title>Закон за данък върху добавената стойност · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Закон за данък върху добавената стойност · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Закон за данък върху добавената стойност · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Парламент</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Закон</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Закон за данък върху добавената стойност</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Приет на първо четене на 12.11.2026 г.; предстои второ четене</div></div></div><nav aria-label=\"Секции на страницата\" class=\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\"><ul class=\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\"><li><a href=\"#nakratko\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Накратко</a></li><li><a href=\"#signali\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Сигнали (1)</a></li><li><a href=\"#zakonoproekti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Кой внесе и кой се изказа</a></li><li><a href=\"#argumenti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Двете страни</a></li><li><a href=\"#mnenie\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Твоето мнение</a></li><li><a href=\"#grupi\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Как гласуваха</a></li><li><a href=\"#glasuvaniya\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Гласувания (8)</a></li></ul></nav><section id=\"nakratko\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Накратко</h2><div class=\"max-w-4xl\"><p class=\"text-[17px]\">Правителственият законопроект въвежда задължителни структурирани електронни фактури между фирмите и към държавата, подавани в реално време към НАП; дневниците за покупки и продажби отпадат, а НАП ще генерира проект на месечната декларация. Очакваният приход е 350 млн. € за 2028 г. и 450 млн. € за 2029 г. Въвежда се задължителна регистрация по ДДС преди първата продажба на нова сграда или парцел (+120 млн. €). Прагът за регистрация се вдига поетапно до 60 000 € (2027), 70 000 € (2028) и 75 000 € (2029). Глобите, непроменяни от 2007 г., се превръщат от лева в евро едно към едно (100 лв. стават 100 €), т.е. на практика се удвояват. Нулева ставка за отбранителни доставки по европейския инструмент SAFE.</p><p class=\"mt-3 text-[15px]\"><b>Вносители:</b> <!-- -->Министерският съвет (представи зам.-министърът на финансите Людмила Петкова). Пет проекта на опозицията бяха отхвърлени.<!-- --> · <a href=\"https://www.parliament.bg/bg/bills/ID/167624\" target=\"_blank\" rel=\"noreferrer\">законопроект <!-- -->52-602-01-60</a></p><p class=\"mt-3 text-[15px]\"><b>Какво се случи:</b> <!-- -->На първо четене (12.11.2026) правителственият проект мина със 122 „за“ и 49 „против“; срокът за предложения беше намален (132 „за“, 43 „против“). Отхвърлени бяха проекти на Мартин Димитров и др. (ПП–ДБ) за праг от 85 000 €, на Димо Дренчев, на Дренчев и Петров и на Цончо Ганев и др. — „Прогресивна България“ се въздържа.</p></div></section><section id=\"signali\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Сигнали</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.</p><ul class=\"grid gap-3 md:grid-cols-2 max-w-5xl\"><li class=\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\"><p class=\"font-semibold\">Съкратен срок за предложения</p><p class=\"text-[15px] text-muted mt-1\">Мнозинството гласува по-кратък срок от обичайните 7 дни, в който депутатите могат да внасят промени между първо и второ четене.</p></li></ul><p class=\"text-sm mt-3\"><a href=\"/parlament/signali\">Всички сигнали в парламента</a></p><p class=\"text-xs text-muted mt-2\">Сигналът е повод за въпрос, не доказателство за нарушение.<!-- --> <a class=\"underline\" href=\"/metodologiya#signal\">Как работим със сигналите</a></p></section><section id=\"zakonoproekti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Кой внесе и кой се изказа</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.</p><ul class=\"space-y-4 max-w-5xl\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167624\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за данък върху добавената стойност</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-602-01-60</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>5 ноември 2026 г.<!-- --> от <!-- -->Министерския съвет</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща); Комисия по европейските въпроси и контрол на европейските фондове (участваща); Комисия по иновациите и дигиталната трансформация (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>КНСБ по ЗИД на ЗДДС-60; НОМА по ЗИД на ЗДДС-60; Сдружение за модерна търговия; БСК по ЗИД на ЗДДС-60; АИКБ по ЗИД на ЗДДС; по Законопроект за изменение и допълнение на Закона за данък върху добавената стойност , № 52-602-01-60, БАПФОЕТ</dd><dt class=\"text-muted\">Предложения</dt><dd>7<!-- --> писмени предложения на депутати между <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">първо</button></span> и <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">второ четене</button></span></dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11196\" target=\"_blank\" rel=\"noreferrer\">12 ноември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167568\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение на Закона за данъка върху добавената стойност</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-150</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>23 септември 2026 г.<!-- --> от <!-- -->Цончо Ганев, Димо Дренчев, Ангел Янчев и още 6 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща); Комисия по икономическа политика, инвестиции и индустрия (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>МФ по ЗИД на ЗДДС-150 на Ц.Ганев и гр.н.п.; относно Законопроект за изменение на Закона за данъка върху добавената стойност 52-654-01-150</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11196\" target=\"_blank\" rel=\"noreferrer\">12 ноември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li></ul><details class=\"mt-3 max-w-5xl\"><summary class=\"cursor-pointer font-semibold text-green py-2\">Още <!-- -->4<!-- --> законопроекта по този закон</summary><ul class=\"space-y-4 mt-2\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167013\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение на Закона за данък върху добавената стойност</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-42</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>18 май 2026 г.<!-- --> от <!-- -->Димо Дренчев, Петър Петров</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща); Комисия по земеделието, храните и горите (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>относно проект на Закон за изменение и допълнение на Закона за данък върху добавената стойност от народни представители Димо Дренчев и Петър Петров</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11196\" target=\"_blank\" rel=\"noreferrer\">12 ноември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/166974\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение на Закона за данъка върху добавената стойност</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-26</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>5 май 2026 г.<!-- --> от <!-- -->Димо Дренчев</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща); Комисия по икономическа политика, инвестиции и индустрия (участваща)</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11196\" target=\"_blank\" rel=\"noreferrer\">12 ноември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/166952\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закон за данък върху добавената стойност</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-14</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>30 април 2026 г.<!-- --> от <!-- -->Ивайло Шотев, Асен Василев, Бойко Рашков и още 12 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща); Комисия по икономическа политика, инвестиции и индустрия (участваща)</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11164\" target=\"_blank\" rel=\"noreferrer\">2 септември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/166935\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение на Закона за данък върху добавената стойност</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-2</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>30 април 2026 г.<!-- --> от <!-- -->Мартин Димитров, Атанас Атанасов, Йордан Иванов и още 9 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща); Комисия по икономическа политика, инвестиции и индустрия (участваща)</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11196\" target=\"_blank\" rel=\"noreferrer\">12 ноември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li></ul></details></section><div id=\"argumenti\" class=\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\"><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Министерството на финансите</p><p class=\"text-[15px]\">Мерките изпълняват изисквания на ЕС и намаляват двойното въвеждане на данни; електронните фактури ще ограничат измамите с ДДС и ще донесат стотици милиони евро.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167624\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-60, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Министерството на финансите</p><p class=\"text-[15px]\">Глобите не са променяни от 2007 г. и са изгубили възпиращия си ефект.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167624\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-60, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Мартин Димитров (ПП–ДБ), за отхвърления проект</p><p class=\"text-[15px]\">Праг от 85 000 € ще освободи около 400 000 микро- и малки фирми от тежестта по ДДС; загубата за бюджета — около 100 млн. € през първата година.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167624\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-60, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Опозицията</p><p class=\"text-[15px]\">49 депутати гласуваха против на първо четене; против беше и намаляването на срока за предложения.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\" title=\"Поименни гласувания, Народно събрание (чрез „Наясно“)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">КНСБ, БСК, АИКБ, НОМА и Сдружението за модерна търговия</p><p class=\"text-[15px]\">Внесоха становища в бюджетната комисия (публикувани на сайта на парламента).<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167624\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-60, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Отворен въпрос</p><p class=\"text-[15px]\">Задължителните е-фактури изискват софтуер и обучение и натоварват най-много малките фирми; удвояването на глобите чрез превалутирането 1:1 не е представено като увеличение.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167624\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-60, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-3\">Какво казват данните</h3><ul class=\"space-y-2 list-none pl-0\"><li class=\"border-l-4 border-deep pl-4 text-[15px]\">Максимумът, който ЕС позволява, е 85 000 €. У нас той беше в сила само от януари до март 2025 г.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://burgasmedia.com/news/parlamentat-prie-na-parvo-chetene-po-visok-prag-za-dds-do-75-hil-evro-prez-2029-g\" target=\"_blank\" rel=\"noreferrer\" title=\"Бургас Медиа: Приет на първо четене по-висок праг за ДДС, до 75 хил. € през 2029 г. (12.11.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">2 септември: 39 „за“ (ДБ, ПП, „Възраждане“), 6 „против“ (ДПС), 119 „въздържал се“ (почти цялата „Прогресивна България“ и част от ГЕРБ–СДС).<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://burgasmedia.com/news/parlamentat-othvarli-povishavaneto-na-praga-za-dds-registraciya\" target=\"_blank\" rel=\"noreferrer\" title=\"Бургас Медиа: Парламентът отхвърли повишаването на прага за ДДС регистрация (02.09.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\" title=\"Поименни гласувания, Народно събрание (чрез „Наясно“)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">12 ноември: 122 „за“ (всички от „Прогресивна България“), 49 „против“, 18 „въздържал се“. Новият праг: 60 000 € през 2027, 70 000 € през 2028 и 75 000 € през 2029 г.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://burgasmedia.com/news/parlamentat-prie-na-parvo-chetene-po-visok-prag-za-dds-do-75-hil-evro-prez-2029-g\" target=\"_blank\" rel=\"noreferrer\" title=\"Бургас Медиа: Приет на първо четене по-висок праг за ДДС, до 75 хил. € през 2029 г. (12.11.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></li></ul></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Двете страни на монетата</h3><p class=\"text-sm text-muted mb-3\">Какво следва на практика, ако законът се приеме и ако се отхвърли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167624\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-60, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\"><p class=\"font-semibold\">Ако се приеме</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">По-малко измами с ДДС и повече приходи.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">По-малко административна тежест за най-малките фирми.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Разходи по въвеждането на е-фактурите.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">На практика двойно по-високи глоби.</li></ul></div></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\"><p class=\"font-semibold\">Ако се отхвърли</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Без приходите от е-фактурите бюджетът ще има по-голям дефицит.</li></ul></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Какво печели и какво губи всяка страна</h3><p class=\"text-sm text-muted mb-3\">Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.</p><div class=\"space-y-3\"><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Малки фирми с оборот до 75 000 €<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167624\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-60, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Не са длъжни да се регистрират по ДДС.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">—</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Регистрираните по ДДС фирми<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167624\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-60, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Без дневници, готов проект на декларация от НАП.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Задължителни структурирани е-фактури и нов софтуер; по-високи глоби.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Купувачи на нови жилища<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167624\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-60, доклади и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Продавачите на нови сгради и парцели трябва да начисляват ДДС, което може да се отрази в цената.</p></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-3\">Проверени твърдения</h3><ul class=\"space-y-3\"><li class=\"rounded-xl ring-1 ring-rule p-4 bg-white\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><p class=\"font-semibold\">„Прогресивна България“ отказа да вдигне прага за ДДС.</p><span class=\"text-sm font-semibold px-2.5 py-0.5 rounded-full bg-[#e2b33b] text-ink\">Подвеждащо</span></div><p class=\"text-[15px] text-muted mt-1\">През септември ПБ се въздържа по законопроекта на ПП и той не мина. Два месеца по-късно обаче мнозинството прие на първо четене собствен вариант с поетапно вдигане до 75 000 € през 2029 г. Вярното е, че отказа 85 000 € веднага.</p></li><li class=\"rounded-xl ring-1 ring-rule p-4 bg-white\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><p class=\"font-semibold\">Прагът ще стигне максимума, позволен от ЕС.</p><span class=\"text-sm font-semibold px-2.5 py-0.5 rounded-full bg-[#d2353f] text-white\">Невярно</span></div><p class=\"text-[15px] text-muted mt-1\">Правителственият вариант стига 75 000 € през 2029 г. Максимумът е 85 000 €.</p></li></ul></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://www.parliament.bg/bg/bills/ID/167624\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-602-01-60, доклади и становища</a></li><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания, Народно събрание (чрез „Наясно“)</a></li><li><a href=\"https://burgasmedia.com/news/parlamentat-othvarli-povishavaneto-na-praga-za-dds-registraciya\" target=\"_blank\" rel=\"noreferrer\">Бургас Медиа: Парламентът отхвърли повишаването на прага за ДДС регистрация (02.09.2026)</a></li><li><a href=\"https://burgasmedia.com/news/parlamentat-prie-na-parvo-chetene-po-visok-prag-za-dds-do-75-hil-evro-prez-2029-g\" target=\"_blank\" rel=\"noreferrer\">Бургас Медиа: Приет на първо четене по-висок праг за ДДС, до 75 хил. € през 2029 г. (12.11.2026)</a></li></ol><p class=\"text-xs text-muted mt-2\">Обобщението е по доклада на бюджетната комисия за първо гласуване. Изводът за удвояването на глобите следва от описания в доклада начин на превалутиране. Ще обновим след второто четене.<!-- --> Проверено: <!-- -->19 ноември 2026 г.</p></div></div><section id=\"dokumenti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Още от документите</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.</p><div class=\"space-y-4 max-w-4xl\"><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167624\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за данък върху добавената стойност</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-602-01-60</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Другите промени се отнасят до следното: • Доставка на газ чрез система за природен газ - определяне на доставката на газ като вътреобщностна дистанционна продажба.<!-- -->“</li><li>„<!-- -->Увеличаване на прага за регистрация по ЗДДС е следващата промяна, която се предлага със законопроекта, и тя включва: • поетапно увеличение на прага за регистрация по ЗДДС (до 60 000 евро през 2027 г., 70 000 евро през 2028 г. и 75 000 евро през 2029 г., предвид кумулативната инфлация и нарастването на оборотите на малките и средни предприятия.<!-- -->“</li><li>„<!-- -->Увеличаването на прага е съобразено с Директива (EС) 2020/285 на Съвета от 18 февруари 2020 година за изменение на Директива 2006/112/ЕО относно общата система на данъка върху добавената стойност по отношение на специалния режим за малките предприятия и Регламент (ЕС) № 904/2010 относно административното сътрудничество и обмена на информация за целите на наблюдението на правилното прилагане на специалния режим за малките предприятия.<!-- -->“</li><li>„<!-- -->А във връзка с предвиждания законов достъп на регистрираните по ЗДДС лица до тестова среда от 1 януари до 30 юни 2028 г. и работа на системата в реална среда от 1 юли 2028 г. предлагат на Комисията по бюджет и финанси да препоръча на НАП при организирането на вече предвиденото тестване да включи професионални организации и оператори с опит във вноса, износа и митническото представителство.<!-- -->“</li><li>„<!-- -->Асоциацията на индустриалния капитал в България подкрепя целите за цифровизацията, ограничаване на измамите и намаляване на административната тежест, но определено смята, че е налице прецизиране на определени текстове преди окончателното приемане на закона по отношение на прага за регистрация, защитата на добросъвестния получател, работоспособността на системата, принудителните мерки и санкциите.<!-- -->“</li><li>„<!-- -->Предлага се въвеждане на децентрализирана система за предаване/получаване на фактури.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167624\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Националната организация на митническите агенти изразява определени резерви по отношение на автоматичното попълване на данъчния кредит при внос и грешката в електронния адрес на получателя и право на данъчен кредит, като предлагат прецизиране на текстовете за по-голяма законова яснота.<!-- -->“</li><li>„<!-- -->По предложените промени в Закона за данък върху добавената стойност Конфедерацията на работодателите и индустриалците в България принципно подкрепя дигитализацията на приходната администрация, но счита, че срокът за въвеждане на Структурирано електронно фактуриране от 1 януари 2028 г. е недостатъчен и ще доведе до практически затруднения при въвеждане от страна на бизнеса.<!-- -->“</li><li>„<!-- -->Възразяват срещу необоснованото превалутиране в евро във връзка с административнонаказателните санкции.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167624\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->КНСБ по ЗИД на ЗДДС-60; НОМА по ЗИД на ЗДДС-60; Сдружение за модерна търговия; БСК по ЗИД на ЗДДС-60; АИКБ по ЗИД на ЗДДС; по Законопроект за изменение и допълнение на Закона за данък върху добавената стойност , № 52-602-01-60, БАПФОЕТ<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167624\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167568\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение на Закона за данъка върху добавената стойност</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-150</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Той изтъкна, че целта е да се ограничи прякото отражение на поскъпването на автомобилните горива върху потребителските разходи и ценовото равнище, като е предвидена временна ставка от 9 на сто ДДС.<!-- -->“</li><li>„<!-- -->Законът дава срок от 12 последователни месеца от началото на прилагането и се предвижда подготвителен период от поне 30 дни, с начало от първо число на месеца, а след изтичането на срока стандартната ставка се възстановява автоматично, без ново решение на изпълнителната власт.<!-- -->“</li><li>„<!-- -->Предвиждат се еднократни разходи за адаптиране на фискалните устройства, електронните системи с фискална памет, счетоводните програми и информационните системи на приходните администрации.<!-- -->“</li><li>„<!-- -->Предлага се бюджетният ефект да бъде поет чрез пренареждане на разходните приоритети, при спазване на действащите фискални правила.<!-- -->“</li><li>„<!-- -->В повечето от тях изтъква като причина за позицията си намаляването на ефективността на данъчната система и едновременно с това увеличаването на риска от данъчни измами, увеличаване на административната тежест и разходите за бизнеса, непостигане на социални и икономически цели и отрицателен ефект върху бюджетните приходи.<!-- -->“</li><li>„<!-- -->2 Цели и съдържание на законопроекта Целта е да се ограничи прякото отражение на поскъпването на автомобилните горива върху потребителските разходи и ценовото равнище.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167568\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->В писмените си становища по законопроектите, внесени от народните представители Министерството на финансите не ги подкрепя.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167568\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Бензините с различно октаново число и горивата с биокомпоненти се третират еднакво, за да не възникват необосновани разлики между близки по предназначение продукти.<!-- -->“</li><li>„<!-- -->Министерството на икономиката, инвестициите и индустрията счита, че предложената мярка за временна ставка от 9 на сто ДДС за готовите моторни горива за автомобилния транспорт по цялата верига на облагаемите доставки, включително внос и вътреобщностно придобиване, като не се разпростира върху природен газ, метан, LРG, електрическа енергия, водород, отоплителни и авиационни горива, е свързана със съществени икономически рискове, и очакваните ползи за бизнеса и гражданите не са гарантирани.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167568\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->МФ по ЗИД на ЗДДС-150 на Ц.Ганев и гр.н.п.; относно Законопроект за изменение на Закона за данъка върху добавената стойност 52-654-01-150<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167568\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167013\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение на Закона за данък върху добавената стойност</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-42</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Законопроектът предвижда спешна помощ за най-бедните 29% от българските граждани, сваляне на цените на най-жизнено необходимите хранителни стоки за социално уязвимите групи, сваляне на инфлацията и борба със социалното неравенство.<!-- -->“</li><li>„<!-- -->Всички български граждани и особено тази една трета от тях, която отделя до 40% от доходите си за храна биха облекчили личния си бюджет за изхранване, тъй като се предвижда облагаема доставка с нулева ставка на данъка върху добавената стойност с място на изпълнение на територията на страната да е доставката на хранителни продукти и напитки от номенклатурата в малката потребителска кошница на Националния статистически институт към 01.01.2026г.<!-- -->“</li><li>„<!-- -->Необходимост от приемане на закона Както във всички други източноевропейски държави, отказали се от собствените си валути и преминали към еврото, в България започна бързо и спекулативно повишение на цените около половин година преди 01.01.26 г.<!-- -->“</li><li>„<!-- -->Законът предвижда МФ съвместно с МЗХ да изработи правилник и наредба за прилагането му с точната спецификация на продуктите освободени от ДДС с цел избягването на злоупотреби и отклоняване от плащането на ДДС.<!-- -->“</li><li>„<!-- -->Предвижда се законът да влезе в сила заедно с редовния бюджет за 2026 г. за улеснение на приходната администрация и бизнеса.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167013\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Законът ще доведе до спад в приходите от ДДС на включените в наредбата храни и напитки, които се компенсират напълно от ръста в приходите от данъка, вследствие на високата инфлация и много по-високите цени на горивата. (Само събраният ДДС от горива през март, 2026 г., бележи годишен ръст от 23,9%).<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167013\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->относно проект на Закон за изменение и допълнение на Закона за данък върху добавената стойност от народни представители Димо Дренчев и Петър Петров<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167013\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/166974\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение на Закона за данъка върху добавената стойност</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-26</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Димо Дренчев, който посочи, че повишаването на прага за регистрация по Закона за ДДС до 84 875 евро е мярка в подкрепа на малкия и семеен бизнес в страната, намалява административната тежест и сваля разходите за счетоводно обслужване на микропредприятията.<!-- -->“</li><li>„<!-- -->В краткосрочен план се предвижда спад в приходите от ДДС с около 67 мил. евро, които обаче ще останат на разположение на бизнеса, а дългосрочно ще има ръст на приходите в резултат от по-голямата стопанска активност.<!-- -->“</li><li>„<!-- -->Христо Трифонов отправи чисто експертни препоръки по отношение на прецизирането и редактирането на текстовете на чл. 182 и съответно на чл. 186, предвид обстоятелството, че в практиката има съдебно решение на Съда на Европейския съюз, което затормозява практиката на контролните органи, както и да се преустанови генерирането на актове, които да бъдат отменяни от съда.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/166974\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Господин Константин Проданов направи обобщаващо изказване по всичките законопроекти, които са внесени от народни представители, като конкретно по тези, касаещи вдигането на прага по ЗДДС заяви, че ще работи в посока за вдигане на прага тогава, когато държавата може да си го позволи.<!-- -->“</li><li>„<!-- -->Както и ще подкрепи законопроекта, внесен от Министерския съвет.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/166974\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div></div></details></div></div></section><section id=\"mnenie\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Твоето мнение</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. <a href=\"/mnenie\">Всички закони за гласуване</a>.</p><div class=\"bg-surface rounded-sm p-5 text-[15px] text-muted\">Зарежда се…</div></section><section id=\"grupi\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласуваха групите по този закон</h2></div><p class=\"text-sm text-muted mb-3\">Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо <!-- -->8<!-- -->. Прието: <!-- -->3<!-- -->, отхвърлено: <!-- -->5<!-- -->.</p><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Прогресивна България</p><p class=\"num text-sm mt-1\">За: <b>3</b> · Против: <b>0</b> · общо <!-- -->8</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ГЕРБ – СДС</p><p class=\"num text-sm mt-1\">За: <b>1</b> · Против: <b>3</b> · общо <!-- -->8</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Демократична България</p><p class=\"num text-sm mt-1\">За: <b>5</b> · Против: <b>0</b> · общо <!-- -->8</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ДПС</p><p class=\"num text-sm mt-1\">За: <b>1</b> · Против: <b>3</b> · общо <!-- -->8</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Продължаваме промяната</p><p class=\"num text-sm mt-1\">За: <b>4</b> · Против: <b>0</b> · общо <!-- -->8</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Възраждане</p><p class=\"num text-sm mt-1\">За: <b>5</b> · Против: <b>3</b> · общо <!-- -->8</p></div></div><p class=\"text-sm mt-3\">Първо четене: <a href=\"/parlament/glasuvane/2026-09-02-11\">2 септември 2026 г.</a><a href=\"/parlament/glasuvane/2026-11-12-6\">12 ноември 2026 г.</a><a href=\"/parlament/glasuvane/2026-11-12-7\">12 ноември 2026 г.</a><a href=\"/parlament/glasuvane/2026-11-12-8\">12 ноември 2026 г.</a><a href=\"/parlament/glasuvane/2026-11-12-9\">12 ноември 2026 г.</a><a href=\"/parlament/glasuvane/2026-11-12-10\">12 ноември 2026 г.</a></p></section><section id=\"glasuvaniya\" class=\"scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Всички гласувания по закона</h2></div><ul><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-09-02-11\">Закона за данъка върху добавената стойност – първо гласуване</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-muted border border-rule\">Отхвърлено</span></div><p class=\"text-sm text-muted mt-1\">2 септември 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: Въздържал се · ГЕРБ – СДС: Въздържал се · Демократична България: За · ДПС: Против · Продължаваме промяната: За · Възраждане: За</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-11-12-5\">Закона за данък върху добавената стойност - първо гласуване - процедура за допускане в зала</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">12 ноември 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-11-12-6\">Закона за данък върху добавената стойност - първо гласуване - вносител Мартин Димитров и група н.п</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-muted border border-rule\">Отхвърлено</span></div><p class=\"text-sm text-muted mt-1\">12 ноември 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: Въздържал се · ГЕРБ – СДС: Против · Демократична България: За · ДПС: Въздържал се · Продължаваме промяната: За · Възраждане: За</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-11-12-7\">Закона за данък върху добавената стойност - първо гласуване - вносител Димо Дренчев</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-muted border border-rule\">Отхвърлено</span></div><p class=\"text-sm text-muted mt-1\">12 ноември 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: Въздържал се · ГЕРБ – СДС: Въздържал се · Демократична България: За · ДПС: Въздържал се · Продължаваме промяната: За · Възраждане: За</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-11-12-8\">Закона за данък върху добавената стойност - първо гласуване - вносител Димо Дренчев и Петър Петров</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-muted border border-rule\">Отхвърлено</span></div><p class=\"text-sm text-muted mt-1\">12 ноември 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: Въздържал се · ГЕРБ – СДС: Въздържал се ·