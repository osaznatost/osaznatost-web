0\"}],[\"$\",\"link\",\"19\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?favicon.117ezoe8m31dk.ico\",\"sizes\":\"48x48\",\"type\":\"image/x-icon\"}],\"$L2a\"]}]}],null]}],\"$L2b\"]}],\"p\":\"$@2c\",\"v\":null,\"s\":\"$d\"}},\"a\":\"$@2d\",\"u\":\"$@2e\",\"b\":\"l1G_Fubxuhk1FCK9ovR4J\"}\n2f:I[32466,[\"$2\",\"$9\"],\"Term\"]\n3d:I[52368,[\"$2\",\"$9\"],\"CitizenVote\"]\n43:I[97367,[\"$2\"],\"OutletBoundary\"]\n45:I[27201,[\"$2\"],\"IconMark\"]\n16:[\"$\",\"li\",\"zakonoproekti\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#zakonoproekti\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Кой внесе и кой се изказа\"}]}]\n17:[\"$\",\"li\",\"argumenti\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#argumenti\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Двете страни\"}]}]\n18:[\"$\",\"li\",\"mnenie\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#mnenie\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Твоето мнение\"}]}]\n19:[\"$\",\"li\",\"grupi\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#grupi\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Как гласуваха\"}]}]\n1a:[\"$\",\"li\",\"glasuvaniya\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#glasuvaniya\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Гласувания (8)\"}]}]\n1b:[\"$\",\"section\",null,{\"id\":\"nakratko\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Накратко\"}],\"$undefined\",[\"$\",\"div\",null,{\"className\":\"max-w-4xl\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[17px]\",\"children\":\"Правителственият законопроект въвежда задължителни структурирани електронни фактури между фирмите и към държавата, подавани в реално време към НАП; дневниците за покупки и продажби отпадат, а НАП ще генерира проект на месечната декларация. Очакваният приход е 350 млн. € за 2028 г. и 450 млн. € за 2029 г. Въвежда се задължителна регистрация по ДДС преди първата продажба на нова сграда или парцел (+120 млн. €). Прагът за регистрация се вдига поетапно до 60 000 € (2027), 70 000 € (2028) и 75 000 € (2029). Глобите, непроменяни от 2007 г., се превръщат от лева в евро едно към едно (100 лв. стават 100 €), т.е. на практика се удвояват. Нулева ставка за отбранителни доставки по европейския инструмент SAFE.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Вносители:\"}],\" \",\"Министерският съвет (представи зам.-министърът на финансите Людмила Петкова). Пет проекта на опозицията бяха отхвърлени.\",[\" · \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167624\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"законопроект \",\"52-602-01-60\"]}]]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Какво се случи:\"}],\" \",\"На първо четене (12.11.2026) правителственият проект мина със 122 „за“ и 49 „против“; срокът за предложения беше намален (132 „за“, 43 „против“). Отхвърлени бяха проекти на Мартин Димитров и др. (ПП–ДБ) за праг от 85 000 €, на Димо Дренчев, на Дренчев и Петров и на Цончо Ганев и др. — „Прогресивна България“ се въздържа.\"]}]]}]]}]\n1c:[\"$\",\"section\",null,{\"id\":\"signali\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Сигнали\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.\"}],[[\"$\",\"ul\",null,{\"className\":\"grid gap-3 md:grid-cols-2 max-w-5xl\",\"children\":[[\"$\",\"li\",\"Съкратен срок за предложения\",{\"className\":\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Съкратен срок за предложения\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Мнозинството гласува по-кратък срок от обичайните 7 дни, в който депутатите могат да внасят промени между първо и второ четене.\"}]]}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3\",\"children\":[\"$\",\"$La\",null,{\"href\":\"/parlament/signali\",\"children\":\"Всички сигнали в парламента\"}]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-2\",\"children\":[\"Сигналът е повод за въпрос, не доказателство за нарушение.\",\" \",[\"$\",\"$La\",null,{\"href\":\"/metodologiya#signal\",\"className\":\"underline\",\"children\":\"Как работим със сигналите\"}]]}]]]}]\n1d:[\"$\",\"section\",null,{\"id\":\"zakonoproekti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Кой внесе и кой се изказа\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.\"}],[[\"$\",\"ul\",null,{\"className\":\"space-y-4 max-w-5xl\",\"children\":[[\"$\",\"li\",\"167624\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167624\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за данък върху добавената стойност\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-602-01-60\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"5 ноември 2026 г.\",\" от \",\"Министерския съвет\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по бюджет и финанси (водеща); Комисия по европейските въпроси и контрол на европейските фондове (участваща); Комисия по иновациите и дигиталната трансформация (участваща)\"}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Становища\"}],[\"$\",\"dd\",null,{\"children\":\"КНСБ по ЗИД на ЗДДС-60; НОМА по ЗИД на ЗДДС-60; Сдружение за модерна търговия; БСК по ЗИД на ЗДДС-60; АИКБ по ЗИД на ЗДДС; по Законопроект за изменение и допълнение на Закона за данък върху добавената стойност , № 52-602-01-60, БАПФОЕТ\"}]],false,false,false,[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Предложения\"}],[\"$\",\"dd\",null,{\"children\":[7,\" писмени предложения на депутати между \",[\"$\",\"$L2f\",null,{\"k\":\"parvo-chetene\",\"children\":\"първо\"}],\" и \",[\"$\",\"$L2f\",null,{\"k\":\"vtoro-chetene\",\"children\":\"второ четене\"}]]}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"В залата\"}],[\"$\",\"dd\",null,{\"children\":[[\"$\",\"span\",\"0\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11196\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"12 ноември 2026 г.\"}],\" (\",\"зала първо гласуване\",\")\"]}]]}]],null]}]]}],[\"$\",\"li\",\"167568\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167568\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за изменение на Закона за данъка върху добавената стойност\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-654-01-150\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"23 септември 2026 г.\",\" от \",\"Цончо Ганев, Димо Дренчев, Ангел Янчев и още 6 депутати\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по бюджет и финанси (водеща); Комисия по икономическа политика, инвестиции и индустрия (участваща)\"}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Становища\"}],[\"$\",\"dd\",null,{\"children\":\"МФ по ЗИД на ЗДДС-150 на Ц.Ганев и гр.н.п.; относно Законопроект за изменение на Закона за данъка върху добавената стойност 52-654-01-150\"}]],false,false,false,false,[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"В залата\"}],[\"$\",\"dd\",null,{\"children\":[[\"$\",\"span\",\"0\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11196\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"12 ноември 2026 г.\"}],\" (\",\"зала първо гласуване\",\")\"]}]]}]],null]}]]}]]}],[\"$\",\"details\",null,{\"className\":\"mt-3 max-w-5xl\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green py-2\",\"children\":[\"Още \",4,\" законопроекта по този закон\"]}],\"$L30\"]}]]]}]\n1e:[\"$\",\"div\",null,{\"id\":\"argumenti\",\"className\":\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-2 mt-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-green bg-surface\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Мотивите на вносителите\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Министерството на финанситеМерките изпълняват и\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Министерството на финансите\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Мерките изпълняват изисквания на ЕС и намаляват двойното въвеждане на данни; електронните фактури ще ограничат измамите с ДДС и ще донесат стотици милиони евро.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167624\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-60, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Министерството на финанситеГлобите не са промен\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Министерството на финансите\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Глобите не са променяни от 2007 г. и са изгубили възпиращия си ефект.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167624\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-60, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Мартин Димитров (ПП–ДБ), за отхвърления проектПраг от 85 000 € ще \",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Мартин Димитров (ПП–ДБ), за отхвърления проект\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Праг от 85 000 € ще освободи около 400 000 микро- и малки фирми от тежестта по ДДС; загубата за бюджета — около 100 млн. € през първата година.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167624\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-60, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Какво казват критиците\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Опозицията49 депутати гласувах\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Опозицията\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"49 депутати гласуваха против на първо четене; против беше и намаляването на срока за предложения.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"2\",{\"href\":\"https://naiasno.bg/parliament\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Поименни гласувания, Народно събрание (чрез „Наясно“)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",2,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"КНСБ, БСК, АИКБ, НОМА и Сдружението за модерна търговияВнесоха становища в \",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"КНСБ, БСК, АИКБ, НОМА и Сдружението за модерна търговия\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Внесоха становища в бюджетната комисия (публикувани на сайта на парламента).\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167624\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-60, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Отворен въпросЗадължителните е-фак\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Отворен въпрос\"}],\"$L31\"]}]]}]]}]]}],\"$L32\",\"$L33\",\"$L34\",\"$L35\",\"$L36\"]}]\n1f:[\"$\",\"section\",null,{\"id\":\"dokumenti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Още от документите\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 max-w-4xl\",\"children\":[[\"$\",\"div\",\"167624\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167624\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за данък върху добавената стойност\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-602-01-60\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Другите промени се отнасят до следното: • Доставка на газ чрез система за природен газ - определяне на доставката на газ като вътреобщностна дистанционна продажба.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Увеличаване на прага за регистрация по ЗДДС е следващата промяна, която се предлага със законопроекта, и тя включва: • поетапно увеличение на прага за регистрация по ЗДДС (до 60 000 евро през 2027 г., 70 000 евро през 2028 г. и 75 000 евро през 2029 г., предвид кумулативната инфлация и нарастването на оборотите на малките и средни предприятия.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Увеличаването на прага е съобразено с Директива (EС) 2020/285 на Съвета от 18 февруари 2020 година за изменение на Директива 2006/112/ЕО относно общата система на данъка върху добавената стойност по отношение на специалния режим за малките предприятия и Регламент (ЕС) № 904/2010 относно административното сътрудничество и обмена на информация за целите на наблюдението на правилното прилагане на специалния режим за малките предприятия.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"А във връзка с предвиждания законов достъп на регистрираните по ЗДДС лица до тестова среда от 1 януари до 30 юни 2028 г. и работа на системата в реална среда от 1 юли 2028 г. предлагат на Комисията по бюджет и финанси да препоръча на НАП при организирането на вече предвиденото тестване да включи професионални организации и оператори с опит във вноса, износа и митническото представителство.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Асоциацията на индустриалния капитал в България подкрепя целите за цифровизацията, ограничаване на измамите и намаляване на административната тежест, но определено смята, че е налице прецизиране на определени текстове преди окончателното приемане на закона по отношение на прага за регистрация, защитата на добросъвестния получател, работоспособността на системата, принудителните мерки и санкциите.\",\"“\"]}],[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"Предлага се въвеждане на децентрализирана система за предаване/получаване на фактури.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167624\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],\"$L37\",\"$L38\",false,\"$L39\"]}]]}]]}],\"$L3a\",\"$L3b\",\"$L3c\"]}]]}]\n20:[\"$\",\"section\",null,{\"id\":\"mnenie\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Твоето мнение\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":[\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \",[\"$\",\"$La\",null,{\"href\":\"/mnenie\",\"children\":\"Всички закони за гласуване\"}],\".\"]}],[\"$\",\"$L3d\",null,{\"item\":\"danak-varhu-dobavenata-stoynost\",\"question\":\"Подкрепяш ли последните промени в „Закон за данък върху добавената стойност (електронни фактури, праг за регистрация, глоби)“?\"}]]}]\n21:[\"$\",\"section\",null,{\"id\":\"grupi\",\"className\":\"mb-12 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb-5\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] sm:text-[2.4rem]\",\"children\":\"Как гласуваха групите по този закон\"}],\"$undefined\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mb-3\",\"children\":[\"Брой гласувания, в които мнозинството в групата е било