2 max-w-5xl\",\"children\":[[\"$\",\"li\",\"1 нови текста в преходните и заключителните разпоредби\",{\"className\":\"border-l-4 rounded-sm p-4 border-red bg-[#fdeff1]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"1 нови текста в преходните и заключителните разпоредби\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Добавени са чак на второ четене, без обществено обсъждане. В тази част често се променят други закони. Прочетете ги в доклада на комисията и стенограмата.\"}]]}],[\"$\",\"li\",\"Съкратен срок за предложения (5 дни)\",{\"className\":\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Съкратен срок за предложения (5 дни)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Мнозинството гласува по-кратък срок от обичайните 7 дни, в който депутатите могат да внасят промени между първо и второ четене.\"}]]}]]}]\n1c:[\"$\",\"p\",null,{\"className\":\"text-sm mt-3\",\"children\":[\"$\",\"$La\",null,{\"href\":\"/parlament/signali\",\"children\":\"Всички сигнали в парламента\"}]}]\n1d:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-2\",\"children\":[\"Сигналът е повод за въпрос, не доказателство за нарушение.\",\" \",[\"$\",\"$La\",null,{\"href\":\"/metodologiya#signal\",\"className\":\"underline\",\"children\":\"Как работим със сигналите\"}]]}]\n1e:[\"$\",\"section\",null,{\"id\":\"zakonoproekti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Кой внесе и кой се изказа\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.\"}],[[\"$\",\"ul\",null,{\"className\":\"space-y-4 max-w-5x