hildren\\\":[\\\"„\\\",\\\"Предлага се и отпадане на справката-декларация по ЗДДС, тъй като тя дублира като съдържание стандартния одитен фейл.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[\\\"„\\\",\\\"Предвижда се се и намаляванс на обхвата на годишната данъчна декларация по ЗКПО, като отпаднат данните, които се подават чрез стандартния одитен файл.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"children\\\":[\\\"„\\\",\\\"Предлага се измененисто да влезе в сила на 01.09.2026 г., за да с налице достатъчно време за въвеждането на стандарта в наредбата на БНБ и неговото въвеждане от доставчиците на платежни услуги.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"5\\\",{\\\"children\\\":[\\\"„\\\",\\\"Предлага се и заповедта на изпълнителния директор на НАП да се замени с наредба на министъра на финансите, тъй като тази заповед е с нормативен характер и трябва да бъде приемана и публикувана по реда на Закона за нормативните актовс.\\\",\\\"“\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted mt-1\\\",\\\"children\\\":[\\\"Източник: \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167542\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":\\\"доклад на комисията и мотиви, parliament.bg\\\"}]]}]]}],null,null,false,[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"children\\\":\\\"Писмени становища внесоха:\\\"}],\\\" \\\",\\\"БНБ по ЗИД на ДОПК-52-654-01-133; МФ - становище по ЗИД на ДОПК - Б.Божанов; Камара на счетоводителите в България по Законопроект за изменение и допълнение на Данъчно-осигурителния процесуален кодекс , 52-654-01-133/10.09.2026\\\",\\\". \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167542\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":\\\"Текстовете в parliament.bg\\\"}]]}]]}]]}]]}],[\\\"$\\\