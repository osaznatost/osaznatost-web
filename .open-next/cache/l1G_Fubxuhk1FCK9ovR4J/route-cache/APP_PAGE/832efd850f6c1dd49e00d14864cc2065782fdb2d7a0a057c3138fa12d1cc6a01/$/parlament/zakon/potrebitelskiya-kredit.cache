{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/zakon/layout,_N_T_/parlament/zakon/[slug]/layout,_N_T_/parlament/zakon/[slug]/page,_N_T_/parlament/zakon/potrebitelskiya-kredit"},"segmentPaths":["/_tree","/_full","/parlament/zakon/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/832efd850f6c1dd49e00d14864cc2065782fdb2d7a0a057c3138fa12d1cc6a01/$/parlament/zakon/potrebitelskiya-kredit","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/zakon/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2bx3suebn7wim.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><script src=\"/_next/static/chunks/43gzry38n6x69.js\" async=\"\"></script><title>Закон за потребителския кредит · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Закон за потребителския кредит · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Закон за потребителския кредит · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Парламент</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Закон</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Закон за потребителския кредит</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Нов закон, приет на първо четене на 23 септември 2026 г. Предстои второ четене.</div></div></div><nav aria-label=\"Секции на страницата\" class=\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\"><ul class=\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\"><li><a href=\"#nakratko\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Накратко</a></li><li><a href=\"#zakonoproekti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Кой внесе и кой се изказа</a></li><li><a href=\"#argumenti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Двете страни</a></li><li><a href=\"#mnenie\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Твоето мнение</a></li><li><a href=\"#grupi\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Как гласуваха</a></li><li><a href=\"#glasuvaniya\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Гласувания (3)</a></li></ul></nav><section id=\"nakratko\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Накратко</h2><div class=\"max-w-4xl\"><p class=\"text-[17px]\">Нов закон за кредитите за потребители, който заменя закона от 2010 г. и въвежда европейската директива за потребителския кредит (CCD II). Обхваща заеми до 100 000 € (досега до 75 000 €), включително „купи сега, плати после“, безлихвени и краткосрочни кредити. Сменя начина, по който се ограничава цената на малките бързи кредити.</p><p class=\"mt-3 text-[15px]\"><b>Вносители:</b> <!-- -->Министерският съвет (внесен на 11 септември 2026 г.)<!-- --> · <a href=\"https://www.parliament.bg/bg/bills/ID/167544\" target=\"_blank\" rel=\"noreferrer\">законопроект <!-- -->52-602-01-41</a></p><p class=\"mt-3 text-[15px]\"><b>Какво се случи:</b> <!-- -->На първо четене (23 септември) „за“ гласуваха 124 депутати, всички от „Прогресивна България“. „Против“ бяха 64: ГЕРБ–СДС, ДБ, ПП и „Възраждане“. ДПС се въздържа. Срокът за предложения между четенията беше удължен.</p></div></section><section id=\"zakonoproekti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Кой внесе и кой се изказа</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.</p><ul class=\"space-y-4 max-w-5xl\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167547\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за потребителския кредит</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-135</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>11 септември 2026 г.<!-- --> от <!-- -->Костадин Костадинов, Цончо Ганев, Петър Петров и още 3 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по икономическа политика, инвестиции и индустрия (водеща); Комисия по бюджет и финанси (участваща); Комисия по правни въпроси (участваща); Комисия по европейските въпроси и контрол на европейските фондове (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>Министерство на икономиката, инвестициите и индустрията относно Законопроект за изменение и допълнение на Закона за  потребителския кредит, № 52-654-01-135, внесен от Костадин Тодоров Костадинов и група народни представители на 11 септември 2026 г.</dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167544\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за потребителския кредит</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-602-01-41</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>11 септември 2026 г.<!-- --> от <!-- -->Министерския съвет</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по икономическа политика, инвестиции и индустрия (водеща); Комисия по бюджет и финанси (участваща); Комисия по европейските въпроси и контрол на европейските фондове (участваща); Комисия по правни въпроси (участваща); Комисия по културата и медиите (участваща); Комисия по регионална политика, благоустройство и местно самоуправление (участваща); Комисия по иновациите и дигиталната трансформация (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>Алианс на технологичната индустрия (АТИ) относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; омбудсмана на Република България относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; Сдружение за правна помощ на потребителите по Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11.09.2026 г.; адв. Десислава Филипова и адв. Веска Волева относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; Национална асоциация за защита на потребителите (НАЗП) относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; &quot;Фондация за живота&quot; относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; Българска национална асоциация &quot;Активни потребители&quot; относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; Сдружение &quot;Българската предприемаческа асоциация&quot; (BESCO) относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; адв. Николай Лалев относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; Асоциация на банките в България (АББ) относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; Българска финтех асоциация (БФА) относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; Асоциация за отговорно небанково кредитиране (АОНК) относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.</dd><dt class=\"text-muted\">Предложения</dt><dd>6<!-- --> писмени предложения на депутати между <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">първо</button></span> и <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">второ четене</button></span></dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11173\" target=\"_blank\" rel=\"noreferrer\">23 септември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li></ul></section><div id=\"argumenti\" class=\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\"><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Министерският съвет</p><p class=\"text-[15px]\">Въвежда европейската директива: по-добра защита при кредитите, задължителна реална оценка дали човекът може да плаща, забрана за подвеждаща реклама.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://cms.law/en/bgr/legal-updates/bulgaria-advances-consumer-credit-reform-under-ccd-ii\" target=\"_blank\" rel=\"noreferrer\" title=\"CMS: България напредва с реформата на потребителския кредит (CCD II)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Константин Проданов („Прогресивна България“), предложения за второ четене</p><p class=\"text-[15px]\">Да се спре заобикалянето на тавана чрез допълнителни такси. Пример: при заем от 1 000 € разходите през първия месец да не надвишават 200 €. Без реална оценка на кредитоспособността договорът да е недействителен.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/videos/40297\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: „Прогресивна България“ предлага ограничаване на таксите по бързите кредити (09.10.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Опозицията (ГЕРБ–СДС, ДБ, ПП, „Възраждане“)</p><p class=\"text-[15px]\">Гласува против на първо четене. В дебата проектът беше обвиняван, че е в полза на фирмите за бързи кредити.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.capital.bg/biznes/finansi/2026/10/30/4972854_zakon_za_ubivane_na_burzite_krediti/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Закон за убиване на бързите кредити (30.10.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\" title=\"Поименни гласувания, Народно събрание (чрез „Наясно“)\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Фирмите за бързи кредити</p><p class=\"text-[15px]\">Новият твърд таван на общите разходи прави малките и краткосрочни заеми нерентабилни и ще ги изтласка в сивия сектор. Високата цена покрива реални разходи, а не огромни печалби.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.capital.bg/biznes/finansi/2026/10/30/4972854_zakon_za_ubivane_na_burzite_krediti/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Закон за убиване на бързите кредити (30.10.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-3\">Какво казват данните</h3><ul class=\"space-y-2 list-none pl-0\"><li class=\"border-l-4 border-deep pl-4 text-[15px]\">Сегашният законов таван на годишния процент на разходите (ГПР) е около 52%, но с допълнителни такси реалното оскъпяване на бързите кредити стига средно 120–140%, по данни на бранша.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.capital.bg/biznes/finansi/2026/10/30/4972854_zakon_za_ubivane_na_burzite_krediti/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Закон за убиване на бързите кредити (30.10.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">По проекта за заеми до три минимални заплати общите разходи са ограничени до 20% от главницата при връщане до месец, 30% до три месеца и 100% за по-дълъг срок.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://cms.law/en/bgr/legal-updates/bulgaria-advances-consumer-credit-reform-under-ccd-ii\" target=\"_blank\" rel=\"noreferrer\" title=\"CMS: България напредва с реформата на потребителския кредит (CCD II)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">Глоби до 60 000 € при повторни нарушения. При някои нарушения договорът е недействителен и човекът връща само главницата.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://cms.law/en/bgr/legal-updates/bulgaria-advances-consumer-credit-reform-under-ccd-ii\" target=\"_blank\" rel=\"noreferrer\" title=\"CMS: България напредва с реформата на потребителския кредит (CCD II)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">Предвидено влизане в сила: 20 ноември 2026 г., с 6 месеца за привеждане на кредиторите в съответствие.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://cms.law/en/bgr/legal-updates/bulgaria-advances-consumer-credit-reform-under-ccd-ii\" target=\"_blank\" rel=\"noreferrer\" title=\"CMS: България напредва с реформата на потребителския кредит (CCD II)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></li></ul></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Двете страни на монетата</h3><p class=\"text-sm text-muted mb-3\">Какво следва на практика, ако законът се приеме и ако се отхвърли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://cms.law/en/bgr/legal-updates/bulgaria-advances-consumer-credit-reform-under-ccd-ii\" target=\"_blank\" rel=\"noreferrer\" title=\"CMS: България напредва с реформата на потребителския кредит (CCD II)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a><a href=\"https://www.capital.bg/biznes/finansi/2026/10/30/4972854_zakon_za_ubivane_na_burzite_krediti/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Закон за убиване на бързите кредити (30.10.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\"><p class=\"font-semibold\">Ако се приеме</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">По-евтини малки заеми: таван на общите разходи от 20% до 100% според срока.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Без реална проверка дали можеш да плащаш договорът е недействителен и връщаш само главницата.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Забрана за предварително отметнати съгласия, непоискан кредит и едностранно вдигане на лимита.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Разсрочване и други облекчения преди съдебно събиране.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Продуктите „купи сега, плати после“ също влизат под закона.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Според бранша малките краткосрочни заеми стават нерентабилни и може да се преместят в сивия сектор.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">По-трудно ще вземат заем хората с ниски доходи или лоша кредитна история.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Нови разходи за кредиторите, които могат да се прехвърлят върху клиентите при по-големите заеми.</li></ul></div></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\"><p class=\"font-semibold\">Ако се отхвърли</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Фирмите за бързи кредити продължават да работят по сегашните правила и достъпът до малки заеми не се свива.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Остава реалното оскъпяване от 120–140% чрез допълнителни такси.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Европейската директива за потребителския кредит остава невъведена.</li></ul></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Какво печели и какво губи всяка страна</h3><p class=\"text-sm text-muted mb-3\">Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.</p><div class=\"space-y-3\"><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Хората, които теглят малки бързи кредити<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://cms.law/en/bgr/legal-updates/bulgaria-advances-consumer-credit-reform-under-ccd-ii\" target=\"_blank\" rel=\"noreferrer\" title=\"CMS: България напредва с реформата на потребителския кредит (CCD II)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a><a href=\"https://www.capital.bg/biznes/finansi/2026/10/30/4972854_zakon_za_ubivane_na_burzite_krediti/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Закон за убиване на бързите кредити (30.10.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Много по-ниска максимална цена на малките заеми и защита от скрити такси.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Част от фирмите може да спрат да отпускат малки заеми, а хората с лоша кредитна история да останат без легален достъп до кредит.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Длъжниците в затруднение<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://cms.law/en/bgr/legal-updates/bulgaria-advances-consumer-credit-reform-under-ccd-ii\" target=\"_blank\" rel=\"noreferrer\" title=\"CMS: България напредва с реформата на потребителския кредит (CCD II)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a><a href=\"https://www.bta.bg/bg/videos/40297\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: „Прогресивна България“ предлага ограничаване на таксите по бързите кредити (09.10.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Кредиторът трябва да предложи разсрочване или намаление преди принудително събиране. Без обаждания от колектори между 20:00 и 08:00 (предложение за второ четене).</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">—</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Фирмите за бързи кредити<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://cms.law/en/bgr/legal-updates/bulgaria-advances-consumer-credit-reform-under-ccd-ii\" target=\"_blank\" rel=\"noreferrer\" title=\"CMS: България напредва с реформата на потребителския кредит (CCD II)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a><a href=\"https://www.capital.bg/biznes/finansi/2026/10/30/4972854_zakon_za_ubivane_na_burzite_krediti/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: Закон за убиване на бързите кредити (30.10.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">По-ниски приходи, нови разходи за съответствие, регистрация в КЗП и риск от глоби.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Банките<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://cms.law/en/bgr/legal-updates/bulgaria-advances-consumer-credit-reform-under-ccd-ii\" target=\"_blank\" rel=\"noreferrer\" title=\"CMS: България напредва с реформата на потребителския кредит (CCD II)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Конкуренцията от бързите кредити намалява.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Също трябва да спазват новите правила за реклама и оценка на кредитоспособността.</p></div></div></div></div></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://cms.law/en/bgr/legal-updates/bulgaria-advances-consumer-credit-reform-under-ccd-ii\" target=\"_blank\" rel=\"noreferrer\">CMS: България напредва с реформата на потребителския кредит (CCD II)</a></li><li><a href=\"https://www.bta.bg/bg/videos/40297\" target=\"_blank\" rel=\"noreferrer\">БТА: „Прогресивна България“ предлага ограничаване на таксите по бързите кредити (09.10.2026)</a></li><li><a href=\"https://www.capital.bg/biznes/finansi/2026/10/30/4972854_zakon_za_ubivane_na_burzite_krediti/\" target=\"_blank\" rel=\"noreferrer\">Капитал: Закон за убиване на бързите кредити (30.10.2026)</a></li><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания, Народно събрание (чрез „Наясно“)</a></li></ol><p class=\"text-xs text-muted mt-2\">Броят гласове е по поименните данни. Таблицата „Какво печели и какво губи всяка страна“ и последиците „ако се приеме / ако се отхвърли“ са наш анализ на текста и аргументите от източниците, не позиция на партия.<!-- --> Проверено: <!-- -->17 ноември 2026 г.</p></div></div><section id=\"dokumenti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Още от документите</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.</p><div class=\"space-y-4 max-w-4xl\"><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167547\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за потребителския кредит</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-135</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Последващото съдебно оспорване е свързано с време, разходи и необходимост от правна помощ.<!-- -->“</li><li>„<!-- -->Проектът отчита и необходимостта от защита след настъпването на просрочие.<!-- -->“</li><li>„<!-- -->Целта на промяната с този конкретен параграф е да се избегне порочна практика по масово отпускане на т. нар.<!-- -->“</li><li>„<!-- -->Тези разходи са оправдани от необходимостта да се предотвратят масови нарушения и последващи съдебни и административни производства. 5.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167547\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->Министерство на икономиката, инвестициите и индустрията относно Законопроект за изменение и допълнение на Закона за  потребителския кредит, № 52-654-01-135, внесен от Костадин Тодоров Костадинов и група народни представители на 11 септември 2026 г.<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167547\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167544\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за потребителския кредит</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-602-01-41</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Проектозаконът, представен от заместник-министъра на икономиката, инвестициите и индустрията Красимир Якимов, въвежда в националното законодателство изискванията на Директива (ЕС) 2023/2225 на Европейския парламент и на Съвета от 18 октомври 2023 година относно договорите за потребителски кредити и за отмяна на Директива 2008/48/ЕО.<!-- -->“</li><li>„<!-- -->Целта е да се повиши защитата на потребителите, като законодателството бъде съобразено с технологичното развитие и новите кредитни продукти.<!-- -->“</li><li>„<!-- -->Предлага се обхватът на закона да бъде разширен за кредити на стойност до 100 000 евро.<!-- -->“</li><li>„<!-- -->Законопроектът забранява предоставянето на непоискан кредит, включително изпращането на предварително одобрени кредитни карти и едностранното увеличаване на кредитни лимити без предварително искане и изрично съгласие на потребителя.<!-- -->“</li><li>„<!-- -->Предвиждат се по-високи изисквания към оценката на кредитоспособността, за да се ограничи рискът от свръхзадлъжнялост.<!-- -->“</li><li>„<!-- -->Проектът въвежда ограничения върху обвързването на кредита със задължително закупуване на други финансови продукти или услуги.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167544\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Николай Цветанов от Асоциация за отговорно небанково кредитиране отбеляза, че са представили становище с предложения за подобряване на правната рамка.<!-- -->“</li><li>„<!-- -->Народният представител Константин Проданов отбеляза, че ще внесе предложения за ограничаване на отпускането на бързи кредити в тъмната част на денонощието, защото голяма част от хазартно зависимите прибягват до тази услуга.<!-- -->“</li><li>„<!-- -->От Алианса на технологичната индустрия подкрепиха целите на проекта, но определиха част от мерките като непропорционални.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167544\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->По време на дискусията народният представител Мартин Димитров настоя Българската народна банка спешно да предостави подробен анализ на пазара на бързите кредити и изрази съмнение относно твърденията на гражданските организации, че договорите с размер до 3 минимални заплати представляват 90% от пазара.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167544\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Стефан Белчев</b><span class=\"text-muted\"> (<!-- -->ПБ<!-- -->)</span>: „<!-- -->Очевидно материята е с изключителна чувствителност за нас като потребители и това изисква една задълбочена прецизност, поради тази причина на основание чл. 79, ал. 1 от ПОДНС правя процедурно предложение – срокът за писмени предложения между първо и второ четене на току-що приетия законопроект да бъде удължен на 16 дни. Благодаря<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11173\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->23.09.2026</a></li><li><b>Даниел Парушев</b><span class=\"text-muted\"> (<!-- -->ПБ<!-- -->)</span>: „<!-- -->Позволете ми от името на парламентарната група на „Прогресивна България“ да Ви запозная със становището, свързано със Законопроекта, който променя Кодекса за застраховането. Тук трябва да отбележа, че по-скоро още в началото изглеждаше като технически законопроект, но трябва да си зададем няколко въпроса: кой носи отговорност, когато има несъстоятелност? Също така – кой гарантира евентуално възникване на задължения…<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11173\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->23.09.2026</a></li><li><b>Цончо Ганев</b><span class=\"text-muted\"> (<!-- -->ВЪЗРАЖДАНЕ<!-- -->)</span>: „<!-- -->Господин Аладжов, не съм съгласен с Вас, защото според мен директно с този законопроект се дава възможност да има поскъпване на „Гражданската отговорност“ – нещо, което касае огромна част от българското<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11173\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->23.09.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->Алианс на технологичната индустрия (АТИ) относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; омбудсмана на Република България относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; Сдружение за правна помощ на потребителите по Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11.09.2026 г.; адв. Десислава Филипова и адв. Веска Волева относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; Национална асоциация за защита на потребителите (НАЗП) относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; &quot;Фондация за живота&quot; относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; Българска национална асоциация &quot;Активни потребители&quot; относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; Сдружение &quot;Българската предприемаческа асоциация&quot; (BESCO) относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; адв. Николай Лалев относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; Асоциация на банките в България (АББ) относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; Българска финтех асоциация (БФА) относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.; Асоциация за отговорно небанково кредитиране (АОНК) относно Законопроект за потребителския кредит, № 52-602-01-41, внесен от Министерски съвет на 11 септември 2026 г.<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167544\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div></div></section><section id=\"mnenie\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Твоето мнение</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. <a href=\"/mnenie\">Всички закони за гласуване</a>.</p><div class=\"bg-surface rounded-sm p-5 text-[15px] text-muted\">Зарежда се…</div></section><section id=\"grupi\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласуваха групите по този закон</h2></div><p class=\"text-sm text-muted mb-3\">Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо <!-- -->3<!-- -->. Прието: <!-- -->3<!-- -->, отхвърлено: <!-- -->0<!-- -->.</p><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Прогресивна България</p><p class=\"num text-sm mt-1\">За: <b>3</b> · Против: <b>0</b> · общо <!-- -->3</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ГЕРБ – СДС</p><p class=\"num text-sm mt-1\">За: <b>2</b> · Против: <b>1</b> · общо <!-- -->3</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Демократична България</p><p class=\"num text-sm mt-1\">За: <b>2</b> · Против: <b>1</b> · общо <!-- -->3</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ДПС</p><p class=\"num text-sm mt-1\">За: <b>2</b> · Против: <b>0</b> · общо <!-- -->3</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Продължаваме промяната</p><p class=\"num text-sm mt-1\">За: <b>1</b> · Против: <b>1</b> · общо <!-- -->3</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Възраждане</p><p class=\"num text-sm mt-1\">За: <b>0</b> · Против: <b>3</b> · общо <!-- -->3</p></div></div><p class=\"text-sm mt-3\">Първо четене: <a href=\"/parlament/glasuvane/2026-09-23-12\">23 септември 2026 г.</a></p></section><section id=\"glasuvaniya\" class=\"scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Всички гласувания по закона</h2></div><ul><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-09-23-11\">първо гласуване - процедура за допускане в залата</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">23 септември 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex