":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://cms.law/en/bgr/legal-updates/bulgaria-advances-consumer-credit-reform-under-ccd-ii\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"CMS: България напредва с реформата на потребителския кредит (CCD II)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}],[\"$\",\"li\",\"Предвидено влизане в сила: 20 ноември 20\",{\"className\":\"border-l-4 border-deep pl-4 text-[15px]\",\"children\":[\"Предвидено влизане в сила: 20 ноември 2026 г., с 6 месеца за привеждане на кредиторите в съответствие.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://cms.law/en/bgr/legal-updates/bulgaria-advances-consumer-credit-reform-under-ccd-ii\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"CMS: България напредва с реформата на потребителския кредит (CCD II)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}]\n32:[\"$\",\"div\",null,{\"className\":\"mt-8\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.8rem] mb-1\",\"children\":\"Двете страни на монетата\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mb-3\",\"children\":[\"Какво следва на практика, ако законът се приеме и ако се отхвърли.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://cms.law/en/bgr/legal-updates/bulgaria-advances-consumer-credit-reform-under-ccd-ii\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"CMS: България напредва с реформата на потребителския кредит (CCD II)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}],[\"$\",\"a\",\"3\",{\"href\":\"https://www.capital.bg/biznes/finansi/2026/10/30/4972854_zakon_za_ubivane_na_burzite_krediti/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Капитал: Закон за убиване на бързите кредити (30.10.2