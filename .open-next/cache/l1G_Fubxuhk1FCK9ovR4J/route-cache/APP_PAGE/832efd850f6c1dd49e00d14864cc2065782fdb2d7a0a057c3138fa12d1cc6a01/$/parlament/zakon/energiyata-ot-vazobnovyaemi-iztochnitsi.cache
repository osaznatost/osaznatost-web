{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/zakon/layout,_N_T_/parlament/zakon/[slug]/layout,_N_T_/parlament/zakon/[slug]/page,_N_T_/parlament/zakon/energiyata-ot-vazobnovyaemi-iztochnitsi"},"segmentPaths":["/_tree","/_full","/parlament/zakon/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/832efd850f6c1dd49e00d14864cc2065782fdb2d7a0a057c3138fa12d1cc6a01/$/parlament/zakon/energiyata-ot-vazobnovyaemi-iztochnitsi","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/zakon/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2bx3suebn7wim.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><script src=\"/_next/static/chunks/43gzry38n6x69.js\" async=\"\"></script><title>Закон за енергията от възобновяеми източници · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Закон за енергията от възобновяеми източници · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Закон за енергията от възобновяеми източници · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Парламент</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Закон</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Закон за енергията от възобновяеми източници</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Малкият закон (вятърни централи) е обнародван в ДВ, бр. 70/2026; големият правителствен е гласуван на второ четене на 4–6.11.2026 г.</div></div></div><nav aria-label=\"Секции на страницата\" class=\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\"><ul class=\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\"><li><a href=\"#nakratko\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Накратко</a></li><li><a href=\"#signali\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Сигнали (3)</a></li><li><a href=\"#zakonoproekti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Кой внесе и кой се изказа</a></li><li><a href=\"#argumenti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Двете страни</a></li><li><a href=\"#mnenie\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Твоето мнение</a></li><li><a href=\"#grupi\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Как гласуваха</a></li><li><a href=\"#glasuvaniya\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Гласувания (28)</a></li></ul></nav><section id=\"nakratko\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Накратко</h2><div class=\"max-w-4xl\"><p class=\"text-[17px]\">Големият правителствен законопроект завършва въвеждането на европейската директива за възобновяемата енергия (2023/2413), чийто срок изтече на 21.05.2025 г.; срещу България вече има процедура за нарушение. Той обновява целите за дела на зелената енергия по сектори, улеснява дългосрочните договори за купуване на зелен ток, въвежда задължения за доставчиците на горива в транспорта, зони за ускорено изграждане на централи с участие на местните общности, правила за биомасата (забрана за субсидии за изгаряне на трупи и промишлена дървесина), за битовите батерии и за малките децентрализирани производители. Малкият закон от юли удължава до 9 месеца валидността на становището за присъединяване на вятърните централи и облекчава затворените електроразпределителни мрежи.</p><p class=\"mt-3 text-[15px]\"><b>Вносители:</b> <!-- -->Министерският съвет (голям законопроект) и Румяна Петрова и др. („Прогресивна България“, малък законопроект)<!-- --> · <a href=\"https://www.parliament.bg/bg/bills/ID/167181\" target=\"_blank\" rel=\"noreferrer\">законопроект <!-- -->52-602-01-22</a></p><p class=\"mt-3 text-[15px]\"><b>Какво се случи:</b> <!-- -->Малкият закон мина през юли за дни: срокът за предложения между четенията беше съкратен по процедура на Румяна Петрова, защото крайният срок по Плана за възстановяване беше 31.08.2026 г. Големият законопроект мина на първо четене на 17.09.2026 г. (131 „за“, „Възраждане“ против); на второ четене са приети и нови текстове в преходните и заключителните разпоредби.</p></div></section><section id=\"signali\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Сигнали</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.</p><ul class=\"grid gap-3 md:grid-cols-2 max-w-5xl\"><li class=\"border-l-4 rounded-sm p-4 border-red bg-[#fdeff1]\"><p class=\"font-semibold\">2 нови текста в преходните и заключителните разпоредби</p><p class=\"text-[15px] text-muted mt-1\">Добавени са чак на второ четене, без обществено обсъждане. В тази част често се променят други закони. Прочетете ги в доклада на комисията и стенограмата.</p></li><li class=\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\"><p class=\"font-semibold\">Съкратен срок за предложения (3 дни)</p><p class=\"text-[15px] text-muted mt-1\">Мнозинството гласува по-кратък срок от обичайните 7 дни, в който депутатите могат да внасят промени между първо и второ четене.</p></li><li class=\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\"><p class=\"font-semibold\">Само 5 дни между двете четения</p><p class=\"text-[15px] text-muted mt-1\">Обичайният срок за предложения между четенията е 7 дни. По-краткият срок означава по-малко време за депутатите и обществото да предложат промени.</p></li></ul><p class=\"text-sm mt-3\"><a href=\"/parlament/signali\">Всички сигнали в парламента</a></p><p class=\"text-xs text-muted mt-2\">Сигналът е повод за въпрос, не доказателство за нарушение.<!-- --> <a class=\"underline\" href=\"/metodologiya#signal\">Как работим със сигналите</a></p></section><section id=\"zakonoproekti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Кой внесе и кой се изказа</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.</p><ul class=\"space-y-4 max-w-5xl\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167196\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за допълнение на Закона за енергията от възобновяеми източници</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-94</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>16 юли 2026 г.<!-- --> от <!-- -->Румяна Петрова, Рашко Динков, Валентин Петров и още 10 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по енергетика (водеща)</dd><dt class=\"text-muted\">Становища</dt><dd>Министерство на енергетиката по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.; КЕВР по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.; БГВЕА по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.; МРРБ по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.; ЕСО ЕАД по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.; Министерство на енергетиката по предложения от Българската ветроенергийна асоциация по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94, внесен от Румяна Петрова и група народни представители на 16.07.2026 г.; Министерство на енергетиката по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.</dd><dt class=\"text-muted\">Предложения</dt><dd>1<!-- --> писмени предложения на депутати между <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">първо</button></span> и <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">второ четене</button></span></dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11156\" target=\"_blank\" rel=\"noreferrer\">24 юли 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span><span>, <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11157\" target=\"_blank\" rel=\"noreferrer\">29 юли 2026 г.</a> (<!-- -->зала второ гласуване<!-- -->)</span></dd><dt class=\"text-muted\">Обнародван</dt><dd>ДВ, бр. 70/2026<!-- -->, приет на 29 юли 2026 г.</dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167181\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за енергията от възобновяеми източници</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-602-01-22</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>10 юли 2026 г.<!-- --> от <!-- -->Министерския съвет</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по енергетика (водеща); Комисия по европейските въпроси и контрол на европейските фондове (участваща); Комисия по околната среда и водите (участваща); Комисия по земеделието, храните и горите (участваща); Комисия по транспорт и съобщения (участваща); Комисия по регионална политика, благоустройство и местно самоуправление (участваща); Комисия по иновациите и дигиталната трансформация (участваща); Комисия по икономическа политика, инвестиции и индустрия (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>АУЕР по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; МРРБ по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; Електроразпределение ЮГ по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; ЕВН България по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; ЕВН България по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; Българската асоциация за водород, горивни клетки и съхранение на енергия  по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; БГВЕА по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; МИИИ  по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; КЕВР  по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; Българска асоциация геотермална енергия  по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; Министерство на околната среда и водите  по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; АПСТЕ по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.</dd><dt class=\"text-muted\">В комисията</dt><dd><span>иновациите и дигиталната трансформация<!-- -->, <!-- -->първо гласуване<!-- -->: <!-- -->9<!-- --> за, <!-- -->1<!-- --> против</span></dd><dt class=\"text-muted\">Предложения</dt><dd>4<!-- --> писмени предложения на депутати между <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">първо</button></span> и <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">второ четене</button></span></dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11171\" target=\"_blank\" rel=\"noreferrer\">17 септември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span><span>, <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11194\" target=\"_blank\" rel=\"noreferrer\">6 ноември 2026 г.</a> (<!-- -->зала второ гласуване<!-- -->)</span></dd></dl></li></ul></section><div id=\"argumenti\" class=\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\"><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Министър на енергетиката Ива Петрова</p><p class=\"text-[15px]\">Законът е нужен, за да приключи транспонирането на директивата и да спре процедурата за нарушение № 2025/0198; помага за европейската цел от 42,5% зелена енергия.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167181\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-22 (Министерски съвет), доклади на три комисии и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Стефан Цанков (за малкия законопроект)</p><p class=\"text-[15px]\">По-дългата валидност на становището за присъединяване отчита дългия процес по изграждане на вятърни централи и намалява риска процедурите да се повтарят; срокът по Плана за възстановяване е 31 август.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167196\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-94 (Р. Петрова и др.), доклад на комисията по енергетика\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Енергийни дружества и браншове (ЕВН, „Електрохолд“, фотоволтаична и ветроенергийна асоциации, КРИБ и др.)</p><p class=\"text-[15px]\">Не възразяват принципно, но предлагат промени по отделни текстове; КРИБ и федерацията на индустриалните консуматори внесоха съвместно становище.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167181\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-22 (Министерски съвет), доклади на три комисии и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Фонд „Сигурност на електроенергийната система“</p><p class=\"text-[15px]\">Подкрепя проекта, но предупреждава, че предложенията на други институции могат да намалят приходите на фонда.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167181\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-22 (Министерски съвет), доклади на три комисии и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">„Възраждане“</p><p class=\"text-[15px]\">Гласуваха против и двата законопроекта на първо четене.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\" title=\"Поименни гласувания, Народно събрание (чрез „Наясно“)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Двете страни на монетата</h3><p class=\"text-sm text-muted mb-3\">Какво следва на практика, ако законът се приеме и ако се отхвърли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167181\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-22 (Министерски съвет), доклади на три комисии и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a><a href=\"https://www.parliament.bg/bg/bills/ID/167196\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-94 (Р. Петрова и др.), доклад на комисията по енергетика\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\"><p class=\"font-semibold\">Ако се приеме</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">България изпълнява директивата и избягва санкции.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">По-бързо изграждане на нови мощности.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Промени в други закони (вкл. в Закона за енергетиката) се правят в преходните и заключителните разпоредби и на второ четене.</li></ul></div></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\"><p class=\"font-semibold\">Ако се отхвърли</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Продължава процедурата за нарушение и рискът от загуба на средства по Плана за възстановяване.</li></ul></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Какво печели и какво губи всяка страна</h3><p class=\"text-sm text-muted mb-3\">Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.</p><div class=\"space-y-3\"><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Инвеститори във вятърни и слънчеви централи<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167181\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-22 (Министерски съвет), доклади на три комисии и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a><a href=\"https://www.parliament.bg/bg/bills/ID/167196\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-94 (Р. Петрова и др.), доклад на комисията по енергетика\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">По-дълъг срок на становището за присъединяване, по-лесни договори за продажба на ток и зони за ускорено изграждане.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Повече правила за участие на местните общности.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Доставчици на горива<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167181\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-22 (Министерски съвет), доклади на три комисии и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Могат да изпълняват задълженията си и чрез кредити за зелена електроенергия.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Нови задължения за дял на възобновяеми горива в транспорта.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Домакинствата<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167181\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-602-01-22 (Министерски съвет), доклади на три комисии и становища\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Права за малките производители и битовите батерии; информация за дела на зелената енергия в парното.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Възможен ефект върху цените от новите задължения не е оценен в доклада.</p></div></div></div></div></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://www.parliament.bg/bg/bills/ID/167181\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-602-01-22 (Министерски съвет), доклади на три комисии и становища</a></li><li><a href=\"https://www.parliament.bg/bg/bills/ID/167196\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-654-01-94 (Р. Петрова и др.), доклад на комисията по енергетика</a></li><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания, Народно събрание (чрез „Наясно“)</a></li></ol><p class=\"text-xs text-muted mt-2\">Обобщението е по докладите на комисиите. „Какво печели и какво губи всяка страна“ е наш анализ.<!-- --> Проверено: <!-- -->19 ноември 2026 г.</p></div></div><section id=\"dokumenti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Още от документите</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.</p><div class=\"space-y-4 max-w-4xl\"><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167196\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за допълнение на Закона за енергията от възобновяеми източници</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-94</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Със законопроекта се предлагат две взаимно свързани промени в Закона за енергията от възобновяеми източници и в Закона за енергетиката, насочени към изпълнение на ключов етап 96 по Реформа C4.R6 „Увеличаване на електрическата енергия от възобновяеми източници“ от Плана за възстановяване и устойчивост, както и към намаляване на административната и регулаторната тежест при реализирането на инвестиции в енергийния сектор.<!-- -->“</li><li>„<!-- -->В мотивите се посочва, че мярката допринася за постигане на целта на Европейския съюз за климатична неутралност до 2050 г., за междинната цел за намаляване на нетните емисии на парникови газове с най-малко 55 на сто до 2030 г. спрямо 1990 г., както и за увеличаване на дела на енергията от възобновяеми източници.<!-- -->“</li><li>„<!-- -->Предвижда се операторите на затворени електроразпределителни мрежи, които служат за разпределение на електрическа енергия между енергийни обекти с интегрирана дейност, да не прилагат общи условия по чл. 104а, ал. 1 от Закона за енергетиката.<!-- -->“</li><li>„<!-- -->Отпадането на това изискване за посочената категория оператори ще намали административната и регулаторната тежест и ще ускори започването на съответната дейност.<!-- -->“</li><li>„<!-- -->Очакваният ефект е намаляване на административната тежест, ускоряване на инвестиционните процеси и създаване на по-благоприятни условия за реализацията на нови енергийни проекти при запазване на приложимите регулаторни изисквания.<!-- -->“</li><li>„<!-- -->Промяната. е с оглед постигане на целта за неутралност по отношение на климата в Съюза до 2050 г., както и междинна цел за намаляване на нетните емисии на парникови газове с поне 5590 до 2030 г. в сравнение с равнищата от 1990 г., общата цел на Съюза за дела на енергията от възобновяеми източници от 42,590, както и конкретно поставените цели за сектор електрическа енергия.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167196\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Стефан Цанков</b><span class=\"text-muted\"> (<!-- -->ПБ<!-- -->)</span>: „<!-- -->Днес обсъждаме Законопроект, който е от две кратки точки, но изключително важни за Плана за възстановяване и устойчивост. Понякога в публичния дебат се създава впечатление, че реформите по ПВУ са само формален акт, но те всъщност преодоляват структурни пречки за развитието на икономиката и намаляването на административната<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11156\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->24.07.2026</a></li><li><b>Цончо Ганев</b><span class=\"text-muted\"> (<!-- -->ВЪЗРАЖДАНЕ<!-- -->)</span>: „<!-- -->Член 1. По така предложения законопроект и конкретно във възможностите, които се предлагат чрез тези промени и ще бъдат приети от мнозинството, имаме ситуация, в която отново депутати и цялата група на „Прогресивна България“ влизат в ярка – щях да кажа „колизия“, в ярко противоречие с това какво са говорили предизборно и какво в този законопроект ще приемете. Ще цитирам конкретно един от водещите в групата Ви, а…<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11157\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->29.07.2026</a></li><li><b>Явор Гечев</b><span class=\"text-muted\"> (<!-- -->ПБ<!-- -->)</span>: „<!-- -->Аз стоя зад всяка дума, която съм казал. Плюс това по времето, по което съм бил служебен министър, точно аз съм човекът, който е отказал да промени статута на такъв тип неща, особено по Варненско, между другото, особено и по Кюстендилско, точно за ветрогенераторите. Абсолютно оставам на позицията, че земеделската земя е с особен статут, че не трябва да се правят такива работи на нея, ако не е изрично необходимо.…<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11157\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->29.07.2026</a></li><li><b>Румяна Петрова</b><span class=\"text-muted\"> (<!-- -->ПБ<!-- -->)</span>: „<!-- -->Уважаеми господин Ганев, госпожа Доцова вече обясни какъв е предметът на Законопроекта, който днес разискваме, но за да стане ясно, безспорно, така е – разглеждаме удължаване на срока на Становището за присъединяването към електропреносната мрежа на обект за производство на енергия от вятър. Никакви фотоволтаици не са обект на този законопроект. И да, работим в посока на намаляването на административната тежест,…<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11157\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->29.07.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->Министерство на енергетиката по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.; КЕВР по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.; БГВЕА по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.; МРРБ по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.; ЕСО ЕАД по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.; Министерство на енергетиката по предложения от Българската ветроенергийна асоциация по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94, внесен от Румяна Петрова и група народни представители на 16.07.2026 г.; Министерство на енергетиката по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167196\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167181\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за енергията от възобновяеми източници</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-602-01-22</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Предлаганите промени са част и от ключов етап 96 по Реформа 6 „Увеличаване на електрическата енергия от възобновяеми източници“ от Плана за възстановяване и устойчивост (ПВУ), както и на мярка 20 от Плана за намаляване на административната тежест, приет с Решение № 233 на Министерския съвет от 29 март 2024 г.<!-- -->“</li><li>„<!-- -->Законопроектът беше представен от Александрина Димитрова, началник на отдел „Енергийна ефективност и възобновяеми енергийни източници“ в дирекция „Енергийни стратегии и политики за устойчиво енергийно развитие“ в Министерството на енергетиката, която обясни, че с него се цели окончателното транспониране на европейското законодателство по отношение на насърчаването на енергията от възобновяеми източници.<!-- -->“</li><li>„<!-- -->От компетентността на Комисията по земеделието, храните и горите са промените, свързани с въвеждането на изискванията по отношение на използването на дървесната биомаса според нейната най-висока икономическа и екологична добавена стойност при спазване на следния ред на приоритетност: продукти от дървесина, удължаване на срока на експлоатация на продуктите от дървесина, повторна употреба, рециклиране, производство на енергия от биомаса и обезвреждане.<!-- -->“</li><li>„<!-- -->Целта е в срок до 31 декември 2030 г. да бъде осигурено изготвянето на споразумения за изпълнението на поне два съвместни проекта.<!-- -->“</li><li>„<!-- -->Разработването на Плана за определяне на приоритетни зони за развитие на обекти за производство на електрическа енергия от вятърна енергия, в което взема участие министърът на земеделието и храните, следва да става при отчитане на възможностите за многоцелево използване на съответната зона.<!-- -->“</li><li>„<!-- -->Министърът на земеделието и храните ще следва да участва в определянето на начина на подаване на информация от икономическите оператори в база данни на Европейския съюз.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167181\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->В последвалата дискусия от парламентарната група на „ВЪЗРАЖДАНЕ“ заявиха, че няма да подкрепят законопроекта.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167181\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Велислава Петрова-чамова</b>: „<!-- -->Председателят на Комисията вече представи съдържанието на Споразумението, затова бих искала да се спра върху елементите от него, които са важни за<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11194\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->06.11.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->АУЕР по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; МРРБ по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; Електроразпределение ЮГ по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; ЕВН България по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; ЕВН България по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; Българската асоциация за водород, горивни клетки и съхранение на енергия  по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; БГВЕА по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; МИИИ  по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; КЕВР  по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; Българска асоциация геотермална енергия  по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; Министерство на околната среда и водите  по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.; АПСТЕ по проект на Закон за изменение и допълнение на Закона за енергията от възобновяеми източници, № 52-602-01-22.<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167181\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div></div></section><section id=\"mnenie\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Твоето мнение</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. <a href=\"/mnenie\">Всички закони за гласуване</a>.</p><div class=\"bg-surface rounded-sm p-5 text-[15px] text-muted\">Зарежда се…</div></section><section id=\"grupi\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласуваха групите по този закон</h2></div><p class=\"text-sm text-muted mb-3\">Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо <!-- -->28<!-- -->. Прието: <!-- -->22<!-- -->, отхвърлено: <!-- -->6<!-- -->.</p><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Прогресивна България</p><p class=\"num text-sm mt-1\">За: <b>22</b> · Против: <b>6</b> · общо <!-- -->28</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ГЕРБ – СДС</p><p class=\"num text-sm mt-1\">За: <b>25</b> · Против: <b>3</b> · общо <!-- -->28</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Демократична България</p><p class=\"num text-sm mt-1\">За: <b>3</b> · Против: <b>1</b> · общо <!-- -->9</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ДПС</p><p class=\"num text-sm mt-1\">За: <b>17</b> · Против: <b>7</b> · общо <!-- -->28</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Продължаваме промяната</p><p class=\"num text-sm mt-1\">За: <b>13</b> · Против: <b>1</b> · общо <!-- -->27</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Възраждане</p><p class=\"num text-sm mt-1\">За: <b>2</b> · Против: <b>24</b> · общо <!-- -->28</p></div></div><p class=\"text-sm mt-3\">Първо четене: <a href=\"/parlament/glasuvane/2026-07-24-236\">24 юли 2026 г.</a><a href=\"/parlament/glasuvane/2026-09-17-4\">17 септември 2026 г.</a></p></section><section id=\"glasuvaniya\" class=\"scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Всички гласувания по закона</h2></div><ul><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-07-24-236\">ЗД на Закона за енергията от възобновяеми източници – първо гласуване</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">24 юли 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: Отсъства · ДПС: За · Продължаваме промяната: За · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\