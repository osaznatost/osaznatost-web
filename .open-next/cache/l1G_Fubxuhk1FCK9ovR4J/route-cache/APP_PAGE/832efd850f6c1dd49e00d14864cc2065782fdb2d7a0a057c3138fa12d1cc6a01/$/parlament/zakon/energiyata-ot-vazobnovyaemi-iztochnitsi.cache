\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs whitespace-nowrap\\\",\\\"children\\\":[\\\" \\\",[[\\\"$\\\",\\\"a\\\",\\\"1\\\",{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167181\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"title\\\":\\\"Народно събрание: законопроект № 52-602-01-22 (Министерски съвет), доклади на три комисии и становища\\\",\\\"className\\\":\\\"ml-0.5 no-underline\\\",\\\"children\\\":[\\\"[\\\",1,\\\"]\\\"]}]]]}]]}]]}],[\\\"$\\\",\\\"li\\\",\\\"Стефан Цанков (за малкия законопроект)По-дългата валидност\\\",{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm font-semibold\\\",\\\"children\\\":\\\"Стефан Цанков (за малкия законопроект)\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px]\\\",\\\"children\\\":[\\\"По-дългата валидност на становището за присъединяване отчита дългия процес по изграждане на вятърни централи и намалява риска процедурите да се повтарят; срокът по Плана за възстановяване е 31 август.\\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs whitespace-nowrap\\\",\\\"children\\\":[\\\" \\\",[[\\\"$\\\",\\\"a\\\",\\\"2\\\",{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167196\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"title\\\":\\\"Народно събрание: законопроект № 52-654-01-94 (Р. Петрова и др.), доклад на комисията по енергетика\\\",\\\"className\\\":\\\"ml-0.5 no-underline\\\",\\\"children\\\":[\\\"[\\\",2,\\\"]\\\"]}]]]}]]}]]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"display text-[1.6rem] mb-3\\\",\\\"children\\\":\\\"Какво казват критиците\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"Енергийни дружества и браншове (ЕВН, „Електрохолд“, фотоволтаична и ветроенергийна асоциации, КРИБ и др.)Не възраз