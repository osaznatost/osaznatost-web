\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Как гласуваха\"}]}],[\"$\",\"li\",\"glasuvaniya\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#glasuvaniya\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Гласувания (28)\"}]}]]}]}],[\"$\",\"section\",null,{\"id\":\"nakratko\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Накратко\"}],\"$undefined\",[\"$\",\"div\",null,{\"className\":\"max-w-4xl\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[17px]\",\"children\":\"Големият правителствен законопроект завършва въвеждането на европейската директива за възобновяемата енергия (2023/2413), чийто срок изтече на 21.05.2025 г.; срещу България вече има процедура за нарушение. Той обновява целите за дела на зелената енергия по сектори, улеснява дългосрочните договори за купуване на зелен ток, въвежда задължения за доставчиците на горива в транспорта, зони за ускорено изграждане на централи с участие на местните общности, правила за биомасата (забрана за субсидии за изгаряне на трупи и промишлена дървесина), за битовите батерии и за малките децентрализирани производители. Малкият закон от юли удължава до 9 месеца валидността на становището за присъединяване на вятърните централи и облекчава затворените електроразпределителни мрежи.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Вносители:\"}],\" \",\"Министерският съвет (голям законопроект) и Румяна Петрова и др. („Прогресивна България“, малък законопроект)\",\"$L1b\"]}],\"$L1c\"]}]]}],\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\"]}]\n24:I[32466,[\"$2\",\"$9\"],\"Term\"]\n35:I[52368,[\"$2\",\"$9\"],\"CitizenVote\"]\n1b:[\" · \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167181\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"законопроект \",\"52-602-01-22\"]}]]\n1c:[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Какво се случи:\"}],\" \",\"Малкият закон мина през юли за дни: срокът за предложения между четенията беше съкратен по процедура на Румяна Петрова, защото крайният срок по Плана за възстановяване беше 31.08.2026 г. Големият законопроект мина на първо четене на 17.09.2026 г. (131 „за“, „Възраждане“ против); на второ четене са приети и нови текстове в преходните и заключителните разпоредби.\"]}]\n1d:[\"$\",\"section\",null,{\"id\":\"signali\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Сигнали\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.\"}],[[\"$\",\"ul\",null,{\"className\":\"grid gap-3 md:grid-cols-2 max-w-5xl\",\"children\":[[\"$\",\"li\",\"2 нови текста в преходните и заключителните разпоредби\",{\"className\":\"border-l-4 rounded-sm p-4 border-red bg-[#fdeff1]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"2 нови текста в преходните и заключителните разпоредби\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Добавени са чак на второ четене, без обществено обсъждане. В тази част често се променят други закони. Прочетете ги в доклада на комисията и стенограмата.\"}]]}],[\"$\",\"li\",\"Съкратен срок за предложения (3 дни)\",{\"className\":\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Съкратен срок за предложения (3 дни)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Мнозинството гласува по-кратък срок от обичайните 7 дни, в който депутатите могат да внасят промени между първо и второ четене.\"}]]}],[\"$\",\"li\",\"Само 5 дни между двете четения\",{\"className\":\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Само 5 дни между двете четения\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Обичайният срок за предложения между четенията е 7 дни. По-краткият срок означава по-малко време за депутатите и обществото да предложат промени.\"}]]}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3\",\"children\":[\"$\",\"$La\",null,{\"href\":\"/parlament/signali\",\"children\":\"Всички сигнали в парламента\"}]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-2\",\"children\":[\"Сигналът е повод за въпрос, не доказателство за нарушение.\",\" \",[\"$\",\"$La\",null,{\"href\":\"/metodologiya#signal\",\"className\":\"underline\",\"children\":\"Как работим със сигналите\"}]]}]]]}]\n1e:[\"$\",\"section\",null,{\"id\":\"zakonoproekti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Кой внесе и кой се изказа\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.\"}],[[\"$\",\"ul\",null,{\"className\":\"space-y-4 max-w-5xl\",\"children\":[[\"$\",\"li\",\"167196\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167196\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за допълнение на Закона за енергията от възобновяеми източници\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-654-01-94\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"16 юли 2026 г.\",\" от \",\"Румяна Петрова, Рашко Динков, Валентин Петров и още 10 депутати\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по енергетика (водеща)\"}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Становища\"}],[\"$\",\"dd\",null,{\"children\":\"Министерство на енергетиката по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.; КЕВР по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.; БГВЕА по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.; МРРБ по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.; ЕСО ЕАД по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.; Министерство на енергетиката по предложения от Българската ветроенергийна асоциация по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94, внесен от Румяна Петрова и група народни представители на 16.07.2026 г.; Министерство на енергетиката по проект на Закон за допълнение на Закона за енергията от възобновяеми източници, № 52-654-01-94.\"}]],false,false,false,[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Предложения\"}],[\"$\",\"dd\",null,{\"children\":[1,\" писмени предложения на депутати между \",[\"$\",\"$L24\",null,{\"k\":\"parvo-chetene\",\"children\":\"първо\"}],\" и \",[\"$\",\"$L24\",null,{\"k\":\"vtoro-chetene\",\"children\":\"второ четене\"}]]}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"В залата\"}],[\"$\",\"dd\",null,{\"children\":[[\"$\",\"span\",\"0\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11156\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"24 юли 2026 г.\"}],\" (\",\"зала първо гласуване\",\")\"]}],[\"$\",\"span\",\"1\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11157\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"29 юли 2026 г.\"}],\" (\",\"зала второ гласуване\",\")\"]}]]}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Обнародван\"}],[\"$\",\"dd\",null,{\"children\":[\"ДВ, бр. 70/2026\",\", приет на 29 юли 2026 г.\"]}]]]}]]}],[\"$\",\"li\",\"167181\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167181\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за енергията от възобновяеми източници\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-602-01-22\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\",false,false,\"$L2a\",\"$L2b\",null]}]]}]]}],false]]}]\n1f:[\"$\",\"div\",null,{\"id\":\"argumenti\",\"className\":\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-2 mt-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-green bg-surface\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Мотивите на вносителите\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Министър на енергетиката Ива ПетроваЗаконът е нужен, за \",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Министър на енергетиката Ива Петрова\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Законът е нужен, за да приключи транспонирането на директивата и да спре процедурата за нарушение № 2025/0198; помага за европейската цел от 42,5% зелена енергия.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167181\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-22 (Министерски съвет), доклади на три комисии и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Стефан Цанков (за малкия законопроект)По-дългата валидност\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Стефан Цанков (за малкия законопроект)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"По-дългата валидност на становището за присъединяване отчита дългия процес по изграждане на вятърни централи и намалява риска процедурите да се повтарят; срокът по Плана за възстановяване е 31 август.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"2\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167196\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-94 (Р. Петрова и др.), доклад на комисията по енергетика\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",2,\"]\"]}]]]}]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Какво казват критиците\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Енергийни дружества и браншове (ЕВН, „Електрохолд“, фотоволтаична и ветроенергийна асоциации, КРИБ и др.)Не възразяват принци\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Енергийни дружества и браншове (ЕВН, „Електрохолд“, фотоволтаична и ветроенергийна асоциации, КРИБ и др.)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Не възразяват принципно, но предлагат промени по отделни текстове; КРИБ и федерацията на индустриалните консуматори внесоха съвместно становище.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167181\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-22 (Министерски съвет), доклади на три комисии и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Фонд „Сигурност на електроенергийната система“Подкрепя проекта, но\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Фонд „Сигурност на електроенергийната система“\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Подкрепя проекта, но предупреждава, че предложенията на други институции могат да намалят приходите на фонда.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167181\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-602-01-22 (Министерски съвет), доклади на три комисии и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"„Възраждане“Гласуваха против и д\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"„Възраждане“\"}],\"$L2c\"]}]]}]]}]]}],null,\"$L2d\",\"$L2e\",null,\"$L2f\"]}]\n20:[\"$\",\"section\",null,{\"id\":\"dokumenti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Още от документите\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 max-w-4xl\",\"children\":[[\"$\",\"div\",\"167196\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167196\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за допълнение на Закона за енергията от възобновяеми източници\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-654-01-94\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Със законопроекта се предлагат две взаимно свързани промени в Закона за енергията от възобновяеми източници и в Закона за енергетиката, насочени към изпълнение на ключов етап 96 по Реформа C4.R6 „Увеличаване на електрическата енергия от възобновяеми източници“ от Плана за възстановяване и устойчивост, както и към намаляване на административната и регулаторната тежест при реализирането на инвестиции в енергийния сектор.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"В мотивите се посочва, че мярката допринася за постигане на целта на Европейския съюз за климатична неутралност до 2050 г., за междинната цел за намаляване на нетните емисии на парникови газове с най-малко 55 на сто до 2030 г. спрямо 1990 г., както и за увеличаване на дела на енергията от възобновяеми източници.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Предвижда се операторите на затворени електроразпределителни мрежи, които служат за разпределение на електрическа енергия между енергийни обекти с интегрирана дейност, да не прилагат общи условия по чл. 104а, ал. 1 от Закона за енергетиката.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"Отпадането на това изискване за посочената категория оператори ще намали административната и регулаторната тежест и ще ускори започването на съответната дейност.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Очакваният ефект е намаляване на административната тежест, ускоряване на инвестиционните процеси и създаване на по-благоприятни условия за реализацията на нови енергийни проекти при запазване на приложимите регулаторни изисквания.\",\"“\"]}],[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"Промяната. е с оглед постигане на целта за неутралност по отношение на климата в Съюза до 2050 г., както и междинна цел за намаляване на нетните емисии на парникови газове с поне 5590 до 2030 г. в сравнение с равнищата от 1990 г., общата цел на Съюза за дела на енергията от възобновяеми източници от 42,590, както и конкретно поставените цели за сектор електрическа енергия.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167196\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],\"$L30\",\"$L31\",\"$L32\",\"$L33\"]}]]}]]}],\"$L34\"]}]]}]\n21:[\"$\",\"section\",null,{\"id\":\"mnenie\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Твоето мнение\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":[\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \",[\"$\",\"$La\",null,{\"href\":\"/mnenie\",\"children\":\"Всички закони за гласуване\"}],\".\"]}],[\"$\",\"$L35\",null,{\"item\":\"energiyata-ot-vazobnovyaemi-iztochnitsi\",\"question\":\"Подкрепяш ли последните промени в „Закон за енергията от възобновяеми източници (два закона: юли и ноември 2026)“?\"}]]}]\n22:[\"$\",\"section\",null,{\"id\":\"grupi\",\"className\":\"mb-12 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb-5\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] sm:text-[2.4rem]\",\"children\":\"Как гласуваха групите по този закон\"}],\"$undefined\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mb-3\",\"children\":[\"Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо \",28,\". Прието: \",22,\", отхвърлено: \",6,\".\"]}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"div\",\"ПБ\",{\"className\":\"border border-rule rounded-sm p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Прогресивна България\"}],[\"$\",\"p\",null,{\"className\":\"num text-sm mt-1\",\"children\":[\"За: \",[\"$\",\"b\",null,{\"children\":22}],\" · Против: \",[\"$\",\"b\",null,{\"children\":6}],\" · общо \",28]}]