\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.bta.bg/bg/news/bulgaria/1211853-parlamentat-odobri-nulev-aktsiz-do-kraya-na-godinata-za-prirodniya-gaz-i-vtechne\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"БТА: Парламентът одобри нулев акциз за природния газ и пропан-бутана (25.09.2026)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}],[\"$\",\"div\",null,{\"className\":\"grid sm:grid-cols-2 gap-px bg-rule mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-white px-4 py-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-[#2f7d57] mb-0.5\",\"children\":\"Печели\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"—\"}]]}],[\"$\",\"div\",null,{\"className\":\"bg-white px-4 py-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-red mb-0.5\",\"children\":\"Губи\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"Около 20 млн. € по-малко приходи до края на 2026 г.\"}]]}]]}]]}],[\"$\",\"div\",\"Вносителите и бензиностанциите\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold px-4 pt-3\",\"children\":[\"Вносителите и бензиностанциите\",\"$L3d\"]}],\"$L3e\"]}]]}]]}]\n2d:[\"$\",\"div\",null,{\"className\":\"mt-8\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.8rem] mb-3\",\"children\":\"Проверени твърдения\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Пропан-бутанът ще поевтинее с около 10 евроцента на литър.\",{\"className\":\"rounded-xl ring-1 ring-rule p-4 bg-white\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-baseline justify-between gap-2\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Пропан-бутанът ще поевтинее с около 10 евроцента на литър.\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold px-2.5 py-0.5 rounded-full bg-[#e2b33b] text-ink\",\"children\":\"Отчасти вярно\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Това е максималният ефект от премахнатия акциз. Намалението стига до шофьора само ако търговците не го задържат в надценката. Около 75% от пропан-бутана е внос и цената зависи от вносителя.\"}]]}],[\"$\",\"li\",\"Мярката струва на бюджета около 20 млн. € за три месеца.\",{\"className\":\"rounded-xl ring-1 ring-rule p-4 bg-white\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-baseline justify-between gap-2\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Мярката струва на бюджета около 20 млн. € за три месеца.\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold px-2.5 py-0.5 rounded-full bg-white text-ink ring-1 ring-rule\",\"children\":\"Непотвърдено\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Това е оценката, цитирана при обсъждането. Ще проверим реалния ефект в отчета за изпълнението на бюджета.\"}]]}]]}]]}]\n2e:[\"$\",\"div\",null,{\"className\":\"mt-8 text-sm\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Източници\"}],[\"$\",\"ol\",null,{\"className\":\"list-decimal pl-5 space-y-0.5\",\"children\":[[\"$\",\"li\",\"https://www.bta.bg/bg/news/bulgaria/1211853-parlamentat-odobri-nulev-aktsiz-do-kraya-na-godinata-za-prirodniya-gaz-i-vtechne\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.bta.bg/bg/news/bulgaria/1211853-parlamentat-odobri-nulev-aktsiz-do-kraya-na-godinata-za-prirodniya-gaz-i-vtechne\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"БТА: Парламентът одобри нулев акциз за природния газ и пропан-бутана (25.09.2026)\"}]}],[\"$\",\"li\",\"https://www.parliament.bg/bg/laws/ID/167564\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/laws/ID/167564\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Народно събрание: законът и указът за обнародване\"}]}],[\"$\",\"li\",\"https://naiasno.bg/parliament\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://naiasno.bg/parliament\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Поименни гласувания (чрез „Наясно“)\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-2\",\"children\":[\"През ноември 2026 г. е внесен и отделен законопроект на Министерския съвет за акциз върху мощните автомобили. Той е приет на първо четене, но още не е в данните ни за гласуванията. Таблицата „Какво печели и какво губи всяка страна“ и последиците „ако се приеме / ако се отхвърли“ са наш анализ на текста и аргументите от източниците, не позиция на партия.\",\" Проверено: \",\"17 ноември 2026 г.\"]}]]}]\n2f:[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167628\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]\n30:[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#8a8f8c] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Позиции, изказани в комисията\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Парламентарната група „Прогресивна България“ ще подкрепи изцяло законопроекта.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167628\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}]\n31:[\"$\",\"div\",null,{\"className\":\"border-l-4 border-red pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Възражения и критики\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"В писменото си становище Асоциацията на производителите, вносителите и търговците на спиртни напитки подкрепя предложените изменения, свързани с валидността на образците на акцизни бандероли за спиртни напитки в чл. 64 от ЗАДС, като приема, че тези промени са положителна стъпка към постигане на по-голяма правна сигурност, предвидимост и намаляване на ненужната административна и финансова тежест за добросъвестните икономически оператори.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"По отношение на предложенията за акциз върху автомобилите с мощност над 250 kW изразяват притеснение, че предвиденият нов акциз за вноса на нови и употребявани автомобили изисква съществени промени в интегрираните IT, ERP, счетоводни, фактуриращи и търговски системи на автомобилните вносители, включително координация с международните системи на производителите и с митническата администрация.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Асоциацията на индустриалния капитал в България по принцип подкрепят промените, свързани с въвеждане на акциз върху леките автомобили с висока мощност и луксозен характер при определено коригиране на текстовете, но не подкрепят увеличението на санкциите, каквото е и становището на КРИБ, и акцизната ставка по § 14 от законопроекта.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"Господин Владислав Горанов изрази притеснение във връзка с предложението за отменя на чл. 124а, 124б и 124в от ЗАДС, като счита, че този подход е неудачен, тъй като Агенция „Митници“ се лишава от един работещ инструмент.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Теменужка Петкова също изразява резерви към този подход на Министерството на финансите, като изтъква, че не може да се говори за прекомерност.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167628\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}]\n32:[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#e08a2e] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"В пленарната зала\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"b\",null,{\"children\":\"Цончо Ганев\"}],[\"$\",\"span\",null,{\"className\":\"text-muted\",\"children\":[\" (\",\"ВЪЗРАЖДАНЕ\",\")\"]}],\": „\",\"След като управляващите дойдоха на власт с обяснението, че няма да вдигат данъци, първите неща, които направиха, е да вдигат данъците – този бюджет е еманация на вдигането на данъци – вчера включително. И след малко продължава вдигането на данъци. Стигнаха дотам, че да продължат борбата срещу ракията в България! Меко казано, е обидно и цинично това нещо, но сега – да е ясно на тези, които слушат и гледат какво се…\",\"“ \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11196\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm whitespace-nowrap\",\"children\":[\"стенограма, \",\"12.11.2026\"]}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"b\",null,{\"children\":\"Костадин Ангелов\"}],[\"$\",\"span\",null,{\"className\":\"text-muted\",\"children\":[\" (\",\"ГЕРБ-СДС\",\")\"]}],\": „\",\"На 14 ноември отбелязваме Световния ден на диабета – на рождената дата на един от откривателите на инсулина, доктор Фредерик Бантинг, получил заедно с трима свои колеги Нобелова награда за медицина и физиология през 1923\",\"“ \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11196\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm whitespace-nowrap\",\"children\":[\"стенограма, \",\"12.11.2026\"]}]]}]]}]]}]\n33:[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"КНСБ по ЗИД на ЗАДС-64; СпиритсБ-я по ЗИД на ЗАДС-64; НОМА по ЗИД на ЗАДС-64; БСК по ЗИД на ЗАДС-64; АИКБ по ЗИД на ЗАДС; Хоризонт Запад по ЗИД на ЗАДС-64; АТЕБ по ЗИД на ЗАДС-64\",\". \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167628\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Текстовете в parliament.bg\"}]]}]\n34:[\"$\",\"div\",\"167564\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167564\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за акцизите и данъчните складове\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-654-01-149\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Поради това, временното прилагане на нулева акцизна ставка за природния газ и втечнения нефтен газ (LPG), използвани като моторно гориво, има за цел да ограничи данъчната компонента в цената на тези продукти и да създаде предпоставки за намаляване или ограничаване на нарастването на крайните цени.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Предвижда се мярката да има извънреден и строго ограничен във времето характер и да се прилага за периода от 1 октомври 2026 г. до 31 декември 2026 г.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Предлаганата мярка е временна, тъй като продължителното прилагане на нулево акцизно облагане би могло да доведе до значителна загуба на бюджетни приходи, да намали ценовите стимули за ограничаване на потреблението на изкопаеми горива и да създаде отклонение от дългосрочните цели в областта на енергийната и климатичната политика.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"Основания за законодателна инициатива Законодателната инициатива е обусловена от необходимостта от предприемане на временни мерки за ограничаване на неблагоприятните икономически последици от същественото повишаване на цените на енергийните продукти и от нарушенията във веригите за доставка на нефт, нефтопродукти и природен газ, породени от геополитическата обстановка в Близкия изток и свързаната с нея несигурност на международните енергийни пазари.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Поради това временното прилагане на нулева акцизна ставка за природния газ и втечнения нефтен газ (СРС), използвани като моторно гориво, има за цел да ограничи данъчната компонента в цената на тези продукти и да създаде предпоставки за намаляване или ограничаване на нарастването на крайните цени.\",\"“\"]}],[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"Предвижда се мярката да има извънреден и строго ограничен във времето характер и да се прилага за периода от | октомври 2026 г. до 31 декември 2020 г.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167564\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#8a8f8c] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Позиции, изказани в комисията\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Вносителят г-н Стефан Белчев посочи, че законодателната инициатива е обусловена от необходимостта от предприемане на временни мерки за ограничаване на неблагоприятните икономически последици от същественото повишаване на цените на енергийните продукти и от нарушенията във веригите за доставка на нефт, нефтопродукти и природен газ, породени от геополитическата обстановка в Близкия изток и свързаната с нея несигурност на международните енергийни пазари.\",\"“\"]}],\"$L3f\"]}],\"$L40\"]}],\"$L41\",\"$L42\",\"$L43\"]}]]}]]}]\n36:[\"$\",\"span\",null,{\"className\":\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\",\"children\":\"Прието\"}]\n37:[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mt-1\",\"children\":[\"25 септември 2026 г.\",\" · \",\"Второ четене: наименование\",\" · \",\"Прогресивна България: За · ГЕРБ – СДС: Въздържал се · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: За\"]}]\n38:[\"$\",\"li\",\"2026-09-25-24\",{\"className\":\"border-b border-rule py-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-baseline justify-between gap-2\",\"children\":[[\"$\",\"$La\",null,{\"href\":\"/parlament/glasuvane/2026-09-25-24\",\"className\":\"text-ink no-underline hover:underline\",\"children\":\"Закона за акцизите и данъчните складове - второ гласуване - параграф 1 - предложение от Светла Коджабашева за редакция\"}],[\"$\",\"span\",null,{\"className\":\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\",\"children\":\"Прието\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mt-1\",\"children\":[\"25 септември 2026 г.\",\" · \",\"Второ четене: редакция от залата\",\" · \",\"Прогресивна България: За · ГЕРБ – СДС: Въздържал се · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: За\"]}]]}]\n39:[\"$\",\"li\"