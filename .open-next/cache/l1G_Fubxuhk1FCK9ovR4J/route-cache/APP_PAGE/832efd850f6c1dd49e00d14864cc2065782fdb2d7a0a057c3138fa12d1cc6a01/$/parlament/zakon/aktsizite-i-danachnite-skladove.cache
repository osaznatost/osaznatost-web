{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/zakon/layout,_N_T_/parlament/zakon/[slug]/layout,_N_T_/parlament/zakon/[slug]/page,_N_T_/parlament/zakon/aktsizite-i-danachnite-skladove"},"segmentPaths":["/_tree","/_full","/parlament/zakon/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/832efd850f6c1dd49e00d14864cc2065782fdb2d7a0a057c3138fa12d1cc6a01/$/parlament/zakon/aktsizite-i-danachnite-skladove","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/zakon/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2bx3suebn7wim.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><script src=\"/_next/static/chunks/43gzry38n6x69.js\" async=\"\"></script><title>Закон за акцизите и данъчните складове · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Закон за акцизите и данъчните складове · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Закон за акцизите и данъчните складове · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Парламент</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Закон</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Закон за акцизите и данъчните складове</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Приет окончателно на 25 септември 2026 г. (обнародван в ДВ, бр. 90/2026)</div></div></div><nav aria-label=\"Секции на страницата\" class=\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\"><ul class=\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\"><li><a href=\"#nakratko\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Накратко</a></li><li><a href=\"#signali\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Сигнали (2)</a></li><li><a href=\"#zakonoproekti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Кой внесе и кой се изказа</a></li><li><a href=\"#argumenti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Двете страни</a></li><li><a href=\"#mnenie\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Твоето мнение</a></li><li><a href=\"#grupi\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Как гласуваха</a></li><li><a href=\"#glasuvaniya\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Гласувания (10)</a></li></ul></nav><section id=\"nakratko\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Накратко</h2><div class=\"max-w-4xl\"><p class=\"text-[17px]\">Временно нулев акциз от 1 октомври до 31 декември 2026 г. за природния газ (метан) и пропан-бутана (LPG), когато се използват като гориво за автомобили. Мотивът са високите цени на горивата заради положението в Близкия изток.</p><p class=\"mt-3 text-[15px]\"><b>Вносители:</b> <!-- -->Стефан Белчев, Константин Проданов и Светла Коджабашева („Прогресивна България“)<!-- --> · <a href=\"https://www.parliament.bg/bg/bills/ID/167564\" target=\"_blank\" rel=\"noreferrer\">законопроект <!-- -->52-654-01-149</a></p><p class=\"mt-3 text-[15px]\"><b>Какво се случи:</b> <!-- -->Законът беше приет на двете четения в едно заседание. На първо четене „за“ гласуваха „Прогресивна България“, ДПС, „Възраждане“, присъстващите от ДБ и трима от ПП. ГЕРБ–СДС се въздържа. Никой не гласува „против“.</p></div></section><section id=\"signali\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Сигнали</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.</p><ul class=\"grid gap-3 md:grid-cols-2 max-w-5xl\"><li class=\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\"><p class=\"font-semibold\">Съкратен срок за предложения (6 дни)</p><p class=\"text-[15px] text-muted mt-1\">Мнозинството гласува по-кратък срок от обичайните 7 дни, в който депутатите могат да внасят промени между първо и второ четене.</p></li><li class=\"border-l-4 rounded-sm p-4 border-red bg-[#fdeff1]\"><p class=\"font-semibold\">Двете четения в един ден</p><p class=\"text-[15px] text-muted mt-1\">Законът е приет на първо и второ четене в едно заседание. Няма срок за предложения и за обсъждане в комисия между четенията. Понякога е оправдано (спешни или технически промени), но намалява контрола.</p></li></ul><p class=\"text-sm mt-3\"><a href=\"/parlament/signali\">Всички сигнали в парламента</a></p><p class=\"text-xs text-muted mt-2\">Сигналът е повод за въпрос, не доказателство за нарушение.<!-- --> <a class=\"underline\" href=\"/metodologiya#signal\">Как работим със сигналите</a></p></section><section id=\"zakonoproekti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Кой внесе и кой се изказа</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.</p><ul class=\"space-y-4 max-w-5xl\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167628\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за акцизите и данъчните складове</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-602-01-64</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>5 ноември 2026 г.<!-- --> от <!-- -->Министерския съвет</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща); Комисия по икономическа политика, инвестиции и индустрия (участваща); Комисия по транспорт и съобщения (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>КНСБ по ЗИД на ЗАДС-64; СпиритсБ-я по ЗИД на ЗАДС-64; НОМА по ЗИД на ЗАДС-64; БСК по ЗИД на ЗАДС-64; АИКБ по ЗИД на ЗАДС; Хоризонт Запад по ЗИД на ЗАДС-64; АТЕБ по ЗИД на ЗАДС-64</dd><dt class=\"text-muted\">Предложения</dt><dd>5<!-- --> писмени предложения на депутати между <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">първо</button></span> и <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">второ четене</button></span></dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11196\" target=\"_blank\" rel=\"noreferrer\">12 ноември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167564\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Закона за акцизите и данъчните складове</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-149</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>21 септември 2026 г.<!-- --> от <!-- -->Стефан Белчев, Константин Проданов, Светла Коджабашева</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по бюджет и финанси (водеща); Комисия по икономическа политика, инвестиции и индустрия (участваща); Комисия по енергетика (участваща); Комисия по европейските въпроси и контрол на европейските фондове (участваща)</dd><dt class=\"text-muted\">Становища</dt><dd>МИИИ по ЗИД на ЗАДС № 52-654-01-149; БПГА по ЗИД на ЗАДС № 52-654-01-149; М-во на енергетиката по ЗИД на ЗАДС - 149; МФ по ЗИД на ЗАДС - 149</dd><dt class=\"text-muted\">В комисията</dt><dd><span>бюджет и финанси<!-- -->, <!-- -->първо гласуване<!-- -->: <!-- -->14<!-- --> за, <!-- -->0<!-- --> против<!-- -->, 2 въздържал се</span></dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11178\" target=\"_blank\" rel=\"noreferrer\">25 септември 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span><span>, <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11178\" target=\"_blank\" rel=\"noreferrer\">25 септември 2026 г.</a> (<!-- -->зала второ гласуване<!-- -->)</span></dd><dt class=\"text-muted\">Обнародван</dt><dd>ДВ, бр. 90/2026<!-- -->, приет на 25 септември 2026 г.</dd></dl></li></ul></section><div id=\"argumenti\" class=\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\"><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Стефан Белчев и Слави Василев („Прогресивна България“)</p><p class=\"text-[15px]\">Мярката сваля цената на горивото, което ползват най-уязвимите шофьори. Контролът е чрез декларациите за съответствие. Около 75% от пропан-бутана е внос и цената следва вносителя.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/news/bulgaria/1211853-parlamentat-odobri-nulev-aktsiz-do-kraya-na-godinata-za-prirodniya-gaz-i-vtechne\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът одобри нулев акциз за природния газ и пропан-бутана (25.09.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Мартин Димитров (ДБ)</p><p class=\"text-[15px]\">Подкрепя, но намалението за метана е „козметично“. Приходната агенция трябва да следи дали търговците свалят цените.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/news/bulgaria/1211853-parlamentat-odobri-nulev-aktsiz-do-kraya-na-godinata-za-prirodniya-gaz-i-vtechne\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът одобри нулев акциз за природния газ и пропан-бутана (25.09.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Петър Петров и Димо Дренчев („Възраждане“)</p><p class=\"text-[15px]\">Подкрепят, но ефектът е ограничен: ползват го около 12% от колите и няма защита, ако цените пак скочат.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/news/bulgaria/1211853-parlamentat-odobri-nulev-aktsiz-do-kraya-na-godinata-za-prirodniya-gaz-i-vtechne\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът одобри нулев акциз за природния газ и пропан-бутана (25.09.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Теменужка Петкова (ГЕРБ–СДС)</p><p class=\"text-[15px]\">Въздържа се: мерките са зле насочени. Хърватия например е намалила ставките за бензин и дизел.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/news/bulgaria/1211853-parlamentat-odobri-nulev-aktsiz-do-kraya-na-godinata-za-prirodniya-gaz-i-vtechne\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът одобри нулев акциз за природния газ и пропан-бутана (25.09.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-3\">Какво казват данните</h3><ul class=\"space-y-2 list-none pl-0\"><li class=\"border-l-4 border-deep pl-4 text-[15px]\">Около 394 000 коли (12%) карат на пропан-бутан и около 65–70 хил. на метан.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/news/bulgaria/1211853-parlamentat-odobri-nulev-aktsiz-do-kraya-na-godinata-za-prirodniya-gaz-i-vtechne\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът одобри нулев акциз за природния газ и пропан-бутана (25.09.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">Максимален ефект: около 10 евроцента на литър пропан-бутан и 2 евроцента на килограм метан, ако търговците го прехвърлят изцяло.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/news/bulgaria/1211853-parlamentat-odobri-nulev-aktsiz-do-kraya-na-godinata-za-prirodniya-gaz-i-vtechne\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът одобри нулев акциз за природния газ и пропан-бутана (25.09.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">Цената за бюджета е около 20 млн. € за три месеца.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/news/bulgaria/1211853-parlamentat-odobri-nulev-aktsiz-do-kraya-na-godinata-za-prirodniya-gaz-i-vtechne\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът одобри нулев акциз за природния газ и пропан-бутана (25.09.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></li><li class=\"border-l-4 border-deep pl-4 text-[15px]\">Първо четене: 158 „за“, 0 „против“, 10 „въздържал се“ (9 от ГЕРБ–СДС и 1 от ПП).<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\" title=\"Поименни гласувания (чрез „Наясно“)\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></li></ul></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Двете страни на монетата</h3><p class=\"text-sm text-muted mb-3\">Какво следва на практика, ако законът се приеме и ако се отхвърли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/news/bulgaria/1211853-parlamentat-odobri-nulev-aktsiz-do-kraya-na-godinata-za-prirodniya-gaz-i-vtechne\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът одобри нулев акциз за природния газ и пропан-бутана (25.09.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\"><p class=\"font-semibold\">Ако се приеме</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">До 10 евроцента по-евтин литър пропан-бутан и 2 евроцента по-евтин килограм метан до края на 2026 г.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Бюджетът губи около 20 млн. €.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Ползват го само около 12% от колите, а търговците може да задържат част от намалението.</li></ul></div></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\"><p class=\"font-semibold\">Ако се отхвърли</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Бюджетът запазва около 20 млн. €.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Няма облекчение за шофьорите на газ при високите цени на горивата.</li></ul></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Какво печели и какво губи всяка страна</h3><p class=\"text-sm text-muted mb-3\">Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.</p><div class=\"space-y-3\"><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Шофьорите на пропан-бутан и метан<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/news/bulgaria/1211853-parlamentat-odobri-nulev-aktsiz-do-kraya-na-godinata-za-prirodniya-gaz-i-vtechne\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът одобри нулев акциз за природния газ и пропан-бутана (25.09.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">До 10 евроцента по-евтин литър пропан-бутан и 2 евроцента по-евтин килограм метан.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Нищо, освен ако търговците задържат намалението.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Шофьорите на бензин и дизел<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/news/bulgaria/1211853-parlamentat-odobri-nulev-aktsiz-do-kraya-na-godinata-za-prirodniya-gaz-i-vtechne\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът одобри нулев акциз за природния газ и пропан-бутана (25.09.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Нищо.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Не получават намаление, а заедно с всички данъкоплатци плащат загубата за бюджета.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Бюджетът<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/news/bulgaria/1211853-parlamentat-odobri-nulev-aktsiz-do-kraya-na-godinata-za-prirodniya-gaz-i-vtechne\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът одобри нулев акциз за природния газ и пропан-бутана (25.09.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">—</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Около 20 млн. € по-малко приходи до края на 2026 г.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Вносителите и бензиностанциите<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/bg/news/bulgaria/1211853-parlamentat-odobri-nulev-aktsiz-do-kraya-na-godinata-za-prirodniya-gaz-i-vtechne\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: Парламентът одобри нулев акциз за природния газ и пропан-бутана (25.09.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->1<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Могат да задържат част от намалението като по-висока печалба.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">—</p></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-3\">Проверени твърдения</h3><ul class=\"space-y-3\"><li class=\"rounded-xl ring-1 ring-rule p-4 bg-white\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><p class=\"font-semibold\">Пропан-бутанът ще поевтинее с около 10 евроцента на литър.</p><span class=\"text-sm font-semibold px-2.5 py-0.5 rounded-full bg-[#e2b33b] text-ink\">Отчасти вярно</span></div><p class=\"text-[15px] text-muted mt-1\">Това е максималният ефект от премахнатия акциз. Намалението стига до шофьора само ако търговците не го задържат в надценката. Около 75% от пропан-бутана е внос и цената зависи от вносителя.</p></li><li class=\"rounded-xl ring-1 ring-rule p-4 bg-white\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><p class=\"font-semibold\">Мярката струва на бюджета около 20 млн. € за три месеца.</p><span class=\"text-sm font-semibold px-2.5 py-0.5 rounded-full bg-white text-ink ring-1 ring-rule\">Непотвърдено</span></div><p class=\"text-[15px] text-muted mt-1\">Това е оценката, цитирана при обсъждането. Ще проверим реалния ефект в отчета за изпълнението на бюджета.</p></li></ul></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://www.bta.bg/bg/news/bulgaria/1211853-parlamentat-odobri-nulev-aktsiz-do-kraya-na-godinata-za-prirodniya-gaz-i-vtechne\" target=\"_blank\" rel=\"noreferrer\">БТА: Парламентът одобри нулев акциз за природния газ и пропан-бутана (25.09.2026)</a></li><li><a href=\"https://www.parliament.bg/bg/laws/ID/167564\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законът и указът за обнародване</a></li><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания (чрез „Наясно“)</a></li></ol><p class=\"text-xs text-muted mt-2\">През ноември 2026 г. е внесен и отделен законопроект на Министерския съвет за акциз върху мощните автомобили. Той е приет на първо четене, но още не е в данните ни за гласуванията. Таблицата „Какво печели и какво губи всяка страна“ и последиците „ако се приеме / ако се отхвърли“ са наш анализ на текста и аргументите от източниците, не позиция на партия.<!-- --> Проверено: <!-- -->17 ноември 2026 г.</p></div></div><section id=\"dokumenti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Още от документите</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.</p><div class=\"space-y-4 max-w-4xl\"><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167628\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за акцизите и данъчните складове</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-602-01-64</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->В тази връзка предлаганите промени са: - въвеждане на акциз върху леките автомобили с цел осигуряване на по-справедливо и ефективно данъчно облагане на автомобилите с висока мощност и луксозен характер чрез отчитане на техните характеристики при формиране на данъчната тежест.<!-- -->“</li><li>„<!-- -->Конфедерацията на независимите синдикати в България подкрепя предложението за въвеждането на акциз върху автомобили с мощност на двигателя над 250 киловата, като се изключват специализираните МПС (като линейки, противопожарни автомобили, автомобили със специален режим на движение) и електрическите автомобили и счита, че то отговаря на очакванията на обществото, и същевременно е източник за допълнителни приходи в хазната.<!-- -->“</li><li>„<!-- -->Подкрепят също и ограничаването на нелегалното разпространение на спиртни напитки (ракия), произведени в условията на облекчения режим за допустима семейна консумация, но обръщат внимание да бъде засилен контрола.<!-- -->“</li><li>„<!-- -->Конфедерацията на работодателите и индустриалците в България считат, че предложените промени в чл. 57а не уреждат достатъчно ясно режима за производители на електроенергия от ВЕИ с инсталирана мощност над 5 MW, които експлоатират колокирани съоръжения за съхранение, като е необходимо изрично да се уреди както регистрационният режим, така и акцизното третиране за тази категория лица и текстовете да се прецизират.<!-- -->“</li><li>„<!-- -->Господин Асен Василев приема, че предлаганите текстове относно предложеното изменение на чл. 100 от законопроекта, които имат за цел да прецизират режима за съхранение на етилов алкохол (ракия), произведен в регистрирани специализирани малки обекти за дестилиране, и създаване на ефективен механизъм за предотвратяване на нерегламентираната му реализация, не са адекватни на действителността.<!-- -->“</li><li>„<!-- -->Константин Проданов обърна внимание, че в случая, нерегламентираните производства на ракия застрашават живота и здравето на хората.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167628\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Парламентарната група „Прогресивна България“ ще подкрепи изцяло законопроекта.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167628\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->В писменото си становище Асоциацията на производителите, вносителите и търговците на спиртни напитки подкрепя предложените изменения, свързани с валидността на образците на акцизни бандероли за спиртни напитки в чл. 64 от ЗАДС, като приема, че тези промени са положителна стъпка към постигане на по-голяма правна сигурност, предвидимост и намаляване на ненужната административна и финансова тежест за добросъвестните икономически оператори.<!-- -->“</li><li>„<!-- -->По отношение на предложенията за акциз върху автомобилите с мощност над 250 kW изразяват притеснение, че предвиденият нов акциз за вноса на нови и употребявани автомобили изисква съществени промени в интегрираните IT, ERP, счетоводни, фактуриращи и търговски системи на автомобилните вносители, включително координация с международните системи на производителите и с митническата администрация.<!-- -->“</li><li>„<!-- -->Асоциацията на индустриалния капитал в България по принцип подкрепят промените, свързани с въвеждане на акциз върху леките автомобили с висока мощност и луксозен характер при определено коригиране на текстовете, но не подкрепят увеличението на санкциите, каквото е и становището на КРИБ, и акцизната ставка по § 14 от законопроекта.<!-- -->“</li><li>„<!-- -->Господин Владислав Горанов изрази притеснение във връзка с предложението за отменя на чл. 124а, 124б и 124в от ЗАДС, като счита, че този подход е неудачен, тъй като Агенция „Митници“ се лишава от един работещ инструмент.<!-- -->“</li><li>„<!-- -->Теменужка Петкова също изразява резерви към този подход на Министерството на финансите, като изтъква, че не може да се говори за прекомерност.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167628\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Цончо Ганев</b><span class=\"text-muted\"> (<!-- -->ВЪЗРАЖДАНЕ<!-- -->)</span>: „<!-- -->След като управляващите дойдоха на власт с обяснението, че няма да вдигат данъци, първите неща, които направиха, е да вдигат данъците – този бюджет е еманация на вдигането на данъци – вчера включително. И след малко продължава вдигането на данъци. Стигнаха дотам, че да продължат борбата срещу ракията в България! Меко казано, е обидно и цинично това нещо, но сега – да е ясно на тези, които слушат и гледат какво се…<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11196\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->12.11.2026</a></li><li><b>Костадин Ангелов</b><span class=\"text-muted\"> (<!-- -->ГЕРБ-СДС<!-- -->)</span>: „<!-- -->На 14 ноември отбелязваме Световния ден на диабета – на рождената дата на един от откривателите на инсулина, доктор Фредерик Бантинг, получил заедно с трима свои колеги Нобелова награда за медицина и физиология през 1923<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11196\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->12.11.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->КНСБ по ЗИД на ЗАДС-64; СпиритсБ-я по ЗИД на ЗАДС-64; НОМА по ЗИД на ЗАДС-64; БСК по ЗИД на ЗАДС-64; АИКБ по ЗИД на ЗАДС; Хоризонт Запад по ЗИД на ЗАДС-64; АТЕБ по ЗИД на ЗАДС-64<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167628\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167564\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Закона за акцизите и данъчните складове</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-149</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Поради това, временното прилагане на нулева акцизна ставка за природния газ и втечнения нефтен газ (LPG), използвани като моторно гориво, има за цел да ограничи данъчната компонента в цената на тези продукти и да създаде предпоставки за намаляване или ограничаване на нарастването на крайните цени.<!-- -->“</li><li>„<!-- -->Предвижда се мярката да има извънреден и строго ограничен във времето характер и да се прилага за периода от 1 октомври 2026 г. до 31 декември 2026 г.<!-- -->“</li><li>„<!-- -->Предлаганата мярка е временна, тъй като продължителното прилагане на нулево акцизно облагане би могло да доведе до значителна загуба на бюджетни приходи, да намали ценовите стимули за ограничаване на потреблението на изкопаеми горива и да създаде отклонение от дългосрочните цели в областта на енергийната и климатичната политика.<!-- -->“</li><li>„<!-- -->Основания за законодателна инициатива Законодателната инициатива е обусловена от необходимостта от предприемане на временни мерки за ограничаване на неблагоприятните икономически последици от същественото повишаване на цените на енергийните продукти и от нарушенията във веригите за доставка на нефт, нефтопродукти и природен газ, породени от геополитическата обстановка в Близкия изток и свързаната с нея несигурност на международните енергийни пазари.<!-- -->“</li><li>„<!-- -->Поради това временното прилагане на нулева акцизна ставка за природния газ и втечнения нефтен газ (СРС), използвани като моторно гориво, има за цел да ограничи данъчната компонента в цената на тези продукти и да създаде предпоставки за намаляване или ограничаване на нарастването на крайните цени.<!-- -->“</li><li>„<!-- -->Предвижда се мярката да има извънреден и строго ограничен във времето характер и да се прилага за периода от | октомври 2026 г. до 31 декември 2020 г.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167564\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Вносителят г-н Стефан Белчев посочи, че законодателната инициатива е обусловена от необходимостта от предприемане на временни мерки за ограничаване на неблагоприятните икономически последици от същественото повишаване на цените на енергийните продукти и от нарушенията във веригите за доставка на нефт, нефтопродукти и природен газ, породени от геополитическата обстановка в Близкия изток и свързаната с нея несигурност на международните енергийни пазари.<!-- -->“</li><li>„<!-- -->Министерството на енергетиката няма предложения за промени и подкрепя законопроекта.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167564\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#e08a2e] pl-4\"><p class=\"font-semibold mb-1\">В пленарната зала</p><ul class=\"space-y-2 text-[15px]\"><li><b>Мартин Димитров</b><span class=\"text-muted\"> (<!-- -->ДБ<!-- -->)</span>: „<!-- -->Намираме се в сериозна ситуация с цените на горивата. Видяхте тази седмица, че Европейската комисия обяви, че най-високият ръст на цените е в България в целия Европейски<!-- -->“ <a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11178\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm whitespace-nowrap\">стенограма, <!-- -->25.09.2026</a></li></ul></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->МИИИ по ЗИД на ЗАДС № 52-654-01-149; БПГА по ЗИД на ЗАДС № 52-654-01-149; М-во на енергетиката по ЗИД на ЗАДС - 149; МФ по ЗИД на ЗАДС - 149<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167564\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div></div></section><section id=\"mnenie\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Твоето мнение</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. <a href=\"/mnenie\">Всички закони за гласуване</a>.</p><div class=\"bg-surface rounded-sm p-5 text-[15px] text-muted\">Зарежда се…</div></section><section id=\"grupi\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласуваха групите по този закон</h2></div><p class=\"text-sm text-muted mb-3\">Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо <!-- -->10<!-- -->. Прието: <!-- -->10<!-- -->, отхвърлено: <!-- -->0<!-- -->.</p><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Прогресивна България</p><p class=\"num text-sm mt-1\">За: <b>10</b> · Против: <b>0</b> · общо <!-- -->10</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ГЕРБ – СДС</p><p class=\"num text-sm mt-1\">За: <b>1</b> · Против: <b>3</b> · общо <!-- -->10</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Демократична България</p><p class=\"num text-sm mt-1\">За: <b>8</b> · Против: <b>2</b> · общо <!-- -->10</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ДПС</p><p class=\"num text-sm mt-1\">За: <b>8</b> · Против: <b>2</b> · общо <!-- -->10</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Продължаваме промяната</p><p class=\"num text-sm mt-1\">За: <b>7</b> · Против: <b>2</b> · общо <!-- -->10</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Възраждане</p><p class=\"num text-sm mt-1\">За: <b>7</b> · Против: <b>3</b> · общо <!-- -->10</p></div></div><p class=\"text-sm mt-3\">Първо четене: <a href=\"/parlament/glasuvane/2026-09-25-20\">25 септември 2026 г.</a><a href=\"/parlament/glasuvane/2026-11-12-3\">12 ноември 2026 г.</a></p></section><section id=\"glasuvaniya\" class=\"scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Всички гласувания по закона</h2></div><ul><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-09-25-19\">Закона за акцизите и данъчните складове - първо гласуване - процедура за допускане в зала</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">25 септември 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: За · Демократична България: За · ДПС: За · Продължаваме промяната: Разделени · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-09-25-20\">Закона за акцизите и данъчните складове - първо гласуване</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">25 септември 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: Въздържал се · Демократична България: За · ДПС: За · Продължаваме промяната: За · Възраждане: За</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-09-25-21\">Закона за акцизите и данъчните складове - първо гласуване - процедура за второ гласуване</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">25 септември 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна Бълг