\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"167628\\\",{\\\"className\\\":\\\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted\\\",\\\"children\\\":\\\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mt-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167628\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"className\\\":\\\"text-ink\\\",\\\"children\\\":\\\"Законопроект за изменение и допълнение на Закона за акцизите и данъчните складове\\\"}],\\\" \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-muted num font-normal\\\",\\\"children\\\":[\\\"№ \\\",\\\"52-602-01-64\\\"]}]]}],[\\\"$\\\",\\\"details\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer font-semibold text-green mt-2\\\",\\\"children\\\":\\\"Покажи цитатите\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-5 mt-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-green pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Какво предлага законопроектът\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"В тази връзка предлаганите промени са: - въвеждане на акциз върху леките автомобили с цел осигуряване на по-справедливо и ефективно данъчно облагане на автомобилите с висока мощност и луксозен характер чрез отчитане на техните характеристики при формиране на данъчната тежест.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"Конфедерацията на независимите синдикати в България подкрепя предложението за въвеждането на акциз върху автомобили с мощност на двигателя над 250 киловата, като се изключват специализираните МПС (като линейки, противопожарни автомобили, автомобили със специален режим на движение) и електрическите автомобили и счита, че то отговаря на очакванията на обществото, и същевременно е източник за допълнителни приходи в хазната.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[\\\"„\\\",\\\"Подкрепят също и ограничаването на нелегалното разпространение на спиртни напитки (ракия), произведени в условията на облекчения режим за допустима семейна консумация, но обръщат внимание да бъде засилен контрола.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[\\\"„\\\",\\\"Конфедерацията на работодателите и индустриалците в България считат, че предложените промени в чл. 57а не уреждат достатъчно ясно режима за производители на електроенергия от ВЕИ с инсталирана мощност над 5 MW, които експлоатират колокирани съоръжения за съхранение, като е необходимо изрично да се уреди както регистрационният режим, така и акцизното третиране за тази категория лица и текстовете да се прецизират.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"children\\\":[\\\"„\\\",\\\"Господин Асен Василев приема, че предлаганите текстове относно предложеното изменение на чл. 100 от законопроекта, които имат за цел да прецизират режима за съхранение на етилов алкохол (ракия), произведен в регистрирани специализирани малки обекти за дестилиране, и създаване на ефективен механизъм за предотвратяване на нерегламентираната му реализация, не са адекватни на действителността.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"5\\\",{\\\"children\\\":[\\\"„\\\",\\\"Константин Проданов обърна внимание, че в случая, нерегламентираните производства на ракия застрашават живота и здравето на хората.\\\",\\\"“\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted mt-1\\\",\\\"children\\\":[\\\"Източник: \\\",\\\"$L2f\\\"]}]]}],\\\"$L30\\\",\\\"$L31\\\",\\\"$L32\\\",\\\"$L33\\\"]}]]}]]}],\\\"$L34\\\"]}]]}]\\n21:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"mnenie\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Твоето мнение\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":[\\\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \\\",[\\\"$\\\",\\\"$La\\\",null,{\\\"href\\\":\\\"/mnenie\\\",\\\"children\\\":\\\"Всички закони за гласуване\\\"}],\\\".\\\"]}],[\\\"$\\\",\\\"$L35\\\",null,{\\\"item\\\":\\\"aktsizite-i-danachnite-skladove\\\",\\\"question\\\":\\\"Подкрепяш ли последните промени в „Закон за акцизите и данъчните складове“?\\\"}]]}]\\n22:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"grupi\\\",\\\"className\\\":\\\"mb-12 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-end justify-between gap-4 mb-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2rem] sm:text-[2.4rem]\\\",\\\"children\\\":\\\"Как гласуваха групите по този закон\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted mb-3\\\",\\\"children\\\":[\\\"Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо \\\",10,\\\". Прието: \\\",10,\\\", отхвърлено: \\\",0,\\\".\\\"]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"ПБ\\\",{\\\"className\\\":\\\"border border-rule rounded-sm p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold\\\",\\\"children\\\":\\\"Прогресивна България\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"num tex