ildren\":[\"Държавата\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167620\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-169, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}],[\"$\",\"div\",null,{\"className\":\"grid sm:grid-cols-2 gap-px bg-rule mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-white px-4 py-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-[#2f7d57] mb-0.5\",\"children\":\"Печели\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"Повече контрол върху държавните ловни стопанства.\"}]]}],[\"$\",\"div\",null,{\"className\":\"bg-white px-4 py-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-red mb-0.5\",\"children\":\"Губи\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"Риск от дела за обезщетения.\"}]]}]]}]]}]]}]]}]\n28:[\"$\",\"div\",null,{\"className\":\"mt-8 text-sm\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Източници\"}],[\"$\",\"ol\",null,{\"className\":\"list-decimal pl-5 space-y-0.5\",\"children\":[[\"$\",\"li\",\"https://www.parliament.bg/bg/bills/ID/167620\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167620\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Народно събрание: законопроект № 52-654-01-169, доклади и становища\"}]}],[\"$\",\"li\",\"https://www.parliament.bg/bg/bills/ID/167622\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167622\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Народно събрание: законопроект № 52-654-01-171, доклади и становища\"}]}],[\"$\",\"li\",\"https://naiasno.bg/parliament\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://naiasno.bg/parliament\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Поименни гласувания, Народно събрание (чрез „Наясно“)\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-2\",\"children\":[\"Обобщението е по доклада на земеделската комисия. Рискът от дела е наш анализ. Ще обновим след второто четене.\",\" Проверено: \",\"19 ноември 2026 г.\"]}]]}]\n29:[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"От парламентарните групи на „Демократична България“ и „Възраждане“ заявиха, че ще подкрепят законопроекта, въпреки определени резерви относно възможността за предсрочно едностранно прекратяване на договорите.\",\"“\"]}]\n2a:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167622\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]\n2b:[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"МЗХ\",\". \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167622\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Текстовете в parliament.bg\"}]]}]\n2c:[\"$\",\"div\",\"167620\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167620\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за допълнение на Закона за лова и опазване на дивеча\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-654-01-169\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Със законопроекта се уреждат хипотезите и редът за предсрочно прекратяване на дългосрочните договори за съвместно извършване на дейности в държавните ловни стопанства.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Предлага се за държавните ловни стопанства „Воден - Ири Хисар“ и „Искър“, които се използват и за държавни представителни нужди, да не се сключват такива договори.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"МОТИВИ към проекта на Закон за допълнение на Закона за лова и опазване на дивеча Предложеният проект на Закон за допълнение на Закона за лова и опазване на дивеча (ЗЛОД) предвижда създаване на нов чл. да, който детайлно урежда хипотезите и реда за предсрочно прекратяване на договорите по чл. 9, ал. 12 за съвместно извършване на дейности с юридически лица.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"Освен основния им предмет на дейност законът предвижда тези две ловни стопанства да се използват за държавни представителни нужди и в тях да се осъществяват дейности по организация на официални мероприятия на най-високо държавно ниво.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"При съобразяване на специфичния статут на държавна представителност, който обуславя необходимостта да се гарантират съответните нива на сигурност, ведно с традиционното научно-академично значение на двете стопанства, се обосновава извод, че извършването на дейностите по чл. 9, ал. 9, т. 1-6 от ЗЛОД на територията на държавните ловни стопанства „Воден -- Ири Хисар“ и „Искър“ следва да бъде само от съответното държавно горско предприятие.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167620\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#8a8f8c] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Позиции, изказани в комисията\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Министерството на земеделието и храните подкрепя законопроекта.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167620\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],null,false,[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"МЗХ; \\\"Ловен комплекс Синаница\\\" ЕООД\",\". \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167620\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Текстовете в parliament.bg\"}]]}]]}]]}]]}]\n2d:[\"$\",\"div\",\"167604\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167604\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за лова и опазване на дивеча\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-602-01-51\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Подробно е регламентиран обхватът на информацията, която националното ловно сдружение ще следва да събира от ловните сдружения, които членуват в него.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Създава се възможност за служебно удостоверяване на информация относно сключените трудови договори със специалисти по ловно стопанство.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"За да се подобрят изискванията за упражняване на ловни практики, Изпълнителната агенция по горите като орган, който осъществява държавната политика в ловното стопанство, през годините отчита необходимост в административнонаказателните разпоредби на ЗЛОД да се регламентира разпоредба, съгласно която административнонаказващите органи да налагат административни наказания за други нарушения на глава IV и V от закона и на глава IV и V от Правилника за прилагането на закона.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"В Решение № 233 на Министерския съвет от 2024 г. за приемане на План за намаляване на административната тежест (Решение № 233) е включена мярка № 93, предвиждаща изменение в Закона за лова и опазване на дивеча относно служебното събиране на информация в съответствие с чл. 36г, ал. 4, т. 6, съгласно който всяко предложение на кандидат за стопанисване и ползване на дивеча в дивечовъден участък следва да съдържа копие от договорите на наетите специалисти по чл. 36а, ал. 1, т. 7.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167604\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],null,null,false,[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"Даниел Топалов\",\". \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167604\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Текстовете в parliament.bg\"}]]}]]}]]}]]}]\n2e:[\"$\",\"div\",\"167515\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167515\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за лова и опазване на дивеча\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-654-01-119\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Към момента законът предвижда, че правото на ловуване се упражнява от лица, които притежават членска карта и билет за лов, заверени за съответната календарна година, както и разрешително за лов.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Билетът за лов се издава и заверява ежегодно от съответното държавно горско или държавно ловно стопанство, като законът вече предвижда поддържането на публичен национален електронен регистър на издадените билети за лов.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Предвижда се електронният билет за лов да има същата правна сила като билета, издаден на хартиен носител, като валидността на билета и на ежегодната заверка се удостоверява. чрез публичния национален електронен регистър на издадените билети за лов.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"Целта е да се модернизира действащият режим, да се намали административната тежест за гражданите и да се улесни контролът върху валидността на документите, необходими за упражняване на правото на ловуване.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167515\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],null,[\"$\",\"div\",null,{\"className\":\"border-l-4 border-red pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Възражения и критики\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Министерството на земеделието и храните не подкрепя законопроекта.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167515\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],false,[