parliament.bg\"}]]}]]}]\n35:[\"$\",\"div\",null,{\"className\":\"border-l-4 border-[#e08a2e] pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"В пленарната зала\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"b\",null,{\"children\":\"Румен Младенов\"}],null,\": „\",\"На основание чл. 87, ал. 1 от Конституцията Министерският съвет е внесъл за разглеждане Проект на закон за изменение и допълнение на Закона за държавните резерви и военновременните запаси. Съгласно чл. 7, ал. 2, т. 3 от действащия закон председателят на Държавна агенция „Държавен резерв и военновременни запаси“ организира съхранението на техническа документация от български разработки и лицензионна техническа…\",\"“ \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11184\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm whitespace-nowrap\",\"children\":[\"стенограма, \",\"08.10.2026\"]}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"b\",null,{\"children\":\"Христо Гаджев\"}],[\"$\",\"span\",null,{\"className\":\"text-muted\",\"children\":[\" (\",\"ГЕРБ-СДС\",\")\"]}],\": „\",\"Този законопроект, който разглеждаме в момента и който най-вероятно ще получи подкрепата от „Прогресивна България“, е, от една страна, лобистки, но от друга страна, е опасен. Бих могъл да го кръстя на луканката на завода, за който се прави… на която е кръстена на завода, за който се прави, но докато изключим чисто частнофирмения интерес, заради който се прави и тази поправка – това не е, между другото, първи опит, и…\",\"“ \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11184\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-sm whitespace-nowrap\",\"children\":[\"стенограма, \",\"08.10.2026\"]}]]}]]}]]}]\n36:[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени ста