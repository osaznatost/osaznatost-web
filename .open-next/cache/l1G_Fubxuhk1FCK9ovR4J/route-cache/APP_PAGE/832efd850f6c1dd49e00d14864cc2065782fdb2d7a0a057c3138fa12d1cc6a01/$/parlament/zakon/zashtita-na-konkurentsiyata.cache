ame\":\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm mb-4\",\"children\":[\"$\",\"$La\",null,{\"href\":\"/parlament\",\"children\":[\"← \",\"Парламент\"]}]}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-green font-semibold mb-2\",\"children\":\"Закон\"}],[\"$\",\"h1\",null,{\"className\":\"display text-5xl sm:text-7xl max-w-4xl\",\"children\":\"Закон за защита на конкуренцията\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-lg text-muted max-w-3xl\",\"children\":\"Приет окончателно на 11.06.2026 г., обнародван в ДВ, бр. 58/2026\"}]]}]}],[\"$\",\"nav\",null,{\"aria-label\":\"Секции на страницата\",\"className\":\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\",\"children\":[\"$\",\"ul\",null,{\"className\":\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\",\"children\":[[\"$\",\"li\",\"nakratko\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#nakratko\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Накратко\"}]}],[\"$\",\"li\",\"signali\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#signali\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Сигнали (2)\"}]}],[\"$\",\"li\",\"zakonoproekti\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#zakonoproekti\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Кой внесе и кой се изказа\"}]}],[\"$\",\"li\",\"argumenti\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#argumenti\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Двете страни\"}]}],[\"$\",\"li\",\"mnenie\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#mnenie\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Твоето мнение\"}]}],[\"$\",\"li\",\"grupi\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#grupi\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Как гласуваха\"}]}],[\"$\",\"li\",\"glasuvaniya\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#glasuvaniya\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Гласувания (25)\"}]}]]}]}],[\"$\",\"section\",null,{\"id\":\"nakratko\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Накратко\"}],\"$undefined\",[\"$\",\"div\",null,{\"className\":\"max-w-4xl\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[17px]\",\"children\":\"Законът разширява списъка на нелоялните търговски практики по веригата на храните: едностранно налагане на цени и такси, такси за „предлагане“ на продукт, последващи и ретроактивни бонуси, прехвърляне на търговския риск върху доставчика, скрити плащания при формиране на цената, изваждане от асортимента или замяна със собствена марка на търговеца. Такива практики са допустими само ако са договорени писмено предварително и срещу реална услуга. При обосновано съмнение Комисията за защита на конкуренцията може да задължи купувача да докаже, че практиката му не е нелоялна. Въвежда се електронен регистър за проследимост по веригата на доставки и възможност КЗК да санкционира „прекомерно високи цени“ при господстващо положение, както и временни мерки.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Вносители:\"}],\" \",\"Явор Гечев, Олга Борисова, Михаела Доцова и др. („Прогресивна България“)\",[\" · \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167003\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"законопроект \",\"52-654-01-38\"]}]]]}],\"$L1b\"]}]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$L22\"]}]\n23:I[32466,[\"$2\",\"$9\"],\"Term\"]\n2f:I[52368,[\"$2\",\"$9\"],\"CitizenVote\"]\n1b:[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Какво се случи:\"}],\" \",\"Първо четене на 13.05.2026 г. (148 „за“, ПП против, ДБ и „Възраждане“ въздържали се, ГЕРБ–СДС не гласуваха); срокът за предложения беше удължен с една седмица. На второ четене (11.06.2026 г.) приет със 106 „за“, 3 „против“ и 11 „въздържал се“. В бюджетната комисия: 17 „за“ (ПБ, ДПС, по един от ГЕРБ–СДС и „Възраждане“), 2 „против“ (ПП), 2 „въздържал се“ (ДБ).\"]}]\n1c:[\"$\",\"section\",null,{\"id\":\"signali\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Сигнали\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.\"}],[[\"$\",\"ul\",null,{\"className\":\"grid gap-3 md:grid-cols-2 max-w-5xl\",\"children\":[[\"$\",\"li\",\"3 нови текста, приети на второ четене\",{\"className\":\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"3 нови текста, приети на второ четене\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Текстове, които ги нямаше в първоначалния законопроект. Обикновено са поправки, но могат и да променят смисъла.\"}]]}],[\"$\",\"li\",\"Внесен от депутати\",{\"className\":\"border-l-4 rounded-sm p-4 border-rule bg-surface\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Внесен от депутати\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Законопроектите на депутати не минават през задължителното 30-дневно обществено обсъждане на strategy.bg, както тези на Министерския съвет, и често нямат подробна оценка на въздействието.\"}]]}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3\",\"children\":[\"$\",\"$La\",null,{\"href\":\"/parlament/signali\",\"children\":\"Всички сигнали в парламента\"}]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-2\",\"children\":[\"Сигналът е повод за въпрос, не доказателство за нарушение.\",\" \",[\"$\",\"$La\",null,{\"href\":\"/metodologiya#signal\",\"className\":\"underline\",\"children\":\"Как работим със сигналите\"}]]}]]]}]\n1d:[\"$\",\"section\",null,{\"id\":\"zakonoproekti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Кой внесе и кой се изказа\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.\"}],[[\"$\",\"ul\",null,{\"className\":\"space-y-4 max-w-5xl\",\"children\":[[\"$\",\"li\",\"167003\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167003\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за защита на конкуренцията\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-654-01-38\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"11 май 2026 г.\",\" от \",\"Явор Гечев, Олга Борисова, Михаела Доцова и още 20 депутати\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по бюджет и финанси (водеща)\"}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Становища\"}],[\"$\",\"dd\",null,{\"children\":\"МИИИ по ЗИД на ЗЗК, № 52-654-01-38; МЗХ по ЗИД на ЗЗК, № 52-654-01-38; КНСБ  по ЗИД на ЗЗК, № 52-654-01-38; BESCO по ЗИД на ЗЗК и ЗИД на ЗЗП; СпиритсБългария по ЗИД на ЗЗК-38; Храни и напитки по ЗИД на ЗЗК-38; Адв. Весела Андонова по ЗИД на ЗЗК-38; Асоциация на свиневъдите по ЗИД на ЗЗК; Асоциация застрахователи по ЗИД на ЗЗК-38; Съюз на птицевъдите по ЗИД на ЗЗК-38 и ЗИД на ЗЗП-36; Американска търговска камара по ЗИД на ЗЗК-38; Асоциация млекопреработватели по ЗИД на ЗЗК-38\"}]],false,false,false,[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Предложения\"}],[\"$\",\"dd\",null,{\"children\":[4,\" писмени предложения на депутати между \",[\"$\",\"$L23\",null,{\"k\":\"parvo-chetene\",\"children\":\"първо\"}],\" и \",[\"$\",\"$L23\",null,{\"k\":\"vtoro-chetene\",\"children\":\"второ четене\"}]]}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"В залата\"}],[\"$\",\"dd\",null,{\"children\":[[\"$\",\"span\",\"0\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11124\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"13 май 2026 г.\"}],\" (\",\"зала първо гласуване\",\")\"]}],[\"$\",\"span\",\"1\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11137\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"11 юни 2026 г.\"}],\" (\",\"зала второ гласуване\",\")\"]}]]}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Обнародван\"}],[\"$\",\"dd\",null,{\"children\":[\"ДВ, бр. 58/2026\",\", приет на 11 юни 2026 г.\"]}]]]}]]}]]}],false]]}]\n1e:[\"$\",\"div\",null,{\"id\":\"argumenti\",\"className\":\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-2 mt-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-green bg-surface\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Мотивите на вносителите\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Явор Гечев (вносител)Целта не е администр\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Явор Гечев (вносител)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Целта не е административно регулиране на цените: законът не въвежда ценови тавани, а ограничава нелоялните практики, за да има реална конкуренция и по-справедливо разпределение на добавената стойност по веригата.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167003\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-38, доклад на бюджетната комисия и 12 становища (КНСБ, AmCham, браншови съюзи и др.)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"ВносителитеОбърнатата доказател\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Вносителите\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Обърнатата доказателствена тежест е нужна, защото информацията за реалните бонуси, такси и критерии за позициониране е у купувача (търговеца), а не у доставчика.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167003\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-38, доклад на бюджетната комисия и 12 становища (КНСБ, AmCham, браншови съюзи и др.)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"ВносителитеРегистърът няма да д\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Вносителите\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Регистърът няма да добави тежест, а ще замени подаването на една и съща информация към няколко институции.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167003\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-38, доклад на бюджетната комисия и 12 становища (КНСБ, AmCham, браншови съюзи и др.)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Какво казват критиците\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Работодателските и синдикалните организацииЗаконопроектът трябв\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Работодателските и синдикалните организации\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Законопроектът трябва да мине през Националния съвет за тристранно сътрудничество.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167003\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-38, доклад на бюджетната комисия и 12 становища (КНСБ, AmCham, браншови съюзи и др.)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Работодателските организацииОбърнатата доказател\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Работодателските организации\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Обърнатата доказателствена тежест и делегирането на Министерския съвет да определя с наредби още практики при господстващо положение създават правна несигурност; регистърът увеличава административната тежест; терминологията е неясна.\",\"$L24\"]}]]}],\"$L25\"]}]]}]]}],null,\"$L26\",\"$L27\",null,\"$L28\"]}]\n1f:[\"$\",\"section\",null,{\"id\":\"dokumenti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Още от документите\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 max-w-4xl\",\"children\":[[\"$\",\"div\",\"167003\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167003\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за изменение и допълнение на Закона за защита на конкуренцията\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-654-01-38\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Той не гарантира административно намаляване на цените, тъй като не въвежда ценови тавани.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Въвежда се по-строга рамка за допустимост на определени практики.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Създава се електронен централен регистър за проследимост по веригата за доставки, който има няколко функции: ● проследимост на движението на продукти и суровини; ● създаване на информационна база за секторни анализи; ● подпомагане на компетентните органи; ● ранно установяване на индикатори за пазарни деформации, нелоялни търговски практики, нарушения на конкуренцията, потребителски, данъчни, митнически, санитарни и фитосанитарни нарушения.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"С въвеждането на единна електронна точка за подаване институциите ще могат да получават необходимата информация автоматично по компетентност.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Със законопроекта се въвежда уредба на прекомерно високите продажни цени само когато са налице господстващо или съвместно господстващо положение.\",\"“\"]}],[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"Целта е да се предотврати продължаване на вредно поведение, когато съществува риск от сериозно или трудно поправимо увреждане на конкуренцията.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167003\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],null,[\"$\",\"div\",null,{\"className\":\"border-l-4 border-red pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Възражения и критики\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Чрез намаляване на нелоялни практики и изкривявания се очаква ценови ефект, който да се прояви чрез по-реална конкуренция и ограничаване на възможностите за необосновано задържане на добавена стойност в отделни звена от веригата.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Със законопроекта се предвижда възможност Комисията за защита на конкуренцията при обосновани съмнения или данни за нелоялна търговска практика, да задължи купувача да представи доказателства, че неговата практика не е нелоялна, тъй като информацията за реалните финансови потоци, вътрешни условия, бонуси, компенсации, търговски планове и критерии за позициониране обикновено се намира у купувача.\",\"“\"]}],\"$L29\",\"$L2a\",\"$L2b\"]}],\"$L2c\"]}],\"$L2d\",\"$L2e\"]}]]}]]}]]}]]}]\n20:[\"$\",\"section\",null,{\"id\":\"mnenie\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Твоето мнение\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":[\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \",[\"$\",\"$La\",null,{\"href\":\"/mnenie\",\"children\":\"Всички закони за гласуване\"}],\".\"]}],[\"$\",\"$L2f\",null,{\"item\":\"zashtita-na-konkurentsiyata\",\"question\":\"Подкрепяш ли последните промени в „Закон за защита на конкуренцията (нелоялни търговски практики и „прекомерно високи цени“)“?\"}]]}]\n21:[\"$\",\"section\",null,{\"id\":\"grupi\",\"className\":\"mb-12 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb-5\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] sm: