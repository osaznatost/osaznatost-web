\\\":\\\"space-y-5 mt-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-green pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Какво предлага законопроектът\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"Той не гарантира административно намаляване на цените, тъй като не въвежда ценови тавани.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"Въвежда се по-строга рамка за допустимост на определени практики.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[\\\"„\\\",\\\"Създава се електронен централен регистър за проследимост по веригата за доставки, който има няколко функции: ● проследимост на движението на продукти и суровини; ● създаване на информационна база за секторни анализи; ● подпомагане на компетентните органи; ● ранно установяване на индикатори за пазарни деформации, нелоялни търговски практики, нарушения на конкуренцията, потребителски, данъчни, митнически, санитарни и фитосанитарни нарушения.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[\\\"„\\\",\\\"С въвеждането на единна електронна точка за подаване институциите ще могат да получават необходимата информация автоматично по компетентност.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"children\\\":[\\\"„\\\",\\\"Със законопроекта се въвежда уредба на прекомерно високите продажни цени само когато са налице господстващо или съвместно господстващо положение.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"5\\\",{\\\"children\\\":[\\\"„\\\",\\\"Целта е да се предотврати продължаване на вредно поведение, когато съществува риск от сериозно или трудно поправимо увреждане на конкуренцията.\\\",\\\"“\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted mt-1\\\",\\\"children\\\":[\\\"Източник: \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167003\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":\\\"доклад на комисията и мотиви, parliament.bg\\\"}]]}]]}],null,[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-l-4 border-red pl-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold mb-1\\\",\\\"children\\\":\\\"Възражения и критики\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"Чрез намаляване на нелоялни практики и изкривявания се очаква ценови ефект, който да се прояви чрез по-реална конкуренция и ограничаване на възможностите за необосновано задържане на добавена стойност в отделни звена от веригата.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"Със законопроекта се предвижда възможност Комисията за защита на конкуренцията при обосновани съмнения или данни за нелоялна търговска практика, да задължи купувача да представи доказателства, че неговата практика не е нелоялна, тъй като информацията за реалните финансови потоци, вътрешни условия, бонуси, компенсации, търговски планове и критерии за позициониране обикновено се намира у купувача.\\\",\\\"“\\\"]}],\\\"$L29\\\",\\\"$L2a\\\",\\\"$L2b\\\"]}],\\\"$L2c\\\"]}],\\\"$L2d\\\",\\\"$L2e\\\"]}]]}]]}]]}]]}]\\n20:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"mnenie\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Твоето мнение\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":[\\\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \\\",[\\\"$\\\",\\\