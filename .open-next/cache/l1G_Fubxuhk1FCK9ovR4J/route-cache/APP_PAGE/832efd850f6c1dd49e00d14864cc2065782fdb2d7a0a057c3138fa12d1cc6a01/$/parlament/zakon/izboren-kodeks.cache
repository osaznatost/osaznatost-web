\":\\\"text-[15px]\\\",\\\"children\\\":\\\"По-ясни правила за мнозинство в ЦИК и за местните коалиции.\\\"}]\\n41:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"bg-white px-4 py-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs font-semibold text-red mb-0.5\\\",\\\"children\\\":\\\"Губи\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px]\\\",\\\"children\\\":\\\"По-малко време за подготовка, защото правилата се сменят месеци преди избори.\\\"}]]}]\\n42:[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-1.5 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[\\\"„\\\",\\\"Г-н Красимир Терзиев и г-н Стефан Арсов посочиха, че разглеждането на промените в Изборния кодекс е непосредствено преди изборите за президент и вицепрезидент, което противоречи на препоръките и добрите практики на Венецианска комисия и ОССЕ.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[\\\"„\\\",\\\"Той допълни, че подкрепят значителна част от предложенията в законопроекта на ПГ „Възраждане“, но не са съгласни с начина на предлагане на преброяване на бюлетините от машинното гласуване.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[\\\"„\\\",\\\"Относно предложения законопроект на ПГ „Прогресивна България“, г-н Стоев подчерта, че ще го подкрепят с известни резерви, тъй като не са съгласни с отпадането на район „Чужбина“.\\\",\\\"“\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[\\\"„\\\",\\\"Г-н Иван Вачев посочи, че законопроектът на ПГ „Възраждане“ не може да бъде подкрепен към настоящия момент, тъй като се съдържат предложения, които следва да бъдат поставени на широк обществен дебат с представители на всички институции, неправителствени организации и академичната общност, като към този момент фокусът е само за неотложни промени по Изборния кодекс.\\\",\\\"“\\\"]}]]}]\\n43:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted mt-1\\\",\\\"c