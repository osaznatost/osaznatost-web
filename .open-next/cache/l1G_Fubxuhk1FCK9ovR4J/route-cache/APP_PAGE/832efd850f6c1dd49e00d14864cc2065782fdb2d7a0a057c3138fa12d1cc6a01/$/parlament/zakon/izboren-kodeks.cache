{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/parlament/layout,_N_T_/parlament/zakon/layout,_N_T_/parlament/zakon/[slug]/layout,_N_T_/parlament/zakon/[slug]/page,_N_T_/parlament/zakon/izboren-kodeks"},"segmentPaths":["/_tree","/_full","/parlament/zakon/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/832efd850f6c1dd49e00d14864cc2065782fdb2d7a0a057c3138fa12d1cc6a01/$/parlament/zakon/izboren-kodeks","owner":{"kind":"APP_PAGE","sourceRoute":"/parlament/zakon/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2bx3suebn7wim.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><script src=\"/_next/static/chunks/43gzry38n6x69.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Изборен кодекс · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Изборен кодекс · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Изборен кодекс · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/parlament\">← <!-- -->Парламент</a></p><p class=\"text-[15px] text-green font-semibold mb-2\">Закон</p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Изборен кодекс</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Приет окончателно на 30.07.2026 г., обнародван в ДВ, бр. 71/2026</div></div></div><nav aria-label=\"Секции на страницата\" class=\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\"><ul class=\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\"><li><a href=\"#nakratko\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Накратко</a></li><li><a href=\"#signali\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Сигнали (2)</a></li><li><a href=\"#zakonoproekti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Кой внесе и кой се изказа</a></li><li><a href=\"#argumenti\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Двете страни</a></li><li><a href=\"#mnenie\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Твоето мнение</a></li><li><a href=\"#grupi\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Как гласуваха</a></li><li><a href=\"#glasuvaniya\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Гласувания (131)</a></li></ul></nav><section id=\"nakratko\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Накратко</h2><div class=\"max-w-4xl\"><p class=\"text-[17px]\">Промените са приети няколко месеца преди президентските избори. Основната тема е начинът на гласуване: проектите на управляващите и на ПП–ДБ връщат машинното гласуване като основен начин, с контролно преброяване на разписките от машините, а проектът на „Прогресивна България“ оставя хартиени бюлетини само по изключение (напр. в секции под 300 избиратели). Втората тема са секциите в чужбина: няколко проекта предлагаха да отпадне ограничението до 20 секции извън посолствата в държави извън ЕС. Обсъждани бяха и правилата за ЦИК (решения с мнозинство над половината от членовете), ограничения за членове на секционните комисии и скенери за личните карти в секциите.</p><p class=\"mt-3 text-[15px]\"><b>Вносители:</b> <!-- -->Общ законопроект на правната комисия от четири проекта: на Николета Тодорова и др. („Прогресивна България“), на Надежда Йорданова и др. (ДБ), на Стою Стоев и др. (ПП) и на Делян Пеевски и др. (ДПС)<!-- --> · <a href=\"https://www.parliament.bg/bg/bills/ID/167202\" target=\"_blank\" rel=\"noreferrer\">законопроект <!-- -->52-653-02-6</a></p><p class=\"mt-3 text-[15px]\"><b>Какво се случи:</b> <!-- -->На първо четене (16.07.2026) парламентът подкрепи проектите на „Прогресивна България“, ДБ, ПП и два проекта на ДПС, а отхвърли проекта на „Възраждане“ (изцяло машинно гласуване с бюлетина в прозрачна кутия) и проекта на ДПС за отпадане на уседналостта. ГЕРБ–СДС гласуваха против всички. Преди второто четене „Прогресивна България“ оттегли спорните си предложения, сред тях ограничаването на агитацията в личните профили в социалните мрежи. Заключителните разпоредби бяха приети със 163 „за“ и 13 „против“ („Възраждане“).</p></div></section><section id=\"signali\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Сигнали</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.</p><ul class=\"grid gap-3 md:grid-cols-2 max-w-5xl\"><li class=\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\"><p class=\"font-semibold\">7 нови текста, приети на второ четене</p><p class=\"text-[15px] text-muted mt-1\">Текстове, които ги нямаше в първоначалния законопроект. Обикновено са поправки, но могат и да променят смисъла.</p></li><li class=\"border-l-4 rounded-sm p-4 border-rule bg-surface\"><p class=\"font-semibold\">Внесен от депутати</p><p class=\"text-[15px] text-muted mt-1\">Законопроектите на депутати не минават през задължителното 30-дневно обществено обсъждане на strategy.bg, както тези на Министерския съвет, и често нямат подробна оценка на въздействието.</p></li></ul><p class=\"text-sm mt-3\"><a href=\"/parlament/signali\">Всички сигнали в парламента</a></p><p class=\"text-xs text-muted mt-2\">Сигналът е повод за въпрос, не доказателство за нарушение.<!-- --> <a class=\"underline\" href=\"/metodologiya#signal\">Как работим със сигналите</a></p></section><section id=\"zakonoproekti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Кой внесе и кой се изказа</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.</p><ul class=\"space-y-4 max-w-5xl\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167581\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Изборния кодекс</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-156</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>2 октомври 2026 г.<!-- --> от <!-- -->Цончо Ганев, Петър Петров, Димо Дренчев и още 5 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">Становища</dt><dd>Камара на счетоводителите в Република България относно законопроект за изменение и допълнение на Изборния кодекс, № 52-654-01-156, внесен от Цончо Томов Ганев и група народни представители на 2.10.2026 г.</dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167202\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Изборния кодекс</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-653-02-6</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>16 юли 2026 г.<!-- --> от <!-- -->депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">Становища</dt><dd>Институт за развитие на публичната среда относно общ законопроект за изменение и допълнение на Изборния кодекс, № 52-653-02-6 от 16.07.2026 г.; Мария Феркова относно общ законопроект за изменение и допълнение на Изборния кодекс, № 52-653-02-6 от 16.07.2026 г.; Омбудсман на Република България относно общ законопроект за изменение и допълнение на Изборния кодекс, № 52-653-02-6 от 16.07.2026 г.; Обществен съвет към Централната избирателна комисия относно общ законопроект за изменение и допълнение на Изборния кодекс, № 52-653-02-6 от 16.07.2026 г.; Министерството на външните работи относно общ законопроект за изменение и допълнение на Изборния кодекс, № 52-653-02-6 от 16.07.2026 г.; Сдружение &quot;Будни хора&quot; относно общ законопроект за изменение и допълнение на Изборния кодекс, № 52-653-02-6 от 16.07.2026 г.; Министерството на вътрешните работи по § 34 относно общ законопроект за изменение и допълнение на Изборния кодекс, № 52-653-02-6 от 16.07.2026 г.</dd><dt class=\"text-muted\">Предложения</dt><dd>6<!-- --> писмени предложения на депутати между <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">първо</button></span> и <span class=\"relative inline\"><button type=\"button\" aria-expanded=\"false\" class=\"underline decoration-dotted decoration-1 underline-offset-[3px] cursor-help text-inherit font-inherit\">второ четене</button></span></dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11158\" target=\"_blank\" rel=\"noreferrer\">30 юли 2026 г.</a> (<!-- -->зала второ гласуване<!-- -->)</span></dd><dt class=\"text-muted\">Обнародван</dt><dd>ДВ, бр. 71/2026<!-- -->, приет на 30 юли 2026 г.</dd></dl></li></ul><details class=\"mt-3 max-w-5xl\"><summary class=\"cursor-pointer font-semibold text-green py-2\">Още <!-- -->6<!-- --> законопроекта по този закон</summary><ul class=\"space-y-4 mt-2\"><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167174\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Изборния кодекс</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-80</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>7 юли 2026 г.<!-- --> от <!-- -->Николета Тодорова, Елена Нонева, Силвия Христова и още 10 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11152\" target=\"_blank\" rel=\"noreferrer\">16 юли 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167173\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Изборния кодекс</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-79</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>7 юли 2026 г.<!-- --> от <!-- -->Стою Стоев, Николай Денков, Богдан Богданов и още 8 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11152\" target=\"_blank\" rel=\"noreferrer\">16 юли 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167171\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Изборния кодекс</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-78</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>6 юли 2026 г.<!-- --> от <!-- -->Костадин Костадинов, Петър Петров</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">Становища</dt><dd>Сдружение „Гражданска платформа“ относно законопроект за изменение и допълнение на Изборния кодекс, № 52-654-01-78, внесен от Костадин Тодоров Костадинов и Петър Николаев Петров на 6.07.2026 г.</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11152\" target=\"_blank\" rel=\"noreferrer\">16 юли 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167124\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Изборния кодекс</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-70</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>18 юни 2026 г.<!-- --> от <!-- -->Делян Пеевски, Айтен Сабри, Атидже Алиева-вели и още 16 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">Становища</dt><dd>Сдружение „Гражданска платформа“ относно законопроект за изменение и допълнение на Изборния кодекс, № 52-654-01-70, внесен от Делян Славчев Пеевски и група народни представители на 18.06.2026 г.</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11152\" target=\"_blank\" rel=\"noreferrer\">16 юли 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/167017\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение и допълнение на Изборния кодекс</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-45</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>22 май 2026 г.<!-- --> от <!-- -->Надежда Йорданова, Божидар Божанов, Катя Панева и още 14 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">Становища</dt><dd>Сдружение &quot;Будни хора&quot; по законопроект за изменение и допълнение на Изборния кодекс, № 52-654-01-45, внесен от Надежда Георгиева Йорданова и група народни представители на 22.05.2026 г.; Сдружение „Гражданска платформа“ относно законопроект за изменение и допълнение на Изборния кодекс, № 52-654-01-45, внесен от Надежда Георгиева Йорданова и група народни представители на 22.05.2026 г.</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11152\" target=\"_blank\" rel=\"noreferrer\">16 юли 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li><li class=\"ring-1 ring-rule rounded-sm bg-white p-4\"><div class=\"flex flex-wrap justify-between gap-2\"><a href=\"https://www.parliament.bg/bg/bills/ID/166943\" target=\"_blank\" rel=\"noreferrer\" class=\"font-semibold text-ink\">Законопроект за изменение на Изборния кодекс</a><span class=\"text-sm text-muted num whitespace-nowrap\">№ <!-- -->52-654-01-6</span></div><dl class=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\"><dt class=\"text-muted\">Внесен</dt><dd>30 април 2026 г.<!-- --> от <!-- -->Делян Пеевски, Айтен Сабри, Хамид Хамид и още 18 депутати</dd><dt class=\"text-muted\">Комисии</dt><dd>Комисия по правни въпроси (водеща)</dd><dt class=\"text-muted\">Становища</dt><dd>Сдружение „Гражданска платформа“ относно законопроект за изменение на Изборния кодекс, № 52-654-01-6, внесен от Делян Славчев Пеевски и група народни представители на 30.04.2026 г.</dd><dt class=\"text-muted\">В залата</dt><dd><span><a href=\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11152\" target=\"_blank\" rel=\"noreferrer\">16 юли 2026 г.</a> (<!-- -->зала първо гласуване<!-- -->)</span></dd></dl></li></ul></details></section><div id=\"argumenti\" class=\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\"><div class=\"grid gap-4 md:grid-cols-2 mt-8\"><div class=\"p-5 rounded-sm border-t-4 border-green bg-surface\"><h3 class=\"display text-[1.6rem] mb-3\">Мотивите на вносителите</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Надежда Йорданова (ДБ)</p><p class=\"text-[15px]\">Машинното гласуване трябва да се върне в пълния си вид, като секционните комисии преброяват и контролните разписки; ограничението за секции извън ЕС трябва да отпадне.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167174\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-80 и доклад за първо гласуване на правната комисия (08.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.bta.bg/en/news/1163718-election-code-reform-push-reopens-debate-on-machine-voting-polling-abroad\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: дебатът за машинното гласуване и секциите в чужбина\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Стою Стоев (ПП)</p><p class=\"text-[15px]\">Анализ на ЦИК от 2022 г. показва, че разликите при машинното гласуване идват от човешки грешки, а не от машините. Решенията на ЦИК да се приемат с мнозинство над половината, за да не може комисията да бъде блокирана.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167174\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-80 и доклад за първо гласуване на правната комисия (08.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.bta.bg/en/news/1163718-election-code-reform-push-reopens-debate-on-machine-voting-polling-abroad\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: дебатът за машинното гласуване и секциите в чужбина\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Янка Тянкова („Прогресивна България“)</p><p class=\"text-[15px]\">Предлага отпадане на хартиените бюлетини и изцяло машинно гласуване, с изключение на малките секции.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167174\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-80 и доклад за първо гласуване на правната комисия (08.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Хамид Хамид (ДПС)</p><p class=\"text-[15px]\">Ограничението до 20 секции извън посолствата в държави извън ЕС ограничава избирателите в чужбина и трябва да отпадне.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167174\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-80 и доклад за първо гласуване на правната комисия (08.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p></li></ul></div><div class=\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\"><h3 class=\"display text-[1.6rem] mb-3\">Какво казват критиците</h3><ul class=\"space-y-3\"><li><p class=\"text-sm font-semibold\">Стефан Арсов (ГЕРБ–СДС)</p><p class=\"text-[15px]\">Смесената система (хартия и машини) работи и трябва да се запази; връщането към изцяло машинно гласуване не е нужно.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.bta.bg/en/news/1163718-election-code-reform-push-reopens-debate-on-machine-voting-polling-abroad\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: дебатът за машинното гласуване и секциите в чужбина\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Петър Петров („Възраждане“)</p><p class=\"text-[15px]\">Подкрепя изцяло машинно гласуване, но е против изключенията за малките секции и против премахването на ограничението за секции извън ЕС (заради Турция). Според него хартиените бюлетини позволяват масови нарушения.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167174\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-80 и доклад за първо гласуване на правната комисия (08.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.bta.bg/en/news/1163718-election-code-reform-push-reopens-debate-on-machine-voting-polling-abroad\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: дебатът за машинното гласуване и секциите в чужбина\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p></li><li><p class=\"text-sm font-semibold\">Граждански организации и опозицията</p><p class=\"text-[15px]\">Предложенията за ограничаване на агитацията в личните профили в социалните мрежи бяха критикувани като намеса в свободата на изразяване; „Прогресивна България“ ги оттегли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2026/07/28/4940316_mashinite_sa_izcialo_reabilitirani_za_prezidentskite/\" target=\"_blank\" rel=\"noreferrer\" title=\"Капитал: „Машините са изцяло реабилитирани за президентските избори“ (28.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->4<!-- -->]</a></span></p></li></ul></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Двете страни на монетата</h3><p class=\"text-sm text-muted mb-3\">Какво следва на практика, ако законът се приеме и ако се отхвърли.<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167174\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-80 и доклад за първо гласуване на правната комисия (08.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.bta.bg/en/news/1163718-election-code-reform-push-reopens-debate-on-machine-voting-polling-abroad\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: дебатът за машинното гласуване и секциите в чужбина\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\"><p class=\"font-semibold\">Ако се приеме</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Машинното гласуване, което дава по-малко недействителни бюлетини, става основен начин.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Контролното преброяване на разписките позволява проверка на машините.</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Промени в изборните правила малко преди избори затрудняват подготовката на ЦИК и администрацията.</li><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Спорът за сигурността на машините и сертифицирането на софтуера остава.</li></ul></div></div></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#d2353f]\"><p class=\"font-semibold\">Ако се отхвърли</p><div class=\"space-y-2 mt-3\"><div><p class=\"text-xs font-semibold text-[#2f7d57]\">Добрата страна</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;+&#x27;] before:absolute before:left-0 before:font-bold\">Запазва се познатата смесена система (хартия и машини).</li></ul></div><div><p class=\"text-xs font-semibold text-red\">Рискът и цената</p><ul class=\"list-none pl-0 space-y-1\"><li class=\"text-[15px] pl-4 relative before:content-[&#x27;−&#x27;] before:absolute before:left-0 before:font-bold\">Повече недействителни бюлетини и по-бавно броене при хартиеното гласуване.</li></ul></div></div></div></div></div><div class=\"mt-8\"><h3 class=\"display text-[1.8rem] mb-1\">Какво печели и какво губи всяка страна</h3><p class=\"text-sm text-muted mb-3\">Едно решение помага на едни и тежи на други. Тук ги показваме една до друга.</p><div class=\"space-y-3\"><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Избирателите в страната<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167174\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-80 и доклад за първо гласуване на правната комисия (08.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.bta.bg/en/news/1163718-election-code-reform-push-reopens-debate-on-machine-voting-polling-abroad\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: дебатът за машинното гласуване и секциите в чужбина\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Машините дават по-малко недействителни бюлетини и резултат веднага.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">При проблем с машините остава хартията само по изключение.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Избирателите в чужбина извън ЕС<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167174\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-80 и доклад за първо гласуване на правната комисия (08.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a><a href=\"https://www.bta.bg/en/news/1163718-election-code-reform-push-reopens-debate-on-machine-voting-polling-abroad\" target=\"_blank\" rel=\"noreferrer\" title=\"БТА: дебатът за машинното гласуване и секциите в чужбина\" class=\"ml-0.5 no-underline\">[<!-- -->3<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">Ако ограничението от 20 секции отпадне, може да се отварят повече секции извън посолствата.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">Противниците (вкл. „Възраждане“) смятат, че това улеснява организиран вот.</p></div></div></div><div class=\"ring-1 ring-rule rounded-sm bg-white\"><p class=\"font-semibold px-4 pt-3\">Партиите и ЦИК<span class=\"text-xs whitespace-nowrap\"> <a href=\"https://www.parliament.bg/bg/bills/ID/167174\" target=\"_blank\" rel=\"noreferrer\" title=\"Народно събрание: законопроект № 52-654-01-80 и доклад за първо гласуване на правната комисия (08.07.2026)\" class=\"ml-0.5 no-underline\">[<!-- -->2<!-- -->]</a></span></p><div class=\"grid sm:grid-cols-2 gap-px bg-rule mt-3\"><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-[#2f7d57] mb-0.5\">Печели</p><p class=\"text-[15px]\">По-ясни правила за мнозинство в ЦИК и за местните коалиции.</p></div><div class=\"bg-white px-4 py-3\"><p class=\"text-xs font-semibold text-red mb-0.5\">Губи</p><p class=\"text-[15px]\">По-малко време за подготовка, защото правилата се сменят месеци преди избори.</p></div></div></div></div></div><div class=\"mt-8 text-sm\"><p class=\"font-semibold mb-1\">Източници</p><ol class=\"list-decimal pl-5 space-y-0.5\"><li><a href=\"https://www.parliament.bg/bg/bills/ID/167202\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: общ законопроект № 52-653-02-6, доклади и становища</a></li><li><a href=\"https://www.parliament.bg/bg/bills/ID/167174\" target=\"_blank\" rel=\"noreferrer\">Народно събрание: законопроект № 52-654-01-80 и доклад за първо гласуване на правната комисия (08.07.2026)</a></li><li><a href=\"https://www.bta.bg/en/news/1163718-election-code-reform-push-reopens-debate-on-machine-voting-polling-abroad\" target=\"_blank\" rel=\"noreferrer\">БТА: дебатът за машинното гласуване и секциите в чужбина</a></li><li><a href=\"https://www.capital.bg/politika_i_ikonomika/bulgaria/2026/07/28/4940316_mashinite_sa_izcialo_reabilitirani_za_prezidentskite/\" target=\"_blank\" rel=\"noreferrer\">Капитал: „Машините са изцяло реабилитирани за президентските избори“ (28.07.2026)</a></li><li><a href=\"https://naiasno.bg/parliament\" target=\"_blank\" rel=\"noreferrer\">Поименни гласувания, Народно събрание (чрез „Наясно“)</a></li></ol><p class=\"text-xs text-muted mt-2\">Обобщението е по доклада на правната комисия за първо гласуване, становищата и медийните източници. „Какво печели и какво губи всяка страна“ е наш анализ, не позиция на партия.<!-- --> Проверено: <!-- -->19 ноември 2026 г.</p></div></div><section id=\"dokumenti\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Още от документите</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.</p><div class=\"space-y-4 max-w-4xl\"><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167581\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Изборния кодекс</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-156</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Целта е да се избегнат броя на замените в РИК/ОИК, които натоварват излишно работата на тези комисии.<!-- -->“</li><li>„<!-- -->Член 178 от Изборния кодекс предвижда бюджетни средства за медийни пакети на определени партии и коалиции според правото им на държавна субсидия, както и на инициативни комитети, регистрирали кандидати.<!-- -->“</li><li>„<!-- -->За да бъде предложеното правило приложимо без предположения, проектът предвижда проверка на целия списък за съответните национални избори.<!-- -->“</li><li>„<!-- -->Целта е публичните средства, действително разходвани за медийно представяне на участник, получил по-малко гласове от броя на проверените подписи за регистрацията си, да се възстановяват в държавния бюджет.<!-- -->“</li><li>„<!-- -->Предлага се пълно възстановяване на направения разход, когато действителните гласове са по-малко от проверените действителни подписи за регистрация.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167581\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->Камара на счетоводителите в Република България относно законопроект за изменение и допълнение на Изборния кодекс, № 52-654-01-156, внесен от Цончо Томов Ганев и група народни представители на 2.10.2026 г.<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167581\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167174\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Изборния кодекс</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-80</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Законопроект, № 52-654-01-80, беше представен от г-жа Янка Тянкова, която отбеляза, че с него се предлага отпадане на гласуването с хартиени бюлетини и се въвежда изцяло машинен вот с изключение на секции с под 300 избиратели, секции за гласуване с подвижна избирателна кутия, избирателни секции в лечебни заведения, домове за стари хора и други специализирани институции за предоставяне на социални услуги и намиращите се извън страната плавателни съдове под български флаг.<!-- -->“</li><li>„<!-- -->Предлага се още Министерството на иновациите и дигиталната трансформация и Министерството на вътрешните работи да извършват проверки на модулите от софтуера, свързани с преброяването на гласовете по методика, утвърдена от министъра на иновациите и дигиталната трансформация и министъра на вътрешните работи.<!-- -->“</li><li>„<!-- -->Предвижда се възстановяване на досегашният модел на изборно райониране, основан на 31 многомандатни изборни района, като чрез отпадане на многомандатния изборен район „Чужбина“.<!-- -->“</li><li>„<!-- -->С предлаганите изменения за първи път се уреждат изрично правомощията на председателя на Централната избирателна комисия, тъй като към настоящия момент неговият статут и функции не са регламентирани в Изборния кодекс, за разлика от законовата уредба на председатели на комисии, чиито статут и правомощия са изрично уредени в съответните нормативни актове.<!-- -->“</li><li>„<!-- -->Тя подчерта, че се засилва ролята и дейността на обучителните звена към Централната избирателна комисия, като се предвижда комисията да води публичен регистър на успешно обучените лица.<!-- -->“</li><li>„<!-- -->Предлага се още социалните мрежи фейсбук, туитър и личните блогове да бъдат включени към дефиницията за медийни услуги, за да бъде избегнато нарушаването на разпоредбите на Изборния кодекс за неправомерно оповестяване на резултати от социологически проучвания.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167174\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Г-н Стою Стоев отбеляза, че ще подкрепят законопроект на ПГ „Демократична България“ и първия внесен законопроект от ПГ „Движение за права и свободи – ДПС“ и няма да подкрепят втория внесен законопроект от ПГ „Движение за права и свободи – ДПС“.<!-- -->“</li><li>„<!-- -->Г-жа Николета Тодорова заяви, че в цялост ще подкрепят законопроектите, които подкрепят машинното гласуване като посочи, че тази промяна е необходима с оглед развитието на съвременните технологии.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167174\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Г-н Красимир Терзиев и г-н Стефан Арсов посочиха, че разглеждането на промените в Изборния кодекс е непосредствено преди изборите за президент и вицепрезидент, което противоречи на препоръките и добрите практики на Венецианска комисия и ОССЕ.<!-- -->“</li><li>„<!-- -->Той допълни, че подкрепят значителна част от предложенията в законопроекта на ПГ „Възраждане“, но не са съгласни с начина на предлагане на преброяване на бюлетините от машинното гласуване.<!-- -->“</li><li>„<!-- -->Относно предложения законопроект на ПГ „Прогресивна България“, г-н Стоев подчерта, че ще го подкрепят с известни резерви, тъй като не са съгласни с отпадането на район „Чужбина“.<!-- -->“</li><li>„<!-- -->Г-н Иван Вачев посочи, че законопроектът на ПГ „Възраждане“ не може да бъде подкрепен към настоящия момент, тъй като се съдържат предложения, които следва да бъдат поставени на широк обществен дебат с представители на всички институции, неправителствени организации и академичната общност, като към този момент фокусът е само за неотложни промени по Изборния кодекс.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167174\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167173\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Изборния кодекс</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-79</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Той отбеляза, че се предвижда решенията на Централната избирателна комисия да се приемат с мнозинство повече от половината от членовете й, като целта е да се преодолее възможността работата на комисията да бъде блокирана чрез прекомерно високо мнозинство.<!-- -->“</li><li>„<!-- -->Той допълни, че се предлага намаляване на броя заявления, необходими за образуване на подвижна секционна избирателна комисия - на не повече от 30 избиратели.<!-- -->“</li><li>„<!-- -->Със законопроекта се предвижда Централната избирателна комисия да извършва служебни справки в Софийски градски съд и Сметната палата относно съдебната регистрация, представителството и финансовите отчети на политическите партии.<!-- -->“</li><li>„<!-- -->Въвеждат се ясен срок, писмено заявление и решение за заличаване, подписано от лицата, представляващи партиите или коалициите, включени в състава на местната коалиция.<!-- -->“</li><li>„<!-- -->Предлага се в избирателната секция избирателят да гласува с бюлетина за машинно гласуване, освен в изрично предвидените от закона случаи, при които се гласува с хартиена бюлетина.<!-- -->“</li><li>„<!-- -->Въвежда се изискването резултатите от машинното гласуване да се отчитат чрез отпечатване на протокол от устройството за машинно гласуване и чрез данните от записващото техническо устройство.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167173\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-[#8a8f8c] pl-4\"><p class=\"font-semibold mb-1\">Позиции, изказани в комисията</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Законопроект, № 52-654-01-79, беше представен от г-н Стою Стоев, който отбеляза, че с него се предлага отпадане на ограничението за разкриване на избирателни секции извън дипломатическите и консулските представителства в държави, които не са членки на Европейския съюз.<!-- -->“</li><li>„<!-- -->Г-н Стоев подчерта, че със законопроекта се разширяват ограниченията за членство в секционните избирателни комисии, като те следва да обхващат и кметските наместници; въвеждат се нови правила за несъвместимост за наблюдатели, застъпници и представители на партии, коалиции и инициативни комитети и се създава възможност за обжалване на решения на районните и общинските избирателни комисии, с които не е установено нарушение на изборното законодателство.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167173\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div></div></details></div><div class=\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\"><p class=\"text-xs text-muted\">Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.</p><p class=\"font-semibold mt-1\"><a href=\"https://www.parliament.bg/bg/bills/ID/167171\" target=\"_blank\" rel=\"noreferrer\" class=\"text-ink\">Законопроект за изменение и допълнение на Изборния кодекс</a> <span class=\"text-sm text-muted num font-normal\">№ <!-- -->52-654-01-78</span></p><details><summary class=\"cursor-pointer font-semibold text-green mt-2\">Покажи цитатите</summary><div class=\"space-y-5 mt-3\"><div class=\"border-l-4 border-green pl-4\"><p class=\"font-semibold mb-1\">Какво предлага законопроектът</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Предвижда се съставът на Централната избирателна комисия да отразява пропорционално разпределението на политическите партии в Народното събрание и следователно трябва да бъде променян по време на мандата на комисията.<!-- -->“</li><li>„<!-- -->Предлага се мандатът на комисията да се намали на 4 г., като се въвежда ограничение за вземане на партийни длъжности по време на мандата на комисията и 2 години след него.<!-- -->“</li><li>„<!-- -->Г-н Петров уточни, че се въвеждат промени в правилата за подаване на електронни заявления, като от един IP адрес може да бъде подадено само едно електронно заявление чрез интернет страницата на Централната избирателна комисия.<!-- -->“</li><li>„<!-- -->Предлага се видеонаблюдение в реално време и видеозаснемане при приемането и проверката на всеки един от протоколите в момента на предаването им от секционните избирателни комисии, и видеонаблюдение в реално време и видеозаснемане на заседанията на общинска избирателна комисия.<!-- -->“</li><li>„<!-- -->Предвижда се по-голям брой застъпници и представители на политически партии и коалиции в районните или общински избирателни комисии, като се въвежда изискване към членовете на секционната избирателна комисия да имат завършено средно образование и се предлага увеличаването на възнаграждението на ръководните длъжности.<!-- -->“</li><li>„<!-- -->Основания и контекст на законодателната инициатива Измененията в Изборния кодекс са продиктувани от необходимостта за подобряване на прозрачността и ефективността в работата на Централната избирателна комисия (ЦИК).<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167171\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><div class=\"border-l-4 border-red pl-4\"><p class=\"font-semibold mb-1\">Възражения и критики</p><ul class=\"space-y-1.5 text-[15px]\"><li>„<!-- -->Със законопроекта се предлага въвеждането на изборните резултати и окончателното им изчисляване да бъде извършвано от държавни институции и ведомства, а не както досега – от акционерно дружество „Информационно обслужване“ АД, като се отбеляза, че по този начин ще бъдат елиминирани съмнения за непрозрачност.<!-- -->“</li></ul><p class=\"text-xs text-muted mt-1\">Източник: <a href=\"https://www.parliament.bg/bg/bills/ID/167171\" target=\"_blank\" rel=\"noreferrer\">доклад на комисията и мотиви, parliament.bg</a></p></div><p class=\"text-[15px]\"><b>Писмени становища внесоха:</b> <!-- -->Сдружение „Гражданска платформа“ относно законопроект за изменение и допълнение на Изборния кодекс, № 52-654-01-78, внесен от Костадин Тодоров Костадинов и Петър Николаев Петров на 6.07.2026 г.<!-- -->. <a href=\"https://www.parliament.bg/bg/bills/ID/167171\" target=\"_blank\" rel=\"noreferrer\">Текстовете в parliament.bg</a></p></div></details></div></div></section><section id=\"mnenie\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Твоето мнение</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. <a href=\"/mnenie\">Всички закони за гласуване</a>.</p><div class=\"bg-surface rounded-sm p-5 text-[15px] text-muted\">Зарежда се…</div></section><section id=\"grupi\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Как гласуваха групите по този закон</h2></div><p class=\"text-sm text-muted mb-3\">Брой гласувания, в които мнозинството в групата е било „за“ или „против“, от общо <!-- -->131<!-- -->. Прието: <!-- -->58<!-- -->, отхвърлено: <!-- -->73<!-- -->.</p><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Прогресивна България</p><p class=\"num text-sm mt-1\">За: <b>58</b> · Против: <b>71</b> · общо <!-- -->131</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ГЕРБ – СДС</p><p class=\"num text-sm mt-1\">За: <b>9</b> · Против: <b>117</b> · общо <!-- -->131</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Демократична България</p><p class=\"num text-sm mt-1\">За: <b>83</b> · Против: <b>42</b> · общо <!-- -->131</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">ДПС</p><p class=\"num text-sm mt-1\">За: <b>46</b> · Против: <b>85</b> · общо <!-- -->131</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Продължаваме промяната</p><p class=\"num text-sm mt-1\">За: <b>89</b> · Против: <b>38</b> · общо <!-- -->130</p></div><div class=\"border border-rule rounded-sm p-4\"><p class=\"font-semibold\">Възраждане</p><p class=\"num text-sm mt-1\">За: <b>36</b> · Против: <b>84</b> · общо <!-- -->129</p></div></div><p class=\"text-sm mt-3\">Първо четене: <a href=\"/parlament/glasuvane/2026-07-16-2\">16 юли 2026 г.</a><a href=\"/parlament/glasuvane/2026-07-16-3\">16 юли 2026 г.</a><a href=\"/parlament/glasuvane/2026-07-16-4\">16 юли 2026 г.</a><a href=\"/parlament/glasuvane/2026-07-16-5\">16 юли 2026 г.</a><a href=\"/parlament/glasuvane/2026-07-16-6\">16 юли 2026 г.</a><a href=\"/parlament/glasuvane/2026-07-16-7\">16 юли 2026 г.</a><a href=\"/parlament/glasuvane/2026-07-16-8\">16 юли 2026 г.</a></p></section><section id=\"glasuvaniya\" class=\"scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Всички гласувания по закона</h2></div><ul><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-07-16-2\">Изборния кодекс - първо гласуване - вносител Делян Пеевски и група н.п</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">16 юли 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: Против · Демократична България: За · ДПС: За · Продължаваме промяната: Против · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-07-16-3\">Изборния кодекс - първо гласуване - вносител Делян Пеевски и група н.п.</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">16 юли 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: Против · Демократична България: За · ДПС: За · Продължаваме промяната: Отсъства · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-07-16-4\">Изборния кодекс - първо гласуване - вносител Надежда Йорданова и група н.п</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">16 юли 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: За · ГЕРБ – СДС: Против · Демократична България: За · ДПС: Против · Продължаваме промяната: За · Възраждане: За</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-07-16-5\">Изборния кодекс - първо гласуване - вносител Делян Пеевски и група н.п. - внесен на 18.06.2026 г</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-muted border border-rule\">Отхвърлено</span></div><p class=\"text-sm text-muted mt-1\">16 юли 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: Против · ГЕРБ – СДС: Против · Демократична България: Въздържал се · ДПС: За · Продължаваме промяната: Против · Възраждане: Против</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-07-16-6\">Изборния кодекс - първо гласуване - вносител Костадин Костадинов и Петър Петров</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-surface text-muted border border-rule\">Отхвърлено</span></div><p class=\"text-sm text-muted mt-1\">16 юли 2026 г.<!-- --> · <!-- -->Първо четене<!-- --> · <!-- -->Прогресивна България: Против · ГЕРБ – СДС: Против · Демократична България: За · ДПС: Против · Продължаваме промяната: За · Възраждане: За</p></li><li class=\"border-b border-rule py-3\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><a class=\"text-ink no-underline hover:underline\" href=\"/parlament/glasuvane/2026-07-16-7\">Изборния кодекс - първо гласуване - вносител Стою Стоев и група н.п</a><span class=\"inline-block text-xs font-semibold px-2 py-0.5 rounded-sm bg-green-soft text-green\">Прието</span></div><p class=\"text-sm text-muted mt-1\">16 юли 2026 г.<!-- --> · <!-- -->Първо четене<!--