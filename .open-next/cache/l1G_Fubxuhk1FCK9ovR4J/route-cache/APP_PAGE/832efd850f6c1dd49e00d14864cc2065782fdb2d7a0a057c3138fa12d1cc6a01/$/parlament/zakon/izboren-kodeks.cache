ren\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#mnenie\\\",\\\"className\\\":\\\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\\\",\\\"children\\\":\\\"Твоето мнение\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"grupi\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#grupi\\\",\\\"className\\\":\\\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\\\",\\\"children\\\":\\\"Как гласуваха\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"glasuvaniya\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#glasuvaniya\\\",\\\"className\\\":\\\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\\\",\\\"children\\\":\\\"Гласувания (131)\\\"}]}]]}]}],[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"nakratko\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Накратко\\\"}],\\\"$undefined\\\",[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"max-w-4xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[17px]\\\",\\\"children\\\":\\\"Промените са приети няколко месеца преди президентските избори. Основната тема е начинът на гласуване: проектите на управляващите и на ПП–ДБ връщат машинното гласуване като основен начин, с контролно преброяване на разписките от машините, а проектът на „Прогресивна България“ оставя хартиени бюлетини само по изключение (напр. в секции под 300 избиратели). Втората тема са секциите в чужбина: няколко проекта предлагаха да отпадне ограничението до 20 секции извън посолствата в държави извън ЕС. Обсъждани бяха и правилата за ЦИК (решения с мнозинство над половината от членовете), ограничения за членове на секционните комисии и скенери за личните карти в секциите.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"children\\\":\\\"Вносители:\\\"}],\\\" \\\",\\\"Общ законопроект на правната комисия от четири проекта: на Николета Тодорова и др. („Прогресивна България“), на Надежда Йорданова и др. (ДБ), на Стою Стоев и др. (ПП) и на Делян Пеевски и др. (ДПС)\\\",[\\\" · \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.parliament.bg/bg/bills/ID/167202\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noreferrer\\\",\\\"children\\\":[\\\"законопроект \\\",\\\"52-653-02-6\\\"]}]]]}],\\\"$L1b\\\"]}]]}],\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\",\\\"$L1f\\\",\\\"$L20\\\",\\\"$L21\\\",\\\"$L22\\\"]}]\\n23:I[32466,[\\\"$2\\\",\\\"$9\\\"],\\\"Term\\\"]\\n2f:I[52368,[\\\"$2\\\",\\\"$9\\\"],\\\"CitizenVote\\\"]\\n1b:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"children\\\":\\\"Какво се случи:\\\"}],\\\" \\\",\\\"На първо четене (16.07.2026) парламентът подкрепи проектите на „Прогресивна България“, ДБ, ПП и два проекта на ДПС, а отхвърли проекта на „Възраждане“ (изцяло машинно гласуване с бюлетина в прозрачна кутия) и проекта на ДПС за отпадане на уседналостта. ГЕРБ–СДС гласуваха против всички. Преди второто четене „Прогресивна България“ оттегли спорните си предложения, сред тях ограничаването на агитацията в личните профили в социалните мрежи. Заключителните разпоредби бяха приети със 163 „за“ и 13 „против“ („Възраждане“).\\\"]}]\\n1c:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"signali\\\",\\\"className\\\":\\\"mb-16 scroll-mt-32 lg:scroll-mt-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"display text-[2.4rem] leading-none mb-2\\\",\\\"children\\\":\\\"Сигнали\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[15px] text-muted mb-5 max-w-3xl\\\",\\\"children\\\":\\\"Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.\\\"}],[[\\\"$\\\",\\