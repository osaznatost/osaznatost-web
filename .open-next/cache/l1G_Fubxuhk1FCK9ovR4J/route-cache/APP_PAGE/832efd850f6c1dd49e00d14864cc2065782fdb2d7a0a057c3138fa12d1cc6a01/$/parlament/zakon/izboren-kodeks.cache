:\"#argumenti\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Двете страни\"}]}]\n18:[\"$\",\"li\",\"mnenie\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#mnenie\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Твоето мнение\"}]}]\n19:[\"$\",\"li\",\"grupi\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#grupi\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Как гласуваха\"}]}]\n1a:[\"$\",\"li\",\"glasuvaniya\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#glasuvaniya\",\"className\":\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\",\"children\":\"Гласувания (131)\"}]}]\n1b:[\"$\",\"section\",null,{\"id\":\"nakratko\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Накратко\"}],\"$undefined\",[\"$\",\"div\",null,{\"className\":\"max-w-4xl\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[17px]\",\"children\":\"Промените са приети няколко месеца преди президентските избори. Основната тема е начинът на гласуване: проектите на управляващите и на ПП–ДБ връщат машинното гласуване като основен начин, с контролно преброяване на разписките от машините, а проектът на „Прогресивна България“ оставя хартиени бюлетини само по изключение (напр. в секции под 300 избиратели). Втората тема са секциите в чужбина: няколко проекта предлагаха да отпадне ограничението до 20 секции извън посолствата в държави извън ЕС. Обсъждани бяха и правилата за ЦИК (решения с мнозинство над половината от членовете), ограничения за членове на секционните комисии и скенери за личните карти в секциите.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Вносители:\"}],\" \",\"Общ законопроект на правната комисия от четири проекта: на Николета Тодорова и др. („Прогресивна България“), на Надежда Йорданова и др. (ДБ), на Стою Стоев и др. (ПП) и на Делян Пеевски и др. (ДПС)\",[\" · \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167202\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":[\"законопроект \",\"52-653-02-6\"]}]]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Какво се случи:\"}],\" \",\"На първо четене (16.07.2026) парламентът подкрепи проектите на „Прогресивна България“, ДБ, ПП и два проекта на ДПС, а отхвърли проекта на „Възраждане“ (изцяло машинно гласуване с бюлетина в прозрачна кутия) и проекта на ДПС за отпадане на уседналостта. ГЕРБ–СДС гласуваха против всички. Преди второто четене „Прогресивна България“ оттегли спорните си предложения, сред тях ограничаването на агитацията в личните профили в социалните мрежи. Заключителните разпоредби бяха приети със 163 „за“ и 13 „против“ („Възраждане“).\"]}]]}]]}]\n1c:[\"$\",\"section\",null,{\"id\":\"signali\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Сигнали\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Автоматично открити особености в начина, по който е приет законът. Не са доказателство за нарушение, а повод текстът да се прочете внимателно.\"}],[[\"$\",\"ul\",null,{\"className\":\"grid gap-3 md:grid-cols-2 max-w-5xl\",\"children\":[[\"$\",\"li\",\"7 нови текста, приети на второ четене\",{\"className\":\"border-l-4 rounded-sm p-4 border-[#e08a2e] bg-[#fdf3e6]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"7 нови текста, приети на второ четене\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Текстове, които ги нямаше в първоначалния законопроект. Обикновено са поправки, но могат и да променят смисъла.\"}]]}],[\"$\",\"li\",\"Внесен от депутати\",{\"className\":\"border-l-4 rounded-sm p-4 border-rule bg-surface\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"Внесен от депутати\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mt-1\",\"children\":\"Законопроектите на депутати не минават през задължителното 30-дневно обществено обсъждане на strategy.bg, както тези на Министерския съвет, и често нямат подробна оценка на въздействието.\"}]]}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm mt-3\",\"children\":[\"$\",\"$La\",null,{\"href\":\"/parlament/signali\",\"children\":\"Всички сигнали в парламента\"}]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-2\",\"children\":[\"Сигналът е повод за въпрос, не доказателство за нарушение.\",\" \",[\"$\",\"$La\",null,{\"href\":\"/metodologiya#signal\",\"className\":\"underline\",\"children\":\"Как работим със сигналите\"}]]}]]]}]\n1d:[\"$\",\"section\",null,{\"id\":\"zakonoproekti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Кой внесе и кой се изказа\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.\"}],[[\"$\",\"ul\",null,{\"className\":\"space-y-4 max-w-5xl\",\"children\":[[\"$\",\"li\",\"167581\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167581\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за изменение и допълнение на Изборния кодекс\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-654-01-156\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"2 октомври 2026 г.\",\" от \",\"Цончо Ганев, Петър Петров, Димо Дренчев и още 5 депутати\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по правни въпроси (водеща)\"}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Становища\"}],[\"$\",\"dd\",null,{\"children\":\"Камара на счетоводителите в Република България относно законопроект за изменение и допълнение на Изборния кодекс, № 52-654-01-156, внесен от Цончо Томов Ганев и група народни представители на 2.10.2026 г.\"}]],false,false,false,false,false,null]}]]}],[\"$\",\"li\",\"167202\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167202\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за изменение и допълнение на Изборния кодекс\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-653-02-6\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"16 юли 2026 г.\",\" от \",\"депутати\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по правни въпроси (водеща)\"}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Становища\"}],[\"$\",\"dd\",null,{\"children\":\"Институт за развитие на публичната среда относно общ законопроект за изменение и допълнение на Изборния кодекс, № 52-653-02-6 от 16.07.2026 г.; Мария Феркова относно общ законопроект за изменение и допълнение на Изборния кодекс, № 52-653-02-6 от 16.07.2026 г.; Омбудсман на Република България относно общ законопроект за изменение и допълнение на Изборния кодекс, № 52-653-02-6 от 16.07.2026 г.; Обществен съвет към Централната избирателна комисия относно общ законопроект за изменение и допълнение на Изборния кодекс, № 52-653-02-6 от 16.07.2026 г.; Министерството на външните работи относно общ законопроект за изменение и допълнение на Изборния кодекс, № 52-653-02-6 от 16.07.2026 г.; Сдружение \\\"Будни хора\\\" относно общ законопроект за изменение и допълнение на Изборния кодекс, № 52-653-02-6 от 16.07.2026 г.; Министерството на вътрешните работи по § 34 относно общ законопроект за изменение и допълнение на Изборния кодекс, № 52-653-02-6 от 16.07.2026 г.\"}]],false,false,false,[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Предложения\"}],[\"$\",\"dd\",null,{\"children\":[6,\" писмени предложения на депутати между \",[\"$\",\"$L2e\",null,{\"k\":\"parvo-chetene\",\"children\":\"първо\"}],\" и \",[\"$\",\"$L2e\",null,{\"k\":\"vtoro-chetene\",\"children\":\"второ четене\"}]]}]],\"$L2f\",\"$L30\"]}]]}]]}],\"$L31\"]]}]\n1e:[\"$\",\"div\",null,{\"id\":\"argumenti\",\"className\":\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-2 mt-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-green bg-surface\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Мотивите на вносителите\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Надежда Йорданова (ДБ)Машинното гласуване \",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Надежда Йорданова (ДБ)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Машинното гласуване трябва да се върне в пълния си вид, като секционните комисии преброяват и контролните разписки; ограничението за секции извън ЕС трябва да отпадне.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"2\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167174\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-80 и доклад за първо гласуване на правната комисия (08.07.2026)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",2,\"]\"]}],[\"$\",\"a\",\"3\",{\"href\":\"https://www.bta.bg/en/news/1163718-election-code-reform-push-reopens-debate-on-machine-voting-polling-abroad\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"БТА: дебатът за машинното гласуване и секциите в чужбина\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",3,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Стою Стоев (ПП)Анализ на ЦИК от 202\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Стою Стоев (ПП)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Анализ на ЦИК от 2022 г. показва, че разликите при машинното гласуване идват от човешки грешки, а не от машините. Решенията на ЦИК да се приемат с мнозинство над половината, за да не може комисията да бъде блокирана.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"2\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167174\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-80 и доклад за първо гласуване на правната комисия (08.07.2026)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",2,\"]\"]}],[\"$\",\"a\",\"3\",{\"href\":\"https://www.bta.bg/en/news/1163718-election-code-reform-push-reopens-debate-on-machine-voting-polling-abroad\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"БТА: дебатът за машинното гласуване и секциите в чужбина\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",3,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Янка Тянкова („Прогресивна България“)Предлага отпадане на\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Янка Тянкова („Прогресивна България“)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Предлага отпадане на хартиените бюлетини и изцяло машинно гласуване, с изключение на малките секции.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"2\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167174\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-80 и доклад за първо гласуване на правната комисия (08.07.2026)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",2,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Хамид Хамид (ДПС)Ограничението до 20 \",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Хамид Хамид (ДПС)\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Ограничението до 20 секции извън посолствата в държави извън ЕС ограничава избирателите в чужбина и трябва да отпадне.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"2\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167174\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-80 и доклад за първо гласуване на правната комисия (08.07.2026)\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",2,\"]\"]}]]]}]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\",\"children\":[\"$L32\",\"$L33\"]}]]}],null,\"$L34\",\"$L35\",null,\"$L36\"]}]\n1f:[\"$\",\"section\",null,{\"id\":\"dokumenti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Още от документите\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 max-w-4xl\",\"children\":[[\"$\",\"div\",\"167581\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167581\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за изменение и допълнение на Изборния кодекс\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-654-01-156\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Целта е да се избегнат броя на замените в РИК/ОИК, които натоварват излишно работата на тези комисии.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Член 178 от Изборния кодекс предвижда бюджетни средства за медийни пакети на определени партии и коалиции според правото им на държавна субсидия, както и на инициативни комитети, регистрирали кандидати.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"За да бъде предложеното правило приложимо без предположения, проектът предвижда проверка на целия списък за съответните национални избори.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"Целта е публичните средства, действително разходвани за медийно представяне на участник, получил по-малко гласове от броя на проверените подписи за регистрацията си, да се възстановяват в държавния бюджет.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"Предлага се пълно възстановяване на направения разход, когато действителните гласове са по-малко от проверените действителни подписи за регистрация.\",\"“\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167581\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]]}],null,null,false,[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"Камара на счетоводителите в Република България относно законопроект за изменение и допълнение на Изборния кодекс, № 52-654-01-156, внесен от Цончо Томов Ганев и група народни представители на 2.10.2026 г.\",\". \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167581\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"Текстовете в parliament.bg\"}]]}]]}]]}]]}],[\"$\",\"div\",\"167174\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167174\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"childr