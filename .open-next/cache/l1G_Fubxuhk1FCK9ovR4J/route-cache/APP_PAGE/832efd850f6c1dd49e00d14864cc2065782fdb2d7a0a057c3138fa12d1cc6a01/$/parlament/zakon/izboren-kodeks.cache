//www.parliament.bg/bg/bills/ID/166943\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за изменение на Изборния кодекс\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-654-01-6\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"30 април 2026 г.\",\" от \",\"Делян Пеевски, Айтен Сабри, Хамид Хамид и още 18 депутати\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по правни въпроси (водеща)\"}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Становища\"}],[\"$\",\"dd\",null,{\"children\":\"Сдружение „Гражданска платформа“ относно законопроект за изменение на Изборния кодекс, № 52-654-01-6, внесен от Делян Славчев Пеевски и група народни представители на 30.04.2026 г.\"}]],false,false,false,false,[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"В залата\"}],[\"$\",\"dd\",null,{\"children\":[[\"$\",\"span\",\"0\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11152\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"16 юли 2026 г.\"}],\" (\",\"зала първо гласуване\",\")\"]}]]}]],null]}]]}]\n4d:[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"По-ясни правила за мнозинство в ЦИК и за местните коалиции.\"}]\n4e:[\"$\",\"div\",null,{\"className\":\"bg-white px-4 py-3\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold text-red mb-0.5\",\"children\":\"Губи\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":\"По-малко време за подготовка, защото правилата се сменят месеци преди избори.\"}]]}]\n4f:[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Г-н Красимир Терзиев и г-н Стефан Арсов посочиха, че разглеждането на промените в Изборния кодекс е непосредствено преди изборите за президент и вицепрезидент, което противоречи на препоръките и добрите практики на Венецианска комисия и ОССЕ.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Той допълни, че подкрепят значителна част от предложенията в законопроекта на ПГ „Възраждане“, но не са съгласни с начина на предлагане на преброяване на бюлетините от машинното гласуване.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Относно предложения законопроект на ПГ „Прогресивна България“, г-н Стоев подчерта, че ще го подкрепят с известни резерви, тъй като не са съгласни с отпадането на район „Чужбина“.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"Г-н Иван Вачев посочи, че законопроектът на ПГ „Възраждане“ не може да бъде подкрепен към настоящия момент, тъй като се съдържат предложения, които следва да бъдат поставени на широк обществен дебат с представители на всички институции, неправителствени организации и академичната общност, като към този момент фокусът е само за неотложни промени по Изборния кодекс.\",\"“\"]}]]}]\n50:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167174\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]\n51:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted mt-1\",\"children\":[\"Източник: \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167173\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"доклад на комисията и мотиви, parliament.bg\"}]]}]\n52:null\n53:[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Писмени становища внесоха:\"}],\" \",\"Сдружение „Гражданска платформа“ относно законопроект за изменение