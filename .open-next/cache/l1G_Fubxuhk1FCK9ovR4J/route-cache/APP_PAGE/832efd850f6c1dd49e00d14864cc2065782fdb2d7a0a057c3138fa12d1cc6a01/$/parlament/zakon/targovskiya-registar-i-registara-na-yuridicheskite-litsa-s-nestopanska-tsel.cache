\",\"$La\",null,{\"href\":\"/metodologiya#signal\",\"className\":\"underline\",\"children\":\"Как работим със сигналите\"}]]}]\n20:[\"$\",\"section\",null,{\"id\":\"zakonoproekti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Кой внесе и кой се изказа\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Законопроектите, с които е променян законът в този парламент: вносители, комисии, становища на външни организации и обсъжданията в залата.\"}],[[\"$\",\"ul\",null,{\"className\":\"space-y-4 max-w-5xl\",\"children\":[[\"$\",\"li\",\"167535\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-between gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167535\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"font-semibold text-ink\",\"children\":\"Законопроект за допълнение на Закона за търговския регистър и регистъра на юридическите лица с нестопанска цел\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num whitespace-nowrap\",\"children\":[\"№ \",\"52-654-01-129\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[15px]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Внесен\"}],[\"$\",\"dd\",null,{\"children\":[\"8 септември 2026 г.\",\" от \",\"Янка Тянкова, Михаела Доцова, Петър Витанов и още 5 депутати\",false]}],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Комисии\"}],[\"$\",\"dd\",null,{\"children\":\"Комисия по правни въпроси (водеща); Комисия по бюджет и финанси (участваща)\"}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Становища\"}],[\"$\",\"dd\",null,{\"children\":\"Българска стопанска камара относно Законопроект за допълнение на Закона за търговския регистър и регистъра на юридическите лица с нестопанска цел, № 52-654-01-129, внесен от Янка Тенева Тянкова и група народни представители на 8.09.2026 г.; Висшия адвокатски съвет относно законопроект за допълнение на Закона за търговския регистър и регистъра на юридическите лица с нестопанска цел, № 52-654-01-129, внесен от Янка Тенева Тянкова и група народни представители на 8.09.2026 г.\"}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"В комисията\"}],[\"$\",\"dd\",null,{\"children\":[[\"$\",\"span\",\"0\",{\"children\":[false,\"правни въпроси\",\", \",\"първо гласуване\",\": \",19,\" за, \",0,\" против\",\", 1 въздържал се\"]}]]}]],false,false,[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Предложения\"}],[\"$\",\"dd\",null,{\"children\":[1,\" писмени предложения на депутати между \",[\"$\",\"$L26\",null,{\"k\":\"parvo-chetene\",\"children\":\"първо\"}],\" и \",[\"$\",\"$L26\",null,{\"k\":\"vtoro-chetene\",\"children\":\"второ четене\"}]]}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"В залата\"}],[\"$\",\"dd\",null,{\"children\":[[\"$\",\"span\",\"0\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11170\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"16 септември 2026 г.\"}],\" (\",\"зала първо гласуване\",\")\"]}],[\"$\",\"span\",\"1\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/plenaryst/ns/52/ID/11180\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"children\":\"1 октомври 2026 г.\"}],\" (\",\"зала второ гласуване\",\")\"]}]]}]],[[\"$\",\"dt\",null,{\"className\":\"text-muted\",\"children\":\"Обнародван\"}],[\"$\",\"dd\",null,{\"children\":[\"ДВ, бр. 92/2026\",\", приет на 1 октомври 2026 г.\"]}]]]}]]}]]}],false]]}]\n21:[\"$\",\"div\",null,{\"id\":\"argumenti\",\"className\":\"scroll-mt-32 lg:scroll-mt-20 max-w-4xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-2 mt-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-green bg-surface\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Мотивите на вносителите\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Проф. Янка ТянковаДо края на септември\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Проф. Янка Тянкова\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"До края на септември 2026 г. неразгледаните заявления за годишни отчети се очаква да са между 900 000 и 1 000 000; Агенцията по вписванията е прекомерно натоварена и с декларации за информация, която вече има.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167535\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-129, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Министерството на правосъдиетоПромените ще улеснят\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Министерството на правосъдието\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Промените ще улеснят бизнеса и работата на Агенцията по вписванията.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167535\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-129, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"p-5 rounded-sm border-t-4 border-red bg-[#fbf1f2]\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.6rem] mb-3\",\"children\":\"Какво казват критиците\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"Иван Вачев и Даниела КършеваПроблемите са натруп\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Иван Вачев и Даниела Кършева\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Проблемите са натрупани при предишни управления; нужни са и по-добри методически указания за длъжностните лица, не само законови промени.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167535\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-129, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}],[\"$\",\"li\",\"Отворен въпросЗаконът облекчава по\",{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Отворен въпрос\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px]\",\"children\":[\"Законът облекчава потока, но не решава причините за забавянето (капацитет и системи на Агенцията).\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167535\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-129, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}]]}]]}]]}]]}],null,[\"$\",\"div\",null,{\"className\":\"mt-8\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"display text-[1.8rem] mb-1\",\"children\":\"Двете страни на монетата\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted mb-3\",\"children\":[\"Какво следва на практика, ако законът се приеме и ако се отхвърли.\",[\"$\",\"span\",null,{\"className\":\"text-xs whitespace-nowrap\",\"children\":[\" \",[[\"$\",\"a\",\"1\",{\"href\":\"https://www.parliament.bg/bg/bills/ID/167535\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"title\":\"Народно събрание: законопроект № 52-654-01-129, доклади и становища\",\"className\":\"ml-0.5 no-underline\",\"children\":[\"[\",1,\"]\"]}]]]}]]}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"ring-1 ring-rule rounded-sm p-4 bg-white border-t-4 border-t-[#2f9e6a]\",\"children\":[\"$L27\",\"$L28\"]}],\"$L29\"]}]]}],\"$L2a\",null,\"$L2b\"]}]\n22:[\"$\",\"section\",null,{\"id\":\"dokumenti\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Още от документите\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":\"Дословни цитати от докладите, мотивите и стенограмите, извлечени автоматично.\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 max-w-4xl\",\"children\":[[\"$\",\"div\",\"167535\",{\"className\":\"ring-1 ring-rule rounded-sm bg-white p-4 sm:p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted\",\"children\":\"Автоматично извлечено от документите на парламента: дословни цитати, без редакция и без оценка от нас.\"}],[\"$\",\"p\",null,{\"className\":\"font-semibold mt-1\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.parliament.bg/bg/bills/ID/167535\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-ink\",\"children\":\"Законопроект за допълнение на Закона за търговския регистър и регистъра на юридическите лица с нестопанска цел\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-sm text-muted num font-normal\",\"children\":[\"№ \",\"52-654-01-129\"]}]]}],[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-semibold text-green mt-2\",\"children\":\"Покажи цитатите\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5 mt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-l-4 border-green pl-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold mb-1\",\"children\":\"Какво предлага законопроектът\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-[15px]\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"„\",\"Янка Тянкова, която посочи, че с него се цели да се преодолее значителната забава при разглеждане на заявления в търговския регистър и осигуряването на възможност за произнасяне в законоустановените срокове по подаваните в търговския регистър заявления за вписване, заличаване или обявяване относно търговци и юридически лица с нестопанска цел.\",\"“\"]}],[\"$\",\"li\",\"1\",{\"children\":[\"„\",\"Председателят на комисията заяви, че със законопроекта се цели увеличаване на административния капацитет на Агенцията по вписванията, като се предвижда изпълнителният директор на Агенцията по вписванията да разполага с възможност временно – за срок от две години – да привлече допълнителен експертен капацитет, като това ще спомогне за преодоляването на забавата при разглеждане на постъпилите заявления в регистъра.\",\"“\"]}],[\"$\",\"li\",\"2\",{\"children\":[\"„\",\"Г-н Стефан Арсов заяви, че парламентарната група на „ГЕРБ-СДС“ ще подкрепи законопроекта, тъй като с него се цели да се подобри дейността на Агенцията по вписванията.\",\"“\"]}],[\"$\",\"li\",\"3\",{\"children\":[\"„\",\"Във връзка с подпомагането на административния капацитет на Агенцията по вписванията и преодоляването на забавата при разглеждане на постъпилите заявления в търговския регистър се предвижда изпълнителният директор на Агенцията по вписванията да разполага с възможността временно - за срок до две години - да привлече допълнителен експертен капацитет („длъжностни лица по регистрацията“) на срочни трудови договори до една година, извън утвърдената численост на персонала, като техният брой не може да бъде повече от 30.\",\"“\"]}],[\"$\",\"li\",\"4\",{\"children\":[\"„\",\"С промяната на ал. 4 на чл. 32 ЗВЕРБ се предвижда задължение за представяне на преписи от устав или дружествен договор, свързани с превалутирането, да възниква при подаване на първото следващо заявление за вписване, заличаване или обявяване само в случаите, в които по Търговския закон е необходимо представяне на препис от устав или дружествен договор.\",\"“\"]}],[\"$\",\"li\",\"5\",{\"children\":[\"„\",\"Последващото изменение на дружествените договори и устави има за цел единствено да съгласува вътрешните актове с вече настъпилите и вписани. промени Така ще се постигне по-голяма яснота относно задължението на търговците да внасят приведените в съответствие с превалутирания вече капитал в търговския регистър дружествени договори и устави само в случаите, в които по Търговския закон е необходимо представянето им.\",\"“\"]}]]}],\"$L2c\"]}],\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\"]}]]}]]}]]}]]}]\n23:[\"$\",\"section\",null,{\"id\":\"mnenie\",\"className\":\"mb-16 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2.4rem] leading-none mb-2\",\"children\":\"Твоето мнение\"}],[\"$\",\"p\",null,{\"className\":\"text-[15px] text-muted mb-5 max-w-3xl\",\"children\":[\"Прочети какво променя законът и доводите на двете страни по-горе, после гласувай. Анонимно е; резултатът се вижда след гласуването. \",[\"$\",\"$La\",null,{\"href\":\"/mnenie\",\"children\":\"Всички закони за гласуване\"}],\".\"]}],[\"$\",\"$L31\",null,{\"item\":\"targovskiya-registar-i-registara-na-yuridicheskite-litsa-s-nestopanska-tsel\",\"question\":\"Подкрепяш ли последните промени в „Закон за търговския регистър (забавените вписвания и годишните отчети)“?\"}]]}]\n24:[\"$\",\"section\",null,{\"id\":\"grupi\",\"className\":\"mb-12 scroll-mt-32 lg:scroll-mt-20\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-end justify-between gap-4 mb-5\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"display text-[2rem] sm:text-[2.4rem]\",\"children\":\"Как гласуваха групите по този закон\"}],\"$undefined\"]}],[\"$\