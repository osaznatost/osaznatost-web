{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/vlast/layout,_N_T_/vlast/deklaracii/layout,_N_T_/vlast/deklaracii/page,_N_T_/vlast/deklaracii"},"segmentPaths":["/_tree","/_full","/vlast/deklaracii/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/997d84c61ca4c4dff5feb1f911e278564c3a954518eae68cb9eec30d57cbd073/$/vlast/deklaracii","owner":{"kind":"APP_PAGE","sourceRoute":"/vlast/deklaracii/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"bg\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2bx3suebn7wim.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2vy51v46dlsq-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2bx7ggprk0oi5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0c1ad7rcpjghx.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/0dydy_44bp5hv.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Декларирани фирми и обществени поръчки · Осъзнатост</title><meta name=\"description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Декларирани фирми и обществени поръчки · Осъзнатост\"/><meta property=\"og:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta property=\"og:site_name\" content=\"Осъзнатост\"/><meta property=\"og:locale\" content=\"bg_BG\"/><meta property=\"og:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Декларирани фирми и обществени поръчки · Осъзнатост\"/><meta name=\"twitter:description\" content=\"Какво прави държавата. С числа и източници.\"/><meta name=\"twitter:image\" content=\"https://osaznatost-web.vercel.app/og.png\"/><meta name=\"twitter:image:alt\" content=\"Осъзнатост — какво прави държавата, с числа и източници\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><header class=\"bg-deep text-white border-b border-white/10 sticky top-0 z-40 lg:static\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 flex items-center gap-x-8 h-14 lg:h-auto lg:py-4\"><a class=\"no-underline text-white hover:text-white flex items-center gap-2 shrink-0\" href=\"/\"><span aria-hidden=\"true\" class=\"inline-block w-3 h-3 bg-red\"></span><span class=\"text-[1.35rem] lg:text-[1.6rem] font-bold tracking-tight\">Осъзнатост</span></a><nav aria-label=\"Основно меню\" class=\"hidden lg:flex items-center gap-x-5 text-[15px] flex-1\"><span class=\"flex items-center gap-x-5\"><a title=\"Кой решава, как се приемат законите, сигнали\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/vlast\">Властта</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Кой как гласува, закони, партии, депутати\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/parlament\">Парламент</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво обещаха правителствата и какво стана\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/obeshtaniya\">Обещания</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Вярно ли е казаното, корупционни дела\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/proverki\">Проверки</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Приходи, разходи, дълг\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/byudzhet\">Бюджет</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Договори, фирми, риск, връзки с политици\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/porachki\">Поръчки</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Растеж, инфлация, заплати, жилища\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ikonomika\">Икономика</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Цените в магазините по вериги и места\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/ceni\">Цени</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Вашата община: пари, поръчки, съвет\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/mesta\">Места</a></span><span class=\"flex items-center gap-x-5\"><span aria-hidden=\"true\" class=\"w-px h-4 bg-white/20\"></span><a title=\"Графики с източник за всичко\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/statistiki\">Статистики</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Заплата, кредит, лична инфлация\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/kalkulatori\">Калкулатори</a></span><span class=\"flex items-center gap-x-5\"><a title=\"Какво е ново в данните\" class=\"no-underline pb-1 border-b-2 text-white/75 border-transparent hover:text-white\" href=\"/novini\">Новини</a></span></nav><div class=\"ml-auto flex items-center gap-1\"><a aria-label=\"Търсене\" class=\"no-underline text-white hover:text-white p-2 rounded hover:bg-white/10\" href=\"/tarsene\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m20 20-4.8-4.8\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-menu\" class=\"lg:hidden flex items-center gap-2 px-3 py-2 rounded bg-white/10 text-[15px] font-semibold\"><span aria-hidden=\"true\" class=\"relative w-4 h-3\"><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-0\"></span><span class=\"absolute left-0 top-1.5 w-4 h-0.5 bg-white \"></span><span class=\"absolute left-0 w-4 h-0.5 bg-white transition top-3\"></span></span>Меню</button></div></div></header><!--/$--><main class=\"flex-1 min-h-[100svh]\"><div class=\"mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-[88rem]\"><div class=\"relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen bg-surface -mt-8 sm:-mt-12 mb-10\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 sm:py-12\"><p class=\"text-sm mb-4\"><a href=\"/vlast\">← <!-- -->Властта</a></p><h1 class=\"display text-5xl sm:text-7xl max-w-4xl\">Декларирани фирми и обществени поръчки</h1><div class=\"mt-3 text-lg text-muted max-w-3xl\">Лицата на публични длъжности всяка година декларират в кои фирми имат дялове или участват в управлението. Тук свързваме тези декларации с обществените поръчки по едно и също правило за всички.</div></div></div><nav aria-label=\"Секции на страницата\" class=\"sticky top-14 lg:top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-8 bg-white/95 backdrop-blur border-b border-rule\"><ul class=\"flex gap-2 overflow-x-auto text-[15px] whitespace-nowrap\"><li><a href=\"#nakratko\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Накратко</a></li><li><a href=\"#sobstvena\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Поръчки от собствената институция</a></li><li><a href=\"#vsichki\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Всички връзки</a></li><li><a href=\"#poTR\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">По Търговския регистър</a></li><li><a href=\"#kak\" class=\"block px-3 py-1.5 rounded-full bg-surface no-underline text-ink hover:ring-1 hover:ring-green\">Как свързваме</a></li></ul></nav><section id=\"nakratko\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Накратко</h2><p class=\"text-[15px] max-w-3xl mb-3\">Общо по двата източника: <b>393</b> лица на публична длъжност с участие във фирма, печелила обществени поръчки, от които <b>64</b> настоящи или бивши народни представители.</p><p class=\"text-[15px] max-w-3xl mb-4\"><b>759</b> декларации за <!-- -->2020<!-- -->–<!-- -->2026<!-- --> г. показват участие във фирма, печелила обществени поръчки като изпълнител или подизпълнител. Те са на <b>270</b> лица, от които <b>23</b> настоящи или бивши народни представители.<!-- --> Отделно по Търговския регистър: <b>168</b> лица, от които <b>51</b> депутати (<a href=\"#poTR\">виж по-долу</a>).</p><div class=\"grid gap-3 sm:grid-cols-3 mb-5\"><div class=\"bg-surface rounded-sm p-4\"><p class=\"text-sm text-muted\">Лица с декларирана фирма, печелила поръчки</p><p class=\"display text-[2.4rem] leading-none mt-1\">270</p><p class=\"text-xs text-muted mt-1\">от <!-- -->14 748<!-- --> декларации с дружества</p></div><div class=\"bg-surface rounded-sm p-4\"><p class=\"text-sm text-muted\">Поръчки от собствената институция</p><p class=\"display text-[2.4rem] leading-none mt-1\">39</p><p class=\"text-xs text-muted mt-1\">връзки лице – фирма</p></div><div class=\"bg-surface rounded-sm p-4\"><p class=\"text-sm text-muted\">Обновено</p><p class=\"display text-[2.4rem] leading-none mt-1\">23.11.2026</p><p class=\"text-xs text-muted mt-1\">всяка седмица</p></div></div><p class=\"text-[15px] max-w-3xl\">По вид длъжност: <!-- -->Кметове, и зам.-кметове на общини, кметовете и зам.-кметовете на райони, председателите на общинските съвети, общинските съветници и гл. архитекти на общините и районите (159), Членовете на управителните органи на икономически обособените лица и структурни единици по чл. 13, ал. 4 от ЗПФ, както и управителите и членовете на ОУ или контрол на ОП или ДП и ръководителите на техните ТП, както и на други ЮЛ, които са бюджетни орг... (25), Народни представители (20), Министър-председател, заместник министър-председатели, министри и заместник-министри (12), Областни управители и заместник-областни управители (11), Ежегодни декларации (6), Управителите и изпълнителните директори на лечебните заведения за болнична помощ, които се финансират от бюджета на НЗОК и/или от държавния или общинския бюджет (4), Лицата, упълномощени по реда на Закона за обществените поръчки от публични възложители, които са задължени лица по този закон да организират и да провеждат процедурите за възлагане на обществени поръчки и да сключват договорите (4)<!-- -->.</p><p class=\"text-sm text-muted mt-3 max-w-3xl\">Всяка връзка е <b>повод за въпрос, не доказателство</b>. Законът не забранява на лице на публична длъжност да има фирма; забранява да участва в решения, от които тя печели (конфликт на интереси). Проверките са на Комисията за противодействие на корупцията.</p></section><section id=\"sobstvena\" class=\"mb-16 scroll-mt-32 lg:scroll-mt-20\"><h2 class=\"display text-[2.4rem] leading-none mb-2\">Поръчки от собствената институция</h2><p class=\"text-[15px] text-muted mb-5 max-w-3xl\">Фирмата, декларирана от лицето, има договори с институцията, в която то заема длъжност. Това е най-силният сигнал, но не доказва, че лицето е участвало в решението.</p><ul class=\"max-w-4xl\"><li class=\"py-3 border-b border-rule\"><div class=\"flex flex-wrap justify-between gap-2\"><span><b>Даниел Руменов Гаргов</b> <span class=\"text-muted text-sm\">Общински съветник<!-- -->, <!-- -->Хасково</span></span><span class=\"num font-semibold\">88 524 165 €</span></div><p class=\"text-[15px] mt-1\">Декларирано: <i>управление</i> в <a href=\"/porachki/firma/126729838\">„ЕКО ТРАДЕКС ГРУП“ АД</a> (Член на Съвета на директорите)<!-- -->.<!-- --> <!-- -->Фирмата има <!-- -->90<!-- --> договора<!-- --> (2020–2026)<!-- -->.<!-- --> <b class=\"text-red\">От институцията, в която лицето заема длъжност: <!-- -->16<!-- --> договора за <!-- -->20 481 675 €<!-- -->.</b></p><p class=\"text-sm text-muted mt-1\">Основни възложители: <!-- -->ОБЩИНА ХАСКОВО (16); ОБЩИНА СЕВЛИЕВО (12); ОБЩИНА ХАРМАНЛИ (10)</p><p class=\"text-xs mt-1\"><a href=\"https://register.cacbg.bg/2024/0C9B8E19-811E-4EF2-8791-FF7BD443D7AB196583.xml\" target=\"_blank\" rel=\"noreferrer\">Декларацията (<!-- -->2024<!-- -->)</a> · <!-- -->лицето е в тази фирма и по Търговския регистър</p></li><li class=\"py-3 border-b border-rule\"><div class=\"flex flex-wrap justify-between gap-2\"><span><b>Даниел Руменов Гаргов</b> <span class=\"text-muted text-sm\">Общински съветник<!-- -->, <!-- -->Хасково</span></span><span class=\"num font-semibold\">19 303 062 €</span></div><p class=\"text-[15px] mt-1\">Декларирано: <i>управление</i> в <a href=\"/porachki/firma/200145389\">„ЕКО-ТИТАН ГРУП“ АД</a> (Член на Съвета на директорите)<!-- -->.<!-- --> <!-- -->Фирмата има <!-- -->5<!-- --> договора<!-- --> (2020–2025)<!-- -->.<!-- --> <b class=\"text-red\">От институцията, в която лицето заема длъжност: <!-- -->2<!-- --> договора за <!-- -->14 042 375 €<!-- -->.</b></p><p class=\"text-sm text-muted mt-1\">Основни възложители: <!-- -->ОБЩИНА ХАСКОВО (2); ОБЩИНА СМОЛЯН (3)</p><p class=\"text-xs mt-1\"><a href=\"https://register.cacbg.bg/2024/0C9B8E19-811E-4EF2-8791-FF7BD443D7AB196583.xml\" target=\"_blank\" rel=\"noreferrer\">Декларацията (<!-- -->2024<!-- -->)</a> · <!-- -->лицето е в тази фирма и по Търговския регистър</p></li><li class=\"py-3 border-b border-rule\"><div class=\"flex flex-wrap justify-between gap-2\"><span><b>Димитър Ангелов Чолаков</b> <span class=\"text-muted text-sm\">Общински съветник<!-- -->, <!-- -->Пловдив</span></span><span class=\"num font-semibold\">11 706 337 €</span></div><p class=\"text-[15px] mt-1\">Декларирано: <i>дял на член на семейството</i> в <a href=\"/porachki/firma/115535593\">&quot;Автотранс-2000&quot; ООД</a> (250)<!-- -->.<!-- --> <!-- -->Фирмата има <!-- -->1<!-- --> договора<!-- --> (2021–2021)<!-- -->.<!-- --> <b class=\"text-red\">От институцията, в която лицето заема длъжност: <!-- -->1<!-- --> договора за <!-- -->11 706 337 €<!-- -->.</b></p><p class=\"text-sm text-muted mt-1\">Основни възложители: <!-- -->Община Пловдив (1)</p><p class=\"text-xs mt-1\"><a href=\"https://register.cacbg.bg/2023/C8B2E447-A238-47B7-B491-59DB033BF3F3150612.xml\" target=\"_blank\" rel=\"noreferrer\">Декларацията (<!-- -->2023<!-- -->)</a> · <!-- -->по Търговския регистър лицето не е сред управителите и собствениците (възможно е дяловете да са на член на семейството или да са прехвърлени)</p></li><li class=\"py-3 border-b border-rule\"><div class=\"flex flex-wrap justify-between gap-2\"><span><b>Веселина Георгиева Петкова - Илиева</b> <span class=\"text-muted text-sm\">Главен архитект<!-- -->, <!-- -->Бургас</span></span><span class=\"num font-semibold\">5 681 004 €</span></div><p class=\"text-[15px] mt-1\">Декларирано: <i>дял на член на семейството</i> в <a href=\"/porachki/firma/102885437\">Кабано Проект ООД</a> (2000)<!-- -->.<!-- --> <!-- -->Фирмата има <!-- -->5<!-- --> договора<!-- --> (2021–2026)<!-- -->.<!-- --> <b class=\"text-red\">От институцията, в която лицето заема длъжност: <!-- -->4<!-- --> договора за <!-- -->5 672 543 €<!-- -->.</b></p><p class=\"text-sm text-muted mt-1\">Основни възложители: <!-- -->ОБЩИНА БУРГАС (4); УНИВЕРСИТЕТСКА МНОГОПРОФИЛНА БОЛНИЦА ЗА АКТИВНО ЛЕЧЕНИЕ - БУРГАС АД (1)</p><p class=\"text-sm text-muted mt-1\">Като подизпълнител: <!-- -->2<!-- --> договора, най-често на <!-- -->БУРГОС СТРОЙ ЕООД, ГЕОПЛАН КЪНСТРАКШЪН ЕООД, Бойчо Брънзов<!-- -->.</p><p class=\"text-xs mt-1\"><a href=\"https://register.cacbg.bg/2020/e02762d1-a1d0-4027-9879-00812f8f7678.xml\" target=\"_blank\" rel=\"noreferrer\">Декларацията (<!-- -->2020<!-- -->)</a> · <!-- -->по Търговския регистър лицето не е сред управителите и собствениците (възможно е дяловете да са на член на семейството или да са прехвърлени)</p></li><li class=\"py-3 border-b border-rule\"><div class=\"flex flex-wrap justify-between gap-2\"><span><b>Гергана Владимирова Муртова</b> <span class=\"text-muted text-sm\">Общински съветник<!-- -->, <!-- -->Благоевград</span></span><span class=\"num font-semibold\">85 576 184 €</span></div><p class=\"text-[15px] mt-1\">Декларирано: <i>дял на член на семейството</i> в <a href=\"/porachki/firma/020767877\">Растер - Юг ООД</a> (25)<!-- -->.<!-- --> <!-- -->Фирмата има <!-- -->110<!-- --> договора<!-- --> (2020–2026)<!-- -->.<!-- --> <b class=\"text-red\">От институцията, в която лицето заема длъжност: <!-- -->8<!-- --> договора за <!-- -->5 214 290 €<!-- -->.</b></p><p class=\"text-sm text-muted mt-1\">Основни възложители: <!-- -->ЮГОЗАПАДЕН УНИВЕРСИТЕТ &quot;НЕОФИТ РИЛСКИ&quot; (19); Агенция „Митници“ (1); ОБЩИНА КЮСТЕНДИЛ (2)</p><p class=\"text-sm text-muted mt-1\">Като подизпълнител: <!-- -->2<!-- 