"#555\"><title>ИТН: 1.4% (2026-04-13)</title></circle><circle cx=\"685.8704144830872\" cy=\"268.71999999999997\" r=\"2\" fill=\"#555\"><title>ИТН: 0.9% (2026-04-14)</title></circle><circle cx=\"686.2115292996665\" cy=\"264.02666666666664\" r=\"2\" fill=\"#555\"><title>ИТН: 1.7% (2026-04-15)</title></circle><circle cx=\"686.5526441162458\" cy=\"261.68\" r=\"2\" fill=\"#555\"><title>ИТН: 2.1% (2026-04-16)</title></circle></g></svg><figcaption class=\"mt-2\"><ul class=\"flex flex-wrap gap-x-4 gap-y-1 text-sm\"><li><span class=\"inline-block w-3 h-3 rounded-sm mr-1 align-middle\" style=\"background:#2f6f8f\"></span>Прогресивна България<b class=\"num\"> <!-- -->32<!-- -->%</b></li><li><span class=\"inline-block w-3 h-3 rounded-sm mr-1 align-middle\" style=\"background:#2b5fa8\"></span>ГЕРБ<b class=\"num\"> <!-- -->9,6<!-- -->%</b></li><li><span class=\"inline-block w-3 h-3 rounded-sm mr-1 align-middle\" style=\"background:#d18a1c\"></span>ПП и ДБ<b class=\"num\"> <!-- -->17,8<!-- -->%</b></li><li><span class=\"inline-block w-3 h-3 rounded-sm mr-1 align-middle\" style=\"background:#7a4fa0\"></span>ДПС / ДПС–НН<b class=\"num\"> <!-- -->5,6<!-- -->%</b></li><li><span class=\"inline-block w-3 h-3 rounded-sm mr-1 align-middle\" style=\"background:#3f7d3a\"></span>Възраждане<b class=\"num\"> <!-- -->4,4<!-- -->%</b></li><li><span class=\"inline-block w-3 h-3 rounded-sm mr-1 align-middle\" style=\"background:#c0392b\"></span>БСП</li><li><span class=\"inline-block w-3 h-3 rounded-sm mr-1 align-middle\" style=\"background:#555\"></span>ИТН</li></ul><p class=\"text-xs text-muted mt-2\">115<!-- --> проучвания от <!-- -->19.01.2021<!-- --> до <!-- -->19.10.2026<!-- --> (последното: <!-- -->Маркет ЛИНКС<!-- -->). Всяка точка е едно проучване; процентът е от посочилите партия, както го публикува агенцията. „ПП и ДБ“ е общата листа, а когато партиите са измервани поотделно, сборът им. „ДПС“ след разцеплението през 2024 г. е ДПС–Ново начало; АПС не е показана. Източник: публикуваните проучвания на агенциите, събрани от „Наясно“.</p></figcaption></figure></section><section id=\"doverie\" class=\"mb-12 scroll-mt-32 lg:scroll-mt-20\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">Доверие в лидерите и институциите</h2></div><div><p class=\"text-[15px] text-muted mb-4 max-w-3xl\">Доверие и одобрение от публикуваните резултати на социологическите агенции. Агенциите задават различни въпроси (доверие, одобрение, положителна оценка) и с различни методи, затова числата са за сравнение във времето в рамките на една агенция, не между агенции.<!-- --> Показваме само проценти, които агенцията или медията е публикувала изрично; където няма число за някого, той не е в таблицата.</p><div class=\"space-y-5\"><div class=\"border-t border-rule pt-3\"><h3 class=\"font-semibold\">Галъп Интернешънъл Болкан<!-- -->, <!-- -->24.07–04.08.2026</h3><p class=\"text-xs text-muted mb-2\">821<!-- --> пълнолетни, <!-- -->по телефона<!-- -->. <a class=\"underline\" href=\"https://bnrnews.bg/en/post/512453/gallup-ruling-pb-retains-strong-support-as-foreign-policy-divides-voters\">Източник</a></p><ul class=\"space-y-1.5 max-w-3xl\"><li class=\"text-[15px]\"><div class=\"flex justify-between gap-3\"><span>Румен Радев<span class=\"text-muted\"> (<!-- -->министър-председател<!-- -->)</span></span><span class=\"num\">48,4%</span></div><div class=\"h-1.5 rounded-full bg-surface mt-1\"><div class=\"h-full rounded-full bg-ink/60\" style=\"width:48.4%\"></div></div></li><li class=\"text-[15px]\"><div class=\"flex justify-between gap-3\"><span>Правителство</span><span class=\"num\">42%</span></div><div class=\"h-1.5 rounded-full bg-surface mt-1\"><div class=\"h-full rounded-full bg-ink/60\" style=\"width:42%\"></div></div></li><li class=\"text-[15px]\"><div class=\"flex justify-between gap-3\"><span>Народно събрание</span><span class=\"num\">20,2%</span></div><div class=\"h-1.5 rounded-full bg-surface mt-1\"><div class=\"h-full rounded-full bg-ink/60\" style=\"width:20.2%\"></div></div></li></ul></div><div class=\"border-t border-rule pt-3\"><h3 class=\"font-semibold\">Алфа Рисърч<!-- -->, <!-- -->17–23.07.2026</h3><p class=\"text-xs text-muted mb-2\">1000<!-- --> пълнолетни, <!-- -->лично интервю с таблет<!-- -->. <a class=\"underline\" href=\"https://sofiaglobe.com/?p=128501\">Източник</a></p><ul class=\"space-y-1.5 max-w-3xl\"><li class=\"text-[15px]\"><div class=\"flex justify-between gap-3\"><span>Правителство</span><span class=\"num\">42%<span class=\"text-muted\"> · недоверие <!-- -->33%</span><span class=\"text-xs text-muted\"> (<!-- -->одобрение<!-- -->)</span></span></div><div class=\"h-1.5 rounded-full bg-surface mt-1\"><div class=\"h-full rounded-full bg-ink/60\" style=\"width:42%\"></div></div></li></ul></div><div class=\"border-t border-rule pt-3\"><h3 class=\"font-semibold\">Маркет ЛИНКС (с bTV)<!-- -->, <!-- -->11–19.07.2026</h3><p class=\"text-xs text-muted mb-2\">1002<!-- --> пълнолетни, <!-- -->лично интервю и онлайн анкета<!-- -->. <a class=\"underline\" href=\"https://www.bta.bg/en/news/bulgaria/1172185-public-trust-in-radev-government-declining-poll-shows\">Източник</a></p><ul class=\"space-y-1.5 max-w-3xl\"><li class=\"text-[15px]\"><div class=\"flex justify-between gap-3\"><span>Румен Радев<span class=\"text-muted\"> (<!-- -->министър-председател<!-- -->)</span></span><span class=\"num\">50%<span class=\"text-muted\"> · недоверие <!-- -->33%</span></span></div><div class=\"h-1.5 rounded-full bg-surface mt-1\"><div class=\"h-full rounded-full bg-ink/60\" style=\"width:50%\"></div></div></li><li class=\"text-[15px]\"><div class=\"flex justify-between gap-3\"><span>Асен Василев<span class=\"text-muted\"> (<!-- -->„Продължаваме промяната“<!-- -->)</span></span><span class=\"num\">13%</span></div><div class=\"h-1.5 rounded-full bg-surface mt-1\"><div class=\"h-full rounded-full bg-ink/60\" style=\"width:13%\"></div></div></li><li class=\"text-[15px]\"><div class=\"flex just