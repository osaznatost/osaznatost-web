n sm:table-cell\">1,4<!-- -->%</td><td class=\"p-3 num hidden md:table-cell\">1007 млн. €</td><td class=\"p-3 num \">80 млн. €</td><td class=\"p-3 num\">99 млн. €</td><td class=\"p-3 num hidden sm:table-cell\">12,1%</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Швеция</td><td class=\"p-3 num font-semibold\">690 млн. €</td><td class=\"p-3 num hidden sm:table-cell\">1,2<!-- -->%</td><td class=\"p-3 num hidden md:table-cell\">164 млн. €</td><td class=\"p-3 num \">150 млн. €</td><td class=\"p-3 num\">85 млн. €</td><td class=\"p-3 num hidden sm:table-cell\">12,4%</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Полша</td><td class=\"p-3 num font-semibold\">627 млн. €</td><td class=\"p-3 num hidden sm:table-cell\">1,1<!-- -->%</td><td class=\"p-3 num hidden md:table-cell\">151 млн. €</td><td class=\"p-3 num \">186 млн. €</td><td class=\"p-3 num\">38 млн. €</td><td class=\"p-3 num hidden sm:table-cell\">6%</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Дания</td><td class=\"p-3 num font-semibold\">492 млн. €</td><td class=\"p-3 num hidden sm:table-cell\">0,9<!-- -->%</td><td class=\"p-3 num hidden md:table-cell\">259 млн. €</td><td class=\"p-3 num \">61 млн. €</td><td class=\"p-3 num\">35 млн. €</td><td class=\"p-3 num hidden sm:table-cell\">7,1%</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Чехия</td><td class=\"p-3 num font-semibold\">460 млн. €</td><td class=\"p-3 num hidden sm:table-cell\">0,8<!-- -->%</td><td class=\"p-3 num hidden md:table-cell\">612 млн. €</td><td class=\"p-3 num \">118 млн. €</td><td class=\"p-3 num\">75 млн. €</td><td class=\"p-3 num hidden sm:table-cell\">16,3%</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Румъния</td><td class=\"p-3 num font-semibold\">393 млн. €</td><td class=\"p-3 num hidden sm:table-cell\">0,7<!-- -->%</td><td class=\"p-3 num hidden md:table-cell\">281 млн. €</td><td class=\"p-3 num text-red\">-51 млн. €</td><td class=\"p-3 num\">67 млн. €</td><td class=\"p-3 num hidden sm:table-cell\">17,1%</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Лихтенщайн<span class=\"text-muted\"> *</span></td><td class=\"p-3 num font-semibold\">326 млн. €</td><td class=\"p-3 num hidden sm:table-cell\">0,6<!-- -->%</td><td class=\"p-3 num hidden md:table-cell\">179 млн. €</td><td class=\"p-3 num \">9 млн. €</td><td class=\"p-3 num\">25 млн. €</td><td class=\"p-3 num hidden sm:table-cell\">7,6%</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Израел</td><td class=\"p-3 num font-semibold\">271 млн. €</td><td class=\"p-3 num hidden sm:table-cell\">0,5<!-- -->%</td><td class=\"p-3 num hidden md:table-cell\">259 млн. €</td><td class=\"p-3 num text-red\">-13 млн. €</td><td class=\"p-3 num\">69 млн. €</td><td class=\"p-3 num hidden sm:table-cell\">25,3%</td></tr></tbody></table></div><p class=\"text-xs text-muted mt-2\">Отрицателните „нови“ означават, че инвеститорите от тази държава са изтеглили повече, отколкото са вложили (продажби, погасени заеми към майката).</p></section><section class=\"mb-14\"><div class=\"flex items-end justify-between gap-4 mb-5\"><h2 class=\"display text-[2rem] sm:text-[2.4rem]\">В кои отрасли</h2></div><div class=\"overflow-x-auto ring-1 ring-rule rounded-sm bg-white mb-6\"><table class=\"w-full text-[15px]\"><thead><tr class=\"text-left text-sm text-muted border-b border-rule\"><th class=\"p-3\">Отрасъл</th><th class=\"p-3 num\">Натрупано <!-- -->2025</th><th class=\"p-3 num\">Дял</th><th class=\"p-3 num hidden sm:table-cell\">2015</th><th class=\"p-3 num\">Нови <!-- -->2025</th></tr></thead><tbody><tr class=\"border-t border-rule\"><td class=\"p-3\">Финанси и застраховане</td><td class=\"p-3 num font-semibold\">12 308 млн. €</td><td class=\"p-3 num\">21,7<!-- -->%</td><td class=\"p-3 num hidden sm:table-cell\">6592 млн. €</td><td class=\"p-3 num \">873 млн. €</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Преработваща промишленост</td><td class=\"p-3 num font-semibold\">11 802 млн. €</td><td class=\"p-3 num\">20,8<!-- -->%</td><td class=\"p-3 num hidden sm:table-cell\">7178 млн. €</td><td class=\"p-3 num \">525 млн. €</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Недвижими имоти</td><td class=\"p-3 num font-semibold\">10 593 млн. €</td><td class=\"p-3 num\">18,7<!-- -->%</td><td class=\"p-3 num hidden sm:table-cell\">10 069 млн. €</td><td class=\"p-3 num \">168 млн. €</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Търговия</td><td class=\"p-3 num font-semibold\">7765 млн. €</td><td class=\"p-3 num\">13,7<!-- -->%</td><td class=\"p-3 num hidden sm:table-cell\">5108 млн. €</td><td class=\"p-3 num \">751 млн. €</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">ИТ и комуникации</td><td class=\"p-3 num font-semibold\">3898 млн. €</td><td class=\"p-3 num\">6,9<!-- -->%</td><td class=\"p-3 num hidden sm:table-cell\">1802 млн. €</td><td class=\"p-3 num \">315 млн. €</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Енергетика</td><td class=\"p-3 num font-semibold\">2938 млн. €</td><td class=\"p-3 num\">5,2<!-- -->%</td><td class=\"p-3 num hidden sm:table-cell\">3179 млн. €</td><td class=\"p-3 num \">177 млн. €</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Професионални и научни услуги</td><td class=\"p-3 num font-semibold\">2863 млн. €</td><td class=\"p-3 num\">5<!-- -->%</td><td class=\"p-3 num hidden sm:table-cell\">1488 млн. €</td><td class=\"p-3 num \">327 млн. €</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Добив</td><td class=\"p-3 num font-semibold\">1035 млн. €</td><td class=\"p-3 num\">1,8<!-- -->%</td><td class=\"p-3 num hidden sm:table-cell\">701 млн. €</td><td class=\"p-3 num \">42 млн. €</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Транспорт и складове</td><td class=\"p-3 num font-semibold\">900 млн. €</td><td class=\"p-3 num\">1,6<!-- -->%</td><td class=\"p-3 num hidden sm:table-cell\">495 млн. €</td><td class=\"p-3 num \">21 млн. €</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Строителство</td><td class=\"p-3 num font-semibold\">792 млн. €</td><td class=\"p-3 num\">1,4<!-- -->%</td><td class=\"p-3 num hidden sm:table-cell\">1030 млн. €</td><td class=\"p-3 num \">58 млн. €</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Административни услуги</td><td class=\"p-3 num font-semibold\">712 млн. €</td><td class=\"p-3 num\">1,3<!-- -->%</td><td class=\"p-3 num hidden sm:table-cell\">289 млн. €</td><td class=\"p-3 num text-red\">-12 млн. €</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Хотели и ресторанти</td><td class=\"p-3 num font-semibold\">486 млн. €</td><td class=\"p-3 num\">0,9<!-- -->%</td><td class=\"p-3 num hidden sm:table-cell\">662 млн. €</td><td class=\"p-3 num \">22 млн. €</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Води и отпадъци</td><td class=\"p-3 num font-semibold\">243 млн. €</td><td class=\"p-3 num\">0,4<!-- -->%</td><td class=\"p-3 num hidden sm:table-cell\">224 млн. €</td><td class=\"p-3 num \">15 млн. €</td></tr><tr class=\"border-t border-rule\"><td class=\"p-3\">Земеделие</td><td class=\"p-3 num font-semibold\">107 млн. €</td><td class=\"p-3 num\">0,2<!-- -->%</td><td class=\"p-3 num hidden sm:table-cell\">161 млн. €</td><td class=\"p-3 num \">12 млн. €</td></tr></tbody></table></div><div class=\"ring-1 ring-rule rounded-sm p-4 bg-white\"><p class=\"font-semibold mb-2\">Преработващата промишленост по видове, млн. € (<!-- -->2025<!-- -->)</p><div class=\"w-full\"></div></div><p class=\"text-[15px] mt-3 max-w-3xl\">Най-много чужд капитал е във финансите, имотите и търговията. Те обслужват вътрешния пазар. Промишлеността и ИТ, които изнасят и създават най-много стойност на зает (виж <a href=\"/ikonomika/struktura\">анатомията на икономиката</a>), привличат по-малка част.</p></section><section class=\"mb-10 bg-surface rounded-sm p-5 max-w-3xl\"><p class=\"font-semibold mb-1\">Какво следва</p><ul class=\"list-disc pl-5 text-[15px] space-y-1\"><li>Чуждите инвестиции по области (НСИ). Евростат не ги дава по региони.</li><li>Европейските средства по проекти, бенефициенти и общини (ИСУН).</li><li>Държавните инвестиции от бюджета, свързани с обществените поръчки.</li><li>Сертифицираните инвеститори по Закона за насърчаване на инвестициите.</li></ul></section><p class=\"text-xs text-muted\">Източник: Евростат, преки инвестиции по методиката BPM6: <a href=\"https://ec.europa.eu/eurostat/databrowser/view/bop_fdi6_geo/default/table\" target=\"_blank\" rel=\"noreferrer\">bop_fdi6_geo</a>, <a href=\"https://ec.europa.eu/eurostat/databrowser/view/bop_fdi6_pos/default/table\" target=\"_blank\" rel=\"noreferrer\">bop_fdi6_pos</a>, <a href=\"https://ec.europa.eu/eurostat/databrowser/view/bop_fdi6_flow/default/table\" target=\"_blank\" rel=\"noreferrer\">bop_fdi6_flow</a>. Първичен източник: БНБ.</p></div><!--$--><!--/$--></main><!--$--><!--/$--><footer class=\"bg-surface border-t border-rule mt-20\"><div class=\"mx-auto max-w-[88rem] px-4 sm:px-6 py-8 text-sm text-muted grid gap-2 sm:grid-cols-2\"><p>Не подкрепяме партия, кандидат или правителство. Всяко число има източник и дата.<!-- --> <a href=\"/metodologiya\">Как работим</a> · <a href=\"/rechnik\">Речник</a> · <a href=\"/sastoyanie\">Състояние на данните</a> · <!--$?--><template id=\"B:1\"></template><a href=\"/metodologiya#greshki\">Съобщи за грешка</a><!--/$--></p><p class=\"sm:text-right\">Вътрешен прототип · данните са към датите, посочени до тях</p></div></footer><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script id=\"_R_\">(globalThis[\"TURBOPACK\"] || (globalThis[\"TURBOPACK\"] = [])).push({\"otherChunks\":[\"static/chunks/310vm2bl3xxpt.js\",\"static/chunks/2vy51v46dlsq-.js\",\"static/chunks/2bx7ggprk0oi5.js\",\"static/chunks/0c1ad7rcpjghx.js\"],\"runtimeModuleIds\":[94553]});</script><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" async=\"\"></script><div hidden id=\"S:0\"><header cl