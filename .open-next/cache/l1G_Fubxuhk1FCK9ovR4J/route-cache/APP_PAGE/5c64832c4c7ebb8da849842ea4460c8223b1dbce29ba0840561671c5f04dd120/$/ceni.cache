\",\\\"li\\\",null,{\\\"children\\\":\\\"Във всяка група има различни марки и разфасовки. „Типична цена“ е медианата: половината от предложенията са по-евтини, половината по-скъпи. Затова сравненията между вериги и места показват общото ниво, а не цената на конкретен продукт.\\\"}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Използваме обикновената цена на дребно, без промоциите. Лекарствата (групи 86–101) не сравняваме, защото в една група има съвсем различни продукти.\\\"}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[\\\"Как стоят цените у нас спрямо другите държави от ЕС (по видове храни и стоки): \\\",[\\\"$\\\",\\\"$Lb\\\",null,{\\\"href\\\":\\\"/ikonomika/pokupatelna-sila\\\",\\\"children\\\":\\\"ценови равнища и покупателна сила (Евростат)\\\"}],\\\". Горивата: \\\",[\\\"$\\\",\\\"$Lb\\\",null,{\\\"href\\\":\\\"/proverki/goriva-2026\\\",\\\"children\\\":\\\"проверката „Горивата: виновно ли е правителството?“\\\"}],\\\".\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Историята е по една дата на седмица от 5 януари 2026 г. (въвеждането на еврото), след това всеки ден.\\\"}]]}]]}]\\n21:[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"block sm:inline sm:ml-2 text-xs text-muted\\\",\\\"children\\\":[79,\\\" стоки\\\"]}]\\n22:[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"text-right px-2 font-semibold text-red\\\",\\\"children\\\":\\\"+6,3%\\\"}]\\n23:[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"text-right px-2\\\",\\\"children\\\":\\\"47\\\"}]\\n24:[\\\"$\\\",\\\"tr\\\",\\\"ПАЦОНИ\\\",{\\\"className\\\":\\\"border-b border-rule\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-1.5 pr-3\\\",\\\"children\\\":[\\\"ПАЦОНИ\\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"block sm:inline sm:ml-2 text-xs text-muted\\\",\\\"children\\\":[77,\\\" стоки\\\"]}]]}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"text-right px-2 font-semibold text-red\\\",\\\"children\\\":\\\"+7,9%\\\"}],[\\\"$\\\",\\\"td\\\",null,{\